---
// Which system's results show: a pair of radio buttons that scope everything in the nearest
// .os-scope around them. Each system's results are in the page twice over, marked data-os, and CSS
// hides the other's, so the switch works without JavaScript. The script only remembers the choice,
// for the next benchmark page, and keeps every switch on a page in step.
import { SUITE_OSES, suite } from '../numbers.mjs';

interface Props {
	/** The radio group's name, unique on the page. */
	name: string;
}
const { name } = Astro.props;
// "Windows 11" and "Ubuntu in WSL2", or "Windows" and "Linux" on a phone.
const options = SUITE_OSES.map((os) => ({
	os,
	label: suite(os).system.replace(/ \d+\.\d+/, ''),
	short: os === 'linux' ? 'Linux' : 'Windows',
}));
---

<div class="os-switch" role="radiogroup" aria-label="System">
	{
		options.map((o, i) => (
			<label>
				<input type="radio" name={name} value={o.os} checked={i === 0} aria-label={o.label} />
				<span>
					<span class="long">{o.label}</span>
					<span class="short" aria-hidden="true">
						{o.short}
					</span>
				</span>
			</label>
		))
	}
</div>

<script>
	const KEY = 'calx-bench-os';
	const radios = [...document.querySelectorAll<HTMLInputElement>('.os-switch input')];
	let saved: string | null = null;
	try {
		saved = localStorage.getItem(KEY);
	} catch {}
	const pick = (os: string) => radios.forEach((r) => (r.checked = r.value === os));
	if (saved && radios.some((r) => r.value === saved)) pick(saved);
	for (const r of radios)
		r.addEventListener('change', () => {
			pick(r.value);
			try {
				localStorage.setItem(KEY, r.value);
			} catch {}
		});
</script>

<style is:global>
	/* The other system's results. Browsers without :has() show both, each labeled. */
	.os-scope:not(:has(.os-switch input[value='linux']:checked)) [data-os='linux'],
	.os-scope:has(.os-switch input[value='linux']:checked) [data-os='windows'] {
		display: none;
	}
	.os-switch {
		display: inline-flex;
		padding: 3px;
		gap: 2px;
		border: 1px solid var(--line-2);
		border-radius: 10px;
		background: var(--sunk);
		flex: none;
	}
	.os-switch label {
		position: relative;
		cursor: pointer;
	}
	.os-switch input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.os-switch .short {
		display: none;
	}
	@media (max-width: 640px) {
		.os-switch .long {
			display: none;
		}
		.os-switch .short {
			display: inline;
		}
	}
	.os-switch label > span {
		display: block;
		font: 500 13.5px/1 var(--f-body);
		color: var(--ink-2);
		padding: 8px 12px;
		border-radius: 7px;
		white-space: nowrap;
	}
	.os-switch label:hover span {
		color: var(--ink);
	}
	.os-switch input:checked + span {
		background: var(--raised);
		color: var(--ink);
		box-shadow:
			0 0 0 1px var(--line-2),
			0 1px 2px rgba(0, 0, 0, 0.08);
	}
	.os-switch input:focus-visible + span {
		outline: 2px solid var(--amber);
		outline-offset: 1px;
	}
</style>
