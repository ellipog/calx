---
// Calx against C, Rust, Go and Python on every benchmark of bench/suite: for each, who was faster
// and by how much, so wins, ties and losses read at a glance. A bar's color is the faster
// language's, Calx's amber or the other's blue, and its length the factor on a log scale that
// fills the cell at 16 times; times within 5% of each other are even. The numbers are the recorded
// runs' (src/numbers.mjs), both systems', and the table under it has every median.
import { GITHUB } from '../markdown.mjs';
import { SUITE_LANGS, SUITE_OSES, suite, tally, versus } from '../numbers.mjs';
import OsSwitch from './OsSwitch.astro';

interface Props {
	/** Where the language benchmarks page is, for the links to its sections: "" on that page. */
	page?: string;
	/** Whether the chart has a switch of its own; on the performance page, the page's switch sets it. */
	switcher?: boolean;
}
const { page = '', switcher = true } = Astro.props;
const OTHERS = SUITE_LANGS.filter((l) => l.id !== 'calx');
const FULL = 16;

const fmt = (ms: number) => (ms < 10 ? ms.toFixed(2) : ms < 100 ? ms.toFixed(1) : Math.round(ms).toLocaleString('en-US'));
const factor = (f: number) => (f < 10 ? f.toFixed(1) : Math.round(f).toString());

type Cell =
	| { kind: 'none'; tip: string }
	| { kind: 'even' | 'calx' | 'other'; text: string; width: string; tip: string };

// The tooltip is HTML, for the bold times; what it quotes from the records is escaped.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function cell(name: string, ms: Record<string, number>, why: Record<string, string>, lang: { id: string; name: string }): Cell {
	const calx = ms.calx;
	const other = ms[lang.id];
	const label = esc(name);
	if (calx === undefined || other === undefined) {
		const who = calx === undefined ? 'Calx' : lang.name;
		return { kind: 'none', tip: `<b>${label}</b><br>No ${who} result: ${esc(why[calx === undefined ? 'calx' : lang.id] ?? 'no program')}` };
	}
	const times = `Calx <b>${fmt(calx)} ms</b> · ${lang.name} <b>${fmt(other)} ms</b>`;
	const v = versus(calx, other);
	if (v.kind === 'even') return { kind: 'even', text: 'even', width: '0%', tip: `<b>${label}</b><br>${times}<br>Within 5%` };
	const width = `${(Math.min(Math.log2(v.factor) / Math.log2(FULL), 1) * 100).toFixed(1)}%`;
	const who = v.kind === 'calx' ? 'Calx' : lang.name;
	return { kind: v.kind, text: `${who} ${factor(v.factor)}×`, width, tip: `<b>${label}</b><br>${times}<br>${who} ${factor(v.factor)}× faster` };
}

const systems = SUITE_OSES.map((os) => {
	const s = suite(os);
	return {
		...s,
		tally: tally(os),
		groups: s.groups.map((g) => ({
			...g,
			rows: g.rows.map((r) => ({ ...r, cells: OTHERS.map((l) => cell(r.label, r.ms, r.why, l)) })),
		})),
	};
});
---

<div class={`suite${switcher ? ' os-scope' : ''}`}>
	<div class="suite-head">
		<div class="suite-title">Who was faster, and how many times<span>median wall time</span></div>
		{switcher && <OsSwitch name="suite-os" />}
	</div>
	<div class="legend">
		<span><i class="k-calx"></i>Calx faster</span>
		<span><i class="k-even"></i>within 5%</span>
		<span><i class="k-other"></i>the other language faster</span>
	</div>
	{
		systems.map((s) => (
			<div class="cq" data-os={s.os}>
				<div class="grid head" aria-hidden="true">
					<div />
					{s.tally.map((t) => (
						<div class="tally">
							<b>vs {t.name}</b>
							<span>
								{t.calx} faster · {t.even} even · {t.other} slower
							</span>
						</div>
					))}
				</div>
				{s.groups.map((g) => (
					<section class="group">
						<h3>
							<a href={`${page}#${g.anchor}`}>{g.id === 'parallel' ? `Parallel loops, on all ${s.threads} threads` : g.title}</a>
						</h3>
						{g.rows.map((r) => (
							<div class="grid row">
								<div class="lab" title={r.title}>
									{r.label}
								</div>
								{r.cells.map((c, i) => (
									<div class={`c c-${c.kind}`} data-tip={c.tip} tabindex="0">
										<span class="vs">vs {OTHERS[i].name}</span>
										{c.kind === 'none' ? (
											<span class="t">—</span>
										) : (
											<>
												<span class="t">{c.text}</span>
												<span class="track">
													<span class="bar" style={`width:${c.width}`} />
												</span>
											</>
										)}
									</div>
								))}
							</div>
						))}
					</section>
				))}
				<div class="suite-foot">
					<span>
						{s.system}: median of {s.rounds} runs on an {s.cpu}, single-threaded programs pinned to performance cores. clang{' '}
						{s.versions.clang}, rustc {s.versions.rustc}, Go {s.versions.go}, Python {s.versions.python}.{' '}
						<a href={`${page}#how-its-measured`}>How it's measured</a>
						{' · '}
						<a href={`${GITHUB}/tree/main/bench/suite`}>The programs</a>
						{' · '}
						<a href={`${GITHUB}/blob/main/bench/results/suite-${s.os}.json`}>Every recorded run</a>
					</span>
					<details class="tbl">
						<summary>Show as a table</summary>
						<table>
							<thead>
								<tr>
									<th>Benchmark</th>
									{SUITE_LANGS.map((l) => (
										<th>{l.name}, ms</th>
									))}
								</tr>
							</thead>
							<tbody>
								{s.groups.flatMap((g) =>
									g.rows.map((r) => (
										<tr>
											<td>{g.id === 'parallel' ? `${r.title}, ${s.threads} threads` : r.title}</td>
											{SUITE_LANGS.map((l) => (
												<td>{r.ms[l.id] === undefined ? '—' : fmt(r.ms[l.id])}</td>
											))}
										</tr>
									))
								)}
							</tbody>
						</table>
					</details>
				</div>
			</div>
		))
	}
	<div class="tip" hidden></div>
</div>

<script>
	// A cell's times and who was faster, beside the pointer, or under the cell when it has the focus.
	for (const chart of document.querySelectorAll<HTMLElement>('.suite')) {
		const tip = chart.querySelector<HTMLElement>('.tip')!;
		const show = (c: HTMLElement, x: number, y: number) => {
			tip.innerHTML = c.dataset.tip ?? '';
			tip.hidden = false;
			tip.style.left = `${Math.max(8, Math.min(x + 14, innerWidth - tip.offsetWidth - 8))}px`;
			tip.style.top = `${y + 16}px`;
		};
		for (const c of chart.querySelectorAll<HTMLElement>('.c')) {
			c.addEventListener('mousemove', (e) => show(c, e.clientX, e.clientY));
			c.addEventListener('mouseleave', () => (tip.hidden = true));
			c.addEventListener('focus', () => {
				const r = c.getBoundingClientRect();
				show(c, r.left, r.bottom - 10);
			});
			c.addEventListener('blur', () => (tip.hidden = true));
		}
		addEventListener('scroll', () => (tip.hidden = true), { passive: true });
	}
</script>

<style>
	.cq {
		container: suite / inline-size;
		margin-top: 18px;
	}
	.suite {
		margin-top: 40px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--raised);
		padding: 26px 32px 26px;
		box-shadow: var(--shadow);
	}
	.suite-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px 20px;
		flex-wrap: wrap;
	}
	.suite-title {
		font: 600 17px var(--f-body);
	}
	.suite-title span {
		font: 400 14px var(--f-body);
		color: var(--ink-3);
		margin-left: 8px;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 20px;
		margin-top: 12px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.legend i {
		width: 12px;
		height: 12px;
		border-radius: 3px;
		display: inline-block;
		margin-right: 8px;
		vertical-align: -1px;
	}
	.k-calx {
		background: var(--calx);
	}
	.k-other {
		background: var(--rust);
	}
	.k-even {
		background: var(--line-2);
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(110px, 1.1fr) repeat(4, minmax(0, 1fr));
		gap: 0 14px;
		align-items: center;
	}
	.head {
		padding-bottom: 10px;
		border-bottom: 1px solid var(--line);
	}
	.tally b {
		display: block;
		font: 600 14px var(--f-body);
		color: var(--ink);
	}
	.tally span {
		font-size: 12.5px;
		color: var(--ink-3);
	}
	.group h3 {
		font: 600 14px var(--f-body);
		margin: 18px 0 4px;
	}
	.group h3 a {
		color: var(--ink-2);
		text-decoration: none;
	}
	.group h3 a::after {
		content: ' →';
		color: var(--ink-3);
		opacity: 0;
		transition: opacity 0.15s;
	}
	.group h3 a:hover {
		color: var(--ink);
	}
	.group h3 a:hover::after,
	.group h3 a:focus-visible::after {
		opacity: 1;
	}
	.row {
		padding: 4px 0;
	}
	.lab {
		font-size: 13.5px;
		color: var(--ink-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.c {
		position: relative;
		display: grid;
		gap: 3px;
		cursor: default;
		padding: 3px 0;
		outline: none;
	}
	.c::before {
		content: '';
		position: absolute;
		inset: -1px -6px;
		border-radius: 6px;
	}
	.c:hover::before,
	.c:focus-visible::before {
		background: var(--amber-wash);
	}
	.c:focus-visible::before {
		box-shadow: inset 0 0 0 1.5px var(--amber);
	}
	.vs {
		display: none;
		font-size: 11.5px;
		color: var(--ink-3);
	}
	.t {
		position: relative;
		font: 500 12.5px var(--f-mono);
		color: var(--ink);
		white-space: nowrap;
	}
	.c-even .t,
	.c-none .t {
		color: var(--ink-3);
	}
	.track {
		position: relative;
		height: 8px;
		border-radius: 0 4px 4px 0;
		background: linear-gradient(var(--line), var(--line)) left / 1px 100% no-repeat;
	}
	.bar {
		display: block;
		height: 100%;
		min-width: 2px;
		border-radius: 0 4px 4px 0;
	}
	.c-calx .bar {
		background: var(--calx);
	}
	.c-other .bar {
		background: var(--rust);
	}
	.c-even .bar {
		background: var(--line-2);
	}
	.suite-foot {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: baseline;
		flex-wrap: wrap;
		margin-top: 22px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
		font-size: 13.5px;
		color: var(--ink-3);
	}
	.suite-foot a {
		font-weight: 500;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1.5px solid var(--amber);
		padding-bottom: 1px;
	}
	.suite-foot a:hover {
		border-bottom-width: 2.5px;
	}
	details summary {
		cursor: pointer;
		font: 500 13.5px var(--f-body);
		color: var(--ink-2);
	}
	details {
		min-width: 0;
		max-width: 100%;
	}
	details table {
		margin-top: 12px;
		display: block;
		max-width: 100%;
		overflow-x: auto;
	}
	.tip {
		position: fixed;
		z-index: 50;
		pointer-events: none;
		background: var(--ink);
		color: var(--paper);
		font: 500 12.5px/1.45 var(--f-body);
		padding: 8px 11px;
		border-radius: 8px;
		box-shadow: var(--shadow);
		max-width: 280px;
	}
	.tip :global(b) {
		font-family: var(--f-mono);
		font-weight: 600;
	}
	.tip[hidden] {
		display: none;
	}
	@media (max-width: 600px) {
		.suite {
			padding: 22px 16px;
		}
	}
	/* Too narrow for a row of five: the benchmark's name goes above its four cells, and the
	   tallies, which no longer line up with columns, say which language each cell is against. */
	@container suite (max-width: 620px) {
		.head {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px 14px;
		}
		.head > div:first-child {
			display: none;
		}
		.row {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 2px 10px;
			padding: 6px 0;
		}
		.lab {
			grid-column: 1 / -1;
		}
		.vs {
			display: block;
		}
	}
</style>
