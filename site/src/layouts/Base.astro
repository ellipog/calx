---
// The frame of the pages Starlight doesn't render (the home page and the 404 page): the head, the
// same header as the docs, and the theme, set before the page paints.
import Header from '../components/Header.astro';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/social.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Calx" />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<!-- Starlight's choice, under its key, or the system's. -->
		<script is:inline>
			(() => {
				let t = null;
				try {
					t = localStorage.getItem('starlight-theme');
				} catch {}
				document.documentElement.dataset.theme =
					t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
			})();
		</script>
	</head>
	<body>
		<header class="site-head"><Header /></header>
		<slot />
	</body>
</html>
