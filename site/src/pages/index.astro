---
// The home page. Its examples come from the docs and its numbers from the README, at build time,
// so the page says what the repo does at this commit.
import Base from '../layouts/Base.astro';
import CodeCard from '../components/CodeCard.astro';
import Example from '../components/Example.astro';
import PerfChart from '../components/PerfChart.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { docsIndex } from '../docs-index.mjs';
import { errorOf, fences } from '../examples.mjs';
import { buildTimes } from '../numbers.mjs';

// parallel.md: its first example, the C that example compiles to (the page's first two C blocks),
// and the first example written not to compile.
const parallel = fences('reference/parallel.md');
const calx = parallel.filter((f) => f.lang === 'calx');
const c = parallel.filter((f) => f.lang === 'c');
const example = calx[0].code;
const exampleC = `${c[0].code}\n\n// and in main, where the loop was:\n${c[1].code}`;
const failing = calx.find((f) => errorOf(f.code) !== null)?.code;
if (!failing) throw new Error('docs/reference/parallel.md has no example marked // error:');

// What stash reads and answers: the first two text blocks of the guide's first page.
const [reads, answers] = fences('guide/getting-started.md').filter((f) => f.lang === 'text');
const guide = docsIndex().find((s) => s.id === 'guide')!;

// For each promise, an example from the page it links to, found by what it shows.
function exampleIn(page: string, has: string) {
	const found = fences(page).find((f) => f.lang === 'calx' && f.code.includes(has));
	if (!found) throw new Error(`docs/${page} has no Calx example with "${has}" in it`);
	return found.code;
}
const mathExample = exampleIn('reference/floats.md', '{0.1 + 0.2}');
const ownershipExample = exampleIn('reference/ownership.md', 'was moved');
const strictExample = exampleIn('reference/strictness.md', 'value is unused');
const builds = buildTimes().map((r) => ({ ...r, command: r.label.match(/^calx \w+/)?.[0] ?? '' }));

// For search engines: the title says what Calx is in the words people search with, and the site's
// name is Calx rather than its domain (schema.org's WebSite, which Google reads for that name).
const site = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Calx',
	alternateName: 'Calx programming language',
	url: new URL('/', Astro.site).href,
};
---

<Base
	title="The Calx programming language"
	description="Calx is a general-purpose compiled language. It's memory-safe without a garbage collector, its math gives the same bits on every platform, and its parallel loops are checked when it compiles."
	jsonLd={site}
>
	<main class="home">
		<section class="hero">
			<canvas class="crystal" data-scene="hero" aria-hidden="true"></canvas>
			<div class="hero-in">
				<h1 class="hero-logo">
					<svg viewBox="0 12 399.761 92" fill="currentColor" role="img" aria-label="Calx"><use href="#logo-shapes"></use></svg>
				</h1>
				<div class="hero-under">
					<p class="tagline">A memory-safe compiled language whose programs give the same results on every machine.</p>
					<div class="cta">
						<a class="btn primary" href="/guide/install/">
							Install Calx <svg class="i" aria-hidden="true"><use href="#i-arrow"></use></svg>
						</a>
						<a class="btn" href="/guide/getting-started/">Learn Calx</a>
					</div>
					<p class="fineprint">Calx is pre-release, and you build it from source. It runs on Windows and Linux.</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="split par">
				<div class="par-copy">
					<h2 class="h">Parallel loops without data races</h2>
					<p class="intro">
						<code>parallel for</code> runs a loop's iterations on a pool of threads. The compiler rejects a loop in which one
						iteration changes data that another one uses, so the output doesn't depend on the number of threads.
					</p>
					<div class="note">Changing a variable that every iteration shares is an error:</div>
					<Example code={failing} />
					<p class="link"><a class="more" href="/reference/parallel/">Parallel loops in the reference</a></p>
				</div>
				<div class="par-code"><CodeCard calx={example} c={exampleC} file="game.calx" /></div>
			</div>
		</section>

		<section class="section">
			<h2 class="h">What else it promises</h2>
			<div class="promises">
				<div class="promise">
					<h3>Deterministic math</h3>
					<p>
						Integer and float arithmetic gives the same bits on every platform, and floats print the same way too. The rules
						are Java's.
					</p>
					<Example code={mathExample} />
					<a class="more" href="/reference/floats/">Floats</a>
				</div>
				<div class="promise">
					<h3>Memory-safe without a garbage collector</h3>
					<p>
						Every value has one owner, and the compiler frees it where the owner ends. Using a value after it has moved is an
						error.
					</p>
					<Example code={ownershipExample} />
					<a class="more" href="/reference/ownership/">Ownership</a>
				</div>
				<div class="promise">
					<h3>Strict by default</h3>
					<p>
						There are no warnings. Unused values, shadowing and silent conversions are errors, and no flag turns one off.
					</p>
					<Example code={strictExample} />
					<a class="more" href="/reference/strictness/">Strictness</a>
				</div>
				<div class="promise">
					<h3>Fast to build</h3>
					<p>CI times the compiler on every push, on the same machine as the benchmark below.</p>
					<table class="times">
						<thead>
							<tr><th></th><th>Windows</th><th>Linux</th></tr>
						</thead>
						<tbody>
							{
								builds.map((r) => (
									<tr>
										<td>
											{r.command && <code>{r.command}</code>}
											{r.label.slice(r.command.length)}
										</td>
										<td>{r.windows}</td>
										<td>{r.linux}</td>
									</tr>
								))
							}
						</tbody>
					</table>
					<a class="more" href="/reference/command/">The calx command</a>
				</div>
			</div>
		</section>

		<section class="section" id="perf">
			<h2 class="h">Faster than Rust, on our benchmark</h2>
			<p class="intro">
				We wrote the same simulation in Calx and in Rust, with the same algorithms. Both must produce the same checksum, and
				CI runs them on every push.
			</p>
			<PerfChart />
		</section>

		<section class="section">
			<div class="split learn">
				<div>
					<h2 class="h">Learn it by building one program</h2>
					<p class="intro">The guide builds <code>stash</code>, a small program that keeps an inventory. Each page adds to it.</p>
					<div class="io">
						<div><div class="cap">Input</div><pre>{reads.code}</pre></div>
						<div><div class="cap">Output</div><pre>{answers.code}</pre></div>
					</div>
				</div>
				<ol class="steps">
					{
						guide.pages.map((p) => (
							<li>
								<a href={`/${p.slug}/`}>{p.title}</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<div class="band">
			<canvas class="crystal" data-scene="band" aria-hidden="true"></canvas>
			<div class="inner">
				<div class="text">
					<h2 class="h">Built with Calx: Calcite</h2>
					<p>
						Calcite is a Minecraft Java Edition server, and the largest program written in Calx so far. It's still in
						development. The official client can log in, walk around a flat world and chat.
					</p>
					<p class="link"><a class="more" href="https://github.com/ellipog/calcite">Calcite on GitHub</a></p>
				</div>
			</div>
		</div>

		<SiteFooter />
	</main>
</Base>

<script>
	import '../scripts/crystal.js';
</script>
