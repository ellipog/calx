// `x.to_bits()` and `T.from_bits(b)`: a float's IEEE 754 bits, as Java's doubleToRawLongBits and
// longBitsToDouble.

fn main() {
    println("{1.0.to_bits()} {(-0.0).to_bits()} {f64.NAN.to_bits()}")    // out: 4607182418800017408 9223372036854775808 9221120237041090560
    println("{1.0f32.to_bits()} {(-2.5f32).to_bits()}")    // out: 1065353216 3223322624
    println("{f64.from_bits(0x7ff0000000000000)} {f64.from_bits(0x3fd0000000000000)} {f32.from_bits(1)}")    // out: Infinity 0.25 1.4E-45
    // Raw: a NaN keeps its payload.
    println("{f64.from_bits(0x7ff0000000000001).to_bits()}")    // out: 9218868437227405313
    let x = 0.1
    println("{f64.from_bits(x.to_bits()) == x}")    // out: true
}
