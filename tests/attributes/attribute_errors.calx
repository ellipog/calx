// The compiler knows `@track_caller`, `@export` and `@attribute`. The rest are functions a library
// marks `@attribute`, imported as any function is (D57, D124).

@track_caller    // error: `@track_caller` is only for a function written in Calx
struct Pos {
    x: i32
}

@message    // error: there's no attribute `@message` here
struct Msg {
    @save    // error: an attribute on a field is for the attribute on its struct to read, and `Msg` has none
    n: i32
}

interface Shape {
    fn area(self) -> i32
}

impl Shape for Pos {
    @track_caller    // error: `@track_caller` is for a function or a type's own method, not an interface's
    fn area(self) -> i32 {
        return self.x
    }
}

impl Pos {
    @track_caller(1)    // error: `@track_caller` takes no arguments
    fn twice(self) -> i32 {
        return self.x * 2
    }
    @track_caller
    @track_caller    // error: `@track_caller` is already on `half`
    fn half(self) -> i32 {
        return self.x / 2
    }
    @whatever    // error: an attribute from a library goes on a struct, an enum or a function on its own, not one in an `impl`
    fn same(self) -> i32 {
        return self.x
    }
}

fn area_of<T: Shape>(s: T) -> i32 {
    return s.area()
}

@track_caller
fn main() {    // error: `main` can't be `@track_caller`, since no Calx code calls it
    let p = Pos { x: 4 }
    let m = Msg { n: 1 }
    println("{area_of(p)} {p.twice()} {p.half()} {p.same()} {m.n}")
}
