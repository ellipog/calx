// `@track_caller` (D115): a function's panics name the place that called it, so a library's
// checks point at the code that broke the rule. One such function calling another passes its
// own caller on.

struct Grid {
    cells: List<i32>
    width: usize
}

impl Grid {
    @track_caller
    fn at(self, x: usize, y: usize) -> i32 {
        if x >= self.width {
            panic("x is {x}, but the grid is {self.width} wide")
        }
        return self.cells[y * self.width + x]
    }
}

@track_caller
fn checked<T: Copy>(xs: List<T>, i: usize) -> T {
    assert(i < xs.len(), "index {i} of {xs.len()}")
    return xs[i]
}

@track_caller
fn corner(g: Grid) -> i32 {
    return g.at(g.width, 0)
}

fn main() {
    let g = Grid { cells: [1, 2, 3, 4, 5, 6], width: 3 }
    let xs: List<i32> = [7, 8]
    let ys: List<f64> = [2.5]
    println("{g.at(2, 1)} {checked(xs, 1)} {checked<f64>(ys, 0)}")    // out: 6 8 2.5
    if g.cells.len() > 100 {
        println("{corner(g)}")
    }
    println("{g.at(3, 0)}")    // panic: x is 3, but the grid is 3 wide
}
