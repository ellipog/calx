// Calling C's own functions, which every program links with.

extern "C" fn abs(x: i32) -> i32

extern "C" {
    fn memcmp(a: *const u8, b: *const u8, n: usize) -> i32
    fn memset(to: *u8, byte: i32, n: usize) -> *u8
}

fn same_bytes(a: List<u8>, b: List<u8>) -> bool {
    if a.len() != b.len() {
        return false
    }
    return unsafe { memcmp(a.as_ptr(), b.as_ptr(), a.len()) == 0 }
}

fn main() {
    let n = unsafe { abs(-42) }
    println("{n}")    // out: 42
    let a: List<u8> = [1, 2, 3]
    let b: List<u8> = [1, 2, 3]
    let c: List<u8> = [1, 2, 4]
    println("{same_bytes(a, b)} {same_bytes(a, c)}")    // out: true false
    var d: List<u8> = [0, 0, 0, 0]
    unsafe {
        _ = memset(d.as_mut_ptr(), 0x41, 2)
    }
    println("{d}")    // out: [65, 65, 0, 0]
}
