// Floats sorted by `total_cmp`, which the runtime radix sorts as their bits (CLX-292): the same
// order the stable sort gives, -0.0 before 0.0, and every NaN last, or first descending, in the
// order they were in, their bits kept. A closure that does more is sorted by calling it.
import std.random.{Random}

fn bits(xs: List<f64>) -> List<u64> {
    return xs.map(|x| x.to_bits())
}

fn main() {
    let nan_a = f64.from_bits(0x7ff8000000000001)
    let nan_b = f64.from_bits(0xfff8000000000002)    // a negative NaN, which total_cmp still puts last
    let nan_c = f64.from_bits(0x7ff0000000000003)    // a signalling NaN
    let xs: List<f64> = [3.5, nan_a, -0.0, f64.INFINITY, 0.0, nan_b, -1.0e300, f64.NEG_INFINITY, 2.0, nan_c, -2.5, 5e-324, -5e-324]
    var up = xs.copy()
    up.sort_by(|a, b| a.total_cmp(b))
    println("{up[..10]}")    // out: [-Infinity, -1.0E300, -2.5, -4.9E-324, -0.0, 0.0, 4.9E-324, 2.0, 3.5, Infinity]
    let tail = bits(up[10..])
    println("{tail == [0x7ff8000000000001u64, 0xfff8000000000002, 0x7ff0000000000003]}")    // out: true

    var down = xs.copy()
    down.sort_by(|a, b| b.total_cmp(a))
    let head = bits(down[..3])
    println("{head == [0x7ff8000000000001u64, 0xfff8000000000002, 0x7ff0000000000003]} {down[3..]}")    // out: true [Infinity, 3.5, 2.0, 4.9E-324, 0.0, -0.0, -4.9E-324, -2.5, -1.0E300, -Infinity]

    // f32, a short list, and none.
    var fs: List<f32> = [2.5, -0.0, 1.0, 0.0, -3.0]
    fs.sort_by(|a, b| a.total_cmp(b))
    var one: List<f64> = [1.0]
    one.sort_by(|a, b| b.total_cmp(a))
    var empty: List<f64> = []
    empty.sort_by(|a, b| a.total_cmp(b))
    var arr = [2.0, -1.0, 0.0, -0.0]
    arr.sort_by(|a, b| a.total_cmp(b))
    println("{fs} {one} {empty.len()} {arr}")    // out: [-3.0, -0.0, 0.0, 1.0, 2.5] [1.0] 0 [-1.0, -0.0, 0.0, 2.0]

    // Many random values, some repeated and some NaN, sorted the same as by a closure the runtime
    // doesn't recognize, which calls total_cmp for each comparison.
    var r = Random.new(7)
    var many: List<f64> = []
    for _ in 0..100000 {
        let k = r.below(20)
        many.push(if k == 0 { f64.from_bits(0x7ff8000000000000 | r.below(1000)) } else if k == 1 { 1.5 } else { r.uniform(-1e6, 1e6) })
    }
    var fast = many.copy()
    fast.sort_by(|a, b| a.total_cmp(b))
    var slow = many.copy()
    slow.sort_by(|a, b| {
        let o = a.total_cmp(b)
        o
    })
    var fast_down = many.copy()
    fast_down.sort_by(|a, b| b.total_cmp(a))
    var slow_down = many.copy()
    slow_down.sort_by(|a, b| {
        let o = b.total_cmp(a)
        o
    })
    println("{bits(fast) == bits(slow)} {bits(fast_down) == bits(slow_down)}")    // out: true true
}
