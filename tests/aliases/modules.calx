// A `pub` type alias goes to other modules as any `pub` type does, by its name or through its
// module's, and is the type it names there too (CLX-436).
// file: main.calx
import geo.shape
import geo.shape.{Pt}

fn area(ps: shape.Path) -> f64 {
    var sum = 0.0
    for i in 0..ps.len() {
        let (x0, y0) = ps[i]
        let (x1, y1) = ps[(i + 1) % ps.len()]
        sum += x0 * y1 - x1 * y0
    }
    return sum.abs() / 2.0
}

fn main() {
    let square: List<Pt> = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0)]
    println("{area(square)}")    // out: 4.0
    let c: (f64, f64) = shape.center(square)
    println("{c}")    // out: (1.0, 1.0)
    let p: shape.Pair<str> = shape.both("a")
    let q: shape.Pair<i32> = (3, 4)
    println("{p.1} {q.0 + q.1}")    // out: a 7
}

// file: geo/shape.calx
module geo.shape

pub type Pt = (f64, f64)
pub type Path = List<Pt>
pub type Pair<T> = (T, T)

pub fn center(ps: Path) -> Pt {
    var x = 0.0
    var y = 0.0
    for (px, py) in ps {
        x += px
        y += py
    }
    let n = f64.nearest(ps.len())
    return (x / n, y / n)
}

pub fn both<T: Copy>(v: T) -> Pair<T> {
    return (v, v)
}
