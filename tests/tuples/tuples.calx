// Tuples: literals, `.0`, destructuring in `let` and `for`, and as parameters and results.
fn min_max(xs: [i32; 4]) -> (i32, i32) {
    var lo = xs[0]
    var hi = xs[0]
    for x in xs {
        lo = lo.min(x)
        hi = hi.max(x)
    }
    return (lo, hi)
}

fn swap(p: (i32, str)) -> (str, i32) {
    return (p.1, p.0)
}

fn main() {
    let (lo, hi) = min_max([4, -2, 9, 3])
    println("{lo} {hi}")                 // out: -2 9

    let t = (1, 2.5, true)
    println("{t.0} {t.1} {t.2}")         // out: 1 2.5 true

    let s = swap((7, "seven"))
    println("{s.0} {s.1}")               // out: seven 7

    // Nested tuples, with `_` to skip what isn't needed.
    let ((a, _), c) = ((1, 2), 3)
    println("{a} {c}")                   // out: 1 3
    let n = ((1, 2), 3)
    println("{n.0.1}")                   // out: 2

    // `var` makes the names it binds variables.
    var (x, y) = (1, 2)
    x += 10
    y *= 3
    println("{x} {y}")                   // out: 11 6

    var p = (0, 0)
    p.0 = 5
    p.1 = p.0 * 2
    println("{p.0} {p.1}")               // out: 5 10

    let pairs = [(1, 'a'), (2, 'b'), (3, 'c')]
    for (i, ch) in pairs {
        print("{i}{ch};")
    }
    println()                            // out: 1a;2b;3c;
}
