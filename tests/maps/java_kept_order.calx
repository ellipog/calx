// A `JavaHashMap` or `JavaHashSet` that keeps its order, `keep_order`: loops and printing go in
// the order the keys went in, the keys already there first, in Java's order. `insert` of a key
// that's there keeps its place, a new one goes last, `remove` takes a key out of the order, and
// `forget_order` goes back to Java's. Finding, `==` and `copy()` are as they are without it.

fn main() {
    var m = JavaHashMap<String, i32>()
    for name in ["stone", "dirt", "grass"] {
        m.insert(String(name), i32.wrap(name.len()))
    }
    println("{m} {m.keeps_order()}")    // out: {grass: 5, dirt: 4, stone: 5} false
    m.keep_order()
    m.insert(String("sand"), 4)
    m.insert(String("gravel"), 6)
    m.insert(String("dirt"), 40)
    println("{m} {m.keeps_order()}")    // out: {grass: 5, dirt: 40, stone: 5, sand: 4, gravel: 6} true
    _ = m.remove("dirt")
    _ = m.compute_if_absent(String("water"), 5)
    _ = m.compute_if_absent(String("stone"), 50)
    var line = String()
    for (k, v) in m {
        if v == 4 {
            continue
        }
        line.push_str(" {k}={v}")
    }
    println("[{line}]")    // out: [ grass=5 stone=5 gravel=6 water=5]
    var sum = 0
    for v in mut m.values() {
        v += 1
        sum += v
    }
    println("{sum} {m["gravel"]} {m.len()}")    // out: 30 7 5

    // A copy keeps the order; `==` doesn't look at it.
    let c = m.copy()
    var java = c.copy()
    java.forget_order()
    println("{c} {java} {c == java} {java.keeps_order()}")    // out: {grass: 6, stone: 6, sand: 5, gravel: 7, water: 6} {gravel: 7, sand: 5, grass: 6, water: 6, stone: 6} true false

    // Many keys, past a table's growth and a tree's making, stay in the order they went in.
    var big = JavaHashMap<i32, i32>()
    big.keep_order()
    for i in 0..200 {
        big.insert((199 - i) * 64, i)
    }
    for i in 0..100 {
        _ = big.remove(i * 128)
    }
    var rising = true
    var last = -1
    var n = 0
    for (_, v) in big {
        if v <= last {
            rising = false
        }
        last = v
        n += 1
    }
    println("{rising} {n} {big.contains(64)} {big.contains(128)}")    // out: true 100 true false

    // `clear` keeps the mode, empty; an empty one prints `{}`.
    big.clear()
    println("{big} {big.keeps_order()}")    // out: {} true
    big.insert(5, 1)
    big.insert(3, 2)
    println("{big}")    // out: {5: 1, 3: 2}

    var s = JavaHashSet<i32>()
    s.keep_order()
    for x in [30, 10, 20, 10] {
        s.insert(x)
    }
    println("{s}")    // out: {30, 10, 20}
}
