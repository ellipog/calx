// `OpenHashMap` and `OpenHashSet` go over their keys in fastutil 8.5.18's order (D107). The
// expected output is what fastutil gives for the same operations.
struct BlockPos {
    x: i32,
    y: i32,
    z: i32,
}

// Vanilla's `Vec3i.hashCode`.
impl JavaHash for BlockPos {
    fn java_hash(self) -> i32 {
        return (self.y + self.z * 31) * 31 + self.x
    }
}

fn count<K: JavaHash + Copy>(xs: List<K>) -> OpenHashMap<K, i32> {
    var m = OpenHashMap<K, i32>()
    for x in xs {
        if m.contains(x) {
            m[x] += 1
        } else {
            m.insert(x, 1)
        }
    }
    return m
}

fn main() {
    // `Int2IntOpenHashMap`: the key 0 comes first, then the slots from the last.
    var ints = OpenHashMap<i32, i32>()
    for i in -6..10 {
        ints.insert(i * 37, i)
    }
    println("{ints}")    // out: {0: 0, -111: -3, 111: 3, 37: 1, -37: -1, -222: -6, 222: 6, 74: 2, -74: -2, 333: 9, 296: 8, 259: 7, 185: 5, 148: 4, -185: -5, -148: -4}
    println("{ints.len()} {ints[0]} {ints.get(37)} {ints.get(1)} {ints.remove(0)} {ints.remove(0)} {ints.len()}")    // out: 16 0 some(1) none some(0) none 15
    ints[74] = 100
    ints[-37] += 5
    println("{ints}")    // out: {-111: -3, 111: 3, 37: 1, -37: 4, -222: -6, 222: 6, 74: 100, -74: -2, 333: 9, 296: 8, 259: 7, 185: 5, 148: 4, -185: -5, -148: -4}

    // `Long2ObjectOpenHashMap`, with packed positions as `BlockPos.asLong` makes them.
    var chunks = OpenHashMap<i64, String>()
    for x in -2i64..3 {
        for z in -1i64..2 {
            chunks.insert((x & 0xFFFFFFFF) | (z << 32), "c{x},{z}")
        }
    }
    println("{chunks}")    // out: {0: c0,0, 4294967296: c0,1, -4294967296: c0,-1, -4294967295: c1,-1, 4294967295: c-1,0, 8589934591: c-1,1, 4294967297: c1,1, 1: c1,0, -1: c-1,-1, 8589934590: c-2,1, -4294967294: c2,-1, 4294967294: c-2,0, 2: c2,0, -2: c-2,-1, 4294967298: c2,1}
    chunks[(1 & 0xFFFFFFFF) | (1i64 << 32)].push_str("!")
    println("{chunks.remove(0)} {chunks.len()} {chunks[(1 & 0xFFFFFFFF) | (1i64 << 32)]}")    // out: some(c0,0) 14 c1,1!

    // `Object2IntOpenHashMap<String>` and `ObjectOpenHashSet<String>`.
    var words = OpenHashMap<String, i32>()
    for w in ["stone", "dirt", "grass", "sand", "gravel", "oak_log", "water", "lava", "Aa", "BB"] {
        words.insert(String(w), i32.wrap(w.len()))
    }
    println("{words}")    // out: {lava: 4, sand: 4, stone: 5, grass: 5, oak_log: 7, water: 5, BB: 2, Aa: 2, gravel: 6, dirt: 4}
    println("{words["Aa"]} {words.contains("BB")} {words.remove("sand")} {words.remove("sand")} {words.len()}")    // out: 2 true some(4) none 9
    var names = OpenHashSet<String>()
    for w in ["stone", "dirt", "grass", "stone"] {
        names.insert(String(w))
    }
    println("{names} {names.len()}")    // out: {stone, grass, dirt} 3

    // `ObjectOpenHashSet<BlockPos>`, whose keys hash as vanilla's do.
    var ps = OpenHashSet<BlockPos>()
    for i in 0..6 {
        ps.insert(BlockPos { x: i, y: 64 - i, z: i * 2 })
    }
    var lines = String()
    for p in ps {
        if not lines.is_empty() {
            lines.push_str("; ")
        }
        lines.push_str("{p.x} {p.y} {p.z} {p.java_hash()}")
    }
    println(lines)    // out: 4 60 8 9552; 5 59 10 11444; 0 64 0 1984; 1 63 2 3876; 2 62 4 5768; 3 61 6 7660

    // The expected size and load factor pick the first table: 17 and 1 share a slot's run in a
    // table of 4, but not in one of 64.
    var small = OpenHashSet<i32>(2, 0.5)
    var big = OpenHashSet<i32>(32, 0.5)
    for k in [17, 1, 33, 49, 2] {
        small.insert(k)
        big.insert(k)
    }
    println("{small} {big}")    // out: {33, 1, 2, 49, 17} {33, 49, 17, 2, 1}

    // Removing keys halves a table that's a quarter full, which moves them; `trim` shrinks it
    // to the smallest that holds them; `clear` keeps its size.
    var grow = OpenHashSet<i64>()
    for i in 0i64..200 {
        grow.insert(i * 1000003)
    }
    for i in 0i64..190 {
        grow.remove(i * 1000003)
    }
    println("{grow}")    // out: {199000597, 191000573, 196000588, 193000579, 194000582, 197000591, 190000570, 198000594, 192000576, 195000585}
    var trimmed = OpenHashSet<i64>(1000, 0.75)
    for i in 0i64..10 {
        trimmed.insert(i * 1000003)
    }
    println("{trimmed}")    // out: {0, 1000003, 6000018, 8000024, 5000015, 2000006, 9000027, 3000009, 4000012, 7000021}
    trimmed.trim()
    println("{trimmed}")    // out: {0, 6000018, 2000006, 4000012, 3000009, 9000027, 1000003, 5000015, 7000021, 8000024}
    trimmed.clear()
    for i in 5i64..9 {
        trimmed.insert(i * 1000003)
    }
    println("{trimmed}")    // out: {6000018, 5000015, 7000021, 8000024}

    // `putAll`: room for what's coming, then the keys in the other table's order.
    var all = OpenHashMap<i32, i32>()
    all.insert(5, 0)
    var more = OpenHashMap<i32, i32>()
    for i in 0..40 {
        more.insert(i * 11, i)
    }
    all.reserve(more.len())
    for (k, v) in more {
        all.insert(k, v)
    }
    println("{all}")    // out: {0: 0, 33: 3, 132: 12, 264: 24, 165: 15, 363: 33, 330: 30, 429: 39, 407: 37, 275: 25, 143: 13, 308: 28, 319: 29, 110: 10, 352: 32, 187: 17, 22: 2, 231: 21, 286: 26, 385: 35, 242: 22, 154: 14, 55: 5, 176: 16, 11: 1, 220: 20, 198: 18, 374: 34, 341: 31, 121: 11, 77: 7, 88: 8, 5: 0, 253: 23, 418: 38, 99: 9, 44: 4, 209: 19, 66: 6, 297: 27, 396: 36}

    // Generic code, copies, `==`, and loops that stop early.
    let seen: List<i32> = [3, 0, 3, 7, 0, 3]
    let c = count(seen)
    println("{c}")    // out: {0: 2, 3: 3, 7: 1}
    let d = c.copy()
    println("{d == c} {d.len()}")    // out: true 3
    var total = 0
    for (k, v) in c {
        if k == 7 {
            continue
        }
        total += k * v
        if k == 3 {
            break
        }
    }
    println("{total}")    // out: 9
}
