// `remove_marked` on an `OpenHashMap` or an `OpenHashSet` needs one mark for each key (D173).
fn main() {
    var s = OpenHashSet<i32>()
    for k in [4, 1, 3] {
        s.insert(k)
    }
    let marks: List<bool> = [true, false, false]
    _ = s.remove_marked(marks)
    println("{s}")    // out: {1, 3}
    _ = s.remove_marked(marks)    // panic: `remove_marked` needs a mark for each key: 3 marks for 2 keys
}
