// Keys and values that own memory: replaced values, the key given for one that's there, removed
// keys and values, a cleared table and the table itself are all freed. The debug build checks.
struct Pos {
    x: i32,
    y: i32,
}

enum Block { Air, Stone, Sign(String) }

struct World {
    blocks: Map<Pos, Block>,
    names: Map<String, List<String>>,
}

fn add_name(w: mut World, key: str, name: str) {
    if not w.names.contains(key) {
        w.names.insert(String(key), List<String>())
    }
    w.names[key].push(String(name))
}

fn count<K: Hash>(xs: List<K>) -> Map<K, i32> {
    var m = Map<K, i32>()
    for x in xs {
        if m.contains(x) {
            m[x] += 1
        } else {
            m.insert(x.copy(), 1)
        }
    }
    return m
}

fn main() {
    var w = World { blocks: Map<Pos, Block>(), names: Map<String, List<String>>() }
    w.blocks.insert(Pos { x: 0, y: 0 }, Block.Stone)
    w.blocks.insert(Pos { x: 1, y: 0 }, Block.Sign(String("hello")))
    w.blocks.insert(Pos { x: 1, y: 0 }, Block.Sign(String("bye")))
    println("{w.blocks[Pos { x: 1, y: 0 }]} {w.blocks.len()}")      // out: Sign(bye) 2
    w.blocks[Pos { x: 0, y: 0 }] = Block.Air
    println("{w.blocks[Pos { x: 0, y: 0 }]}")                       // out: Air
    let gone = w.blocks.remove(Pos { x: 1, y: 0 })
    println("{gone} {w.blocks.len()}")                             // out: some(Sign(bye)) 1
    add_name(mut w, "team", "Ann")
    add_name(mut w, "team", "Bo")
    add_name(mut w, "solo", "Cy")
    println("{w.names["team"]} {w.names["solo"]}")                 // out: [Ann, Bo] [Cy]
    w.names["team"][0].push_str("ie")
    println("{w.names["team"][0]}")                                // out: Annie

    let words: List<String> = ["a", "b", "a", "c", "a"]
    let c = count(words)
    println("{c["a"]} {c["b"]} {c.len()}")                          // out: 3 1 3
    let pairs: List<(i32, bool)> = [(1, true), (1, true), (2, false)]
    let d = count(pairs)
    println("{d[(1, true)]} {d[(2, false)]}")                      // out: 2 1

    // A copy is its own table; `==` doesn't care about order.
    var e = c.copy()
    e["a"] = 0
    println("{c["a"]} {e["a"]} {c == e}")                          // out: 3 0 false
    e["a"] = 3
    println("{c == e}")                                            // out: true
    var f = Map<String, i32>()
    f.insert("c", 1)
    f.insert("b", 1)
    f.insert("a", 3)
    println("{c == f}")                                            // out: true
    f.clear()
    println("{f} {f.len()}")                                       // out: {} 0
    f.insert("only", 1)
    println("{f}")                                                 // out: {only: 1}
    var s = Set<String>()
    s.insert("x")
    s.insert(String("x"))
    println("{s} {s.contains("x")}")                               // out: {x} true
}
