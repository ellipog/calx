fn main() {
    let u: u32 = 5
    let b = true
    let s: i16 = 3
    let x = 7
    let f = 1.5
    let _a = -u                      // error: an unsigned `u32` can't be negated
    let _b = ~b                      // error: `~` is for integers; negate a bool with `not`
    let _c = b & b                   // error: for bools use `and`
    let _d = s << 2                  // error: shifts work on i32, i64, u32 and u64
    let _e = u >>> 1                 // error: `>>>` is the same as `>>` on an unsigned type
    let _f = x << 32                 // error: a constant shift count must be from 0 to 31
    let _g = x / 0                   // error: division by zero
    let _h = f == f64.NAN            // error: comparing with NaN is always false
    let _i = i32.MAX + 1             // error: this constant expression overflows `i32`
    let _j = x + f                   // error: expected `i32`, found `f64`
    let _k = u.abs()                 // error: is never negative; remove `.abs()`
}
