impl Counter {
    pub fn new() -> Counter {
        return Counter { hits: 0 }
    }
    pub fn bump(c: mut Counter) {
        c.hits += 1
    }
    pub fn get(self) -> i32 {
        return self.hits
    }
    fn reset(c: mut Counter) {
        c.hits = 0
    }
}

pub fn use_all(s: Sealed) -> i32 {
