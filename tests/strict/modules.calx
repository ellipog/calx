// file: util.calx
pub const LIMIT: i32 = 10

pub interface Show {
    fn show(self) -> i32
}

pub fn twice(n: i32) -> i32 {
    return n * 2
}

fn secret() -> i32 {
    return 1
}

pub struct Point {
    pub x: i32
}

pub struct Counter {
    hits: i32
}

pub struct Sealed {
    key: i32
}

struct Hidden {
    v: i32
}

