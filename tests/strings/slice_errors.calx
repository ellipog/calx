// What slicing text doesn't allow (D117).

fn main() {
    var s = String("hello")
    s.push('!')
    s[1..3] = "x"    // error: a part of a text can't be changed where it is; build a new `String` from the parts
    s[1..].push('x')    // error: `push` changes `String`, so call it on a variable
    let xs: List<i32> = [1, 2, 3]
    println("{xs[0..2]}")    // error: `List<i32>` can't be sliced; only text can be, by byte offsets, for now
    println("{"abc"[2..1]}")    // error: the range starts after it ends
    println("{"abc"[0..5]}")    // error: byte 5 is past the end of the text, which is 3 bytes long
    println("{"abc"[4..]}")    // error: byte 4 is past the end of the text, which is 3 bytes long
    println("{"aé"[2..]}")    // error: byte 2 is inside a rune, not where one starts
    println("{"aé"[..=1]}")    // error: byte 2 is inside a rune, not where one starts
    let n: i32 = 1
    println("{s[n..]}")    // error: expected `usize`, found `i32`; keep the low bits with `usize.wrap(...)`, as Java's cast does
    let v: str = s[1..]    // error: expected `str`, found `String`; take a `String` here instead
    println("{v} {s[..=]}")    // error: `..=` needs the byte it goes up to
    println("{5.to_lower_root()}")    // error: `i32` has no method `to_lower_root`
}
