// `{x:spec}`: a fill, an alignment and a width, a sign, zeros, groups of digits, a precision, and
// hex, octal, binary, scientific and percent (CLX-93). The grouped and zero-padded numbers are as
// Python writes them, and the rounded floats as Python and Rust do.

struct Point {
    x: i32,
    y: i32,
}

enum Color {
    Red,
    Green,
}

fn main() {
    // Integers: right-aligned unless the format says, with a fill, zeros after the sign, a sign
    // on the others too, and groups of three.
    let n = 1234567
    let neg = -42
    println("[{n:>10}] [{n:<10}] [{n:^10}] [{n:*^11}] [{n:010}] [{neg:06}] [{neg:+}] [{n:+}] [{n:,}] [{n:_}]")    // out: [   1234567] [1234567   ] [ 1234567  ] [**1234567**] [0001234567] [-00042] [-42] [+1234567] [1,234,567] [1_234_567]
    println("[{1234:09,}] [{1234:08,}] [{-1234:010,}] [{-5:+05}] [{5:+05}] [{123456789:_}]")    // out: [0,001,234] [0,001,234] [-0,001,234] [-0005] [+0005] [123_456_789]
    // Hex, octal and binary, with `#` for the prefix and `_` for groups of four. A negative
    // number is written as its bits, as Java's `toHexString` writes it.
    println("[{255:x}] [{255:X}] [{255:#x}] [{255:#X}] [{255:#010x}] [{255:#010_x}] [{5:b}] [{5:#b}] [{8:o}] [{8:#o}] [{0xdeadbeefu32:_x}]")    // out: [ff] [FF] [0xff] [0xFF] [0x000000ff] [0x000_00ff] [101] [0b101] [10] [0o10] [dead_beef]
    let m1: i32 = -1
    let m8: i8 = -1
    let m16: i16 = -2
    println("[{m1:x}] [{m8:x}] [{m8:b}] [{m16:X}] [{u64.MAX:x}] [{i64.MIN}] [{i64.MIN:,}] [{0xdeadbeefu32:_b}]")    // out: [ffffffff] [ff] [11111111] [FFFE] [ffffffffffffffff] [-9223372036854775808] [-9,223,372,036,854,775,808] [1101_1110_1010_1101_1011_1110_1110_1111]

    // Floats: `.N` rounds the exact value to N digits after the point, ties to even.
    let x = 3.14159265
    println("[{x:.2}] [{x:8.3}] [{x:<8.1}] [{x:08.2}] [{-x:08.2}] [{x:+.3}] [{x:.0}] [{2.5:.0}] [{3.5:.0}] [{0.125:.2}] [{2.675:.2}]")    // out: [3.14] [   3.142] [3.1     ] [00003.14] [-0003.14] [+3.142] [3] [2] [4] [0.12] [2.67]
    println("[{1234567.891:015,.2}] [{-0.5:08.3}] [{1234567.891:,.2}] [{1234567.891:,}] [{1.0e20:.1}] [{123456789.0:.0}] [{1.0e-7:.3}] [{-0.0:.2}]")    // out: [0,001,234,567.89] [-000.500] [1,234,567.89] [1,234,567.891] [100000000000000000000.0] [123456789] [0.000] [-0.00]
    // Scientific notation, as Rust writes it: the shortest digits, or `.N` after the point.
    println("[{x:e}] [{x:.3e}] [{1234.5:e}] [{0.00012:E}] [{1.0e100:.3e}] [{0.0:e}] [{0.0:.2e}] [{9.99:.1e}] [{1.0:e}]")    // out: [3.14159265e0] [3.142e0] [1.2345e3] [1.2E-4] [1.000e100] [0e0] [0.00e0] [1.0e1] [1e0]
    // Percent: the exact value a hundred times larger.
    println("[{0.125:%}] [{0.5:%}] [{0.1234:.1%}] [{1.0:.0%}] [{0.07:>6.1%}] [{-0.25:%}]")    // out: [12.5%] [50%] [12.3%] [100%] [  7.0%] [-25%]
    // Without a precision a float is written as `{x}` writes it, padded, and right-aligned as
    // every number is unless the format says.
    let inf = 1.0 / 0.0
    let nan = 0.0 / 0.0
    println("[{x:12}] [{x:<12}] [{1.0e10:>10}] [{inf:9}] [{-inf:010.2}] [{nan:+.2}] [{nan:>5}]")    // out: [  3.14159265] [3.14159265  ] [    1.0E10] [ Infinity] [ -Infinity] [NaN] [  NaN]
    println("[{f32.from_bits(1):e}] [{(0.1f32):.10}] [{1.5f32:+}] [{(2.5f32):.0}] [{(1.0f32 / 3.0f32):.3e}]")    // out: [1e-45] [0.1000000015] [+1.5] [2] [3.333e-1]
    // The smallest subnormals: `{x}` writes Java's closest of one or two digits, and `{x:e}` the
    // one digit that reads back, as Rust and Python do.
    println("[{f64.from_bits(1)}] [{f64.from_bits(1):e}] [{f32.from_bits(1)}] [{f64.from_bits(3):e}]")    // out: [4.9E-324] [5e-324] [1.4E-45] [1.5e-323]

    // Text, runes and anything else: a fill, an alignment and a width, in runes, and for text the
    // most runes to write.
    let s = "héllo"
    println("[{s:8}] [{s:>8}] [{s:^9}] [{s:.3}] [{s:-^9.2}] [{String("ab"):_>4}] [{s:2}]")    // out: [héllo   ] [   héllo] [  héllo  ] [hél] [---hé----] [__ab] [héllo]
    println("[{true:>6}] [{false:<6}] [{'é':3}] [{'x':*^5}] [{Color.Green:>7}] [{Point { x: 1, y: 2 }:>22}]")    // out: [  true] [false ] [é  ] [**x**] [  Green] [  Point { x: 1, y: 2 }]
    let xs: List<i32> = [1, 2, 3]
    let maybe: i32? = some(5)
    println("[{xs:<12}] [{maybe:>8}] [{(1, "a"):>10}] [{xs.len():03}]")    // out: [[1, 2, 3]   ] [ some(5)] [    (1, a)] [003]
    // A part of a text, and a fill that isn't ASCII.
    let line = String("key=value")
    println("[{line[..3]:>5}] [{line[4..]:→<8}] [{n:·>10,}]")    // out: [  key] [value→→→] [·1,234,567]

    // Formats work wherever interpolation does: building a string, pushing onto one, and panics.
    var table = String()
    for (name, score) in [("ann", 9.5), ("bo", 12.25)] {
        table.push_str("{name:<5}|{score:>6.2}\n")
    }
    print(table)    // out: ann  |  9.50
    // out: bo   | 12.25
    let built = "{n:>9,}|{x:.4}"
    println("{built} {built.len()}")    // out: 1,234,567|3.1416 16
}
