fn sign(x: i32) -> i32 {
    if x < 0 {
        return -1
    } else if x == 0 {
        return 0
    }
    return 1
}

fn main() {
    println("{sign(-5)} {sign(0)} {sign(9)}")    // out: -1 0 1
    let x = 7
    let kind = if x % 2 == 0 { "even" } else { "odd" }
    println("{kind}")                            // out: odd
    let size = if x < 5 {
        let half = x / 2
        half
    } else if x < 10 {
        x * 10
    } else {
        0
    }
    println("{size}")                            // out: 70
    if x > 5 and not (x > 100) {
        println("between")                       // out: between
    }
}
