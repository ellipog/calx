// `for x in it` over a type that implements `Iterator<T>` (CLX-101): `next` until it gives
// `none`, each value the pass's own.

struct Counter {
    n: i32
    end: i32
}

impl Iterator<i32> for Counter {
    fn next(mut self) -> i32? {
        if self.n >= self.end {
            return none
        }
        self.n += 1
        return some(self.n)
    }
}

// Values that own memory, which each pass drops unless it moves them.
struct Words {
    parts: List<String>
    at: usize
}

impl Iterator<String> for Words {
    fn next(mut self) -> String? {
        if self.at >= self.parts.len() {
            return none
        }
        self.at += 1
        return some("<{self.parts[self.at - 1]}>")
    }
}

fn words(text: str) -> Words {
    return Words { parts: text.split(" "), at: 0 }
}

struct Repeat<T> {
    value: T
    left: usize
}

impl<T: Copy> Iterator<T> for Repeat<T> {
    fn next(mut self) -> T? {
        if self.left == 0 {
            return none
        }
        self.left -= 1
        return some(self.value)
    }
}

struct Holder {
    it: Repeat<i32>
}

impl Holder {
    fn drain(mut self) -> i32 {
        var t = 0
        for x in self.it {
            t += x
        }
        return t
    }
}

fn total<I: Iterator<i32>>(it: mut I) -> i32 {
    var t = 0
    for x in it {
        t += x
    }
    return t
}

fn keep(s: own String) -> usize {
    return s.len()
}

fn main() {
    // A value made for the loop, which the loop holds.
    var seen: List<i32> = []
    for x in (Counter { n: 0, end: 3 }) {
        seen.push(x)
    }
    println("{seen}")                        // out: [1, 2, 3]

    // A variable, which the loop changes.
    var c = Counter { n: 10, end: 13 }
    seen.clear()
    for x in c {
        seen.push(x)
    }
    println("{seen} {c.n}")                  // out: [11, 12, 13] 13
    var d = Counter { n: 0, end: 4 }
    println("{total(mut d)}")                // out: 10

    var kept: List<String> = []
    for w in words("x y z") {
        if w == "<y>" {
            continue
        }
        kept.push(w)
    }
    println("{kept}")                        // out: [<x>, <z>]
    for w in words("p q r") {
        if w == "<q>" {
            break
        }
        println(w)                           // out: <p>
    }
    var n: usize = 0
    for w in words("s t") {
        n += keep(w)
    }
    println("{n}")                           // out: 6
    var passes = 0
    for _ in words("u v") {
        passes += 1
    }
    println("{passes}")                      // out: 2
    for (i, w) in words("m n").enumerate() {
        println("{i}{w}")
    }
    // out: 0<m>
    // out: 1<n>

    var letters = String()
    for r in (Repeat { value: 'z', left: 3 }) {
        letters.push(r)
    }
    var h = Holder { it: Repeat { value: 5, left: 4 } }
    println("{letters} {h.drain()} {h.it.left}")  // out: zzz 20 0
}
