// Division truncates toward zero, and MIN / -1 is MIN, as in Java.
fn main() {
    let a = -7
    let b = 2
    println("{a / b} {a % b} {7 / -2} {7 % -2}")              // out: -3 -1 -3 1
    println("{a.floor_div(b)} {a.floor_mod(b)} {7.floor_mod(-2)}")   // out: -4 1 -1
    let min = i32.MIN
    let minus_one = -1
    println("{min / minus_one} {min % minus_one}")            // out: -2147483648 0
    let lmin = i64.MIN
    let lm1 = -1i64
    println("{lmin / lm1}")                                   // out: -9223372036854775808
    let small: i8 = -128
    let sm1: i8 = -1
    println("{small / sm1} {small % sm1}")                    // out: -128 0
    let u: u32 = 4000000000
    println("{u / 3u32} {u % 7u32}")                          // out: 1333333333 3
}
