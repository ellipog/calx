// Shift counts are masked as in Java, and `>>>` is a logical shift.
fn main() {
    println("{1 << 31} {-8 >> 1} {-1 >>> 1} {-16 >>> 28}")    // out: -2147483648 -4 2147483647 15
    println("{1i64 << 63} {-1i64 >>> 60}")                    // out: -9223372036854775808 15
    let n = 33
    let minus = -1
    println("{1 << n} {1 << minus} {1i64 << n}")              // out: 2 -2147483648 8589934592
    let u = 0x80000000u32
    println("{u >> 31} {u >> n}")                             // out: 1 1073741824
    let count: u8 = 4
    println("{1 << count}")                                   // out: 16
}
