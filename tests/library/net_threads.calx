// std.net's loops on threads a library starts, through the program's runtime (D123, CLX-386): the
// library runs a std.http.server on one thread and a std.http.websocket client to it on another,
// trades messages both ways and closes, and joins both, while the program runs a `Net` of its own
// on a thread of its own, echoing a burst at itself. All of the library's part is in `pair`, so
// any program that can call it, however it's linked to the library, can run the same test.
// lib: plugin.calx
// file: main.calx
import std.env.{args}
import std.net.{Event, Net}
import std.thread.{Task}

// Sends 100 lines to itself, each echoed back before the next.
struct Echo {
    out: Sender<String>
}

impl Task for Echo {
    fn run(own self) {
        var out = self.out
        let net = Net.new()!
        let port = net.listen("127.0.0.1", 0)!
        let client = net.connect("127.0.0.1", port)!
        var events = List<Event>()
        var back: usize = 0
        var got = List<u8>()
        while back < 100 {
            net.poll(10000, mut events)
            if events.is_empty() {
                break
            }
            for e in events {
                match e {
                    Connected(c) => net.write(c, "line 0\n".to_bytes()),
                    Received(c) => {
                        if c == client {
                            _ = net.read(c, mut got)
                            if got.len() > 0 and got[got.len() - 1] == 10 {
                                back += 1
                                got.clear()
                                net.write(c, "line {back}\n".to_bytes())
                            }
                        } else {
                            var bytes = List<u8>()
                            _ = net.read(c, mut bytes)
                            net.write(c, bytes)
                        }
                    }
                    _ => {}
                }
            }
        }
        out.send("program: {back} lines back")
    }
}

fn main() {
    let given = args()
    let lib = unsafe { Library.open(given[0])! }
    let pair = lib.find<fn() -> String>("pair")!
    var out = Receiver<String>()
    let echo = unsafe { Thread.spawn(Echo { out: out.sender() }) }
    println(pair())
    // out: client: hello, 20 answers right, binary [3, 2, 1]
    // out: server: 20 texts, 1 binary, closed 1000 bye
    echo.join()
    println(out.next() ?? String())    // out: program: 100 lines back
}

// file: plugin.calx
import std.http.server.{Server}
import std.http.websocket.{Message, connect}
import std.thread.{Task}

struct Serving {
    port: Sender<u16>
    log: Sender<String>
}

impl Task for Serving {
    fn run(own self) {
        var port = self.port
        var log = self.log
        var server = Server.listen(0)!
        port.send(server.port)
        var texts: usize = 0
        var binaries: usize = 0
        loop {
            match server.next_event(20000) {
                some(Request(req)) => {
                    let s = server.upgrade(req)!
                    _ = server.send_text(s, "hello")
                },
                some(Message(s, Text(t))) => {
                    texts += 1
                    _ = server.send_text(s, "{t} back")
                },
                some(Message(s, Binary(b))) => {
                    binaries += 1
                    var back = List<u8>()
                    var i = b.len()
                    while i > 0 {
                        i -= 1
                        back.push(b[i])
                    }
                    _ = server.send_binary(s, back)
                },
                some(Closed(_, code, why)) => {
                    log.send("server: {texts} texts, {binaries} binary, closed {code} {why}")
                    break
                },
                some(_) => {},
                none => {
                    log.send("server: nothing for 20 seconds")
                    break
                },
            }
        }
        server.shutdown()
    }
}

struct Client {
    port: u16
    log: Sender<String>
}

fn text_of(m: own Message?) -> String {
    return match m {
        some(Text(t)) => t,
        some(Binary(_)) => String("<binary>"),
        none => String("<nothing>"),
    }
}

impl Task for Client {
    fn run(own self) {
        var log = self.log
        let ws = connect("ws://127.0.0.1:{self.port}/")!
        let hello = text_of(ws.receive(20000)!)
        var right: usize = 0
        for i in 0usize..10 {
            ws.send_text("one {i}")!
            if text_of(ws.receive(20000)!) == "one {i} back" {
                right += 1
            }
        }
        for i in 0usize..10 {
            ws.send_text("many {i}")!
        }
        for i in 0usize..10 {
            if text_of(ws.receive(20000)!) == "many {i} back" {
                right += 1
            }
        }
        let bytes: List<u8> = [1, 2, 3]
        ws.send_binary(bytes)!
        let reversed = match ws.receive(20000)! {
            some(Binary(b)) => b,
            _ => List<u8>(),
        }
        ws.close(1000, "bye")
        log.send("client: {hello}, {right} answers right, binary {reversed}")
    }
}

@export
fn pair() -> String {
    var ports = Receiver<u16>()
    var log = Receiver<String>()
    let server = unsafe { Thread.spawn(Serving { port: ports.sender(), log: log.sender() }) }
    let port = ports.wait() ?? 0
    let client = unsafe { Thread.spawn(Client { port: port, log: log.sender() }) }
    client.join()
    server.join()
    var lines = List<String>()
    while let line = log.next() {
        lines.push(line)
    }
    lines.sort()
    return lines.join("\n")
}
