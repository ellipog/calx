// Parameters are read-only views unless they're `mut`; `mut` ones change the caller's value.
struct Bin {
    items: [i32; 4]
    count: i32
}

fn add(b: mut Bin, item: i32) {
    b.items[usize.wrap(b.count)] = item
    b.count += 1
}

fn total(b: Bin) -> i32 {
    var sum = 0
    for x in b.items {
        sum += x
    }
    return sum
}

fn bump(n: mut i32) {
    n += 1
}

fn main() {
    var b = Bin { items: [0; 4], count: 0 }
    add(mut b, 5)
    add(mut b, 7)
    println("{b.count} {total(b)}")      // out: 2 12
    var n = 41
    bump(mut n)
    println("{n}")                       // out: 42
}
