// std.json.schema's formats: what jsonschema 4.26's `FormatChecker()` checks with no format library
// installed, `date`, `email`, `idn-email`, `ipv4`, `ipv6`, `regex`, `time` and `uuid`, what it
// checks with `jsonschema[format-nongpl]` too, and the checks of std.json.schema.formats on their
// own (CLX-226). Each line expected below is what jsonschema printed for the same schema and values.

import std.json
import std.json.schema.{Draft, Validator}
import std.json.schema.formats
import std.json.schema.formats.{FormatChecker}

fn main() {
    var props = List<String>()
    for f in ["date", "email", "idn-email", "ipv4", "ipv6", "regex", "time", "uuid", "hostname"] {
        props.push("\"{f}\": \{\"format\": \"{f}\"\}")
    }
    let schema = json.parse("\{\"properties\": \{{props.join(", ")}\}\}")!
    var v = Validator.new(schema, Draft.Draft202012).with_formats()
    let bad = json.parse(#"{"date": "2019-02-29", "email": "nobody", "idn-email": "nobody", "ipv4": "1.2.03.4", "ipv6": "fe80::1%eth0", "regex": "a(", "time": "12:00:60", "uuid": "0123456789abcdef0123456789abcdef", "hostname": "-not-checked-"}"#)!
    for e in v.iter_errors(bad)! {
        println("{e.json_path()} {e.message}")
    }
    // out: $.date '2019-02-29' is not a 'date'
    // out: $.email 'nobody' is not a 'email'
    // out: $['idn-email'] 'nobody' is not a 'idn-email'
    // out: $.ipv4 '1.2.03.4' is not a 'ipv4'
    // out: $.ipv6 'fe80::1%eth0' is not a 'ipv6'
    // out: $.regex 'a(' is not a 'regex'
    // out: $.time '12:00:60' is not a 'time'
    // out: $.uuid '0123456789abcdef0123456789abcdef' is not a 'uuid'
    let good = json.parse(#"{"date": "2020-02-29", "email": "a@b", "idn-email": "실례@실례.테스트", "ipv4": "0.0.0.0", "ipv6": "::ffff:1.2.3.4", "regex": "a+", "time": " 5:06:07", "uuid": "01234567-89ab-cdef-0123-456789abcdef"}"#)!
    println("{v.is_valid(good)!}")                                              // out: true
    // Without `with_formats`, a format is only a note.
    var plain = Validator.new(schema, Draft.Draft202012)
    println("{plain.is_valid(bad)!}")                                           // out: true

    // Python's `strptime` takes any Unicode digit, and `uuid.UUID` reads its hex with `int`.
    println("{formats.is_time("1\u{663}:00:00")} {formats.is_time("24:00:00")}")    // out: true false
    println("{formats.is_uuid("+1234567-89ab-cdef-0123-456789abcdef")}")           // out: true
    println("{formats.is_uuid("01234567-89ab-cdef-0123_456789abcdef")}")           // out: false
    println("{formats.is_uuid("\u{660}1234567-89ab-cdef-0123-456789abcdef")}")     // out: true
    println("{formats.is_ipv6("1:2:3:4:5:6:1.2.3.4")} {formats.is_ipv6("1::2::3")}")  // out: true false
    println("{formats.is_ipv4("256.0.0.0")} {formats.is_date("0000-01-01")}")       // out: false false
    println("{formats.is_email("a@b")} {formats.is_date("2000-02-29")}")            // out: true true

    // With the libraries of `jsonschema[format-nongpl]` too: `with_all_formats`.
    var lib = List<String>()
    for f in ["color", "date-time", "duration", "hostname", "idn-hostname", "iri", "iri-reference", "json-pointer", "relative-json-pointer", "uri", "uri-reference", "uri-template"] {
        lib.push("\"{f}\": \{\"format\": \"{f}\"\}")
    }
    let schema2 = json.parse("\{\"properties\": \{{lib.join(", ")}\}\}")!
    var all = Validator.new(schema2, Draft.Draft202012).with_all_formats()
    let bad2 = json.parse(##"{"color": "#abcd", "date-time": "1985-04-12T23:20:50", "duration": "P1Y1W", "hostname": "-a.b", "idn-hostname": "Exämple.com", "iri": "http://a b", "iri-reference": "\\", "json-pointer": "a/b", "relative-json-pointer": "-1", "uri": "/a/b", "uri-reference": "http://[::1", "uri-template": "{a"}"##)!
    for e in all.iter_errors(bad2)! {
        println("{e.json_path()} {e.message}")
    }
    // out: $.color '#abcd' is not a 'color'
    // out: $['date-time'] '1985-04-12T23:20:50' is not a 'date-time'
    // out: $.duration 'P1Y1W' is not a 'duration'
    // out: $.hostname '-a.b' is not a 'hostname'
    // out: $['idn-hostname'] 'Exämple.com' is not a 'idn-hostname'
    // out: $.iri 'http://a b' is not a 'iri'
    // out: $['iri-reference'] '\\' is not a 'iri-reference'
    // out: $['json-pointer'] 'a/b' is not a 'json-pointer'
    // out: $['relative-json-pointer'] '-1' is not a 'relative-json-pointer'
    // out: $.uri '/a/b' is not a 'uri'
    // out: $['uri-reference'] 'http://[::1' is not a 'uri-reference'
    // out: $['uri-template'] '{a' is not a 'uri-template'
    let good2 = json.parse(##"{"color": "DarkKhaki", "date-time": "1985-04-12t23:20:50.52z", "duration": "P1Y2M3DT4H5M6.5S", "hostname": "xn--bcher-kva.example", "idn-hostname": "bücher.example", "iri": "http://ü.example/ä?é#ö", "iri-reference": "//ü/", "json-pointer": "/a~0b/c~1d", "relative-json-pointer": "1/a", "uri": "urn:isbn:0451450523", "uri-reference": "../c", "uri-template": "http://example.com/{id}{?q,r}"}"##)!
    println("{all.is_valid(good2)!}")                                           // out: true
    // A number too big for a `Decimal` raises from Python's check, and so it fails here.
    match all.is_valid(json.parse(#"{"duration": "P1e1000000D"}"#)!) {
        ok(b) => println("{b}"),
        err(f) => println("{f.kind} {f}"),                                      // out: Overflow [<class 'decimal.Overflow'>]
    }

    // `FormatChecker` on its own, as jsonschema's: the Kelvin sign lowercases to `k`, `$` matches
    // before a newline at the end, and `relative-json-pointer` reads a second digit's first with `int`.
    var fc = FormatChecker.with_libraries()
    println("{fc.conforms("dar\u{212a}khaki", "color")!} {fc.conforms("a.b\n", "hostname")!}")  // out: true true
    println("{fc.conforms("1985-04-12T23:20:50Z\n", "date-time")!} {fc.conforms("a:\n", "uri")!}")  // out: true true
    println("{fc.conforms("a:\n", "iri")!} {fc.conforms("P0Y1W", "duration")!}")    // out: false true
    println("{fc.conforms("\u{b2}/a", "relative-json-pointer")!}")               // out: true
    match fc.conforms("\u{b2}3", "relative-json-pointer") {
        ok(b) => println("{b}"),
        err(f) => println("{f.kind}: {f}"),                                     // out: ValueError: invalid literal for int() with base 10: '²'
    }
    // Without the libraries, those formats pass.
    var alone = FormatChecker.new()
    println("{alone.conforms("-a.b", "hostname")!}")                           // out: true
}
