// std.net's send_file: a range of a file sent after what was written before it, with what's
// written after it following it, from a handle the runtime keeps after the program closes the
// file; one file at a time on a connection; a range past the end of the file closing the
// connection where the file ends; and a client that goes while a file is sent to it, which ends
// the connection, not the program, as Linux's SIGPIPE would.
import std.fs.{open_read, remove_dir_all, temp_dir, write}
import std.net.{Event, Net}

const SIZE: usize = 3000000
const FROM: usize = 1000
const COUNT: usize = 2500000

fn pattern(i: usize) -> u8 {
    return u8.wrap(i * 7 + i / 1000)
}

fn main() {
    let dir = temp_dir()!
    let path = "{dir}/data.bin"
    var data = List<u8>()
    for i in 0usize..SIZE {
        data.push(pattern(i))
    }
    write(path, data)!

    let head = "head:".to_bytes()
    let tail = "tail".to_bytes()
    var expect = head.copy()
    for i in FROM..FROM + COUNT {
        expect.push(pattern(i))
    }
    for b in tail {
        expect.push(b)
    }

    let net = Net.new()!
    let port = net.listen("127.0.0.1", 0)!
    // Per slot: 0 unused, 1 the whole range's client, 2 the short range's, 3 a server's end, 4 a
    // client that goes at once.
    var role = [0; 16]
    var got = [0usize; 16]
    var wrong = 0
    let whole = net.connect("127.0.0.1", port)!
    role[whole.slot()] = 1
    var accepted = 0
    var empty = false
    var short = false
    var left = false
    var closed = 0
    var events = List<Event>()
    var buf = List<u8>()
    var polls = 0
    while closed < 6 and polls < 100000 {
        net.poll(1000, mut events)
        polls += 1
        for e in events {
            match e {
                Accepted(c) => {
                    role[c.slot()] = 3
                    accepted += 1
                    let f = open_read(path)!
                    if accepted == 1 {
                        net.write(c, head)
                        println("first: {net.send_file(c, f, u64(FROM), u64(COUNT))}")    // out: first: true
                        println("second: {net.send_file(c, f, 0, 10)}")                   // out: second: false
                        net.write(c, tail)
                        println("queued: {net.queued(c)}")                                 // out: queued: 2500009
                        // The runtime has a handle of its own, so the program's can go.
                        f.close()!
                        net.close(c)
                    } else if accepted == 2 {
                        // Printed when its client has closed, after the first connection's lines.
                        empty = net.send_file(c, f, 0, 0)
                        short = net.send_file(c, f, u64(SIZE - 1000), 5000)
                        f.close()!
                    } else {
                        // More than the system holds for a connection, so it's still being sent
                        // when the client has gone.
                        left = net.send_file(c, f, 0, u64(SIZE))
                        f.close()!
                    }
                }
                Connected(c) => {
                    if role[c.slot()] == 4 {
                        net.close(c)
                    }
                }
                Received(c) => {
                    buf.clear()
                    _ = net.read(c, mut buf)
                    let s = c.slot()
                    for b in buf {
                        if role[s] == 1 {
                            if got[s] >= expect.len() or b != expect[got[s]] {
                                wrong += 1
                            }
                        } else if role[s] == 2 {
                            if b != pattern(SIZE - 1000 + got[s]) {
                                wrong += 1
                            }
                        }
                        got[s] += 1
                    }
                }
                Closed(c) => {
                    closed += 1
                    if role[c.slot()] == 1 {
                        println("whole range: {got[c.slot()]} bytes")                     // out: whole range: 2500009 bytes
                        let again = net.connect("127.0.0.1", port)!
                        role[again.slot()] = 2
                    } else if role[c.slot()] == 2 {
                        println("empty: {empty}")                                            // out: empty: true
                        println("short: {short}")                                            // out: short: true
                        println("short range: at most 1000 bytes: {got[c.slot()] <= 1000}") // out: short range: at most 1000 bytes: true
                        let gone = net.connect("127.0.0.1", port)!
                        role[gone.slot()] = 4
                    }
                }
                Woken => {}
            }
        }
    }
    println("sent to a client that went: {left}")    // out: sent to a client that went: true
    println("{wrong} wrong bytes, {closed} closed")    // out: 0 wrong bytes, 6 closed
    remove_dir_all(dir)!
}
