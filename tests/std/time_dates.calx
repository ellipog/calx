// std.time's dates: checking, arithmetic, strftime and strptime codes, and ISO 8601 (CLX-103).
// Python's datetime gives the same for each, except where a comment says otherwise.

import std.time.{DateTime, Timestamp}
import std.time

fn show(d: DateTime?) -> String {
    if let x = d {
        return x.iso()
    }
    return "none"
}

fn showt(t: Timestamp?) -> String {
    if let x = t {
        return "{x.unix_ms}"
    }
    return "none"
}

fn main() {
    // Checking.
    println("{time.is_leap(2024)} {time.is_leap(1900)} {time.is_leap(2000)} {time.is_leap(2026)}")  // out: true false true false
    println("{time.days_in_month(2024, 2)} {time.days_in_month(2026, 2)} {time.days_in_month(2026, 4)} {time.days_in_month(2026, 12)}")  // out: 29 28 30 31
    println("{show(DateTime.new(2026, 2, 29))} {show(DateTime.new(2024, 2, 29))} {show(DateTime.new(2026, 13, 1))}")  // out: none 2024-02-29T00:00:00 none
    println("{show(DateTime.new(2026, 1, 1, 24))} {show(DateTime.new(2026, 1, 1, 0, 60))} {show(DateTime.new(2026, 1, 1, 0, 0, 0, 1000))}")  // out: none none none
    let bad = DateTime { year: 2026, month: 4, day: 31, hour: 0, minute: 0, second: 0, milli: 0 }
    println("{bad.is_valid()}")                                                                // out: false

    // Arithmetic.
    let d = DateTime.new(2026, 11, 8, 14, 5, 9, 250)!
    println("{d.iso()} {d.weekday()} {d.day_of_year()}")                                      // out: 2026-11-08T14:05:09.250 6 312
    println("{d.timestamp(3600).unix_ms} {d.timestamp(3600).date_time(3600).iso()}")           // out: 1794143109250 2026-11-08T14:05:09.250
    println("{d.add_days(-400).iso()} {d.add_days(54).iso()}")                                // out: 2025-10-04T14:05:09.250 2027-01-01T14:05:09.250
    println("{DateTime.new(2026, 1, 31)!.add_months(1).iso()} {DateTime.new(2024, 1, 31)!.add_months(1).iso()}")  // out: 2026-02-28T00:00:00 2024-02-29T00:00:00
    println("{DateTime.new(2026, 3, 31)!.add_months(-13).iso()} {d.add_months(14).iso()}")    // out: 2025-02-28T00:00:00 2028-01-08T14:05:09.250
    println("{DateTime.new(2000, 12, 31)!.day_of_year()} {DateTime.new(1970, 1, 1)!.weekday()}")  // out: 366 3

    // Formatting, by strftime's codes.
    println(d.format("%Y-%m-%d %H:%M:%S.%f"))                                                 // out: 2026-11-08 14:05:09.250000
    println(d.format("%a %A %b %B %j %u %w"))                                                 // out: Sun Sunday Nov November 312 7 0
    println(d.format("%I:%M %p, %d/%m/%y, %F %T, 100%%"))                                     // out: 02:05 PM, 08/11/26, 2026-11-08 14:05:09, 100%
    println(DateTime.new(2000, 1, 1)!.format("%I %p %y [%j]"))                                // out: 12 AM 00 [001]
    println(DateTime.new(812, 3, 4, 12)!.format("%Y %I %p"))                                  // out: 0812 12 PM
    let t = Timestamp { unix_ms: 1794143109250 }
    println(t.format("%F %T %z %:z", 19800))                                                  // out: 2026-11-08 18:35:09 +0530 +05:30
    println(t.format("%H:%M %z", -34200))                                                     // out: 03:35 -0930
    println("{t.iso(0)} {t.iso(3600)} {t.iso(-18000)}")                                       // out: 2026-11-08T13:05:09.250Z 2026-11-08T14:05:09.250+01:00 2026-11-08T08:05:09.250-05:00

    // Parsing, by the same codes.
    println(show(DateTime.parse("8/11/2026", "%d/%m/%Y")))                                    // out: 2026-11-08T00:00:00
    println(show(DateTime.parse("8/11/26", "%d/%m/%Y")))                                      // out: none
    println("{show(DateTime.parse("8/11/68", "%d/%m/%y"))} {show(DateTime.parse("8/11/69", "%d/%m/%y"))}")  // out: 2068-11-08T00:00:00 1969-11-08T00:00:00
    println(show(DateTime.parse("tuesday  3 FEBRUARY 2026", "%A %d %B %Y")))                 // out: 2026-02-03T00:00:00
    println(show(DateTime.parse("2026-11-0814:05", "%Y-%m-%d %H:%M")))                        // out: none
    println("{show(DateTime.parse("12:30 am", "%I:%M %p"))} {show(DateTime.parse("1:30 PM", "%I:%M %p"))}")  // out: 1900-01-01T00:30:00 1900-01-01T13:30:00
    println("{show(DateTime.parse("13:30 pm", "%I:%M %p"))} {show(DateTime.parse("09:30 PM", "%H:%M %p"))}")  // out: none 1900-01-01T09:30:00
    println("{show(DateTime.parse("2024-060", "%Y-%j"))} {show(DateTime.parse("2026-000", "%Y-%j"))}")  // out: 2024-02-29T00:00:00 none
    // Python rolls day 366 of a year of 365 over into the next year.
    println(show(DateTime.parse("2026-366", "%Y-%j")))                                        // out: none
    println(show(DateTime.parse("2026-11-08 14:05:09.123456", "%F %T.%f")))                   // out: 2026-11-08T14:05:09.123
    println("{show(DateTime.parse("2026-02-29", "%F"))} {show(DateTime.parse("2026-11-08x", "%F"))} {show(DateTime.parse("", ""))}")  // out: none none 1900-01-01T00:00:00
    println("{show(DateTime.parse("7 2026-11-08", "%u %F"))} {show(DateTime.parse("8 2026-11-08", "%u %F"))}")  // out: 2026-11-08T00:00:00 none
    println(showt(Timestamp.parse("08/Nov/2026:14:05:09 +0100", "%d/%b/%Y:%H:%M:%S %z")))      // out: 1794143109000
    println("{showt(Timestamp.parse("2026-11-08 14:05 Z", "%F %H:%M %z"))} {showt(Timestamp.parse("2026-11-08 14:05 -05:30", "%F %H:%M %z"))}")  // out: 1794146700000 1794166500000
    println("{showt(Timestamp.parse("2026-11-08 14:05 +05", "%F %H:%M %z"))} {showt(Timestamp.parse("2026-11-08 14:05 +2400", "%F %H:%M %z"))}")  // out: none none

    // ISO 8601.
    println("{show(DateTime.parse_iso("2026-11-08"))} {show(DateTime.parse_iso("2026-11-08T14"))} {show(DateTime.parse_iso("2026-11-08 14:05"))}")  // out: 2026-11-08T00:00:00 2026-11-08T14:00:00 2026-11-08T14:05:00
    println("{show(DateTime.parse_iso("2026-11-08T14:05:09,5"))} {show(DateTime.parse_iso("2026-11-08T14:05:09.1234567"))}")  // out: 2026-11-08T14:05:09.500 2026-11-08T14:05:09.123
    println("{show(DateTime.parse_iso("2026-02-30"))} {show(DateTime.parse_iso("2026-11-8"))} {show(DateTime.parse_iso("2026-11-08T14:05:09Z"))}")  // out: none none none
    println("{showt(Timestamp.parse_iso("2026-11-08T14:05:09.250+05:30"))} {showt(Timestamp.parse_iso("2026-11-08 14:05-08:00"))}")  // out: 1794126909250 1794175500000
    println("{showt(Timestamp.parse_iso("2026-11-08T14:05:09+01"))} {showt(Timestamp.parse_iso("2026-11-08T14:05:09+0100"))} {showt(Timestamp.parse_iso("1969-12-31T23:59:59.999Z"))}")  // out: 1794143109000 1794143109000 -1
    println("{showt(Timestamp.parse_iso("2026-11-08T14:05:09"))} {showt(Timestamp.parse_iso("2026-11-08T14:05:09+01:0"))} {showt(Timestamp.parse_iso("2026-11-08T14:05:09Zx"))}")  // out: none none none

    // Before year 1, which Python can't reach, the calendar runs on, with a year 0.
    println("{DateTime.new(1, 1, 1)!.add_days(-100).iso()} {DateTime.new(1, 1, 1)!.add_months(-13).iso()} {DateTime.new(0, 2, 29)!.weekday()}")  // out: 0000-09-23T00:00:00 -0001-12-01T00:00:00 1
}
