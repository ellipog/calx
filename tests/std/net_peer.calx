// std.net: each connection's peer address, and addresses as RFC 5952 writes them.
import std.net.{Net, Conn, Event, Ip, Address}

fn v6(groups: [u32; 8], scope: u32) -> Ip {
    var b: [u8; 16] = [0; 16]
    let count: usize = 8
    for i in 0..count {
        b[2 * i] = u8.wrap(groups[i] >> 8)
        b[2 * i + 1] = u8.wrap(groups[i])
    }
    return Ip.V6(b, scope)
}

// Connects to `host`, and gives back what the server saw as the client's address, and what the
// client saw as the server's.
fn both_ends(net: Net, host: String, port: u16) -> String {
    let client = net.connect(host, port)!
    var server: Conn? = none
    var events = List<Event>()
    var accepted = String()
    var connected = String()
    while accepted.is_empty() or connected.is_empty() {
        net.poll(2000, mut events)
        for e in events {
            match e {
                Event.Accepted(c) => {
                    server = some(c)
                    let a = net.peer(c)!
                    accepted = a.ip.to_string()
                },
                Event.Connected(c) => {
                    let a = net.peer(c)!
                    connected = if a.port == port { a.ip.to_string() } else { String("wrong port") }
                },
                Event.Closed(_) => panic("couldn't connect to {host}"),
                _ => {},
            }
        }
    }
    net.close(client)
    // The peer stays until the poll after the connection's Closed.
    var closed = false
    while not closed {
        net.poll(2000, mut events)
        for e in events {
            match e {
                Event.Closed(c) => {
                    if c == client {
                        closed = true
                        assert(net.peer(c) != none, "the peer went before its Closed was seen")
                    }
                },
                _ => {},
            }
        }
    }
    net.poll(0, mut events)
    assert(net.peer(client) == none, "the peer outlived its connection")
    if let c = server {
        net.close(c)
    }
    return "{accepted} -> {connected}"
}

fn main() {
    let net = Net.new()!
    let port = net.listen("127.0.0.1", 0)!
    println(both_ends(net, "127.0.0.1", port))    // out: 127.0.0.1 -> 127.0.0.1

    // A socket listening on every address sees an IPv4 client as IPv4, not as ::ffff:127.0.0.1.
    let any = net.listen("", 0)!
    println(both_ends(net, "127.0.0.1", any))     // out: 127.0.0.1 -> 127.0.0.1
    println(both_ends(net, "::1", any))           // out: ::1 -> ::1

    // RFC 5952's text: the longest run of zero groups, the first on a tie, and never just one.
    println(v6([0x2001, 0xdb8, 0, 0, 8, 0x800, 0x200c, 0x417a], 0).to_string())    // out: 2001:db8::8:800:200c:417a
    println(v6([0x2001, 0xdb8, 0, 0, 1, 0, 0, 1], 0).to_string())                  // out: 2001:db8::1:0:0:1
    println(v6([0x2001, 0, 0, 1, 0, 0, 0, 1], 0).to_string())                      // out: 2001:0:0:1::1
    println(v6([0x2001, 0xdb8, 0, 1, 1, 1, 1, 1], 0).to_string())                  // out: 2001:db8:0:1:1:1:1:1
    println(v6([0, 0, 0, 0, 0, 0, 0, 0], 0).to_string())                           // out: ::
    println(v6([1, 0, 0, 0, 0, 0, 0, 0], 0).to_string())                           // out: 1::
    println(v6([0, 0, 0, 0, 0, 0xffff, 0xc000, 0x0201], 0).to_string())            // out: ::ffff:192.0.2.1
    println(Address { ip: v6([0xfe80, 0, 0, 0, 0, 0, 0, 1], 3), port: 80 }.to_string())    // out: [fe80::1%3]:80
    println(Address { ip: Ip.V4([10, 0, 0, 255]), port: 25565 }.to_string())                // out: 10.0.0.255:25565
}
