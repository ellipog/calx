// std.zstd trains dictionaries as Python 3.14's train_dict(samples, size) does, with libzstd's
// fastCover; docs/std/zstd.md compares what they make. Here: a dictionary trained from records
// makes the records it wasn't trained on much smaller, reads back from its bytes, comes out the
// same from the same samples however many threads there are, and too few samples or too small a
// size fail. finalize_dict puts tables from samples on content picked another way.

import std.zstd.{Dictionary, compress, finalize_dict, train_dict, xxh64}
import std.pool.{set_workers}

fn record(i: i32) -> List<u8> {
    let roles = ["admin", "user", "guest", "bot"]
    return "\{\"id\": {i * 7919 % 100000}, \"name\": \"user{i * 31 % 977}\", \"role\": \"{roles[usize.wrap(i % 4)]}\", \"active\": {i % 3 != 0}, \"score\": {i * 13 % 1000}\}".to_bytes()
}

fn main() {
    var samples: List<List<u8>> = []
    for i in 0..2000 {
        samples.push(record(i))
    }
    let d = train_dict(samples, 4096)!
    let bytes = d.to_bytes()
    let magic = bytes[0] == 0x37 and bytes[1] == 0xa4 and bytes[2] == 0x30 and bytes[3] == 0xec
    println("{bytes.len() <= 4096} {magic} {d.id() >= 32768}")    // out: true true true

    // Records it wasn't trained on, a frame each: under half the size with it, and back as they
    // were.
    var small: usize = 0
    var plain: usize = 0
    var wrong = 0
    for i in 5000..5500 {
        let r = record(i)
        let z = d.compress(r)
        small += z.len()
        plain += compress(r).len()
        if d.decompress(z)! != r {
            wrong += 1
        }
    }
    println("{wrong} wrong {small * 2 < plain}")    // out: 0 wrong true

    // Read back from its bytes, as from a file, it's the same dictionary.
    let again = Dictionary.new(bytes.copy())!
    println("{again.id() == d.id()} {again.compress(record(7)) == d.compress(record(7))}")    // out: true true

    // The same samples give the same bytes on one thread and on eight, and on any machine.
    set_workers(1)
    let one = train_dict(samples, 4096)!.to_bytes()
    set_workers(8)
    let eight = train_dict(samples, 4096)!.to_bytes()
    println("{one == bytes} {eight == bytes}")    // out: true true
    println("{bytes.len()} {xxh64(bytes) >> 40:06x}")    // out: 4096 b59252

    // Content picked by hand, with tables from the samples: it ends the dictionary, and records
    // come back through it. Too small a size for the content fails.
    var picked: List<u8> = []
    for i in [3, 10, 17, 24] {
        picked.extend(record(i))
    }
    let content = Dictionary.raw(picked.copy())!
    let f = finalize_dict(content, samples, 4096, 3)!
    let fb = f.to_bytes()
    var fwrong = 0
    for i in 6000..6100 {
        if f.decompress(f.compress(record(i)))! != record(i) {
            fwrong += 1
        }
    }
    println("{fb[fb.len() - picked.len()..] == picked} {f.id() >= 32768} {fwrong} wrong")    // out: true true 0 wrong
    println("{fb.len()} {xxh64(fb) >> 40:06x}")    // out: 426 80ff2d
    match finalize_dict(Dictionary.raw(picked.copy())!, samples, picked.len() - 1, 3) {
        ok(_) => println("finalized"),
        err(e) => println("{e}"),    // out: too few samples or too small a size to train a dictionary
    }

    // Six samples are too few: a quarter are held back to test with, and five must be left.
    // Seven of a byte each have too little in them, and 255 bytes is too small a size.
    var few: List<List<u8>> = []
    for i in 0..6 {
        few.push(record(i))
    }
    var tiny: List<List<u8>> = []
    for _ in 0..7 {
        tiny.push([42u8])
    }
    for (samples2, size) in [(few, 4096usize), (tiny, 4096usize), (samples.copy(), 255usize)] {
        match train_dict(samples2, size) {
            ok(_) => println("trained"),
            err(e) => println("{e}"),
        }
    }
    // out: too few samples or too small a size to train a dictionary
    // out: too few samples or too small a size to train a dictionary
    // out: too few samples or too small a size to train a dictionary
}
