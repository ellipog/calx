// A server and a client in one program, over loopback: the client sends "ping", the server
// answers "pong" and closes, and the client sees the bytes and then the close.
import std.net.{Event, Net}

fn text(bytes: List<u8>) -> String {
    return String.from_utf8(bytes.copy()) ?? String("<not UTF-8>")
}

fn main() {
    let net = Net.new()!
    let port = net.listen("127.0.0.1", 0)!
    let client = net.connect("127.0.0.1", port)!
    var events = List<Event>()
    var at_server = List<u8>()
    var at_client = List<u8>()
    var opened = 0
    var closed = 0
    var polls = 0
    while closed < 2 and polls < 2000 {
        net.poll(1000, mut events)
        polls += 1
        for e in events {
            match e {
                Connected(c) => {
                    opened += 1
                    let ping: List<u8> = [112, 105, 110, 103]
                    net.write(c, ping)
                }
                Accepted(_) => opened += 1,
                Received(c) => {
                    if c.slot() == client.slot() {
                        _ = net.read(c, mut at_client)
                    } else {
                        _ = net.read(c, mut at_server)
                        if at_server.len() >= 4 {
                            let pong: List<u8> = [112, 111, 110, 103]
                            net.write(c, pong)
                            net.close(c)
                        }
                    }
                }
                Closed(_) => closed += 1,
                Woken => {},
            }
        }
    }
    println("opened {opened}")                 // out: opened 2
    println("server got {text(at_server)}")    // out: server got ping
    println("client got {text(at_client)}")    // out: client got pong
    println("closed {closed}")                 // out: closed 2
}
