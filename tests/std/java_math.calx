// std.java.math gives StrictMath's results bit for bit. The bits below are Java 25's StrictMath, on
// the hardest cases for each function: tiny and huge arguments, the ends of each range, and
// arguments whose reduction by pi/2 needs hundreds of bits of 2/pi. build/scratch's wider check
// compared 1,043,282 results.

import std.java.math.{E, PI, acos, asin, atan, atan2, cbrt, cos, cosh, exp, expm1, hypot, log, log10, log1p, pow, sin, sinh, tan, tanh}

// A NaN only has to be NaN: its sign and payload depend on the CPU, in Java too.
fn check(what: str, got: f64, want: u64) {
    if f64.from_bits(want).is_nan() {
        if not got.is_nan() {
            panic("{what} is {got}, want NaN")
        }
    } else if got.to_bits() != want {
        panic("{what} has bits {got.to_bits()}, want {want}")
    }
}

fn main() {
    println("{log(1.0)} {log(2.0)} {log(10.0)}")    // out: 0.0 0.6931471805599453 2.302585092994046
    println("{log(0.0)} {log(-1.0)} {log(f64.INFINITY)}")    // out: -Infinity NaN Infinity
    println("{sin(PI / 6.0)} {cos(PI)} {atan2(1.0, -1.0)}")    // out: 0.49999999999999994 -1.0 2.356194490192345
    println("{pow(2.0, 10.0)} {exp(1.0)} {cbrt(-27.0)} {hypot(3.0, 4.0)}")    // out: 1024.0 2.7182818284590455 -3.0 5.0

    check("log(0.0)", log(0.0), 18442240474082181120)
    check("log(-0.0)", log(-0.0), 18442240474082181120)
    check("log(-1.0)", log(-1.0), 18444492273895866368)
    check("log(0.5)", log(0.5), 13827790571168217583)
    check("log(MIN subnormal)", log(f64.from_bits(1)), 13873131416795836867)
    check("log(1e-310)", log(f64.from_bits(0x12688b70e62b)), 13872861916001309960)
    check("log(MAX)", log(f64.MAX), 4649454530587146735)
    check("log(NAN)", log(f64.NAN), 9221120237041090560)
    check("log(-inf)", log(f64.NEG_INFINITY), 18444492273895866368)
    check("log(1.0000001)", log(f64.from_bits(0x3ff000001ad7f29b)), 4502148214114968722)
    check("log(0.9999999)", log(f64.from_bits(0x3fefffffca501acb)), 13725520251716934559)
    check("log(e)", log(E), 4607182418800017408)    // exactly 1
    check("log(1e300)", log(1e300), 4649287341619838901)
    check("log(1 + 1e-12)", log(f64.from_bits(0x3ff0000000001198)), 4427487034449327700)    // |f| < 2^-20
    check("sin(0.5)", sin(0.5), 0x3fdeaee8744b05f0)
    check("sin(-0.0)", sin(-0.0), 0x8000000000000000)
    check("sin(1.0e-300)", sin(1.0e-300), 0x01a56e1fc2f8f359)
    check("sin(3.141592653589793)", sin(3.141592653589793), 0x3ca1a62633145c07)
    check("sin(100.0)", sin(100.0), 0xbfe03425b78c4db8)
    check("sin(1.0e22)", sin(1.0e22), 0xbfeb453ab76bf397)
    check("sin(5.319372648326541e255)", sin(5.319372648326541e255), 0x3ff0000000000000)
    check("sin(1.7976931348623157e308)", sin(1.7976931348623157e308), 0x3f7452fc98b34e97)
    check("sin(f64.INFINITY)", sin(f64.INFINITY), 0xfff8000000000000)
    check("cos(0.5)", cos(0.5), 0x3fec1528065b7d50)
    check("cos(0.0)", cos(0.0), 0x3ff0000000000000)
    check("cos(0.7)", cos(0.7), 0x3fe87996529f9d93)
    check("cos(1.5707963267948966)", cos(1.5707963267948966), 0x3c91a62633145c07)
    check("cos(100.0)", cos(100.0), 0x3feb981dbf665fdf)
    check("cos(1.0e22)", cos(1.0e22), 0x3fe0be2cef01c8f4)
    check("cos(5.319372648326541e255)", cos(5.319372648326541e255), 0xbc214ae72e6ba22f)
    check("cos(1.7976931348623157e308)", cos(1.7976931348623157e308), 0xbfefffe62ecfab75)
    check("tan(0.5)", tan(0.5), 0x3fe17b4f5bf3474a)
    check("tan(0.7)", tan(0.7), 0x3feaf406c2fc78ae)
    check("tan(-1.0e-30)", tan(-1.0e-30), 0xb9b4484bfeebc2a0)
    check("tan(1.5707963267948966)", tan(1.5707963267948966), 0x434d02967c31cdb5)
    check("tan(100.0)", tan(100.0), 0xbfe2ca74d62b5d38)
    check("tan(1.0e22)", tan(1.0e22), 0xbffa0f79c1b6b258)
    check("tan(5.319372648326541e255)", tan(5.319372648326541e255), 0xc3bd9ba9a7975636)
    check("asin(0.3)", asin(0.3), 0x3fd380159e14f6ff)
    check("asin(-0.7)", asin(-0.7), 0xbfe8d00e692afd95)
    check("asin(0.98)", asin(0.98), 0x3ff5ed690583be07)
    check("asin(1.0)", asin(1.0), 0x3ff921fb54442d18)
    check("asin(1.0e-10)", asin(1.0e-10), 0x3ddb7cdfd9d7bdbb)
    check("asin(1.5)", asin(1.5), 0xfff8000000000000)
    check("acos(0.3)", acos(0.3), 0x3ff441f5ecbeef59)
    check("acos(-0.7)", acos(-0.7), 0x4002c501446cd5f2)
    check("acos(0.98)", acos(0.98), 0x3fc9a49276037887)
    check("acos(-1.0)", acos(-1.0), 0x400921fb54442d18)
    check("acos(1.0e-60)", acos(1.0e-60), 0x3ff921fb54442d18)
    check("acos(1.5)", acos(1.5), 0xfff8000000000000)
    check("atan(0.3)", atan(0.3), 0x3fd2a73a661eaf06)
    check("atan(0.5)", atan(0.5), 0x3fddac670561bb4f)
    check("atan(-1.0)", atan(-1.0), 0xbfe921fb54442d18)
    check("atan(2.0)", atan(2.0), 0x3ff1b6e192ebbe44)
    check("atan(10.0)", atan(10.0), 0x3ff789bd2c160054)
    check("atan(1.0e70)", atan(1.0e70), 0x3ff921fb54442d18)
    check("atan(f64.NEG_INFINITY)", atan(f64.NEG_INFINITY), 0xbff921fb54442d18)
    check("atan2(1.0, 1.0)", atan2(1.0, 1.0), 0x3fe921fb54442d18)
    check("atan2(1.0, -1.0)", atan2(1.0, -1.0), 0x4002d97c7f3321d2)
    check("atan2(-1.0, -1.0)", atan2(-1.0, -1.0), 0xc002d97c7f3321d2)
    check("atan2(0.0, -0.0)", atan2(0.0, -0.0), 0x400921fb54442d18)
    check("atan2(-0.0, -1.0)", atan2(-0.0, -1.0), 0xc00921fb54442d18)
    check("atan2(f64.INFINITY, f64.INFINITY)", atan2(f64.INFINITY, f64.INFINITY), 0x3fe921fb54442d18)
    check("atan2(1.0e300, 1.0e-300)", atan2(1.0e300, 1.0e-300), 0x3ff921fb54442d18)
    check("atan2(3.0, 4.0)", atan2(3.0, 4.0), 0x3fe4978fa3269ee1)
    check("atan2(5.0, f64.INFINITY)", atan2(5.0, f64.INFINITY), 0x0000000000000000)
    check("exp(1.0)", exp(1.0), 0x4005bf0a8b14576a)
    check("exp(-1.0)", exp(-1.0), 0x3fd78b56362cef38)
    check("exp(0.1)", exp(0.1), 0x3ff1aec7b35a00d4)
    check("exp(100.0)", exp(100.0), 0x48f3494a9b171bf5)
    check("exp(709.0)", exp(709.0), 0x7fdd422d2be5dc9b)
    check("exp(710.0)", exp(710.0), 0x7ff0000000000000)
    check("exp(-745.0)", exp(-745.0), 0x0000000000000001)
    check("exp(-746.0)", exp(-746.0), 0x0000000000000000)
    check("exp(1.0e-30)", exp(1.0e-30), 0x3ff0000000000000)
    check("expm1(1.0e-10)", expm1(1.0e-10), 0x3ddb7cdfd9dda4e3)
    check("expm1(0.3)", expm1(0.3), 0x3fd6641632306a56)
    check("expm1(-0.3)", expm1(-0.3), 0xbfd0966f2c7907f6)
    check("expm1(1.0)", expm1(1.0), 0x3ffb7e151628aed2)
    check("expm1(40.0)", expm1(40.0), 0x438a220d397972ea)
    check("expm1(-40.0)", expm1(-40.0), 0xbff0000000000000)
    check("expm1(700.0)", expm1(700.0), 0x7f0d945df4f8ec8e)
    check("expm1(1.0e-300)", expm1(1.0e-300), 0x01a56e1fc2f8f359)
    check("log10(1000.0)", log10(1000.0), 0x4008000000000000)
    check("log10(1.0e22)", log10(1.0e22), 0x4036000000000000)
    check("log10(2.0)", log10(2.0), 0x3fd34413509f79ff)
    check("log10(0.001)", log10(0.001), 0xc008000000000000)
    check("log10(1.0e-310)", log10(1.0e-310), 0xc073600000000000)
    check("log10(-1.0)", log10(-1.0), 0xfff8000000000000)
    check("log1p(1.0e-10)", log1p(1.0e-10), 0x3ddb7cdfd9d1d693)
    check("log1p(0.3)", log1p(0.3), 0x3fd0ca937be1b9dc)
    check("log1p(-0.3)", log1p(-0.3), 0xbfd6d3c324e13f4e)
    check("log1p(-0.9)", log1p(-0.9), 0xc0026bb1bbb55516)
    check("log1p(1.0e300)", log1p(1.0e300), 0x4085963447f87fb5)
    check("log1p(-1.0)", log1p(-1.0), 0xfff0000000000000)
    check("pow(2.0, 10.0)", pow(2.0, 10.0), 0x4090000000000000)
    check("pow(2.0, 0.5)", pow(2.0, 0.5), 0x3ff6a09e667f3bcd)
    check("pow(10.0, -3.0)", pow(10.0, -3.0), 0x3f50624dd2f1a9fc)
    check("pow(-2.0, 3.0)", pow(-2.0, 3.0), 0xc020000000000000)
    check("pow(-2.0, 0.5)", pow(-2.0, 0.5), 0xfff8000000000000)
    check("pow(1.0000001, 1.0e10)", pow(1.0000001, 1.0e10), 0x7ff0000000000000)
    check("pow(0.5, 1100.0)", pow(0.5, 1100.0), 0x0000000000000000)
    check("pow(2.0, -1075.0)", pow(2.0, -1075.0), 0x0000000000000000)
    check("pow(2.718281828459045, 3.141592653589793)", pow(2.718281828459045, 3.141592653589793), 0x403724046eb09338)
    check("pow(-0.0, -3.0)", pow(-0.0, -3.0), 0xfff0000000000000)
    check("pow(1.0, f64.INFINITY)", pow(1.0, f64.INFINITY), 0xfff8000000000000)
    check("pow(1.7, 21.3)", pow(1.7, 21.3), 0x40f3c765d1bc4751)
    check("cbrt(27.0)", cbrt(27.0), 0x4008000000000000)
    check("cbrt(-8.0)", cbrt(-8.0), 0xc000000000000000)
    check("cbrt(2.0)", cbrt(2.0), 0x3ff428a2f98d728b)
    check("cbrt(1.0e-310)", cbrt(1.0e-310), 0x2a7a9d1b0b5d7427)
    check("cbrt(1.0e300)", cbrt(1.0e300), 0x54b249ad2594c37d)
    check("hypot(3.0, 4.0)", hypot(3.0, 4.0), 0x4014000000000000)
    check("hypot(1.0e300, 1.0e300)", hypot(1.0e300, 1.0e300), 0x7e40e4d50f99b211)
    check("hypot(1.0e-310, 1.0e-310)", hypot(1.0e-310, 1.0e-310), 0x00001a088b6bf34f)
    check("hypot(f64.INFINITY, f64.NAN)", hypot(f64.INFINITY, f64.NAN), 0x7ff0000000000000)
    check("hypot(1.0, 1.0e-20)", hypot(1.0, 1.0e-20), 0x3ff0000000000000)
    check("hypot(0.1, 0.2)", hypot(0.1, 0.2), 0x3fcc9f25c5bfedd9)
    check("sinh(1.0e-30)", sinh(1.0e-30), 0x39b4484bfeebc2a0)
    check("sinh(0.1)", sinh(0.1), 0x3fb9a487337b59b3)
    check("sinh(1.0)", sinh(1.0), 0x3ff2cd9fc44eb982)
    check("sinh(-5.0)", sinh(-5.0), 0xc0528d0166f07374)
    check("sinh(25.0)", sinh(25.0), 0x4220c3d3920962c9)
    check("sinh(710.0)", sinh(710.0), 0x7fe3e21a464507fa)
    check("sinh(711.0)", sinh(711.0), 0x7ff0000000000000)
    check("cosh(1.0e-30)", cosh(1.0e-30), 0x3ff0000000000000)
    check("cosh(0.1)", cosh(0.1), 0x3ff0147f40224b38)
    check("cosh(1.0)", cosh(1.0), 0x3ff8b07551d9f551)
    check("cosh(-5.0)", cosh(-5.0), 0x40528d6fcbeff3aa)
    check("cosh(25.0)", cosh(25.0), 0x4220c3d3920962c9)
    check("cosh(710.0)", cosh(710.0), 0x7fe3e21a464507fa)
    check("cosh(711.0)", cosh(711.0), 0x7ff0000000000000)
    check("tanh(1.0e-30)", tanh(1.0e-30), 0x39b4484bfeebc2a0)
    check("tanh(0.1)", tanh(0.1), 0x3fb983d7795f413a)
    check("tanh(1.0)", tanh(1.0), 0x3fe85efab514f394)
    check("tanh(-5.0)", tanh(-5.0), 0xbfefff419668df11)
    check("tanh(25.0)", tanh(25.0), 0x3ff0000000000000)
    check("tanh(f64.NEG_INFINITY)", tanh(f64.NEG_INFINITY), 0xbff0000000000000)

    println("ok")    // out: ok
}
