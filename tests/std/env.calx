// std.env: the command line, with spaces, quotes, backslashes and text that isn't ASCII.
import std.env.{args}

// args: --threads
// args: 24
// args: two words
// args: say "hi"
// args: back\slash\
// args:
// args: héllo 世界

fn main() {
    let a = args()
    println("{a.len()}")    // out: 7
    for s in a {
        println("[{s}]")
    }
    // out: [--threads]
    // out: [24]
    // out: [two words]
    // out: [say "hi"]
    // out: [back\slash\]
    // out: []
    // out: [héllo 世界]
}
