// std.env: the command line, with spaces, quotes, backslashes and text that isn't ASCII, and
// environment variables.
import std.env.{args, variable}

// args: --threads
// args: 24
// args: two words
// args: say "hi"
// args: back\slash\
// args:
// args: héllo 世界

fn main() {
    let a = args()
    println("{a.len()}")    // out: 7
    for s in a {
        println("[{s}]")
    }
    // out: [--threads]
    // out: [24]
    // out: [two words]
    // out: [say "hi"]
    // out: [back\slash\]
    // out: []
    // out: [héllo 世界]

    // PATH is set wherever the tests run, and reading it twice gives the same value; a name that
    // isn't set, and names that can't be one, give none.
    let path = variable("PATH")
    println("{path != none} {path == variable("PATH")}")    // out: true true
    println("{variable("CALX_NOT_A_VARIABLE_EVER") == none}")    // out: true
    println("{variable("") == none} {variable("A=B") == none} {variable("=C:") == none}")    // out: true true true
}
