// Noise handshakes against cacophony's and snow's vectors (CLX-411), in noise/vectors.txt: 131
// of them, every pattern, fundamental and deferred, with and without `psk` modifiers, over each
// of the eight suites of 25519, ChaChaPoly or AESGCM, and SHA256, SHA512, BLAKE2s or BLAKE2b.
// Both sides of each run in step from its fixed keys, and each message must be written as the
// vector's bytes and read back as its payload, the handshake hash must be its, and then so must
// each transport message.

import std.bytes.{from_hex}
import std.crypto.{NoiseHandshake, X25519Key, X25519PublicKey}

const VECTORS: [u8; 170766] = embed("noise/vectors.txt")

fn unhex(text: String) -> List<u8> {
    if text == "-" {
        return []
    }
    return from_hex(text) ?? panic("hex: {text}")
}

fn side(initiator: bool, v: List<String>, at: usize) -> NoiseHandshake {
    let name = v[1].copy()
    var hs = if initiator { NoiseHandshake.initiator(name) } else { NoiseHandshake.responder(name) }
    hs.set_prologue(unhex(v[2].copy()))
    if v[at] != "-" {
        hs.set_static(X25519Key.from_bytes(unhex(v[at].copy()))!)
    }
    if v[at + 1] != "-" {
        hs.set_ephemeral(X25519Key.from_bytes(unhex(v[at + 1].copy()))!)
    }
    if v[at + 2] != "-" {
        hs.set_remote_static(X25519PublicKey.from_bytes(unhex(v[at + 2].copy()))!)
    }
    if v[9] != "-" {
        var psks = List<List<u8>>()
        for p in v[9].split(",") {
            psks.push(unhex(p))
        }
        hs.set_psks(psks)
    }
    return hs
}

// What's different from the vector, or empty if nothing is.
fn run(v: List<String>, messages: List<(String, String)>) -> String {
    var init = side(true, v.copy(), 3)
    var resp = side(false, v.copy(), 6)
    var k: usize = 0
    while not init.is_finished() {
        let (payload, ciphertext) = messages[k].copy()
        let from_init = init.is_my_turn()
        if resp.is_my_turn() == from_init {
            return "message {k}: both sides think it's the same one's turn"
        }
        let written = if from_init { init.write_message(unhex(payload.copy()))! } else { resp.write_message(unhex(payload.copy()))! }
        if written != unhex(ciphertext) {
            return "message {k} is written differently"
        }
        let read = if from_init { resp.read_message(written)! } else { init.read_message(written)! }
        if read != unhex(payload) {
            return "message {k} reads differently"
        }
        k += 1
    }
    if not resp.is_finished() {
        return "the responder isn't finished"
    }
    if v[10] != "-" and (init.handshake_hash() != unhex(v[10].copy()) or resp.handshake_hash() != unhex(v[10].copy())) {
        return "the handshake hash is different"
    }
    if init.handshake_hash() != resp.handshake_hash() {
        return "the two sides' handshake hashes differ"
    }
    if v[8] != "-" and resp.remote_static() == none {
        return "the responder didn't learn the initiator's key"
    }
    let one_way = k == 1
    var ti = init.transport()
    var tr = resp.transport()
    while k < messages.len() {
        let (payload, ciphertext) = messages[k].copy()
        let from_init = one_way or k % 2 == 0
        let written = if from_init { ti.encrypt(unhex(payload.copy())) } else { tr.encrypt(unhex(payload.copy())) }
        if written != unhex(ciphertext) {
            return "transport message {k} is written differently"
        }
        let read = if from_init { tr.decrypt(written) } else { ti.decrypt(written) }
        if read != some(unhex(payload)) {
            return "transport message {k} reads differently"
        }
        k += 1
    }
    return ""
}

fn main() {
    let text = String.from_utf8(VECTORS[..]) ?? panic("UTF-8")
    var vector = List<String>()
    var messages = List<(String, String)>()
    var passed: usize = 0
    var transported: usize = 0
    var lines = text.lines()
    lines.push("v end")
    for line in lines {
        if line.starts_with("#") {
            continue
        }
        let parts = line.split(" ")
        if parts[0] == "m" {
            messages.push((parts[1].copy(), parts[2].copy()))
            continue
        }
        if not vector.is_empty() {
            let wrong = run(vector.copy(), messages.copy())
            if wrong.is_empty() {
                passed += 1
                transported += messages.len()
            } else {
                println("{vector[1]}: {wrong}")
            }
        }
        vector = parts
        messages = List()
    }
    println("{passed} vectors, {transported} messages")    // out: 131 vectors, 712 messages
}
