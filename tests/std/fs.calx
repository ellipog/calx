// std.fs: files written, read, renamed and removed, directories made, listed and removed, and
// the errors, in a temporary directory of the test's own.
import std.time.{Timestamp}
import std.fs.{FsError, Kind, append, metadata, set_modified, read, read_part, read_parts, read_text, write, write_parts, rename, remove_file, remove_dir, remove_dir_all, make_dir, make_dir_all, kind, is_file, is_dir, list, real_path, temp_dir, try_lock}

fn describe(e: FsError) -> String {
    return match e {
        NotFound => String("not found"),
        Denied => String("denied"),
        Exists => String("exists"),
        BadPath => String("bad path"),
        IsDirectory => String("is a directory"),
        NotEmpty => String("not empty"),
        Os(code) => "system error {code}",
    }
}

fn kind_name(path: String) -> String {
    return match kind(path) {
        ok(some(Kind.File)) => String("file"),
        ok(some(Kind.Dir)) => String("dir"),
        ok(some(Kind.Link)) => String("link"),
        ok(some(Kind.Other)) => String("other"),
        ok(none) => String("none"),
        err(e) => describe(e),
    }
}

fn names(path: String) -> String {
    return match list(path) {
        ok(all) => {
            var out = String()
            for n in all {
                if not out.is_empty() {
                    out.push(' ')
                }
                out.push_str(n)
            }
            "[{out}]"
        },
        err(e) => describe(e),
    }
}

fn read_error(path: String) -> String {
    return match read(path) {
        ok(b) => "{b.len()} bytes",
        err(e) => describe(e),
    }
}

fn main() {
    let dir = temp_dir()!
    println("{is_dir(dir)} {names(dir)}")    // out: true []

    // Write, read back, and replace.
    let a = "{dir}/a.txt"
    let hello: List<u8> = [104, 101, 108, 108, 111]
    write(a, hello)!
    println("{read_text(a)! ?? String("?")} {is_file(a)} {kind_name(a)}")    // out: hello true file
    write(a, [])!
    println("{read(a)!.len()}")    // out: 0

    // Appending adds to the end, and makes the file if it isn't there.
    append(a, hello)!
    append(a, [33])!
    println("{read_text(a)! ?? String("?")}")    // out: hello!

    // Sizes and modified times: set to the millisecond, before 1970 too, and moved on by a write.
    println("{metadata(a)!.size}")    // out: 6
    set_modified(a, Timestamp { unix_ms: 1761609600123 })!
    println("{metadata(a)!.modified.unix_ms}")    // out: 1761609600123
    set_modified(a, Timestamp { unix_ms: -1500 })!
    println("{metadata(a)!.modified.unix_ms}")    // out: -1500
    append(a, [33])!
    let m = metadata(a)!
    println("{m.size} {m.modified.unix_ms > 1761609600123}")    // out: 7 true
    match metadata("{dir}/missing") {
        ok(_) => println("found"),
        err(e) => println(describe(e)),    // out: not found
    }
    match set_modified("{dir}/missing", Timestamp { unix_ms: 0 }) {
        ok => println("set"),
        err(e) => println(describe(e)),    // out: not found
    }
    write(a, hello)!
    let c = "{dir}/c.log"
    append(c, [104, 105])!
    println("{read_text(c)! ?? String("?")}")    // out: hi
    remove_file(c)!
    match append("{dir}/no/c.log", hello) {
        ok => println("appended"),
        err(e) => println(describe(e)),    // out: not found
    }

    // A file bigger than one read, and text that isn't ASCII in names and contents.
    var big = List<u8>()
    for i in 0..200000 {
        big.push(u8.wrap(i * 7))
    }
    let b = "{dir}/größe é.bin"
    write(b, big)!
    let back = read(b)!
    var same = back.len() == big.len()
    for i in 0..big.len() {
        same = same and back[i] == big[i]
    }
    println("{same}")    // out: true

    // A stretch from the middle, one that runs past the end, and one from past the end.
    let part = read_part(b, 150000, 10)!
    println("{part.len()} {part[0] == u8.wrap(150000 * 7)} {part[9] == u8.wrap(150009 * 7)}")    // out: 10 true true
    println("{read_part(b, 199995, 10)!.len()} {read_part(b, 300000, 10)!.len()}")    // out: 5 0
    match read_part("{dir}/missing", 0, 1) {
        ok(x) => println("{x.len()}"),
        err(e) => println(describe(e)),    // out: not found
    }

    // Several stretches from one opening, in the order asked, past the end too.
    let ranges: List<(u64, usize)> = [(199995, 10), (0, 3), (150000, 2), (300000, 4)]
    let parts = read_parts(b, ranges)!
    println("{parts.len()} {parts[0].len()} {parts[1][2] == 14} {parts[2][1] == u8.wrap(150001 * 7)} {parts[3].len()}")    // out: 4 5 true true 0
    match read_parts("{dir}/missing", ranges) {
        ok(x) => println("{x.len()}"),
        err(e) => println(describe(e)),    // out: not found
    }

    // Parts written in place: a new file, then into the middle and past the end, keeping the
    // rest, with zeros in the gap, and a later part over an earlier one.
    let r = "{dir}/r.mca"
    let first: List<(u64, List<u8>)> = [(2, [1, 2, 3]), (0, [9])]
    write_parts(r, first, false)!
    println("{read(r)!}")    // out: [9, 0, 1, 2, 3]
    let second: List<(u64, List<u8>)> = [(3, [7, 7]), (8, [5]), (4, [6])]
    write_parts(r, second, true)!
    println("{read(r)!}")    // out: [9, 0, 1, 7, 6, 0, 0, 0, 5]
    write_parts(r, [], true)!
    println("{metadata(r)!.size}")    // out: 9
    let big_parts: List<(u64, List<u8>)> = [(150000, [1, 2])]
    write_parts(b, big_parts, true)!
    let after = read_part(b, 149999, 4)!
    println("{after[0] == u8.wrap(149999 * 7)} {after[1]} {after[2]} {after[3] == u8.wrap(150002 * 7)} {metadata(b)!.size}")    // out: true 1 2 true 200000
    match write_parts("{dir}/no/r.mca", first, false) {
        ok => println("written"),
        err(e) => println(describe(e)),    // out: not found
    }
    make_dir("{dir}/d")!
    match write_parts("{dir}/d", first, false) {
        ok => println("written"),
        err(e) => println(describe(e)),    // out: is a directory
    }
    remove_dir("{dir}/d")!
    remove_file(r)!

    // Rename, replacing a file that's there.
    write(a, hello)!
    rename(a, b)!
    println("{read(b)!.len()} {kind_name(a)}")    // out: 5 none

    // Directories, sorted however the system lists them.
    make_dir_all("{dir}/x/y/z")!
    make_dir_all("{dir}/x/y")!
    write("{dir}/x/y/z/deep", hello)!
    write("{dir}/B", hello)!
    write("{dir}/a", hello)!
    println(names(dir))    // out: [B a größe é.bin x]
    println("{kind_name("{dir}/x")} {is_file("{dir}/x")} {is_dir("{dir}/x/y/z")}")    // out: dir false true

    // Errors.
    println(read_error("{dir}/missing"))    // out: not found
    println(read_error("{dir}/missing/a"))    // out: not found
    println(read_error("{dir}/x"))    // out: is a directory
    println(read_error("{dir}/a\0b"))    // out: bad path
    println(kind_name("{dir}/missing"))    // out: none
    println(names("{dir}/missing"))    // out: not found
    println(names("{dir}/a"))    // out: not found
    match make_dir("{dir}/x") {
        ok => println("made"),
        err(e) => println(describe(e)),    // out: exists
    }
    match remove_dir("{dir}/x") {
        ok => println("removed"),
        err(e) => println(describe(e)),    // out: not empty
    }
    match remove_file("{dir}/missing") {
        ok => println("removed"),
        err(e) => println(describe(e)),    // out: not found
    }
    match make_dir_all("{dir}/a/b") {
        ok => println("made"),
        err(e) => println(describe(e)),    // out: exists
    }

    // Real paths: absolute, with `.` and `..` resolved, the same however the path is written.
    let real = real_path(dir)!
    let y = real_path("{dir}/x/./y/../y")!
    println("{y.starts_with(real)} {y.len() == real.len() + 4} {y.ends_with("y")}")    // out: true true true
    match real_path("{dir}/missing") {
        ok(p) => println(p),
        err(e) => println(describe(e)),    // out: not found
    }

    // A lock: refused while it's held, by this program too, and taken again once it's let go.
    // What it writes goes at the start, and the rest of the file stays.
    let l = "{dir}/session.lock"
    write(l, [1, 2, 3, 4, 5])!
    let snowman: List<u8> = [226, 152, 131]
    let held = try_lock(l, snowman)! else panic("not locked")
    match try_lock(l, snowman) {
        ok(some(_)) => println("locked twice"),
        ok(none) => println("refused"),    // out: refused
        err(e) => println(describe(e)),
    }
    held.release()!
    let again = try_lock(l, [])! else panic("not locked again")
    again.release()!
    let locked = read(l)!
    println("{locked.len()} {locked[0]} {locked[2]} {locked[3]}")    // out: 5 226 131 4
    let fresh = try_lock("{dir}/new.lock", snowman)! else panic("not locked new")
    fresh.release()!
    println("{read("{dir}/new.lock")!.len()}")    // out: 3
    match try_lock("{dir}/x", snowman) {
        ok(_) => println("locked a directory"),
        err(e) => println(describe(e)),    // out: is a directory
    }

    // Everything goes.
    remove_dir_all(dir)!
    println("{kind_name(dir)} {is_dir(dir)}")    // out: none false
}
