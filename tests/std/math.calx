// std.math's exp, log, pow, sin, cos and tan are Calx's own, within 0.51 ULP for the first three
// and 0.55 for the others, and almost always correctly rounded. The bits below are the correctly
// rounded results, which is what these give, from Python's decimal at 50 digits. The special
// cases are Java's.

import std.math.{E, PI, acos, atan2, cos, exp, log, log10, pow, sin, tan}

fn check(what: str, got: f64, want: u64) {
    if got.to_bits() != want {
        println("{what} = {got} [{got.to_bits()}], want {f64.from_bits(want)} [{want}]")
    }
}

fn main() {
    println("{exp(1.0)} {log(2.0)} {pow(2.0, 0.5)}")    // out: 2.718281828459045 0.6931471805599453 1.4142135623730951
    println("{exp(f64.NEG_INFINITY)} {exp(1000.0)} {exp(-1000.0)} {exp(f64.NAN)}")    // out: 0.0 Infinity 0.0 NaN
    println("{log(0.0)} {log(-0.0)} {log(-1.0)} {log(f64.INFINITY)}")    // out: -Infinity -Infinity NaN Infinity
    println("{pow(f64.NAN, 0.0)} {pow(1.0, f64.INFINITY)} {pow(-8.0, 1.0 / 3.0)} {pow(-0.0, -3.0)}")    // out: 1.0 NaN NaN -Infinity
    println("{pow(-2.0, 3.0)} {pow(-2.0, 1.0e300)} {pow(0.5, -2000.0)} {pow(-1.0e-200, 3.0)}")    // out: -8.0 Infinity Infinity -0.0
    println("{sin(PI / 6.0)} {cos(PI)} {atan2(1.0, -1.0)} {acos(-1.0) == PI} {log10(1000.0)} {E}")    // out: 0.49999999999999994 -1.0 2.356194490192345 true 3.0 2.718281828459045
    println("{sin(-0.0)} {cos(-0.0)} {tan(-0.0)} {sin(1.0e-300)} {cos(1.0e-9)} {tan(-1.0e-9)}")    // out: -0.0 1.0 -0.0 1.0E-300 1.0 -1.0E-9
    println("{sin(f64.INFINITY)} {cos(f64.NEG_INFINITY)} {tan(f64.NAN)} {sin(1.0e300) == sin(1.0e300)}")    // out: NaN NaN NaN true
    check("pow(2.0, 10.0)", pow(2.0, 10.0), 0x4090000000000000)
    check("pow(-3.0, 3.0)", pow(-3.0, 3.0), 0xc03b000000000000)
    check("pow(10.0, 15.0)", pow(10.0, 15.0), 0x430c6bf526340000)
    check("pow(0.5, 1074.0)", pow(0.5, 1074.0), 0x0000000000000001)
    check("pow(1075.0, 7.0)", pow(1075.0, 7.0), 0x44567bfba4b73d41)
    check("pow(7.0, 22.0)", pow(7.0, 22.0), 0x43cb213cc3a81131)
    check("pow(745.1332191019411, 10.0)", pow(745.1332191019411, 10.0), 0x45e54fb068581353)
    check("pow(1e-20, -10.0)", pow(1e-20, -10.0), 0x6974e718d7d7625d)
    check("exp(1.0)", exp(1.0), 0x4005bf0a8b145769)
    check("exp(-1.0)", exp(-1.0), 0x3fd78b56362cef38)
    check("exp(0.5)", exp(0.5), 0x3ffa61298e1e069c)
    check("exp(10.0)", exp(10.0), 0x40d5829dcf950560)
    check("exp(700.0)", exp(700.0), 0x7f0d945df4f8ec8e)
    check("exp(-740.0)", exp(-740.0), 0x0000000000000055)
    check("exp(1e-10)", exp(1e-10), 0x3ff000000006df38)
    check("log(2.0)", log(2.0), 0x3fe62e42fefa39ef)
    check("log(10.0)", log(10.0), 0x40026bb1bbb55516)
    check("log(0.5)", log(0.5), 0xbfe62e42fefa39ef)
    check("log(1.0000001)", log(1.0000001), 0x3e7ad7f2847b6492)
    check("log(1e-300)", log(1e-300), 0xc085963447f87fb5)
    check("log(5e-324)", log(5e-324), 0xc0874385446d71c3)
    check("log(1.7976931348623157e+308)", log(1.7976931348623157e+308), 0x40862e42fefa39ef)
    check("sin(1.0)", sin(1.0), 0x3feaed548f090cee)
    check("sin(0.5)", sin(0.5), 0x3fdeaee8744b05f0)
    check("sin(10.0)", sin(10.0), 0xbfe1689ef5f34f52)
    check("sin(PI)", sin(PI), 0x3ca1a62633145c07)
    check("sin(1e5)", sin(1e5), 0x3fa24daa9c527e96)
    check("sin(1e-5)", sin(1e-5), 0x3ee4f8b588e1e8a2)
    check("sin(-2.5)", sin(-2.5), 0xbfe326af0dcfcab1)
    check("cos(1.0)", cos(1.0), 0x3fe14a280fb5068c)
    check("cos(PI / 4.0)", cos(PI / 4.0), 0x3fe6a09e667f3bcd)
    check("cos(10.0)", cos(10.0), 0xbfead9ac890c6b1f)
    check("cos(PI / 2.0)", cos(PI / 2.0), 0x3c91a62633145c07)
    check("cos(1e5)", cos(1e5), 0xbfeffac3841b3da7)
    check("cos(-3.0)", cos(-3.0), 0xbfefae04be85e5d2)
    check("tan(1.0)", tan(1.0), 0x3ff8eb245cbee3a6)
    check("tan(PI / 4.0)", tan(PI / 4.0), 0x3fefffffffffffff)
    check("tan(PI / 2.0)", tan(PI / 2.0), 0x434d02967c31cdb5)
    check("tan(10.0)", tan(10.0), 0x3fe4bf5f34be3782)
    check("tan(-1e5)", tan(-1e5), 0x3fa250a9d503313d)
    check("tan(1e-5)", tan(1e-5), 0x3ee4f8b588e6698e)
    // The double below 2^20 nearest an odd multiple of pi/2, relative to its size: x - k pi/2
    // is about 4.4e-17, so cos and tan depend on the reduction's last bits.
    check("sin(321307.9594422229)", sin(321307.9594422229), 0xbff0000000000000)
    check("cos(321307.9594422229)", cos(321307.9594422229), 0xbc8988efe18ff83f)
    check("tan(321307.9594422229)", tan(321307.9594422229), 0x43540d0d167bccd6)
    println("ok")    // out: ok
}
