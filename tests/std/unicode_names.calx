// std.unicode.names gives the names Python 3.14's unicodedata and Java 25's Character give
// (CLX-235): names made by rule and kept in the tables, aliases, named sequences, case, Java's
// names by block, and runes with no name. Each line is what Python or Java gave.
import std.unicode.names.{java_code_point_of, java_name, lookup, lookup_rune, name}

fn one(t: str) -> String {
    let r = lookup_rune(String(t)) else return String("none")
    return "{u32(r):X}"
}

fn codes(s: String?) -> String {
    let text = s else return String("none")
    var parts: List<String> = []
    for r in text.runes() {
        parts.push("{u32(r):X}")
    }
    return parts.join(" ")
}

fn named(c: u32) -> String {
    return name(rune.try_from(c)!) ?? String("none")
}

fn java(c: u32) -> String {
    return java_name(c) ?? String("none")
}

fn point(text: str) -> String {
    return match java_code_point_of(String(text)) {
        some(c) => "{c:X}",
        none => String("none"),
    }
}

fn main() {
    println(named(0x41))    // out: LATIN CAPITAL LETTER A
    println(named(0xE9))    // out: LATIN SMALL LETTER E WITH ACUTE
    println(named(0x1F600))    // out: GRINNING FACE
    // Hangul syllables and CJK ideographs are named by rule, and so are the families numbered in
    // the tables.
    println("{named(0xAC00)}, {named(0xD7A3)}, {named(0x4E00)}, {named(0x2EBF0)}")
    // out: HANGUL SYLLABLE GA, HANGUL SYLLABLE HIH, CJK UNIFIED IDEOGRAPH-4E00, CJK UNIFIED IDEOGRAPH-2EBF0
    println("{named(0xF900)}, {named(0x18800)}, {named(0xFE0F)}, {named(0xE01EF)}, {named(0x1D200)}")
    // out: CJK COMPATIBILITY IDEOGRAPH-F900, TANGUT COMPONENT-001, VARIATION SELECTOR-16, VARIATION SELECTOR-256, GREEK VOCAL NOTATION SYMBOL-1
    // Hyphens inside and at the ends of words.
    println("{named(0x1180)}, {named(0xF60)}, {named(0xFD0)}")
    // out: HANGUL JUNGSEONG O-E, TIBETAN LETTER -A, TIBETAN MARK BSKA- SHOG GI MGO RGYAN
    // No name: a control, private use, a Tangut ideograph, one not assigned yet.
    println("{named(0)} {named(0x9F)} {named(0xE000)} {named(0x17000)} {named(0x378)} {named(0x10FFFF)}")
    // out: none none none none none none

    println("{codes(lookup("LATIN SMALL LETTER A"))} {codes(lookup("latin small letter a"))} {codes(lookup("Latin Small Letter A"))}")
    // out: 61 61 61
    // Aliases: corrections, controls, abbreviations.
    println("{codes(lookup("LF"))} {codes(lookup("NBSP"))} {codes(lookup("bom"))} {codes(lookup("LATIN CAPITAL LETTER GHA"))}")
    // out: A A0 FEFF 1A2
    println("{codes(lookup("PRESENTATION FORM FOR VERTICAL RIGHT WHITE LENTICULAR BRAKCET"))} {codes(lookup("PRESENTATION FORM FOR VERTICAL RIGHT WHITE LENTICULAR BRACKET"))}")
    // out: FE18 FE18
    // Named sequences are more than one rune.
    println("{codes(lookup("KEYCAP NUMBER SIGN"))}, {codes(lookup("BENGALI LETTER KHINYA"))}")
    // out: 23 FE0F 20E3, 995 9CD 9B7
    // `lookup_rune` gives one rune, as `re`'s `\N{...}` takes `ord` of what `lookup` gives, so no
    // named sequence (CLX-239).
    println("{one("nbsp")} {one("HANGUL SYLLABLE GAG")} {one("cjk unified ideograph-4e00")} {one("TANGUT IDEOGRAPH-17000")} {one("VARIATION SELECTOR-17")} {one("KEYCAP NUMBER SIGN")} {one("é")}")
    // out: A0 AC01 4E00 17000 E0100 none none
    // Hangul syllables take the longest jamo names that fit.
    println("{codes(lookup("hangul syllable gag"))} {codes(lookup("HANGUL SYLLABLE GGA"))} {codes(lookup("HANGUL SYLLABLE GAGG"))} {codes(lookup("HANGUL SYLLABLE A"))} {codes(lookup("HANGUL SYLLABLE KKAG"))}")
    // out: AC01 AE4C AC02 C544 none
    // Numbers in hex in either case, but with no zero in front, and only for runes in the ranges.
    println("{codes(lookup("cjk unified ideograph-4e00"))} {codes(lookup("CJK UNIFIED IDEOGRAPH-04E00"))} {codes(lookup("CJK UNIFIED IDEOGRAPH-4DC0"))}")
    // out: 4E00 none none
    println("{codes(lookup("tangut ideograph-187f7"))} {codes(lookup("TANGUT IDEOGRAPH-187F8"))} {codes(lookup("variation selector-17"))} {codes(lookup("VARIATION SELECTOR-0017"))}")
    // out: 187F7 none E0100 none
    // Only ASCII letters change case, and the name must be exact.
    println("{codes(lookup(" LATIN SMALL LETTER A"))} {codes(lookup("LATIN  SMALL LETTER A"))} {codes(lookup("LAT\u{130}N SMALL LETTER A"))} {codes(lookup(""))}")
    // out: none none none none

    // Java names a control by its Unicode 1 name, and a rune with no name by its block.
    println("{java(0)}, {java(0xA)}, {java(0x9F)}, {java(0x84)}")
    // out: NULL, LINE FEED (LF), APPLICATION PROGRAM COMMAND, LATIN 1 SUPPLEMENT 84
    println("{java(0xAC00)}, {java(0x4E00)}, {java(0xD800)}, {java(0xE000)}, {java(0x10FFFD)}")
    // out: HANGUL SYLLABLES AC00, CJK UNIFIED IDEOGRAPHS 4E00, HIGH SURROGATES D800, PRIVATE USE AREA E000, SUPPLEMENTARY PRIVATE USE AREA B 10FFFD
    println("{java(0xF900)} {java(0x378)} {java(0x110000)}")
    // out: CJK COMPATIBILITY IDEOGRAPH-F900 none none
    // Java's codePointOf takes what getName gives, in any case, trimmed, but no aliases.
    println("{point(" latin small letter a\u{1}")} {point("LINE FEED (LF)")} {point("LF")} {point("HIGH SURROGATES D800")} {point("CJK UNIFIED IDEOGRAPHS 4E00")}")
    // out: 61 A none D800 4E00
    println("{point("CJK UNIFIED IDEOGRAPH-4E00")} {point("LATIN 1 SUPPLEMENT 084")} {point("LATIN 1 SUPPLEMENT 84")} {point("UNASSIGNED 378")}")
    // out: none none 84 none
}
