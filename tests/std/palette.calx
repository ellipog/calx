// std.palette keeps containers as vanilla 26.3's PalettedContainer keeps them. Each order, byte
// and outcome below is vanilla's: the rig's `palette` probe ran the same operations on vanilla's
// own classes (calcite/cases/palette), and Calcite's flat world sends the section that's first.
// Where vanilla doesn't fail, an empty palette and an index past its end, Calcite does (D163).

import std.palette.{BitStorage, Packed, PalettedContainer, Strategy}

fn hex64(v: i64) -> String {
    let digits = "0123456789abcdef"
    var s = String()
    for k in 0..16 {
        let d = usize(u8.wrap(v >>> (60 - k * 4)) & 15)
        s.push_str(digits[d..d + 1])
    }
    return s
}

fn hex(bytes: List<u8>, from: usize, to: usize) -> String {
    let digits = "0123456789abcdef"
    var s = String()
    for i in from..to {
        let hi = usize(bytes[i] / 16)
        let lo = usize(bytes[i] % 16)
        s.push_str(digits[hi..hi + 1])
        s.push_str(digits[lo..lo + 1])
    }
    return s
}

fn outcome(strategy: Strategy, packed: own Packed) -> String {
    return match PalettedContainer.unpack(strategy, packed) {
        ok(c) => "bits {c.bits()}, {c.get_at(0)} first",
        err(e) => "{e}",
    }
}

fn storage() {
    // 5 bits: 12 values in each long, so 64 values take 6.
    var s = BitStorage.new(5, 64)
    println("{s.bits()} {s.len()} {s.longs().len()}")    // out: 5 64 6
    s.set(0, 31)
    s.set(12, 7)
    println("{s.get(0)} {s.get(1)} {s.get(12)} {s.get_and_set(12, 9)} {s.get(12)}")    // out: 31 0 7 7 9
    println("{hex64(s.longs()[0])} {hex64(s.longs()[1])}")    // out: 000000000000001f 0000000000000009
    // Fill spreads the value by doubling, so the 4 bits above a long's 12 values hold its low bits.
    s.fill(1)
    println("{hex64(s.longs()[0])} {s.values()[63]}")    // out: 1084210842108421 1
    s.fill(22)
    println("{hex64(s.longs()[0])}")    // out: 6b5ad6b5ad6b5ad6
    // Bits that divide 64 leave nothing above the values.
    var q = BitStorage.new(4, 32)
    q.fill(5)
    println("{q.longs().len()} {hex64(q.longs()[0])}")    // out: 2 5555555555555555
    // 0 bits: every value is 0, and there are no longs.
    let z = BitStorage.new(0, 4096)
    println("{z.len()} {z.get(4095)} {z.longs().len()}")    // out: 4096 0 0
    // 32 bits hold every u32.
    var w = BitStorage.new(32, 3)
    w.set(2, 4294967295)
    println("{w.get(2)} {w.longs().len()} {hex64(w.longs()[1])}")    // out: 4294967295 2 00000000ffffffff
    // Loaded longs are kept as they are, the bits above the values too.
    let raw: List<i64> = [-1, 3]
    let l = BitStorage.from_longs(30, 3, raw)!
    println("{l.values()} {hex64(l.longs()[0])}")    // out: [1073741823, 1073741823, 3] ffffffffffffffff
    let short: List<i64> = [0]
    match BitStorage.from_longs(30, 3, short) {
        ok(_) => println("loaded"),
        err(e) => println("{e}"),    // out: Length { got: 1, expected: 2 }
    }
}

fn strategies() {
    let blocks = Strategy.block_states(35723)
    let biomes = Strategy.biomes(65)
    println("{blocks.size()} {blocks.registry_size()} {blocks.index(1, 2, 3)} {blocks.index(15, 15, 15)}")    // out: 4096 35723 561 4095
    println("{biomes.size()} {biomes.registry_size()} {biomes.index(1, 2, 3)}")    // out: 64 65 45
}

// The flat world's bottom section: bedrock, two dirt, then grass, over air.
fn flat() {
    let blocks = Strategy.block_states(35723)
    var c = PalettedContainer.new(0, blocks)
    for x in 0..16 {
        for z in 0..16 {
            c.set(x, 0, z, 88)
            c.set(x, 1, z, 10)
            c.set(x, 2, z, 10)
            c.set(x, 3, z, 9)
        }
    }
    var out: List<u8> = []
    c.write(mut out)
    // 4 bits, then 4 entries in the order they were added, then 256 longs with no count.
    println("{c.bits()} {out.len()} {hex(out, 0, 14)}")    // out: 4 2054 040400580a091111111111111111
    println("{c.get(3, 0, 7)} {c.get(0, 3, 0)} {c.get(0, 4, 0)} {c.counts()}")    // out: 88 9 0 [(0, 3072), (88, 256), (10, 512), (9, 256)]
    // Packing lists the values in the order they first appear, from index 0 up.
    let p = c.pack()
    println("{p.palette}")    // out: [88, 10, 9, 0]
    if let d = p.data {
        println("{d.len()} {hex64(d[0])} {hex64(d[16])} {hex64(d[48])} {hex64(d[64])}")    // out: 256 0000000000000000 1111111111111111 2222222222222222 3333333333333333
    }
    let back = PalettedContainer.unpack(blocks, p)!
    var again: List<u8> = []
    back.write(mut again)
    println("{back.counts()} {hex(again, 0, 6)}")    // out: [(88, 256), (10, 512), (9, 256), (0, 3072)] 0404580a0900
}

// The palette grows: one entry takes no bits, up to 16 take 4, up to 256 take 5 to 8, and more
// take the 16 bits of a block state's ID, with no palette.
fn growth() {
    let blocks = Strategy.block_states(35723)
    var c = PalettedContainer.new(0, blocks)
    var seen = String()
    for i in 0usize..300 {
        c.set_at(i, u32.wrap(i + 1))
        // The container now holds i + 2 values.
        if i == 0 or i == 14 or i == 15 or i == 30 or i == 31 or i == 254 or i == 255 {
            seen.push_str(" {i + 2}:{c.bits()}")
        }
    }
    println("values:bits{seen}")    // out: values:bits 2:4 16:4 17:5 32:5 33:6 256:8 257:16
    var out: List<u8> = []
    c.write(mut out)
    // With no palette, the bits are followed straight by the longs: 4,096 values, 4 to a long.
    println("{out.len()} {hex(out, 0, 9)} {c.counts().len()} {c.get_at(299)} {c.get_at(300)}")    // out: 8193 100004000300020001 301 300 0
    let p = c.pack()
    // On disk, 301 entries take 9 bits, 7 to a long.
    if let d = p.data {
        println("{p.palette.len()} {p.palette[0]} {p.palette[300]} {d.len()}")    // out: 301 1 0 586
    }

    let biomes = Strategy.biomes(65)
    var b = PalettedContainer.new(0, biomes)
    var bits = String()
    for i in 0usize..10 {
        b.set_at(i, u32.wrap(i + 1))
        bits.push_str(" {b.bits()}")
    }
    // Biomes take 1, 2 and 3 bits, then the 7 of a biome's ID; on disk, 11 entries take 4.
    println("biomes{bits}")    // out: biomes 1 2 2 3 3 3 3 7 7 7
    let bp = b.pack()
    if let d = bp.data {
        println("{bp.palette.len()} {d.len()} {hex64(d[0])}")    // out: 11 4 aaaaaa9876543210
    }
}

// Entries nothing refers to stay until the palette is full, and the resize drops them.
fn dropped() {
    let blocks = Strategy.block_states(35723)
    var c = PalettedContainer.new(0, blocks)
    for v in 1u32..16 {
        c.set_at(5, v)
    }
    var out: List<u8> = []
    c.write(mut out)
    println("{c.bits()} {out[1]} {c.counts()}")    // out: 4 16 [(0, 4095), (15, 1)]
    c.set_at(5, 16)
    out.clear()
    c.write(mut out)
    println("{c.bits()} {hex(out, 0, 5)} {c.counts()}")    // out: 5 0503000f10 [(0, 4095), (16, 1)]
    // What `set` overwrote is still in the palette, so `get_and_set` finds 15's entry again.
    println("{c.get_and_set_at(5, 15)} {c.get_and_set_at(6, 16)} {c.counts()}")    // out: 16 0 [(0, 4094), (15, 1), (16, 1)]
}

fn unpacks() {
    let blocks = Strategy.block_states(35723)
    let biomes = Strategy.biomes(65)
    // One entry needs no data, and any that's there is ignored.
    println(outcome(blocks, Packed { palette: [5], data: none }))    // out: bits 0, 5 first
    println(outcome(blocks, Packed { palette: [5], data: some([1, 2]) }))    // out: bits 0, 5 first
    println(outcome(blocks, Packed { palette: [], data: none }))    // out: Empty
    println(outcome(blocks, Packed { palette: [1, 2], data: none }))    // out: MissingData
    println(outcome(blocks, Packed { palette: [1, 2], data: some([0, 0, 0]) }))    // out: Length { got: 3, expected: 256 }
    // 300 entries are 9 bits on disk: 586 longs.
    println(outcome(blocks, Packed { palette: [0u32; 300], data: some([0i64; 10]) }))    // out: Length { got: 10, expected: 586 }
    // Value 3 of a palette of 2.
    var past: List<i64> = [0i64; 256]
    past[0] = 0x3000
    println(outcome(blocks, Packed { palette: [1, 2], data: some(past) }))    // out: Index { at: 3, index: 3 }
    // The bits above the values in each long are kept with a palette, as they're sent, and
    // dropped when the values become IDs. 17 entries take 5 bits, 12 to a long, with 4 above.
    var few: List<u32> = []
    var entries: List<u32> = []
    for j in 0u32..300 {
        if j < 17 {
            few.push(j * 7)
        }
        entries.push(j * 7)
    }
    var padded: List<i64> = [i64.MIN; 342]
    padded[0] = i64.MIN | 2
    let c = PalettedContainer.unpack(blocks, Packed { palette: few, data: some(padded) })!
    var out: List<u8> = []
    c.write(mut out)
    println("{c.bits()} {c.get_at(0)} {c.get_at(1)} {hex(out, 19, 27)} {c.counts()}")    // out: 5 14 0 8000000000000002 [(0, 4095), (14, 1)]
    // 300 entries take 9 bits, 7 to a long, with 1 above.
    var wide: List<i64> = [i64.MIN; 586]
    wide[0] = i64.MIN | 299
    let g = PalettedContainer.unpack(blocks, Packed { palette: entries, data: some(wide) })!
    out.clear()
    g.write(mut out)
    println("{g.bits()} {g.get_at(0)} {g.get_at(1)} {hex(out, 1, 9)} {g.counts()}")    // out: 16 2093 0 000000000000082d [(0, 4095), (2093, 1)]
    println(outcome(biomes, Packed { palette: [20, 21, 22, 23, 24, 25, 26, 27, 28], data: some([0x0123456787654321, 0, 0, 0]) }))    // out: bits 7, 21 first
    println(outcome(biomes, Packed { palette: [1, 2], data: some([]) }))    // out: Length { got: 0, expected: 1 }
}

fn main() {
    storage()
    strategies()
    flat()
    growth()
    dropped()
    unpacks()
}
