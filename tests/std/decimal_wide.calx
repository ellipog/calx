// std.decimal's long divisions, which work in limbs of 18 digits once the divisor has 5 limbs of 9
// (CLX-147), against what Python's decimal gives. The first three divide a dividend whose top limbs
// over the divisor's give a quotient limb one too big, which the next limbs don't catch: the step
// that adds the divisor back runs, which random values reach once in about 10^18. In the third the
// divisor's top limb is under a third of 10^18, so both are scaled by 3 first and the remainder is
// scaled back. build/scratch/clx147/wide_cases.py made them. Then quotients, square roots and
// remainders at 300 and 1000 digits, by the CRC-32 of their text.

import std.decimal.{Context, Decimal}
import std.zlib.{crc32}

fn show(d: Decimal) -> String {
    let t = "{d}"
    return "{t.len()} {crc32(t.to_bytes())} {t[t.len() - 20..]}"
}

// The remainder, the quotient from it, and u / v at `prec` digits, a precision at which the
// dividend is shifted by a whole limb of 18 digits, so its first quotient limb is the one guessed
// too big: a quotient limb that wasn't put right would show there.
fn back(c: Context, u: str, v: str, prec: u32) {
    let x = c.parse(String(u))!
    let y = c.parse(String(v))!
    let r = x % y
    println("{r}")
    println("{(x - r) / y}")
    println("{x.with_prec(prec) / y.with_prec(prec)}")
}

fn main() {
    let c = Context.new(200)
    back(c, "493827160993839353402885693816855046412240549498259003999999999999999999012345678012345678",
        "500000000000012345314159265358979323999999999999999999999999999999999999", 35)
    // out: 500000000000012345314159265358979323999999999999999999999999999999999998
    // out: 987654321987654320
    // out: 987654321987654321.00000000000000000
    back(c, "999999999999999998999999999999999999000000000000000000999999999999999999000000000000000000",
        "999999999999999999999999999999999998999999999999999999999999999999999999", 35)
    // out: 999999999999999999999999999999999998999999999999999999999999999999999998
    // out: 999999999999999998
    // out: 999999999999999999.00000000000000000
    back(c, "35802468813580246631186344872405385932422558298912875999999999999999999958847736995884773",
        "290000000000000000090609394281968175333333333333333333333333333333333333", 34)
    // out: 290000000000000000090609394281968175333333333333333333333333333333333332
    // out: 123456789012345677
    // out: 123456789012345678.0000000000000000

    for p in [300u32, 1000] {
        let k = Context.new(p)
        let x = k.from(2).sqrt()
        let y = k.from(3).sqrt()
        println(show(x / y))
        println(show(k.from(7).sqrt()))
        println(show(x * k.parse("1E{p / 2}")! % y))
    }
    // out: 302 3167423206 67279433360529935947
    // out: 301 246327439 04158151990440347432
    // out: 301 1608321548 29489855286332264205
    // out: 1002 1906415372 92770122336511774908
    // out: 1001 3047872404 08067233469812000430
    // out: 1001 1030392016 75776917692293803462
}
