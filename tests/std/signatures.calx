    return #"
        6a7dd7de5322098175c229da81f87e8f81d1daa9a69a0f0b753a205ef7a0a1727a23c7b2b8230159aed2ebc7c4de0f7b
        804bfd5e88b521e1057abdcef95e832a051ff60bced0b0c94a0379691efaa65138645ab098af92d4654c98d9b22222c2
        3ae3dfbd360b37bf965550cebaa92ef6176d87412e5c7c4219d885827bb24f22
        "#
}

fn sig_1024_sha256() -> String {
