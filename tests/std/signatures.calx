// RSA signatures, PKCS#1 v1.5: checked against signatures and keys from Java's `Signature` and
// `KeyPairGenerator` (JDK 25), and made by `RsaKey.sign`, which signs as they do.
import std.crypto.{RsaKey, RsaPublicKey}
import std.hash.{Algorithm}

fn unhex(text: String) -> List<u8> {
    var out = List<u8>()
    var high = -1
    for i in 0..text.len() {
        let c = text.byte_at(i)
        // The digits come in lines, with the text's line breaks between them.
        if c == 10 or c == 13 or c == 32 {
            continue
        }
        if high < 0 {
            high = digit(c)
        } else {
            out.push(u8.wrap(high * 16 + digit(c)))
            high = -1
        }
    }
    return out
}

fn digit(c: u8) -> i32 {
    return if c >= 97 { i32(c) - 87 } else { i32(c) - 48 }
}

fn reads(der: List<u8>) -> bool {
    return match RsaPublicKey.from_der(der) {
        some(_) => true,
        none => false,
    }
}

fn flip(bytes: List<u8>, at: usize) -> List<u8> {
    var out = bytes.copy()
    out[at] = out[at] ^ 1
    return out
}

// The JDK's 1024-bit key, as `getEncoded()` gives it, and its signatures of `Calx signs this`.
fn key_1024() -> String {
    return #"
        30819f300d06092a864886f70d010101050003818d0030818902818100803f9bd2de8e7bc1db040e366bb526fca6bdf8
        ba135ae4588561ed52545c86b003831828435b35c3932d830f9e5664962dacc31bf1ec5f3aedb544fa473624d1e509aa
        75c74a05930dfe9910b356b34365a044df719507350c44e10b740717fef5a189199dc6f992a0174f475d388c5937a822
        a7416d6e55e9172458f6b74f290203010001
        "#
}

