        fb8fbc3257c6f387a5b0daeaf060a8997297786091843ad78a3e43604041909a
        "#
}

fn check(bits: String, der: String, sha1: String, sha256: String) {
    let message = "Calx signs this".to_bytes()
    let key = RsaPublicKey.from_der(unhex(der)) ?? panic("the JDK's {bits}-bit key doesn't read")
    let s1 = unhex(sha1)
    let s256 = unhex(sha256)
    let good = key.verify(Algorithm.Sha1, message.copy(), s1.copy()) and key.verify(Algorithm.Sha256, message.copy(), s256.copy())
    // The wrong hash, another message, or a flipped bit isn't the signature.
    let swapped = key.verify(Algorithm.Sha256, message.copy(), s1.copy()) or key.verify(Algorithm.Sha1, message.copy(), s256.copy())
    let other = key.verify(Algorithm.Sha256, "Calx signs that".to_bytes(), s256.copy())
    let flipped = key.verify(Algorithm.Sha256, message.copy(), flip(s256, key.size() - 1))
    println("{bits} {key.size()} {good} {swapped} {other} {flipped} {key.der() == unhex(der)}")
}

fn main() {
    check("1024", key_1024(), sig_1024_sha1(), sig_1024_sha256())     // out: 1024 128 true false false false true
    check("2048", key_2048(), sig_2048_sha1(), sig_2048_sha256())     // out: 2048 256 true false false false true
    check("4096", key_4096(), sig_4096_sha1(), sig_4096_sha256())     // out: 4096 512 true false false false true

    // A signature of the wrong length, or one that's the modulus or more, is no signature.
    let k = RsaPublicKey.from_der(unhex(key_2048()))!
    let message = "Calx signs this".to_bytes()
    var short = unhex(sig_2048_sha256())
    _ = short.pop()
    let all_ones: List<u8> = [0xFF; 256]
    println("{k.verify(Algorithm.Sha256, message.copy(), short)} {k.verify(Algorithm.Sha256, message.copy(), all_ones)} {k.verify(Algorithm.Sha256, message.copy(), [])}")    // out: false false false

    // What a key pair signs, its public key checks, and the same message signs the same, as
    // PKCS#1 v1.5 has no randomness.
    let pair = RsaKey.generate(2048)
    let public = pair.public_key()
    let signed = pair.sign(Algorithm.Sha256, message.copy())
    let again = pair.sign(Algorithm.Sha256, message.copy())
    println("{signed.len()} {public.verify(Algorithm.Sha256, message.copy(), signed.copy())} {signed == again} {public.der() == pair.public_der()}")    // out: 256 true true true
    let small = RsaKey.generate(1024)
    let s1 = small.sign(Algorithm.Sha1, message.copy())
    println("{s1.len()} {small.public_key().verify(Algorithm.Sha1, message.copy(), s1.copy())} {public.verify(Algorithm.Sha1, message.copy(), s1)}")    // out: 128 true false

    // DER that isn't a key as `getEncoded()` writes one doesn't read: cut short, with a byte
    // after it, or with another algorithm.
    let der = unhex(key_2048())
    var cut = der.copy()
    _ = cut.pop()
    var longer = der.copy()
    longer.push(0)
    var bad_oid = der.copy()
    bad_oid[16] = 2
    println("{reads(der)} {reads(cut)} {reads(longer)} {reads(bad_oid)} {reads([])}")    // out: true false false false false
}
