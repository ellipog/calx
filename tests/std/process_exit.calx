// std.process.exit ends the program at once with its status, from any thread: what was printed
// is written, then what at_exit says, and nothing after the call runs.
import std.process.{exit}
import std.term.{at_exit}
import std.thread.{Task}

fn main() {
    at_exit("put back\n")
    println("started")    // out: started
    var done = Receiver<i32>()
    _ = unsafe { Thread.spawn(Ender { done: done.sender(), code: 7 }) }
    _ = done.wait()
    println("not reached")
}

struct Ender {
    done: Sender<i32>
    code: u8
}

impl Task for Ender {
    fn run(own self) {
        println("ending")    // out: ending
        // `exit` returns `never` (CLX-153), so code right after it is an error; behind an `if`,
        // this tells `main` to go on, and print what it mustn't, if `exit` ever returns.
        if self.code > 0 {
            exit(self.code)
        }
        var done = self.done
        done.send(1)
    }
}
// out: put back
// status: 7
