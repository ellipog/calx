// std.net's `Ip.parse`, as Python's `ipaddress.ip_address` reads addresses, and what an address
// is: loopback, link-local or multicast (CLX-412).
import std.net.{Ip}

fn shown(text: String) -> String {
    return match Ip.parse(text) {
        some(ip) => ip.to_string(),
        none => String("none"),
    }
}

fn main() {
    for t in ["127.0.0.1", "0.0.0.0", "255.255.255.255", "192.168.1.20"] {
        println(shown(t))
    }
    // out: 127.0.0.1
    // out: 0.0.0.0
    // out: 255.255.255.255
    // out: 192.168.1.20
    // Leading zeros, too few or many parts, and numbers past 255 aren't IPv4, as in Python 3.9.5
    // and later.
    let not_v4: List<String> = ["01.2.3.4", "1.2.3", "1.2.3.4.5", "256.0.0.1", "1..2.3", "", "a.b.c.d", "1.2.3.4 "]
    println(not_v4.map(|t| shown(t)).join(" "))    // out: none none none none none none none none
    for t in ["::", "::1", "fe80::1%3", "2001:DB8::8:800:200C:417A", "1:2:3:4:5:6:7:8", "::ffff:192.0.2.1", "64:ff9b::192.0.2.33", "1::"] {
        println(shown(t))
    }
    // out: ::
    // out: ::1
    // out: fe80::1%3
    // out: 2001:db8::8:800:200c:417a
    // out: 1:2:3:4:5:6:7:8
    // out: ::ffff:192.0.2.1
    // out: 64:ff9b::c000:221
    // out: 1::
    let not_v6: List<String> = [":::", "1::2::3", "1:2:3:4:5:6:7:8:9", "1:2:3:4:5:6:7", "12345::", "g::1", "fe80::1%", "fe80::1%x", "1:2:3:4:5:6:7::8", ":1::"]
    println(not_v6.map(|t| shown(t)).join(" "))    // out: none none none none none none none none none none
    let lo = Ip.parse("::1")!
    let ll = Ip.parse("fe80::1%3")!
    let group = Ip.parse("224.0.0.251")!
    println("{lo.is_loopback()} {Ip.V4([127, 1, 2, 3]).is_loopback()} {group.is_loopback()}")    // out: true true false
    println("{ll.is_link_local()} {Ip.V4([169, 254, 0, 9]).is_link_local()} {lo.is_link_local()}")    // out: true true false
    println("{group.is_multicast()} {Ip.parse("ff02::fb")!.is_multicast()} {lo.is_multicast()}")    // out: true true false
    println("{group.is_v4()} {lo.is_v4()} {Ip.parse("::ffff:1.2.3.4")!.is_v4()}")    // out: true false false
}
