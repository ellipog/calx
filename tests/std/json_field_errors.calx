// `@json` reads `@json_key` on a field, and refuses any other attribute there, which is likely a
// misspelling.
import std.json.{json}

@json
struct Named {
    @json_name("x")    // error: `@json` doesn't read `@json_name`; the attributes it reads on fields are `@json_key`
    x: i32
}

fn main() {}
