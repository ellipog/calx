// std.xz's Decompressor and Compressor, which take a file a piece at a time (CLX-179): the
// Decompressor gives what `decompress` gives, and fails where it fails, however the bytes are cut
// into pieces, and the Compressor writes what `compress` writes. The hex is Python 3.14's
// lzma.compress's, or xz 5.8.3's, as in xz.calx.

import std.xz.{Check, Compressor, Decompressor, Error, Format, compress, decompress}

fn nibble(c: u8) -> u8 {
    return if c >= 97 { c - 87 } else { c - 48 }
}

fn unhex(s: str) -> List<u8> {
    var out: List<u8> = []
    var i: usize = 0
    while i < s.len() {
        out.push(nibble(s.byte_at(i)) * 16 + nibble(s.byte_at(i + 1)))
        i += 2
    }
    return out
}

fn text(bytes: own List<u8>) -> String {
    return String.from_utf8(bytes) ?? "not UTF-8"
}

fn joined(a: List<u8>, b: List<u8>) -> List<u8> {
    var out = a.copy()
    out.extend(b)
    return out
}

// Decompresses the bytes in pieces of `piece`, at most `most` at a time: what comes out, or the
// error, with where it came.
fn pieces(bytes: List<u8>, piece: usize, most: u64 = u64.MAX, format: Format = Format.Auto, limit: u64 = u64.MAX) -> String {
    var d = Decompressor.new(format, limit)
    var out = List<u8>()
    var at: usize = 0
    while at < bytes.len() {
        let end = if at + piece < bytes.len() { at + piece } else { bytes.len() }
        match d.add(bytes[at..end], most) {
            ok(part) => out.extend(part),
            err(e) => return "{e}, by byte {end}",
        }
        while not d.needs_input() {
            match d.add([], most) {
                ok(part) => out.extend(part),
                err(e) => return "{e}, by byte {end}",
            }
        }
        at = end
    }
    match d.finish() {
        ok(part) => out.extend(part),
        err(e) => return "{e}, at the end",
    }
    if out.len() >= 40 {
        return "ok {out.len()} bytes"
    }
    let lines = text(out).trim_end().replace("\n", " / ")
    return "ok {lines}"
}

// The same for pieces of 1, 3, 17 bytes and all at once, if they agree.
fn all_ways(bytes: List<u8>) -> String {
    let one = pieces(bytes, 1)
    for piece in [3usize, 17, bytes.len() + 1] {
        let got = pieces(bytes, piece)
        if got != one {
            return "pieces of 1 give {one}, of {piece} {got}"
        }
    }
    return one
}

fn main() {
    let hello = unhex("fd377a585a000004e6d6b4460200210116000000742fe5a301000968656c6c6f2c20787a0a000000eb12b68bfc71df280001220a151ae1671fb6f37d010000000004595a")
    let alone = unhex("5d00008000ffffffffffffffff00341949ee8def8c6a5793f0c06f15ceabfffedf3800")
    let lzip = unhex("4c5a4950011000341949ee8def8c6a5793bb880809717dffff07300000972e52d30c000000000000003100000000000000")
    let sha = unhex("fd377a585a00000ae1fb0ca10200210116000000742fe5a3010007636865636b65640a0077c2ca150b61c7330da139378ffd3940d093f1bd74a1294689345d27e15b512400013808e281c239189b4b9a01000000000a595a")
    println(all_ways(hello))    // out: ok hello, xz
    println(all_ways(alone))    // out: ok hello, lzma
    println(all_ways(lzip))    // out: ok hello, lzip
    println(all_ways(sha))    // out: ok checked

    // Delta, then x86 calls, then LZMA2, which the filters undo as the text comes.
    let chain = unhex("")
    let whole = decompress(chain.copy())!
    for piece in [1usize, 2, 5, 64] {
        var d = Decompressor.new()
        var out = List<u8>()
        var at: usize = 0
        while at < chain.len() {
            let end = if at + piece < chain.len() { at + piece } else { chain.len() }
            d.add_into(chain, at, end, u64.MAX, mut out)!
            at = end
        }
        d.finish_into(mut out)!
        println("{piece}: {out == whole}")
        // out: 1: true
        // out: 2: true
        // out: 5: true
        // out: 64: true
    }

    // `xz -T4 --block-size=1000`: six blocks with both sizes, which wait for each other and then
    // decode at once.
    let blocks = unhex("")
    println(all_ways(blocks))    // out: ok 5890 bytes
    // At most 1000 bytes at a time, which is less than a block, so they decode one at a time.
    println(pieces(blocks, 300, 1000))    // out: ok 5890 bytes
    println(pieces(blocks, 300, 1))    // out: ok 5890 bytes
    var broken = blocks.copy()
    broken[400] = broken[400] ^ 0x10
    println(pieces(broken, 1000))    // out: corrupt data, by byte 892
    // Where it fails depends on how many blocks wait for each other, so on the processors.
    println("{pieces(broken, 100).starts_with("corrupt data,")}")    // out: true

    // At most 4 bytes from each `add`: it says when it has more without more input.
    var d = Decompressor.new()
    var got = text(d.add(hello, 4)!)
    while not d.needs_input() {
        got.push_str("|{text(d.add([], 4)!)}")
    }
    println("{got.trim_end()} {text(d.finish()!)}|")    // out: hell|o, x|z |

    // Streams one after another, and what follows them.
    println(all_ways(joined(hello, alone)))    // out: ok hello, xz / hello, lzma
    var two = Decompressor.new()
    let both = two.add(joined(hello, joined(alone, lzip)))!
    println("{both.len()} {two.unused().len()} {two.finish()!.len()}")    // out: 34 0 0
    var trail = Decompressor.new()
    print(text(trail.add(joined(hello, "garbage!".to_bytes()))!))    // out: hello, xz
    println("{text(trail.unused())}")    // out: garbage!
    _ = trail.add("more".to_bytes())!
    println("{text(trail.unused())} {trail.finish()!.len()}")    // out: garbage!more 0
    println(pieces(joined(hello, [0u8, 0, 0, 0]), 5))    // out: the data ends early, at the end
    println(pieces(joined(hello, alone), 1, u64.MAX, Format.Xz))    // out: ok hello, xz

    // Broken files fail as `decompress` fails them, as soon as the bytes show it, but for one cut
    // short, which only `finish` can tell.
    println(pieces("not xz".to_bytes(), 1))    // out: not an .xz or .lzma file, by byte 5
    println(pieces([], 1))    // out: the data ends early, at the end
    var cut = hello.copy()
    cut.truncate(hello.len() - 3)
    println(pieces(cut, 7))    // out: the data ends early, at the end
    var bad_check = hello.copy()
    bad_check[40] = bad_check[40] ^ 1
    println(pieces(bad_check, 1))    // out: checksum mismatch, by byte 48
    var bad_chunk = hello.copy()
    bad_chunk[24] = 3
    println(pieces(bad_chunk, 1))    // out: corrupt data, by byte 25
    println(pieces(alone, 4, u64.MAX, Format.Xz))    // out: not an .xz or .lzma file, by byte 12
    println(pieces(hello, 10, u64.MAX, Format.Auto, 9))    // out: longer than the limit when decompressed, by byte 30
    println(pieces(hello, 10, u64.MAX, Format.Auto, 10))    // out: ok hello, xz
    // After failing, it fails the same way again.
    var failed = Decompressor.new()
    match failed.add(bad_chunk) {
        ok(_) => println("ok"),
        err(e) => println("{e}"),    // out: corrupt data
    }
    match failed.add(hello) {
        ok(_) => println("ok"),
        err(Error.Corrupt) => println("still corrupt"),    // out: still corrupt
        err(e) => println("{e}"),
    }

    // The Compressor writes what `compress` writes, a block at a time.
    var lines = String()
    for i in 0..30000 {
        lines.push_str("line {i}: the quick brown fox jumps over the lazy dog\n")
    }
    let source = lines.to_bytes()
    for preset in [0u32, 6] {
        for piece in [1000usize, 100000, source.len()] {
            var c = Compressor.new(preset, Check.Crc32, Format.Xz, false, 200000)
            var made = List<u8>()
            var at: usize = 0
            while at < source.len() {
                let end = if at + piece < source.len() { at + piece } else { source.len() }
                made.extend(c.add(source[at..end]))
                at = end
            }
            made.extend(c.finish())
            let same = made == compress(source.copy(), preset, Check.Crc32, Format.Xz, false, 200000)
            println("{preset} {piece}: {same} {decompress(made)! == source}")
            // out: 0 1000: true true
            // out: 0 100000: true true
            // out: 0 1668890: true true
            // out: 6 1000: true true
            // out: 6 100000: true true
            // out: 6 1668890: true true
        }
    }
    // Its first piece is the stream's header; nothing at all is an empty stream.
    var first = Compressor.new()
    println("{first.add("x".to_bytes()).len()} {Compressor.new().finish() == compress([])}")    // out: 12 true
    var lzma = Compressor.new(6, Check.Crc64, Format.Alone)
    println("{lzma.add(source[0..5000]).len()} {lzma.finish() == compress(source[0..5000], 6, Check.Crc64, Format.Alone)}")    // out: 0 true
}
