// std.process: a program started with `confine` reads and writes the folder it's given, reads
// the system's programs and runs them, and can't see the home, a folder beside its own or another
// drive, nor write anywhere else; the programs it starts are confined too; and it reaches the
// internet only if it may (CLX-479). The test runs itself as each confined program.
// needs: git
import std.env.{args, os, variable}
import std.fs.{exists, is_dir, list, make_dir_all, read_text, remove_dir_all, separator, temp_dir, write_text}
import std.http.{fetch}
import std.path.{parent_dir}
import std.process.{Command, Confine, Stdio, confine_supported, current_exe}
import std.uuid.{Uuid}

// What a confined program sees, each a word: what it tried, and whether it could.
fn child(a: List<String>) {
    let what = a[0].copy()
    if what == "write" {
        let f = "{a[1]}{separator()}note.txt"
        match write_text(f, "hello") {
            ok => {},
            err(_) => {
                println("denied")
                return
            },
        }
        match read_text(f) {
            ok(t) => println(if t == some(String("hello")) { "ok" } else { "wrong" }),
            err(_) => println("denied"),
        }
    } else if what == "list" {
        println(match list(a[1]) {
            ok(_) => "listed",
            err(_) => "denied",
        })
    } else if what == "read" {
        println(match read_text(a[1]) {
            ok(_) => "read",
            err(_) => "denied",
        })
    } else if what == "git" {
        println(match Command.new("git").arg("--version").stderr(Stdio.Null).read() {
            ok(v) => String(if v.starts_with("git version") { "ok" } else { "wrong" }),
            err(e) => "failed: {e}",
        })
    } else if what == "get" {
        println(match fetch(a[1], 20000) {
            ok(r) => if r.status == 200 { String("ok") } else { "status {r.status}" },
            err(_) => String("failed"),
        })
    } else if what == "nest" {
        // A program this one starts, which wasn't asked to be confined.
        println(match Command.new(current_exe()).args(["list", a[1].copy()]).read() {
            ok(v) => v,
            err(e) => "failed: {e}",
        })
    }
}

// Another drive, or what's mounted beside the system: D: or the next on Windows, `/Volumes` on
// macOS, `/mnt` on Linux, if there is one.
fn other_drive() -> String? {
    if os() == "windows" {
        for d in ["D", "E", "F", "G"] {
            let root = "{d}:\\"
            if is_dir(root) {
                return some(root)
            }
        }
        return none
    }
    let m = if os() == "macos" { "/Volumes" } else { "/mnt" }
    return if is_dir(m) { some(String(m)) } else { none }
}

fn home() -> String {
    return variable(if os() == "windows" { "USERPROFILE" } else { "HOME" }) ?? String()
}

// What the program run with `what` and `arg`, confined by `c`, said.
fn run(c: Confine, what: String, arg: String) -> String {
    return match Command.new(current_exe()).args([what.copy(), arg.copy()]).confine(c).read() {
        ok(v) => v,
        err(e) => "failed: {e}",
    }
}

fn main() {
    let a = args()
    if a.len() > 0 {
        child(a)
        return
    }
    if not confine_supported() {
        println("this system can't confine a program")
        return
    }
    let base = temp_dir()!
    let s = separator()
    let mine = "{base}{s}box"
    let beside = "{base}{s}beside"
    make_dir_all(mine)!
    make_dir_all(beside)!
    write_text("{beside}{s}secret.txt", "secret")!
    let name = "calx-test-{Uuid.random().simple()}"
    let exe_dir = parent_dir(current_exe()) ?? String(".")
    let c = Confine.new(name).write(mine).read(exe_dir)

    println("writes its folder: {run(c, "write", mine)}")              // out: writes its folder: ok
    println("lists the home: {run(c, "list", home())}")                // out: lists the home: denied
    println("lists a folder beside: {run(c, "list", beside)}")         // out: lists a folder beside: denied
    println("reads a file beside: {run(c, "read", "{beside}{s}secret.txt")}") // out: reads a file beside: denied
    println("writes a folder beside: {run(c, "write", beside)}")       // out: writes a folder beside: denied
    let other = match other_drive() {
        some(d) => run(c, "list", d),
        none => String("denied"),
    }
    println("lists another drive: {other}")                            // out: lists another drive: denied
    println("its programs: {run(c, "nest", home())}")                  // out: its programs: denied
    println("runs git: {run(c, "git", "")}")                           // out: runs git: ok
    println("offline: {run(c, "get", "https://example.com/")}")        // out: offline: failed
    let online = c.internet(true)
    println("online: {run(online, "get", "https://example.com/")}")    // out: online: ok
    println("lists the home online: {run(online, "list", home())}")    // out: lists the home online: denied
    match Confine.remove(name) {
        ok => println("removed"),                                  // out: removed
        err(e) => println("remove: {e}"),
    }
    // Once removed, the folder is the parent's alone again, and gone.
    remove_dir_all(base)!
    println("cleaned: {not exists(base)}")                             // out: cleaned: true
}
