// std.path: paths joined, taken apart, normalized and matched against globs, by the text alone,
// with what Windows reads differently checked on each system.
import std.env.{os}
import std.path.{path_root, is_absolute, join_path, file_name, parent_dir, file_stem, file_extension, with_extension, with_file_name, path_parts, normalize_path, glob_matches, glob_matches_name}

fn show(s: String?) -> String {
    if let v = s {
        return "[{v}]"
    }
    return "none"
}

fn describe(p: String) -> String {
    return "{show(file_name(p))} {show(parent_dir(p))} {show(file_stem(p))} {show(file_extension(p))}"
}

fn main() {
    // Names, parents, stems and extensions.
    println(describe("logs/report.txt"))    // out: [report.txt] [logs] [report] [txt]
    println(describe("archive.tar.gz"))    // out: [archive.tar.gz] [.] [archive.tar] [gz]
    println(describe(".bashrc"))    // out: [.bashrc] [.] [.bashrc] none
    println(describe("notes."))    // out: [notes.] [.] [notes] []
    println(describe("a/b/"))    // out: [b] [a] [b] none
    println(describe("a/b/."))    // out: [b] [a] [b] none
    println(describe("a/./b"))    // out: [b] [a] [b] none
    println(describe("a/.."))    // out: none [a] none none
    println(describe("../x"))    // out: [x] [..] [x] none
    println(describe("/srv"))    // out: [srv] [/] [srv] none
    println(describe("/"))    // out: none none none none
    println(describe("."))    // out: none none none none
    println(describe(""))    // out: none none none none

    // Joining.
    println("{join_path("a", "b")} {join_path("a/", "b")} {join_path("", "b")} {join_path("a", "/b")} {join_path("a", "")}")    // out: a/b a/b b /b a/
    println("{join_path(join_path("world", "region"), "r.0.0.mca")}")    // out: world/region/r.0.0.mca

    // Changing the last name.
    println("{with_extension("a/notes.txt", "md")} {with_extension("a/notes", "md")} {with_extension("a/notes.txt", "")} {with_extension("a/b/", "x")}")    // out: a/notes.md a/notes.md a/notes a/b.x
    println("{with_extension(".bashrc", "bak")} {with_extension("/", "x")} {with_extension("a/..", "x")}")    // out: .bashrc.bak / a/..
    println("{with_file_name("logs/old.txt", "new.txt")} {with_file_name("/", "x")} {with_file_name("a/..", "x")}")    // out: logs/new.txt /x a/../x

    // Parts and normalizing.
    println(path_parts("./logs/../x").join("|"))    // out: logs|..|x
    println(path_parts("/srv//world/").join("|"))    // out: /|srv|world
    println("{path_parts(".").len()}")    // out: 0
    println("{normalize_path("a/./b/../c/")} {normalize_path("/../a")} {normalize_path("../a/..")} {normalize_path("a/../..")}")    // out: a/c /a .. ..
    println("{normalize_path("./")} {normalize_path("")} {normalize_path("a//b")} {normalize_path("x/y/../../..")}")    // out: . . a/b ..

    // Globs.
    println("{glob_matches("src/main.calx", "src/*.calx")} {glob_matches("src/a/b/main.calx", "src/**/*.calx")} {glob_matches("src/main.calx", "src/**/*.calx")}")    // out: true true true
    println("{glob_matches("src/.git/x.calx", "src/**/*.calx")} {glob_matches("src/.h.calx", "src/*.calx")} {glob_matches("src/.h.calx", "src/.*.calx")}")    // out: false false true
    println("{glob_matches("logs/a/b", "logs/**")} {glob_matches("logs", "logs/**")} {glob_matches("logs/.a", "logs/**")}")    // out: true false false
    println("{glob_matches("a1", "a[0-9]")} {glob_matches("ab", "a[!0-9]")} {glob_matches("a5", "a[^0-9]")} {glob_matches("a-", "a[x-]")}")    // out: true true false true
    println("{glob_matches("a]", "a[]]")} {glob_matches("a*", "a[*]")} {glob_matches("ab", "a[*]")} {glob_matches("x[y", "x[y")}")    // out: true true false true
    println("{glob_matches("é.txt", "?.txt")} {glob_matches("é.txt", "[à-ê].txt")} {glob_matches("abcabd", "*abd")} {glob_matches("abc", "a*b*c*")}")    // out: true true true true
    println("{glob_matches("/a/b", "/a/*")} {glob_matches("a/b", "/a/*")} {glob_matches("./a/b/", "a/b")} {glob_matches("A.TXT", "*.txt")}")    // out: true false true false
    println("{glob_matches("a/b", "a")} {glob_matches("a", "a/b")} {glob_matches("a/x/y/b", "a/**/b")} {glob_matches("a/b", "a/**/b")}")    // out: false false true true
    println("{glob_matches_name("r.0.0.mca", "r.*.mca")} {glob_matches_name(".x", "*")} {glob_matches_name("", "*")}")    // out: true false true

    // What only Windows reads as roots and separators.
    let win = os() == "windows"
    println("{path_root("/srv") == "/"} {is_absolute("/srv") == not win} {is_absolute("srv")}")    // out: true true false
    println("{path_root("C:\\x") == (if win { "C:\\" } else { "" })} {is_absolute("C:\\x") == win} {is_absolute("C:x")} {is_absolute("\\\\srv\\share") == win}")    // out: true true false true
    println("{file_name("a\\b") == (if win { some(String("b")) } else { some(String("a\\b")) })}")    // out: true
    println("{join_path("C:\\a", "b") == (if win { "C:\\a\\b" } else { "C:\\a/b" })} {join_path("C:\\a", "\\b") == (if win { "C:\\b" } else { "C:\\a/\\b" })}")    // out: true true
    println("{join_path("C:", "b") == (if win { "C:b" } else { "C:/b" })} {join_path("x", "D:\\y") == (if win { "D:\\y" } else { "x/D:\\y" })}")    // out: true true
    println("{normalize_path("C:\\a\\..\\b") == (if win { "C:\\b" } else { "C:\\a\\..\\b" })} {normalize_path("C:a\\..\\..\\b") == (if win { "C:..\\b" } else { "C:a\\..\\..\\b" })}")    // out: true true
    println("{parent_dir("\\\\srv\\share\\d") == (if win { some(String("\\\\srv\\share\\")) } else { some(String(".")) })}")    // out: true
    println("{glob_matches("C:\\x\\y.txt", "c:/x/*.txt") == win}")    // out: true
}
