// `@yaml` reads `@yaml_key` on a field, and refuses any other attribute there, which is likely a
// misspelling.
import std.yaml.{yaml}

@yaml
struct Named {
    @yaml_name("x")    // error: `@yaml` doesn't read `@yaml_name`; the attributes it reads on fields are `@yaml_key`
    x: i32
}

fn main() {}
