// std.hash gives what Java 25's MessageDigest and Mac give, and Python's hashlib and hmac. The
// MD5, SHA-1 and SHA-256 hashes below are Java's, and the SHA-384, SHA-512 and hmac ones Python's,
// for the lengths around a block's padding (55, 56 and 64 bytes, or 111, 112 and 128) and for more
// than one block. build/scratch's wider checks compared 3000 random inputs with Java, and 2510 of
// every hash and HMAC with Python, whole and in two pieces (CLX-149).

import std.fs.{exists, remove_dir_all, temp_dir, write}
import std.hash.{Algorithm, Digest, file_digest, hmac, hmac_sha256, md5, sha1, sha256, sha384, sha512}

fn hex(bytes: List<u8>) -> String {
    let digits = "0123456789abcdef"
    var s = String()
    for b in bytes {
        let hi = usize(b / 16)
        let lo = usize(b % 16)
        s.push_str(digits[hi..hi + 1])
        s.push_str(digits[lo..lo + 1])
    }
    return s
}

// n bytes of i * mul + 3, as the Java program made them.
fn seq(n: usize, mul: u32) -> List<u8> {
    var out: List<u8> = []
    for i in 0..n {
        out.push(u8.wrap(u32.wrap(i) * mul + 3))
    }
    return out
}

fn text(s: str) -> List<u8> {
    return s.to_bytes()
}

fn main() {
    println(hex(md5([])))    // out: d41d8cd98f00b204e9800998ecf8427e
    println(hex(md5(text("abc"))))    // out: 900150983cd24fb0d6963f7d28e17f72
    println(hex(md5(seq(55, 7))))    // out: 52c0e574e1198de5fe3f8f11440dcb1b
    println(hex(md5(seq(56, 7))))    // out: 46c9907fc908ee68b1e7b8e71286a518
    println(hex(md5(seq(64, 7))))    // out: 7160b8fb5e9e4023d549c3971fbaeead
    println(hex(md5(seq(1000, 13))))    // out: c8ce7a730fe5d05fb51ff859bd691d1f
    println(hex(md5(text("Grüße, 世界"))))    // out: 3f09d838cd485bfad6c29ac11286f1ac

    println(hex(sha1([])))    // out: da39a3ee5e6b4b0d3255bfef95601890afd80709
    println(hex(sha1(text("abc"))))    // out: a9993e364706816aba3e25717850c26c9cd0d89d
    println(hex(sha1(seq(55, 7))))    // out: ddf57317ef34bfee3b6df83d359098930eb278bc
    println(hex(sha1(seq(56, 7))))    // out: a0d492bb0fc889d0eca3bc137066ab6f4f74f369
    println(hex(sha1(seq(64, 7))))    // out: bede92be29c3874e1b54ddc77988d606fc857a8e
    println(hex(sha1(seq(1000, 13))))    // out: d3c4fd2ca45aaf2e4480b0f728df5bb5c85b7dd3
    println(hex(sha1(text("Grüße, 世界"))))    // out: 3e5721529bceb180397d308b1fcf4ddcd13552d9

    println(hex(sha256([])))    // out: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    println(hex(sha256(text("abc"))))    // out: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    println(hex(sha256(seq(55, 7))))    // out: e7313d333c272e639f790978283f9eb392e843d0f29b7016828bb1daa4aac70b
    println(hex(sha256(seq(56, 7))))    // out: 4324d65f3c103567f5589c710bc08f8523f929a9272e3af36fc968e52abc6c27
    println(hex(sha256(seq(64, 7))))    // out: 39e3d7b6b5d075d37d053ad89b24b41bef4f3c29760c84447cab3f3be1882241
    println(hex(sha256(seq(1000, 13))))    // out: 169f388674ddef9a71d2bf97e62d6fa07b83a8fd96ed37349544af086d4f57c9
    println(hex(sha256(text("Grüße, 世界"))))    // out: 49837434716aa6f6917104cbba82bd5b8e82a970ddc5bfef7bcc45e3d6ea60b6

    // Keys shorter than a block, a block long, and longer, which are hashed first.
    println(hex(hmac_sha256(seq(16, 5), seq(100, 11))))    // out: 0a3a0a4eba35efe9c10ba9cf54f0d0a17dbba2eb4a1c009cd30dea14c6e4d935
    println(hex(hmac_sha256(seq(64, 5), seq(3, 11))))    // out: 8b67b22e2c6f3465d3c1ea9a97eb1af3f7d4b08639d787a7aaf00484e0d788d3
    println(hex(hmac_sha256(seq(65, 5), seq(64, 11))))    // out: b7e5b4101533a34209cf04aba20358a3718ee44e77e1863f3b4015ce7dfe6e38
    println(hex(hmac_sha256(seq(200, 5), seq(1000, 11))))    // out: a6f4955e4abb114244d96c70e55311b168de68819559245e7f00776882e47653

    println(hex(sha384([])))    // out: 38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b
    println(hex(sha384(text("abc"))))    // out: cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
    println(hex(sha384(seq(111, 7))))    // out: 341388a9dc2275074e90cf394323761919761c805fd9e370977c9966a0e8c81a52135f02577670b0071638a4a26dbc31
    println(hex(sha384(seq(112, 7))))    // out: 619cc5d06138526d70659eccf602d197e63e1050e22039a7feb40a30a5b2b08fb03729e291df12f8c576e6f1cd8af22a
    println(hex(sha384(seq(128, 7))))    // out: e8480e9c4dd90f88104a79cbaccec48edbd798a142b4f241d726dc252f1502350e824c7d18dadd59d7d716919fb8f9bf
    println(hex(sha384(seq(1000, 13))))    // out: 0974559b9a661811aa6b18f147b8e624acffbf8a7a1bc82e729e20611cdb7d0cbab1836b7c7083ed47813512d488218f
    println(hex(sha384(text("Grüße, 世界"))))    // out: 564416edef858f974f99dbc4f2fa65e63dd6b4dfd7b8ea1389b45e9e0e678375a5d5daa8d6f818997725271a737d4d57

    println(hex(sha512([])))    // out: cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e
    println(hex(sha512(text("abc"))))    // out: ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
    println(hex(sha512(seq(111, 7))))    // out: 68cffa6d0d76f309c9ce0d35280939f8e25990c43b7b086ccdf709be35b07d4ddba599541ff2b1c19d34ea49aeafb9659adb7ac3c0b078bb30a22d57fc6687ef
    println(hex(sha512(seq(112, 7))))    // out: d0865c524d1dddf7c23b799c413f5adcd7caefd3f66a9b49750ec81066012c25a8bcf94ddea6dc525691673097ca40e0101e897fc97218cfdb0704084e2bef4b
    println(hex(sha512(seq(128, 7))))    // out: 99b16f17aa0b969a5b8f08f367719d516e330ccd2660b6f0688ec031dbc783de50a1cd185a2568dba75070a2403d17d4741d163578515dfd2ff756ddfe4d47b1
    println(hex(sha512(seq(1000, 13))))    // out: bfdca439cfd22ae838a02346abf89bb132d44a90d8fda779675665934cd89e9c144ac35e85f1a6a758ca9bd815535afc236006e3222e1688047ee556b1c8a961
    println(hex(sha512(text("Grüße, 世界"))))    // out: 0d79353f8f649ab846f0231c291e5da4c97e6ac88ab8583074ba69b94aef85f33eba3e12f34ce718f826dc88bb6489a5823d1c7159d07918c274c0ed45f00ac3

    // Keys shorter than a block, a block long, and longer, which are hashed first: 128 bytes for
    // SHA-384 and SHA-512, and 64 for the others.
    println(hex(hmac(Algorithm.Sha512, seq(100, 5), seq(100, 11))))    // out: 8054a1c48cfb860f4420078444bfba4bfcf432fb64d830ffd09764f0e6ddc01358d82c2ee9c4a4be79b9224d17e425de2b0e9de8d2f944cb6dac1260235cc51d
    println(hex(hmac(Algorithm.Sha512, seq(128, 5), seq(3, 11))))    // out: e7a3324dae49f55b377445257ab638ffdfb732677aa6aa8bbf006cf489cab0555ed14cb9527a204bfea9028a79bdb2d4a10f855d9025e7c53c5bda593f25449d
    println(hex(hmac(Algorithm.Sha512, seq(129, 5), seq(128, 11))))    // out: 77cae02ecc73af90afc9dde85d8507090f26ce8f9d12c15d09cb66117e678344dce1eafb3f43f6e94c543293cc07a8d4e33cbb7c3d32a7455d9b4676704416ec
    println(hex(hmac(Algorithm.Sha384, seq(200, 5), seq(1000, 11))))    // out: 5f24d28b4daa22028d9a3c1216dd228e7513885fea50cc8505e40b6cec78722fd8257c4f4098ead54c14dee36374d106
    println(hex(hmac(Algorithm.Md5, seq(65, 5), seq(64, 11))))    // out: 6c79a88aa97733b4e0ed011fcdfabc93
    println(hex(hmac(Algorithm.Sha1, seq(16, 5), seq(100, 11))))    // out: 8ff0d19694155526368c488f60c00846a31313fe
    println(hex(hmac(Algorithm.Sha256, seq(65, 5), seq(64, 11))))    // out: b7e5b4101533a34209cf04aba20358a3718ee44e77e1863f3b4015ce7dfe6e38
    println("{Algorithm.Md5.len()} {Algorithm.Sha384.len()} {Algorithm.Sha512.block_len()} {Algorithm.Sha1.block_len()}")    // out: 16 48 128 64

    // Pieces of every size give the hash of the whole, across block edges.
    let whole = seq(1000, 13)
    let sizes: List<usize> = [1, 3, 63, 64, 65, 127, 128, 129, 999]
    for size in sizes {
        var big = Digest.new(Algorithm.Sha512)
        var d = Digest.new(Algorithm.Sha256)
        var at: usize = 0
        while at < whole.len() {
            let end = if at + size < whole.len() { at + size } else { whole.len() }
            var piece: List<u8> = []
            for i in at..end {
                piece.push(whole[i])
            }
            big.add(piece.copy())
            d.add(piece)
            at = end
        }
        if hex(d.finish()) != "169f388674ddef9a71d2bf97e62d6fa07b83a8fd96ed37349544af086d4f57c9" {
            panic("pieces of {size} give another hash")
        }
        if big.finish() != sha512(whole) {
            panic("pieces of {size} give another SHA-512")
        }
    }

    var d = Digest.new(Algorithm.Md5)
    d.add_text("OfflinePlayer:")
    d.add_text("Notch")
    // UUID.nameUUIDFromBytes starts from this, then sets the version and variant bits.
    println(hex(d.finish()))    // out: b50ad385829da141a2167e7d7539ba7f

    // A file hashed a mebibyte at a time, across the edge of one, gives what its bytes give.
    let dir = temp_dir()!
    var data = List<u8>()
    for i in 0usize..2621440 {
        data.push(u8.wrap(i * 31 + i / 977))
    }
    write("{dir}/data.bin", data.copy())!
    write("{dir}/empty.bin", [])!
    println("{file_digest(Algorithm.Sha256, "{dir}/data.bin")! == sha256(data.copy())} {file_digest(Algorithm.Sha512, "{dir}/data.bin")! == sha512(data)}")    // out: true true
    println(hex(file_digest(Algorithm.Sha1, "{dir}/empty.bin")!))    // out: da39a3ee5e6b4b0d3255bfef95601890afd80709
    // A missing file is NotFound, and isn't made.
    match file_digest(Algorithm.Md5, "{dir}/missing.bin") {
        ok(_) => println("hashed"),
        err(e) => println("{e} {exists("{dir}/missing.bin")}"),    // out: not found false
    }
    remove_dir_all(dir)!
}
