// std.zstd a piece at a time (CLX-413): Compressor's frame in pieces of every size, which
// decompress and Decompressor both read; a flush that makes everything so far readable; the
// checksum; Decompressor across frames, skippable frames, `most`, the limit, a frame cut short and
// bytes after one; and Writer and Reader over other Writers and Readers.
import std.io.{ByteReader}
import std.zstd.{Compressor, Decompressor, Error, compress, decompress}
import std.zstd

fn text() -> List<u8> {
    var s = String()
    for i in 0..120000 {
        s.push_str("record {i}: {i * 7919 % 10007} the quick brown fox\n")
    }
    return s.to_bytes()
}

// `bytes` given to the compressor `piece` bytes at a time.
fn compressed(bytes: List<u8>, piece: usize, level: i32, checksum: bool) -> List<u8> {
    var c = Compressor.new(level, checksum)
    var out = List<u8>()
    var at: usize = 0
    while at < bytes.len() {
        let end = if at + piece < bytes.len() { at + piece } else { bytes.len() }
        c.add_into(bytes, at, end, mut out)
        at = end
    }
    c.finish_into(mut out)
    return out
}

// `bytes` given to a decompressor `piece` bytes at a time.
fn decompressed(bytes: List<u8>, piece: usize) -> List<u8> ! Error {
    var d = Decompressor.new()
    var out = List<u8>()
    var at: usize = 0
    while at < bytes.len() {
        let end = if at + piece < bytes.len() { at + piece } else { bytes.len() }
        try d.add_into(bytes, at, end, u64.MAX, mut out)
        at = end
    }
    try d.finish_into(mut out)
    return out
}

// What `decompressed` fails with, in words, or "ok".
fn why(bytes: List<u8>, piece: usize) -> String {
    return match decompressed(bytes, piece) {
        ok(_) => String("ok"),
        err(e) => "{e}",
    }
}

fn main() {
    let source = text()
    println("{source.len()}")    // out: 4675664
    // A frame with no size, which says its window: level 3's is 2 MiB, so `08` for 2^21.
    let made = compressed(source, 100000, 3, false)
    println("{made[0..6]}")    // out: [40, 181, 47, 253, 0, 88]
    for level in [1, 3, 12, -3] {
        for piece in [1000usize, 65536, source.len()] {
            let z = compressed(source, piece, level, level == 3)
            let back = decompress(z)!
            let streamed = decompressed(z, 4093)!
            println("{level} {piece}: {back == source} {streamed == source} {z.len() < source.len() / 2}")
        }
    }
    // out: 1 1000: true true true
    // out: 1 65536: true true true
    // out: 1 4675664: true true true
    // out: 3 1000: true true true
    // out: 3 65536: true true true
    // out: 3 4675664: true true true
    // out: 12 1000: true true true
    // out: 12 65536: true true true
    // out: 12 4675664: true true true
    // out: -3 1000: true true true
    // out: -3 65536: true true true
    // out: -3 4675664: true true true

    // Nothing at all is an empty frame, which decompresses to nothing; a checksum is 4 bytes more.
    println("{decompress(Compressor.new().finish())!.len()} {Compressor.new().finish().len()} {Compressor.new(3, true).finish().len()}")    // out: 0 9 13

    // After a flush, what's come out decompresses to everything given so far, and the frame goes on.
    var c = Compressor.new()
    var sent = c.add("first message;".to_bytes())
    sent.extend(c.flush())
    var d = Decompressor.new()
    println("{String.from_utf8(d.add(sent)!)!}")    // out: first message;
    var rest = c.add("second".to_bytes())
    rest.extend(c.finish())
    println("{String.from_utf8(d.add(rest)!)!} {d.finish()!.len()}")    // out: second 0
    sent.extend(rest)
    println("{String.from_utf8(decompress(sent)!)!}")    // out: first message;second

    // A checksum that doesn't match.
    var bad = compressed("checked".to_bytes(), 3, 3, true)
    let last = bad.len() - 1
    bad[last] ^= 1
    println("{why(bad, 2)}")    // out: checksum mismatch

    // Frames one after another, with a skippable frame between them, as decompress reads them.
    var frames = compress("one,".to_bytes())
    frames.extend([0x50u8, 0x2A, 0x4D, 0x18, 3, 0, 0, 0, 9, 9, 9])
    frames.extend(compressed("two".to_bytes(), 1, 3, false))
    println("{String.from_utf8(decompressed(frames, 1)!)!} {String.from_utf8(decompress(frames)!)!}")    // out: one,two one,two

    // At most `most` bytes from each add; then add with nothing gives the rest.
    var m = Decompressor.new()
    let first = m.add(made, 1000)!
    println("{first.len()} {m.needs_input()}")    // out: 1000 false
    var all = first
    while not m.needs_input() {
        all.extend(m.add([], 1000000)!)
    }
    all.extend(m.finish()!)
    println("{all == source}")    // out: true

    // The limit, data cut short, nothing at all, and bytes after a frame that aren't one.
    var lim = Decompressor.new(1000)
    for _ in 0..2 {
        match lim.add(made) {
            ok(b) => println("{b.len()}"),
            err(e) => println("{e == Error.TooLong}"),
        }
    }
    // out: true
    // out: true
    println("{why(made[..made.len() - 10], 777)}")    // out: the data ends early
    println("{why([], 1)}")    // out: the data ends early
    var after = compress("x".to_bytes())
    after.extend("garbage".to_bytes())
    println("{why(after, 3)}")    // out: not a Zstandard file

    // A Writer onto a list, and a Reader of what it wrote, a few bytes at a time.
    var w = zstd.Writer.new(List<u8>(), 3, true)
    var k: usize = 0
    while k < source.len() {
        let end = if k + 77777 < source.len() { k + 77777 } else { source.len() }
        w.write(source[k..end])!
        k = end
    }
    let wrote = w.finish()!
    var r = zstd.Reader.new(ByteReader.new(wrote.copy()))
    var got = List<u8>()
    loop {
        if r.read(mut got, 5000)! == 0 {
            break
        }
    }
    println("{got == source} {decompress(wrote)! == source}")    // out: true true
    // One cut short fails at the end, rather than reading as one that ended.
    var short = zstd.Reader.new(ByteReader.new(compressed(source, 50000, 3, false)[..30000]))
    var sink = List<u8>()
    var failed = String()
    loop {
        match short.read(mut sink, 65536) {
            ok(0) => break,
            ok(_) => {},
            err(e) => {
                failed = e
                break
            },
        }
    }
    println(failed)    // out: the zstd stream is broken: the data ends early
}
