// Operators on a value type through Add, Sub, Mul and Neg, and in generic code bound by Add<T> (CLX-143).

struct Vec3 {
    x: f64
    y: f64
    z: f64
}

impl Add<Vec3> for Vec3 {
    fn add(self, other: Vec3) -> Vec3 {
        return Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
    }
}

impl Sub<Vec3> for Vec3 {
    fn sub(self, other: Vec3) -> Vec3 {
        return Vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z }
    }
}

impl Mul<f64> for Vec3 {
    fn mul(self, other: f64) -> Vec3 {
        return Vec3 { x: self.x * other, y: self.y * other, z: self.z * other }
    }
}

impl Neg for Vec3 {
    fn neg(self) -> Vec3 {
        return Vec3 { x: -self.x, y: -self.y, z: -self.z }
    }
}

fn sum<T: Add<T> + Copy>(xs: List<T>, zero: T) -> T {
    var acc = zero
    for x in xs {
        acc += x
    }
    return acc
}

fn main() {
    let a = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let b = Vec3 { x: 0.5, y: 0.5, z: 0.5 }
    let c = a + b * 2.0 - -a
    println("{c.x} {c.y} {c.z}")      // out: 3.0 5.0 7.0
    var d = a
    d += b
    d -= a
    println("{d.x} {d.y} {d.z}")      // out: 0.5 0.5 0.5
    let s = sum(three(a, b), Vec3 { x: 0.0, y: 0.0, z: 0.0 })
    println("{s.x} {s.y} {s.z}")      // out: 2.5 4.5 6.5
    let ns: List<i32> = [1, 2, 3]
    println("{sum(ns, 0)}")           // out: 6
}

fn three(a: Vec3, b: Vec3) -> List<Vec3> {
    return [a, b, a]
}
