// software is freely granted, provided that this notice
// is preserved.
// ====================================================
//
// The rest (e_acos.c, e_asin.c, e_atan2.c, e_cosh.c, e_hypot.c, e_log.c, e_log10.c,
// e_rem_pio2.c, e_sinh.c, k_cos.c, k_rem_pio2.c, k_sin.c, s_atan.c, s_cbrt.c, s_copysign.c,
// s_cos.c, s_expm1.c, s_log1p.c, s_scalbn.c, s_sin.c, s_tan.c and s_tanh.c) are under this one:
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
