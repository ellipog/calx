/// Zstandard files, decompressed as Python's `compression.zstd.decompress` reads them (CLX-181):
/// release archives such as `.tar.zst`, and whatever `zstd` or Python wrote. And compressed into
/// frames that both read, at `zstd`'s levels (CLX-183). And both a piece at a time, in as much
/// memory as a level's window takes, for files bigger than memory and bytes to and from a socket
/// (CLX-413).
module std.zstd

import std.io

extern "C" {
    fn cx_zstd_block(ctx: *u8, input: *const u8, n: usize, at: usize, out: *u8, start: usize, pos: *usize, cap: usize, info: *u64) -> i32
    fn cx_zstd_block_end(ctx: *u8, input: *const u8, n: usize, at: usize, info: *u64) -> i32
    fn cx_zstd_xxh_size() -> usize
    fn cx_zstd_xxh_start(state: *u8)
    fn cx_zstd_xxh_add(state: *u8, p: *const u8, n: usize)
    fn cx_zstd_xxh_end(state: *const u8) -> u64
    fn cx_zse_stream_params(level: i32, info: *u64)
    fn cx_zse_stream_job(level: i32, text: *const u8, pre: u64, n: u64, first: u32, last: u32, out: *u8) -> u64
    fn memmove(to: *u8, from: *const u8, n: usize) -> *u8
    fn cx_zstd_ctx_size() -> usize
    fn cx_zstd_ent_size() -> usize
    fn cx_zstd_init(ctx: *u8)
    fn cx_zstd_end(ctx: *u8)
    fn cx_zstd_dict(d: *const u8, n: usize, ent: *u8, info: *u64) -> i32
    fn cx_zstd_frame(ctx: *u8, input: *const u8, n: usize, at: usize, ent: *const u8, dict_id: u32, window_max: u64, info: *u64) -> i32
    fn cx_zstd_blocks(ctx: *u8, input: *const u8, n: usize, out: *u8, start: usize, len: *usize, cap: usize, limit: usize, dict: *const u8, dict_n: usize, info: *u64) -> i32
    fn cx_zstd_xxh64(p: *const u8, n: usize, seed: u64) -> u64
    fn cx_zstd_dict_params_size() -> usize
    fn cx_zstd_dict_params(d: *const u8, n: usize, out: *u8) -> i32
    fn cx_zse_bound(n: u64) -> u64
    fn cx_zse_compress(input: *const u8, n: u64, out: *u8, level: i32, flags: u32) -> u64
    fn cx_zse_compress_dict(input: *const u8, n: u64, out: *u8, level: i32, flags: u32, content: *const u8, content_n: u64, dict_n: u64, dict_id: u32, params: *const u8, has_params: u32, key: u64) -> u64
    fn cx_zse_dict_key() -> u64
    fn cx_zse_train(samples: *const u8, sizes: *const u64, count: u64, out: *u8, cap: u64, level: i32) -> u64
    fn cx_zse_finalize(content: *const u8, cn: u64, samples: *const u8, sizes: *const u64, count: u64, out: *u8, cap: u64, level: i32) -> u64
}

/// Why bytes didn't decompress. Python raises a `ZstdError` for each, and a `ValueError` for a
/// dictionary that isn't one.
pub enum Error {
    /// They aren't Zstandard. Python says "Unknown frame descriptor".
    Format
    /// A frame sets a bit that's reserved. Python says "Unsupported frame parameter".
    Unsupported
    /// A frame asks for a window of more than 128 MiB, as Python refuses unless it's told
    /// otherwise. Python says "Frame requires too much memory for decoding".
    Window
    /// They're broken. Python says "Data corruption detected", or names what's wrong.
    Corrupt
    /// A frame's checksum doesn't match what it decompresses to. Python says "Restored data
    /// doesn't match checksum".
    Checksum
    /// A frame needs a dictionary it wasn't given, or another one. Python says "Dictionary
    /// mismatch".
    Dictionary
    /// They end inside a frame. Python says "Compressed data ended before the end-of-stream
    /// marker was reached".
    Truncated
    /// They decompress to more than the limit.
    TooLong
    /// A dictionary that isn't one. Python says "invalid Zstandard dictionary".
    BadDictionary
    /// `train_dict` had fewer than seven samples, fewer than 8 bytes in the first three quarters
    /// of them, or a size under 256, or `finalize_dict` a size under 256 or under its content's.
    /// Python says "Src size is incorrect" or "Destination buffer is too small".
    Training
}

/// What went wrong, in words: `corrupt data`, `the data ends early`.
impl Display for Error {
    fn show(self) {
        match self {
            Format => print("not a Zstandard file"),
            Unsupported => print("a frame setting that isn't supported"),
            Window => print("a window bigger than 128 MiB"),
            Corrupt => print("corrupt data"),
            Checksum => print("checksum mismatch"),
            Dictionary => print("the wrong dictionary, or none"),
            Truncated => print("the data ends early"),
            TooLong => print("longer than the limit when decompressed"),
            BadDictionary => print("not a Zstandard dictionary"),
            Training => print("too few samples or too small a size to train a dictionary"),
        }
    }
}

/// A dictionary, which small files compressed with it need to decompress, as Python's `ZstdDict`
/// holds one. Files compressed with one come out smaller, if they're like what it was made from.
pub struct Dictionary {
    bytes: List<u8>
    // Its entropy tables and repeated offsets, as the runtime reads them.
    tables: List<u8>
    dict_id: u32
    // Where its content starts after the tables, or 0 for bytes that are all content.
    content: usize
    // For one with tables, those tables as the compressor takes them; empty for content alone.
    params: List<u8>
    // This dictionary's own number, which no other has: the compressor keeps the tables it makes
    // from the content by it, as the content can't change. 0 for none.
    key: u64
}

impl Dictionary {
    /// A dictionary that `zstd --train` or Python's `train_dict` made, which starts with its
    /// magic number and an ID that isn't 0, as `ZstdDict(bytes)` takes it. Fails with
    /// `BadDictionary` for other bytes, and for a dictionary whose tables are broken, which Python
    /// only finds when it first decompresses with it.
    pub fn new(bytes: own List<u8>) -> Dictionary ! Error {
        let d = try Dictionary.read(bytes)
        if d.content == 0 or d.dict_id == 0 {
            fail Error.BadDictionary
        }
        return d
    }

    /// Bytes to use as a dictionary as they are, as `ZstdDict(bytes, is_raw=True)` takes them:
    /// what came before, for matches to reach back into. Its ID is 0. As libzstd reads them,
    /// bytes that start with the dictionary magic number are a dictionary all the same, with its
    /// ID and tables. Fails with `BadDictionary` for fewer than eight bytes, as Python does, or
    /// for such a dictionary whose tables are broken.
    pub fn raw(bytes: own List<u8>) -> Dictionary ! Error {
        return try Dictionary.read(bytes)
    }

    // Reads the bytes as libzstd does: a dictionary if they start with its magic number, and
    // otherwise all content.
    fn read(bytes: own List<u8>) -> Dictionary ! Error {
        if bytes.len() < 8 {
            fail Error.BadDictionary
        }
        var d = Dictionary { bytes: bytes, tables: tables_for(), dict_id: 0, content: 0, params: [], key: unsafe { cx_zse_dict_key() } }
        var info: List<u64> = [0; 2]
        let r = unsafe { cx_zstd_dict(d.bytes.as_ptr(), d.bytes.len(), d.tables.as_mut_ptr(), info.as_mut_ptr()) }
        if r != 0 {
            fail Error.BadDictionary
        }
        d.dict_id = u32.wrap(info[0])
        d.content = usize.wrap(info[1])
        if d.content != 0 {
            let n = unsafe { cx_zstd_dict_params_size() }
            var p: List<u8> = [0; n]
            let pr = unsafe { cx_zstd_dict_params(d.bytes.as_ptr(), d.bytes.len(), p.as_mut_ptr()) }
            if pr != 0 {
                fail Error.BadDictionary
            }
            d.params = p
        }
        return d
    }

    // No dictionary at all.
    fn empty() -> Dictionary {
        var d = Dictionary { bytes: [], tables: tables_for(), dict_id: 0, content: 0, params: [], key: 0 }
        var info: List<u64> = [0; 2]
        _ = unsafe { cx_zstd_dict(d.bytes.as_ptr(), 0, d.tables.as_mut_ptr(), info.as_mut_ptr()) }
        return d
    }

    /// The ID frames compressed with it give, or 0 for content alone.
    pub fn id(self) -> u32 {
        return self.dict_id
    }

    /// Its bytes, as Python's `dict_content` gives them: to keep one `train_dict` made in a file,
    /// which `new` reads back.
    pub fn to_bytes(self) -> List<u8> {
        return self.bytes.copy()
    }

    /// What the bytes decompress to with this dictionary, as `decompress(bytes, zstd_dict=d)`
    /// gives it.
    pub fn decompress(self, bytes: List<u8>, limit: u64 = u64.MAX) -> List<u8> ! Error {
        var out: List<u8> = []
        try decode(bytes, 0, bytes.len(), limit, self, mut out)
        return out
    }

    /// Decompresses `bytes[from..to]` onto the end of `out` with this dictionary, as
    /// `decompress_into` does.
    @track_caller
    pub fn decompress_into(self, bytes: List<u8>, from: usize, to: usize, limit: u64, out: mut List<u8>) ! Error {
        try decode(bytes, from, to, limit, self, mut out)
    }

    /// The bytes compressed as one frame with this dictionary, as `compress(bytes, level,
    /// zstd_dict=d)` writes one: matches reach back into its content, a trained one's tables and
    /// repeated offsets start the first block, and the frame gives its ID, which only content
    /// alone doesn't have. Otherwise as `compress`. Python, `zstd -D` and `decompress` here read
    /// it back with the same dictionary.
    @track_caller
    pub fn compress(self, bytes: List<u8>, level: i32 = 3, checksum: bool = false) -> List<u8> {
        var out: List<u8> = []
        encode(bytes, 0, bytes.len(), level, checksum, self.bytes, self.content, self.dict_id, self.params, self.key, mut out)
        return out
    }

    /// Compresses `bytes[from..to]` with this dictionary, as `compress` does, onto the end of
    /// `out`. Panics unless the range is in `bytes`, and for a level outside -131072 to 22.
    @track_caller
    pub fn compress_into(self, bytes: List<u8>, from: usize, to: usize, level: i32, checksum: bool, out: mut List<u8>) {
        encode(bytes, from, to, level, checksum, self.bytes, self.content, self.dict_id, self.params, self.key, mut out)
    }
}

/// A dictionary of at most `size` bytes trained from samples of what it's for, as Python's
/// `train_dict(samples, size)` trains one, with libzstd's fastCover: its content is the stretches
/// of the samples whose bytes come up most often in them, the best last, and its tables are for
/// what's left after matches into it. Of five lengths of stretch, it takes the one with which the
/// last quarter of the samples, left out of the training, comes out smallest. The same samples
/// give the same dictionary. Fails with `Training` for fewer than seven samples, fewer than 8
/// bytes in the first three quarters of them, or a size under 256, as Python raises a
/// `ZstdError`.
pub fn train_dict(samples: List<List<u8>>, size: usize) -> Dictionary ! Error {
    let (all, sizes) = laid_out(samples)
    var out: List<u8> = [0; size]
    let n = unsafe { cx_zse_train(all.as_ptr(), sizes.as_ptr(), u64(sizes.len()), out.as_mut_ptr(), u64(size), 3) }
    if n == 0 {
        fail Error.Training
    }
    out.truncate(usize.wrap(n))
    return try Dictionary.new(out)
}

/// A dictionary of at most `size` bytes with `content`'s bytes as its content, and tables from the
/// samples for frames at `level`, as Python's `finalize_dict(content, samples, size, level)` makes
/// one: for content picked by hand, or some other way than `train_dict`'s. If the content and the
/// tables are more than `size`, the content's end is kept, the part nearest what follows it, where
/// Python keeps its start. Fails with `Training` for a size under 256 or under the content's, as
/// Python raises a `ZstdError`. Panics for a level outside -131072 to 22.
@track_caller
pub fn finalize_dict(content: Dictionary, samples: List<List<u8>>, size: usize, level: i32) -> Dictionary ! Error {
    if level < -131072 or level > 22 {
        panic("the level {level} isn't one: levels go from -131072 to 22")
    }
    let (all, sizes) = laid_out(samples)
    var out: List<u8> = [0; size]
    let n = unsafe { cx_zse_finalize(content.bytes.as_ptr(), u64(content.bytes.len()), all.as_ptr(), sizes.as_ptr(), u64(sizes.len()), out.as_mut_ptr(), u64(size), level) }
    if n == 0 {
        fail Error.Training
    }
    out.truncate(usize.wrap(n))
    return try Dictionary.new(out)
}

// The samples one after another, and each one's size.
fn laid_out(samples: List<List<u8>>) -> (List<u8>, List<u64>) {
    var total: usize = 0
    for s in samples {
        total += s.len()
    }
    var all: List<u8> = []
    all.reserve(total)
    var sizes: List<u64> = []
    for s in samples {
        all.extend(s)
        sizes.push(u64(s.len()))
    }
    return (all, sizes)
}

fn tables_for() -> List<u8> {
    let n = unsafe { cx_zstd_ent_size() }
    let t: List<u8> = [0; n]
    return t
}

// Python's limit on a frame's window, 2^27 bytes, and a size a frame doesn't give.
const WINDOW_MAX: u64 = 134217728
const UNKNOWN: u64 = 18446744073709551615
// The room the runtime needs past where a frame ends.
const SLACK: usize = 64

/// What the bytes decompress to: every frame in them, one after another, as
/// `compression.zstd.decompress(bytes)` gives it. Skippable frames give nothing. Fails with
/// `TooLong` if it's more than `limit` bytes, which is no limit at all unless it's given.
pub fn decompress(bytes: List<u8>, limit: u64 = u64.MAX) -> List<u8> ! Error {
    var out: List<u8> = []
    try decompress_into(bytes, 0, bytes.len(), limit, mut out)
    return out
}

/// Decompresses the bytes from `from` up to `to` onto the end of `out`, as `decompress` does,
/// adding at most `limit` bytes. On an error, `out` is as it was. Panics unless the range is in
/// `bytes`.
@track_caller
pub fn decompress_into(bytes: List<u8>, from: usize, to: usize, limit: u64, out: mut List<u8>) ! Error {
    try decode(bytes, from, to, limit, Dictionary.empty(), mut out)
}

/// The bytes compressed as one Zstandard frame, as Python's `compression.zstd.compress(bytes,
/// level)` writes one: with the size it decompresses to, and with a checksum if `checksum` is set,
/// as zstd's `checksum_flag` adds one. Levels go from 1, the fastest, to 22, the smallest, and 0 is
/// the default, 3; the negative ones, down to -131072, are faster still and compress less. Big
/// inputs are compressed on all the processors, into the same bytes however many there are.
/// Panics for a level outside -131072 to 22, where Python raises a `ValueError`.
@track_caller
pub fn compress(bytes: List<u8>, level: i32 = 3, checksum: bool = false) -> List<u8> {
    var out: List<u8> = []
    compress_into(bytes, 0, bytes.len(), level, checksum, mut out)
    return out
}

/// Compresses `bytes[from..to]` as `compress` does, onto the end of `out`. Panics unless the range
/// is in `bytes`, and for a level outside -131072 to 22.
@track_caller
pub fn compress_into(bytes: List<u8>, from: usize, to: usize, level: i32, checksum: bool, out: mut List<u8>) {
    encode(bytes, from, to, level, checksum, [], 0, 0, [], 0, mut out)
}

// Compresses bytes[from..to] onto the end of out, with dict[content..] as the text before them if
// there's a dictionary, its ID if that isn't 0, its tables if params has them, and its key.
@track_caller
fn encode(bytes: List<u8>, from: usize, to: usize, level: i32, checksum: bool, dict: List<u8>, content: usize, dict_id: u32, params: List<u8>, key: u64, out: mut List<u8>) {
    if from > to or to > bytes.len() {
        panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
    }
    if level < -131072 or level > 22 {
        panic("the level {level} isn't one: levels go from -131072 to 22")
    }
    let n = u64(to - from)
    let at = out.len()
    let room = unsafe { cx_zse_bound(n) }
    out.reserve(usize.wrap(room))
    let flags = if checksum { 1u32 } else { 0u32 }
    unsafe {
        let made = if dict.is_empty() {
            cx_zse_compress(bytes.as_ptr().add(from), n, out.as_mut_ptr().add(at), level, flags)
        } else {
            cx_zse_compress_dict(bytes.as_ptr().add(from), n, out.as_mut_ptr().add(at), level, flags, dict.as_ptr().add(content), u64(dict.len() - content), u64(dict.len()), dict_id, params.as_ptr(), if params.is_empty() { 0u32 } else { 1u32 }, key)
        }
        out.set_len(at + usize.wrap(made))
    }
    if checksum {
        // The low 32 bits of the text's XXH64, which cx_zse_bound leaves room for.
        let h = unsafe { cx_zstd_xxh64(bytes.as_ptr().add(from), to - from, 0) }
        for k in 0u64..4 {
            out.push(u8.wrap(h >> (8 * k)))
        }
    }
}

/// Whether the bytes start as a Zstandard frame does: `28 b5 2f fd`.
pub fn is_zstd(bytes: List<u8>) -> bool {
    return bytes.len() >= 4 and bytes[0] == 0x28 and bytes[1] == 0xB5 and bytes[2] == 0x2F and bytes[3] == 0xFD
}

/// The XXH64 hash of the bytes with `seed`, as Zstandard checks frames with its low 32 bits, and
/// as the `xxhash` package's `xxh64_intdigest` gives it.
pub fn xxh64(bytes: List<u8>, seed: u64 = 0) -> u64 {
    return unsafe { cx_zstd_xxh64(bytes.as_ptr(), bytes.len(), seed) }
}

@track_caller
fn decode(bytes: List<u8>, from: usize, to: usize, limit: u64, dict: Dictionary, out: mut List<u8>) ! Error {
    if from > to or to > bytes.len() {
        panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
    }
    let begin = out.len()
    // The context is set up by the runtime, so it isn't cleared first, and what it takes on the
    // way is given back however the frames end.
    let size = unsafe { cx_zstd_ctx_size() }
    var ctx = List<u8>()
    ctx.reserve(size)
    unsafe {
        ctx.set_len(size)
        cx_zstd_init(ctx.as_mut_ptr())
    }
    match frames(bytes, from, to, limit, dict, mut ctx, mut out) {
        ok => {
            unsafe {
                cx_zstd_end(ctx.as_mut_ptr())
            }
        },
        err(e) => {
            unsafe {
                cx_zstd_end(ctx.as_mut_ptr())
            }
            out.truncate(begin)
            fail e
        },
    }
}

fn frames(bytes: List<u8>, from: usize, to: usize, limit: u64, dict: Dictionary, ctx: mut List<u8>, out: mut List<u8>) ! Error {
    let begin = out.len()
    // The longest out may get.
    let most: u64 = if limit > u64.MAX - u64(begin) { u64.MAX } else { u64(begin) + limit }
    let most_len = usize.wrap(most)
    var info: List<u64> = [0; 4]
    var lens: List<usize> = [0]
    // Matches may reach back past the content into the tables, as libzstd lets them: its whole
    // bytes are what came before.
    let past = dict.bytes.len()
    var at = from
    // As Python reads them, frames follow one another to the end of the bytes, and nothing at
    // all is a frame cut short.
    loop {
        let r = unsafe { cx_zstd_frame(ctx.as_mut_ptr(), bytes.as_ptr(), to, at, dict.tables.as_ptr(), dict.dict_id, WINDOW_MAX, info.as_mut_ptr()) }
        if r == 1 {
            at = usize.wrap(info[2])
        } else if r != 0 {
            fail error_for(r)
        } else {
            let start = out.len()
            let given = info[0]
            if given != UNKNOWN {
                if given > most - u64(start) {
                    fail Error.TooLong
                }
                out.reserve(usize.wrap(given) + SLACK)
            }
            loop {
                lens[0] = out.len()
                let got = unsafe { cx_zstd_blocks(ctx.as_mut_ptr(), bytes.as_ptr(), to, out.as_mut_ptr(), start, lens.as_mut_ptr(), out.capacity(), most_len, dict.bytes.as_ptr(), past, info.as_mut_ptr()) }
                if got == 0 {
                    unsafe {
                        out.set_len(lens[0])
                    }
                    at = usize.wrap(info[0])
                    break
                }
                if got != 2 {
                    fail error_for(got)
                }
                unsafe {
                    out.set_len(lens[0])
                }
                // The room the runtime asks for past the end, or twice as much as there is.
                let need = usize.wrap(info[1])
                out.reserve(if need > out.len() { need } else { out.len() })
            }
        }
        if at == to {
            return
        }
    }
}

// The runtime's codes, calx_zstd.c's ZS_ ones.
fn error_for(code: i32) -> Error {
    let errors: List<Error> = [Error.Format, Error.Unsupported, Error.Window, Error.Corrupt, Error.Checksum, Error.Dictionary, Error.Truncated, Error.BadDictionary, Error.TooLong]
    if code < 0 and code >= -9 {
        return errors[usize.wrap(-code - 1)]
    }
    return Error.Corrupt
}

// --- a piece at a time -------------------------------------------------------------------------

// The runtime's codes for a block that isn't all there yet, and for room it needs.
const ROOM: i32 = 2
const TRUNCATED: i32 = -7
// Where a Decompressor is: before a frame's header, in its blocks, at its checksum, or in a
// skippable frame.
const HEAD: u8 = 0
const BLOCKS: u8 = 1
const CHECK: u8 = 2
const SKIPPING: u8 = 3
// How much input a Reader reads at a time.
const CHUNK: usize = 131072

/// Text compressed as it comes, a piece at a time, into one Zstandard frame, as Python's
/// `ZstdCompressor` and zstandard's `compressobj` take it: a file bigger than memory, or bytes
/// for a pipe or a socket. The frame has no size, which isn't known until the end, so it says
/// what window it needs instead, as `zstd` writes one from a pipe. Whatever reads Zstandard reads
/// it, as `decompress` does.
///
/// It compresses the text in jobs, as `compress` does a big input's, each matching into the end of
/// the text before it, so it holds one job's text at a time and that end: 2 MiB at level 1, 8.25
/// MiB at 3, 18 MiB at 9, 40 MiB at 19 and 640 MiB at 22, whose window alone is 128 MiB, and the
/// level's match tables besides. A job goes as soon as its text is in, on one thread.
pub struct Compressor {
    level: i32
    checksum: bool
    // How much text a job takes, and how far back its matches reach before it, and the window's
    // log, which the frame's header gives.
    each: usize
    reach: usize
    wlog: u32
    // text[..pre] is the end of what's been compressed, which the next job's matches reach into,
    // and text[pre..] what hasn't been.
    text: List<u8>
    pre: usize = 0
    started: bool = false
    jobs: u64 = 0
    // The checksum so far, if it has one.
    hash: List<u8>
}

impl Compressor {
    /// A compressor at `level`, as `compress` takes it, which ends the frame with a checksum if
    /// `checksum` is set. Panics for a level outside -131072 to 22, as `compress` does.
    @track_caller
    pub fn new(level: i32 = 3, checksum: bool = false) -> Compressor {
        if level < -131072 or level > 22 {
            panic("the level {level} isn't one: levels go from -131072 to 22")
        }
        var info: List<u64> = [0; 3]
        unsafe {
            cx_zse_stream_params(level, info.as_mut_ptr())
        }
        var hash: List<u8> = []
        if checksum {
            let n = unsafe { cx_zstd_xxh_size() }
            hash = [0; n]
            unsafe {
                cx_zstd_xxh_start(hash.as_mut_ptr())
            }
        }
        return Compressor { level: level, checksum: checksum, each: usize.wrap(info[0]), reach: usize.wrap(info[1]), wlog: u32.wrap(info[2]), text: [], hash: hash }
    }

    /// Takes the next piece of text, and gives what's compressed so far that it hasn't given: the
    /// frame's header the first time, then a job's blocks each time one fills.
    pub fn add(mut self, bytes: List<u8>) -> List<u8> {
        var out = List<u8>()
        self.add_into(bytes, 0, bytes.len(), mut out)
        return out
    }

    /// Takes bytes[from..to] as the next piece, as `add` does, and puts what it gives onto the end
    /// of `out`. Panics unless the range is in `bytes`.
    @track_caller
    pub fn add_into(mut self, bytes: List<u8>, from: usize, to: usize, out: mut List<u8>) {
        if from > to or to > bytes.len() {
            panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
        }
        self.start(mut out)
        if self.checksum and to > from {
            unsafe {
                cx_zstd_xxh_add(self.hash.as_mut_ptr(), bytes.as_ptr().add(from), to - from)
            }
        }
        if to > from and self.text.capacity() < self.reach + self.each {
            self.text.reserve(self.reach + self.each - self.text.len())
        }
        var at = from
        while at < to {
            let room = self.pre + self.each - self.text.len()
            let k = if room < to - at { room } else { to - at }
            self.text.extend(bytes[at..at + k])
            at += k
            if self.text.len() - self.pre == self.each {
                self.job(false, mut out)
            }
        }
    }

    /// Compresses the text it holds, and gives it, so that what it has given so far decompresses
    /// to all the text it was given, as zstd's `ZSTD_e_flush` and Python's
    /// `flush(ZstdCompressor.FLUSH_BLOCK)` do: for a message over a socket that the other end
    /// should read now. The frame goes on, and a frame flushed often compresses less.
    pub fn flush(mut self) -> List<u8> {
        var out = List<u8>()
        self.flush_into(mut out)
        return out
    }

    /// Flushes as `flush` does, onto the end of `out`.
    pub fn flush_into(mut self, out: mut List<u8>) {
        self.start(mut out)
        if self.text.len() > self.pre {
            self.job(false, mut out)
        }
    }

    /// Compresses the rest of the text, and gives it with the end of the frame, and its checksum
    /// if it has one.
    pub fn finish(own self) -> List<u8> {
        var out = List<u8>()
        self.finish_into(mut out)
        return out
    }

    /// Ends the frame as `finish` does, onto the end of `out`.
    pub fn finish_into(own self, out: mut List<u8>) {
        var c = self
        c.start(mut out)
        c.job(true, mut out)
        if c.checksum {
            // The low 32 bits of the text's XXH64.
            let h = unsafe { cx_zstd_xxh_end(c.hash.as_ptr()) }
            for k in 0u64..4 {
                out.push(u8.wrap(h >> (8 * k)))
            }
        }
    }

    // The frame's header, the first time: no size, a checksum or none, and the window.
    fn start(mut self, out: mut List<u8>) {
        if self.started {
            return
        }
        self.started = true
        out.extend([0x28u8, 0xB5, 0x2F, 0xFD])
        out.push(if self.checksum { 4u8 } else { 0u8 })
        out.push(u8.wrap((self.wlog - 10) << 3))
    }

    // Compresses text[pre..] as the frame's next blocks, the last if `last` is set, and keeps the
    // end of the text for the next job's matches to reach into.
    fn job(mut self, last: bool, out: mut List<u8>) {
        let n = self.text.len() - self.pre
        let room = usize.wrap(unsafe { cx_zse_bound(u64(n)) })
        out.reserve(room)
        unsafe {
            let at = out.len()
            let made = cx_zse_stream_job(self.level, self.text.as_ptr(), u64(self.pre), u64(n), if self.jobs == 0 { 1u32 } else { 0u32 }, if last { 1u32 } else { 0u32 }, out.as_mut_ptr().add(at))
            out.set_len(at + usize.wrap(made))
        }
        self.jobs += 1
        let keep = if self.reach < self.text.len() { self.reach } else { self.text.len() }
        let drop = self.text.len() - keep
        if drop > 0 {
            unsafe {
                _ = memmove(self.text.as_mut_ptr(), self.text.as_ptr().add(drop), keep)
                self.text.set_len(keep)
            }
        }
        self.pre = keep
    }
}

/// Zstandard data decompressed as it comes, a piece at a time, as `decompress` does with all of it
/// at once: a file bigger than memory read a part at a time, or bytes from a pipe or a socket, as
/// Python's `ZstdDecompressor` and zstandard's `decompressobj` take them. Every frame in the data is
/// read, one after another, as `decompress` reads them, and skippable frames give nothing.
///
/// It holds the input it hasn't used, at most a block's, and what it has decompressed that it
/// hasn't given out, and as much of the frame as its window says, which matches reach back into:
/// a frame that `zstd` or `Compressor` made at level 3 has a window of 2 MiB, and a frame may ask
/// for up to 128 MiB, as Python allows. Frames with a dictionary aren't read here.
pub struct Decompressor {
    limit: u64
    // What it has decompressed, and whether any frame has started: nothing at all is a frame cut
    // short, as `decompress` says.
    made: u64 = 0
    any: bool = false
    // The decoder, and the tables a frame without a dictionary starts with.
    ctx: List<u8>
    tables: List<u8>
    // The input, which it has used up to `skip`, and where it is in the data: a skippable frame's
    // bytes still to skip, or the frame's window.
    input: List<u8>
    skip: usize = 0
    part: u8 = HEAD
    skip_left: u64 = 0
    keep: usize = 0
    // What the frame has made: window[start..] is the frame's, and window[given..] hasn't gone out.
    window: List<u8>
    start: usize = 0
    given: usize = 0
    // Whether the last call stopped for want of input, and the error it failed with.
    hungry: bool = true
    failed: Error? = none
}

impl Decompressor {
    /// A decompressor that fails with `TooLong` once more than `limit` bytes have come out, as
    /// `decompress` does.
    pub fn new(limit: u64 = u64.MAX) -> Decompressor {
        let size = unsafe { cx_zstd_ctx_size() }
        var ctx = List<u8>()
        ctx.reserve(size)
        unsafe {
            ctx.set_len(size)
            cx_zstd_init(ctx.as_mut_ptr())
        }
        return Decompressor { limit: limit, ctx: ctx, tables: Dictionary.empty().tables, input: [], window: [] }
    }

    /// Takes the next piece, and gives what it and the pieces before decompress to that hasn't
    /// been given yet, at most `most` bytes. A piece can be any size, even empty. Fails as
    /// `decompress` fails, but for `Truncated`, which only `finish` can tell, and fails the same
    /// way again after that.
    pub fn add(mut self, bytes: List<u8>, most: u64 = u64.MAX) -> List<u8> ! Error {
        var out = List<u8>()
        try self.add_into(bytes, 0, bytes.len(), most, mut out)
        return out
    }

    /// Takes bytes[from..to] as the next piece, as `add` does, and puts what it gives onto the end
    /// of `out`, which can be kept from one call to the next. Panics unless the range is in
    /// `bytes`.
    @track_caller
    pub fn add_into(mut self, bytes: List<u8>, from: usize, to: usize, most: u64, out: mut List<u8>) ! Error {
        if from > to or to > bytes.len() {
            panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
        }
        self.feed(bytes, from, to)
        try self.run(most)
        _ = self.take(mut out, most)
    }

    /// Whether the last `add` gave all it could from what it has, so it wants the next piece.
    /// It's false when `add` stopped at `most` bytes: then `add` with no bytes gives more.
    pub fn needs_input(self) -> bool {
        return self.hungry
    }

    /// Ends the data: gives all the rest of what it decompresses to, and fails with `Truncated` if
    /// the data ended inside a frame, or had none, as `decompress` would.
    pub fn finish(own self) -> List<u8> ! Error {
        var out = List<u8>()
        try self.finish_into(mut out)
        return out
    }

    /// Ends the data as `finish` does, putting the rest onto the end of `out`. On an error, `out`
    /// is as it was.
    pub fn finish_into(own self, out: mut List<u8>) ! Error {
        var d = self
        try d.run(u64.MAX)
        try d.ended()
        _ = d.take(mut out, u64.MAX)
    }

    // Fails with Truncated unless the data has ended where a frame did.
    fn ended(self) ! Error {
        if let e = self.failed {
            fail e
        }
        if not self.any or self.part != HEAD or self.skip < self.input.len() {
            fail Error.Truncated
        }
    }

    // Adds bytes[from..to] to the input, after what it hasn't used.
    fn feed(mut self, bytes: List<u8>, from: usize, to: usize) {
        if self.skip > 0 and (self.skip == self.input.len() or self.skip >= 65536) {
            let left = self.input.len() - self.skip
            unsafe {
                if left > 0 {
                    _ = memmove(self.input.as_mut_ptr(), self.input.as_ptr().add(self.skip), left)
                }
                self.input.set_len(left)
            }
            self.skip = 0
        }
        self.input.extend(bytes[from..to])
    }

    // Moves up to `most` bytes that haven't gone out onto the end of `out`, and says how many.
    fn take(mut self, out: mut List<u8>, most: u64) -> usize {
        let ready = self.window.len() - self.given
        let n = if u64(ready) > most { usize.wrap(most) } else { ready }
        out.extend(self.window[self.given..self.given + n])
        self.given += n
        return n
    }

    // Decompresses what it can until `most` bytes are waiting to go out, failing as `run_on` does,
    // and the same way after that.
    fn run(mut self, most: u64) ! Error {
        if let e = self.failed {
            fail e
        }
        match self.run_on(most) {
            ok => {},
            err(e) => {
                self.failed = some(e)
                fail e
            },
        }
    }

    fn run_on(mut self, most: u64) ! Error {
        var info: List<u64> = [0; 4]
        var pos: List<usize> = [0]
        loop {
            if u64(self.window.len() - self.given) >= most {
                self.hungry = false
                return
            }
            let left = self.input.len() - self.skip
            if self.part == SKIPPING {
                let k = if u64(left) < self.skip_left { left } else { usize.wrap(self.skip_left) }
                self.skip += k
                self.skip_left -= u64(k)
                if self.skip_left > 0 {
                    self.hungry = true
                    return
                }
                self.part = HEAD
                continue
            }
            if self.part == HEAD {
                if left == 0 {
                    self.hungry = true
                    return
                }
                let at = self.skip
                if left >= 4 and self.input[at] & 0xF0 == 0x50 and self.input[at + 1] == 0x2A and self.input[at + 2] == 0x4D and self.input[at + 3] == 0x18 {
                    if left < 8 {
                        self.hungry = true
                        return
                    }
                    self.skip_left = u64(self.input[at + 4]) | (u64(self.input[at + 5]) << 8) | (u64(self.input[at + 6]) << 16) | (u64(self.input[at + 7]) << 24)
                    self.skip += 8
                    self.part = SKIPPING
                    self.any = true
                    continue
                }
                let r = unsafe { cx_zstd_frame(self.ctx.as_mut_ptr(), self.input.as_ptr(), self.input.len(), at, self.tables.as_ptr(), 0, WINDOW_MAX, info.as_mut_ptr()) }
                if r == TRUNCATED {
                    self.hungry = true
                    return
                }
                if r != 0 {
                    fail error_for(r)
                }
                self.any = true
                // A frame's window is at most WINDOW_MAX, but for a small one that's all here.
                self.keep = usize.wrap(if info[1] < WINDOW_MAX { info[1] } else { WINDOW_MAX })
                self.skip = usize.wrap(info[2])
                self.part = BLOCKS
                // Matches can't reach into the frames before, so nothing before this one is kept
                // but what hasn't gone out.
                self.start = self.window.len()
                continue
            }
            if self.part == CHECK {
                let r = unsafe { cx_zstd_block_end(self.ctx.as_mut_ptr(), self.input.as_ptr(), self.input.len(), self.skip, info.as_mut_ptr()) }
                if r == TRUNCATED {
                    self.hungry = true
                    return
                }
                if r != 0 {
                    fail error_for(r)
                }
                self.skip = usize.wrap(info[2])
                self.part = HEAD
                continue
            }
            pos[0] = self.window.len()
            let r = unsafe { cx_zstd_block(self.ctx.as_mut_ptr(), self.input.as_ptr(), self.input.len(), self.skip, self.window.as_mut_ptr(), self.start, pos.as_mut_ptr(), self.window.capacity(), info.as_mut_ptr()) }
            if r == ROOM {
                self.make_room(usize.wrap(info[1]))
                continue
            }
            if r == TRUNCATED {
                self.hungry = true
                return
            }
            if r != 0 {
                fail error_for(r)
            }
            let grew = pos[0] - self.window.len()
            unsafe {
                self.window.set_len(pos[0])
            }
            self.made += u64(grew)
            if self.made > self.limit {
                fail Error.TooLong
            }
            self.skip = usize.wrap(info[2])
            if info[0] == 1 {
                self.part = CHECK
            }
        }
    }

    // Makes room for `need` more bytes in the window, first dropping what's gone out and what the
    // frame's matches can't reach any more, the frame's window back from its end, if that's at
    // least half of it, so that each byte moves at most once or so.
    fn make_room(mut self, need: usize) {
        let len = self.window.len()
        var reach_from = if len > self.keep { len - self.keep } else { 0 }
        if reach_from < self.start {
            reach_from = self.start
        }
        let drop = if reach_from < self.given { reach_from } else { self.given }
        if drop > 0 and drop * 2 >= len {
            unsafe {
                _ = memmove(self.window.as_mut_ptr(), self.window.as_ptr().add(drop), len - drop)
                self.window.set_len(len - drop)
            }
            self.given -= drop
            self.start = if self.start > drop { self.start - drop } else { 0 }
        }
        self.window.reserve(need)
    }
}

/// A `Writer` that compresses what's written to it, as `Compressor` does, and writes the frame on
/// to `out` as it's made, as zstandard's `ZstdCompressor().stream_writer(f)` and Python's
/// `ZstdFile(f, "w")` do: `std.tar`'s `StreamWriter` writing a `.tar.zst` into a file or a socket
/// in the memory one job takes. `finish` ends the frame and gives `out` back.
pub struct Writer<W: io.Writer> {
    out: W
    c: Compressor
    buf: List<u8>
}

impl<W: io.Writer> Writer<W> {
    /// A writer onto `out`, at `level`, with a checksum if `checksum` is set. Panics for a level
    /// outside -131072 to 22, as `compress` does.
    @track_caller
    pub fn new(out: own W, level: i32 = 3, checksum: bool = false) -> Writer<W> {
        return Writer { out: out, c: Compressor.new(level, checksum), buf: [] }
    }

    /// Ends the frame, writes the rest of it to `out` and flushes that, and gives `out` back, or
    /// fails with what writing to it failed with.
    pub fn finish(own self) -> W ! String {
        var w = self
        var tail = List<u8>()
        w.c.finish_into(mut tail)
        try w.out.write(tail)
        try w.out.flush()
        return w.out
    }
}

impl<W: io.Writer> io.Writer for Writer<W> {
    fn write(mut self, bytes: List<u8>) ! String {
        self.buf.clear()
        self.c.add_into(bytes, 0, bytes.len(), mut self.buf)
        if not self.buf.is_empty() {
            try self.out.write(self.buf)
        }
    }

    /// Compresses what it holds and writes it, as `Compressor.flush` does, then flushes `out`.
    fn flush(mut self) ! String {
        self.buf.clear()
        self.c.flush_into(mut self.buf)
        if not self.buf.is_empty() {
            try self.out.write(self.buf)
        }
        try self.out.flush()
    }
}

/// A `Reader` that decompresses what it reads from `input`, as `Decompressor` does, a block at a
/// time, as zstandard's `ZstdDecompressor().stream_reader(f)` and Python's `ZstdFile(f)` do:
/// `std.tar`'s `StreamReader` reading a `.tar.zst` from a file or a socket in the memory a frame's
/// window takes. It reads every frame to the end of `input`, and fails at the end if the data was
/// cut short, so a `.tar.zst` cut off in the middle of a frame doesn't read as one that ended.
pub struct Reader<R: io.Reader> {
    input: R
    d: Decompressor
    chunk: List<u8>
    ended: bool = false
}

impl<R: io.Reader> Reader<R> {
    /// A reader of `input`, which fails with `TooLong` once more than `limit` bytes have come out.
    pub fn new(input: own R, limit: u64 = u64.MAX) -> Reader<R> {
        return Reader { input: input, d: Decompressor.new(limit), chunk: [] }
    }

    /// Gives `input` back, with whatever it hasn't read yet.
    pub fn into_inner(own self) -> R {
        let r = self
        return r.input
    }
}

impl<R: io.Reader> io.Reader for Reader<R> {
    fn read(mut self, buf: mut List<u8>, n: usize) -> usize ! String {
        if n == 0 {
            return 0
        }
        loop {
            let got = self.d.take(mut buf, u64(n))
            if got > 0 {
                return got
            }
            if self.ended {
                return 0
            }
            if let err(e) = self.d.run(u64(n)) {
                fail "the zstd stream is broken: {e}"
            }
            if not self.d.hungry {
                continue
            }
            self.chunk.clear()
            let k = try self.input.read(mut self.chunk, CHUNK)
            if k == 0 {
                self.ended = true
                if let err(e) = self.d.ended() {
                    fail "the zstd stream is broken: {e}"
                }
                continue
            }
            self.d.feed(self.chunk, 0, k)
        }
    }
}
