/// Random bytes, AES-128 in CFB8 mode, and RSA with PKCS#1 v1.5 padding and signatures (D118).
///
/// They're what vanilla's online-mode login uses. The server makes an RSA key pair and sends the
/// public key. The client encrypts a random shared secret with it, and the server decrypts it.
/// From then on both sides encrypt everything with AES-CFB8, using the secret as key and IV. Each
/// gives what Java's `SecureRandom`, `Cipher` and `KeyPairGenerator` give, for the same inputs.
/// Signatures are what signed chat uses: a player's key, which Mojang's key signs, signs each of
/// their messages, and each is checked as Java's `Signature` checks `SHA256withRSA`.
///
/// Beside those, argon2id for storing passwords (CLX-384), as Python's argon2-cffi does, in the
/// PHC strings it writes, and Ed25519 signatures (CLX-379), which minisign and SSH keys are, as
/// Python's `cryptography` signs and checks them. And ES256 signatures (CLX-406), ECDSA on P-256
/// with SHA-256, which JWTs for Apple's push service and App Store Connect are signed with, from
/// PKCS#8 keys such as Apple's `.p8` files, as `cryptography` signs and checks them.
///
/// X25519 key exchange (CLX-411), as `cryptography`'s `X25519PrivateKey` makes it, and Noise
/// handshakes over it, as Python's `noiseprotocol` runs them: the patterns of revision 34 of the
/// spec, IK and XX among them, with ChaChaPoly or AESGCM and SHA256, SHA512, BLAKE2s or
/// BLAKE2b, and the transport they give, with its nonces and rekeying.
///
/// And authenticated encryption (CLX-397), sealing secrets so that reading them takes the key and
/// changing them is noticed: ChaCha20-Poly1305 and XChaCha20-Poly1305, and AES-GCM, as Python's
/// `cryptography` gives them in `ChaCha20Poly1305` and `AESGCM`.
module std.crypto

import std.bytes.{base64, from_base64}
import std.hash.{Algorithm, Digest, blake2b, blake2s, sha256, sha512}

extern "C" {
    fn cx_crypto_random(p: *u8, n: usize)
    fn cx_cfb8_start(ctx: *u8, key: *const u8, iv: *const u8)
    fn cx_cfb8_encrypt(ctx: *u8, p: *u8, n: usize)
    fn cx_cfb8_decrypt(ctx: *u8, p: *u8, n: usize)
    fn cx_rsa_generate(ctx: *u8, bits: u32) -> bool
    fn cx_rsa_primes(ctx: *const u8, out: *u8) -> usize
    fn cx_rsa_from_primes(ctx: *u8, bytes: *const u8, len: usize) -> bool
    fn cx_rsa_public_der(ctx: *const u8, out: *u8) -> usize
    fn cx_rsa_encrypt(ctx: *const u8, msg: *const u8, len: usize, out: *u8) -> bool
    fn cx_rsa_decrypt(ctx: *const u8, bytes: *const u8, len: usize, out: *u8) -> i64
    fn cx_rsa_size(ctx: *const u8) -> usize
    fn cx_rsa_private_op(ctx: *const u8, bytes: *const u8, len: usize, out: *u8) -> bool
    fn cx_rsa_public_setup(ctx: *u8, modulus: *const u8, len: usize, exponent: *const u8, elen: usize) -> bool
    fn cx_rsa_public_op(ctx: *const u8, bytes: *const u8, out: *u8) -> bool
    fn cx_argon2_hash(
        kind: u32,
        memory: u32,
        passes: u32,
        lanes: u32,
        pwd: *const u8,
        pwd_len: usize,
        salt: *const u8,
        salt_len: usize,
        secret: *const u8,
        secret_len: usize,
        data: *const u8,
        data_len: usize,
        out: *u8,
        out_len: usize,
    ) -> bool
    fn cx_ed25519_public(seed: *const u8, out: *u8)
    fn cx_ed25519_sign(seed: *const u8, public: *const u8, msg: *const u8, len: usize, out: *u8)
    fn cx_ed25519_check(public: *const u8) -> bool
    fn cx_ed25519_verify(public: *const u8, msg: *const u8, len: usize, sig: *const u8) -> bool
    fn cx_x25519(scalar: *const u8, u: *const u8, out: *u8) -> bool
    fn cx_x25519_public(scalar: *const u8, out: *u8)
    fn cx_p256_scalar_check(d: *const u8) -> bool
    fn cx_p256_public(d: *const u8, out: *u8)
    fn cx_p256_check(xy: *const u8) -> bool
    fn cx_p256_decompress(x: *const u8, odd: bool, y: *u8) -> bool
    fn cx_p256_sign(d: *const u8, msg: *const u8, len: usize, out: *u8)
    fn cx_p256_verify(xy: *const u8, msg: *const u8, len: usize, sig: *const u8) -> bool
    fn cx_aead_chacha_seal(key: *const u8, nonce: *const u8, nonce_len: usize, pt: *const u8, n: usize, aad: *const u8, alen: usize, out: *u8)
    fn cx_aead_chacha_open(key: *const u8, nonce: *const u8, nonce_len: usize, sealed: *const u8, n: usize, aad: *const u8, alen: usize, out: *u8) -> bool
    fn cx_gcm_start(ctx: *u8, key: *const u8, len: usize)
    fn cx_gcm_seal(ctx: *const u8, iv: *const u8, ivlen: usize, pt: *const u8, n: usize, aad: *const u8, alen: usize, out: *u8)
    fn cx_gcm_open(ctx: *const u8, iv: *const u8, ivlen: usize, sealed: *const u8, n: usize, aad: *const u8, alen: usize, out: *u8) -> bool
}

/// `n` random bytes from the system's generator, which is good for keys, secrets and tokens.
pub fn random_bytes(n: usize) -> List<u8> {
    var out: List<u8> = [0; n]
    unsafe {
        cx_crypto_random(out.as_mut_ptr(), n)
    }
    return out
}

/// AES-128 in CFB8 mode, as Java's "AES/CFB8/NoPadding" is. A stream cipher: each byte encrypts
/// to one byte, and how a stream is split into calls doesn't change it. Vanilla keeps one for
/// each direction of a connection, both made from the shared secret.
pub struct Cfb8 {
    ctx: List<u8>,
}

impl Cfb8 {
    /// A cipher with the key and the IV, 16 bytes each. Panics if either is another length.
    @track_caller
    pub fn new(key: List<u8>, iv: List<u8>) -> Cfb8 {
        if key.len() != 16 or iv.len() != 16 {
            panic("AES-128 takes a key and an IV of 16 bytes, not {key.len()} and {iv.len()}")
        }
        var ctx: List<u8> = [0; 208]
        unsafe {
            cx_cfb8_start(ctx.as_mut_ptr(), key.as_ptr(), iv.as_ptr())
        }
        return Cfb8 { ctx: ctx }
    }

    /// Encrypts the bytes where they are, carrying on from the last call.
    pub fn encrypt(mut self, bytes: mut List<u8>) {
        unsafe {
            cx_cfb8_encrypt(self.ctx.as_mut_ptr(), bytes.as_mut_ptr(), bytes.len())
        }
    }

    /// Decrypts the bytes where they are, carrying on from the last call. It goes 16 bytes at a
    /// time with AES-NI, so it's several times as fast as encrypting.
    pub fn decrypt(mut self, bytes: mut List<u8>) {
        unsafe {
            cx_cfb8_decrypt(self.ctx.as_mut_ptr(), bytes.as_mut_ptr(), bytes.len())
        }
    }
}

/// An RSA key pair, with 65537 as the public exponent, as Java's `KeyPairGenerator` makes.
pub struct RsaKey {
    ctx: List<u8>,
}

impl RsaKey {
    /// A new key pair with a modulus of `bits` bits, 1024 or 2048. Vanilla uses 1024. Panics for
    /// any other size.
    @track_caller
    pub fn generate(bits: u32) -> RsaKey {
        var ctx: List<u8> = [0; 912]
        let made = unsafe { cx_rsa_generate(ctx.as_mut_ptr(), bits) }
        if not made {
            panic("RSA keys are 1024 or 2048 bits, not {bits}")
        }
        return RsaKey { ctx: ctx }
    }

    /// The key pair's two primes, each half the modulus's bytes, big-endian, which `from_primes`
    /// makes the same key pair from. Anyone with them has the private key.
    pub fn primes(self) -> List<u8> {
        var out: List<u8> = [0; 256]
        unsafe {
            let n = cx_rsa_primes(self.ctx.as_ptr(), out.as_mut_ptr())
            out.truncate(n)
        }
        return out
    }

    /// The key pair whose `primes` these are, or `none` unless they're two different primes as
    /// `generate` makes them, of 512 or 1024 bits each.
    pub fn from_primes(primes: List<u8>) -> RsaKey? {
        var ctx: List<u8> = [0; 912]
        let made = unsafe { cx_rsa_from_primes(ctx.as_mut_ptr(), primes.as_ptr(), primes.len()) }
        if not made {
            return none
        }
        return some(RsaKey { ctx: ctx })
    }

    /// The public key as Java's `PublicKey.getEncoded()` gives it, an X.509 SubjectPublicKeyInfo
    /// in DER, which is what vanilla's encryption request sends: 162 bytes for 1024 bits.
    pub fn public_der(self) -> List<u8> {
        var out: List<u8> = [0; 300]
        unsafe {
            let n = cx_rsa_public_der(self.ctx.as_ptr(), out.as_mut_ptr())
            out.truncate(n)
        }
        return out
    }

    /// The message encrypted with the public key and random padding, as Java's
    /// "RSA/ECB/PKCS1Padding" does: the key's length in bytes. `none` if the message is longer
    /// than that less 11.
    pub fn encrypt(self, message: List<u8>) -> List<u8>? {
        var out: List<u8> = [0; 256]
        unsafe {
            if not cx_rsa_encrypt(self.ctx.as_ptr(), message.as_ptr(), message.len(), out.as_mut_ptr()) {
                return none
            }
        }
        out.truncate(self.size())
        return some(out)
    }

    /// The message that `encrypt`, or a client with the public key, encrypted. `none` if the bytes
    /// aren't the key's length or the padding inside them is wrong. What's wrong isn't told, and
    /// it takes the same time either way, so a client can't learn about the key from it.
    pub fn decrypt(self, bytes: List<u8>) -> List<u8>? {
        var out: List<u8> = [0; 256]
        unsafe {
            let n = cx_rsa_decrypt(self.ctx.as_ptr(), bytes.as_ptr(), bytes.len(), out.as_mut_ptr())
            if n < 0 {
                return none
            }
            out.truncate(usize.wrap(n))
        }
        return some(out)
    }

    /// The modulus's length in bytes, which is what `encrypt` gives and `decrypt` takes: 128 for
    /// 1024 bits.
    pub fn size(self) -> usize {
        return unsafe { cx_rsa_size(self.ctx.as_ptr()) }
    }

    /// The public key, which `verify`s what this key signs.
    pub fn public_key(self) -> RsaPublicKey {
        return RsaPublicKey.from_der(self.public_der()) ?? panic("a key pair's own public key reads")
    }

    /// The signature of `message` with the `hash` of it, as Java's `Signature` signs with
    /// "SHA256withRSA" for `Sha256`: PKCS#1 v1.5, the key's length in bytes. The same message
    /// always signs the same.
    pub fn sign(self, hash: Algorithm, message: List<u8>) -> List<u8> {
        let size = self.size()
        let padded = pkcs1_digest(hash, message, size) ?? panic("every digest fits a key of 1024 bits")
        var out: List<u8> = [0; 256]
        unsafe {
            if not cx_rsa_private_op(self.ctx.as_ptr(), padded.as_ptr(), size, out.as_mut_ptr()) {
                panic("a padded digest is below the modulus")
            }
        }
        out.truncate(size)
        return out
    }
}

/// An RSA public key, read from an X.509 SubjectPublicKeyInfo in DER, the bytes Java's
/// `PublicKey.getEncoded()` gives: a modulus of 512 to 4096 bits and its exponent. It checks
/// signatures, as Java's `Signature` checks them.
pub struct RsaPublicKey {
    encoded: List<u8>,
    // The modulus's length in bytes, and the key set up for its operation, with what Montgomery
    // multiplication needs worked out once.
    bytes: usize,
    ctx: List<u8>,
}

impl RsaPublicKey {
    /// The key in `der`, or `none` if it isn't an RSA key in DER as `getEncoded()` writes one,
    /// every length and number in its shortest form with nothing after it, or its modulus isn't
    /// an odd number of 512 to 4096 bits, or its exponent isn't from 3 to less than the modulus.
    pub fn from_der(der: List<u8>) -> RsaPublicKey? {
        var r = Der { bytes: der.copy(), at: 0 }
        let info = r.enter(0x30) else return none
        let algorithm = r.enter(0x30) else return none
        // rsaEncryption, 1.2.840.113549.1.1.1, with no parameters.
        let oid: List<u8> = [0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x01, 0x05, 0x00]
        if algorithm - r.at != oid.len() or not r.next_are(oid) {
            return none
        }
        let bits = r.enter(0x03) else return none
        if r.byte() != some(0) {
            return none
        }
        let key = r.enter(0x30) else return none
        let modulus = r.integer() else return none
        let exponent = r.integer() else return none
        if r.at != key or key != bits or bits != info or info != der.len() {
            return none
        }
        let size = modulus.len()
        let top = modulus[0]
        var top_bits: usize = 0
        while i32(top) >> i32.wrap(top_bits) != 0 {
            top_bits += 1
        }
        let length = 8 * (size - 1) + top_bits
        if length < 512 or length > 4096 or modulus[size - 1] & 1 == 0 {
            return none
        }
        if exponent.len() > size or (exponent.len() == size and not below(exponent, modulus)) {
            return none
        }
        if exponent.len() == 1 and exponent[0] < 3 {
            return none
        }
        var ctx: List<u8> = [0; 1568]
        let ready = unsafe { cx_rsa_public_setup(ctx.as_mut_ptr(), modulus.as_ptr(), size, exponent.as_ptr(), exponent.len()) }
        if not ready {
            return none
        }
        return some(RsaPublicKey { encoded: der.copy(), bytes: size, ctx: ctx })
    }

    /// The key as X.509 DER, as it was read, which is how Java's `getEncoded()` writes it.
    pub fn der(self) -> List<u8> {
        return self.encoded.copy()
    }

    /// The modulus's length in bytes, which a signature has: 256 for 2048 bits.
    pub fn size(self) -> usize {
        return self.bytes
    }

    /// Whether `signature` is the key's PKCS#1 v1.5 signature of `message` with its `hash`, as
    /// Java's `Signature.verify` decides for "SHA256withRSA" with `Sha256` or "SHA1withRSA" with
    /// `Sha1`. One whose number isn't below the modulus isn't, as Java decides too. Nor is one
    /// that isn't the key's length, where Java throws a `SignatureException`, `Bad signature
    /// length: got 255 but was expecting 256`, that vanilla logs and takes as a no.
    pub fn verify(self, hash: Algorithm, message: List<u8>, signature: List<u8>) -> bool {
        let size = self.size()
        if signature.len() != size {
            return false
        }
        let want = pkcs1_digest(hash, message, size) else return false
        var got: List<u8> = [0; size]
        let done = unsafe { cx_rsa_public_op(self.ctx.as_ptr(), signature.as_ptr(), got.as_mut_ptr()) }
        return done and got == want
    }
}

/// Whether the two are the same bytes, in a time that depends only on their lengths, not on where
/// they first differ, as Python's `hmac.compare_digest` decides. A tag or token checked with `==`
/// tells someone timing the answers how much of their guess was right.
pub fn compare_digest(a: List<u8>, b: List<u8>) -> bool {
    if a.len() != b.len() {
        return false
    }
    var diff: u8 = 0
    for i in 0..a.len() {
        diff |= a[i] ^ b[i]
    }
    return diff == 0
}

/// Which of RFC 9106's three argon2s: `Id`, for passwords, chooses blocks as `I` does for the first
/// half of the first pass, which shows nothing of the password to someone timing the memory, and
/// as `D` does after, which makes it costly to trade memory for time.
pub enum Argon2Type {
    /// Blocks chosen by what's in memory: the costliest to attack with less of it, but open to
    /// someone timing which memory is read.
    D
    /// Blocks chosen by a counter: open to nothing that watches the memory, but less costly to
    /// attack with less of it.
    I
    /// The two together, which RFC 9106 says to use.
    Id
}

impl Argon2Type {
    /// Its name in a PHC string: `argon2d`, `argon2i` or `argon2id`.
    pub fn name(self) -> str {
        return match self {
            D => "argon2d",
            I => "argon2i",
            Id => "argon2id",
        }
    }

    fn code(self) -> u32 {
        return match self {
            D => 0,
            I => 1,
            Id => 2,
        }
    }
}

/// The argon2 tag of the password with the salt, version 0x13, as RFC 9106 makes it and Python's
/// `argon2.low_level.hash_secret_raw` gives it: `len` bytes, from `memory_kib` KiB of memory
/// passed over `iterations` times in `parallelism` lanes, which run on threads of their own.
/// `secret` is a key mixed in that isn't stored beside the hash, a pepper, and `data` more that's
/// tied to it; both are empty unless given. The defaults are RFC 9106's second recommendation,
/// argon2-cffi's: 64 MiB, 3 passes and 4 lanes. Panics unless the salt is 8 bytes or more, `len`
/// 4 or more, `iterations` 1 or more, `parallelism` 1 to 16777215 and `memory_kib` at least 8
/// for each lane, or if the memory can't be had.
@track_caller
pub fn argon2(
    password: List<u8>,
    salt: List<u8>,
    memory_kib: u32 = 65536,
    iterations: u32 = 3,
    parallelism: u32 = 4,
    len: usize = 32,
    secret: List<u8> = [],
    data: List<u8> = [],
    kind: Argon2Type = Argon2Type.Id,
) -> List<u8> {
    if salt.len() < 8 {
        panic("an argon2 salt is 8 bytes or more, not {salt.len()}")
    }
    if len < 4 {
        panic("an argon2 tag is 4 bytes or more, not {len}")
    }
    if iterations < 1 {
        panic("argon2 makes 1 pass or more, not 0")
    }
    if parallelism < 1 or parallelism > 16777215 {
        panic("argon2 has 1 to 16777215 lanes, not {parallelism}")
    }
    if u64(memory_kib) < 8 * u64(parallelism) {
        panic("argon2 takes 8 KiB or more for each lane, so {parallelism} lanes take {8 * u64(parallelism)}, not {memory_kib}")
    }
    return argon2_raw(kind, password, salt, memory_kib, iterations, parallelism, len, secret, data) ?? panic("argon2 couldn't have {memory_kib} KiB of memory")
}

// The tag, or none if the parameters are out of range or the memory couldn't be had.
fn argon2_raw(kind: Argon2Type, password: List<u8>, salt: List<u8>, memory: u32, passes: u32, lanes: u32, len: usize, secret: List<u8>, data: List<u8>) -> List<u8>? {
    var out: List<u8> = [0; len]
    let done = unsafe {
        cx_argon2_hash(
            kind.code(),
            memory,
            passes,
            lanes,
            password.as_ptr(),
            password.len(),
            salt.as_ptr(),
            salt.len(),
            secret.as_ptr(),
            secret.len(),
            data.as_ptr(),
            data.len(),
            out.as_mut_ptr(),
            len,
        )
    }
    if not done {
        return none
    }
    return some(out)
}

/// Hashes passwords with argon2id for storing, as Python's `argon2.PasswordHasher` does, in the
/// PHC string format it and the reference implementation write, which `verify_password` checks:
/// `$argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>`, the salt and hash in base64 without padding.
/// `PasswordHasher()` has argon2-cffi's defaults, RFC 9106's second recommendation; give fields
/// to change them, as `PasswordHasher { memory_kib: 19456, iterations: 2, parallelism: 1 }`.
pub struct PasswordHasher {
    /// The memory each hash takes, in KiB: 64 MiB.
    pub memory_kib: u32 = 65536
    /// How many passes over that memory.
    pub iterations: u32 = 3
    /// How many lanes, run on threads of their own.
    pub parallelism: u32 = 4
    /// How many bytes of hash.
    pub hash_len: usize = 32
    /// How many bytes of salt, which `hash` takes from the system's random source.
    pub salt_len: usize = 16
}

impl PasswordHasher {
    /// The password hashed with a new random salt, as a PHC string to store, which is different
    /// each time. Panics if the parameters are out of argon2's range, as `argon2` says.
    @track_caller
    pub fn hash(self, password: String) -> String {
        let salt = random_bytes(self.salt_len)
        let tag = argon2(password.to_bytes(), salt.copy(), memory_kib: self.memory_kib, iterations: self.iterations, parallelism: self.parallelism, len: self.hash_len)
        return "$argon2id$v=19$m={self.memory_kib},t={self.iterations},p={self.parallelism}${phc64(salt)}${phc64(tag)}"
    }

    /// Whether `hash` was made other than this hasher would make it now, by type, version,
    /// memory, passes, lanes or the salt's or hash's length, so it should be made again from the
    /// password, which a program has just after `verify_password` takes it, as argon2-cffi's
    /// `check_needs_rehash` decides. A string that isn't a hash needs it too.
    pub fn needs_rehash(self, hash: String) -> bool {
        let phc = Phc.parse(hash) else return true
        return phc.kind != Argon2Type.Id or phc.memory != self.memory_kib or phc.iterations != self.iterations or phc.parallelism != self.parallelism or phc.salt.len() != self.salt_len or phc.hash.len() != self.hash_len
    }
}

/// Whether `password` is the one `hash`, a PHC string, was made from, as argon2-cffi's
/// `PasswordHasher.verify` decides, with the parameters in the string, so it checks hashes made
/// with any `PasswordHasher`'s, before they changed too. It takes argon2id, argon2i and argon2d,
/// of version 19. The hashes are compared in constant time. A string that isn't such a hash is
/// `false`, where argon2-cffi raises.
pub fn verify_password(hash: String, password: String) -> bool {
    let phc = Phc.parse(hash) else return false
    let tag = argon2_raw(phc.kind, password.to_bytes(), phc.salt.copy(), phc.memory, phc.iterations, phc.parallelism, phc.hash.len(), [], []) else return false
    return compare_digest(tag, phc.hash.copy())
}

// Base64 without its padding, as PHC strings write it.
fn phc64(bytes: List<u8>) -> String {
    return base64(bytes).replace("=", "")
}

// An argon2 hash read from a PHC string: `$argon2id$v=19$m=…,t=…,p=…$salt$hash`, with the
// parameters in that order, as the reference implementation reads it, and in range.
struct Phc {
    kind: Argon2Type,
    memory: u32,
    iterations: u32,
    parallelism: u32,
    salt: List<u8>,
    hash: List<u8>,
}

impl Phc {
    fn parse(text: String) -> Phc? {
        let parts = text.split("$")
        if parts.len() != 6 or parts[0] != "" or parts[2] != "v=19" {
            return none
        }
        let kind = if parts[1] == "argon2id" {
            Argon2Type.Id
        } else if parts[1] == "argon2i" {
            Argon2Type.I
        } else if parts[1] == "argon2d" {
            Argon2Type.D
        } else {
            return none
        }
        let params = parts[3].split(",")
        if params.len() != 3 {
            return none
        }
        let memory = u32.parse(params[0].trim_prefix("m=")) else return none
        let iterations = u32.parse(params[1].trim_prefix("t=")) else return none
        let parallelism = u32.parse(params[2].trim_prefix("p=")) else return none
        if not params[0].starts_with("m=") or not params[1].starts_with("t=") or not params[2].starts_with("p=") {
            return none
        }
        if parts[4].contains("=") or parts[5].contains("=") {
            return none
        }
        let salt = from_base64(parts[4]) else return none
        let hash = from_base64(parts[5]) else return none
        if salt.len() < 8 or hash.len() < 4 or iterations < 1 or parallelism < 1 or parallelism > 16777215 or u64(memory) < 8 * u64(parallelism) {
            return none
        }
        return some(Phc { kind: kind, memory: memory, iterations: iterations, parallelism: parallelism, salt: salt, hash: hash })
    }
}

/// An Ed25519 private key, RFC 8032's: a 32-byte seed, from which its public key and every
/// signature are worked out, as Python's `cryptography` `Ed25519PrivateKey` holds it.
pub struct Ed25519Key {
    secret: List<u8>,
    public: List<u8>,
}

impl Ed25519Key {
    /// A new key, from 32 bytes of the system's random source, as `Ed25519PrivateKey.generate()`.
    pub fn generate() -> Ed25519Key {
        return Ed25519Key.from_seed(random_bytes(32)) ?? panic("32 random bytes are a seed")
    }

    /// The key whose seed this is, as `Ed25519PrivateKey.from_private_bytes(seed)` makes it, or
    /// `none` unless it's 32 bytes. Every 32 bytes are a seed.
    pub fn from_seed(seed: List<u8>) -> Ed25519Key? {
        if seed.len() != 32 {
            return none
        }
        var public: List<u8> = [0; 32]
        unsafe {
            cx_ed25519_public(seed.as_ptr(), public.as_mut_ptr())
        }
        return some(Ed25519Key { secret: seed.copy(), public: public })
    }

    /// The 32-byte seed, which `from_seed` makes the same key from, as `private_bytes_raw()` gives
    /// it. Anyone with it can sign as the key.
    pub fn seed(self) -> List<u8> {
        return self.secret.copy()
    }

    /// The public key, which checks what this key signs.
    pub fn public_key(self) -> Ed25519PublicKey {
        return Ed25519PublicKey { encoded: self.public.copy() }
    }

    /// The 64-byte signature of the message, the same each time for the same message, as
    /// `Ed25519PrivateKey.sign(message)` gives it.
    pub fn sign(self, message: List<u8>) -> List<u8> {
        var out: List<u8> = [0; 64]
        unsafe {
            cx_ed25519_sign(self.secret.as_ptr(), self.public.as_ptr(), message.as_ptr(), message.len(), out.as_mut_ptr())
        }
        return out
    }
}

/// An Ed25519 public key: 32 bytes, a point on the curve, as Python's `cryptography`
/// `Ed25519PublicKey` holds it. It checks signatures.
pub struct Ed25519PublicKey {
    encoded: List<u8>,
}

impl Ed25519PublicKey {
    /// The key in these 32 bytes, as `Ed25519PublicKey.from_public_bytes(bytes)` reads it, or
    /// `none` unless they're 32 bytes that encode a point on the curve, in its one encoding.
    pub fn from_bytes(bytes: List<u8>) -> Ed25519PublicKey? {
        if bytes.len() != 32 or not unsafe { cx_ed25519_check(bytes.as_ptr()) } {
            return none
        }
        return some(Ed25519PublicKey { encoded: bytes.copy() })
    }

    /// The key's 32 bytes, as `public_bytes_raw()` gives them.
    pub fn bytes(self) -> List<u8> {
        return self.encoded.copy()
    }

    /// Whether `signature` is the key's signature of `message`, as `cryptography`'s `verify`
    /// decides it, where that raises `InvalidSignature` for no: 64 bytes, its R a point in its one
    /// encoding and its S below the group's order, with [S]B - [k]A giving R.
    pub fn verify(self, message: List<u8>, signature: List<u8>) -> bool {
        if signature.len() != 64 {
            return false
        }
        return unsafe { cx_ed25519_verify(self.encoded.as_ptr(), message.as_ptr(), message.len(), signature.as_ptr()) }
    }
}

/// An X25519 private key, RFC 7748's: 32 bytes, as Python's `cryptography` `X25519PrivateKey`
/// holds it. With another's public key it makes a secret the two share, which the other makes
/// from this key's public key and its own private key, and which no one watching can.
pub struct X25519Key {
    secret: List<u8>,
    public: List<u8>,
}

impl X25519Key {
    /// A new key, 32 bytes from the system's random source, as `X25519PrivateKey.generate()`.
    pub fn generate() -> X25519Key {
        return X25519Key.from_bytes(random_bytes(32)) ?? panic("32 random bytes are a key")
    }

    /// The key in these 32 bytes, as `X25519PrivateKey.from_private_bytes(bytes)` reads it, or
    /// `none` unless they're 32 bytes. Every 32 bytes are a key: X25519 clears the low three bits
    /// and the top one, and sets the one below the top, as it uses them.
    pub fn from_bytes(bytes: List<u8>) -> X25519Key? {
        if bytes.len() != 32 {
            return none
        }
        var public: List<u8> = [0; 32]
        unsafe {
            cx_x25519_public(bytes.as_ptr(), public.as_mut_ptr())
        }
        return some(X25519Key { secret: bytes.copy(), public: public })
    }

    /// The key's 32 bytes, as they were given, as `private_bytes_raw()` gives them. Anyone with
    /// them has every secret the key shares.
    pub fn bytes(self) -> List<u8> {
        return self.secret.copy()
    }

    /// The public key, 9 on the curve times this key, which is given to the other side.
    pub fn public_key(self) -> X25519PublicKey {
        return X25519PublicKey { encoded: self.public.copy() }
    }

    /// The 32 bytes this key shares with `peer`, as `exchange(peer)` gives them, or `none` where
    /// they'd be all zeros, where `cryptography` raises `ValueError`: `peer` is a point of small
    /// order, which shares the same zeros with every key, so nothing is secret. Hash them, with
    /// both public keys, before using them as a key, as HKDF or Noise does.
    pub fn exchange(self, peer: X25519PublicKey) -> List<u8>? {
        var out: List<u8> = [0; 32]
        let shared = unsafe { cx_x25519(self.secret.as_ptr(), peer.encoded.as_ptr(), out.as_mut_ptr()) }
        if not shared {
            return none
        }
        return some(out)
    }
}

/// An X25519 public key: 32 bytes, a point's u, little-endian, as Python's `cryptography`
/// `X25519PublicKey` holds it.
pub struct X25519PublicKey {
    encoded: List<u8>,
}

impl X25519PublicKey {
    /// The key in these 32 bytes, as `X25519PublicKey.from_public_bytes(bytes)` reads it, or
    /// `none` unless they're 32 bytes. Every 32 bytes are taken, as RFC 7748 says: the top bit is
    /// left out, and a u of the field's prime or more is taken less the prime. A point of small
    /// order is taken too, and `exchange` with it gives `none`.
    pub fn from_bytes(bytes: List<u8>) -> X25519PublicKey? {
        if bytes.len() != 32 {
            return none
        }
        return some(X25519PublicKey { encoded: bytes.copy() })
    }

    /// The key's 32 bytes, as `public_bytes_raw()` gives them.
    pub fn bytes(self) -> List<u8> {
        return self.encoded.copy()
    }
}

/// An ECDSA private key on NIST's P-256 curve, also called secp256r1 and prime256v1, which signs
/// with SHA-256: JWS's ES256, which Apple's push service, App Store Connect's API and Sign in
/// with Apple take, as Python's `cryptography` signs with `ec.ECDSA(hashes.SHA256())`. It's a
/// number from 1 to the group's order less 1, kept in a PKCS#8 file, which Apple's `.p8` keys
/// are.
pub struct P256Key {
    // d, 32 bytes, big-endian, and its public key's x and y, 32 bytes each.
    secret: List<u8>,
    public: List<u8>,
}

impl P256Key {
    /// A new key, a number from the system's random source, as `ec.generate_private_key(ec.SECP256R1())`.
    pub fn generate() -> P256Key {
        loop {
            // 32 random bytes are n or more, and drawn again, about once in 2^32 times.
            if let key = P256Key.from_scalar(random_bytes(32)) {
                return key
            }
        }
    }

    /// The key whose private number d is these 32 bytes, big-endian, as
    /// `ec.derive_private_key(d, ec.SECP256R1())` makes it, or `none` unless they're 32 bytes of
    /// a number from 1 to the group's order less 1.
    pub fn from_scalar(bytes: List<u8>) -> P256Key? {
        if bytes.len() != 32 or not unsafe { cx_p256_scalar_check(bytes.as_ptr()) } {
            return none
        }
        var public: List<u8> = [0; 64]
        unsafe {
            cx_p256_public(bytes.as_ptr(), public.as_mut_ptr())
        }
        return some(P256Key { secret: bytes.copy(), public: public })
    }

    /// The key in DER, as `serialization.load_der_private_key(der, None)` reads it: a PKCS#8
    /// PrivateKeyInfo for a P-256 key, or a SEC1 ECPrivateKey that names the curve, as OpenSSL's
    /// `ecparam -genkey` writes, every length in its shortest form and nothing after. `none` for
    /// anything else, an encrypted key or another curve's among them, or if the public key in it
    /// isn't the private key's.
    pub fn from_der(der: List<u8>) -> P256Key? {
        if let key = pkcs8_key(der.copy()) {
            return some(key)
        }
        return ec_private_key(der, true)
    }

    /// The key in PEM, as `serialization.load_pem_private_key(pem, None)` reads it: the PKCS#8
    /// of a `-----BEGIN PRIVATE KEY-----` block, which is what an Apple `.p8` file holds, or the
    /// SEC1 of a `-----BEGIN EC PRIVATE KEY-----` one, read as `from_der` reads them. Text before
    /// and after the block is skipped. `none` if there's no such block, or what's in it isn't
    /// such a key.
    pub fn from_pem(pem: String) -> P256Key? {
        if let der = pem_block(pem.copy(), "PRIVATE KEY") {
            return pkcs8_key(der)
        }
        let der = pem_block(pem, "EC PRIVATE KEY") else return none
        return ec_private_key(der, true)
    }

    /// The private number d, 32 bytes, big-endian, which `from_scalar` makes the same key from,
    /// as `private_numbers().private_value` holds it. Anyone with it can sign as the key.
    pub fn scalar(self) -> List<u8> {
        return self.secret.copy()
    }

    /// The key as a PKCS#8 PrivateKeyInfo in DER, unencrypted, with the public key in it, as
    /// `private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())` and OpenSSL write it,
    /// and as Apple's `.p8` files hold it: 138 bytes.
    pub fn der(self) -> List<u8> {
        var ec: List<u8> = [0x02, 0x01, 0x01]
        ec.extend(der_tlv(0x04, self.secret.copy()))
        ec.extend(der_tlv(0xA1, der_tlv(0x03, point_bits(self.public.copy()))))
        var info: List<u8> = [0x02, 0x01, 0x00]
        info.extend(P256_ALGORITHM)
        info.extend(der_tlv(0x04, der_tlv(0x30, ec)))
        return der_tlv(0x30, info)
    }

    /// `der()` as a `-----BEGIN PRIVATE KEY-----` PEM block, base64 in lines of 64, as
    /// `private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption())` writes it.
    pub fn pem(self) -> String {
        return pem_text(self.der(), "PRIVATE KEY")
    }

    /// The public key, which checks what this key signs.
    pub fn public_key(self) -> P256PublicKey {
        return P256PublicKey { point: self.public.copy() }
    }

    /// The ES256 signature of the message: r then s, 32 bytes each, big-endian, the 64 bytes JWS
    /// and WebAuthn's COSE put in a token, where `cryptography`'s `sign` gives DER and
    /// `utils.decode_dss_signature` takes it apart. The nonce is RFC 6979's, worked out from the
    /// key and the message's SHA-256, so the same message always signs the same and no random
    /// source is needed.
    pub fn sign(self, message: List<u8>) -> List<u8> {
        var out: List<u8> = [0; 64]
        unsafe {
            cx_p256_sign(self.secret.as_ptr(), message.as_ptr(), message.len(), out.as_mut_ptr())
        }
        return out
    }

    /// The same signature in DER, a SEQUENCE of r and s as INTEGERs, as `cryptography`'s
    /// `sign(message, ec.ECDSA(hashes.SHA256()))`, X.509 and TLS give it: 70 to 72 bytes, most
    /// often.
    pub fn sign_der(self, message: List<u8>) -> List<u8> {
        let raw = self.sign(message)
        var both = der_uint(raw[..32])
        both.extend(der_uint(raw[32..]))
        return der_tlv(0x30, both)
    }
}

/// A P-256 public key: a point on the curve, x and y, as Python's `cryptography`
/// `EllipticCurvePublicKey` holds it. It checks ES256 signatures.
pub struct P256PublicKey {
    // x then y, 32 bytes each, big-endian.
    point: List<u8>,
}

impl P256PublicKey {
    /// The key in SEC1's encoding of a point, X9.62's, as
    /// `EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), bytes)` reads it: 65 bytes, 4
    /// then x and y, or 33, 2 or 3 for y's parity then x. `none` unless it's one of those, with x
    /// and y below the field's prime and the point on the curve.
    pub fn from_sec1(bytes: List<u8>) -> P256PublicKey? {
        if bytes.len() == 65 and bytes[0] == 4 {
            let point = bytes[1..]
            if not unsafe { cx_p256_check(point.as_ptr()) } {
                return none
            }
            return some(P256PublicKey { point: point })
        }
        if bytes.len() == 33 and (bytes[0] == 2 or bytes[0] == 3) {
            var point = bytes[1..]
            var y: List<u8> = [0; 32]
            if not unsafe { cx_p256_decompress(point.as_ptr(), bytes[0] == 3, y.as_mut_ptr()) } {
                return none
            }
            point.extend(y)
            return some(P256PublicKey { point: point })
        }
        return none
    }

    /// The key in an X.509 SubjectPublicKeyInfo in DER, as `serialization.load_der_public_key`
    /// reads one and Java's `getEncoded()` writes it: `id-ecPublicKey` with `prime256v1`, then
    /// the point as `from_sec1` takes it, every length in its shortest form and nothing after.
    /// `none` for anything else.
    pub fn from_der(der: List<u8>) -> P256PublicKey? {
        var r = Der { bytes: der.copy(), at: 0 }
        let info = r.enter(0x30) else return none
        if info != der.len() or not r.next_are(P256_ALGORITHM[..]) {
            return none
        }
        let bits = r.enter(0x03) else return none
        if bits != info or r.byte() != some(0) {
            return none
        }
        return P256PublicKey.from_sec1(der[r.at..])
    }

    /// The key in a `-----BEGIN PUBLIC KEY-----` PEM block, as
    /// `serialization.load_pem_public_key` reads it, the DER in it read as `from_der` reads it.
    pub fn from_pem(pem: String) -> P256PublicKey? {
        let der = pem_block(pem, "PUBLIC KEY") else return none
        return P256PublicKey.from_der(der)
    }

    /// The point in SEC1's encoding: 65 bytes, 4 then x and y, as
    /// `public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)`, or with `compressed` 33, 2
    /// or 3 for y's parity then x, as `PublicFormat.CompressedPoint`.
    pub fn sec1(self, compressed: bool = false) -> List<u8> {
        if compressed {
            var out: List<u8> = [2 + (self.point[63] & 1)]
            out.extend(self.point[..32])
            return out
        }
        var out: List<u8> = [4]
        out.extend(self.point.copy())
        return out
    }

    /// x and y, 32 bytes each, big-endian, as a JWK's `x` and `y` hold them in base64url.
    pub fn x(self) -> List<u8> {
        return self.point[..32]
    }

    /// y, as `x` gives x.
    pub fn y(self) -> List<u8> {
        return self.point[32..]
    }

    /// The key as an X.509 SubjectPublicKeyInfo in DER, 91 bytes, as
    /// `public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo)` writes it.
    pub fn der(self) -> List<u8> {
        var info = P256_ALGORITHM[..]
        info.extend(der_tlv(0x03, point_bits(self.point.copy())))
        return der_tlv(0x30, info)
    }

    /// `der()` as a `-----BEGIN PUBLIC KEY-----` PEM block.
    pub fn pem(self) -> String {
        return pem_text(self.der(), "PUBLIC KEY")
    }

    /// Whether `signature`, r then s in 64 bytes as `P256Key.sign` gives them, is the key's ES256
    /// signature of `message`, as `cryptography`'s `verify` decides, where that raises
    /// `InvalidSignature` for no: r and s from 1 to the group's order less 1, and the point
    /// worked out from them, the message's SHA-256 and the key having r as its x. One that isn't
    /// 64 bytes isn't.
    pub fn verify(self, message: List<u8>, signature: List<u8>) -> bool {
        if signature.len() != 64 {
            return false
        }
        return unsafe { cx_p256_verify(self.point.as_ptr(), message.as_ptr(), message.len(), signature.as_ptr()) }
    }

    /// Whether `signature`, in DER as `P256Key.sign_der` and `cryptography` give it, is the key's
    /// signature of `message`, as `verify` decides. It must be DER, not BER: a SEQUENCE of two
    /// positive INTEGERs, every length and number in its shortest form, and nothing after, so no
    /// second form of a signature passes.
    pub fn verify_der(self, message: List<u8>, signature: List<u8>) -> bool {
        let raw = der_signature(signature) else return false
        return self.verify(message, raw)
    }
}

// The AlgorithmIdentifier of a P-256 key: id-ecPublicKey, 1.2.840.10045.2.1, with prime256v1,
// 1.2.840.10045.3.1.7, as its parameters.
const P256_ALGORITHM: [u8; 21] = [
    0x30, 0x13, 0x06, 0x07, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03, 0x01, 0x07,
]

// prime256v1's OBJECT IDENTIFIER, as SEC1's ECPrivateKey names its curve.
const P256_CURVE: [u8; 10] = [0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03, 0x01, 0x07]

// A P-256 key from a PKCS#8 PrivateKeyInfo: version 0, P-256's AlgorithmIdentifier, then the
// SEC1 ECPrivateKey in an OCTET STRING.
fn pkcs8_key(der: List<u8>) -> P256Key? {
    var r = Der { bytes: der.copy(), at: 0 }
    let info = r.enter(0x30) else return none
    if info != der.len() or not r.next_are([0x02, 0x01, 0x00]) or not r.next_are(P256_ALGORITHM[..]) {
        return none
    }
    let inner = r.enter(0x04) else return none
    if inner != info {
        return none
    }
    return ec_private_key(der[r.at..inner], false)
}

// A P-256 key from a SEC1 ECPrivateKey: version 1, the private number in an OCTET STRING, then
// the curve in [0], which must be prime256v1 if it's there and is needed with `named`, since
// nothing else says which curve the number is on, then the public key in [1], which must be the
// private key's if it's there.
fn ec_private_key(der: List<u8>, named: bool) -> P256Key? {
    var r = Der { bytes: der.copy(), at: 0 }
    let end = r.enter(0x30) else return none
    if end != der.len() or not r.next_are([0x02, 0x01, 0x01]) {
        return none
    }
    let number = r.enter(0x04) else return none
    let len = number - r.at
    // RFC 5915 says 32 bytes. Some writers have left out the zeros at the front.
    if len == 0 or len > 32 {
        return none
    }
    var scalar: List<u8> = [0; 32 - len]
    scalar.extend(der[r.at..number])
    r.at = number
    var has_curve = false
    if r.at < end and der[r.at] == 0xA0 {
        let curve = r.enter(0xA0) else return none
        if not r.next_are(P256_CURVE[..]) or r.at != curve {
            return none
        }
        has_curve = true
    }
    var public: List<u8>? = none
    if r.at < end and der[r.at] == 0xA1 {
        let tagged = r.enter(0xA1) else return none
        let bits = r.enter(0x03) else return none
        if bits != tagged or r.byte() != some(0) {
            return none
        }
        public = some(der[r.at..bits])
        r.at = bits
    }
    if r.at != end or (named and not has_curve) {
        return none
    }
    let key = P256Key.from_scalar(scalar) else return none
    if let encoded = public {
        let point = P256PublicKey.from_sec1(encoded) else return none
        if point.point != key.public {
            return none
        }
    }
    return some(key)
}

// A tag, its length in DER's shortest form, and the content.
fn der_tlv(tag: u8, content: List<u8>) -> List<u8> {
    var out: List<u8> = [tag]
    let n = content.len()
    if n < 0x80 {
        out.push(u8.wrap(n))
    } else if n < 0x100 {
        out.push(0x81)
        out.push(u8.wrap(n))
    } else {
        out.push(0x82)
        out.push(u8.wrap(n >> 8))
        out.push(u8.wrap(n))
    }
    out.extend(content)
    return out
}

// A big-endian unsigned number as a DER INTEGER: without the zeros at its front, and with one
// if its top bit is set, which would make it negative.
fn der_uint(bytes: List<u8>) -> List<u8> {
    var start: usize = 0
    while start + 1 < bytes.len() and bytes[start] == 0 {
        start += 1
    }
    var content: List<u8> = []
    if bytes[start] & 0x80 != 0 {
        content.push(0)
    }
    content.extend(bytes[start..])
    return der_tlv(0x02, content)
}

// A point's BIT STRING content: no unused bits, then 4, x and y.
fn point_bits(xy: List<u8>) -> List<u8> {
    var out: List<u8> = [0, 4]
    out.extend(xy)
    return out
}

// r and s, 32 bytes each, from a signature in DER, or none unless it's a SEQUENCE of two positive
// INTEGERs of up to 32 bytes, in DER's shortest forms, with nothing after.
fn der_signature(der: List<u8>) -> List<u8>? {
    var r = Der { bytes: der.copy(), at: 0 }
    let end = r.enter(0x30) else return none
    if end != der.len() {
        return none
    }
    let first = r.integer() else return none
    let second = r.integer() else return none
    if r.at != end or first.len() > 32 or second.len() > 32 {
        return none
    }
    var out: List<u8> = [0; 32 - first.len()]
    out.extend(first)
    out.extend([0; 32 - second.len()])
    out.extend(second)
    return some(out)
}

// The bytes of the first `-----BEGIN label-----` block in PEM text, its base64 with the line
// breaks taken out, or none if there's none or what's in it isn't base64, as a header line, such
// as an encrypted key's `Proc-Type:`, isn't.
fn pem_block(pem: String, label: str) -> List<u8>? {
    let begin = "-----BEGIN {label}-----"
    let start = pem.find(begin.copy()) else return none
    let rest = pem[(start + begin.len())..]
    let stop = rest.find("-----END {label}-----") else return none
    let body = rest[..stop].split_whitespace().join("")
    if body.is_empty() {
        return none
    }
    return from_base64(body)
}

// DER as a PEM block, its base64 in lines of 64, as OpenSSL writes it.
fn pem_text(der: List<u8>, label: str) -> String {
    let encoded = base64(der)
    var out = "-----BEGIN {label}-----\n"
    var at: usize = 0
    while at < encoded.len() {
        let stop = if at + 64 < encoded.len() { at + 64 } else { encoded.len() }
        out.push_str(encoded[at..stop])
        out.push('\n')
        at = stop
    }
    out.push_str("-----END {label}-----\n")
    return out
}

/// ChaCha20-Poly1305, RFC 8439's authenticated encryption, as Python's `cryptography`
/// `ChaCha20Poly1305` gives it: a 32-byte key and a 12-byte nonce, and what it seals is the
/// ciphertext with a 16-byte tag after it, which `decrypt` checks before it gives anything back.
/// A nonce must never seal two messages with one key, which would give away the xor of the two
/// and let someone forge others. A counter is safe. For random nonces, use `XChaCha20Poly1305`,
/// whose nonce is long enough for them.
pub struct ChaCha20Poly1305 {
    key: List<u8>,
}

impl ChaCha20Poly1305 {
    /// A new key, 32 bytes from the system's random source, as `ChaCha20Poly1305.generate_key()`.
    pub fn generate_key() -> List<u8> {
        return random_bytes(32)
    }

    /// The cipher with the key, as `ChaCha20Poly1305(key)`. Panics unless it's 32 bytes.
    @track_caller
    pub fn new(key: List<u8>) -> ChaCha20Poly1305 {
        if key.len() != 32 {
            panic("ChaCha20-Poly1305 takes a key of 32 bytes, not {key.len()}")
        }
        return ChaCha20Poly1305 { key: key.copy() }
    }

    /// The plaintext encrypted, with the tag after it, 16 bytes longer, as `encrypt(nonce,
    /// plaintext, aad)`. `aad` is associated data, which isn't encrypted or put in, but which the
    /// tag covers, so `decrypt` opens the message only with the same: a record's id, say, so a
    /// sealed value can't be moved to another record. Panics unless the nonce is 12 bytes, or if
    /// the plaintext is over 256 GiB less 64 bytes, as far as the cipher's block counter goes.
    @track_caller
    pub fn encrypt(self, nonce: List<u8>, plaintext: List<u8>, aad: List<u8> = []) -> List<u8> {
        if nonce.len() != 12 {
            panic("ChaCha20-Poly1305 takes a nonce of 12 bytes, not {nonce.len()}")
        }
        return chacha_seal(self.key, nonce, plaintext, aad)
    }

    /// The plaintext `encrypt` sealed with this key, nonce and `aad`, or `none` if `sealed` isn't
    /// that, as when a byte of it, the nonce or the associated data has changed, or the key is
    /// another, where `cryptography` raises `InvalidTag`. The tag is compared in constant time,
    /// before anything is decrypted. `none` too unless the nonce is 12 bytes.
    pub fn decrypt(self, nonce: List<u8>, sealed: List<u8>, aad: List<u8> = []) -> List<u8>? {
        if nonce.len() != 12 {
            return none
        }
        return chacha_open(self.key, nonce, sealed, aad)
    }
}

/// XChaCha20-Poly1305, as draft-irtf-cfrg-xchacha makes it and libsodium's
/// `crypto_aead_xchacha20poly1305_ietf` gives it: ChaCha20-Poly1305 with a 24-byte nonce, from
/// which HChaCha20 makes a key for each message. Nonces of 24 random bytes from `random_bytes`
/// are safe for as many messages as a key will ever seal, so a program needn't keep a counter.
pub struct XChaCha20Poly1305 {
    key: List<u8>,
}

impl XChaCha20Poly1305 {
    /// A new key, 32 bytes from the system's random source.
    pub fn generate_key() -> List<u8> {
        return random_bytes(32)
    }

    /// The cipher with the key. Panics unless it's 32 bytes.
    @track_caller
    pub fn new(key: List<u8>) -> XChaCha20Poly1305 {
        if key.len() != 32 {
            panic("XChaCha20-Poly1305 takes a key of 32 bytes, not {key.len()}")
        }
        return XChaCha20Poly1305 { key: key.copy() }
    }

    /// The plaintext encrypted, with the 16-byte tag of it and `aad` after it, as
    /// `ChaCha20Poly1305.encrypt` seals it. Panics unless the nonce is 24 bytes, or if the
    /// plaintext is over 256 GiB less 64 bytes.
    @track_caller
    pub fn encrypt(self, nonce: List<u8>, plaintext: List<u8>, aad: List<u8> = []) -> List<u8> {
        if nonce.len() != 24 {
            panic("XChaCha20-Poly1305 takes a nonce of 24 bytes, not {nonce.len()}")
        }
        return chacha_seal(self.key, nonce, plaintext, aad)
    }

    /// The plaintext `encrypt` sealed with this key, nonce and `aad`, or `none` if `sealed` isn't
    /// that, or the nonce isn't 24 bytes. The tag is compared in constant time, before anything
    /// is decrypted.
    pub fn decrypt(self, nonce: List<u8>, sealed: List<u8>, aad: List<u8> = []) -> List<u8>? {
        if nonce.len() != 24 {
            return none
        }
        return chacha_open(self.key, nonce, sealed, aad)
    }
}

// The most ChaCha20 encrypts under one nonce: 2^32 - 1 blocks of 64 bytes, block 0 making the
// Poly1305 key.
const CHACHA_MAX: u64 = 274877906880

@track_caller
fn chacha_seal(key: List<u8>, nonce: List<u8>, plaintext: List<u8>, aad: List<u8>) -> List<u8> {
    if u64(plaintext.len()) > CHACHA_MAX {
        panic("ChaCha20-Poly1305 seals up to {CHACHA_MAX} bytes under a nonce, not {plaintext.len()}")
    }
    var out: List<u8> = [0; plaintext.len() + 16]
    unsafe {
        cx_aead_chacha_seal(key.as_ptr(), nonce.as_ptr(), nonce.len(), plaintext.as_ptr(), plaintext.len(), aad.as_ptr(), aad.len(), out.as_mut_ptr())
    }
    return out
}

fn chacha_open(key: List<u8>, nonce: List<u8>, sealed: List<u8>, aad: List<u8>) -> List<u8>? {
    if sealed.len() < 16 or u64(sealed.len() - 16) > CHACHA_MAX {
        return none
    }
    var out: List<u8> = [0; sealed.len() - 16]
    let opened = unsafe { cx_aead_chacha_open(key.as_ptr(), nonce.as_ptr(), nonce.len(), sealed.as_ptr(), sealed.len(), aad.as_ptr(), aad.len(), out.as_mut_ptr()) }
    if not opened {
        return none
    }
    return some(out)
}

/// AES in Galois/Counter Mode, NIST SP 800-38D's authenticated encryption, as Python's
/// `cryptography` `AESGCM` gives it: a key of 16, 24 or 32 bytes, for AES-128, AES-192 or
/// AES-256, a nonce of 12 bytes, and the ciphertext with a 16-byte tag after it. As with
/// `ChaCha20Poly1305`, a nonce must never seal two messages with one key, and here a repeat gives
/// away what forges any message under the key. Random 12-byte nonces are safe for 2^32 messages
/// a key, as NIST counts it.
pub struct AesGcm {
    ctx: List<u8>,
}

impl AesGcm {
    /// A new key of `bits` bits, 128, 192 or 256, from the system's random source, as
    /// `AESGCM.generate_key(bit_length)`. Panics for any other size.
    @track_caller
    pub fn generate_key(bits: u32 = 256) -> List<u8> {
        if bits != 128 and bits != 192 and bits != 256 {
            panic("AES keys are 128, 192 or 256 bits, not {bits}")
        }
        return random_bytes(usize(bits / 8))
    }

    /// The cipher with the key, as `AESGCM(key)`, its round keys and GHASH key worked out once.
    /// Panics unless it's 16, 24 or 32 bytes.
    @track_caller
    pub fn new(key: List<u8>) -> AesGcm {
        if key.len() != 16 and key.len() != 24 and key.len() != 32 {
            panic("AES-GCM takes a key of 16, 24 or 32 bytes, not {key.len()}")
        }
        var ctx: List<u8> = [0; 400]
        unsafe {
            cx_gcm_start(ctx.as_mut_ptr(), key.as_ptr(), key.len())
        }
        return AesGcm { ctx: ctx }
    }

    /// The plaintext encrypted, with the 16-byte tag of it and `aad` after it, as
    /// `encrypt(nonce, plaintext, aad)`; `aad` is as `ChaCha20Poly1305.encrypt` takes it. The
    /// nonce is 12 bytes, as NIST advises, or 8 to 128, as `cryptography` takes them. Panics for
    /// another length, or if the plaintext is over 64 GiB less 32 bytes, as far as GCM's counter
    /// goes.
    @track_caller
    pub fn encrypt(self, nonce: List<u8>, plaintext: List<u8>, aad: List<u8> = []) -> List<u8> {
        if nonce.len() < 8 or nonce.len() > 128 {
            panic("AES-GCM takes a nonce of 12 bytes, or 8 to 128, not {nonce.len()}")
        }
        if u64(plaintext.len()) > GCM_MAX {
            panic("AES-GCM seals up to {GCM_MAX} bytes under a nonce, not {plaintext.len()}")
        }
        var out: List<u8> = [0; plaintext.len() + 16]
        unsafe {
            cx_gcm_seal(self.ctx.as_ptr(), nonce.as_ptr(), nonce.len(), plaintext.as_ptr(), plaintext.len(), aad.as_ptr(), aad.len(), out.as_mut_ptr())
        }
        return out
    }

    /// The plaintext `encrypt` sealed with this key, nonce and `aad`, or `none` if `sealed` isn't
    /// that, as when a byte of it, the nonce or the associated data has changed, or the key is
    /// another, where `cryptography` raises `InvalidTag`. The tag is compared in constant time,
    /// before anything is decrypted. `none` too unless the nonce is 8 to 128 bytes.
    pub fn decrypt(self, nonce: List<u8>, sealed: List<u8>, aad: List<u8> = []) -> List<u8>? {
        if nonce.len() < 8 or nonce.len() > 128 or sealed.len() < 16 or u64(sealed.len() - 16) > GCM_MAX {
            return none
        }
        var out: List<u8> = [0; sealed.len() - 16]
        let opened = unsafe { cx_gcm_open(self.ctx.as_ptr(), nonce.as_ptr(), nonce.len(), sealed.as_ptr(), sealed.len(), aad.as_ptr(), aad.len(), out.as_mut_ptr()) }
        if not opened {
            return none
        }
        return some(out)
    }
}

// The most GCM encrypts under one nonce: 2^32 - 2 blocks of 16 bytes, NIST's 2^39 - 256 bits.
const GCM_MAX: u64 = 68719476704

/// Why a Noise handshake's message couldn't be written or read. After either, the handshake is
/// over: writing, reading or taking its transport panics.
pub enum NoiseError {
    /// The message is too short for what the pattern says comes in it.
    Truncated
    /// The message is over Noise's 65535 bytes.
    TooLong
    /// A key, or the payload, didn't decrypt: the message was changed on the way, or the two
    /// sides have different keys, prologues, pre-shared keys or protocols.
    Decrypt
    /// A Diffie-Hellman gave all zeros, as it does with a public key of small order, which shares
    /// nothing secret with any key. One that comes in a message, or one given to
    /// `set_remote_static`, can be.
    SmallOrder
}

impl NoiseError {
    /// What went wrong, for a message.
    pub fn message(self) -> str {
        return match self {
            NoiseError.Truncated => "the Noise message is too short",
            NoiseError.TooLong => "the Noise message is over 65535 bytes",
            NoiseError.Decrypt => "the Noise message didn't decrypt",
            NoiseError.SmallOrder => "a public key in the Noise handshake is of small order",
        }
    }
}

/// A Noise handshake, as revision 34 of the Noise Protocol Framework makes it and Python's
/// `noiseprotocol` package runs it: the two sides send each other the messages a pattern such as
/// `IK` or `XX` lays out, and each comes out with the other's static key, where the pattern sends
/// it, and a `NoiseTransport` that encrypts what they say after. The protocol's name says which:
/// `Noise_`, the pattern with any `psk` modifiers, `25519`, `ChaChaPoly` or `AESGCM`, and
/// `SHA256`, `SHA512`, `BLAKE2s` or `BLAKE2b`, as `Noise_IK_25519_ChaChaPoly_SHA256`.
pub struct NoiseHandshake {
    name: String,
    is_initiator: bool,
    protocol: NoiseProtocol,
    prologue: List<u8>,
    s: X25519Key?,
    e: X25519Key?,
    rs: X25519PublicKey?,
    re: X25519PublicKey?,
    psks: List<List<u8>>,
    psk_next: usize,
    started: bool,
    failed: bool,
    next: usize,
    symmetric: NoiseSymmetric,
}

impl NoiseHandshake {
    /// The initiator's side of the handshake the protocol's name gives, as `noiseprotocol`'s
    /// `NoiseConnection.from_name(name)` then `set_as_initiator()`. Give it the keys and anything
    /// else the pattern needs before its first message. Panics for a name `supports` says no to.
    @track_caller
    pub fn initiator(name: String) -> NoiseHandshake {
        return NoiseHandshake.new(name, true)
    }

    /// The responder's side, as `set_as_responder()`.
    @track_caller
    pub fn responder(name: String) -> NoiseHandshake {
        return NoiseHandshake.new(name, false)
    }

    /// Whether there's a handshake for the protocol's name: one of Noise's 38 patterns, the
    /// fundamental and the deferred ones, with any `psk` modifiers, as `XXpsk3` or `NNpsk0+psk2`,
    /// over `25519` with either cipher and any of the four hashes.
    pub fn supports(name: String) -> bool {
        return noise_protocol(name) != none
    }

    @track_caller
    fn new(name: String, initiator: bool) -> NoiseHandshake {
        let protocol = noise_protocol(name) else panic("std.crypto has no Noise protocol `{name}`")
        let symmetric = NoiseSymmetric.new(name, protocol.hash, protocol.cipher)
        return NoiseHandshake {
            name: name.copy(),
            is_initiator: initiator,
            protocol: protocol,
            prologue: [],
            s: none,
            e: none,
            rs: none,
            re: none,
            psks: [],
            psk_next: 0,
            started: false,
            failed: false,
            next: 0,
            symmetric: symmetric,
        }
    }

    /// Sets the prologue: bytes both sides must give the same of, though neither sends them, such
    /// as a version, or the messages that chose this protocol. A handshake whose sides give
    /// different ones fails at its first encrypted payload. Empty unless set.
    @track_caller
    pub fn set_prologue(mut self, prologue: List<u8>) {
        self.check_unstarted("set_prologue")
        self.prologue = prologue.copy()
    }

    /// Sets this side's static key, its long-term identity, which a pattern with an `s` of this
    /// side's sends, or has the other side know beforehand.
    @track_caller
    pub fn set_static(mut self, key: X25519Key) {
        self.check_unstarted("set_static")
        self.s = some(key.copy())
    }

    /// Sets the other side's static key, known beforehand, as `IK`'s and `NK`'s initiator knows
    /// the responder's, from a QR code, say, and `KK`'s responder knows the initiator's.
    @track_caller
    pub fn set_remote_static(mut self, key: X25519PublicKey) {
        self.check_unstarted("set_remote_static")
        self.rs = some(key.copy())
    }

    /// Sets this side's ephemeral key, which the handshake otherwise makes new from the system's
    /// random source, as it must for the handshake to keep its secrets. For tests against fixed
    /// vectors alone.
    @track_caller
    pub fn set_ephemeral(mut self, key: X25519Key) {
        self.check_unstarted("set_ephemeral")
        self.e = some(key.copy())
    }

    /// Sets the pre-shared keys, 32 bytes each, one for each `psk` modifier of the protocol, in
    /// the order the handshake mixes them in, as `noiseprotocol`'s `set_psks(psks=...)`. Panics
    /// for a key of another length.
    @track_caller
    pub fn set_psks(mut self, psks: List<List<u8>>) {
        self.check_unstarted("set_psks")
        for psk in psks {
            if psk.len() != 32 {
                panic("a Noise pre-shared key is 32 bytes, not {psk.len()}")
            }
        }
        self.psks = psks.copy()
    }

    /// Whether every message of the pattern has been written or read, so `transport` can be had,
    /// as `handshake_finished` says.
    pub fn is_finished(self) -> bool {
        return self.next == self.protocol.messages.len()
    }

    /// Whether this side writes the next message, and the other side reads it.
    pub fn is_my_turn(self) -> bool {
        return not self.is_finished() and (self.next % 2 == 0) == self.is_initiator
    }

    /// The handshake's hash so far, h, which is the same on both sides once it's finished, as
    /// `get_handshake_hash()` gives it: what's said later can be tied to this handshake by
    /// signing it, say.
    pub fn handshake_hash(self) -> List<u8> {
        return self.symmetric.h.copy()
    }

    /// The other side's static key, once it's been set or read from a message.
    pub fn remote_static(self) -> X25519PublicKey? {
        return self.rs.copy()
    }

    /// The next message of the pattern, its keys and then the payload, which is encrypted once
    /// the two sides have a key, as `write_message(payload)`. Fails with `SmallOrder` where a
    /// Diffie-Hellman with the other side's key gives all zeros. Panics if it isn't this side's
    /// turn, if a key the pattern needs wasn't set, or if the message would be over 65535 bytes.
    @track_caller
    pub fn write_message(mut self, payload: List<u8> = []) -> List<u8> ! NoiseError {
        self.start()
        if not self.is_my_turn() {
            panic(if self.is_finished() { "the Noise handshake is finished; write with its transport" } else { "it's the other side's turn to write" })
        }
        var out = List<u8>()
        for token in self.protocol.messages[self.next].copy() {
            if token == NoiseToken.E {
                if self.e == none {
                    self.e = some(X25519Key.generate())
                }
                let public = self.e.copy()!.public
                out.extend(public)
                self.symmetric.mix_hash(public)
                if self.protocol.psks > 0 {
                    self.symmetric.mix_key(public)
                }
            } else if token == NoiseToken.S {
                out.extend(self.symmetric.encrypt_and_hash(self.s.copy()!.public))
            } else if token == NoiseToken.Psk {
                self.mix_psk()
            } else if not self.mix_dh(token) {
                self.failed = true
                fail NoiseError.SmallOrder
            }
        }
        out.extend(self.symmetric.encrypt_and_hash(payload))
        if out.len() > NOISE_MAX {
            panic("a Noise message is up to {NOISE_MAX} bytes, and this one would be {out.len()}")
        }
        self.next += 1
        return out
    }

    /// The payload of the other side's next message, with the keys in it taken and checked, as
    /// `read_message(message)`. Fails if the message is too short or too long, doesn't decrypt,
    /// or makes a Diffie-Hellman give all zeros, and then the handshake can't go on. Panics if
    /// it's this side's turn to write, or if a key the pattern needs wasn't set.
    @track_caller
    pub fn read_message(mut self, message: List<u8>) -> List<u8> ! NoiseError {
        self.start()
        if self.is_finished() or self.is_my_turn() {
            panic(if self.is_finished() { "the Noise handshake is finished; read with its transport" } else { "it's this side's turn to write" })
        }
        if message.len() > NOISE_MAX {
            self.failed = true
            fail NoiseError.TooLong
        }
        var at: usize = 0
        for token in self.protocol.messages[self.next].copy() {
            if token == NoiseToken.E {
                if message.len() - at < 32 {
                    self.failed = true
                    fail NoiseError.Truncated
                }
                let public = message[at..at + 32]
                at += 32
                self.symmetric.mix_hash(public)
                if self.protocol.psks > 0 {
                    self.symmetric.mix_key(public)
                }
                self.re = some(X25519PublicKey { encoded: public })
            } else if token == NoiseToken.S {
                let len: usize = if self.symmetric.cipher.has_key() { 48 } else { 32 }
                if message.len() - at < len {
                    self.failed = true
                    fail NoiseError.Truncated
                }
                let sealed = message[at..at + len]
                at += len
                let public = self.symmetric.decrypt_and_hash(sealed) else {
                    self.failed = true
                    fail NoiseError.Decrypt
                }
                self.rs = some(X25519PublicKey { encoded: public })
            } else if token == NoiseToken.Psk {
                self.mix_psk()
            } else if not self.mix_dh(token) {
                self.failed = true
                fail NoiseError.SmallOrder
            }
        }
        if self.symmetric.cipher.has_key() and message.len() - at < 16 {
            self.failed = true
            fail NoiseError.Truncated
        }
        let payload = self.symmetric.decrypt_and_hash(message[at..]) else {
            self.failed = true
            fail NoiseError.Decrypt
        }
        self.next += 1
        return payload
    }

    /// The transport the finished handshake gives, a key and a nonce for each direction, which
    /// `noiseprotocol`'s connection switches to once `handshake_finished` is true. Panics unless
    /// it's finished.
    @track_caller
    pub fn transport(own self) -> NoiseTransport {
        if self.failed {
            panic("the Noise handshake failed, so it has no transport")
        }
        if not self.is_finished() {
            panic("the Noise handshake isn't finished: it has {self.protocol.messages.len() - self.next} more messages")
        }
        let (first, second) = self.symmetric.split()
        // A one-way pattern's initiator only writes, and its responder only reads.
        let one_way = self.protocol.messages.len() == 1
        if self.is_initiator {
            return NoiseTransport { send: first, receive: second, sends: true, receives: not one_way, hash: self.symmetric.h, remote: self.rs }
        }
        return NoiseTransport { send: second, receive: first, sends: not one_way, receives: true, hash: self.symmetric.h, remote: self.rs }
    }

    @track_caller
    fn check_unstarted(self, what: str) {
        if self.started {
            panic("`{what}` is for before the Noise handshake's first message")
        }
    }

    // What comes before the first message: once the keys the pattern needs are checked, the
    // prologue, and the static keys its pre-messages say each side knows of the other's, are
    // hashed in after the protocol's name.
    @track_caller
    fn start(mut self) {
        if self.failed {
            panic("the Noise handshake failed, and can't go on")
        }
        if self.started {
            return
        }
        let side = if self.is_initiator { "initiator" } else { "responder" }
        var sends_s = if self.is_initiator { self.protocol.initiator_known } else { self.protocol.responder_known }
        for i in 0..self.protocol.messages.len() {
            if (i % 2 == 0) == self.is_initiator and self.protocol.messages[i].contains(NoiseToken.S) {
                sends_s = true
            }
        }
        if sends_s and self.s == none {
            panic("{self.name}'s {side} needs its static key: give it with `set_static`")
        }
        let knows_rs = if self.is_initiator { self.protocol.responder_known } else { self.protocol.initiator_known }
        if knows_rs and self.rs == none {
            panic("{self.name}'s {side} needs the other side's static key: give it with `set_remote_static`")
        }
        if self.psks.len() != self.protocol.psks {
            panic("{self.name} takes {self.protocol.psks} pre-shared keys, not {self.psks.len()}: give them with `set_psks`")
        }
        self.started = true
        self.symmetric.mix_hash(self.prologue)
        if self.protocol.initiator_known {
            let public = if self.is_initiator { self.s.copy()!.public } else { self.rs.copy()!.encoded }
            self.symmetric.mix_hash(public)
        }
        if self.protocol.responder_known {
            let public = if self.is_initiator { self.rs.copy()!.encoded } else { self.s.copy()!.public }
            self.symmetric.mix_hash(public)
        }
    }

    // The next pre-shared key, mixed into the key and the hash.
    fn mix_psk(mut self) {
        let psk = self.psks[self.psk_next].copy()
        self.psk_next += 1
        self.symmetric.mix_key_and_hash(psk)
    }

    // The Diffie-Hellman `ee`, `es`, `se` or `ss` names, the initiator's key with the responder's,
    // mixed into the key, or false if it gave all zeros. The pattern has sent or set each key it
    // takes by then.
    fn mix_dh(mut self, token: NoiseToken) -> bool {
        let initiator_e = token == NoiseToken.Ee or token == NoiseToken.Es
        let responder_e = token == NoiseToken.Ee or token == NoiseToken.Se
        let mine_e = if self.is_initiator { initiator_e } else { responder_e }
        let theirs_e = if self.is_initiator { responder_e } else { initiator_e }
        let key = if mine_e { self.e.copy()! } else { self.s.copy()! }
        let peer = if theirs_e { self.re.copy()! } else { self.rs.copy()! }
        let shared = key.exchange(peer) else return false
        self.symmetric.mix_key(shared)
        return true
    }
}

/// What a finished Noise handshake gives: a key and a nonce for each direction, as
/// `noiseprotocol`'s `encrypt` and `decrypt` use them once the handshake is done. A message's
/// nonce is its place in the stream, so messages must be decrypted in the order they were
/// encrypted, as over TCP or a WebSocket, and each is up to 65535 bytes, its 16-byte tag among
/// them.
pub struct NoiseTransport {
    send: NoiseCipherState,
    receive: NoiseCipherState,
    sends: bool,
    receives: bool,
    hash: List<u8>,
    remote: X25519PublicKey?,
}

impl NoiseTransport {
    /// The plaintext encrypted for the other side, 16 bytes longer, as `encrypt(data)`. Panics
    /// for a plaintext over 65519 bytes, which a program splits into messages of its own, and on
    /// a one-way pattern's responder, which only reads.
    @track_caller
    pub fn encrypt(mut self, plaintext: List<u8>) -> List<u8> {
        if not self.sends {
            panic("a one-way Noise pattern's responder only reads")
        }
        if plaintext.len() > NOISE_MAX - 16 {
            panic("a Noise message holds up to {NOISE_MAX - 16} bytes of plaintext, not {plaintext.len()}")
        }
        return self.send.encrypt([], plaintext)
    }

    /// The plaintext of the other side's next message, as `decrypt(data)`, or `none` if it doesn't
    /// decrypt, where `noiseprotocol` raises: it was changed on the way, or isn't the next one,
    /// or isn't from this handshake. The nonce then stays as it was, so a connection that goes on
    /// is still in step. Panics on a one-way pattern's initiator, which only writes.
    @track_caller
    pub fn decrypt(mut self, message: List<u8>) -> List<u8>? {
        if not self.receives {
            panic("a one-way Noise pattern's initiator only writes")
        }
        if message.len() > NOISE_MAX {
            return none
        }
        return self.receive.decrypt([], message)
    }

    /// Changes the key this side encrypts with to one worked out from it, as
    /// `rekey_outbound_cipher()` does, so a key that leaks later doesn't open what was sent
    /// before. The other side calls `rekey_inbound` at the same place in the stream, as the two
    /// agree: every so many messages, say. The nonce goes on from where it was.
    pub fn rekey_outbound(mut self) {
        self.send.rekey()
    }

    /// Changes the key this side decrypts with, as the other side's `rekey_outbound` changes its,
    /// as `rekey_inbound_cipher()` does.
    pub fn rekey_inbound(mut self) {
        self.receive.rekey()
    }

    /// The handshake's hash, the same on both sides, as `NoiseHandshake.handshake_hash` gave it
    /// at the end.
    pub fn handshake_hash(self) -> List<u8> {
        return self.hash.copy()
    }

    /// The other side's static key, if the handshake had one.
    pub fn remote_static(self) -> X25519PublicKey? {
        return self.remote.copy()
    }
}

// The longest Noise message, and the nonce no message is sealed with, which REKEY uses.
const NOISE_MAX: usize = 65535
const NOISE_NONCE_MAX: u64 = 18446744073709551615

// Noise's ciphers and hashes, as a protocol's name gives them.
enum NoiseCipher {
    ChaChaPoly
    AesGcm
}

enum NoiseHash {
    Sha256
    Sha512
    Blake2s
    Blake2b
}

// A token of a message pattern.
enum NoiseToken {
    E
    S
    Ee
    Es
    Se
    Ss
    Psk
}

// Noise's handshake patterns, from revision 34 of the spec: section 7.2's one-way patterns, 7.5's
// interactive ones and 7.6's deferred ones. Each is its name, whether the initiator's static key
// is known to the responder before the first message, whether the responder's is to the
// initiator, then its messages, the initiator's first and each side in turn, with `|` between
// them.
const NOISE_PATTERNS: [(str, bool, bool, str); 38] = [
    ("N", false, true, "e es"),
    ("K", true, true, "e es ss"),
    ("X", false, true, "e es s ss"),
    ("NN", false, false, "e|e ee"),
    ("NK", false, true, "e es|e ee"),
    ("NX", false, false, "e|e ee s es"),
    ("KN", true, false, "e|e ee se"),
    ("KK", true, true, "e es ss|e ee se"),
    ("KX", true, false, "e|e ee se s es"),
    ("XN", false, false, "e|e ee|s se"),
    ("XK", false, true, "e es|e ee|s se"),
    ("XX", false, false, "e|e ee s es|s se"),
    ("IN", false, false, "e s|e ee se"),
    ("IK", false, true, "e es s ss|e ee se"),
    ("IX", false, false, "e s|e ee se s es"),
    ("NK1", false, true, "e|e ee es"),
    ("NX1", false, false, "e|e ee s|es"),
    ("X1N", false, false, "e|e ee|s|se"),
    ("X1K", false, true, "e es|e ee|s|se"),
    ("XK1", false, true, "e|e ee es|s se"),
    ("X1K1", false, true, "e|e ee es|s|se"),
    ("X1X", false, false, "e|e ee s es|s|se"),
    ("XX1", false, false, "e|e ee s|es s se"),
    ("X1X1", false, false, "e|e ee s|es s|se"),
    ("K1N", true, false, "e|e ee|se"),
    ("K1K", true, true, "e es|e ee|se"),
    ("KK1", true, true, "e|e ee se es"),
    ("K1K1", true, true, "e|e ee es|se"),
    ("K1X", true, false, "e|e ee s es|se"),
    ("KX1", true, false, "e|e ee se s|es"),
    ("K1X1", true, false, "e|e ee s|se es"),
    ("I1N", false, false, "e s|e ee|se"),
    ("I1K", false, true, "e es s|e ee|se"),
    ("IK1", false, true, "e s|e ee se es"),
    ("I1K1", false, true, "e s|e ee es|se"),
    ("I1X", false, false, "e s|e ee s es|se"),
    ("IX1", false, false, "e s|e ee se s|es"),
    ("I1X1", false, false, "e s|e ee s|se es"),
]

// A protocol, from its name.
struct NoiseProtocol {
    hash: NoiseHash,
    cipher: NoiseCipher,
    initiator_known: bool,
    responder_known: bool,
    messages: List<List<NoiseToken>>,
    psks: usize,
}

// The protocol a name gives, as `Noise_XXpsk3_25519_ChaChaPoly_SHA256`, or none. `pskN` puts a
// `psk` token at the start of the first message for 0, or at the end of message N.
fn noise_protocol(name: String) -> NoiseProtocol? {
    let parts = name.split("_")
    if parts.len() != 5 or parts[0] != "Noise" or parts[2] != "25519" {
        return none
    }
    var cipher = NoiseCipher.ChaChaPoly
    if parts[3] == "AESGCM" {
        cipher = NoiseCipher.AesGcm
    } else if parts[3] != "ChaChaPoly" {
        return none
    }
    var hash = NoiseHash.Sha256
    if parts[4] == "SHA512" {
        hash = NoiseHash.Sha512
    } else if parts[4] == "BLAKE2s" {
        hash = NoiseHash.Blake2s
    } else if parts[4] == "BLAKE2b" {
        hash = NoiseHash.Blake2b
    } else if parts[4] != "SHA256" {
        return none
    }
    var base = parts[1].copy()
    var modifiers = List<String>()
    if let at = parts[1].find("psk") {
        base = parts[1][..at]
        modifiers = parts[1][at..].split("+")
    }
    for pattern in NOISE_PATTERNS {
        if pattern.0 != base {
            continue
        }
        var messages = List<List<NoiseToken>>()
        for text in pattern.3.split("|") {
            var tokens = List<NoiseToken>()
            for token in text.split(" ") {
                tokens.push(noise_token(token))
            }
            messages.push(tokens)
        }
        // Each modifier once, in order, as the spec names them.
        var last: usize? = none
        for modifier in modifiers {
            var place: usize? = none
            for k in 0..messages.len() + 1 {
                if modifier == "psk{k}" and (last == none or k > last!) {
                    place = some(k)
                }
            }
            let k = place else return none
            if k == 0 {
                messages[0].insert(0, NoiseToken.Psk)
            } else {
                messages[k - 1].push(NoiseToken.Psk)
            }
            last = some(k)
        }
        return some(NoiseProtocol {
            hash: hash,
            cipher: cipher,
            initiator_known: pattern.1,
            responder_known: pattern.2,
            messages: messages,
            psks: modifiers.len(),
        })
    }
    return none
}

fn noise_token(text: String) -> NoiseToken {
    if text == "e" {
        return NoiseToken.E
    } else if text == "s" {
        return NoiseToken.S
    } else if text == "ee" {
        return NoiseToken.Ee
    } else if text == "es" {
        return NoiseToken.Es
    } else if text == "se" {
        return NoiseToken.Se
    } else if text == "ss" {
        return NoiseToken.Ss
    }
    panic("not a Noise token: {text}")
}

fn noise_hash_len(hash: NoiseHash) -> usize {
    return match hash {
        NoiseHash.Sha256 => 32,
        NoiseHash.Sha512 => 64,
        NoiseHash.Blake2s => 32,
        NoiseHash.Blake2b => 64,
    }
}

// HASH(data), and the block length HMAC pads its key to.
fn noise_hash(hash: NoiseHash, data: List<u8>) -> List<u8> {
    return match hash {
        NoiseHash.Sha256 => sha256(data),
        NoiseHash.Sha512 => sha512(data),
        NoiseHash.Blake2s => blake2s(data),
        NoiseHash.Blake2b => blake2b(data),
    }
}

fn noise_block_len(hash: NoiseHash) -> usize {
    return match hash {
        NoiseHash.Sha256 => 64,
        NoiseHash.Sha512 => 128,
        NoiseHash.Blake2s => 64,
        NoiseHash.Blake2b => 128,
    }
}

// RFC 2104's HMAC with the hash, which Noise uses with BLAKE2 too, rather than BLAKE2's own key.
fn noise_hmac(hash: NoiseHash, key: List<u8>, data: List<u8>) -> List<u8> {
    let block = noise_block_len(hash)
    var k = if key.len() > block { noise_hash(hash, key) } else { key.copy() }
    while k.len() < block {
        k.push(0)
    }
    var inner = List<u8>()
    var outer = List<u8>()
    for b in k {
        inner.push(b ^ 0x36)
        outer.push(b ^ 0x5C)
    }
    inner.extend(data)
    outer.extend(noise_hash(hash, inner))
    return noise_hash(hash, outer)
}

// HKDF(ck, ikm, n), for n of 2 or 3, the third empty for 2.
fn noise_hkdf(hash: NoiseHash, ck: List<u8>, ikm: List<u8>, n: usize) -> (List<u8>, List<u8>, List<u8>) {
    let temp = noise_hmac(hash, ck, ikm)
    let first = noise_hmac(hash, temp, [1])
    var then = first.copy()
    then.push(2)
    let second = noise_hmac(hash, temp, then)
    if n == 2 {
        return (first, second, [])
    }
    var last = second.copy()
    last.push(3)
    let third = noise_hmac(hash, temp, last)
    return (first, second, third)
}

// A SymmetricState of the spec: the chaining key, the hash of everything so far, and the cipher
// they key.
struct NoiseSymmetric {
    hash: NoiseHash,
    ck: List<u8>,
    h: List<u8>,
    cipher: NoiseCipherState,
}

impl NoiseSymmetric {
    // The name, padded with zeros to the hash's length, or hashed if it's longer, is both h and ck.
    fn new(name: String, hash: NoiseHash, cipher: NoiseCipher) -> NoiseSymmetric {
        var h = name.to_bytes()
        if h.len() > noise_hash_len(hash) {
            h = noise_hash(hash, h)
        }
        while h.len() < noise_hash_len(hash) {
            h.push(0)
        }
        return NoiseSymmetric { hash: hash, ck: h.copy(), h: h, cipher: NoiseCipherState.new(cipher) }
    }

    fn mix_hash(mut self, data: List<u8>) {
        var all = self.h.copy()
        all.extend(data)
        self.h = noise_hash(self.hash, all)
    }

    fn mix_key(mut self, ikm: List<u8>) {
        let (ck, key, _) = noise_hkdf(self.hash, self.ck, ikm, 2)
        self.ck = ck
        self.cipher.set_key(key)
    }

    fn mix_key_and_hash(mut self, ikm: List<u8>) {
        let (ck, temp, key) = noise_hkdf(self.hash, self.ck, ikm, 3)
        self.ck = ck
        self.mix_hash(temp)
        self.cipher.set_key(key)
    }

    @track_caller
    fn encrypt_and_hash(mut self, plaintext: List<u8>) -> List<u8> {
        let sealed = self.cipher.encrypt(self.h, plaintext)
        self.mix_hash(sealed)
        return sealed
    }

    fn decrypt_and_hash(mut self, sealed: List<u8>) -> List<u8>? {
        let plaintext = self.cipher.decrypt(self.h, sealed) else return none
        self.mix_hash(sealed)
        return some(plaintext)
    }

    // The two transport ciphers: the initiator's to the responder, then the responder's back.
    fn split(self) -> (NoiseCipherState, NoiseCipherState) {
        let (one, two, _) = noise_hkdf(self.hash, self.ck, [], 2)
        var first = NoiseCipherState.new(self.cipher.cipher)
        first.set_key(one)
        var second = NoiseCipherState.new(self.cipher.cipher)
        second.set_key(two)
        return (first, second)
    }
}

// A CipherState of the spec: a key, or none yet, and the nonce of the next message under it.
struct NoiseCipherState {
    cipher: NoiseCipher,
    key: List<u8>,
    gcm: AesGcm?,
    nonce: u64,
}

impl NoiseCipherState {
    fn new(cipher: NoiseCipher) -> NoiseCipherState {
        return NoiseCipherState { cipher: cipher, key: [], gcm: none, nonce: 0 }
    }

    fn has_key(self) -> bool {
        return not self.key.is_empty()
    }

    // Keys it with the first 32 bytes of `key`, from nonce 0.
    fn set_key(mut self, key: List<u8>) {
        self.key = key[..32]
        self.nonce = 0
        if self.cipher == NoiseCipher.AesGcm {
            self.gcm = some(AesGcm.new(self.key.copy()))
        }
    }

    // ENCRYPT(k, n, ad, plaintext) and DECRYPT: the nonce is 4 zero bytes, then the counter,
    // little-endian for ChaChaPoly and big-endian for AESGCM.
    fn seal(self, n: u64, ad: List<u8>, plaintext: List<u8>) -> List<u8> {
        let nonce = noise_nonce(self.cipher, n)
        if let gcm = self.gcm {
            return gcm.encrypt(nonce, plaintext, ad)
        }
        return chacha_seal(self.key, nonce, plaintext, ad)
    }

    fn open(self, n: u64, ad: List<u8>, sealed: List<u8>) -> List<u8>? {
        let nonce = noise_nonce(self.cipher, n)
        if let gcm = self.gcm {
            return gcm.decrypt(nonce, sealed, ad)
        }
        return chacha_open(self.key, nonce, sealed, ad)
    }

    // EncryptWithAd: the plaintext as it is until there's a key.
    @track_caller
    fn encrypt(mut self, ad: List<u8>, plaintext: List<u8>) -> List<u8> {
        if not self.has_key() {
            return plaintext.copy()
        }
        if self.nonce == NOISE_NONCE_MAX {
            panic("this Noise key has sealed as many messages as it can, 2^64 - 1")
        }
        let sealed = self.seal(self.nonce, ad, plaintext)
        self.nonce += 1
        return sealed
    }

    // DecryptWithAd, which leaves the nonce as it was when the tag doesn't match.
    fn decrypt(mut self, ad: List<u8>, sealed: List<u8>) -> List<u8>? {
        if not self.has_key() {
            return some(sealed.copy())
        }
        if self.nonce == NOISE_NONCE_MAX {
            return none
        }
        let plaintext = self.open(self.nonce, ad, sealed) else return none
        self.nonce += 1
        return some(plaintext)
    }

    // REKEY: the key becomes the first 32 bytes of 32 zeros sealed under nonce 2^64 - 1, and the
    // nonce goes on.
    fn rekey(mut self) {
        let nonce = self.nonce
        let key = self.seal(NOISE_NONCE_MAX, [], [0; 32])
        self.set_key(key)
        self.nonce = nonce
    }
}

fn noise_nonce(cipher: NoiseCipher, n: u64) -> List<u8> {
    var out: List<u8> = [0; 12]
    var rest = n
    for i in 0..8usize {
        let at = if cipher == NoiseCipher.ChaChaPoly { 4 + i } else { 11 - i }
        out[at] = u8.wrap(rest)
        rest >>= 8
    }
    return out
}

// What PKCS#1 v1.5 signs, EMSA-PKCS1-v1_5: 0, 1, 0xFF bytes, 0, then the digest's DigestInfo, the
// hash's identifier and the digest, `size` bytes in all; `none` if that's too long for the key.
fn pkcs1_digest(hash: Algorithm, message: List<u8>, size: usize) -> List<u8>? {
    let prefix: List<u8> = match hash {
        Algorithm.Md5 => [0x30, 0x20, 0x30, 0x0C, 0x06, 0x08, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x02, 0x05, 0x05, 0x00, 0x04, 0x10],
        Algorithm.Sha1 => [0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2B, 0x0E, 0x03, 0x02, 0x1A, 0x05, 0x00, 0x04, 0x14],
        Algorithm.Sha256 => [0x30, 0x31, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20],
        Algorithm.Sha384 => [0x30, 0x41, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30],
        Algorithm.Sha512 => [0x30, 0x51, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40],
    }
    var d = Digest.new(hash)
    d.add(message)
    let digest = d.finish()
    let info = prefix.len() + digest.len()
    if size < info + 11 {
        return none
    }
    var out: List<u8> = [0xFF; size]
    out[0] = 0
    out[1] = 1
    out[size - info - 1] = 0
    for i in 0..prefix.len() {
        out[size - info + i] = prefix[i]
    }
    for i in 0..digest.len() {
        out[size - digest.len() + i] = digest[i]
    }
    return some(out)
}

// Whether `a` is less than `b`, both big-endian and the same length.
fn below(a: List<u8>, b: List<u8>) -> bool {
    for i in 0..a.len() {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
    }
    return false
}

// A reader of DER that takes only its shortest forms.
struct Der {
    bytes: List<u8>,
    at: usize,
}

impl Der {
    fn byte(mut self) -> u8? {
        if self.at >= self.bytes.len() {
            return none
        }
        self.at += 1
        return some(self.bytes[self.at - 1])
    }

    fn next_are(mut self, want: List<u8>) -> bool {
        for b in want {
            if self.byte() != some(b) {
                return false
            }
        }
        return true
    }

    // The tag, which must be `tag`, and the length after it; gives where the value ends.
    fn enter(mut self, tag: u8) -> usize? {
        if self.byte() != some(tag) {
            return none
        }
        let first = self.byte() else return none
        var length: usize = 0
        if first < 0x80 {
            length = usize(first)
        } else {
            let count = first & 0x7F
            if count == 0 or count > 2 {
                return none
            }
            for _ in 0..count {
                let b = self.byte() else return none
                length = length * 256 + usize(b)
            }
            // The short form, or fewer bytes, would have done.
            if length < 0x80 or (count == 2 and length < 0x100) {
                return none
            }
        }
        if length > self.bytes.len() - self.at {
            return none
        }
        return some(self.at + length)
    }

    // A positive INTEGER, as its bytes without the 0 that keeps its top bit clear.
    fn integer(mut self) -> List<u8>? {
        let end = self.enter(0x02) else return none
        if end == self.at {
            return none
        }
        var start = self.at
        if self.bytes[start] & 0x80 != 0 {
            return none
        }
        if self.bytes[start] == 0 {
            // A 0 is only there to clear the top bit of the byte after it.
            if end - start == 1 or self.bytes[start + 1] & 0x80 == 0 {
                return none
            }
            start += 1
        }
        var out = List<u8>()
        for i in start..end {
            out.push(self.bytes[i])
        }
        self.at = end
        return some(out)
    }
}
