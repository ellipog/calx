/// Random bytes, AES-128 in CFB8 mode, and RSA with PKCS#1 v1.5 padding and signatures (D118).
///
/// They're what vanilla's online-mode login uses. The server makes an RSA key pair and sends the
/// public key. The client encrypts a random shared secret with it, and the server decrypts it.
/// From then on both sides encrypt everything with AES-CFB8, using the secret as key and IV. Each
/// gives what Java's `SecureRandom`, `Cipher` and `KeyPairGenerator` give, for the same inputs.
/// Signatures are what signed chat uses: a player's key, which Mojang's key signs, signs each of
/// their messages, and each is checked as Java's `Signature` checks `SHA256withRSA`.
module std.crypto

import std.hash.{Algorithm, Digest}

extern "C" {
    fn cx_crypto_random(p: *u8, n: usize)
    fn cx_cfb8_start(ctx: *u8, key: *const u8, iv: *const u8)
    fn cx_cfb8_encrypt(ctx: *u8, p: *u8, n: usize)
    fn cx_cfb8_decrypt(ctx: *u8, p: *u8, n: usize)
    fn cx_rsa_generate(ctx: *u8, bits: u32) -> bool
    fn cx_rsa_public_der(ctx: *const u8, out: *u8) -> usize
    fn cx_rsa_encrypt(ctx: *const u8, msg: *const u8, len: usize, out: *u8) -> bool
    fn cx_rsa_decrypt(ctx: *const u8, bytes: *const u8, len: usize, out: *u8) -> i64
    fn cx_rsa_size(ctx: *const u8) -> usize
    fn cx_rsa_private_op(ctx: *const u8, bytes: *const u8, len: usize, out: *u8) -> bool
    fn cx_rsa_public_setup(ctx: *u8, modulus: *const u8, len: usize, exponent: *const u8, elen: usize) -> bool
    fn cx_rsa_public_op(ctx: *const u8, bytes: *const u8, out: *u8) -> bool
}

/// `n` random bytes from the system's generator, which is good for keys, secrets and tokens.
pub fn random_bytes(n: usize) -> List<u8> {
    var out: List<u8> = [0; n]
    unsafe {
        cx_crypto_random(out.as_mut_ptr(), n)
    }
    return out
}

/// AES-128 in CFB8 mode, as Java's "AES/CFB8/NoPadding" is. A stream cipher: each byte encrypts
/// to one byte, and how a stream is split into calls doesn't change it. Vanilla keeps one for
/// each direction of a connection, both made from the shared secret.
pub struct Cfb8 {
    ctx: List<u8>,
}

impl Cfb8 {
    /// A cipher with the key and the IV, 16 bytes each. Panics if either is another length.
    @track_caller
    pub fn new(key: List<u8>, iv: List<u8>) -> Cfb8 {
        if key.len() != 16 or iv.len() != 16 {
            panic("AES-128 takes a key and an IV of 16 bytes, not {key.len()} and {iv.len()}")
        }
        var ctx: List<u8> = [0; 208]
        unsafe {
            cx_cfb8_start(ctx.as_mut_ptr(), key.as_ptr(), iv.as_ptr())
        }
        return Cfb8 { ctx: ctx }
    }

    /// Encrypts the bytes where they are, carrying on from the last call.
    pub fn encrypt(mut self, bytes: mut List<u8>) {
        unsafe {
            cx_cfb8_encrypt(self.ctx.as_mut_ptr(), bytes.as_mut_ptr(), bytes.len())
        }
    }

    /// Decrypts the bytes where they are, carrying on from the last call. It goes 16 bytes at a
    /// time with AES-NI, so it's several times as fast as encrypting.
    pub fn decrypt(mut self, bytes: mut List<u8>) {
        unsafe {
            cx_cfb8_decrypt(self.ctx.as_mut_ptr(), bytes.as_mut_ptr(), bytes.len())
        }
    }
}

/// An RSA key pair, with 65537 as the public exponent, as Java's `KeyPairGenerator` makes.
pub struct RsaKey {
    ctx: List<u8>,
}

impl RsaKey {
    /// A new key pair with a modulus of `bits` bits, 1024 or 2048. Vanilla uses 1024. Panics for
    /// any other size.
    @track_caller
    pub fn generate(bits: u32) -> RsaKey {
        var ctx: List<u8> = [0; 912]
        let made = unsafe { cx_rsa_generate(ctx.as_mut_ptr(), bits) }
        if not made {
            panic("RSA keys are 1024 or 2048 bits, not {bits}")
        }
        return RsaKey { ctx: ctx }
    }

    /// The public key as Java's `PublicKey.getEncoded()` gives it, an X.509 SubjectPublicKeyInfo
    /// in DER, which is what vanilla's encryption request sends: 162 bytes for 1024 bits.
    pub fn public_der(self) -> List<u8> {
        var out: List<u8> = [0; 300]
        unsafe {
            let n = cx_rsa_public_der(self.ctx.as_ptr(), out.as_mut_ptr())
            out.truncate(n)
        }
        return out
    }

    /// The message encrypted with the public key and random padding, as Java's
    /// "RSA/ECB/PKCS1Padding" does: the key's length in bytes. `none` if the message is longer
    /// than that less 11.
    pub fn encrypt(self, message: List<u8>) -> List<u8>? {
        var out: List<u8> = [0; 256]
        unsafe {
            if not cx_rsa_encrypt(self.ctx.as_ptr(), message.as_ptr(), message.len(), out.as_mut_ptr()) {
                return none
            }
        }
        out.truncate(self.size())
        return some(out)
    }

    /// The message that `encrypt`, or a client with the public key, encrypted. `none` if the bytes
    /// aren't the key's length or the padding inside them is wrong. What's wrong isn't told, and
    /// it takes the same time either way, so a client can't learn about the key from it.
    pub fn decrypt(self, bytes: List<u8>) -> List<u8>? {
        var out: List<u8> = [0; 256]
        unsafe {
            let n = cx_rsa_decrypt(self.ctx.as_ptr(), bytes.as_ptr(), bytes.len(), out.as_mut_ptr())
            if n < 0 {
                return none
            }
            out.truncate(usize.wrap(n))
        }
        return some(out)
    }

    /// The modulus's length in bytes, which is what `encrypt` gives and `decrypt` takes: 128 for
    /// 1024 bits.
    pub fn size(self) -> usize {
        return unsafe { cx_rsa_size(self.ctx.as_ptr()) }
    }

    /// The public key, which `verify`s what this key signs.
    pub fn public_key(self) -> RsaPublicKey {
        return RsaPublicKey.from_der(self.public_der()) ?? panic("a key pair's own public key reads")
    }

    /// The signature of `message` with the `hash` of it, as Java's `Signature` signs with
    /// "SHA256withRSA" for `Sha256`: PKCS#1 v1.5, the key's length in bytes. The same message
    /// always signs the same.
    pub fn sign(self, hash: Algorithm, message: List<u8>) -> List<u8> {
        let size = self.size()
        let padded = pkcs1_digest(hash, message, size) ?? panic("every digest fits a key of 1024 bits")
        var out: List<u8> = [0; 256]
        unsafe {
            if not cx_rsa_private_op(self.ctx.as_ptr(), padded.as_ptr(), size, out.as_mut_ptr()) {
                panic("a padded digest is below the modulus")
            }
        }
        out.truncate(size)
        return out
    }
}

/// An RSA public key, read from an X.509 SubjectPublicKeyInfo in DER, the bytes Java's
/// `PublicKey.getEncoded()` gives: a modulus of 512 to 4096 bits and its exponent. It checks
/// signatures, as Java's `Signature` checks them.
pub struct RsaPublicKey {
    encoded: List<u8>,
    // The modulus's length in bytes, and the key set up for its operation, with what Montgomery
    // multiplication needs worked out once.
    bytes: usize,
    ctx: List<u8>,
}

impl RsaPublicKey {
    /// The key in `der`, or `none` if it isn't an RSA key in DER as `getEncoded()` writes one,
    /// every length and number in its shortest form with nothing after it, or its modulus isn't
    /// an odd number of 512 to 4096 bits, or its exponent isn't from 3 to less than the modulus.
    pub fn from_der(der: List<u8>) -> RsaPublicKey? {
        var r = Der { bytes: der.copy(), at: 0 }
        let info = r.enter(0x30) else return none
        let algorithm = r.enter(0x30) else return none
        // rsaEncryption, 1.2.840.113549.1.1.1, with no parameters.
        let oid: List<u8> = [0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x01, 0x05, 0x00]
        if algorithm - r.at != oid.len() or not r.next_are(oid) {
            return none
        }
        let bits = r.enter(0x03) else return none
        if r.byte() != some(0) {
            return none
        }
        let key = r.enter(0x30) else return none
        let modulus = r.integer() else return none
        let exponent = r.integer() else return none
        if r.at != key or key != bits or bits != info or info != der.len() {
            return none
        }
        let size = modulus.len()
        let top = modulus[0]
        var top_bits: usize = 0
        while i32(top) >> i32.wrap(top_bits) != 0 {
            top_bits += 1
        }
        let length = 8 * (size - 1) + top_bits
        if length < 512 or length > 4096 or modulus[size - 1] & 1 == 0 {
            return none
        }
        if exponent.len() > size or (exponent.len() == size and not below(exponent, modulus)) {
            return none
        }
        if exponent.len() == 1 and exponent[0] < 3 {
            return none
        }
        var ctx: List<u8> = [0; 1568]
        let ready = unsafe { cx_rsa_public_setup(ctx.as_mut_ptr(), modulus.as_ptr(), size, exponent.as_ptr(), exponent.len()) }
        if not ready {
            return none
        }
        return some(RsaPublicKey { encoded: der.copy(), bytes: size, ctx: ctx })
    }

    /// The key as X.509 DER, as it was read, which is how Java's `getEncoded()` writes it.
    pub fn der(self) -> List<u8> {
        return self.encoded.copy()
    }

    /// The modulus's length in bytes, which a signature has: 256 for 2048 bits.
    pub fn size(self) -> usize {
        return self.bytes
    }

    /// Whether `signature` is the key's PKCS#1 v1.5 signature of `message` with its `hash`, as
    /// Java's `Signature.verify` decides for "SHA256withRSA" with `Sha256` or "SHA1withRSA" with
    /// `Sha1`. One whose number isn't below the modulus isn't, as Java decides too. Nor is one
    /// that isn't the key's length, where Java throws a `SignatureException`, `Bad signature
    /// length: got 255 but was expecting 256`, that vanilla logs and takes as a no.
    pub fn verify(self, hash: Algorithm, message: List<u8>, signature: List<u8>) -> bool {
        let size = self.size()
        if signature.len() != size {
            return false
        }
        let want = pkcs1_digest(hash, message, size) else return false
        var got: List<u8> = [0; size]
        let done = unsafe { cx_rsa_public_op(self.ctx.as_ptr(), signature.as_ptr(), got.as_mut_ptr()) }
        return done and got == want
    }
}

// What PKCS#1 v1.5 signs, EMSA-PKCS1-v1_5: 0, 1, 0xFF bytes, 0, then the digest's DigestInfo, the
// hash's identifier and the digest, `size` bytes in all; `none` if that's too long for the key.
fn pkcs1_digest(hash: Algorithm, message: List<u8>, size: usize) -> List<u8>? {
    let prefix: List<u8> = match hash {
        Algorithm.Md5 => [0x30, 0x20, 0x30, 0x0C, 0x06, 0x08, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x02, 0x05, 0x05, 0x00, 0x04, 0x10],
        Algorithm.Sha1 => [0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2B, 0x0E, 0x03, 0x02, 0x1A, 0x05, 0x00, 0x04, 0x14],
        Algorithm.Sha256 => [0x30, 0x31, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20],
    }
    var d = Digest.new(hash)
    d.add(message)
    let digest = d.finish()
    let info = prefix.len() + digest.len()
    if size < info + 11 {
        return none
    }
    var out: List<u8> = [0xFF; size]
    out[0] = 0
    out[1] = 1
    out[size - info - 1] = 0
    for i in 0..prefix.len() {
        out[size - info + i] = prefix[i]
    }
    for i in 0..digest.len() {
        out[size - digest.len() + i] = digest[i]
    }
    return some(out)
}

// Whether `a` is less than `b`, both big-endian and the same length.
fn below(a: List<u8>, b: List<u8>) -> bool {
    for i in 0..a.len() {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
    }
    return false
}

// A reader of DER that takes only its shortest forms.
struct Der {
    bytes: List<u8>,
    at: usize,
}

impl Der {
    fn byte(mut self) -> u8? {
        if self.at >= self.bytes.len() {
            return none
        }
        self.at += 1
        return some(self.bytes[self.at - 1])
    }

    fn next_are(mut self, want: List<u8>) -> bool {
        for b in want {
            if self.byte() != some(b) {
                return false
            }
        }
        return true
    }

    // The tag, which must be `tag`, and the length after it; gives where the value ends.
    fn enter(mut self, tag: u8) -> usize? {
        if self.byte() != some(tag) {
            return none
        }
        let first = self.byte() else return none
        var length: usize = 0
        if first < 0x80 {
            length = usize(first)
        } else {
            let count = first & 0x7F
            if count == 0 or count > 2 {
                return none
            }
            for _ in 0..count {
                let b = self.byte() else return none
                length = length * 256 + usize(b)
            }
            // The short form, or fewer bytes, would have done.
            if length < 0x80 or (count == 2 and length < 0x100) {
                return none
            }
        }
        if length > self.bytes.len() - self.at {
            return none
        }
        return some(self.at + length)
    }

    // A positive INTEGER, as its bytes without the 0 that keeps its top bit clear.
    fn integer(mut self) -> List<u8>? {
        let end = self.enter(0x02) else return none
        if end == self.at {
            return none
        }
        var start = self.at
        if self.bytes[start] & 0x80 != 0 {
            return none
        }
        if self.bytes[start] == 0 {
            // A 0 is only there to clear the top bit of the byte after it.
            if end - start == 1 or self.bytes[start + 1] & 0x80 == 0 {
                return none
            }
            start += 1
        }
        var out = List<u8>()
        for i in start..end {
            out.push(self.bytes[i])
        }
        self.at = end
        return some(out)
    }
}
