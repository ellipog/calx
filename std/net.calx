/// TCP connections, driven by events (D33, D92).
///
/// A `Net` holds listening sockets and connections. `poll` waits until something happens and
/// reports it as events: a connection accepted or opened, bytes received, a connection closed,
/// or another thread waking it. The runtime keeps what arrived until `read` takes it, and what
/// `write` queued until the socket takes it, so nothing here waits for the network except `poll`.
module std.net

import std.fs.{File}
import std.io

extern "C" {
    fn cx_net_open() -> u64
    fn cx_net_listen(net: u64, host: *const u8, len: usize, port: u16) -> i32
    fn cx_net_connect(net: u64, host: *const u8, len: usize, port: u16) -> u32
    fn cx_net_poll(net: u64, timeout_ms: i64) -> usize
    fn cx_net_event_kind(net: u64, i: usize) -> u32
    fn cx_net_event_conn(net: u64, i: usize) -> u32
    fn cx_net_available(net: u64, conn: u32) -> usize
    fn cx_net_read(net: u64, conn: u32, to: *u8, n: usize) -> usize
    fn cx_net_send(net: u64, conn: u32, from: *const u8, n: usize)
    fn cx_net_queued(net: u64, conn: u32) -> usize
    fn cx_net_send_file(net: u64, conn: u32, file: i64, at: u64, len: u64) -> bool
    fn cx_net_close(net: u64, conn: u32)
    fn cx_net_flush(net: u64)
    fn cx_net_waker(net: u64) -> bool
    fn cx_net_wake(net: u64)
    fn cx_net_wake_on_signal(net: u64) -> bool
    fn cx_net_signalled(net: u64) -> bool
    fn cx_net_number(net: u64) -> u32
    fn cx_net_drain(net: u64, timeout_ms: i64) -> bool
    fn cx_net_peer(net: u64, conn: u32, out: *u8) -> u32
    fn cx_net_error_kind() -> u32
    fn cx_net_error_code() -> i32
}

/// Why opening a `Net`, listening or connecting failed.
pub enum NetError {
    /// Another socket is listening on that address and port.
    AddressInUse
    /// The host isn't an address, or no name server knows it.
    BadAddress
    /// Nothing is listening there.
    Refused
    /// Something else, with the system's error code.
    Os(i32)
}

/// What went wrong, in words: `connection refused`, `address already in use`, or
/// `system error 10060` with the system's code.
impl Display for NetError {
    fn show(self) {
        match self {
            AddressInUse => print("address already in use"),
            BadAddress => print("not an address, or no name server knows the host"),
            Refused => print("connection refused"),
            Os(code) => print("system error {code}"),
        }
    }
}

/// A connection, as `Event`s name it and `read`, `write` and `close` take it. It's the `Net`'s
/// that made or accepted it, and another `Net` panics if it's given one (CLX-386). Two are equal
/// when their `id`s are.
pub struct Conn {
    number: u32,
    // The number of the `Net` it's from, or 0 for one `from_id` made, which any `Net` takes.
    net: u32,
}

impl Equal for Conn {
    fn eq(self, other: Self) -> bool {
        return self.number == other.number
    }
}

impl Hash for Conn {
    fn hash(self, h: mut Hasher) {
        h.add(self.number)
    }
}

impl Conn {
    /// A small number for the connection, counting from 0, for indexing a list of what the
    /// program keeps per connection. A new connection can have the slot of one whose `Closed`
    /// event was reported by an earlier poll.
    pub fn slot(self) -> usize {
        return usize(self.number & 0xFFFFFF)
    }

    /// The connection's number: its slot, and how many connections had the slot before it. No
    /// two connections a `Net` has at once have the same, and `Conn.from_id` makes it again, for
    /// a log of connections that's replayed.
    pub fn id(self) -> u32 {
        return self.number
    }

    /// The connection whose `id` this is, in whichever `Net` it's given to. One that no
    /// connection of that `Net` has names none: it has nothing to read, and what's written to it
    /// or closes it does nothing.
    pub fn from_id(id: u32) -> Conn {
        return Conn { number: id, net: 0 }
    }
}

/// An IP address.
pub enum Ip {
    /// An IPv4 address, such as `127.0.0.1`.
    V4([u8; 4])
    /// An IPv6 address, and its scope: the interface a link-local address is on, or 0.
    V6([u8; 16], u32)
}

impl Ip {
    /// The address as RFC 5952 writes it: `127.0.0.1`, `::1`, `2001:db8::8:800:200c:417a`,
    /// `::ffff:192.0.2.1` for an IPv4-mapped address, and `fe80::1%3` with a scope.
    pub fn to_string(self) -> String {
        return match self {
            Ip.V4(b) => "{b[0]}.{b[1]}.{b[2]}.{b[3]}",
            Ip.V6(b, scope) => {
                var out = v6_text(b)
                if scope != 0 {
                    out.push_str("%{scope}")
                }
                out
            },
        }
    }
}

/// An IP address and a port.
pub struct Address {
    pub ip: Ip
    pub port: u16
}

impl Address {
    /// The address and port as RFC 5952 writes them: `127.0.0.1:25565`, or `[::1]:25565`.
    pub fn to_string(self) -> String {
        return match self.ip {
            Ip.V4(_) => "{self.ip.to_string()}:{self.port}",
            Ip.V6(_, _) => "[{self.ip.to_string()}]:{self.port}",
        }
    }
}

// An IPv6 address's text, without its scope: each 16-bit group in lowercase hex without leading
// zeros, and the longest run of two or more zero groups, the first if there's a tie, as `::`.
fn v6_text(b: [u8; 16]) -> String {
    var mapped = b[10] == 0xFF and b[11] == 0xFF
    let prefix: usize = 10
    for i in 0..prefix {
        mapped = mapped and b[i] == 0
    }
    if mapped {
        return "::ffff:{b[12]}.{b[13]}.{b[14]}.{b[15]}"
    }
    var groups: [u32; 8] = [0; 8]
    let count: usize = 8
    for i in 0..count {
        groups[i] = (u32(b[2 * i]) << 8) | u32(b[2 * i + 1])
    }
    var best_at: usize = 8
    var best_len: usize = 1
    var i: usize = 0
    while i < 8 {
        if groups[i] != 0 {
            i += 1
            continue
        }
        var end = i
        while end < 8 and groups[end] == 0 {
            end += 1
        }
        if end - i > best_len {
            best_at = i
            best_len = end - i
        }
        i = end
    }
    let digits = "0123456789abcdef"
    var out = String()
    var g: usize = 0
    while g < 8 {
        if g == best_at {
            out.push_str("::")
            g += best_len
            continue
        }
        if g > 0 and g != best_at + best_len {
            out.push(':')
        }
        let v = groups[g]
        var started = false
        var shift: i32 = 12
        while shift >= 0 {
            let d = usize((v >> shift) & 15)
            if d != 0 or started or shift == 0 {
                out.push_str(digits[d..d + 1])
                started = true
            }
            shift -= 4
        }
        g += 1
    }
    return out
}

/// What a poll reports.
pub enum Event {
    /// A listening socket accepted this new connection.
    Accepted(Conn)
    /// A connection from `connect` is open.
    Connected(Conn)
    /// Bytes arrived on the connection: `read` takes them.
    Received(Conn)
    /// The connection ended: the other side closed it, it failed, `connect` couldn't open it, or
    /// `close` finished. It's the last event for the connection, and what arrived before it can
    /// still be read until the next poll.
    Closed(Conn)
    /// A `Waker` woke the poll, or a signal did, after `wake_on_signal`. Wakes before the poll
    /// that reports them come as one.
    Woken
}

/// Wakes a `Net`'s poll from another thread, so a thread that queued something for the one
/// polling can say so: the poll reports `Woken`, or the next one does if none is waiting. It's
/// `Copy` and `Send`, and every copy wakes the same `Net`.
pub struct Waker {
    handle: u64,
}

impl Waker {
    /// Wakes the poll. Any thread can, except inside a `parallel for`.
    pub fn wake(self) {
        unsafe {
            cx_net_wake(self.handle)
        }
    }
}

/// Listening sockets and connections, and the events about them. It's one thread's at a time:
/// each thread that polls makes its own, and they run at once without waiting on each other
/// (CLX-386). One can move to another thread, but two threads using it at once panic, and so does
/// one inside a `parallel for`. It lasts until the program ends.
pub struct Net {
    handle: u64,
    // Which of the program's `Net`s it is, which each `Conn` it gives holds.
    number: u32,
}

fn last_error() -> NetError {
    let kind = unsafe { cx_net_error_kind() }
    return match kind {
        1 => NetError.AddressInUse,
        2 => NetError.BadAddress,
        3 => NetError.Refused,
        _ => NetError.Os(unsafe { cx_net_error_code() }),
    }
}

impl Net {
    pub fn new() -> Net ! NetError {
        let handle = unsafe { cx_net_open() }
        if handle == 0 {
            fail last_error()
        }
        return Net { handle: handle, number: unsafe { cx_net_number(handle) } }
    }

    /// Listens for connections on `host` and `port`, and returns the port, which the system picks
    /// when `port` is 0. An empty host listens on every address, IPv4 and IPv6. Each connection
    /// is reported as `Accepted`.
    pub fn listen(self, host: String, port: u16) -> u16 ! NetError {
        let bound = unsafe { cx_net_listen(self.handle, host.as_ptr(), host.len(), port) }
        if bound < 0 {
            fail last_error()
        }
        return u16.wrap(bound)
    }

    /// Starts opening a connection to `host` and `port`. A poll reports `Connected` once it's
    /// open, or `Closed` if it couldn't be. What's sent before then waits.
    pub fn connect(self, host: String, port: u16) -> Conn ! NetError {
        let id = unsafe { cx_net_connect(self.handle, host.as_ptr(), host.len(), port) }
        if id == 0xFFFFFFFF {
            fail last_error()
        }
        return Conn { number: id, net: self.number }
    }

    /// Waits up to `timeout_ms` milliseconds for something to happen, or forever if it's
    /// negative, and puts what happened in `events`, replacing what was there. It returns as soon
    /// as there's an event, so `events` is empty only once the time is up. A connection gets at
    /// most one `Received` per poll, however many times bytes arrived.
    pub fn poll(self, timeout_ms: i64, events: mut List<Event>) {
        events.clear()
        unsafe {
            let n = cx_net_poll(self.handle, timeout_ms)
            for i in 0usize..n {
                let conn = Conn { number: cx_net_event_conn(self.handle, i), net: self.number }
                events.push(match cx_net_event_kind(self.handle, i) {
                    1 => Event.Accepted(conn),
                    2 => Event.Connected(conn),
                    3 => Event.Received(conn),
                    4 => Event.Closed(conn),
                    _ => Event.Woken,
                })
            }
        }
    }

    // The connection's number, which it panics at for another `Net`'s connection: that number
    // could be one of this `Net`'s too, which would be read from or written to in its place.
    @track_caller
    fn id_of(self, conn: Conn) -> u32 {
        if conn.net != 0 and conn.net != self.number {
            panic("the connection is another `Net`'s: a `Net` reads, writes and closes only the connections it opened or accepted")
        }
        return conn.number
    }

    /// Moves every byte that has arrived on the connection onto the end of `buf`, and returns
    /// how many there were.
    @track_caller
    pub fn read(self, conn: Conn, buf: mut List<u8>) -> usize {
        let id = self.id_of(conn)
        unsafe {
            let n = cx_net_available(self.handle, id)
            buf.reserve(n)
            let start = buf.len()
            let got = cx_net_read(self.handle, id, buf.as_mut_ptr().add(start), n)
            buf.set_len(start + got)
            return got
        }
    }

    /// How many bytes queued on the connection the system hasn't taken yet, so a program sending
    /// something big can queue the next part once most of the last has gone. 0 for a connection
    /// that has closed.
    @track_caller
    pub fn queued(self, conn: Conn) -> usize {
        return unsafe { cx_net_queued(self.handle, self.id_of(conn)) }
    }

    /// Queues `n` bytes of `file`, from byte `at`, to send on the connection after what's queued
    /// on it, files too. The system sends them from the file without them passing through the
    /// program: TransmitFile on Windows, sendfile on Linux. The runtime keeps its own handle to
    /// the file, so `file` can be closed at once. What's written while it waits or goes is sent
    /// after it. `false` if the connection is closing or closed, or the file can't be opened
    /// again. A file shorter than the range closes the connection when its end is reached.
    @track_caller
    pub fn send_file(self, conn: Conn, file: File, at: u64, n: u64) -> bool {
        return unsafe { cx_net_send_file(self.handle, self.id_of(conn), file.raw(), at, n) }
    }

    /// Queues the bytes to send on the connection. They go to the system at the next poll or
    /// `flush`, with everything else queued on the connection since the last, and then as soon
    /// as the socket takes them. On a connection that has closed, they're dropped.
    @track_caller
    pub fn write(self, conn: Conn, bytes: List<u8>) {
        let id = self.id_of(conn)
        unsafe {
            cx_net_send(self.handle, id, bytes.as_ptr(), bytes.len())
        }
    }

    /// Sends what was queued on every connection now, rather than at the next poll.
    pub fn flush(self) {
        unsafe {
            cx_net_flush(self.handle)
        }
    }

    /// A `Waker` for this `Net`'s polls, which another thread can wake them with.
    pub fn waker(self) -> Waker ! NetError {
        if not unsafe { cx_net_waker(self.handle) } {
            fail NetError.Os(0)
        }
        return Waker { handle: self.handle }
    }

    /// Waits up to `timeout_ms` milliseconds, or forever if it's negative, until what was
    /// written to every connection has gone to the system and each connection `close` closed has
    /// closed, for a program about to end, which would cut both off, as asyncio's `drain()` and
    /// `wait_closed()` do. `false` if the time ran out first. What happens meanwhile, a new
    /// connection or bytes arriving, waits for the next poll.
    pub fn drain(self, timeout_ms: i64) -> bool {
        return unsafe { cx_net_drain(self.handle, timeout_ms) }
    }

    /// Wakes this `Net`'s polls at each signal the program handles with `std.signal`, as a
    /// `Waker` would, so a server waiting for connections hears that it's asked to stop: the
    /// poll reports `Woken`, and `std.signal.take` says which signal it was. Every `Net` that asks
    /// is woken, on whichever thread it's polled.
    pub fn wake_on_signal(self) ! NetError {
        if not unsafe { cx_net_wake_on_signal(self.handle) } {
            fail NetError.Os(0)
        }
    }

    /// Whether a signal has woken this `Net` since `wake_on_signal`, or since `signalled` last
    /// said so, which it then forgets. Each `Net` hears of each signal, though only one thread
    /// `take`s it, so a loop on each of several threads stops at one signal: each asks its own
    /// `Net`, rather than asking `std.signal` whether one is pending, which another thread may
    /// have taken first.
    pub fn signalled(self) -> bool {
        return unsafe { cx_net_signalled(self.handle) }
    }

    /// Sends what was queued on the connection, then closes it. A poll reports `Closed` after.
    @track_caller
    pub fn close(self, conn: Conn) {
        let id = self.id_of(conn)
        unsafe {
            cx_net_close(self.handle, id)
        }
    }

    /// The address at the connection's other end, as it was when the connection opened. It
    /// stays until the poll after the connection's `Closed`, so the `Closed` can be logged with
    /// it. None for a connection that never opened, and once it's gone.
    @track_caller
    pub fn peer(self, conn: Conn) -> Address? {
        let id = self.id_of(conn)
        var out = List<u8>()
        out.reserve(22)
        // The runtime writes all 22 bytes.
        let family = unsafe { cx_net_peer(self.handle, id, out.as_mut_ptr()) }
        unsafe {
            out.set_len(22)
        }
        let port = u16.wrap((u32(out[16]) << 8) | u32(out[17]))
        if family == 4 {
            return some(Address { ip: Ip.V4([out[0], out[1], out[2], out[3]]), port: port })
        }
        if family != 6 {
            return none
        }
        var b: [u8; 16] = [0; 16]
        let size: usize = 16
        for i in 0..size {
            b[i] = out[i]
        }
        let scope = (u32(out[18]) << 24) | (u32(out[19]) << 16) | (u32(out[20]) << 8) | u32(out[21])
        return some(Address { ip: Ip.V6(b, scope), port: port })
    }
}

// How much a Stream lets wait unsent before a write waits for it to go.
const STREAM_QUEUED: usize = 4194304

/// A connection read and written in order, waiting as a blocking socket does, for code that takes
/// a `std.io` `Reader` or `Writer`, as Python's `socket.makefile("rwb")` makes a file of a socket:
/// `std.tar`'s `StreamWriter` sending folders to another server in a `std.zstd` `Writer`, and its
/// `StreamReader` taking them at the other end. A read waits until bytes arrive, and gives 0 once
/// the connection has closed and they've all been read. A write that leaves more than 4 MiB
/// queued waits until it has gone to the system, so not much more than that waits in memory, and
/// fails once the connection has closed.
///
/// It polls its `Net` while it waits, and passes over what those polls say of other connections,
/// so the `Net` is the stream's alone while it's used: one a thread makes for the transfer, as a
/// blocking socket is a thread's.
pub struct Stream {
    net: Net
    connection: Conn
    // What it has read and not given out, from `at`.
    buf: List<u8>
    at: usize = 0
    closed: bool = false
    events: List<Event>
}

impl Stream {
    /// The connection `conn` of `net`, accepted or from `connect`, as a stream. A connection from
    /// `connect` that isn't open yet is waited for: what's written waits until it is, and a read
    /// waits for its bytes.
    pub fn new(net: Net, conn: Conn) -> Stream {
        return Stream { net: net, connection: conn, buf: [], events: [] }
    }

    /// The connection.
    pub fn conn(self) -> Conn {
        return self.connection
    }

    /// Sends what's queued and closes the connection, as `Net.close` does, then waits up to
    /// `timeout_ms` milliseconds, or forever if it's negative, until it has gone, as `Net.drain`
    /// does: `false` if the time ran out first.
    pub fn close(own self, timeout_ms: i64 = -1) -> bool {
        let s = self
        s.net.close(s.connection)
        return s.net.drain(timeout_ms)
    }

    // Waits up to `timeout_ms` for the next events, or forever if it's negative, noting whether the
    // connection has closed.
    fn wait(mut self, timeout_ms: i64) {
        self.net.poll(timeout_ms, mut self.events)
        var ended = false
        for e in self.events {
            match e {
                Closed(c) => {
                    if c == self.connection {
                        ended = true
                    }
                },
                _ => {},
            }
        }
        if ended {
            self.closed = true
        }
    }

    // Waits until what's queued has gone to the system, as `Net.drain` does, which a poll can't
    // wait for, since nothing's reported when it goes; then fails if the connection has closed.
    fn sent(mut self) ! String {
        _ = self.net.drain(-1)
        self.wait(0)
        if self.closed {
            fail "the connection closed before what was written went"
        }
    }
}

impl io.Reader for Stream {
    fn read(mut self, buf: mut List<u8>, n: usize) -> usize ! String {
        if n == 0 {
            return 0
        }
        loop {
            let here = self.buf.len() - self.at
            if here > 0 {
                let k = if here < n { here } else { n }
                buf.extend(self.buf[self.at..self.at + k])
                self.at += k
                return k
            }
            self.buf.clear()
            self.at = 0
            // What arrived before the connection closed can still be read until the next poll.
            if self.net.read(self.connection, mut self.buf) > 0 {
                continue
            }
            if self.closed {
                return 0
            }
            self.wait(-1)
        }
    }
}

impl io.Writer for Stream {
    fn write(mut self, bytes: List<u8>) ! String {
        if self.closed {
            fail "the connection has closed"
        }
        self.net.write(self.connection, bytes)
        if self.net.queued(self.connection) > STREAM_QUEUED {
            try self.sent()
        }
    }

    /// Waits until everything written has gone to the system, which sends it on.
    fn flush(mut self) ! String {
        try self.sent()
    }
}
