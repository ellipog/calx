/// TCP connections, driven by events (D33, D92).
///
/// A `Net` holds listening sockets and connections. `poll` waits until something happens and
/// reports it as events: a connection accepted or opened, bytes received, a connection closed,
/// or another thread waking it. The runtime keeps what arrived until `read` takes it, and what
/// `write` queued until the socket takes it, so nothing here waits for the network except `poll`.
module std.net

extern "C" {
    fn cx_net_open() -> u64
    fn cx_net_listen(net: u64, host: *const u8, len: usize, port: u16) -> i32
    fn cx_net_connect(net: u64, host: *const u8, len: usize, port: u16) -> u32
    fn cx_net_poll(net: u64, timeout_ms: i64) -> usize
    fn cx_net_event_kind(net: u64, i: usize) -> u32
    fn cx_net_event_conn(net: u64, i: usize) -> u32
    fn cx_net_available(net: u64, conn: u32) -> usize
    fn cx_net_read(net: u64, conn: u32, to: *u8, n: usize) -> usize
    fn cx_net_send(net: u64, conn: u32, from: *const u8, n: usize)
    fn cx_net_close(net: u64, conn: u32)
    fn cx_net_flush(net: u64)
    fn cx_net_waker(net: u64) -> bool
    fn cx_net_wake(net: u64)
    fn cx_net_peer(net: u64, conn: u32, out: *u8) -> u32
    fn cx_net_error_kind() -> u32
    fn cx_net_error_code() -> i32
}

/// Why opening a `Net`, listening or connecting failed.
pub enum NetError {
    /// Another socket is listening on that address and port.
    AddressInUse
    /// The host isn't an address, or no name server knows it.
    BadAddress
    /// Nothing is listening there.
    Refused
    /// Something else, with the system's error code.
    Os(i32)
}

/// A connection, as `Event`s name it and `read`, `write` and `close` take it.
pub struct Conn {
    number: u32,
}

impl Conn {
    /// A small number for the connection, counting from 0, for indexing a list of what the
    /// program keeps per connection. A new connection can have the slot of one whose `Closed`
    /// event was reported by an earlier poll.
    pub fn slot(self) -> usize {
        return usize(self.number & 0xFFFFFF)
    }

    /// The connection's number: its slot, and how many connections had the slot before it. No
    /// two connections a `Net` has at once have the same, and `Conn.from_id` makes it again, for
    /// a log of connections that's replayed.
    pub fn id(self) -> u32 {
        return self.number
    }

    /// The connection whose `id` this is. One that no connection of a `Net` has names none: it
    /// has nothing to read, and what's written to it or closes it does nothing.
    pub fn from_id(id: u32) -> Conn {
        return Conn { number: id }
    }
}

/// An IP address.
pub enum Ip {
    /// An IPv4 address, such as `127.0.0.1`.
    V4([u8; 4])
    /// An IPv6 address, and its scope: the interface a link-local address is on, or 0.
    V6([u8; 16], u32)
}

impl Ip {
    /// The address as RFC 5952 writes it: `127.0.0.1`, `::1`, `2001:db8::8:800:200c:417a`,
    /// `::ffff:192.0.2.1` for an IPv4-mapped address, and `fe80::1%3` with a scope.
    pub fn to_string(self) -> String {
        return match self {
            Ip.V4(b) => "{b[0]}.{b[1]}.{b[2]}.{b[3]}",
            Ip.V6(b, scope) => {
                var out = v6_text(b)
                if scope != 0 {
                    out.push_str("%{scope}")
                }
                out
            },
        }
    }
}

/// An IP address and a port.
pub struct Address {
    pub ip: Ip
    pub port: u16
}

impl Address {
    /// The address and port as RFC 5952 writes them: `127.0.0.1:25565`, or `[::1]:25565`.
    pub fn to_string(self) -> String {
        return match self.ip {
            Ip.V4(_) => "{self.ip.to_string()}:{self.port}",
            Ip.V6(_, _) => "[{self.ip.to_string()}]:{self.port}",
        }
    }
}

// An IPv6 address's text, without its scope: each 16-bit group in lowercase hex without leading
// zeros, and the longest run of two or more zero groups, the first if there's a tie, as `::`.
fn v6_text(b: [u8; 16]) -> String {
    var mapped = b[10] == 0xFF and b[11] == 0xFF
    let prefix: usize = 10
    for i in 0..prefix {
        mapped = mapped and b[i] == 0
    }
    if mapped {
        return "::ffff:{b[12]}.{b[13]}.{b[14]}.{b[15]}"
    }
    var groups: [u32; 8] = [0; 8]
    let count: usize = 8
    for i in 0..count {
        groups[i] = (u32(b[2 * i]) << 8) | u32(b[2 * i + 1])
    }
    var best_at: usize = 8
    var best_len: usize = 1
    var i: usize = 0
    while i < 8 {
        if groups[i] != 0 {
            i += 1
            continue
        }
        var end = i
        while end < 8 and groups[end] == 0 {
            end += 1
        }
        if end - i > best_len {
            best_at = i
            best_len = end - i
        }
        i = end
    }
    let digits = "0123456789abcdef"
    var out = String()
    var g: usize = 0
    while g < 8 {
        if g == best_at {
            out.push_str("::")
            g += best_len
            continue
        }
        if g > 0 and g != best_at + best_len {
            out.push(':')
        }
        let v = groups[g]
        var started = false
        var shift: i32 = 12
        while shift >= 0 {
            let d = usize((v >> shift) & 15)
            if d != 0 or started or shift == 0 {
                out.push_str(digits[d..d + 1])
                started = true
            }
            shift -= 4
        }
        g += 1
    }
    return out
}

/// What a poll reports.
pub enum Event {
    /// A listening socket accepted this new connection.
    Accepted(Conn)
    /// A connection from `connect` is open.
    Connected(Conn)
    /// Bytes arrived on the connection: `read` takes them.
    Received(Conn)
    /// The connection ended: the other side closed it, it failed, `connect` couldn't open it, or
    /// `close` finished. It's the last event for the connection, and what arrived before it can
    /// still be read until the next poll.
    Closed(Conn)
    /// A `Waker` woke the poll. Wakes before the poll that reports them come as one.
    Woken
}

/// Wakes a `Net`'s poll from another thread, so a thread that queued something for the one
/// polling can say so: the poll reports `Woken`, or the next one does if none is waiting. It's
/// `Copy` and `Send`, and every copy wakes the same `Net`.
pub struct Waker {
    handle: u64,
}

impl Waker {
    /// Wakes the poll. Any thread can, except inside a `parallel for`.
    pub fn wake(self) {
        unsafe {
            cx_net_wake(self.handle)
        }
    }
}

/// Listening sockets and connections, and the events about them. Only the thread that made it
/// can use it, and never inside a `parallel for`. It lasts until the program ends.
pub struct Net {
    handle: u64,
}

fn last_error() -> NetError {
    let kind = unsafe { cx_net_error_kind() }
    return match kind {
        1 => NetError.AddressInUse,
        2 => NetError.BadAddress,
        3 => NetError.Refused,
        _ => NetError.Os(unsafe { cx_net_error_code() }),
    }
}

impl Net {
    pub fn new() -> Net ! NetError {
        let handle = unsafe { cx_net_open() }
        if handle == 0 {
            fail last_error()
        }
        return Net { handle: handle }
    }

    /// Listens for connections on `host` and `port`, and returns the port, which the system picks
    /// when `port` is 0. An empty host listens on every address, IPv4 and IPv6. Each connection
    /// is reported as `Accepted`.
    pub fn listen(self, host: String, port: u16) -> u16 ! NetError {
        let bound = unsafe { cx_net_listen(self.handle, host.as_ptr(), host.len(), port) }
        if bound < 0 {
            fail last_error()
        }
        return u16.wrap(bound)
    }

    /// Starts opening a connection to `host` and `port`. A poll reports `Connected` once it's
    /// open, or `Closed` if it couldn't be. What's sent before then waits.
    pub fn connect(self, host: String, port: u16) -> Conn ! NetError {
        let id = unsafe { cx_net_connect(self.handle, host.as_ptr(), host.len(), port) }
        if id == 0xFFFFFFFF {
            fail last_error()
        }
        return Conn { number: id }
    }

    /// Waits up to `timeout_ms` milliseconds for something to happen, or forever if it's
    /// negative, and puts what happened in `events`, replacing what was there. It returns as soon
    /// as there's an event, so `events` is empty only once the time is up. A connection gets at
    /// most one `Received` per poll, however many times bytes arrived.
    pub fn poll(self, timeout_ms: i64, events: mut List<Event>) {
        events.clear()
        unsafe {
            let n = cx_net_poll(self.handle, timeout_ms)
            for i in 0usize..n {
                let conn = Conn { number: cx_net_event_conn(self.handle, i) }
                events.push(match cx_net_event_kind(self.handle, i) {
                    1 => Event.Accepted(conn),
                    2 => Event.Connected(conn),
                    3 => Event.Received(conn),
                    4 => Event.Closed(conn),
                    _ => Event.Woken,
                })
            }
        }
    }

    /// Moves every byte that has arrived on the connection onto the end of `buf`, and returns
    /// how many there were.
    pub fn read(self, conn: Conn, buf: mut List<u8>) -> usize {
        unsafe {
            let n = cx_net_available(self.handle, conn.number)
            buf.reserve(n)
            let start = buf.len()
            let got = cx_net_read(self.handle, conn.number, buf.as_mut_ptr().add(start), n)
            buf.set_len(start + got)
            return got
        }
    }

    /// Queues the bytes to send on the connection. They go to the system at the next poll or
    /// `flush`, with everything else queued on the connection since the last, and then as soon
    /// as the socket takes them. On a connection that has closed, they're dropped.
    pub fn write(self, conn: Conn, bytes: List<u8>) {
        unsafe {
            cx_net_send(self.handle, conn.number, bytes.as_ptr(), bytes.len())
        }
    }

    /// Sends what was queued on every connection now, rather than at the next poll.
    pub fn flush(self) {
        unsafe {
            cx_net_flush(self.handle)
        }
    }

    /// A `Waker` for this `Net`'s polls, which another thread can wake them with.
    pub fn waker(self) -> Waker ! NetError {
        if not unsafe { cx_net_waker(self.handle) } {
            fail NetError.Os(0)
        }
        return Waker { handle: self.handle }
    }

    /// Sends what was queued on the connection, then closes it. A poll reports `Closed` after.
    pub fn close(self, conn: Conn) {
        unsafe {
            cx_net_close(self.handle, conn.number)
        }
    }

    /// The address at the connection's other end, as it was when the connection opened. It
    /// stays until the poll after the connection's `Closed`, so the `Closed` can be logged with
    /// it. None for a connection that never opened, and once it's gone.
    pub fn peer(self, conn: Conn) -> Address? {
        var out = List<u8>()
        out.reserve(22)
        // The runtime writes all 22 bytes.
        let family = unsafe { cx_net_peer(self.handle, conn.number, out.as_mut_ptr()) }
        unsafe {
            out.set_len(22)
        }
        let port = u16.wrap((u32(out[16]) << 8) | u32(out[17]))
        if family == 4 {
            return some(Address { ip: Ip.V4([out[0], out[1], out[2], out[3]]), port: port })
        }
        if family != 6 {
            return none
        }
        var b: [u8; 16] = [0; 16]
        let size: usize = 16
        for i in 0..size {
            b[i] = out[i]
        }
        let scope = (u32(out[18]) << 24) | (u32(out[19]) << 16) | (u32(out[20]) << 8) | u32(out[21])
        return some(Address { ip: Ip.V6(b, scope), port: port })
    }
}
