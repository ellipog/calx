/// TCP connections, driven by events (D33, D92).
///
/// A `Net` holds listening sockets and connections. `poll` waits until something happens and
/// reports it as events: a connection accepted or opened, bytes received, a connection closed.
/// The runtime keeps what arrived until `read` takes it, and what `write` queued until the socket
/// takes it, so nothing here waits for the network except `poll`.
module std.net

extern "C" {
    fn cx_net_open() -> u64
    fn cx_net_listen(net: u64, host: *const u8, len: usize, port: u16) -> i32
    fn cx_net_connect(net: u64, host: *const u8, len: usize, port: u16) -> u32
    fn cx_net_poll(net: u64, timeout_ms: i64) -> usize
    fn cx_net_event_kind(net: u64, i: usize) -> u32
    fn cx_net_event_conn(net: u64, i: usize) -> u32
    fn cx_net_available(net: u64, conn: u32) -> usize
    fn cx_net_read(net: u64, conn: u32, to: *u8, n: usize) -> usize
    fn cx_net_send(net: u64, conn: u32, from: *const u8, n: usize)
    fn cx_net_close(net: u64, conn: u32)
    fn cx_net_error_kind() -> u32
    fn cx_net_error_code() -> i32
}

/// Why opening a `Net`, listening or connecting failed.
pub enum NetError {
    /// Another socket is listening on that address and port.
    AddressInUse
    /// The host isn't an address, or no name server knows it.
    BadAddress
    /// Nothing is listening there.
    Refused
    /// Something else, with the system's error code.
    Os(i32)
}

/// A connection, as `Event`s name it and `read`, `write` and `close` take it.
pub struct Conn {
    id: u32,
}

impl Conn {
    /// A small number for the connection, counting from 0, for indexing a list of what the
    /// program keeps per connection. A new connection can have the slot of one whose `Closed`
    /// event was reported by an earlier poll.
    pub fn slot(self) -> usize {
        return usize(self.id & 0xFFFFFF)
    }
}

/// What a poll reports.
pub enum Event {
    /// A listening socket accepted this new connection.
    Accepted(Conn)
    /// A connection from `connect` is open.
    Connected(Conn)
    /// Bytes arrived on the connection: `read` takes them.
    Received(Conn)
    /// The connection ended: the other side closed it, it failed, `connect` couldn't open it, or
    /// `close` finished. It's the last event for the connection, and what arrived before it can
    /// still be read until the next poll.
    Closed(Conn)
}

/// Listening sockets and connections, and the events about them. Only the thread that made it
/// can use it, and never inside a `parallel for`. It lasts until the program ends.
pub struct Net {
    handle: u64,
}

fn last_error() -> NetError {
    let kind = unsafe { cx_net_error_kind() }
    return match kind {
        1 => NetError.AddressInUse,
        2 => NetError.BadAddress,
        3 => NetError.Refused,
        _ => NetError.Os(unsafe { cx_net_error_code() }),
    }
}

impl Net {
    pub fn new() -> Net ! NetError {
        let handle = unsafe { cx_net_open() }
        if handle == 0 {
            fail last_error()
        }
        return Net { handle: handle }
    }

    /// Listens for connections on `host` and `port`, and returns the port, which the system picks
    /// when `port` is 0. An empty host listens on every address, IPv4 and IPv6. Each connection
    /// is reported as `Accepted`.
    pub fn listen(self, host: String, port: u16) -> u16 ! NetError {
        let bound = unsafe { cx_net_listen(self.handle, host.as_ptr(), host.len(), port) }
        if bound < 0 {
            fail last_error()
        }
        return u16.wrap(bound)
    }

    /// Starts opening a connection to `host` and `port`. A poll reports `Connected` once it's
    /// open, or `Closed` if it couldn't be. What's sent before then waits.
    pub fn connect(self, host: String, port: u16) -> Conn ! NetError {
        let id = unsafe { cx_net_connect(self.handle, host.as_ptr(), host.len(), port) }
        if id == 0xFFFFFFFF {
            fail last_error()
        }
        return Conn { id: id }
    }

    /// Waits up to `timeout_ms` milliseconds for something to happen, or forever if it's
    /// negative, and puts what happened in `events`, replacing what was there. A connection gets
    /// at most one `Received` per poll, however many times bytes arrived.
    pub fn poll(self, timeout_ms: i64, events: mut List<Event>) {
        events.clear()
        unsafe {
            let n = cx_net_poll(self.handle, timeout_ms)
            for i in 0usize..n {
                let conn = Conn { id: cx_net_event_conn(self.handle, i) }
                events.push(match cx_net_event_kind(self.handle, i) {
                    1 => Event.Accepted(conn),
                    2 => Event.Connected(conn),
                    3 => Event.Received(conn),
                    _ => Event.Closed(conn),
                })
            }
        }
    }

    /// Moves every byte that has arrived on the connection onto the end of `buf`, and returns
    /// how many there were.
    pub fn read(self, conn: Conn, buf: mut List<u8>) -> usize {
        unsafe {
            let n = cx_net_available(self.handle, conn.id)
            buf.reserve(n)
            let start = buf.len()
            let got = cx_net_read(self.handle, conn.id, buf.as_mut_ptr().add(start), n)
            buf.set_len(start + got)
            return got
        }
    }

    /// Queues the bytes to send on the connection. They go as soon as the socket takes them. On
    /// a connection that has closed, they're dropped.
    pub fn write(self, conn: Conn, bytes: List<u8>) {
        unsafe {
            cx_net_send(self.handle, conn.id, bytes.as_ptr(), bytes.len())
        }
    }

    /// Closes the connection once what was queued is sent. A poll reports `Closed` after.
    pub fn close(self, conn: Conn) {
        unsafe {
            cx_net_close(self.handle, conn.id)
        }
    }
}
