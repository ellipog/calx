/// MD5, SHA-1, SHA-256, SHA-384 and SHA-512, and HMAC with any of them (D118).
///
/// Vanilla uses MD5 for an offline player's UUID, SHA-1 for the server hash the session server
/// checks a login by, and SHA-256 for the seed it sends a joining player. Velocity signs the
/// player data it forwards with HMAC-SHA256. Scripts check what they download with SHA-256 and
/// SHA-512. They give what Java's `MessageDigest` and `Mac` and Python's `hashlib` and `hmac` give.
module std.hash

import std.fs.{FsError, open_read}

extern "C" {
    fn cx_digest_start(ctx: *u8, kind: u32)
    fn cx_digest_add(ctx: *u8, p: *const u8, n: usize)
    fn cx_digest_finish(ctx: *u8, out: *u8) -> usize
    fn cx_digest_hmac_sha256(key: *const u8, key_len: usize, msg: *const u8, msg_len: usize, out: *u8)
}

/// Which hash a `Digest` works out.
pub enum Algorithm {
    /// 16 bytes. Broken for security, but what `UUID.nameUUIDFromBytes` uses.
    Md5
    /// 20 bytes. Broken for security, but what Mojang's session server uses.
    Sha1
    /// 32 bytes.
    Sha256
    /// 48 bytes: SHA-512 cut short, from other starting values.
    Sha384
    /// 64 bytes.
    Sha512
}

impl Algorithm {
    /// How many bytes its hash is: 16, 20, 32, 48 or 64.
    pub fn len(self) -> usize {
        return match self {
            Md5 => 16,
            Sha1 => 20,
            Sha256 => 32,
            Sha384 => 48,
            Sha512 => 64,
        }
    }

    /// How many bytes it hashes at a time, which HMAC pads its key to: 128 for SHA-384 and
    /// SHA-512, and 64 for the others.
    pub fn block_len(self) -> usize {
        return match self {
            Sha384 | Sha512 => 128,
            _ => 64,
        }
    }
}

/// A hash being worked out: add bytes and text in any number of pieces, then `finish`. The pieces
/// give the same hash as all of them at once.
pub struct Digest {
    ctx: List<u8>,
}

impl Digest {
    pub fn new(algorithm: Algorithm) -> Digest {
        var ctx: List<u8> = [0; 224]
        let kind: u32 = match algorithm {
            Algorithm.Md5 => 0,
            Algorithm.Sha1 => 1,
            Algorithm.Sha256 => 2,
            Algorithm.Sha512 => 3,
            Algorithm.Sha384 => 4,
        }
        unsafe {
            cx_digest_start(ctx.as_mut_ptr(), kind)
        }
        return Digest { ctx: ctx }
    }

    /// Adds the bytes.
    pub fn add(mut self, bytes: List<u8>) {
        unsafe {
            cx_digest_add(self.ctx.as_mut_ptr(), bytes.as_ptr(), bytes.len())
        }
    }

    /// Adds the text's UTF-8 bytes.
    pub fn add_text(mut self, text: String) {
        unsafe {
            cx_digest_add(self.ctx.as_mut_ptr(), text.as_ptr(), text.len())
        }
    }

    /// The hash of everything added.
    pub fn finish(own self) -> List<u8> {
        var ctx = self.ctx
        var out: List<u8> = [0; 64]
        unsafe {
            let n = cx_digest_finish(ctx.as_mut_ptr(), out.as_mut_ptr())
            out.truncate(n)
        }
        return out
    }
}

/// The hash of the bytes with `algorithm`.
pub fn digest(algorithm: Algorithm, bytes: List<u8>) -> List<u8> {
    var d = Digest.new(algorithm)
    d.add(bytes)
    return d.finish()
}

/// The hash of the file at `path`, read a mebibyte at a time so a file of any size takes no more
/// memory than that, as Python's `hashlib.file_digest(f, name).digest()`. `std.bytes.hex` writes
/// it as `sha256sum` and `hexdigest` do.
pub fn file_digest(algorithm: Algorithm, path: String) -> List<u8> ! FsError {
    let f = try open_read(path)
    var d = Digest.new(algorithm)
    var at: u64 = 0
    loop {
        let chunk = try f.read_part(at, 1048576)
        if chunk.is_empty() {
            break
        }
        at += u64(chunk.len())
        d.add(chunk)
    }
    return d.finish()
}

/// The MD5 of the bytes, 16 of them.
pub fn md5(bytes: List<u8>) -> List<u8> {
    return digest(Algorithm.Md5, bytes)
}

/// The SHA-1 of the bytes, 20 of them.
pub fn sha1(bytes: List<u8>) -> List<u8> {
    return digest(Algorithm.Sha1, bytes)
}

/// The SHA-256 of the bytes, 32 of them.
pub fn sha256(bytes: List<u8>) -> List<u8> {
    return digest(Algorithm.Sha256, bytes)
}

/// The SHA-384 of the bytes, 48 of them.
pub fn sha384(bytes: List<u8>) -> List<u8> {
    return digest(Algorithm.Sha384, bytes)
}

/// The SHA-512 of the bytes, 64 of them.
pub fn sha512(bytes: List<u8>) -> List<u8> {
    return digest(Algorithm.Sha512, bytes)
}

/// The HMAC of the message under the key, with `algorithm`, as RFC 2104 makes it and Java's `Mac`
/// and Python's `hmac` give it: the hash of the key padded and xored with 0x5c, then of the key
/// padded and xored with 0x36 and the message. A key longer than a block is hashed first.
pub fn hmac(algorithm: Algorithm, key: List<u8>, message: List<u8>) -> List<u8> {
    let block = algorithm.block_len()
    var k = if key.len() > block { digest(algorithm, key) } else { key.copy() }
    while k.len() < block {
        k.push(0)
    }
    var inner = Digest.new(algorithm)
    inner.add(k.map(|b| b ^ 0x36))
    inner.add(message)
    var outer = Digest.new(algorithm)
    outer.add(k.map(|b| b ^ 0x5c))
    outer.add(inner.finish())
    return outer.finish()
}

/// The HMAC-SHA256 of the message under the key, 32 bytes, as Java's `Mac` "HmacSHA256" gives.
pub fn hmac_sha256(key: List<u8>, message: List<u8>) -> List<u8> {
    var out: List<u8> = [0; 32]
    unsafe {
        cx_digest_hmac_sha256(key.as_ptr(), key.len(), message.as_ptr(), message.len(), out.as_mut_ptr())
    }
    return out
}
