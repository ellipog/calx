/// NBT, the binary format Minecraft keeps its data in: `level.dat`, players' files, structures and
/// each chunk of a region file. Tags are read and written as vanilla 26.3's `NbtIo` reads and
/// writes them, files gzipped, zlib-compressed or plain, SNBT is read and written as its
/// `TagParser`, `toString` and pretty printer do, NBT paths are followed as its
/// `NbtPathArgument` does, and FTB's SNBT is read and written as FTB Library's `SNBT` class
/// does. A compound keeps its keys in the order they were read or put, as a
/// Python dict does, so the NBT of a file read and written back is the same, byte for byte.
module std.nbt

import std.bytes.{i16_be, i32_be, i64_be, put_i16_be, put_i32_be, put_i64_be, put_u16_be, put_u32_be, put_u64_be, u16_be, u32_be, u64_be}
import std.fs
import std.text.mutf8
import std.text.ucd.{JAVA_ALNUM, JAVA_ALNUM_LEN}
import std.unicode.names.{java_code_point_of}
import std.zlib

/// One NBT value: a number, a string, an array, a list of tags or a compound of named ones.
pub enum Tag {
    /// The tag that ends a compound in the binary format. `decode_any` gives it for a lone 0, as
    /// vanilla's `readAnyTag` gives its `EndTag`, which a packet sends for "no data"; nothing
    /// else holds one.
    End
    Byte(i8)
    Short(i16)
    Int(i32)
    Long(i64)
    Float(f32)
    Double(f64)
    ByteArray(List<i8>)
    String(String)
    /// Tags of any kinds. Vanilla's lists hold one kind, but since 1.21.5 a list of several is
    /// written as compounds, each holding its tag under the empty key, and read back as it was.
    List(List<Tag>)
    /// Named tags, in the order their keys were read or put.
    Compound(LinkedMap<String, Tag>)
    IntArray(List<i32>)
    LongArray(List<i64>)
}

/// Why bytes aren't NBT, said as vanilla says it where it says something.
pub enum NbtError {
    /// The bytes end before the tag does.
    Truncated
    /// A tag's kind, the byte at `at`, isn't one of NBT's 13.
    BadKind { kind: u8, at: usize }
    /// The string whose length is at `at` isn't Java's Modified UTF-8.
    BadString(usize)
    /// The length at `at` of a list or an array is below 0.
    NegativeLength { length: i32, at: usize }
    /// The list at `at` has elements but no kind for them: vanilla's "Missing type on ListTag".
    ListWithoutKind(usize)
    /// Lists and compounds nest more than 512 deep, at `at`: vanilla's limit.
    TooDeep(usize)
    /// The root isn't a compound, which a file's must be.
    NotCompound
    /// The gzip or zlib stream around the NBT is broken.
    Compressed(zlib.Error)
}

impl Display for NbtError {
    fn show(self) {
        match self {
            Truncated => print("the NBT ends early"),
            BadKind { kind, at } => print("byte {at}: {kind} isn't a kind of tag"),
            BadString(at) => print("byte {at}: a string that isn't Modified UTF-8"),
            NegativeLength { length, at } => print("byte {at}: a length of {length}"),
            ListWithoutKind(at) => print("byte {at}: a list with elements but no kind for them"),
            TooDeep(at) => print("byte {at}: lists and compounds nest more than 512 deep"),
            NotCompound => print("the root tag isn't a compound"),
            Compressed(e) => print("the compressed NBT is broken: {e}"),
        }
    }
}

/// How a file's NBT is compressed.
pub enum Compression {
    /// Not at all, as vanilla's `NbtIo.write` writes it.
    None
    /// Gzip, as `level.dat`, players' files and structures are, written by `NbtIo.writeCompressed`.
    Gzip
    /// Zlib, as most chunks in a region file are.
    Zlib
}

const END: u8 = 0
const BYTE: u8 = 1
const SHORT: u8 = 2
const INT: u8 = 3
const LONG: u8 = 4
const FLOAT: u8 = 5
const DOUBLE: u8 = 6
const BYTE_ARRAY: u8 = 7
const STRING: u8 = 8
const LIST: u8 = 9
const COMPOUND: u8 = 10
const INT_ARRAY: u8 = 11
const LONG_ARRAY: u8 = 12

/// How deep lists and compounds may nest, vanilla's `NbtAccounter` limit.
const MAX_DEPTH: usize = 512

// --- reading -------------------------------------------------------------------------------------

/// A tag as vanilla's `NbtIo.readAnyTag` reads it, as packets send it since 1.20.2: its kind,
/// then its value, with no name. Reads from `at`, and moves `at` past the tag.
pub fn decode_any(bytes: List<u8>, at: mut usize) -> Tag ! NbtError {
    try need(bytes, at, 1)
    let kind_at = at
    let kind = bytes[at]
    at += 1
    if kind == END {
        return Tag.End
    }
    var keys = new_keys()
    return try payload(bytes, mut at, kind, kind_at, 0, mut keys)
}

/// A named tag, as a file holds its root and vanilla's `NbtIo.read` reads it: its kind, its name,
/// then its value. Reads from `at`, and moves `at` past it. A lone 0, the end tag, has no name.
pub fn decode_named(bytes: List<u8>, at: mut usize) -> (String, Tag) ! NbtError {
    try need(bytes, at, 1)
    let kind_at = at
    let kind = bytes[at]
    at += 1
    if kind == END {
        return (String(), Tag.End)
    }
    let name = try read_string(bytes, mut at)
    var keys = new_keys()
    let tag = try payload(bytes, mut at, kind, kind_at, 0, mut keys)
    return (name, tag)
}

// The keys a read has met, in 256 places by a hash of their bytes. A file's compounds repeat the
// same few keys, so most are found here, interned: a copy costs no memory, and they aren't
// decoded again or freed with their compounds.
fn new_keys() -> List<String> {
    var keys = List<String>()
    keys.reserve(256)
    for _ in 0..256 {
        keys.push(String())
    }
    return keys
}

fn read_key(b: List<u8>, at: mut usize, keys: mut List<String>) -> String ! NbtError {
    try need(b, at, 2)
    let n = usize(u16_be(b, at))
    // Interning keeps text of 1 to 64 bytes.
    if n == 0 or n > 64 {
        return try read_string(b, mut at)
    }
    let from = at + 2
    try need(b, from, n)
    var h: u32 = 2166136261
    for i in from..from + n {
        h = (h ^ u32(b[i])).wrapping_mul(16777619)
    }
    let slot = usize(h >> 24)
    if keys[slot].len() == n {
        var same = true
        for i in 0..n {
            if keys[slot].byte_at(i) != b[from + i] {
                same = false
                break
            }
        }
        if same {
            at = from + n
            return keys[slot].copy()
        }
    }
    let k = (try read_string(b, mut at)).interned()
    keys[slot] = k.copy()
    return k
}

fn need(b: List<u8>, at: usize, n: usize) ! NbtError {
    if b.len() - at < n {
        fail NbtError.Truncated
    }
}

fn read_string(b: List<u8>, at: mut usize) -> String ! NbtError {
    try need(b, at, 2)
    let start = at
    let n = usize(u16_be(b, at))
    at += 2
    try need(b, at, n)
    let s = match mutf8.decode(b, at, at + n) {
        ok(s) => s,
        err(_) => fail NbtError.BadString(start),
    }
    at += n
    return s
}

// The length of a list or an array, at `at`, which must be 0 or more.
fn read_length(b: List<u8>, at: mut usize) -> usize ! NbtError {
    try need(b, at, 4)
    let n = i32_be(b, at)
    if n < 0 {
        fail NbtError.NegativeLength { length: n, at: at }
    }
    at += 4
    return usize.wrap(n)
}

// The value of a tag of `kind`, whose kind byte is at `kind_at`, `depth` lists and compounds in.
fn payload(b: List<u8>, at: mut usize, kind: u8, kind_at: usize, depth: usize, keys: mut List<String>) -> Tag ! NbtError {
    if kind == COMPOUND {
        return Tag.Compound(try read_compound(b, mut at, kind_at, depth, mut keys))
    }
    if kind == LIST {
        return Tag.List(try read_list(b, mut at, kind_at, depth, mut keys))
    }
    return try leaf(b, mut at, kind, kind_at)
}

// A tag that holds no tags. Lists and compounds build theirs in place, rather than through a
// `Tag ! NbtError` given back from each level, which cost a third of the time in copies.
fn leaf(b: List<u8>, at: mut usize, kind: u8, kind_at: usize) -> Tag ! NbtError {
    match kind {
        BYTE => {
            try need(b, at, 1)
            at += 1
            return Tag.Byte(i8.wrap(b[at - 1]))
        },
        SHORT => {
            try need(b, at, 2)
            at += 2
            return Tag.Short(i16_be(b, at - 2))
        },
        INT => {
            try need(b, at, 4)
            at += 4
            return Tag.Int(i32_be(b, at - 4))
        },
        LONG => {
            try need(b, at, 8)
            at += 8
            return Tag.Long(i64_be(b, at - 8))
        },
        FLOAT => {
            try need(b, at, 4)
            at += 4
            return Tag.Float(float_at(b, at - 4))
        },
        DOUBLE => {
            try need(b, at, 8)
            at += 8
            return Tag.Double(double_at(b, at - 8))
        },
        BYTE_ARRAY => {
            let n = try read_length(b, mut at)
            try need(b, at, n)
            var out = List<i8>()
            out.reserve(n)
            for i in at..at + n {
                out.push(i8.wrap(b[i]))
            }
            at += n
            return Tag.ByteArray(out)
        },
        STRING => return Tag.String(try read_string(b, mut at)),
        INT_ARRAY => {
            let n = try read_length(b, mut at)
            try need(b, at, n * 4)
            var out = List<i32>()
            out.reserve(n)
            for i in 0..n {
                out.push(i32_be(b, at + i * 4))
            }
            at += n * 4
            return Tag.IntArray(out)
        },
        LONG_ARRAY => {
            let n = try read_length(b, mut at)
            try need(b, at, n * 8)
            var out = List<i64>()
            out.reserve(n)
            for i in 0..n {
                out.push(i64_be(b, at + i * 8))
            }
            at += n * 8
            return Tag.LongArray(out)
        },
        _ => fail NbtError.BadKind { kind: kind, at: kind_at },
    }
}

// Vanilla's `FloatTag.valueOf` and `DoubleTag.valueOf` give their zero for -0.0, so -0.0 reads as 0.0.
fn float_at(b: List<u8>, at: usize) -> f32 {
    let f = f32.from_bits(u32_be(b, at))
    return if f == 0.0 { 0.0 } else { f }
}

fn double_at(b: List<u8>, at: usize) -> f64 {
    let d = f64.from_bits(u64_be(b, at))
    return if d == 0.0 { 0.0 } else { d }
}

// A compound's tags, up to its end tag, whose kind byte is at `kind_at`.
fn read_compound(b: List<u8>, at: mut usize, kind_at: usize, depth: usize, keys: mut List<String>) -> LinkedMap<String, Tag> ! NbtError {
    if depth >= MAX_DEPTH {
        fail NbtError.TooDeep(kind_at)
    }
    var m = LinkedMap<String, Tag>()
    loop {
        try need(b, at, 1)
        let k_at = at
        let k = b[at]
        at += 1
        if k == END {
            break
        }
        if k > LONG_ARRAY {
            fail NbtError.BadKind { kind: k, at: k_at }
        }
        let name = try read_key(b, mut at, mut keys)
        if k == COMPOUND {
            m.insert(name, Tag.Compound(try read_compound(b, mut at, k_at, depth + 1, mut keys)))
        } else if k == LIST {
            m.insert(name, Tag.List(try read_list(b, mut at, k_at, depth + 1, mut keys)))
        } else {
            m.insert(name, try leaf(b, mut at, k, k_at))
        }
    }
    return m
}

// A list's tags, whose kind byte is at `kind_at`. Numbers are read in a loop of their own, once
// there are bytes enough for all of them.
fn read_list(b: List<u8>, at: mut usize, kind_at: usize, depth: usize, keys: mut List<String>) -> List<Tag> ! NbtError {
    if depth >= MAX_DEPTH {
        fail NbtError.TooDeep(kind_at)
    }
    try need(b, at, 1)
    let elem_at = at
    let elem = b[at]
    at += 1
    let n = try read_length(b, mut at)
    if elem == END and n > 0 {
        fail NbtError.ListWithoutKind(kind_at)
    }
    // An empty list's kind isn't looked at, as vanilla doesn't look.
    var items = List<Tag>()
    if n == 0 {
        return items
    }
    if elem > LONG_ARRAY {
        fail NbtError.BadKind { kind: elem, at: elem_at }
    }
    // Each element takes a byte at least, so a length past what's left is cut short.
    items.reserve(if n < b.len() - at { n } else { b.len() - at })
    let size: usize = match elem {
        BYTE => 1,
        SHORT => 2,
        INT => 4,
        FLOAT => 4,
        LONG => 8,
        DOUBLE => 8,
        _ => 0,
    }
    if size > 0 {
        try need(b, at, n * size)
        // A loop for each kind, so each builds its one variant straight into the list.
        let p = at
        at += n * size
        match elem {
            BYTE => {
                for i in 0..n {
                    items.push(Tag.Byte(i8.wrap(b[p + i])))
                }
            },
            SHORT => {
                for i in 0..n {
                    items.push(Tag.Short(i16_be(b, p + i * 2)))
                }
            },
            INT => {
                for i in 0..n {
                    items.push(Tag.Int(i32_be(b, p + i * 4)))
                }
            },
            FLOAT => {
                for i in 0..n {
                    items.push(Tag.Float(float_at(b, p + i * 4)))
                }
            },
            LONG => {
                for i in 0..n {
                    items.push(Tag.Long(i64_be(b, p + i * 8)))
                }
            },
            _ => {
                for i in 0..n {
                    items.push(Tag.Double(double_at(b, p + i * 8)))
                }
            },
        }
        return items
    }
    if elem == COMPOUND {
        for _ in 0..n {
            var m = try read_compound(b, mut at, elem_at, depth + 1, mut keys)
            // A list of several kinds is written as compounds each holding a tag under the
            // empty key, and read back unwrapped, as vanilla's `addAndUnwrap` does.
            if is_wrapper(m) {
                items.push(m.remove("")!)
            } else {
                items.push(Tag.Compound(m))
            }
        }
    } else if elem == LIST {
        for _ in 0..n {
            items.push(Tag.List(try read_list(b, mut at, elem_at, depth + 1, mut keys)))
        }
    } else {
        for _ in 0..n {
            items.push(try leaf(b, mut at, elem, elem_at))
        }
    }
    return items
}

// Whether `m` is a wrapper: one tag, under the empty key.
fn is_wrapper(m: LinkedMap<String, Tag>) -> bool {
    return m.len() == 1 and m.contains("")
}

// --- writing -------------------------------------------------------------------------------------

/// Adds `tag` to `out` as vanilla's `NbtIo.writeAnyTag` writes it, as packets send it: its kind,
/// then its value, with no name. `Tag.End` is the one byte 0.
pub fn encode_any(tag: Tag, out: mut List<u8>) {
    out.push(tag.id())
    if tag.id() != END {
        put_payload(tag, mut out)
    }
}

/// Adds `tag` to `out` named `name`, as a file holds its root: its kind, its name, then its value.
/// Vanilla's `NbtIo.write` writes a compound so, with the empty name.
pub fn encode_named(name: String, tag: Tag, out: mut List<u8>) {
    out.push(tag.id())
    if tag.id() != END {
        put_string(name, mut out)
        put_payload(tag, mut out)
    }
}

fn put_string(s: String, out: mut List<u8>) {
    let n = mutf8.encoded_len(s)
    if n > 65535 {
        panic("NBT can't hold a string of {n} bytes in Modified UTF-8, past 65535, as Java's writeUTF can't")
    }
    put_u16_be(mut out, u16.wrap(n))
    mutf8.encode(s, mut out)
}

// How a list is written: its elements' kind, and whether each goes in a wrapper compound, as
// vanilla writes a list of several kinds, or of compounds one of which is itself a wrapper.
fn list_kind(items: List<Tag>) -> (u8, bool) {
    if items.is_empty() {
        return (END, false)
    }
    let first = items[0].id()
    var wrap = false
    for item in items {
        if item.id() != first {
            return (COMPOUND, true)
        }
        if let Compound(m) = item {
            wrap = wrap or is_wrapper(m)
        }
    }
    return (first, wrap)
}

fn put_payload(tag: Tag, out: mut List<u8>) {
    match tag {
        End => panic("an end tag can't be in a list or a compound"),
        Byte(v) => out.push(u8.wrap(v)),
        Short(v) => put_i16_be(mut out, v),
        Int(v) => put_i32_be(mut out, v),
        Long(v) => put_i64_be(mut out, v),
        // Java's `writeFloat` and `writeDouble` write every NaN as the one NaN.
        Float(v) => put_u32_be(mut out, if v.is_nan() { 0x7FC00000u32 } else { v.to_bits() }),
        Double(v) => put_u64_be(mut out, if v.is_nan() { 0x7FF8000000000000u64 } else { v.to_bits() }),
        ByteArray(v) => {
            put_i32_be(mut out, i32.wrap(v.len()))
            out.reserve(v.len())
            for x in v {
                out.push(u8.wrap(x))
            }
        },
        String(s) => put_string(s, mut out),
        List(items) => {
            let (kind, wrap) = list_kind(items)
            out.push(kind)
            put_i32_be(mut out, i32.wrap(items.len()))
            for item in items {
                if not wrap {
                    put_payload(item, mut out)
                    continue
                }
                if let Compound(m) = item {
                    if not is_wrapper(m) {
                        put_payload(item, mut out)
                        continue
                    }
                }
                if item.id() == END {
                    panic("an end tag can't be in a list or a compound")
                }
                out.push(item.id())
                out.push(0)
                out.push(0)
                put_payload(item, mut out)
                out.push(END)
            }
        },
        Compound(m) => {
            for (k, v) in m {
                if v.id() == END {
                    panic("an end tag can't be in a list or a compound")
                }
                out.push(v.id())
                put_string(k, mut out)
                put_payload(v, mut out)
            }
            out.push(END)
        },
        IntArray(v) => {
            put_i32_be(mut out, i32.wrap(v.len()))
            out.reserve(v.len() * 4)
            for x in v {
                put_i32_be(mut out, x)
            }
        },
        LongArray(v) => {
            put_i32_be(mut out, i32.wrap(v.len()))
            out.reserve(v.len() * 8)
            for x in v {
                put_i64_be(mut out, x)
            }
        },
    }
}

// --- files ---------------------------------------------------------------------------------------

/// An NBT file: its root compound, the root's name, and how it's compressed.
pub struct NbtFile {
    /// The root's name, which is empty in what vanilla writes, and which it ignores when it reads.
    pub name: String
    /// The root, a `Tag.Compound`.
    pub root: Tag
    /// How the file was compressed when read, and how `encode` and `save` compress it.
    pub compression: Compression
}

impl NbtFile {
    /// A file of `root`, a compound, named "" and gzipped, as vanilla's `writeCompressed` writes one.
    pub fn new(root: own Tag) -> NbtFile {
        return NbtFile { name: String(), root: root, compression: Compression.Gzip }
    }

    /// The NBT file at `path`, gzipped, zlib-compressed or plain, told apart by their first bytes.
    pub fn open(path: String) -> NbtFile ! Error {
        let bytes = try fs.read(path.copy()).context("reading {path}")
        return match NbtFile.decode(bytes) {
            ok(f) => f,
            err(e) => fail "reading {path}: {e}",
        }
    }

    /// The NBT file in `bytes`: gzip if they start `1F 8B`, zlib if they start with a zlib header,
    /// and plain otherwise. Its root must be a compound, as vanilla's `NbtIo.read` wants. Bytes
    /// after the root are ignored, as vanilla ignores them.
    pub fn decode(bytes: List<u8>) -> NbtFile ! NbtError {
        let compression = compression_of(bytes)
        var at: usize = 0
        let (name, root) = match compression {
            Compression.None => try decode_named(bytes, mut at),
            Compression.Gzip => try decode_named(try inflate(bytes, zlib.Format.Gzip), mut at),
            Compression.Zlib => try decode_named(try inflate(bytes, zlib.Format.Zlib), mut at),
        }
        if root.id() != COMPOUND {
            fail NbtError.NotCompound
        }
        return NbtFile { name: name, root: root, compression: compression }
    }

    /// The file's bytes, compressed as `compression` says, gzip and zlib at level 6, as Java's
    /// streams compress by default.
    pub fn encode(self) -> List<u8> {
        var out = List<u8>()
        encode_named(self.name, self.root, mut out)
        return match self.compression {
            Compression.None => out,
            Compression.Gzip => zlib.compress(out, zlib.Format.Gzip, 6),
            Compression.Zlib => zlib.compress(out, zlib.Format.Zlib, 6),
        }
    }

    /// Writes the file to `path`.
    pub fn save(self, path: String) ! Error {
        try fs.write(path.copy(), self.encode()).context("writing {path}")
    }
}

fn compression_of(b: List<u8>) -> Compression {
    if b.len() >= 2 and b[0] == 0x1F and b[1] == 0x8B {
        return Compression.Gzip
    }
    if b.len() >= 2 and b[0] % 16 == 8 and b[0] / 16 <= 7 and (u32(b[0]) * 256 + u32(b[1])) % 31 == 0 {
        return Compression.Zlib
    }
    return Compression.None
}

fn inflate(b: List<u8>, format: zlib.Format) -> List<u8> ! NbtError {
    // Deflate makes at most 1032 bytes of each, so this limit is none.
    return match zlib.decompress(b, format, b.len() * 1032 + 1024) {
        ok(out) => out,
        err(e) => fail NbtError.Compressed(e),
    }
}

// --- reading values ------------------------------------------------------------------------------

impl Tag {
    /// The kind's number in the binary format: 0 for an end tag, 1 for a byte, up to 12 for a long
    /// array.
    pub fn id(self) -> u8 {
        return match self {
            End => END,
            Byte(_) => BYTE,
            Short(_) => SHORT,
            Int(_) => INT,
            Long(_) => LONG,
            Float(_) => FLOAT,
            Double(_) => DOUBLE,
            ByteArray(_) => BYTE_ARRAY,
            String(_) => STRING,
            List(_) => LIST,
            Compound(_) => COMPOUND,
            IntArray(_) => INT_ARRAY,
            LongArray(_) => LONG_ARRAY,
        }
    }

    /// The kind's name, as vanilla's `TagType.getName` gives it: `BYTE`, `INT[]`, `COMPOUND`.
    pub fn kind_name(self) -> String {
        return match self {
            End => "END",
            Byte(_) => "BYTE",
            Short(_) => "SHORT",
            Int(_) => "INT",
            Long(_) => "LONG",
            Float(_) => "FLOAT",
            Double(_) => "DOUBLE",
            ByteArray(_) => "BYTE[]",
            String(_) => "STRING",
            List(_) => "LIST",
            Compound(_) => "COMPOUND",
            IntArray(_) => "INT[]",
            LongArray(_) => "LONG[]",
        }
    }

    /// A copy of the tag at `key`, if this is a compound that has one. A `match` on the tag reads
    /// it in place instead, without the copy.
    pub fn get(self, key: String) -> Tag? {
        return match self {
            Compound(m) => if m.contains(key) { some(m[key].copy()) } else { none },
            _ => none,
        }
    }

    /// A copy of element `i`, if this is a list that long.
    pub fn at(self, i: usize) -> Tag? {
        return match self {
            List(items) => if i < items.len() { some(items[i].copy()) } else { none },
            _ => none,
        }
    }

    /// The number, if this is a byte, a short, an int or a long.
    pub fn as_int(self) -> i64? {
        return match self {
            Byte(v) => some(i64(v)),
            Short(v) => some(i64(v)),
            Int(v) => some(i64(v)),
            Long(v) => some(v),
            _ => none,
        }
    }

    /// The number, if this is one of any kind, as the nearest `f64`.
    pub fn as_float(self) -> f64? {
        return match self {
            Byte(v) => some(f64(v)),
            Short(v) => some(f64(v)),
            Int(v) => some(f64(v)),
            Long(v) => some(f64.nearest(v)),
            Float(v) => some(f64(v)),
            Double(v) => some(v),
            _ => none,
        }
    }

    /// Whether the number isn't 0, if this is a byte, a short, an int or a long. NBT keeps a
    /// boolean as a byte, 1 or 0.
    pub fn as_bool(self) -> bool? {
        return match self.as_int() {
            some(v) => some(v != 0),
            none => none,
        }
    }

    /// The text, if this is a string.
    pub fn as_str(self) -> String? {
        return match self {
            String(s) => some(s.copy()),
            _ => none,
        }
    }

    /// How many tags a list or a compound holds, or numbers an array does. Anything else holds none.
    pub fn len(self) -> usize {
        return match self {
            ByteArray(v) => v.len(),
            List(items) => items.len(),
            Compound(m) => m.len(),
            IntArray(v) => v.len(),
            LongArray(v) => v.len(),
            _ => 0,
        }
    }

    /// A compound's keys, in order, or none for anything else.
    pub fn keys(self) -> List<String> {
        var out = List<String>()
        if let Compound(m) = self {
            out.reserve(m.len())
            for (k, _) in m {
                out.push(k.copy())
            }
        }
        return out
    }

    // --- changing ---

    /// Puts `value` at `key`, if this is a compound, and says whether it is. A key that's there
    /// keeps its place and gets the new value.
    pub fn insert(mut self, key: own String, value: own Tag) -> bool {
        if let Compound(m) = mut self {
            m.insert(key, value)
            return true
        }
        return false
    }

    /// Takes the tag at `key` out, if this is a compound that has one.
    pub fn remove(mut self, key: String) -> Tag? {
        if let Compound(m) = mut self {
            return m.remove(key)
        }
        return none
    }

    /// Adds `value` at the end, if this is a list, and says whether it is.
    pub fn push(mut self, value: own Tag) -> bool {
        if let List(items) = mut self {
            items.push(value)
            return true
        }
        return false
    }

    // --- SNBT ---

    /// The tag as SNBT, as vanilla's `Tag.toString` writes it: compact, with a compound's keys in
    /// Java's order of strings and quoted only where they must be, and each number with its
    /// kind's letter: `{Count:1b,id:"minecraft:stone",Pos:[1.5d,64.0d,-3.0d]}`.
    pub fn to_snbt(self) -> String {
        var out = String()
        write_snbt(self, mut out)
        return out
    }

    /// The tag as SNBT laid out to be read, as vanilla's `SnbtPrinterTagVisitor` writes it, and
    /// so the `.snbt` files of structures: four spaces a level, `key: value`, and a compound's keys
    /// in Java's order of strings. A structure's keys come in the order vanilla gives them, and
    /// its blocks, palette and entities one to a line.
    pub fn to_pretty_snbt(self) -> String {
        var out = String()
        write_pretty(self, AT_ROOT, 0, false, mut out)
        return out
    }
}

/// `{tag}` is the tag as SNBT, as `to_snbt` writes it.
impl Display for Tag {
    fn show(self) {
        print(self.to_snbt())
    }
}

// --- SNBT ----------------------------------------------------------------------------------------

fn write_snbt(tag: Tag, out: mut String) {
    match tag {
        End => out.push_str("END"),
        Byte(v) => out.push_str("{v}b"),
        Short(v) => out.push_str("{v}s"),
        Int(v) => out.push_str("{v}"),
        Long(v) => out.push_str("{v}L"),
        Float(v) => out.push_str("{v}f"),
        Double(v) => out.push_str("{v}d"),
        ByteArray(v) => {
            out.push_str("[B;")
            for i in 0..v.len() {
                if i > 0 {
                    out.push(',')
                }
                out.push_str("{v[i]}B")
            }
            out.push(']')
        },
        String(s) => quote(s, mut out),
        List(items) => {
            out.push('[')
            for i in 0..items.len() {
                if i > 0 {
                    out.push(',')
                }
                write_snbt(items[i], mut out)
            }
            out.push(']')
        },
        Compound(m) => {
            var keys = List<String>()
            keys.reserve(m.len())
            var wide = false
            for (k, _) in m {
                keys.push(k.copy())
                wide = wide or has_wide_rune(k)
            }
            // Java orders strings by their UTF-16 units, which is the order of their UTF-8 bytes
            // but where a rune past U+FFFF meets one from U+E000 to U+FFFF.
            if wide {
                keys.sort_by(|a, b| java_order(a, b))
            } else {
                keys.sort()
            }
            out.push('{')
            for i in 0..keys.len() {
                if i > 0 {
                    out.push(',')
                }
                write_key(keys[i], mut out)
                out.push(':')
                write_snbt(m[keys[i]], mut out)
            }
            out.push('}')
        },
        IntArray(v) => {
            out.push_str("[I;")
            for i in 0..v.len() {
                if i > 0 {
                    out.push(',')
                }
                out.push_str("{v[i]}")
            }
            out.push(']')
        },
        LongArray(v) => {
            out.push_str("[L;")
            for i in 0..v.len() {
                if i > 0 {
                    out.push(',')
                }
                out.push_str("{v[i]}L")
            }
            out.push(']')
        },
    }
}

fn has_wide_rune(s: String) -> bool {
    for i in 0..s.len() {
        if s.byte_at(i) >= 0xF0 {
            return true
        }
    }
    return false
}

// Java's `String.compareTo`: by UTF-16 units.
fn java_order(a: String, b: String) -> Ordering {
    var x = List<char>()
    for c in a.chars() {
        x.push(c)
    }
    var y = List<char>()
    for c in b.chars() {
        y.push(c)
    }
    return x.cmp(y)
}

// A key as vanilla writes it: bare if it's letters, digits and `._+-`, starting with a letter,
// `.` or `_`, and isn't `true` or `false` in any case; quoted otherwise.
fn write_key(k: String, out: mut String) {
    if bare_key(k) {
        out.push_str(k)
    } else {
        quote(k, mut out)
    }
}

fn bare_key(k: String) -> bool {
    if k.is_empty() {
        return false
    }
    for i in 0..k.len() {
        let c = k.byte_at(i)
        let letter = (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or c == b'.' or c == b'_'
        if not letter and (i == 0 or not ((c >= b'0' and c <= b'9') or c == b'+' or c == b'-')) {
            return false
        }
    }
    let low = k.to_lower_root()
    return low != "true" and low != "false"
}

// `s` in quotes, as vanilla's `StringTag.quoteAndEscape` writes it: in `"`, or in `'` if the first
// quote in it is `"`, with that quote, `\` and control characters escaped.
fn quote(s: String, out: mut String) {
    var q: u8 = 0
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if c == b'"' {
            q = b'\''
            break
        }
        if c == b'\'' {
            q = b'"'
            break
        }
    }
    if q == 0 {
        q = b'"'
    }
    out.push(rune(q))
    var from: usize = 0
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if c >= 0x20 and c != q and c != b'\\' {
            continue
        }
        out.push_str(s[from..i])
        from = i + 1
        if c == q or c == b'\\' {
            out.push('\\')
            out.push(rune(c))
        } else if c == 8 {
            out.push_str("\\b")
        } else if c == 9 {
            out.push_str("\\t")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c == 12 {
            out.push_str("\\f")
        } else if c == 13 {
            out.push_str("\\r")
        } else {
            out.push_str("\\x")
            out.push(hex_digit(c / 16))
            out.push(hex_digit(c % 16))
        }
    }
    out.push_str(s[from..s.len()])
    out.push(rune(q))
}

fn hex_digit(v: u8) -> rune {
    return rune(if v < 10 { v + 48 } else { v + 55 })
}

// --- SNBT laid out -------------------------------------------------------------------------------

// Where a tag is, as far as the layout cares. Vanilla names places by paths, `{}` for a compound,
// `[]` for a list and keys between, and lays out five of a structure's differently: `{}` itself,
// `{}.size.[]`, and each of `{}.data.[].{}`, `{}.palette.[].{}` and `{}.entities.[].{}`.
const AT_ROOT: u8 = 0
const AT_OTHER: u8 = 1
const AT_SIZE: u8 = 2
const AT_DATA: u8 = 3
const AT_PALETTE: u8 = 4
const AT_ENTITIES: u8 = 5
const AT_BLOCK: u8 = 6
const AT_PALETTE_ENTRY: u8 = 7
const AT_ENTITY: u8 = 8

// `place` is where the tag is, and `flat` whether it goes on one line.
fn write_pretty(tag: Tag, place: u8, level: usize, flat: bool, out: mut String) {
    match tag {
        List(items) => {
            if items.is_empty() {
                out.push_str("[]")
                return
            }
            let one_line = flat or place == AT_SIZE
            let inner = if place == AT_DATA { AT_BLOCK } else if place == AT_PALETTE { AT_PALETTE_ENTRY } else if place == AT_ENTITIES { AT_ENTITY } else { AT_OTHER }
            out.push('[')
            for i in 0..items.len() {
                if i > 0 {
                    out.push(',')
                    if one_line {
                        out.push(' ')
                    }
                }
                if not one_line {
                    out.push('\n')
                    push_indent(level + 1, mut out)
                }
                write_pretty(items[i], inner, level + 1, one_line, mut out)
            }
            if not one_line {
                out.push('\n')
                push_indent(level, mut out)
            }
            out.push(']')
        },
        Compound(m) => {
            if m.len() == 0 {
                out.push_str("\{\}")
                return
            }
            let keys = pretty_order(m, place)
            let one_line = flat or place == AT_BLOCK or place == AT_PALETTE_ENTRY or place == AT_ENTITY
            out.push('{')
            var first = true
            for k in keys {
                if not first {
                    out.push(',')
                    if one_line {
                        out.push(' ')
                    }
                }
                first = false
                if not one_line {
                    out.push('\n')
                    push_indent(level + 1, mut out)
                }
                if pretty_bare(k) {
                    out.push_str(k)
                } else {
                    quote(k, mut out)
                }
                out.push_str(": ")
                var inner = AT_OTHER
                if place == AT_ROOT {
                    inner = if k == "size" { AT_SIZE } else if k == "data" { AT_DATA } else if k == "palette" { AT_PALETTE } else if k == "entities" { AT_ENTITIES } else { AT_OTHER }
                }
                write_pretty(m[k], inner, level + 1, one_line, mut out)
            }
            if not one_line {
                out.push('\n')
                push_indent(level, mut out)
            }
            out.push('}')
        },
        ByteArray(v) => {
            out.push_str("[B;")
            for i in 0..v.len() {
                out.push_str(if i == 0 { " " } else { ", " })
                out.push_str("{v[i]}B")
            }
            out.push(']')
        },
        IntArray(v) => {
            out.push_str("[I;")
            for i in 0..v.len() {
                out.push_str(if i == 0 { " " } else { ", " })
                out.push_str("{v[i]}")
            }
            out.push(']')
        },
        LongArray(v) => {
            out.push_str("[L;")
            for i in 0..v.len() {
                out.push_str(if i == 0 { " " } else { ", " })
                out.push_str("{v[i]}L")
            }
            out.push(']')
        },
        _ => write_snbt(tag, mut out),
    }
}

fn push_indent(level: usize, out: mut String) {
    for _ in 0..level {
        out.push_str("    ")
    }
}

// A compound's keys in the order the layout writes them: a structure's own keys first, in the
// order vanilla gives them, then the rest in Java's order.
fn pretty_order(m: LinkedMap<String, Tag>, place: u8) -> List<String> {
    var first = List<String>()
    if place == AT_ROOT {
        first = [String("DataVersion"), String("author"), String("size"), String("data"), String("entities"), String("palette"), String("palettes")]
    } else if place == AT_BLOCK {
        first = [String("pos"), String("state"), String("nbt")]
    } else if place == AT_ENTITY {
        first = [String("blockPos"), String("pos")]
    }
    var out = List<String>()
    out.reserve(m.len())
    for k in first {
        if m.contains(k) {
            out.push(k.copy())
        }
    }
    let from = out.len()
    var wide = false
    for (k, _) in m {
        if first.is_empty() or not first.contains(k) {
            out.push(k.copy())
            wide = wide or has_wide_rune(k)
        }
    }
    if from == 0 {
        if wide {
            out.sort_by(|a, b| java_order(a, b))
        } else {
            out.sort()
        }
        return out
    }
    var rest = out[from..]
    if wide {
        rest.sort_by(|a, b| java_order(a, b))
    } else {
        rest.sort()
    }
    out.truncate(from)
    out.extend(rest)
    return out
}

// The layout leaves a key bare if it's letters, digits and `._+-`, whatever it starts with.
fn pretty_bare(k: String) -> bool {
    if k.is_empty() {
        return false
    }
    for i in 0..k.len() {
        if not bare_char(k.byte_at(i)) {
            return false
        }
    }
    return true
}

fn bare_char(c: u8) -> bool {
    return (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'_' or c == b'-' or c == b'.' or c == b'+'
}

// --- SNBT parsing --------------------------------------------------------------------------------

/// Why text isn't SNBT, and where.
pub struct SnbtError {
    pub message: String
    /// The line, from 1.
    pub line: usize
    /// The rune on the line, from 1.
    pub column: usize
}

impl Display for SnbtError {
    fn show(self) {
        print("line {self.line}, column {self.column}: {self.message}")
    }
}

/// The tag in `text`, which is SNBT as vanilla 26.3's `TagParser` reads it in commands and
/// `.snbt` files, with white space around it. That's numbers with their kind's letter, hex and
/// binary integers, `_` between digits, strings quoted either way or bare, `true` and `false`,
/// `bool(...)` and `uuid(...)`, arrays, lists of any kinds and compounds.
pub fn parse_snbt(text: String) -> Tag ! SnbtError {
    var at: usize = 0
    var keys = new_keys()
    let tag = try snbt_value(text, mut at, 0, mut keys)
    skip_white(text, mut at)
    if at < text.len() {
        fail snbt_error(text, at, "{found(text, at)} after the tag, where the text should end")
    }
    return tag
}

fn snbt_error(t: String, at: usize, message: own String) -> SnbtError {
    var line: usize = 1
    var start: usize = 0
    for i in 0..at {
        if t.byte_at(i) == 10 {
            line += 1
            start = i + 1
        }
    }
    var column: usize = 1
    for i in start..at {
        if (t.byte_at(i) & 0xC0) != 0x80 {
            column += 1
        }
    }
    return SnbtError { message: message, line: line, column: column }
}

// What's at byte `at`, for an error: the rune in backquotes, its number if it can't be seen,
// such as a no-break space, or the end.
fn found(t: String, at: usize) -> String {
    if at >= t.len() {
        return "the end"
    }
    let b = t.byte_at(at)
    let n: usize = if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
    let s = t[at..at + n]
    var r: u32 = if n == 1 { u32(b) } else if n == 2 { u32(b & 0x1F) } else if n == 3 { u32(b & 0x0F) } else { u32(b & 0x07) }
    for i in 1..n {
        r = (r << 6) | u32(t.byte_at(at + i) & 0x3F)
    }
    if r < 0x20 or (r >= 0x7F and r <= 0xA0) or r == 0xAD or (r >= 0x2000 and r <= 0x200F) or (r >= 0x2028 and r <= 0x202F) or (r >= 0x205F and r <= 0x2064) or r == 0x3000 or r == 0xFEFF {
        return "U+{hex4(r)}"
    }
    return "`{s}`"
}

fn hex4(v: u32) -> String {
    var out = String()
    for i in 0u32..4 {
        out.push(hex_digit(u8.wrap((v >> (12 - 4 * i)) & 15)))
    }
    return out
}

fn skip_white(t: String, at: mut usize) {
    // Most bytes are printable ASCII, which isn't white space, and this much goes inline.
    if at < t.len() {
        let b = t.byte_at(at)
        if b > 32 and b < 0x80 {
            return
        }
    }
    skip_white_slow(t, mut at)
}

fn skip_white_slow(t: String, at: mut usize) {
    while at < t.len() {
        let b = t.byte_at(at)
        if b == 32 or (b >= 9 and b <= 13) or (b >= 28 and b <= 31) {
            at += 1
            continue
        }
        if b < 0x80 {
            return
        }
        let n = white_len(t, at)
        if n == 0 {
            return
        }
        at += n
    }
}

// How many bytes the white space at `at` takes, or 0 if there's none: Java's
// `Character.isWhitespace`, which is what vanilla skips, and which isn't true of no-break spaces.
fn white_len(t: String, at: usize) -> usize {
    let b = t.byte_at(at)
    if b == 32 or (b >= 9 and b <= 13) or (b >= 28 and b <= 31) {
        return 1
    }
    if b < 0xE1 or b > 0xE3 or t.len() - at < 3 {
        return 0
    }
    let b1 = t.byte_at(at + 1)
    let b2 = t.byte_at(at + 2)
    if b == 0xE1 {
        return if b1 == 0x9A and b2 == 0x80 { 3 } else { 0 }
    }
    if b == 0xE3 {
        return if b1 == 0x80 and b2 == 0x80 { 3 } else { 0 }
    }
    // U+2000 to U+200A but U+2007, a figure space that doesn't break, then U+2028, U+2029 and U+205F.
    if b1 == 0x80 {
        return if (b2 >= 0x80 and b2 <= 0x8A and b2 != 0x87) or b2 == 0xA8 or b2 == 0xA9 { 3 } else { 0 }
    }
    return if b1 == 0x81 and b2 == 0x9F { 3 } else { 0 }
}

// Where the white space at `at` ends.
fn past_white(t: String, at: usize) -> usize {
    var k = at
    skip_white(t, mut k)
    return k
}

fn is_digit(c: u8) -> bool {
    return c >= b'0' and c <= b'9'
}

fn is_letter(c: u8) -> bool {
    return (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

// Whether the bytes from `from` to `to` are `word`, in any case.
fn is_word(t: String, from: usize, to: usize, word: str) -> bool {
    if to - from != word.len() {
        return false
    }
    for i in 0..word.len() {
        var c = t.byte_at(from + i)
        if c >= b'A' and c <= b'Z' {
            c += 32
        }
        if c != word.byte_at(i) {
            return false
        }
    }
    return true
}

// A tag that's `depth` lists, compounds and operations in.
fn snbt_value(t: String, at: mut usize, depth: usize, keys: mut List<String>) -> Tag ! SnbtError {
    skip_white(t, mut at)
    if at >= t.len() {
        fail snbt_error(t, at, "the end, where a tag should be")
    }
    let c = t.byte_at(at)
    if c == b'{' or c == b'[' {
        if depth >= MAX_DEPTH {
            fail snbt_error(t, at, "lists and compounds nest more than 512 deep")
        }
        if c == b'[' {
            return try snbt_list(t, mut at, depth + 1, mut keys)
        }
        return Tag.Compound(try snbt_compound(t, mut at, depth + 1, mut keys))
    }
    if c == b'"' or c == b'\'' {
        return Tag.String(try snbt_quoted(t, mut at))
    }
    if is_digit(c) or c == b'-' or c == b'+' or c == b'.' {
        return try snbt_number(t, mut at, 32)
    }
    if not is_letter(c) and c != b'_' {
        fail snbt_error(t, at, "{found(t, at)}, where a tag should be")
    }
    // A bare word: a string, `true` or `false` in any case, or an operation's name.
    let start = at
    while at < t.len() and bare_char(t.byte_at(at)) {
        at += 1
    }
    let end = at
    skip_white(t, mut at)
    if at < t.len() and t.byte_at(at) == b'(' {
        return try snbt_operation(t, mut at, t[start..end], start, depth, mut keys)
    }
    at = end
    if is_word(t, start, end, "true") {
        return Tag.Byte(1)
    }
    if is_word(t, start, end, "false") {
        return Tag.Byte(0)
    }
    return Tag.String(t[start..end])
}

// A list, or an array if a kind's letter and `;` start it.
fn snbt_list(t: String, at: mut usize, depth: usize, keys: mut List<String>) -> Tag ! SnbtError {
    at += 1
    skip_white(t, mut at)
    if at < t.len() {
        let k = t.byte_at(at)
        if k == b'B' or k == b'I' or k == b'L' {
            let after = past_white(t, at + 1)
            if after < t.len() and t.byte_at(after) == b';' {
                at = after + 1
                return try snbt_array(t, mut at, k)
            }
        }
    }
    var items = List<Tag>()
    if at < t.len() and t.byte_at(at) == b']' {
        at += 1
        return Tag.List(items)
    }
    loop {
        items.push(try snbt_value(t, mut at, depth, mut keys))
        if try snbt_next(t, mut at, b']', "a list") {
            break
        }
    }
    return Tag.List(items)
}

// After an element: true at the closing bracket, which may follow a last comma, and false at a
// comma with more after it.
fn snbt_next(t: String, at: mut usize, close: u8, what: String) -> bool ! SnbtError {
    skip_white(t, mut at)
    if at < t.len() and t.byte_at(at) == b',' {
        at += 1
        skip_white(t, mut at)
        if at < t.len() and t.byte_at(at) == close {
            at += 1
            return true
        }
        return false
    }
    if at < t.len() and t.byte_at(at) == close {
        at += 1
        return true
    }
    fail snbt_error(t, at, "{found(t, at)} in {what}, where `,` or `{rune(close)}` should be")
}

// An array's integers, after its `;`. One without a letter takes the array's kind, and one with
// its letter may be of a narrower kind.
fn snbt_array(t: String, at: mut usize, kind: u8) -> Tag ! SnbtError {
    let bits: u32 = if kind == b'B' { 8 } else if kind == b'I' { 32 } else { 64 }
    var bytes = List<i8>()
    var ints = List<i32>()
    var longs = List<i64>()
    skip_white(t, mut at)
    if at < t.len() and t.byte_at(at) == b']' {
        at += 1
    } else {
        loop {
            skip_white(t, mut at)
            let el_at = at
            if at >= t.len() or not (is_digit(t.byte_at(at)) or t.byte_at(at) == b'-' or t.byte_at(at) == b'+' or t.byte_at(at) == b'.') {
                fail snbt_error(t, at, "{found(t, at)} in an array, where an integer should be")
            }
            let x: i64 = match try snbt_number(t, mut at, bits) {
                Byte(v) => i64(v),
                Short(v) => if bits >= 16 { i64(v) } else { fail snbt_error(t, el_at, "a short in an array of bytes") },
                Int(v) => if bits >= 32 { i64(v) } else { fail snbt_error(t, el_at, "an int in an array of bytes") },
                Long(v) => if bits == 64 { v } else { fail snbt_error(t, el_at, "a long in an array of {array_of(bits)}") },
                _ => fail snbt_error(t, el_at, "a float or a double in an array, which holds integers"),
            }
            if bits == 8 {
                bytes.push(i8.wrap(x))
            } else if bits == 32 {
                ints.push(i32.wrap(x))
            } else {
                longs.push(x)
            }
            if try snbt_next(t, mut at, b']', "an array") {
                break
            }
        }
    }
    return if bits == 8 { Tag.ByteArray(bytes) } else if bits == 32 { Tag.IntArray(ints) } else { Tag.LongArray(longs) }
}

fn array_of(bits: u32) -> str {
    return if bits == 8 { "bytes" } else { "ints" }
}

fn snbt_compound(t: String, at: mut usize, depth: usize, keys: mut List<String>) -> LinkedMap<String, Tag> ! SnbtError {
    at += 1
    var m = LinkedMap<String, Tag>()
    skip_white(t, mut at)
    if at < t.len() and t.byte_at(at) == b'}' {
        at += 1
        return m
    }
    loop {
        skip_white(t, mut at)
        let key = try snbt_key(t, mut at, mut keys)
        skip_white(t, mut at)
        if at >= t.len() or t.byte_at(at) != b':' {
            fail snbt_error(t, at, "{found(t, at)} after a key, where `:` should be")
        }
        at += 1
        let value = try snbt_value(t, mut at, depth, mut keys)
        m.insert(key, value)
        if try snbt_next(t, mut at, b'}', "a compound") {
            break
        }
    }
    return m
}

// A key: quoted and not empty, or bare, letters, digits and `._+-` in any order. A key with no
// escapes is interned, as the binary reader's are.
fn snbt_key(t: String, at: mut usize, keys: mut List<String>) -> String ! SnbtError {
    let start = at
    if at < t.len() and (t.byte_at(at) == b'"' or t.byte_at(at) == b'\'') {
        let q = t.byte_at(at)
        var end = at + 1
        while end < t.len() and t.byte_at(end) != q and t.byte_at(end) != b'\\' {
            end += 1
        }
        if end < t.len() and t.byte_at(end) == q and end > at + 1 {
            at = end + 1
            return intern_key(t, start + 1, end, mut keys)
        }
        let k = try snbt_quoted(t, mut at)
        if k.is_empty() {
            fail snbt_error(t, start, "an empty key, which SNBT doesn't take")
        }
        return k
    }
    while at < t.len() and bare_char(t.byte_at(at)) {
        at += 1
    }
    if at == start {
        fail snbt_error(t, at, "{found(t, at)}, where a key should be")
    }
    return intern_key(t, start, at, mut keys)
}

// The text from `from` to `to`, interned, through the same 256 places the binary reader keeps.
fn intern_key(t: String, from: usize, to: usize, keys: mut List<String>) -> String {
    let n = to - from
    if n > 64 {
        return t[from..to]
    }
    var h: u32 = 2166136261
    for i in from..to {
        h = (h ^ u32(t.byte_at(i))).wrapping_mul(16777619)
    }
    let slot = usize(h >> 24)
    if keys[slot].len() == n {
        var same = true
        for i in 0..n {
            if keys[slot].byte_at(i) != t.byte_at(from + i) {
                same = false
                break
            }
        }
        if same {
            return keys[slot].copy()
        }
    }
    let k = t[from..to].interned()
    keys[slot] = k.copy()
    return k
}

// A string in quotes, `"` or `'`, with its escapes. `\u` gives a UTF-16 unit, as Java's strings
// hold, so two make a rune past U+FFFF, and one without its pair becomes `?`, as the binary
// reader makes it.
fn snbt_quoted(t: String, at: mut usize) -> String ! SnbtError {
    let open = at
    let q = t.byte_at(at)
    at += 1
    // Most strings have no escapes, and are their bytes.
    var end = at
    while end < t.len() and t.byte_at(end) != q and t.byte_at(end) != b'\\' {
        end += 1
    }
    if end < t.len() and t.byte_at(end) == q {
        let s = t[at..end]
        at = end + 1
        return s
    }
    var out = String()
    var high: u32 = 0
    var from = at
    loop {
        if at >= t.len() {
            fail snbt_error(t, open, "a string that doesn't end")
        }
        let c = t.byte_at(at)
        if c != q and c != b'\\' {
            at += 1
            continue
        }
        if at > from {
            if high != 0 {
                out.push('?')
                high = 0
            }
            out.push_str(t[from..at])
        }
        at += 1
        if c == q {
            break
        }
        let esc = at - 1
        // Vanilla takes white space between `\` and the escape's letter.
        skip_white(t, mut at)
        if at >= t.len() {
            fail snbt_error(t, open, "a string that doesn't end")
        }
        let e = t.byte_at(at)
        at += 1
        if e == b'\\' or e == b'\'' or e == b'"' {
            push_unit(mut out, mut high, u32(e))
        } else if e == b'b' {
            push_unit(mut out, mut high, 8)
        } else if e == b's' {
            push_unit(mut out, mut high, 32)
        } else if e == b't' {
            push_unit(mut out, mut high, 9)
        } else if e == b'n' {
            push_unit(mut out, mut high, 10)
        } else if e == b'f' {
            push_unit(mut out, mut high, 12)
        } else if e == b'r' {
            push_unit(mut out, mut high, 13)
        } else if e == b'x' or e == b'u' or e == b'U' or e == b'N' {
            var v: u32 = 0
            if e == b'N' {
                v = try snbt_named(t, mut at, esc)
            } else {
                let n: usize = if e == b'x' { 2 } else if e == b'u' { 4 } else { 8 }
                for i in 0..n {
                    let d = if at + i < t.len() { digit_value(t.byte_at(at + i)) } else { 99 }
                    if d >= 16 {
                        fail snbt_error(t, esc, "`\\{rune(e)}` takes {n} hexadecimal digits")
                    }
                    v = v * 16 + d
                }
                at += n
                if v > 0x10FFFF {
                    fail snbt_error(t, esc, "U+{t[at - n..at]} is past the last Unicode character")
                }
            }
            if v >= 0x10000 {
                if high != 0 {
                    out.push('?')
                    high = 0
                }
                out.push(rune.try_from(v)!)
            } else {
                push_unit(mut out, mut high, v)
            }
        } else {
            fail snbt_error(t, esc, "`\\` then {found(t, at - 1)} isn't an escape SNBT has")
        }
        from = at
    }
    if high != 0 {
        out.push('?')
    }
    return out
}

// `\N{name}`, after the `N`: the code point Java's `Character.codePointOf` gives for the name, as
// vanilla takes it, with white space before the `{` and the name of letters, digits, spaces and
// `-`. It can be a surrogate, as `HIGH SURROGATES D800`, which is then a UTF-16 unit.
fn snbt_named(t: String, at: mut usize, esc: usize) -> u32 ! SnbtError {
    skip_white(t, mut at)
    if at >= t.len() or t.byte_at(at) != b'\{' {
        fail snbt_error(t, esc, "`\\N` takes a character's name in braces, as `\\N\{SNOWMAN\}`")
    }
    at += 1
    let start = at
    while at < t.len() {
        let b = t.byte_at(at)
        if not (is_digit(b) or (b >= b'A' and b <= b'Z') or (b >= b'a' and b <= b'z') or b == b' ' or b == b'-') {
            break
        }
        at += 1
    }
    if at == start {
        fail snbt_error(t, esc, "`\\N\{\}` needs a character's name, as `\\N\{SNOWMAN\}`")
    }
    if at >= t.len() or t.byte_at(at) != b'\}' {
        fail snbt_error(t, at, "{found(t, at)} in a character's name, which has only letters, digits, spaces and `-`")
    }
    let name = t[start..at]
    at += 1
    let c = java_code_point_of(name) else {
        fail snbt_error(t, esc, "no character is named `{name}`, as Java's `Character.codePointOf` reads names")
    }
    return c
}

// Adds a UTF-16 unit to `out`, pairing surrogates, with `high` a high one waiting for its low one.
fn push_unit(out: mut String, high: mut u32, u: u32) {
    if u >= 0xDC00 and u <= 0xDFFF and high != 0 {
        out.push(rune.try_from(0x10000 + ((high - 0xD800) << 10) + (u - 0xDC00))!)
        high = 0
        return
    }
    if high != 0 {
        out.push('?')
        high = 0
    }
    if u >= 0xD800 and u <= 0xDBFF {
        high = u
    } else if u >= 0xDC00 and u <= 0xDFFF {
        out.push('?')
    } else {
        out.push(rune.try_from(u)!)
    }
}

// `name(...)`, at the `(`: vanilla's `bool(x)`, which is 1b if `x` is a number other than 0, and
// `uuid(s)`, the four ints of a UUID, as entities keep theirs.
fn snbt_operation(t: String, at: mut usize, name: String, start: usize, depth: usize, keys: mut List<String>) -> Tag ! SnbtError {
    if depth >= MAX_DEPTH {
        fail snbt_error(t, start, "lists and compounds nest more than 512 deep")
    }
    at += 1
    var args = List<Tag>()
    skip_white(t, mut at)
    if at < t.len() and t.byte_at(at) == b')' {
        at += 1
    } else {
        loop {
            args.push(try snbt_value(t, mut at, depth + 1, mut keys))
            if try snbt_next(t, mut at, b')', "`{name}(...)`") {
                break
            }
        }
    }
    if name == "bool" and args.len() == 1 {
        let truth = match args[0] {
            Byte(v) => v != 0,
            Short(v) => v != 0,
            Int(v) => v != 0,
            Long(v) => v != 0,
            Float(v) => v != 0.0,
            Double(v) => v != 0.0,
            _ => fail snbt_error(t, start, "bool() takes a number or a boolean"),
        }
        return Tag.Byte(if truth { 1 } else { 0 })
    }
    if name == "uuid" and args.len() == 1 {
        if let String(s) = args[0] {
            if let ints = java_uuid(s) {
                return Tag.IntArray(ints)
            }
            fail snbt_error(t, start, "uuid() takes a UUID, and `{s}` isn't one")
        }
        fail snbt_error(t, start, "uuid() takes a string")
    }
    fail snbt_error(t, start, "there's no `{name}` of {args.len()} arguments: SNBT has bool(x) and uuid(s)")
}

// The UUID in `s` as Java's `UUID.fromString` reads it, as its four ints: at most 36 characters,
// five fields of hexadecimal between `-`, each a Java long, cut to 32, 16, 16, 16 and 48 bits.
fn java_uuid(s: String) -> List<i32>? {
    if s.len() > 36 {
        return none
    }
    var parts = List<u64>()
    var from: usize = 0
    for i in 0..s.len() + 1 {
        if i == s.len() or s.byte_at(i) == b'-' {
            match i64.parse_radix(s[from..i], 16) {
                some(v) => parts.push(u64.wrap(v)),
                none => return none,
            }
            from = i + 1
        }
    }
    if parts.len() != 5 {
        return none
    }
    let most = ((parts[0] & 0xFFFFFFFF) << 32) | ((parts[1] & 0xFFFF) << 16) | (parts[2] & 0xFFFF)
    let least = ((parts[3] & 0xFFFF) << 48) | (parts[4] & 0xFFFFFFFFFFFF)
    return some([i32.wrap(most >> 32), i32.wrap(most & 0xFFFFFFFF), i32.wrap(least >> 32), i32.wrap(least & 0xFFFFFFFF)])
}

// A number at `at`, which is a digit, a sign or `.`. An integer without its kind's letter is of
// `bits`: an int, or an array's kind. Vanilla takes white space between a number's parts, as in
// `- 1 . 5 e 3 f`, though not inside a run of digits.
fn snbt_number(t: String, at: mut usize, bits: u32) -> Tag ! SnbtError {
    let start = at
    var neg = false
    if t.byte_at(at) == b'-' or t.byte_at(at) == b'+' {
        neg = t.byte_at(at) == b'-'
        at = past_white(t, at + 1)
    }
    // A hex or binary integer, after its `0x` or `0b`.
    if at < t.len() and t.byte_at(at) == b'0' {
        let x = past_white(t, at + 1)
        var radix: u32 = 0
        var digits_at = x
        if x < t.len() and (t.byte_at(x) == b'x' or t.byte_at(x) == b'X') {
            radix = 16
            digits_at = past_white(t, x + 1)
        } else if x < t.len() and (t.byte_at(x) == b'b' or t.byte_at(x) == b'B') {
            let d = past_white(t, x + 1)
            if d < t.len() and (t.byte_at(d) == b'0' or t.byte_at(d) == b'1') {
                radix = 2
                digits_at = d
            }
        }
        if radix != 0 {
            at = digits_at
            let n = try scan_digits(t, mut at, radix)
            if n == 0 {
                fail snbt_error(t, at, "{found(t, at)}, where a hexadecimal digit should be")
            }
            let mag = digits_value(t, digits_at, at, radix)
            return try snbt_integer(t, mut at, start, neg, mag, radix, bits)
        }
    }
    let w0 = at
    let wn = try scan_digits(t, mut at, 10)
    let w1 = at
    // Most numbers are plain ints, ended by `,`, `]` or `}`, which fit an int at 9 digits.
    if bits == 32 and wn > 0 and wn <= 9 and w1 - w0 == wn and at < t.len() and not (wn > 1 and t.byte_at(w0) == b'0') {
        let c = t.byte_at(at)
        if c == b',' or c == b']' or c == b'}' {
            var v: i32 = 0
            for i in w0..w1 {
                v = v * 10 + i32(t.byte_at(i) - b'0')
            }
            return Tag.Int(if neg { -v } else { v })
        }
    }
    var float = false
    var f0 = at
    var f1 = at
    let dot = past_white(t, at)
    if dot < t.len() and t.byte_at(dot) == b'.' {
        at = dot + 1
        let f = past_white(t, at)
        if f < t.len() and is_digit(t.byte_at(f)) {
            at = f
            f0 = f
            _ = try scan_digits(t, mut at, 10)
        } else {
            f0 = at
        }
        f1 = at
        if wn == 0 and f1 == f0 {
            fail snbt_error(t, at, "{found(t, at)}, where a digit should be")
        }
        float = true
    } else if wn == 0 {
        fail snbt_error(t, at, "{found(t, at)}, where a digit should be")
    }
    // An exponent, where digits follow the `e` and its sign.
    var e0 = at
    var e1 = at
    var e_neg = false
    let e = past_white(t, at)
    if e < t.len() and (t.byte_at(e) == b'e' or t.byte_at(e) == b'E') {
        var k = past_white(t, e + 1)
        var sign_neg = false
        if k < t.len() and (t.byte_at(k) == b'+' or t.byte_at(k) == b'-') {
            sign_neg = t.byte_at(k) == b'-'
            k = past_white(t, k + 1)
        }
        if k < t.len() and is_digit(t.byte_at(k)) {
            at = k
            e0 = k
            _ = try scan_digits(t, mut at, 10)
            e1 = at
            e_neg = sign_neg
            float = true
        }
    }
    var single = false
    let s = past_white(t, at)
    if s < t.len() {
        let c = t.byte_at(s)
        if c == b'f' or c == b'F' {
            single = true
            float = true
            at = s + 1
        } else if c == b'd' or c == b'D' {
            float = true
            at = s + 1
        }
    }
    if float {
        if let v = fast_decimal(t, w0, w1, f0, f1, e0, e1, e_neg, single) {
            if single {
                let f = f32.nearest(v)
                return Tag.Float(if f == 0.0 { 0.0 } else if neg { -f } else { f })
            }
            return Tag.Double(if v == 0.0 { 0.0 } else if neg { -v } else { v })
        }
        // The number's text as Java reads it, without `_` and white space.
        var text = String()
        text.reserve(w1 - w0 + f1 - f0 + e1 - e0 + 3)
        push_digits(t, w0, w1, mut text)
        text.push('.')
        push_digits(t, f0, f1, mut text)
        if e1 > e0 {
            text.push('e')
            text.push(if e_neg { '-' } else { '+' })
            push_digits(t, e0, e1, mut text)
        }
        if single {
            let v = f32.parse(text)!
            if v.abs() == f32.INFINITY {
                fail snbt_error(t, start, "{t[start..at]} is too big for a float")
            }
            // Vanilla's `FloatTag.valueOf` gives its zero for -0.0.
            return Tag.Float(if v == 0.0 { 0.0 } else if neg { -v } else { v })
        }
        let v = f64.parse(text)!
        if v.abs() == f64.INFINITY {
            fail snbt_error(t, start, "{t[start..at]} is too big for a double")
        }
        return Tag.Double(if v == 0.0 { 0.0 } else if neg { -v } else { v })
    }
    if wn > 1 and t.byte_at(w0) == b'0' {
        fail snbt_error(t, start, "an integer can't start with 0, unless it's 0")
    }
    return try snbt_integer(t, mut at, start, neg, digits_value(t, w0, w1, 10), 10, bits)
}

// Moves `at` past a run of digits in `radix`, with `_` between them that must have a digit on
// each side, and says how many digits there are.
fn scan_digits(t: String, at: mut usize, radix: u32) -> usize ! SnbtError {
    var n: usize = 0
    while at < t.len() {
        let c = t.byte_at(at)
        if digit_value(c) < radix {
            n += 1
            at += 1
        } else if c == b'_' and n > 0 {
            var k = at
            while k < t.len() and t.byte_at(k) == b'_' {
                k += 1
            }
            if k >= t.len() or digit_value(t.byte_at(k)) >= radix {
                fail snbt_error(t, k, "{found(t, k)} after `_`, where a digit should be")
            }
            at = k
        } else {
            break
        }
    }
    return n
}

// The run of digits from `from` to `to` without its `_`, which scan_digits has checked.
fn push_digits(t: String, from: usize, to: usize, out: mut String) {
    for i in from..to {
        let c = t.byte_at(i)
        if c != b'_' {
            out.push(rune(c))
        }
    }
}

// The number from its runs of digits, the whole part, the fraction and the exponent, if one
// rounding makes it, as Java's would: Clinger's fast path. That's when the digits, as an integer,
// and a power of ten are both exact, so one multiply or divide rounds them correctly: below 2^53
// and up to 10^22 for a double, below 2^24 and up to 10^10 for a float, in float arithmetic. A
// float comes back as the double that holds it exactly. Most numbers people write are such.
fn fast_decimal(t: String, w0: usize, w1: usize, f0: usize, f1: usize, e0: usize, e1: usize, e_neg: bool, single: bool) -> f64? {
    var m: u64 = 0
    var digits: u32 = 0
    var scale: i32 = 0
    for i in w0..f1 {
        if i >= w1 and i < f0 {
            continue
        }
        let c = t.byte_at(i)
        if c == b'_' {
            continue
        }
        if i >= f0 {
            scale -= 1
        }
        if m == 0 and c == b'0' {
            continue
        }
        m = m * 10 + u64(c - b'0')
        digits += 1
        if digits > 15 {
            return none
        }
    }
    if e1 - e0 > 4 {
        return none
    }
    var e: i32 = 0
    for i in e0..e1 {
        let c = t.byte_at(i)
        if c != b'_' {
            e = e * 10 + i32(c - b'0')
        }
    }
    let k = scale + (if e_neg { -e } else { e })
    if m == 0 {
        return some(0.0)
    }
    if single {
        if m >= 16777216 or k < -10 or k > 10 {
            return none
        }
        var p: f32 = 1.0
        for _ in 0..(if k < 0 { -k } else { k }) {
            p *= 10.0
        }
        let x = f32.nearest(m)
        return some(f64(if k < 0 { x / p } else { x * p }))
    }
    if k < -22 or k > 22 {
        return none
    }
    var p: f64 = 1.0
    for _ in 0..(if k < 0 { -k } else { k }) {
        p *= 10.0
    }
    let x = f64.nearest(m)
    return some(if k < 0 { x / p } else { x * p })
}

// The value of the digits from `from` to `to`, or none past a u64.
fn digits_value(t: String, from: usize, to: usize, radix: u32) -> u64? {
    var v: u64 = 0
    let r = u64(radix)
    for i in from..to {
        let c = t.byte_at(i)
        if c == b'_' {
            continue
        }
        let d = u64(digit_value(c))
        if v > (0xFFFFFFFFFFFFFFFFu64 - d) / r {
            return none
        }
        v = v * r + d
    }
    return some(v)
}

fn digit_value(c: u8) -> u32 {
    if c >= b'0' and c <= b'9' {
        return u32(c - b'0')
    }
    if c >= b'a' and c <= b'f' {
        return u32(c - b'a') + 10
    }
    if c >= b'A' and c <= b'F' {
        return u32(c - b'A') + 10
    }
    return 99
}

// The kind a letter names, in bits, or 0 if it names none.
fn kind_bits(c: u8) -> u32 {
    return if c == b'b' or c == b'B' { 8 } else if c == b's' or c == b'S' { 16 } else if c == b'i' or c == b'I' { 32 } else if c == b'l' or c == b'L' { 64 } else { 0 }
}

// An integer's letters and range. `s` or `u` before the kind's letter makes it signed or
// unsigned; a decimal one is signed and a hex or binary one unsigned without. An unsigned one
// takes the kind's bits as they are, so `255ub` is -1b.
fn snbt_integer(t: String, at: mut usize, start: usize, neg: bool, magnitude: u64?, radix: u32, default_bits: u32) -> Tag ! SnbtError {
    var sign: u8 = 0
    var bits = default_bits
    let s = past_white(t, at)
    if s < t.len() {
        let c = t.byte_at(s)
        let k = past_white(t, s + 1)
        let next = if k < t.len() { kind_bits(t.byte_at(k)) } else { 0 }
        if (c == b's' or c == b'S' or c == b'u' or c == b'U') and next > 0 {
            sign = if c == b'u' or c == b'U' { b'u' } else { b's' }
            bits = next
            at = k + 1
        } else if kind_bits(c) > 0 {
            bits = kind_bits(c)
            at = s + 1
        }
    }
    let mag = match magnitude {
        some(v) => v,
        none => fail snbt_error(t, start, "{t[start..at]} is past the range of a long"),
    }
    if sign == b'u' or (sign == 0 and radix != 10) {
        if neg {
            fail snbt_error(t, start, if sign == b'u' { "{t[start..at]} is negative, and unsigned" } else { "{t[start..at]} is negative, which a hex or binary integer can only be with `s` before its kind's letter" })
        }
        if bits < 64 and mag >> bits != 0 {
            fail snbt_error(t, start, "{t[start..at]} is past the range of {kind_name_of(bits)}")
        }
        return int_tag(i64.wrap(mag), bits)
    }
    let limit = 1u64 << (bits - 1)
    if (neg and mag > limit) or (not neg and mag >= limit) {
        fail snbt_error(t, start, "{t[start..at]} is past the range of {kind_name_of(bits)}")
    }
    let v = if neg { 0i64.wrapping_sub(i64.wrap(mag)) } else { i64.wrap(mag) }
    return int_tag(v, bits)
}

fn kind_name_of(bits: u32) -> str {
    return if bits == 8 { "a byte" } else if bits == 16 { "a short" } else if bits == 32 { "an int" } else { "a long" }
}

fn int_tag(v: i64, bits: u32) -> Tag {
    return if bits == 8 { Tag.Byte(i8.wrap(v)) } else if bits == 16 { Tag.Short(i16.wrap(v)) } else if bits == 32 { Tag.Int(i32.wrap(v)) } else { Tag.Long(v) }
}

// --- NBT paths -----------------------------------------------------------------------------------

/// A path to tags inside a tag, as vanilla's `/data` and `/execute store` commands take one:
/// `Inventory[{Slot:0b}].id`, `Pos[0]`, `Passengers[].id`. Its parts are a compound's keys, a
/// list's or an array's elements by index or all of them, and compounds that hold some tags, and
/// it reads and changes what it names as vanilla 26.3's `NbtPathArgument` does.
pub struct NbtPath {
    text: String
    nodes: List<PathNode>
    // Where each node ends in `text`, to say which part of the path found nothing.
    ends: List<usize>
}

// One part of a path.
enum PathNode {
    // `{...}`, first: the root, if it's a compound that holds what the pattern does.
    Root(Tag)
    // `name`: the tag at a compound's key.
    Key(String)
    // `name{...}`: the compound at a key, if it holds what the pattern does.
    KeyMatch { name: String, pattern: Tag }
    // `[i]`: a list's or an array's element, counted from the end if `i` is below 0.
    Index(i32)
    // `[]`: every element of a list or an array.
    All
    // `[{...}]`: each compound in a list that holds what the pattern does.
    ListMatch(Tag)
}

/// Why a path couldn't be followed, or a change through it made, where vanilla's commands fail.
pub enum PathError {
    /// The path names nothing, or the part of it before the last names nothing to change in:
    /// vanilla's "Found no elements matching".
    NoMatch(String)
    /// Inserting found this tag where a list or an array should be.
    NotList(Tag)
    /// Inserting at `index`, which is outside a list of `len`: an index is from `-len - 1` to
    /// `len`.
    BadIndex { index: i32, len: usize }
    /// The change would nest more than 512 deep, counting the path's parts and the value's depth.
    TooDeep
    /// The path is empty, so it names the root, which can't be changed through it.
    Empty
}

impl Display for PathError {
    fn show(self) {
        match self {
            NoMatch(p) => print("nothing matches `{p}`"),
            NotList(t) => print("`{t}`, where a list or an array to insert into should be"),
            BadIndex { index, len } => print("{index} is outside a list of {len}, where an index should be from -{len + 1} to {len}"),
            TooDeep => print("the change would nest lists and compounds more than 512 deep"),
            Empty => print("an empty path names the root itself, which can't be changed through it"),
        }
    }
}

impl NbtPath {
    /// The path in `text`, as vanilla reads one: keys bare or quoted, joined by `.`, then `[i]`,
    /// `[]` or `[{...}]` after a key or each other, `name{...}` for a compound that holds some
    /// tags, and `{...}` first for the root. The whole text is the path, and an empty one names
    /// the root.
    pub fn parse(text: String) -> NbtPath ! SnbtError {
        var nodes = List<PathNode>()
        var ends = List<usize>()
        var keys = new_keys()
        var at: usize = 0
        let n = text.len()
        while at < n and text.byte_at(at) != b' ' {
            nodes.push(try path_node(text, mut at, ends.is_empty(), mut keys))
            ends.push(at)
            if at < n {
                let c = text.byte_at(at)
                if c == b'.' {
                    at += 1
                } else if c != b' ' and c != b'[' and c != b'{' {
                    fail snbt_error(text, at, "{found(text, at)} after a part of the path, where `.`, `[` or the end should be")
                }
            }
        }
        if at < n {
            fail snbt_error(text, at, "{found(text, at)} in the path, where it should end")
        }
        return NbtPath { text: text.copy(), nodes, ends }
    }

    /// Copies of the tags the path names in `root`, in order, or `NoMatch` with the path as far
    /// as the part that found nothing.
    pub fn get(self, root: Tag) -> List<Tag> ! PathError {
        var out = List<Tag>()
        var reached: usize = 0
        _ = path_find(root, self.nodes, 0, mut out, true, mut reached)
        if out.is_empty() {
            fail PathError.NoMatch(self.prefix(reached))
        }
        return out
    }

    /// How many tags the path names in `root`.
    pub fn count(self, root: Tag) -> usize {
        var out = List<Tag>()
        var reached: usize = 0
        return path_find(root, self.nodes, 0, mut out, false, mut reached)
    }

    /// Puts a copy of `value` at each place the path names, making the compounds and lists on the
    /// way that aren't there, as `/data modify ... set` does. Gives how many tags it changed: one
    /// that already equals `value` doesn't count.
    pub fn set(self, root: mut Tag, value: Tag) -> usize ! PathError {
        if self.nodes.is_empty() {
            fail PathError.Empty
        }
        if self.nodes.len() + tag_depth(value) > MAX_DEPTH {
            fail PathError.TooDeep
        }
        var w = PathWalk { what: WALK_SET, index: 0, found: List<Tag>(), count: 0, reached: 0, failed: none }
        let none_items = List<Tag>()
        path_walk(mut root, self.nodes, 0, value, none_items, mut w)
        try self.check_reached(w.reached)
        return w.count
    }

    /// Takes out the tags the path names, as `/data remove` does, and gives how many it took.
    pub fn remove(self, root: mut Tag) -> usize ! PathError {
        if self.nodes.is_empty() {
            fail PathError.Empty
        }
        var w = PathWalk { what: WALK_REMOVE, index: 0, found: List<Tag>(), count: 0, reached: 0, failed: none }
        let none_items = List<Tag>()
        path_walk(mut root, self.nodes, 0, Tag.End, none_items, mut w)
        return w.count
    }

    /// Puts copies of `items` into each list or array the path names, in order from `index`, as
    /// `/data modify ... insert` does: -1 is after the last element, as `append` puts them, and 0
    /// before the first, as `prepend` does. A list the path names that isn't there is made. An
    /// array takes the numbers among the items, as its kind. Gives how many lists or arrays took
    /// an item.
    pub fn insert(self, root: mut Tag, index: i32, items: List<Tag>) -> usize ! PathError {
        if self.nodes.is_empty() {
            fail PathError.Empty
        }
        var deepest: usize = 0
        for item in items {
            let d = tag_depth(item)
            if d > deepest {
                deepest = d
            }
        }
        if not items.is_empty() and self.nodes.len() + deepest > MAX_DEPTH {
            fail PathError.TooDeep
        }
        // Vanilla makes what's missing all the way first, then inserts into each list in turn,
        // so a list that fails leaves those before it changed and the rest made but not changed.
        // The walk does the same in one go, inserting no more after the first failure.
        var w = PathWalk { what: WALK_INSERT, index, found: List<Tag>(), count: 0, reached: 0, failed: none }
        path_walk(mut root, self.nodes, 0, Tag.End, items, mut w)
        try self.check_reached(w.reached)
        if let e = w.failed.take() {
            fail e
        }
        return w.count
    }

    /// Copies of the tags the path names in `root`, making what isn't there on the way, with a
    /// copy of `value` at the end, as vanilla's `getOrCreate` does.
    pub fn get_or_create(self, root: mut Tag, value: Tag) -> List<Tag> ! PathError {
        if self.nodes.is_empty() {
            fail PathError.Empty
        }
        var w = PathWalk { what: WALK_CREATE, index: 0, found: List<Tag>(), count: 0, reached: 0, failed: none }
        let none_items = List<Tag>()
        path_walk(mut root, self.nodes, 0, value, none_items, mut w)
        try self.check_reached(w.reached)
        return w.found
    }

    // A change fails if a part of the path before the last found nothing, naming the path as far
    // as that part.
    fn check_reached(self, reached: usize) ! PathError {
        if reached + 1 < self.nodes.len() {
            fail PathError.NoMatch(self.prefix(reached))
        }
    }

    // The path's text as far as part `j`. Vanilla keeps one `[]` for a path's every `[]` and
    // finds where a part ends by the part, so a `[]` ends where the path's last `[]` does.
    fn prefix(self, j: usize) -> String {
        var end = self.ends[j]
        if let All = self.nodes[j] {
            for k in j..self.nodes.len() {
                if let All = self.nodes[k] {
                    end = self.ends[k]
                }
            }
        }
        return self.text[0..end]
    }
}

/// `{path}` is the path as it was written.
impl Display for NbtPath {
    fn show(self) {
        print(self.text)
    }
}

// One part of a path, from `at`, which moves past it.
fn path_node(t: String, at: mut usize, first: bool, keys: mut List<String>) -> PathNode ! SnbtError {
    let n = t.len()
    let start = at
    if at < n and t.byte_at(at) == b'{' {
        if not first {
            fail snbt_error(t, at, "`\{` after the path's first part, where a key or `[` should be")
        }
        return PathNode.Root(Tag.Compound(try snbt_compound(t, mut at, 1, mut keys)))
    }
    if at < n and t.byte_at(at) == b'[' {
        at += 1
        if at < n and t.byte_at(at) == b']' {
            at += 1
            return PathNode.All
        }
        if at < n and t.byte_at(at) == b'{' {
            let pattern = Tag.Compound(try snbt_compound(t, mut at, 1, mut keys))
            if at >= n or t.byte_at(at) != b']' {
                fail snbt_error(t, at, "{found(t, at)} after the compound in `[...]`, where `]` should be")
            }
            at += 1
            return PathNode.ListMatch(pattern)
        }
        // As Brigadier reads an int: digits, `-` and `.`, then Java's `Integer.parseInt`.
        let from = at
        while at < n and (is_digit(t.byte_at(at)) or t.byte_at(at) == b'-' or t.byte_at(at) == b'.') {
            at += 1
        }
        if at == from {
            fail snbt_error(t, at, "{found(t, at)} in `[...]`, where an index, a compound or `]` should be")
        }
        let index = match i32.parse(t[from..at]) {
            some(v) => v,
            none => fail snbt_error(t, from, "`{t[from..at]}` in `[...]`, which isn't an int an index can be"),
        }
        if at >= n or t.byte_at(at) != b']' {
            fail snbt_error(t, at, "{found(t, at)} after the index, where `]` should be")
        }
        at += 1
        return PathNode.Index(index)
    }
    var name = String()
    if at < n and (t.byte_at(at) == b'"' or t.byte_at(at) == b'\'') {
        name = try path_quoted(t, mut at)
        if name.is_empty() {
            fail snbt_error(t, start, "an empty key, which a path doesn't take")
        }
    } else {
        while at < n and path_bare(t.byte_at(at)) {
            at += 1
        }
        if at == start {
            let what = if first { "a key, `[` or `\{`" } else { "a key or `[`" }
            fail snbt_error(t, at, "{found(t, at)}, where {what} should be")
        }
        name = intern_key(t, start, at, mut keys)
    }
    if at < n and t.byte_at(at) == b'{' {
        let pattern = Tag.Compound(try snbt_compound(t, mut at, 1, mut keys))
        return PathNode.KeyMatch { name, pattern }
    }
    return PathNode.Key(name)
}

// A bare key in a path is anything up to a space, a quote, a bracket, a brace or `.`.
fn path_bare(c: u8) -> bool {
    return c != b' ' and c != b'"' and c != b'\'' and c != b'[' and c != b']' and c != b'.' and c != b'{' and c != b'}'
}

// A quoted key, as Brigadier reads a quoted string: `\` only before `\` or the quote it's in.
fn path_quoted(t: String, at: mut usize) -> String ! SnbtError {
    let q = t.byte_at(at)
    at += 1
    var out = String()
    var from = at
    loop {
        if at >= t.len() {
            fail snbt_error(t, at, "the end in a quoted key, where `{rune(q)}` should be")
        }
        let c = t.byte_at(at)
        if c == q {
            out.push_str(t[from..at])
            at += 1
            return out
        }
        if c == b'\\' {
            out.push_str(t[from..at])
            at += 1
            if at < t.len() and (t.byte_at(at) == q or t.byte_at(at) == b'\\') {
                out.push(rune(t.byte_at(at)))
                at += 1
                from = at
                continue
            }
            fail snbt_error(t, at, "{found(t, at)} after `\\` in a quoted key, where `\\` or `{rune(q)}` should be")
        }
        at += 1
    }
}

// The index `k` names in `len` elements, counting from the end if it's below 0.
fn path_index(k: i32, len: usize) -> usize? {
    let j = if k < 0 { i64.wrap(len) + i64(k) } else { i64(k) }
    if j < 0 or j >= i64.wrap(len) {
        return none
    }
    return some(usize.wrap(j))
}

// The tags `nodes[i..]` name from `tag`, counted, and copied into `out` if `keep`. `reached` is
// the most parts any tag was found through.
fn path_find(tag: Tag, nodes: List<PathNode>, i: usize, out: mut List<Tag>, keep: bool, reached: mut usize) -> usize {
    if i > reached {
        reached = i
    }
    if i == nodes.len() {
        if keep {
            out.push(tag.copy())
        }
        return 1
    }
    var n: usize = 0
    match nodes[i] {
        Root(p) => {
            if matches(p, tag) {
                n += path_find(tag, nodes, i + 1, mut out, keep, mut reached)
            }
        },
        Key(name) => {
            if let Compound(m) = tag {
                if m.contains(name) {
                    n += path_find(m[name], nodes, i + 1, mut out, keep, mut reached)
                }
            }
        },
        KeyMatch { name, pattern } => {
            if let Compound(m) = tag {
                if m.contains(name) and matches(pattern, m[name]) {
                    n += path_find(m[name], nodes, i + 1, mut out, keep, mut reached)
                }
            }
        },
        Index(k) => {
            match tag {
                List(xs) => if let j = path_index(k, xs.len()) { n += path_find(xs[j], nodes, i + 1, mut out, keep, mut reached) },
                ByteArray(v) => if let j = path_index(k, v.len()) { n += path_find(Tag.Byte(v[j]), nodes, i + 1, mut out, keep, mut reached) },
                IntArray(v) => if let j = path_index(k, v.len()) { n += path_find(Tag.Int(v[j]), nodes, i + 1, mut out, keep, mut reached) },
                LongArray(v) => if let j = path_index(k, v.len()) { n += path_find(Tag.Long(v[j]), nodes, i + 1, mut out, keep, mut reached) },
                _ => {},
            }
        },
        All => {
            match tag {
                List(xs) => { for x in xs { n += path_find(x, nodes, i + 1, mut out, keep, mut reached) } },
                ByteArray(v) => { for x in v { n += path_find(Tag.Byte(x), nodes, i + 1, mut out, keep, mut reached) } },
                IntArray(v) => { for x in v { n += path_find(Tag.Int(x), nodes, i + 1, mut out, keep, mut reached) } },
                LongArray(v) => { for x in v { n += path_find(Tag.Long(x), nodes, i + 1, mut out, keep, mut reached) } },
                _ => {},
            }
        },
        ListMatch(p) => {
            if let List(xs) = tag {
                for x in xs {
                    if matches(p, x) {
                        n += path_find(x, nodes, i + 1, mut out, keep, mut reached)
                    }
                }
            }
        },
    }
    return n
}

// What a walk through a path does: sets or removes at the last part, or makes what's missing and
// keeps copies of what it finds or inserts into it.
const WALK_SET: u8 = 0
const WALK_REMOVE: u8 = 1
const WALK_CREATE: u8 = 2
const WALK_INSERT: u8 = 3

struct PathWalk {
    what: u8
    // Where insert puts the items.
    index: i32
    found: List<Tag>
    count: usize
    // The most parts of the path any tag was found through.
    reached: usize
    // The first list insert failed on, after which it inserts into no more.
    failed: PathError?
}

// Walks `nodes[i..]` from `tag` as `w.what` says, depth first. Vanilla goes a part at a time over
// every tag found so far, but each part changes only the tags it's at, so the two end the same.
fn path_walk(tag: mut Tag, nodes: List<PathNode>, i: usize, value: Tag, items: List<Tag>, w: mut PathWalk) {
    if i > w.reached {
        w.reached = i
    }
    if i + 1 == nodes.len() and w.what == WALK_SET {
        w.count += set_last(mut tag, nodes[i], value)
        return
    }
    if i + 1 == nodes.len() and w.what == WALK_REMOVE {
        w.count += remove_last(mut tag, nodes[i])
        return
    }
    if i == nodes.len() {
        if w.what == WALK_CREATE {
            w.found.push(tag.copy())
        } else if w.what == WALK_INSERT and w.failed == none {
            match insert_into(mut tag, w.index, items) {
                ok(took) => {
                    if took {
                        w.count += 1
                    }
                },
                err(e) => w.failed = some(e),
            }
        }
        return
    }
    let create = w.what != WALK_REMOVE
    match nodes[i] {
        Root(p) => {
            if matches(p, tag) {
                path_walk(mut tag, nodes, i + 1, value, items, mut w)
            }
        },
        Key(name) => {
            if let Compound(m) = mut tag {
                if create and not m.contains(name) {
                    m.insert(name.copy(), path_made(nodes, i, value, w.what))
                }
                if m.contains(name) {
                    path_walk(mut m[name], nodes, i + 1, value, items, mut w)
                }
            }
        },
        KeyMatch { name, pattern } => {
            if let Compound(m) = mut tag {
                if m.contains(name) {
                    if matches(pattern, m[name]) {
                        path_walk(mut m[name], nodes, i + 1, value, items, mut w)
                    }
                } else if create {
                    m.insert(name.copy(), pattern.copy())
                    path_walk(mut m[name], nodes, i + 1, value, items, mut w)
                }
            }
        },
        Index(k) => {
            match mut tag {
                List(xs) => {
                    if let j = path_index(k, xs.len()) {
                        path_walk(mut xs[j], nodes, i + 1, value, items, mut w)
                    }
                },
                // An array's element is a number, which nothing after it can change, so a copy
                // stands in for it.
                ByteArray(v) => {
                    if let j = path_index(k, v.len()) {
                        var e = Tag.Byte(v[j])
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                IntArray(v) => {
                    if let j = path_index(k, v.len()) {
                        var e = Tag.Int(v[j])
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                LongArray(v) => {
                    if let j = path_index(k, v.len()) {
                        var e = Tag.Long(v[j])
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                _ => {},
            }
        },
        All => {
            // An empty list or array takes one element first, if the walk makes what's missing.
            match mut tag {
                List(xs) => {
                    if create and xs.is_empty() {
                        xs.push(path_made(nodes, i, value, w.what))
                    }
                    for x in mut xs {
                        path_walk(mut x, nodes, i + 1, value, items, mut w)
                    }
                },
                // An empty array that takes the tag made goes on with that tag, as vanilla does,
                // not with the number the array keeps of it.
                ByteArray(v) => {
                    if create and v.is_empty() {
                        var made = path_made(nodes, i, value, w.what)
                        if let b = array_byte(made) {
                            v.push(b)
                            path_walk(mut made, nodes, i + 1, value, items, mut w)
                        }
                        return
                    }
                    for x in v {
                        var e = Tag.Byte(x)
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                IntArray(v) => {
                    if create and v.is_empty() {
                        var made = path_made(nodes, i, value, w.what)
                        if let b = array_int(made) {
                            v.push(b)
                            path_walk(mut made, nodes, i + 1, value, items, mut w)
                        }
                        return
                    }
                    for x in v {
                        var e = Tag.Int(x)
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                LongArray(v) => {
                    if create and v.is_empty() {
                        var made = path_made(nodes, i, value, w.what)
                        if let b = array_long(made) {
                            v.push(b)
                            path_walk(mut made, nodes, i + 1, value, items, mut w)
                        }
                        return
                    }
                    for x in v {
                        var e = Tag.Long(x)
                        path_walk(mut e, nodes, i + 1, value, items, mut w)
                    }
                },
                _ => {},
            }
        },
        ListMatch(p) => {
            // A list with no compound that matches takes a copy of the pattern, if the walk
            // makes what's missing.
            if let List(xs) = mut tag {
                var any = false
                for x in mut xs {
                    if matches(p, x) {
                        any = true
                        path_walk(mut x, nodes, i + 1, value, items, mut w)
                    }
                }
                if not any and create {
                    xs.push(p.copy())
                    let last = xs.len() - 1
                    path_walk(mut xs[last], nodes, i + 1, value, items, mut w)
                }
            }
        },
    }
}

// What a walk puts where part `i` finds nothing: for a part before the last, a compound if a key
// comes next and a list if `[...]` does, and for the last, the value being made or, for insert,
// a list.
fn path_made(nodes: List<PathNode>, i: usize, value: Tag, what: u8) -> Tag {
    if i + 1 < nodes.len() {
        return match nodes[i + 1] {
            Key(_) => Tag.Compound(LinkedMap()),
            KeyMatch { name: _, pattern: _ } => Tag.Compound(LinkedMap()),
            _ => Tag.List(List()),
        }
    }
    if what == WALK_CREATE {
        return value.copy()
    }
    return Tag.List(List())
}

// Puts `value` where the path's last part names from `tag`, and gives how many tags changed.
fn set_last(tag: mut Tag, node: PathNode, value: Tag) -> usize {
    match node {
        Root(_) => return 0,
        Key(name) => {
            if let Compound(m) = mut tag {
                let same_there = m.contains(name) and tag_equal(m[name], value)
                m.insert(name.copy(), value.copy())
                return if same_there { 0 } else { 1 }
            }
        },
        KeyMatch { name, pattern } => {
            if let Compound(m) = mut tag {
                if m.contains(name) and matches(pattern, m[name]) and not tag_equal(m[name], value) {
                    m.insert(name.copy(), value.copy())
                    return 1
                }
            }
        },
        Index(k) => {
            match mut tag {
                List(xs) => {
                    if let j = path_index(k, xs.len()) {
                        if not tag_equal(xs[j], value) {
                            xs[j] = value.copy()
                            return 1
                        }
                    }
                },
                ByteArray(v) => {
                    if let j = path_index(k, v.len()) {
                        if not tag_equal(Tag.Byte(v[j]), value) {
                            if let b = array_byte(value) {
                                v[j] = b
                                return 1
                            }
                        }
                    }
                },
                IntArray(v) => {
                    if let j = path_index(k, v.len()) {
                        if not tag_equal(Tag.Int(v[j]), value) {
                            if let b = array_int(value) {
                                v[j] = b
                                return 1
                            }
                        }
                    }
                },
                LongArray(v) => {
                    if let j = path_index(k, v.len()) {
                        if not tag_equal(Tag.Long(v[j]), value) {
                            if let b = array_long(value) {
                                v[j] = b
                                return 1
                            }
                        }
                    }
                },
                _ => {},
            }
        },
        All => {
            // As vanilla does it: an empty one takes the value and counts 1 even if an array
            // can't hold it, and otherwise every element is replaced, if any differs, and an
            // array that can't hold the value is left empty.
            match mut tag {
                List(xs) => {
                    if xs.is_empty() {
                        xs.push(value.copy())
                        return 1
                    }
                    var differ: usize = 0
                    for x in xs {
                        if not tag_equal(x, value) {
                            differ += 1
                        }
                    }
                    if differ > 0 {
                        for x in mut xs {
                            x = value.copy()
                        }
                    }
                    return differ
                },
                ByteArray(v) => {
                    if v.is_empty() {
                        if let b = array_byte(value) {
                            v.push(b)
                        }
                        return 1
                    }
                    var differ: usize = 0
                    for x in v {
                        if not tag_equal(Tag.Byte(x), value) {
                            differ += 1
                        }
                    }
                    if differ == 0 {
                        return 0
                    }
                    let n = v.len()
                    v.clear()
                    if let b = array_byte(value) {
                        for _ in 0..n {
                            v.push(b)
                        }
                        return differ
                    }
                    return 0
                },
                IntArray(v) => {
                    if v.is_empty() {
                        if let b = array_int(value) {
                            v.push(b)
                        }
                        return 1
                    }
                    var differ: usize = 0
                    for x in v {
                        if not tag_equal(Tag.Int(x), value) {
                            differ += 1
                        }
                    }
                    if differ == 0 {
                        return 0
                    }
                    let n = v.len()
                    v.clear()
                    if let b = array_int(value) {
                        for _ in 0..n {
                            v.push(b)
                        }
                        return differ
                    }
                    return 0
                },
                LongArray(v) => {
                    if v.is_empty() {
                        if let b = array_long(value) {
                            v.push(b)
                        }
                        return 1
                    }
                    var differ: usize = 0
                    for x in v {
                        if not tag_equal(Tag.Long(x), value) {
                            differ += 1
                        }
                    }
                    if differ == 0 {
                        return 0
                    }
                    let n = v.len()
                    v.clear()
                    if let b = array_long(value) {
                        for _ in 0..n {
                            v.push(b)
                        }
                        return differ
                    }
                    return 0
                },
                _ => {},
            }
        },
        ListMatch(p) => {
            // An empty list takes the value, whatever it is, as vanilla does.
            var n: usize = 0
            if let List(xs) = mut tag {
                if xs.is_empty() {
                    xs.push(value.copy())
                    return 1
                }
                for x in mut xs {
                    if matches(p, x) and not tag_equal(x, value) {
                        x = value.copy()
                        n += 1
                    }
                }
            }
            return n
        },
    }
    return 0
}

// Takes out what the path's last part names from `tag`, and gives how many tags it took.
fn remove_last(tag: mut Tag, node: PathNode) -> usize {
    match node {
        Root(_) => return 0,
        Key(name) => {
            if let Compound(m) = mut tag {
                if m.remove(name) != none {
                    return 1
                }
            }
        },
        KeyMatch { name, pattern } => {
            if let Compound(m) = mut tag {
                if m.contains(name) and matches(pattern, m[name]) {
                    _ = m.remove(name)
                    return 1
                }
            }
        },
        Index(k) => {
            match mut tag {
                List(xs) => if let j = path_index(k, xs.len()) { _ = xs.remove(j); return 1 },
                ByteArray(v) => if let j = path_index(k, v.len()) { _ = v.remove(j); return 1 },
                IntArray(v) => if let j = path_index(k, v.len()) { _ = v.remove(j); return 1 },
                LongArray(v) => if let j = path_index(k, v.len()) { _ = v.remove(j); return 1 },
                _ => {},
            }
        },
        All => {
            match mut tag {
                List(xs) => { let n = xs.len(); xs.clear(); return n },
                ByteArray(v) => { let n = v.len(); v.clear(); return n },
                IntArray(v) => { let n = v.len(); v.clear(); return n },
                LongArray(v) => { let n = v.len(); v.clear(); return n },
                _ => {},
            }
        },
        ListMatch(p) => {
            if let List(xs) = mut tag {
                let before = xs.len()
                xs.retain(|x| not matches(p, x))
                return before - xs.len()
            }
        },
    }
    return 0
}

// Puts copies of `items` into the list or array `tag` from `index`, and says whether it took any.
// As vanilla does it, the index is only wrong once an item would go in, so an array given no
// numbers takes none and fails on none.
fn insert_into(tag: mut Tag, index: i32, items: List<Tag>) -> bool ! PathError {
    let len = match tag {
        List(xs) => xs.len(),
        ByteArray(v) => v.len(),
        IntArray(v) => v.len(),
        LongArray(v) => v.len(),
        _ => fail PathError.NotList(tag.copy()),
    }
    let start = if index < 0 { i64.wrap(len) + i64(index) + 1 } else { i64(index) }
    let fits = start >= 0 and start <= i64.wrap(len)
    var at = if fits { usize.wrap(start) } else { 0 }
    var any = false
    match mut tag {
        List(xs) => {
            for item in items {
                if not fits {
                    fail PathError.BadIndex { index, len }
                }
                xs.insert(at, item.copy())
                at += 1
                any = true
            }
        },
        ByteArray(v) => {
            for item in items {
                if let b = array_byte(item) {
                    if not fits {
                        fail PathError.BadIndex { index, len }
                    }
                    v.insert(at, b)
                    at += 1
                    any = true
                }
            }
        },
        IntArray(v) => {
            for item in items {
                if let b = array_int(item) {
                    if not fits {
                        fail PathError.BadIndex { index, len }
                    }
                    v.insert(at, b)
                    at += 1
                    any = true
                }
            }
        },
        LongArray(v) => {
            for item in items {
                if let b = array_long(item) {
                    if not fits {
                        fail PathError.BadIndex { index, len }
                    }
                    v.insert(at, b)
                    at += 1
                    any = true
                }
            }
        },
        _ => {},
    }
    return any
}

// Whether `tag` holds what `pattern` does, as vanilla matches a path's compounds: a compound
// holds each of the pattern's keys with a value that matches, a list holds for each of the
// pattern's elements one that matches, in any order, and an empty list only matches an empty
// one. Anything else must be equal.
fn matches(pattern: Tag, tag: Tag) -> bool {
    match pattern {
        Compound(p) => {
            if let Compound(m) = tag {
                for (k, v) in p {
                    if not m.contains(k) or not matches(v, m[k]) {
                        return false
                    }
                }
                return true
            }
            return false
        },
        List(p) => {
            if let List(xs) = tag {
                if p.is_empty() {
                    return xs.is_empty()
                }
                for want in p {
                    var hit = false
                    for x in xs {
                        if matches(want, x) {
                            hit = true
                            break
                        }
                    }
                    if not hit {
                        return false
                    }
                }
                return true
            }
            return false
        },
        _ => return tag_equal(pattern, tag),
    }
}

// Whether two tags are equal as vanilla's are: as `==` has it, but with every NaN equal to every
// other, as Java's records compare floats, and -0.0 equal to 0.0, which vanilla keeps as 0.0.
fn tag_equal(a: Tag, b: Tag) -> bool {
    match a {
        Float(x) => if let Float(y) = b { return x == y or (x.is_nan() and y.is_nan()) },
        Double(x) => if let Double(y) = b { return x == y or (x.is_nan() and y.is_nan()) },
        List(xs) => {
            if let List(ys) = b {
                if xs.len() != ys.len() {
                    return false
                }
                for i in 0..xs.len() {
                    if not tag_equal(xs[i], ys[i]) {
                        return false
                    }
                }
                return true
            }
        },
        Compound(m) => {
            if let Compound(n) = b {
                if m.len() != n.len() {
                    return false
                }
                for (k, v) in m {
                    if not n.contains(k) or not tag_equal(v, n[k]) {
                        return false
                    }
                }
                return true
            }
        },
        _ => return a == b,
    }
    return false
}

// How deep a tag nests, as vanilla counts it for a change through a path: 1 for a number, a
// string, an array or an empty list or compound, and one more than its deepest tag for a list or
// a compound that holds some.
fn tag_depth(t: Tag) -> usize {
    var d: usize = 0
    match t {
        List(xs) => { for x in xs { d = d.max(tag_depth(x)) } },
        Compound(m) => { for (_, v) in m { d = d.max(tag_depth(v)) } },
        _ => {},
    }
    return d + 1
}

// A number as an array of its kind takes it, as vanilla's `NumericTag` gives it: an integer's low
// bits, and a float or a double rounded down first, then clamped to an int. A long array takes a
// float cut toward 0 instead, as Java's `(long) f` does, and a double rounded down.
fn array_byte(v: Tag) -> i8? {
    return match v {
        Byte(x) => some(x),
        Short(x) => some(i8.wrap(x)),
        Int(x) => some(i8.wrap(x)),
        Long(x) => some(i8.wrap(x)),
        Float(x) => some(i8.wrap(i32.saturate(x.floor()))),
        Double(x) => some(i8.wrap(i32.saturate(x.floor()))),
        _ => none,
    }
}

fn array_int(v: Tag) -> i32? {
    return match v {
        Byte(x) => some(i32(x)),
        Short(x) => some(i32(x)),
        Int(x) => some(x),
        Long(x) => some(i32.wrap(x)),
        Float(x) => some(i32.saturate(x.floor())),
        Double(x) => some(i32.saturate(x.floor())),
        _ => none,
    }
}

fn array_long(v: Tag) -> i64? {
    return match v {
        Byte(x) => some(i64(x)),
        Short(x) => some(i64(x)),
        Int(x) => some(i64(x)),
        Long(x) => some(x),
        Float(x) => some(i64.saturate(x)),
        Double(x) => some(i64.saturate(x.floor())),
        _ => none,
    }
}

// --- FTB's SNBT ----------------------------------------------------------------------------------

/// A file in FTB Library's SNBT, the text FTB Quests, FTB Chunks, FTB Teams and FTB's other mods
/// keep their configs and data in: a compound, and which of its bytes are written `true` and
/// `false`.
pub struct FtbSnbt {
    /// The root, a `Tag.Compound`.
    pub root: Tag
    /// The paths of the bytes that are written `true` or `false`, as `NbtPath` reads them, such
    /// as `quests[2].optional`. FTB keeps this for a compound's keys, so a byte in a list is
    /// always a number.
    pub booleans: Set<String>
}

impl FtbSnbt {
    /// A file of `root`, a compound, with no booleans.
    pub fn new(root: own Tag) -> FtbSnbt {
        return FtbSnbt { root: root, booleans: Set<String>() }
    }

    /// The file at `path`, read as `parse_ftb_snbt` reads text. It must be UTF-8, as FTB wants.
    pub fn open(path: String) -> FtbSnbt ! Error {
        let text = match try fs.read_text(path.copy()).context("reading {path}") {
            some(t) => t,
            none => fail "reading {path}: it isn't UTF-8",
        }
        return match parse_ftb_snbt(text) {
            ok(f) => f,
            err(e) => fail "reading {path}: {e}",
        }
    }

    /// The file as FTB Library's `SNBT.write` writes it: a tab for each level, a line for each
    /// key, in their order, and a line break after the last line. FTB ends its lines as the
    /// system does, `\r\n` on Windows; these end with `\n`.
    pub fn to_snbt(self) -> String {
        var out = String()
        var path = String()
        ftb_write(self.root, 0, self.booleans, mut path, mut out)
        out.push('\n')
        return out
    }

    /// Writes the file to `path`, as `to_snbt` lays it out.
    pub fn save(self, path: String) ! Error {
        try fs.write_text(path.copy(), self.to_snbt()).context("writing {path}")
    }
}

/// The file in `text`, as FTB Library 2101.1.39's `SNBT.read` reads it. That's a compound, with
/// lines that start with `#` left out, keys and values split by white space or commas, bare
/// strings, `true`, `false` and `null`, numbers with or without their kind's letter, strings in
/// either quote, lists of one kind and arrays. Text after the compound is ignored, as FTB
/// ignores it.
pub fn parse_ftb_snbt(text: String) -> FtbSnbt ! SnbtError {
    var r = FtbRead { booleans: Set<String>(), path: String(), keys: new_keys() }
    var at: usize = 0
    ftb_skip(text, mut at, false)
    if at >= text.len() or text.byte_at(at) != b'{' {
        fail snbt_error(text, at, "{found(text, at)}, where the file's `\{` should be")
    }
    let root = Tag.Compound(try ftb_compound(text, mut at, 1, mut r))
    return FtbSnbt { root: root, booleans: r.booleans }
}

struct FtbRead {
    booleans: Set<String>
    // The path to where the reader is, kept only where a boolean could be.
    path: String
    keys: List<String>
}

// Skips what FTB skips between parts: runes up to U+0020, commas too if `commas`, and lines
// whose first rune past those is `#`, which FTB drops before it reads. FTB splits lines at `\n`,
// `\r\n` and `\r`.
fn ftb_skip(t: String, at: mut usize, commas: bool) {
    while at < t.len() {
        let b = t.byte_at(at)
        if b <= 32 or (commas and b == b',') {
            at += 1
        } else if b == b'#' and ftb_line_start(t, at) {
            while at < t.len() and t.byte_at(at) != 10 and t.byte_at(at) != 13 {
                at += 1
            }
        } else {
            return
        }
    }
}

// Whether nothing but runes up to U+0020 comes before `at` on its line.
fn ftb_line_start(t: String, at: usize) -> bool {
    var k = at
    while k > 0 {
        let b = t.byte_at(k - 1)
        if b == 10 or b == 13 {
            return true
        }
        if b > 32 {
            return false
        }
        k -= 1
    }
    return true
}

// The rune at byte `at`, and how many bytes it takes.
fn rune_at(t: String, at: usize) -> (u32, usize) {
    let b = t.byte_at(at)
    if b < 0x80 {
        return (u32(b), 1)
    }
    let n: usize = if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
    var r: u32 = if n == 2 { u32(b & 0x1F) } else if n == 3 { u32(b & 0x0F) } else { u32(b & 0x07) }
    for i in 1..n {
        r = (r << 6) | u32(t.byte_at(at + i) & 0x3F)
    }
    return (r, n)
}

// Java's `Character.isAlphabetic(c) || Character.isDigit(c)`, for a UTF-16 unit, as FTB asks it.
fn java_alnum(c: u32) -> bool {
    if c < 0x80 {
        return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57)
    }
    var lo: usize = 0
    var hi = JAVA_ALNUM_LEN / 2
    while lo < hi {
        let mid = (lo + hi) / 2
        if c > JAVA_ALNUM[2 * mid + 1] {
            lo = mid + 1
        } else if c < JAVA_ALNUM[2 * mid] {
            hi = mid
        } else {
            return true
        }
    }
    return false
}

fn ftb_compound(t: String, at: mut usize, depth: usize, r: mut FtbRead) -> LinkedMap<String, Tag> ! SnbtError {
    at += 1
    var m = LinkedMap<String, Tag>()
    let mark = r.path.len()
    loop {
        ftb_skip(t, mut at, true)
        if at >= t.len() {
            fail snbt_error(t, at, "the end in a compound, where a key or `\}` should be")
        }
        let c = t.byte_at(at)
        if c == b'}' {
            at += 1
            return m
        }
        var key = String()
        if c == b'"' or c == b'\'' {
            key = try ftb_quoted(t, mut at)
        } else {
            let start = at
            try ftb_token(t, mut at)
            key = intern_key(t, start, at, mut r.keys)
        }
        ftb_skip(t, mut at, false)
        if at >= t.len() or t.byte_at(at) != b':' {
            fail snbt_error(t, at, "{found(t, at)} after a key, where `:` should be")
        }
        at += 1
        ftb_skip(t, mut at, false)
        // The path matters to a value that's a boolean or holds some, and to a key read again,
        // whose booleans go with the value it had.
        let again = not r.booleans.is_empty() and m.contains(key)
        var pathed = again
        if at < t.len() {
            let v = t.byte_at(at)
            pathed = pathed or v == b'{' or v == b'[' or v == b't' or v == b'f'
        }
        if pathed {
            ftb_path_key(key, mut r.path)
        }
        if again {
            ftb_forget(mut r.booleans, r.path)
        }
        let value = try ftb_value(t, mut at, depth, mut r, true)
        if pathed {
            r.path.truncate(mark)
        }
        m.insert(key, value)
    }
}

// Adds `key` to a path, as `NbtPath` reads one: bare if it can be, quoted otherwise.
fn ftb_path_key(key: String, path: mut String) {
    if not path.is_empty() {
        path.push('.')
    }
    var bare = not key.is_empty()
    for i in 0..key.len() {
        if not path_bare(key.byte_at(i)) {
            bare = false
            break
        }
    }
    if bare {
        path.push_str(key)
        return
    }
    path.push('"')
    var from: usize = 0
    for i in 0..key.len() {
        let c = key.byte_at(i)
        if c == b'"' or c == b'\\' {
            path.push_str(key[from..i])
            path.push('\\')
            from = i
        }
    }
    path.push_str(key[from..key.len()])
    path.push('"')
}

// Drops the booleans at `path` and under it.
fn ftb_forget(booleans: mut Set<String>, path: String) {
    var gone = List<String>()
    for p in booleans {
        if p.starts_with(path) and (p.len() == path.len() or p.byte_at(path.len()) == b'.' or p.byte_at(path.len()) == b'[') {
            gone.push(p.copy())
        }
    }
    for p in gone {
        booleans.remove(p)
    }
}

// A value, `depth` lists and compounds in. `keyed` is whether it's a compound's, where FTB marks
// `true` and `false`.
fn ftb_value(t: String, at: mut usize, depth: usize, r: mut FtbRead, keyed: bool) -> Tag ! SnbtError {
    ftb_skip(t, mut at, false)
    if at >= t.len() {
        fail snbt_error(t, at, "the end, where a value should be")
    }
    let c = t.byte_at(at)
    if c == b'{' or c == b'[' {
        if depth >= MAX_DEPTH {
            fail snbt_error(t, at, "lists and compounds nest more than 512 deep")
        }
        if c == b'{' {
            return Tag.Compound(try ftb_compound(t, mut at, depth + 1, mut r))
        }
        return try ftb_list(t, mut at, depth + 1, mut r)
    }
    if c == b'"' or c == b'\'' {
        return Tag.String(try ftb_quoted(t, mut at))
    }
    let start = at
    try ftb_token(t, mut at)
    return try ftb_word(t, start, at, mut r, keyed)
}

// Moves past a bare token: its first rune, whatever it is, then letters and digits, as Java's
// `Character.isAlphabetic` and `isDigit` take them, and `_-.+`.
fn ftb_token(t: String, at: mut usize) ! SnbtError {
    let (c, n) = rune_at(t, at)
    if c > 0xFFFF {
        fail snbt_error(t, at, "{found(t, at)} outside quotes, which FTB would split in two")
    }
    at += n
    while at < t.len() {
        let b = t.byte_at(at)
        if b < 0x80 {
            if not bare_char(b) {
                return
            }
            at += 1
            continue
        }
        let (r, m) = rune_at(t, at)
        if not java_alnum(r) {
            return
        }
        at += m
    }
}

// What FTB makes of a bare token: `true`, `false` or `null`, a number, or else a string.
fn ftb_word(t: String, start: usize, end: usize, r: mut FtbRead, keyed: bool) -> Tag ! SnbtError {
    let first = t.byte_at(start)
    if first == b't' and bytes_are(t, start, end, "true") {
        if keyed {
            r.booleans.insert(r.path.copy())
        }
        return Tag.Byte(1)
    }
    if first == b'f' and bytes_are(t, start, end, "false") {
        if keyed {
            r.booleans.insert(r.path.copy())
        }
        return Tag.Byte(0)
    }
    if first == b'n' and bytes_are(t, start, end, "null") {
        return Tag.End
    }
    // A word that can't be a number is a string. Numbers start with a digit, a sign or `.`, or
    // are `NaN` or `Infinity`.
    if not (is_digit(first) or first == b'-' or first == b'+' or first == b'.' or first == b'N' or first == b'I') {
        return Tag.String(t[start..end])
    }
    let last = t.byte_at(end - 1)
    if last == b'b' or last == b'B' or last == b's' or last == b'S' {
        // FTB takes digits that fit an int, then wants them to fit the kind.
        let v = if ftb_digits(t, start, end - 1) { ftb_integer(t, start, end - 1) ?? 9223372036854775807 } else { 9223372036854775807 }
        if v < -2147483648 or v > 2147483647 {
            return Tag.String(t[start..end])
        }
        let byte = last == b'b' or last == b'B'
        let lo: i64 = if byte { -128 } else { -32768 }
        if v < lo or v > -lo - 1 {
            let kind = if byte { "a byte" } else { "a short" }
            fail snbt_error(t, start, "`{t[start..end]}`, which is past the range of {kind}, {lo} to {-lo - 1}")
        }
        return if byte { Tag.Byte(i8.wrap(v)) } else { Tag.Short(i16.wrap(v)) }
    }
    if last == b'l' or last == b'L' {
        if ftb_digits(t, start, end - 1) {
            if let v = ftb_integer(t, start, end - 1) {
                return Tag.Long(v)
            }
        }
        return Tag.String(t[start..end])
    }
    if last == b'f' or last == b'F' {
        if let v = f32.parse(t[start..end - 1]) {
            return Tag.Float(if v == 0.0 { 0.0 } else { v })
        }
        return Tag.String(t[start..end])
    }
    if last == b'd' or last == b'D' {
        if let v = f64.parse(t[start..end - 1]) {
            return Tag.Double(if v == 0.0 { 0.0 } else { v })
        }
        return Tag.String(t[start..end])
    }
    if ftb_digits(t, start, end) {
        if let v = ftb_integer(t, start, end) {
            if v >= -2147483648 and v <= 2147483647 {
                return Tag.Int(i32.wrap(v))
            }
        }
    }
    // FTB reads an int too big for one as a double, and so whatever else Java's
    // `Double.parseDouble` takes, such as `1.5`, `.5`, `1e3`, `+1` and `NaN`.
    if let v = f64.parse(t[start..end]) {
        return Tag.Double(if v == 0.0 { 0.0 } else { v })
    }
    return Tag.String(t[start..end])
}

// Whether the bytes from `from` to `to` are `word`.
fn bytes_are(t: String, from: usize, to: usize, word: str) -> bool {
    if to - from != word.len() {
        return false
    }
    for i in 0..word.len() {
        if t.byte_at(from + i) != word.byte_at(i) {
            return false
        }
    }
    return true
}

// Whether the bytes from `from` to `to` are an integer as FTB's pattern `-?[0-9]+` takes one.
fn ftb_digits(t: String, from: usize, to: usize) -> bool {
    var i = from
    if i < to and t.byte_at(i) == b'-' {
        i += 1
    }
    if i >= to {
        return false
    }
    while i < to {
        if not is_digit(t.byte_at(i)) {
            return false
        }
        i += 1
    }
    return true
}

// The integer from `from` to `to`, which `ftb_digits` takes, or `none` past a long's range.
fn ftb_integer(t: String, from: usize, to: usize) -> i64? {
    let neg = t.byte_at(from) == b'-'
    let m = match digits_value(t, if neg { from + 1 } else { from }, to, 10) {
        some(v) => v,
        none => return none,
    }
    if neg {
        if m > 9223372036854775808u64 {
            return none
        }
        return some(i64.wrap(0u64.wrapping_sub(m)))
    }
    if m > 9223372036854775807u64 {
        return none
    }
    return some(i64.wrap(m))
}

// A list, or an array if a kind's letter in either case and `;` start it.
fn ftb_list(t: String, at: mut usize, depth: usize, r: mut FtbRead) -> Tag ! SnbtError {
    at += 1
    ftb_skip(t, mut at, false)
    if at < t.len() {
        let k = t.byte_at(at) | 0x20
        if k == b'b' or k == b'i' or k == b'l' {
            var after = at + 1
            ftb_skip(t, mut after, false)
            if after < t.len() and t.byte_at(after) == b';' {
                at = after + 1
                return try ftb_array(t, mut at, k, depth, mut r)
            }
        }
    }
    var items = List<Tag>()
    let mark = r.path.len()
    loop {
        ftb_skip(t, mut at, true)
        if at >= t.len() {
            fail snbt_error(t, at, "the end in a list, where a value or `]` should be")
        }
        let c = t.byte_at(at)
        if c == b']' {
            at += 1
            break
        }
        // Only a compound in a list holds booleans.
        let pathed = c == b'{' or c == b'['
        if pathed {
            r.path.push_str("[{items.len()}]")
        }
        let el_at = at
        let v = try ftb_value(t, mut at, depth, mut r, false)
        if pathed {
            r.path.truncate(mark)
        }
        if v.id() == END {
            fail snbt_error(t, el_at, "`null` in a list, which FTB doesn't take")
        }
        if items.len() > 0 and v.id() != items[0].id() {
            fail snbt_error(t, el_at, "{a_kind(v)} in a list of {items[0].kind_name()}, which FTB doesn't mix")
        }
        items.push(v)
    }
    return Tag.List(items)
}

// An array's numbers, after its `;`, each converted to the array's kind as Minecraft 1.21.1's
// `NumericTag` converts it: an integer's low bits, and a float or a double rounded down with
// `Mth.floor`. A long array takes a float cut toward 0, and a double rounded down, clamped.
fn ftb_array(t: String, at: mut usize, kind: u8, depth: usize, r: mut FtbRead) -> Tag ! SnbtError {
    var bytes = List<i8>()
    var ints = List<i32>()
    var longs = List<i64>()
    loop {
        ftb_skip(t, mut at, true)
        if at >= t.len() {
            fail snbt_error(t, at, "the end in an array, where a number or `]` should be")
        }
        if t.byte_at(at) == b']' {
            at += 1
            break
        }
        let el_at = at
        let v = try ftb_value(t, mut at, depth, mut r, false)
        let x: i64 = match v {
            Byte(x) => i64(x),
            Short(x) => i64(x),
            Int(x) => i64(x),
            Long(x) => x,
            Float(x) => if kind == b'l' { i64.saturate(x) } else { i64(mth_floor_f32(x)) },
            Double(x) => if kind == b'l' { i64.saturate(x.floor()) } else { i64(mth_floor(x)) },
            _ => fail snbt_error(t, el_at, "{a_kind(v)} in an array, where a number should be"),
        }
        if kind == b'b' {
            bytes.push(i8.wrap(x))
        } else if kind == b'i' {
            ints.push(i32.wrap(x))
        } else {
            longs.push(x)
        }
    }
    return if kind == b'b' { Tag.ByteArray(bytes) } else if kind == b'i' { Tag.IntArray(ints) } else { Tag.LongArray(longs) }
}

// Minecraft's `Mth.floor`: Java's `(int)` cast, then one less if that's above. So a double below
// an int's range gives the largest int, as the cast clamps and the one less wraps.
fn mth_floor(v: f64) -> i32 {
    let i = i32.saturate(v)
    return if v < f64(i) { i.wrapping_sub(1) } else { i }
}

fn mth_floor_f32(v: f32) -> i32 {
    let i = i32.saturate(v)
    return if v < f32.nearest(i) { i.wrapping_sub(1) } else { i }
}

// A string in quotes as FTB reads it: up to the same quote, with `\"`, `\\`, `\t`, `\n`, `\b`,
// `\r` and `\f`, and any other `\` dropped with the ASCII rune after it. It can't hold a line
// break.
fn ftb_quoted(t: String, at: mut usize) -> String ! SnbtError {
    let open = at
    let q = t.byte_at(at)
    at += 1
    var end = at
    while end < t.len() {
        let b = t.byte_at(end)
        if b == q or b == b'\\' or b == 10 or b == 13 {
            break
        }
        end += 1
    }
    if end < t.len() and t.byte_at(end) == q {
        let s = t[at..end]
        at = end + 1
        return s
    }
    var out = String()
    var from = at
    loop {
        if at >= t.len() {
            fail snbt_error(t, open, "a string that doesn't end")
        }
        let c = t.byte_at(at)
        if c == 10 or c == 13 {
            fail snbt_error(t, at, "a line break in a string, which FTB doesn't take")
        }
        if c != q and c != b'\\' {
            at += 1
            continue
        }
        out.push_str(t[from..at])
        at += 1
        if c == q {
            return out
        }
        if at >= t.len() {
            fail snbt_error(t, open, "a string that doesn't end")
        }
        let e = t.byte_at(at)
        if e == 10 or e == 13 {
            fail snbt_error(t, at, "a line break in a string, which FTB doesn't take")
        }
        // FTB looks the rune after `\` up in a table of ASCII, and fails past it.
        if e >= 0x80 {
            fail snbt_error(t, at, "{found(t, at)} after `\\`, where FTB takes only ASCII")
        }
        at += 1
        let v: u8 = if e == b'"' or e == b'\\' { e } else if e == b't' { 9 } else if e == b'n' { 10 } else if e == b'b' { 8 } else if e == b'r' { 13 } else if e == b'f' { 12 } else { 0 }
        if v != 0 {
            out.push(rune(v))
        }
        from = at
    }
}

// --- FTB's SNBT written --------------------------------------------------------------------------

// `tag` as FTB's `SNBT.write` writes it, `indent` tabs in. `path` is where it is, kept only when
// there are booleans.
fn ftb_write(tag: Tag, indent: usize, booleans: Set<String>, path: mut String, out: mut String) {
    match tag {
        End => out.push_str("null"),
        Byte(v) => out.push_str("{v}b"),
        Short(v) => out.push_str("{v}s"),
        Int(v) => out.push_str("{v}"),
        Long(v) => out.push_str("{v}L"),
        Float(v) => out.push_str("{v}f"),
        Double(v) => out.push_str("{v}d"),
        String(s) => ftb_quote(s, mut out),
        ByteArray(v) => {
            out.push_str("[B;")
            if v.is_empty() {
                out.push_str(" ]")
            } else if v.len() == 1 {
                out.push_str("{v[0]}b]")
            } else {
                for x in v {
                    out.push('\n')
                    push_tabs(indent + 1, mut out)
                    out.push_str("{x}b")
                }
                out.push('\n')
                push_tabs(indent, mut out)
                out.push(']')
            }
        },
        IntArray(v) => {
            out.push_str("[I;")
            if v.is_empty() {
                out.push_str(" ]")
            } else if v.len() == 1 {
                out.push_str("{v[0]}]")
            } else {
                for x in v {
                    out.push('\n')
                    push_tabs(indent + 1, mut out)
                    out.push_str("{x}")
                }
                out.push('\n')
                push_tabs(indent, mut out)
                out.push(']')
            }
        },
        LongArray(v) => {
            out.push_str("[L;")
            if v.is_empty() {
                out.push_str(" ]")
            } else if v.len() == 1 {
                out.push_str("{v[0]}L]")
            } else {
                for x in v {
                    out.push('\n')
                    push_tabs(indent + 1, mut out)
                    out.push_str("{x}L")
                }
                out.push('\n')
                push_tabs(indent, mut out)
                out.push(']')
            }
        },
        List(items) => {
            if items.is_empty() {
                out.push_str("[ ]")
                return
            }
            out.push('[')
            let one = items.len() == 1
            let mark = path.len()
            for i in 0..items.len() {
                let pathed = not booleans.is_empty() and (items[i].id() == COMPOUND or items[i].id() == LIST)
                if pathed {
                    path.push_str("[{i}]")
                }
                if one {
                    ftb_write(items[i], indent, booleans, mut path, mut out)
                } else {
                    out.push('\n')
                    push_tabs(indent + 1, mut out)
                    ftb_write(items[i], indent + 1, booleans, mut path, mut out)
                }
                if pathed {
                    path.truncate(mark)
                }
            }
            if not one {
                out.push('\n')
                push_tabs(indent, mut out)
            }
            out.push(']')
        },
        Compound(m) => {
            if m.is_empty() {
                out.push_str("\{ \}")
                return
            }
            out.push('{')
            let mark = path.len()
            for (k, v) in m {
                out.push('\n')
                push_tabs(indent + 1, mut out)
                ftb_key(k, mut out)
                out.push_str(": ")
                let id = v.id()
                let pathed = not booleans.is_empty() and (id == BYTE or id == COMPOUND or id == LIST)
                if pathed {
                    ftb_path_key(k, mut path)
                }
                match v {
                    Byte(b) => {
                        if pathed and booleans.contains(path) {
                            out.push_str(if b != 0 { "true" } else { "false" })
                        } else {
                            out.push_str("{b}b")
                        }
                    },
                    _ => ftb_write(v, indent + 1, booleans, mut path, mut out),
                }
                if pathed {
                    path.truncate(mark)
                }
            }
            out.push('\n')
            push_tabs(indent, mut out)
            out.push('}')
        },
    }
}

fn push_tabs(n: usize, out: mut String) {
    for _ in 0..n {
        out.push('\t')
    }
}

// A key as FTB writes it: bare if every UTF-16 unit in it is a letter or a digit to Java, or
// `_-.+`, and quoted otherwise.
fn ftb_key(k: String, out: mut String) {
    var bare = not k.is_empty()
    var i: usize = 0
    while bare and i < k.len() {
        let b = k.byte_at(i)
        if b < 0x80 {
            bare = bare_char(b)
            i += 1
        } else {
            let (c, n) = rune_at(k, i)
            bare = java_alnum(c)
            i += n
        }
    }
    if bare {
        out.push_str(k)
    } else {
        ftb_quote(k, mut out)
    }
}

// `s` in `"`, as FTB writes a string: `"`, `\`, tabs, line breaks, backspaces, carriage returns
// and form feeds escaped, and everything else as it is.
fn ftb_quote(s: String, out: mut String) {
    out.push('"')
    var from: usize = 0
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if c >= 0x20 and c != b'"' and c != b'\\' {
            continue
        }
        let e: u8 = if c == b'"' or c == b'\\' { c } else if c == 8 { b'b' } else if c == 9 { b't' } else if c == 10 { b'n' } else if c == 12 { b'f' } else if c == 13 { b'r' } else { 0 }
        if e == 0 {
            continue
        }
        out.push_str(s[from..i])
        out.push('\\')
        out.push(rune(e))
        from = i + 1
    }
    out.push_str(s[from..s.len()])
    out.push('"')
}

// A tag's kind with its article, for a message: `an INT`, `a STRING`.
fn a_kind(t: Tag) -> String {
    let k = t.kind_name()
    return if k.starts_with("INT") { "an {k}" } else { "a {k}" }
}
