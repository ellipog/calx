/// URLs as text: percent-encoding and decoding as Python's `urllib.parse` quotes and unquotes,
/// form bodies as `urlencode` writes them and `parse_qsl` reads them, and URLs taken apart, put
/// back together and resolved against a base, as RFC 3986 says and `urljoin` does, or, with
/// `urlsplit`, `urlunsplit`, `urljoin` and `urldefrag`, as Python's functions of those names do,
/// corners and all.
module std.url

import std.text.utf8.{decode_lossy_unicode}
import std.unicode.{normalize, Form}

/// The text percent-encoded, as Python's `quote`: each byte of its UTF-8 as `%XX`, in uppercase
/// hex, except letters, digits, `_`, `.`, `-` and `~`, which are never encoded, and the ASCII
/// characters in `safe`, which by default is `/`, so a path keeps its slashes.
pub fn encode(text: String, safe: String = "/") -> String {
    return quote(text, safe, false)
}

/// The text percent-encoded for a form or a query, as Python's `quote_plus`: a space as `+`,
/// and `/` encoded too unless it's in `safe`.
pub fn encode_plus(text: String, safe: String = "") -> String {
    return quote(text, safe, true)
}

/// The text with each `%XX` turned back into its byte, as Python's `unquote`. A `%` without two
/// hex digits after it stays as it is, and bytes that aren't UTF-8 become U+FFFD, as Python's
/// `errors="replace"` makes them.
pub fn decode(text: String) -> String {
    return unquote(text, false)
}

/// The text decoded as `decode` does, with each `+` a space first, as Python's `unquote_plus`.
pub fn decode_plus(text: String) -> String {
    return unquote(text, true)
}

/// Names and values as a form body or a query, as Python's `urlencode`: each name `=` its value,
/// both encoded with `encode_plus`, joined by `&`.
pub fn form_encode(pairs: List<(String, String)>) -> String {
    var out = String()
    for (name, value) in pairs {
        if not out.is_empty() {
            out.push('&')
        }
        out.push_str(encode_plus(name))
        out.push('=')
        out.push_str(encode_plus(value))
    }
    return out
}

/// The names and values in a form body or a query, in order, as Python's
/// `parse_qsl(text, keep_blank_values=True)`: the parts between `&`, each split at its first `=`
/// and decoded with `decode_plus`. A part without `=` is a name with an empty value, and empty
/// parts are skipped.
pub fn form_decode(text: String) -> List<(String, String)> {
    var out: List<(String, String)> = []
    for part in text.split("&") {
        if part.is_empty() {
            continue
        }
        match part.split_once("=") {
            some((name, value)) => out.push((decode_plus(name), decode_plus(value))),
            none => out.push((decode_plus(part), String())),
        }
    }
    return out
}

/// A URL taken apart, as RFC 3986 names its parts. `{url}` puts it back together.
pub struct Url {
    /// `https`, in lowercase.
    pub scheme: String
    /// The user name before the host, still percent-encoded, if there's one.
    pub user: String?
    /// The password after the user name, still percent-encoded, if there's one.
    pub password: String?
    /// The host, without the brackets around an IPv6 address, or `none` if the URL has no
    /// authority, as `mailto:` ones don't. `file:///` has an empty one.
    pub host: String?
    /// The port, if one is written.
    pub port: u16?
    /// The path, still percent-encoded: `/a/b` or empty.
    pub path: String
    /// What follows the `?`, still encoded, if there's a `?`.
    pub query: String?
    /// What follows the `#`, if there's a `#`.
    pub fragment: String?
}

impl Url {
    /// The URL taken apart, or why it can't be: it needs a scheme, and a port has to be a number
    /// up to 65535. Nothing is decoded, so `{url}` gives back the same text, except that the
    /// scheme and host are lowercased.
    pub fn parse(text: String) -> Url ! String {
        let parts = split(text)
        if parts.scheme == none {
            fail "`{text}` has no scheme, such as `https:`"
        }
        return try from_parts(parts.scheme ?? String(), parts.authority, parts.path, parts.query, parts.fragment)
    }

    /// The URL `reference` names, read relative to this one, as RFC 3986's section 5.2 resolves it
    /// and Python's `urljoin` does: `../b?x` from `https://h/a/c` is `https://h/b?x`. A reference
    /// with a scheme stands for itself, less any `.` and `..` in its path.
    pub fn join(self, reference: String) -> Url ! String {
        let r = split(reference)
        if r.scheme != none {
            return try from_parts(r.scheme ?? String(), r.authority, remove_dot_segments(r.path), r.query, r.fragment)
        }
        if r.authority != none {
            return try from_parts(self.scheme.copy(), r.authority, remove_dot_segments(r.path), r.query, r.fragment)
        }
        var path = String()
        var query = r.query
        if r.path.is_empty() {
            path = self.path.copy()
            if query == none {
                query = self.query.copy()
            }
        } else if r.path.starts_with("/") {
            path = remove_dot_segments(r.path)
        } else {
            path = remove_dot_segments(merge(self, r.path))
        }
        return Url {
            scheme: self.scheme.copy(),
            user: self.user.copy(),
            password: self.password.copy(),
            host: self.host.copy(),
            port: self.port,
            path,
            query,
            fragment: r.fragment,
        }
    }

    /// The names and values in the query, as `form_decode` reads them; none if there's no query.
    pub fn query_pairs(self) -> List<(String, String)> {
        return match self.query {
            some(q) => form_decode(q),
            none => [],
        }
    }

    // The authority as it's written: user, password, host and port.
    fn authority(self) -> String? {
        let host = self.host else {
            return none
        }
        var s = String()
        match self.user {
            some(user) => {
                s.push_str(user)
                match self.password {
                    some(password) => {
                        s.push(':')
                        s.push_str(password)
                    }
                    none => {}
                }
                s.push('@')
            }
            none => {}
        }
        if host.contains(":") {
            s.push('[')
            s.push_str(host)
            s.push(']')
        } else {
            s.push_str(host)
        }
        if self.port != none {
            s.push_str(":{self.port ?? 0}")
        }
        return some(s)
    }
}

/// The URL as text, its parts put back as RFC 3986's section 5.3 joins them.
impl Display for Url {
    fn show(self) {
        var s = String()
        s.push_str(self.scheme)
        s.push(':')
        match self.authority() {
            some(a) => {
                s.push_str("//")
                s.push_str(a)
            }
            none => {}
        }
        s.push_str(self.path)
        match self.query {
            some(q) => {
                s.push('?')
                s.push_str(q)
            }
            none => {}
        }
        match self.fragment {
            some(f) => {
                s.push('#')
                s.push_str(f)
            }
            none => {}
        }
        print(s)
    }
}

// A URL or a reference's five parts, as RFC 3986's Appendix B splits them.
struct Parts {
    scheme: String?
    authority: String?
    path: String
    query: String?
    fragment: String?
}

// The parts are found by their offsets, in one pass, so the only text made is the parts'.
fn split(text: String) -> Parts {
    let n = text.len()
    let hash = index(text, b'#', 0, n)
    let end = index(text, b'?', 0, hash)
    var fragment: String? = none
    if hash < n {
        fragment = some(text[hash + 1..])
    }
    var query: String? = none
    if end < hash {
        query = some(text[end + 1..hash])
    }
    // A scheme is letters, digits, `+`, `-` and `.` after a letter, then `:`, before any `/`.
    var scheme: String? = none
    var start: usize = 0
    let colon = index(text, b':', 0, end)
    if colon > 0 and colon < end and is_scheme(text, colon) {
        scheme = some(lower(text[..colon]))
        start = colon + 1
    }
    var authority: String? = none
    if start + 1 < end and text.byte_at(start) == b'/' and text.byte_at(start + 1) == b'/' {
        let slash = index(text, b'/', start + 2, end)
        authority = some(text[start + 2..slash])
        start = slash
    }
    return Parts { scheme, authority, path: text[start..end], query, fragment }
}

// The first `byte` in `text` from `from` up to `to`, or `to` if there's none there.
fn index(text: String, byte: u8, from: usize, to: usize) -> usize {
    for i in from..to {
        if text.byte_at(i) == byte {
            return i
        }
    }
    return to
}

// The text in lowercase, as Python lowercases a scheme and a host, made anew only when there's
// something to lower, which there mostly isn't.
fn lower(text: own String) -> String {
    for i in 0usize..text.len() {
        let c = text.byte_at(i)
        if (c >= b'A' and c <= b'Z') or c >= 0x80 {
            return text.to_lower_root()
        }
    }
    return text
}

fn is_scheme(text: String, end: usize) -> bool {
    for i in 0usize..end {
        let c = text.byte_at(i)
        let letter = (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
        if i == 0 and not letter {
            return false
        }
        if not letter and not (c >= b'0' and c <= b'9') and c != b'+' and c != b'-' and c != b'.' {
            return false
        }
    }
    return true
}

fn from_parts(scheme: own String, authority: String?, path: own String, query: own String?, fragment: own String?) -> Url ! String {
    var user: String? = none
    var password: String? = none
    var host: String? = none
    var port: u16? = none
    match authority {
        some(a) => {
            // Offsets again: the host and port start after the last `@`, and the user name and
            // password before it split at its first `:`.
            let n = a.len()
            var from: usize = 0
            match a.find_last("@") {
                some(at) => {
                    let c = index(a, b':', 0, at)
                    if c < at {
                        user = some(a[..c])
                        password = some(a[c + 1..at])
                    } else {
                        user = some(a[..at])
                    }
                    from = at + 1
                }
                none => {}
            }
            var start = from    // the host, from `start` up to `end`
            var end = n
            var digits = n      // and the port's digits, from here to the end
            if from < n and a.byte_at(from) == b'[' {
                let close = index(a, b']', from, n)
                if close == n {
                    fail "`{a[from..]}` opens an IPv6 address with `[` and doesn't close it"
                }
                start = from + 1
                end = close
                if close + 1 < n {
                    if a.byte_at(close + 1) != b':' {
                        fail "`{a[close + 1..]}` can't follow an IPv6 address; a port goes after `:`"
                    }
                    digits = close + 2
                }
            } else {
                // The first `:`, as Python splits there, so `a:b:c` has the port `b:c`, which
                // isn't one.
                end = index(a, b':', from, n)
                if end < n {
                    digits = end + 1
                }
                if index(a, b'[', from, end) < end or index(a, b']', from, end) < end {
                    fail "`{a[from..]}` has a bracket that isn't around an IPv6 address"
                }
            }
            if digits < n {
                var v: u32 = 0
                for i in digits..n {
                    let d = a.byte_at(i)
                    if d < b'0' or d > b'9' {
                        fail "the port `{a[digits..]}` isn't a number"
                    }
                    v = v * 10 + u32(d - b'0')
                    if v > 65535 {
                        fail "the port {a[digits..]} is more than 65535"
                    }
                }
                port = some(u16.wrap(v))
            }
            host = some(lower(a[start..end]))
        }
        none => {}
    }
    return Url { scheme, user, password, host, port, path, query, fragment }
}

// RFC 3986's 5.2.3: the reference's path after the base's, up to and with its last `/`.
fn merge(base: Url, path: String) -> String {
    if base.host != none and base.path.is_empty() {
        return "/{path}"
    }
    let cut = base.path.find_last("/") else {
        return path.copy()
    }
    var out = base.path[..cut + 1]
    out.push_str(path)
    return out
}

// RFC 3986's 5.2.4: the path without its `.` and `..` segments, each `..` taking away the one
// before it.
fn remove_dot_segments(path: String) -> String {
    if not has_dot_segment(path) {
        return path.copy()
    }
    var out: List<String> = []
    let segments = path.split("/")
    let absolute = path.starts_with("/")
    let n = segments.len()
    for i in 0usize..n {
        let s = segments[i].copy()
        if i == 0 and absolute {
            continue
        }
        if s == "." or s == ".." {
            if s == ".." and out.len() > 0 {
                _ = out.pop()
            }
            // A last `.` or `..` leaves the path ending in `/`.
            if i == n - 1 {
                out.push(String())
            }
            continue
        }
        out.push(s)
    }
    let joined = out.join("/")
    return if absolute { "/{joined}" } else { joined }
}

// Whether a segment of the path is `.` or `..`, which most paths have none of.
fn has_dot_segment(path: String) -> bool {
    let n = path.len()
    var start: usize = 0
    while start <= n {
        let end = index(path, b'/', start, n)
        let len = end - start
        if (len == 1 or len == 2) and path.byte_at(start) == b'.' and path.byte_at(end - 1) == b'.' {
            return true
        }
        start = end + 1
    }
    return false
}

// Which ASCII bytes stay as they are: letters, digits, `_`, `.`, `-`, `~` and those in `safe`.
// Python ignores what in `safe` isn't ASCII, and so does this.
fn kept(safe: String) -> [bool; 128] {
    var keep = [false; 128]
    for i in 0usize..128 {
        let c = u8.wrap(i)
        keep[i] = (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'_' or c == b'.' or c == b'-' or c == b'~'
    }
    for i in 0usize..safe.len() {
        let c = safe.byte_at(i)
        if c < 128 {
            keep[usize(c)] = true
        }
    }
    return keep
}

fn quote(text: String, safe: String, plus: bool) -> String {
    let keep = kept(safe)
    var out = String()
    out.reserve(text.len())
    for i in 0usize..text.len() {
        let b = text.byte_at(i)
        // `quote_plus` makes a space `+` even when `safe` holds a space.
        if plus and b == b' ' {
            out.push('+')
        } else if b < 128 and keep[usize(b)] {
            out.push(rune(b))
        } else {
            out.push('%')
            out.push(hex_digit(b / 16))
            out.push(hex_digit(b % 16))
        }
    }
    return out
}

fn hex_digit(v: u8) -> rune {
    return rune(if v < 10 { v + 48 } else { v + 55 })
}

fn hex_value(c: u8) -> u8? {
    if c >= b'0' and c <= b'9' {
        return some(c - b'0')
    }
    if c >= b'a' and c <= b'f' {
        return some(c - b'a' + 10)
    }
    if c >= b'A' and c <= b'F' {
        return some(c - b'A' + 10)
    }
    return none
}

fn unquote(text: String, plus: bool) -> String {
    let n = text.len()
    var out: List<u8> = []
    out.reserve(n)
    var i: usize = 0
    while i < n {
        let b = text.byte_at(i)
        if b == b'%' and i + 2 < n {
            let hi = hex_value(text.byte_at(i + 1))
            let lo = hex_value(text.byte_at(i + 2))
            if hi != none and lo != none {
                out.push((hi ?? 0) * 16 + (lo ?? 0))
                i += 3
                continue
            }
        }
        out.push(if plus and b == b'+' { b' ' } else { b })
        i += 1
    }
    return decode_lossy_unicode(out, 0, out.len())
}

// --- Python's urllib.parse, as it is ------------------------------------------------------------
//
// These follow CPython 3.14's Lib/urllib/parse.py and, for a host in brackets, Lib/ipaddress.py,
// under the Python Software Foundation License, Version 2, whose notice is in
// std/regex/sre.calx. They're written anew in Calx.

/// A URL split as Python's `urlsplit` splits it: `scheme://netloc/path?query#fragment`, with `""`
/// for each part that isn't there, and the scheme in lowercase.
pub struct SplitUrl {
    pub scheme: String
    pub netloc: String
    pub path: String
    pub query: String
    pub fragment: String
}

/// `url` split as Python's `urlsplit(url)` splits it, or the `ValueError` it raises: for a
/// netloc with one bracket and not the other, an IPv6 address in brackets that isn't one, or a
/// netloc whose NFKC form has a `/`, `?`, `#`, `@` or `:` it didn't have.
pub fn urlsplit(url: String) -> SplitUrl ! String {
    let p = try split_python(url)
    return SplitUrl { scheme: p.scheme ?? String(), netloc: p.netloc ?? String(), path: p.path, query: p.query ?? String(), fragment: p.fragment ?? String() }
}

/// The parts put back together as Python's `urlunsplit` and `geturl` put them: an empty query
/// or fragment leaves out its `?` or `#`, and a scheme that has a netloc in Python, such as
/// `file`, keeps its `//` with an empty one.
pub fn urlunsplit(parts: SplitUrl) -> String {
    var netloc: String? = none
    if not parts.netloc.is_empty() {
        netloc = some(parts.netloc.copy())
    } else if not parts.scheme.is_empty() and in_list(USES_NETLOC, parts.scheme) and (parts.path.is_empty() or parts.path.starts_with("/")) {
        netloc = some(String())
    }
    let scheme: String? = if parts.scheme.is_empty() { none } else { some(parts.scheme.copy()) }
    let query: String? = if parts.query.is_empty() { none } else { some(parts.query.copy()) }
    let fragment: String? = if parts.fragment.is_empty() { none } else { some(parts.fragment.copy()) }
    return unsplit_python(scheme, netloc, parts.path, query, fragment)
}

/// `url` read relative to `base` as Python's `urljoin(base, url)` reads it, or the `ValueError`
/// it raises. Unlike `Url.join`, it's Python's to the letter: a scheme Python doesn't take as
/// relative, such as `urn:`, makes `url` stand for itself, `..` above the root is dropped, and an
/// empty query or fragment keeps its `?` or `#`.
pub fn urljoin(base: String, url: String) -> String ! String {
    if base.is_empty() {
        return url.copy()
    }
    if url.is_empty() {
        return base.copy()
    }
    let b = try split_python(base)
    let u = try split_python(url)
    var scheme = u.scheme.copy()
    if scheme == none {
        scheme = b.scheme.copy()
    }
    let s = scheme.copy() ?? String()
    if scheme != b.scheme or (not s.is_empty() and not in_list(USES_RELATIVE, s)) {
        return url.copy()
    }
    var netloc = u.netloc.copy()
    if s.is_empty() or in_list(USES_NETLOC, s) {
        if not (netloc.copy() ?? String()).is_empty() {
            return unsplit_python(scheme, netloc, u.path, u.query, u.fragment)
        }
        netloc = b.netloc.copy()
    }
    if u.path.is_empty() {
        var query = u.query.copy()
        var fragment = u.fragment.copy()
        if query == none {
            query = b.query.copy()
            if fragment == none {
                fragment = b.fragment.copy()
            }
        }
        return unsplit_python(scheme, netloc, b.path, query, fragment)
    }
    var base_parts = b.path.split("/")
    if base_parts[base_parts.len() - 1] != "" {
        // The last part isn't a directory, so it isn't taken into account.
        _ = base_parts.pop()
    }
    var segments = List<String>()
    if u.path.starts_with("/") {
        segments = u.path.split("/")
    } else {
        var all = base_parts
        all.extend(u.path.split("/"))
        // Empty parts between the first and the last would make doubled slashes.
        for i in 0..all.len() {
            if i == 0 or i == all.len() - 1 or not all[i].is_empty() {
                segments.push(all[i].copy())
            }
        }
    }
    var resolved = List<String>()
    for seg in segments {
        if seg == ".." {
            _ = resolved.pop()
        } else if seg != "." {
            resolved.push(seg.copy())
        }
    }
    let last = segments[segments.len() - 1].copy()
    if last == "." or last == ".." {
        resolved.push(String())
    }
    var path = resolved.join("/")
    if path.is_empty() {
        path = String("/")
    }
    return unsplit_python(scheme, netloc, path, u.query, u.fragment)
}

/// `url` without its fragment, and the fragment, as Python's `urldefrag(url)` gives them: `""`
/// for none, and the URL as it is when it has no `#`.
pub fn urldefrag(url: String) -> (String, String) ! String {
    if not url.contains("#") {
        return (url.copy(), String())
    }
    let p = try split_python(url)
    return (unsplit_python(p.scheme, p.netloc, p.path, p.query, none), p.fragment ?? String())
}

const USES_RELATIVE: str = ",ftp,http,gopher,nntp,imap,wais,file,https,shttp,mms,prospero,rtsp,rtsps,rtspu,sftp,svn,svn+ssh,ws,wss,"
const USES_NETLOC: str = ",ftp,http,gopher,nntp,telnet,imap,wais,file,mms,https,shttp,snews,prospero,rtsp,rtsps,rtspu,rsync,svn,svn+ssh,sftp,nfs,git,git+ssh,ws,wss,itms-services,"

// Whether `s` is one of the names in `list`, which has a comma before and after each.
fn in_list(list: str, s: String) -> bool {
    return list.contains(",{s},")
}

// The parts as `_urlsplit` gives them, `none` where it gives `None`.
struct PyParts {
    scheme: String?
    netloc: String?
    path: String
    query: String?
    fragment: String?
}

fn is_scheme_byte(b: u8) -> bool {
    return (b >= b'a' and b <= b'z') or (b >= b'A' and b <= b'Z') or (b >= b'0' and b <= b'9') or b == b'+' or b == b'-' or b == b'.'
}

// Python's `_urlsplit(url, None, True)`.
fn split_python(text: String) -> PyParts ! String {
    // Leading C0 controls and spaces go, and tabs and line breaks anywhere.
    var start: usize = 0
    while start < text.len() and text.byte_at(start) <= 0x20 {
        start += 1
    }
    var url = String()
    for r in text[start..].runes() {
        if r != '\t' and r != '\r' and r != '\n' {
            url.push(r)
        }
    }
    var scheme: String? = none
    if let i = url.find(":") {
        let first = url.byte_at(0)
        if i > 0 and ((first >= b'a' and first <= b'z') or (first >= b'A' and first <= b'Z')) {
            var all = true
            for k in 0..i {
                if not is_scheme_byte(url.byte_at(k)) {
                    all = false
                    break
                }
            }
            if all {
                scheme = some(url[..i].to_lower_root())
                url = url[i + 1..]
            }
        }
    }
    var netloc: String? = none
    if url.starts_with("//") {
        var delim = url.len()
        for k in 2..url.len() {
            let b = url.byte_at(k)
            if b == b'/' or b == b'?' or b == b'#' {
                delim = k
                break
            }
        }
        let n = url[2..delim]
        url = url[delim..]
        let open = n.contains("[")
        let close = n.contains("]")
        if open != close {
            fail String("Invalid IPv6 URL")
        }
        if open and close {
            try check_bracketed_netloc(n)
        }
        netloc = some(n)
    }
    var fragment: String? = none
    if let (u, f) = url.split_once("#") {
        fragment = some(f.copy())
        url = u.copy()
    }
    var query: String? = none
    if let (u, q) = url.split_once("?") {
        query = some(q.copy())
        url = u.copy()
    }
    if let n = netloc {
        try check_netloc(n)
    }
    return PyParts { scheme, netloc, path: url, query, fragment }
}

// Python's `_urlunsplit`.
fn unsplit_python(scheme: String?, netloc: String?, path: String, query: String?, fragment: String?) -> String {
    var url = path.copy()
    if let n = netloc {
        if not url.is_empty() and not url.starts_with("/") {
            url = "/{url}"
        }
        url = "//{n}{url}"
    } else if url.starts_with("//") {
        url = "//{url}"
    }
    if let s = scheme {
        if not s.is_empty() {
            url = "{s}:{url}"
        }
    }
    if let q = query {
        url.push('?')
        url.push_str(q)
    }
    if let f = fragment {
        url.push('#')
        url.push_str(f)
    }
    return url
}

// `_checknetloc`: a netloc that isn't ASCII mustn't gain a `/`, `?`, `#`, `@` or `:` under NFKC.
fn check_netloc(netloc: String) ! String {
    var ascii = true
    for i in 0..netloc.len() {
        if netloc.byte_at(i) >= 0x80 {
            ascii = false
        }
    }
    if ascii {
        return
    }
    let n = netloc.replace("@", "").replace(":", "").replace("#", "").replace("?", "")
    let nfkc = normalize(n, Form.NFKC)
    if nfkc == n {
        return
    }
    let marks: List<String> = ["/", "?", "#", "@", ":"]
    for c in marks {
        if nfkc.contains(c) {
            fail "netloc '{netloc}' contains invalid characters under NFKC normalization"
        }
    }
}

// `_check_bracketed_netloc`: what's in brackets has to be an IPv6 address or an IPvFuture one.
fn check_bracketed_netloc(netloc: String) ! String {
    var hostport = netloc.copy()
    if let k = netloc.find_last("@") {
        hostport = netloc[k + 1..]
    }
    var host = String()
    if let (before, bracketed) = hostport.split_once("[") {
        if not before.is_empty() {
            fail String("Invalid IPv6 URL")
        }
        var port = String()
        if let (h, p) = bracketed.split_once("]") {
            host = h.copy()
            port = p.copy()
        } else {
            host = bracketed.copy()
        }
        if not port.is_empty() and not port.starts_with(":") {
            fail String("Invalid IPv6 URL")
        }
    } else if let (h, _) = hostport.split_once(":") {
        host = h.copy()
    } else {
        host = hostport.copy()
    }
    if host.starts_with("v") {
        // \Av[a-fA-F0-9]+\..+\z
        var i: usize = 1
        while i < host.len() and hex_value(host.byte_at(i)) != none {
            i += 1
        }
        if i == 1 or i >= host.len() or host.byte_at(i) != b'.' or i + 1 >= host.len() {
            fail String("IPvFuture address is invalid")
        }
        return
    }
    if is_ipv4(host) {
        fail String("An IPv4 address cannot be in brackets")
    }
    if not is_ipv6(host) {
        fail "'{host}' does not appear to be an IPv4 or IPv6 address"
    }
}

// Whether `s` is an IPv4 address as Python's `ipaddress` reads one: four decimal octets up to 255,
// none with a leading zero.
fn is_ipv4(s: String) -> bool {
    let octets = s.split(".")
    if octets.len() != 4 {
        return false
    }
    for o in octets {
        if o.is_empty() or o.len() > 3 {
            return false
        }
        var v: u32 = 0
        for i in 0..o.len() {
            let b = o.byte_at(i)
            if b < b'0' or b > b'9' {
                return false
            }
            v = v * 10 + u32(b - b'0')
        }
        if (o.len() > 1 and o.byte_at(0) == b'0') or v > 255 {
            return false
        }
    }
    return true
}

// Whether `s` is an IPv6 address as Python's `ipaddress` reads one, with a scope after `%` and
// an IPv4 address as its last 32 bits allowed.
fn is_ipv6(text: String) -> bool {
    var s = text.copy()
    if let (a, scope) = text.split_once("%") {
        if scope.is_empty() or scope.contains("%") {
            return false
        }
        s = a.copy()
    }
    if s.is_empty() {
        return false
    }
    var parts = s.split(":")
    if parts.len() < 3 {
        return false
    }
    if parts[parts.len() - 1].contains(".") {
        let last = parts.pop() ?? String()
        if not is_ipv4(last) {
            return false
        }
        parts.push(String("0"))
        parts.push(String("0"))
    }
    if parts.len() > 9 {
        return false
    }
    var skip: i64 = -1
    for i in 1..parts.len() - 1 {
        if parts[i].is_empty() {
            if skip >= 0 {
                return false
            }
            skip = i64.wrap(i)
        }
    }
    var hi = parts.len()
    var lo: usize = 0
    if skip >= 0 {
        hi = usize.wrap(skip)
        lo = parts.len() - hi - 1
        if parts[0].is_empty() {
            if hi != 1 {
                return false
            }
            hi = 0
        }
        if parts[parts.len() - 1].is_empty() {
            if lo != 1 {
                return false
            }
            lo = 0
        }
        if hi + lo + 1 > 8 {
            return false
        }
    } else if parts.len() != 8 or parts[0].is_empty() or parts[7].is_empty() {
        return false
    }
    for i in 0..parts.len() {
        if i < hi or i >= parts.len() - lo {
            let h = parts[i].copy()
            if h.len() > 4 {
                return false
            }
            for k in 0..h.len() {
                if hex_value(h.byte_at(k)) == none {
                    return false
                }
            }
        }
    }
    return true
}
