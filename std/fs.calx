/// Files and directories: whole files read and written, parts of files read and written in
/// place, copies, renames, sizes and modified times, directories made, listed, walked, copied
/// and removed, globs, links read and made, the current folder, absolute and real paths, and
/// temporary directories.
module std.fs

import std.path.{join, normalize, glob_matches_name, root as path_root, parts as path_parts}
import std.time.{Timestamp}

extern "C" {
    fn cx_fs_copy(from: *const u8, from_len: usize, to: *const u8, to_len: usize) -> i32
    fn cx_fs_current_dir() -> i32
    fn cx_fs_set_current_dir(path: *const u8, len: usize) -> i32
    fn cx_fs_absolute(path: *const u8, len: usize) -> i32
    fn cx_fs_open(path: *const u8, len: usize, write: u32) -> i64
    fn cx_fs_size(h: i64) -> i64
    fn cx_fs_read(h: i64, to: *u8, n: usize) -> i64
    fn cx_fs_seek(h: i64, at: u64) -> i32
    fn cx_fs_write(h: i64, from: *const u8, n: usize) -> i32
    fn cx_fs_sync(h: i64) -> i32
    fn cx_fs_close(h: i64) -> i32
    fn cx_fs_lock(path: *const u8, len: usize, bytes: *const u8, n: usize) -> i64
    fn cx_fs_unlock(h: i64) -> i32
    fn cx_fs_rename(from: *const u8, from_len: usize, to: *const u8, to_len: usize, sync: u32) -> i32
    fn cx_fs_remove_file(path: *const u8, len: usize) -> i32
    fn cx_fs_remove_dir(path: *const u8, len: usize) -> i32
    fn cx_fs_make_dir(path: *const u8, len: usize) -> i32
    fn cx_fs_kind(path: *const u8, len: usize, follow: u32) -> u32
    fn cx_fs_list(path: *const u8, len: usize) -> i32
    fn cx_fs_list_typed(path: *const u8, len: usize) -> i32
    fn cx_fs_temp_dir() -> i32
    fn cx_fs_real_path(path: *const u8, len: usize) -> i32
    fn cx_fs_read_link(path: *const u8, len: usize) -> i32
    fn cx_fs_make_link(target: *const u8, target_len: usize, path: *const u8, len: usize) -> i32
    fn cx_fs_separator() -> u8
    fn cx_fs_stat(path: *const u8, len: usize) -> i32
    fn cx_fs_stat_size() -> i64
    fn cx_fs_stat_modified() -> i64
    fn cx_fs_set_modified(path: *const u8, len: usize, ms: i64) -> i32
    fn cx_fs_stat_mode() -> u32
    fn cx_fs_stat_kind() -> u32
    fn cx_fs_handle_stat(h: i64) -> i32
    fn cx_fs_set_mode(path: *const u8, len: usize, mode: u32) -> i32
    fn cx_fs_result_len() -> usize
    fn cx_fs_result_copy(to: *u8)
    fn cx_fs_error_kind() -> u32
    fn cx_fs_error_code() -> i32
}

/// Why something with a file or directory failed.
pub enum FsError {
    /// Nothing is at the path, or a directory on the way to it is missing.
    NotFound
    /// The system doesn't allow it, such as writing a read-only file.
    Denied
    /// Something is already at the path.
    Exists
    /// The path can't name anything, such as one with a NUL byte in it.
    BadPath
    /// It's a directory, where a file was wanted.
    IsDirectory
    /// The directory isn't empty.
    NotEmpty
    /// Something else, with the system's error code.
    Os(i32)
}

/// What went wrong, in words, as Python says it: `not found`, `permission denied`, or
/// `system error 32` with the system's code. In an `Error`, after what was being done:
/// `reading config.toml: not found`.
impl Display for FsError {
    fn show(self) {
        match self {
            NotFound => print("not found"),
            Denied => print("permission denied"),
            Exists => print("already exists"),
            BadPath => print("not a valid path"),
            IsDirectory => print("is a directory"),
            NotEmpty => print("directory not empty"),
            Os(code) => print("system error {code}"),
        }
    }
}

/// What `metadata` reads of a file or a directory.
pub struct Metadata {
    /// Its length in bytes. A directory's is whatever the system says, often 0.
    pub size: u64
    /// When what it holds last changed, to the millisecond, as Java's `File.lastModified` gives
    /// it. Writing or appending to a file sets it.
    pub modified: Timestamp
    /// Its permission bits, as Unix gives them, such as `0o644`: read, write and run for its
    /// owner, its group and everyone else. On Windows, which has only a read-only flag, they're
    /// `0o666`, or `0o444` when it's read-only, with `0o111` added for a directory.
    pub mode: u32
    /// What it is, following links: a `File`, a `Dir` or `Other`, so one `metadata` says what
    /// `is_file` or `is_dir` would, without asking the system again.
    pub kind: Kind
}

/// What a link points to, as `read_link` reads it.
pub struct Link {
    /// Where it leads, as it was made: relative to the link's directory or absolute, not resolved,
    /// and maybe to nothing, as Java's `Files.readSymbolicLink` gives it.
    pub target: String
    /// Whether it's a Windows junction, a link to a directory by its absolute path, which Java
    /// takes for the directory itself. It's `false` on other systems, which have none.
    pub junction: bool
}

/// What's at a path.
pub enum Kind {
    File
    Dir
    /// A symbolic link, or on Windows a junction, which `kind` doesn't follow.
    Link
    /// Something else, such as a device or a socket.
    Other
}

fn last_error() -> FsError {
    let code = unsafe { cx_fs_error_kind() }
    return match code {
        1 => FsError.NotFound,
        2 => FsError.Denied,
        3 => FsError.Exists,
        4 => FsError.BadPath,
        5 => FsError.IsDirectory,
        6 => FsError.NotEmpty,
        _ => FsError.Os(unsafe { cx_fs_error_code() }),
    }
}

// The runtime's result buffer, as text.
fn result() -> String {
    var bytes = List<u8>()
    unsafe {
        let n = cx_fs_result_len()
        bytes.reserve(n)
        cx_fs_result_copy(bytes.as_mut_ptr())
        bytes.set_len(n)
    }
    return String.from_utf8(bytes)!
}

/// The whole file at `path`.
pub fn read(path: String) -> List<u8> ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 0) }
    if h < 0 {
        fail last_error()
    }
    var out = List<u8>()
    // One byte past the size, so that reading a file whole sees its end without growing.
    let size = unsafe { cx_fs_size(h) }
    out.reserve(if size >= 0 { usize.wrap(size) + 1 } else { 16384 })
    loop {
        if out.len() == out.capacity() {
            out.reserve(out.len())
        }
        let at = out.len()
        let n = unsafe { cx_fs_read(h, out.as_mut_ptr().add(at), out.capacity() - at) }
        if n < 0 {
            let e = last_error()
            _ = unsafe { cx_fs_close(h) }
            fail e
        }
        if n == 0 {
            break
        }
        unsafe {
            out.set_len(at + usize.wrap(n))
        }
    }
    _ = unsafe { cx_fs_close(h) }
    return out
}

/// The `n` bytes of the file at `path` from byte `from`, or fewer where the file ends before
/// them, read without reading the rest of the file.
pub fn read_part(path: String, from: u64, n: usize) -> List<u8> ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 0) }
    if h < 0 {
        fail last_error()
    }
    var out = List<u8>()
    if not read_range(h, from, n, mut out) {
        let e = last_error()
        _ = unsafe { cx_fs_close(h) }
        fail e
    }
    _ = unsafe { cx_fs_close(h) }
    return out
}

/// What `read_part` gives for each of `ranges`, a byte offset and a length, from one opening of
/// the file at `path`: for reading many parts of one file, such as a region file's chunks.
pub fn read_parts(path: String, ranges: List<(u64, usize)>) -> List<List<u8>> ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 0) }
    if h < 0 {
        fail last_error()
    }
    var parts = List<List<u8>>()
    parts.reserve(ranges.len())
    for (from, n) in ranges {
        var out = List<u8>()
        if not read_range(h, from, n, mut out) {
            let e = last_error()
            _ = unsafe { cx_fs_close(h) }
            fail e
        }
        parts.push(out)
    }
    _ = unsafe { cx_fs_close(h) }
    return parts
}

// Reads up to `n` bytes from `from` onto `out`, stopping where the file ends. False if the
// system failed, with why in `last_error`.
fn read_range(h: i64, from: u64, n: usize, out: mut List<u8>) -> bool {
    if unsafe { cx_fs_seek(h, from) } == 0 {
        return false
    }
    out.reserve(n)
    let start = out.len()
    while out.len() - start < n {
        let at = out.len()
        let got = unsafe { cx_fs_read(h, out.as_mut_ptr().add(at), n - (at - start)) }
        if got < 0 {
            return false
        }
        if got == 0 {
            break
        }
        unsafe {
            out.set_len(at + usize.wrap(got))
        }
    }
    return true
}

/// The whole file at `path` as text, which fails with `none` inside `ok` if it isn't UTF-8.
pub fn read_text(path: String) -> String? ! FsError {
    return String.from_utf8(try read(path))
}

// Opens `path` to write, `mode` 1 to replace what it holds and 2 to add to its end.
fn open_to(path: String, mode: u32) -> i64 ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), mode) }
    if h < 0 {
        fail last_error()
    }
    return h
}

// Closes `h` after a write, which `wrote` says went or not, failing with the write's error first.
fn close_after(h: i64, wrote: i32) ! FsError {
    let e = if wrote == 0 { some(last_error()) } else { none }
    let closed = unsafe { cx_fs_close(h) }
    if let first = e {
        fail first
    }
    if closed == 0 {
        fail last_error()
    }
}

/// Makes the file at `path` hold `bytes`, creating it or replacing what it held. A crash part
/// way through can leave it half written: to replace a file safely, write another and `rename`
/// it over this one.
pub fn write(path: String, bytes: List<u8>) ! FsError {
    let h = try open_to(path, 1)
    try close_after(h, unsafe { cx_fs_write(h, bytes.as_ptr(), bytes.len()) })
}

/// Makes the file at `path` hold `text`, as UTF-8, as `write` makes it hold bytes, without
/// copying the text first.
pub fn write_text(path: String, text: String) ! FsError {
    let h = try open_to(path, 1)
    try close_after(h, unsafe { cx_fs_write(h, text.as_ptr(), text.len()) })
}

/// Adds `bytes` to the end of the file at `path`, creating it if nothing is there. The
/// bytes go after everything the file held, even what another program added since it opened it.
pub fn append(path: String, bytes: List<u8>) ! FsError {
    let h = try open_to(path, 2)
    try close_after(h, unsafe { cx_fs_write(h, bytes.as_ptr(), bytes.len()) })
}

/// Adds `text` to the end of the file at `path`, as UTF-8, as `append` adds bytes: for a log a
/// program adds a line to now and then.
pub fn append_text(path: String, text: String) ! FsError {
    let h = try open_to(path, 2)
    try close_after(h, unsafe { cx_fs_write(h, text.as_ptr(), text.len()) })
}

/// Writes each of `parts`, a byte offset and the bytes to put there, into the file at `path`, in
/// order, creating the file if nothing is there and leaving the rest of what it holds as it was.
/// A part that ends past the end makes the file longer, and one that starts past it leaves
/// zeros between. A later part wins where two overlap.
///
/// With `sync`, it returns only once the system says the bytes are on the disk, as Java's
/// `FileChannel.force(true)`, so nothing written after can reach the disk before them: a region
/// file's chunks can be written, synced, and then the header that points at them. A crash part
/// way through can leave any of the parts written or not.
pub fn write_parts(path: String, parts: List<(u64, List<u8>)>, sync: bool) ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 3) }
    if h < 0 {
        fail last_error()
    }
    var wrote = true
    for (at, bytes) in parts {
        if unsafe { cx_fs_seek(h, at) } == 0 or unsafe { cx_fs_write(h, bytes.as_ptr(), bytes.len()) } == 0 {
            wrote = false
            break
        }
    }
    if wrote and sync {
        wrote = unsafe { cx_fs_sync(h) } != 0
    }
    let e = if not wrote { some(last_error()) } else { none }
    let closed = unsafe { cx_fs_close(h) }
    if let first = e {
        fail first
    }
    if closed == 0 {
        fail last_error()
    }
}

/// A file kept open to read and write parts of, as Java keeps a `FileChannel`, for a program that
/// goes back to the same file again and again, such as a game's region files. Each of the
/// functions above opens the file and closes it again, and on Windows a file closed after a write
/// is scanned again by the antivirus: writing 20 KB into a 4 MB file took 3 ms that way on the
/// reference machine, where a `File` kept open took 30 µs. It's open until `close`, or until the
/// program ends, so a program keeps the files it uses most and closes the rest. It's a handle, so
/// it can't be copied: there's one open file, and one thing to close it.
@handle
pub struct File {
    handle: i64
    named: String
}

/// Opens the file at `path` to read and write, creating it if nothing is there and keeping what
/// it holds. Other programs, and this one, can read, write and remove it while it's open, as Java
/// lets them while it has a `FileChannel` open.
pub fn open(path: String) -> File ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 3) }
    if h < 0 {
        fail last_error()
    }
    return File { handle: h, named: path.copy() }
}

/// Opens the file at `path` only to read, as Python's `open(path, "rb")`: `NotFound` if nothing's
/// there, rather than a new empty file, and writing through it fails. For reading a big file a
/// part at a time.
pub fn open_read(path: String) -> File ! FsError {
    let h = unsafe { cx_fs_open(path.as_ptr(), path.len(), 0) }
    if h < 0 {
        fail last_error()
    }
    return File { handle: h, named: path.copy() }
}

impl File {
    /// The path it was opened at.
    pub fn path(self) -> String {
        return self.named.copy()
    }

    /// The system's handle to it, as Python's `fileno()`: a `HANDLE` on Windows and a file
    /// descriptor on Linux, for passing to the system through `extern "C"`. It's the file's for as
    /// long as it's open, and closing it any way but `close` is the program's mistake.
    pub fn raw(self) -> i64 {
        return self.handle
    }

    /// Its size, modified time, permission bits and kind, as `metadata` reads them, from the
    /// file already open, which on Windows is quicker than opening it again by its path.
    pub fn metadata(self) -> Metadata ! FsError {
        if unsafe { cx_fs_handle_stat(self.handle) } == 0 {
            fail last_error()
        }
        return stat_result()
    }

    /// Its length in bytes.
    pub fn size(self) -> u64 ! FsError {
        let size = unsafe { cx_fs_size(self.handle) }
        if size < 0 {
            fail last_error()
        }
        return u64.wrap(size)
    }

    /// The `n` bytes from byte `from`, or fewer where the file ends first, as `read_part` reads
    /// them.
    pub fn read_part(self, from: u64, n: usize) -> List<u8> ! FsError {
        var out = List<u8>()
        if not read_range(self.handle, from, n, mut out) {
            fail last_error()
        }
        return out
    }

    /// What `read_part` gives for each of `ranges`, a byte offset and a length, in order.
    pub fn read_parts(self, ranges: List<(u64, usize)>) -> List<List<u8>> ! FsError {
        var parts = List<List<u8>>()
        parts.reserve(ranges.len())
        for (from, n) in ranges {
            var out = List<u8>()
            if not read_range(self.handle, from, n, mut out) {
                fail last_error()
            }
            parts.push(out)
        }
        return parts
    }

    /// Writes each of `parts`, a byte offset and the bytes to put there, in order, as the
    /// function `write_parts` does, and with `sync` returns once the system says they're on the
    /// disk. A later part wins where two overlap; a part past the end makes the file longer.
    pub fn write_parts(self, parts: List<(u64, List<u8>)>, sync: bool) ! FsError {
        for (at, bytes) in parts {
            if unsafe { cx_fs_seek(self.handle, at) } == 0 or unsafe { cx_fs_write(self.handle, bytes.as_ptr(), bytes.len()) } == 0 {
                fail last_error()
            }
        }
        if sync {
            try self.sync()
        }
    }

    /// Returns once the system says everything written to it is on the disk, as Java's
    /// `FileChannel.force(true)`.
    pub fn sync(self) ! FsError {
        if unsafe { cx_fs_sync(self.handle) } == 0 {
            fail last_error()
        }
    }

    /// Closes it. What was written is the system's to put on the disk, as when any file is closed.
    pub fn close(own self) ! FsError {
        if unsafe { cx_fs_close(self.handle) } == 0 {
            fail last_error()
        }
    }
}

/// A lock on a file, which no other program, and no other `try_lock` in this one, can take while
/// it's held, Java's `FileLock`. It's held until `release`, or until the program ends. It's a
/// handle, so it can't be copied.
@handle
pub struct FileLock {
    handle: i64
}

impl FileLock {
    /// Lets the lock go and closes the file.
    pub fn release(own self) ! FsError {
        if unsafe { cx_fs_unlock(self.handle) } == 0 {
            fail last_error()
        }
    }
}

/// Locks the file at `path`, as a program marks a folder as in use: opens the file to write,
/// creating it if nothing is there and keeping what it holds, writes `bytes` at its start and
/// waits until they're on the disk, then takes an exclusive lock on the whole file without
/// waiting. That's what Java's `FileChannel` does as vanilla takes a world's `session.lock`, so
/// vanilla and a Calx program refuse each other's lock. `none` if another lock is held on the
/// file, by this program or another.
///
/// On Windows it's `LockFileEx`'s lock, which every program's reads and writes of the file
/// respect, so while another program holds one, even the write is refused, and that's `none`
/// too. On Linux it's an open file description lock, which only programs that lock the file
/// respect, and which conflicts with the `fcntl` locks Java and most programs take.
pub fn try_lock(path: String, bytes: List<u8>) -> FileLock? ! FsError {
    let h = unsafe { cx_fs_lock(path.as_ptr(), path.len(), bytes.as_ptr(), bytes.len()) }
    if h == -2 {
        return none
    }
    if h < 0 {
        fail last_error()
    }
    return some(FileLock { handle: h })
}

/// Moves what's at `from` to `to`, replacing a file there. On one volume it's atomic: anything
/// that opens `to` sees the old file or the new one, never part of either.
pub fn rename(from: String, to: String) ! FsError {
    if unsafe { cx_fs_rename(from.as_ptr(), from.len(), to.as_ptr(), to.len(), 0) } == 0 {
        fail last_error()
    }
}

/// Moves what's at `from` to `to` as `rename` does, and returns once the system says the move is on
/// the disk, so a power cut after it can't undo it. With `write_parts` and its `sync` first, it
/// replaces a file so that after a crash there's the old file or the new one, whole. If it fails
/// after the move, the move may not be on the disk yet.
pub fn rename_synced(from: String, to: String) ! FsError {
    if unsafe { cx_fs_rename(from.as_ptr(), from.len(), to.as_ptr(), to.len(), 1) } == 0 {
        fail last_error()
    }
}

/// Removes the file at `path`, or the link, not what it leads to.
pub fn remove_file(path: String) ! FsError {
    if unsafe { cx_fs_remove_file(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
}

/// Removes the directory at `path`, which must be empty.
pub fn remove_dir(path: String) ! FsError {
    if unsafe { cx_fs_remove_dir(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
}

/// Removes the directory at `path` and everything in it. A link inside is removed, never
/// followed, so nothing outside the directory is touched.
pub fn remove_dir_all(path: String) ! FsError {
    for name in try list(path) {
        let inner = "{path}/{name}"
        match try kind(inner) {
            some(Kind.Dir) => try remove_dir_all(inner),
            some(Kind.Link) => {
                // A link to a directory on Windows is removed as a directory.
                match remove_file(inner) {
                    ok => {},
                    err(FsError.IsDirectory) => try remove_dir(inner),
                    err(e) => {
                        fail e
                    },
                }
            },
            some(_) => try remove_file(inner),
            none => {},
        }
    }
    try remove_dir(path)
}

/// Makes a directory at `path`. Fails with `Exists` if something's there already.
pub fn make_dir(path: String) ! FsError {
    if unsafe { cx_fs_make_dir(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
}

/// Makes the directory at `path`, and each one on the way to it that's missing. It's fine if
/// it's there already.
pub fn make_dir_all(path: String) ! FsError {
    if is_dir(path) {
        return
    }
    // The parent first: the part before the last separator, if that isn't the root.
    var cut: usize? = none
    for i in 0..path.len() {
        let b = path.byte_at(i)
        if (b == 47 or b == 92) and i > 0 and i + 1 < path.len() {
            cut = some(i)
        }
    }
    if let c = cut {
        let parent = path[..c]
        if not parent.ends_with(":") {
            try make_dir_all(parent)
        }
    }
    match make_dir(path) {
        ok => {},
        err(FsError.Exists) => {
            if not is_dir(path) {
                fail FsError.Exists
            }
        },
        err(e) => {
            fail e
        },
    }
}

/// What's at `path`, without following a link, or `none` if nothing is.
pub fn kind(path: String) -> Kind? ! FsError {
    return match unsafe { cx_fs_kind(path.as_ptr(), path.len(), 0) } {
        0 => none,
        1 => some(Kind.File),
        2 => some(Kind.Dir),
        3 => some(Kind.Link),
        4 => some(Kind.Other),
        _ => {
            fail last_error()
        },
    }
}

/// Whether `path` is a file, following links, as Java's `Files.isRegularFile`. Any error is
/// `false`.
pub fn is_file(path: String) -> bool {
    return unsafe { cx_fs_kind(path.as_ptr(), path.len(), 1) } == 1
}

/// Whether `path` is a directory, following links, as Java's `Files.isDirectory`. Any error is
/// `false`.
pub fn is_dir(path: String) -> bool {
    return unsafe { cx_fs_kind(path.as_ptr(), path.len(), 1) } == 2
}

/// The size and modified time of what's at `path`, following links, as Java's `Files.size` and
/// `Files.getLastModifiedTime` read them.
pub fn metadata(path: String) -> Metadata ! FsError {
    if unsafe { cx_fs_stat(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
    return stat_result()
}

// What the last stat on this thread found.
fn stat_result() -> Metadata {
    let size = unsafe { cx_fs_stat_size() }
    let modified = unsafe { cx_fs_stat_modified() }
    let mode = unsafe { cx_fs_stat_mode() }
    let k = match unsafe { cx_fs_stat_kind() } {
        1 => Kind.File,
        2 => Kind.Dir,
        _ => Kind.Other,
    }
    return Metadata { size: u64.wrap(size), modified: Timestamp { unix_ms: modified }, mode: mode, kind: k }
}

/// Sets when what's at `path` was last modified, following links, as Java's
/// `File.setLastModified` does, without changing what it holds.
pub fn set_modified(path: String, at: Timestamp) ! FsError {
    if unsafe { cx_fs_set_modified(path.as_ptr(), path.len(), at.unix_ms) } == 0 {
        fail last_error()
    }
}

/// Sets the permission bits of what's at `path`, following links, as `chmod` does: `0o755` for
/// a program anyone may run, `0o644` for a file only its owner may change. On Windows only the
/// owner's write bit, `0o200`, counts: without it the file is read-only.
pub fn set_mode(path: String, mode: u32) ! FsError {
    if unsafe { cx_fs_set_mode(path.as_ptr(), path.len(), mode) } == 0 {
        fail last_error()
    }
}

/// The names in the directory at `path`, without `.` and `..`, sorted by their bytes, so a
/// program never depends on the order a system lists them in.
pub fn list(path: String) -> List<String> ! FsError {
    if unsafe { cx_fs_list(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
    let all = result()
    var names = List<String>()
    var start: usize = 0
    for i in 0..all.len() {
        if all.byte_at(i) == 0 {
            names.push(all[start..i])
            start = i + 1
        }
    }
    names.sort()
    return names
}

// The names in the directory at `path` with what each is, without following links, sorted as
// `list` sorts them. What each is comes with the listing, as Python's `os.scandir` gives it, so
// nothing more is asked of the system, except where a file system doesn't say: then it's looked
// at, and a name gone by then is left out.
fn list_typed(path: String) -> List<(String, Kind)> ! FsError {
    if unsafe { cx_fs_list_typed(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
    let all = result()
    var out = List<(String, Kind)>()
    let n = all.len()
    var at: usize = 0
    // Each entry is a byte for what it is, the name, and a zero byte.
    while at < n {
        let code = all.byte_at(at)
        var end = at + 1
        while all.byte_at(end) != 0 {
            end += 1
        }
        let name: String = all[at + 1..end]
        at = end + 1
        let k = match code {
            1 => some(Kind.File),
            2 => some(Kind.Dir),
            3 => some(Kind.Link),
            4 => some(Kind.Other),
            _ => try kind(join(path, name)),
        }
        if let found = k {
            out.push((name, found))
        }
    }
    out.sort()
    return out
}

/// The absolute path of what `path` names, with every link followed and each `.` and `..`
/// resolved, as Java's `Path.toRealPath` gives it: such as `/srv/world` or `C:\srv\world`.
/// What isn't there is `NotFound`.
pub fn real_path(path: String) -> String ! FsError {
    if unsafe { cx_fs_real_path(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
    return result()
}

/// What the link at `path` points to, without following it, or `none` if what's there isn't a
/// link: a symbolic link, or on Windows a junction. On Windows it's the name the system shows
/// for the link, without the `\??\` the system may put on its front, as Java gives it.
pub fn read_link(path: String) -> Link? ! FsError {
    return match unsafe { cx_fs_read_link(path.as_ptr(), path.len()) } {
        1 => none,
        2 => some(Link { target: result(), junction: false }),
        3 => some(Link { target: result(), junction: true }),
        _ => {
            fail last_error()
        },
    }
}

/// Makes a symbolic link at `path` to `target`, which is kept as it's given, relative to the
/// link's directory or absolute, and needn't be there. On Windows each `/` in it becomes `\`,
/// which the system needs in a link, and it's a link to a directory if `target` is one when it's
/// made, as Java's `Files.createSymbolicLink` makes it. Windows lets a program make one only
/// in developer mode or with the privilege to, and is `Denied` otherwise.
pub fn make_link(target: String, path: String) ! FsError {
    if unsafe { cx_fs_make_link(target.as_ptr(), target.len(), path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
}

/// What the system puts between a path's names, as Java's `File.separator`: `\` on Windows and
/// `/` elsewhere. `real_path` and `temp_dir` give paths with it. Either works in the paths
/// `std.fs` is given, on Windows too.
pub fn separator() -> String {
    var s = String()
    s.push(rune(unsafe { cx_fs_separator() }))
    return s
}

/// A new, empty directory of its own in the system's temporary folder, such as
/// `/tmp/calx-a1B2c3` or `C:\Users\me\AppData\Local\Temp\calx-1f2c-1-5b3e9a`. It's the
/// program's to remove, with `remove_dir_all`.
pub fn temp_dir() -> String ! FsError {
    if unsafe { cx_fs_temp_dir() } == 0 {
        fail last_error()
    }
    return result()
}

/// Whether anything is at `path`, following links, as Python's `os.path.exists`: `false` for a
/// link to nothing. Any error is `false`.
pub fn exists(path: String) -> bool {
    let k = unsafe { cx_fs_kind(path.as_ptr(), path.len(), 1) }
    return k >= 1 and k <= 4
}

/// Copies the file at `from` to `to`, replacing a file there, with its permission bits and
/// modified time, as Python's `shutil.copy2` keeps them. Windows copies it with its own
/// `CopyFileW`; on Linux the kernel copies the bytes, with `copy_file_range`, which on a file
/// system that can, such as Btrfs or XFS, shares them instead. A file copied onto itself is left
/// as it is. A directory at `from` is `IsDirectory`: `copy_dir_all` copies one.
pub fn copy(from: String, to: String) ! FsError {
    if unsafe { cx_fs_copy(from.as_ptr(), from.len(), to.as_ptr(), to.len()) } == 0 {
        fail last_error()
    }
}

/// Copies the directory at `from` and everything in it to `to`, as Python's `shutil.copytree`
/// does with `symlinks=True` and `dirs_exist_ok=True`: makes `to` and each directory inside as
/// needed, copies each file with `copy`, replacing one that's there, and makes each link again
/// as a link to the same target, never following it, so nothing outside `from` is copied.
/// Devices, sockets and pipes are passed over. Each directory is listed before anything is made
/// in it, so a `to` inside `from` isn't copied into itself.
pub fn copy_dir_all(from: String, to: String) ! FsError {
    let names = try list(from)
    try make_dir_all(to)
    for name in names {
        let a = join(from, name)
        let b = join(to, name)
        match try kind(a) {
            some(Kind.Dir) => try copy_dir_all(a, b),
            some(Kind.File) => try copy(a, b),
            some(Kind.Link) => {
                if let link = try read_link(a) {
                    try make_link(link.target, b)
                }
            },
            _ => {},
        }
    }
}

/// A path `walk` found, and what's there.
pub struct Entry {
    /// The directory walked and the names down to it, joined as `std.path.join` joins them.
    pub path: String
    /// What's there, without following a link.
    pub kind: Kind
}

/// Everything in the directory at `dir` and in each directory inside it, at any depth, as
/// Python's `os.walk` and Rust's `walkdir` find it: each path, and what's there. A directory
/// comes just before what's in it, and the names in each are in order of their bytes, as `list`
/// sorts them, so a walk finds the same order on every system. Hidden files are there too. A
/// link is listed and not followed, so a walk never leaves `dir`, nor goes round a loop.
pub fn walk(dir: String) -> List<Entry> ! FsError {
    var out = List<Entry>()
    try walk_into(dir, mut out)
    return out
}

fn walk_into(dir: String, out: mut List<Entry>) ! FsError {
    for e in try list_typed(dir) {
        let inner = join(dir, e.0)
        out.push(Entry { path: inner.copy(), kind: e.1 })
        if e.1 == Kind.Dir {
            try walk_into(inner, mut out)
        }
    }
}

/// The paths that match the glob `pattern`, by the rules of `std.path`'s `glob_matches`, sorted
/// by their bytes, as Python's `glob.glob` finds them with `recursive=True`: `logs/*.txt`,
/// `src/**/*.calx`, `[0-9]*.png`. Each is the pattern up to the name with its first wildcard,
/// as it's written, and then the names found, joined as `std.path.join` joins them.
///
/// - `*`, `?` and `[...]` pass over hidden names, and so does `**`, which goes into directories
///   but not through links to them, so it can't go round a loop.
/// - A pattern that ends with a separator, as `*/` does, finds only directories, and each path
///   it gives ends with that separator.
/// - A pattern with no wildcards gives itself, if something's there, even a link to nothing.
/// - A directory that's missing, or that the system doesn't let the program list, has nothing
///   in it to match, as in Python. Other errors fail.
pub fn glob(pattern: String) -> List<String> ! FsError {
    let win = separator() == "\\"
    let n = pattern.len()
    // Where the name with the first wildcard starts, and where the fixed part before it ends.
    var at = path_root(pattern).len()
    var fixed = at
    var wild: usize? = none
    while at < n {
        while at < n and is_sep(pattern.byte_at(at), win) {
            at += 1
        }
        var end = at
        while end < n and not is_sep(pattern.byte_at(end), win) {
            end += 1
        }
        if has_wildcard(pattern[at..end]) {
            wild = some(at)
            break
        }
        if end > at {
            fixed = end
        }
        at = end
    }
    var out = List<String>()
    let dirs_only = n > 0 and is_sep(pattern.byte_at(n - 1), win)
    if let w = wild {
        let names = path_parts(pattern[w..])
        let suffix = if dirs_only { pattern[n - 1..] } else { String() }
        let base: String = pattern[..fixed]
        // Each directory under it is known to be one from its listing.
        if is_dir(if base.is_empty() { String(".") } else { base.copy() }) {
            try glob_in(base, names, 0, suffix, mut out)
        }
    } else {
        if n == 0 {
            return out
        }
        let there = if dirs_only {
            is_dir(pattern)
        } else {
            match try kind(pattern) {
                some(_) => true,
                none => false,
            }
        }
        if there {
            out.push(pattern.copy())
        }
        return out
    }
    out.sort()
    // Two `**`s can find a path twice.
    var unique = List<String>()
    for i in 0..out.len() {
        if i == 0 or out[i] != out[i - 1] {
            unique.push(out[i].copy())
        }
    }
    return unique
}

// Whether the byte `b` separates names: `/`, or on Windows `\` too.
fn is_sep(b: u8, win: bool) -> bool {
    return b == 47 or (win and b == 92)
}

fn has_wildcard(name: String) -> bool {
    return name.contains("*") or name.contains("?") or name.contains("[")
}

// The names in the directory `at`, the current folder if it's empty, with what each is, or none
// if it's missing or the program may not list it.
fn glob_list(at: String) -> List<(String, Kind)> ! FsError {
    let here = if at.is_empty() { String(".") } else { at.copy() }
    return match list_typed(here) {
        ok(entries) => entries,
        err(FsError.NotFound) => List<(String, Kind)>(),
        err(FsError.Denied) => List<(String, Kind)>(),
        err(e) => {
            fail e
        },
    }
}

// Finds what's in `at` that the pattern's names from `i` match, onto `out`. `at` is there, and
// a directory if `i` isn't past the last name. `suffix` is the separator each directory found
// ends with if only directories are wanted, or empty.
fn glob_in(at: String, names: List<String>, i: usize, suffix: String, out: mut List<String>) ! FsError {
    if i == names.len() {
        if suffix.is_empty() {
            out.push(at.copy())
        } else if is_dir(at) {
            out.push("{at}{suffix}")
        }
        return
    }
    let name = names[i].copy()
    if name != "**" and not has_wildcard(name) {
        // A name without wildcards is looked for, not listed: it can be hidden.
        let inner = join(at, name)
        let there = if i + 1 == names.len() {
            match try kind(inner) {
                some(_) => true,
                none => false,
            }
        } else {
            is_dir(inner)
        }
        if there {
            try glob_in(inner, names, i + 1, suffix, mut out)
        }
        return
    }
    let entries = try glob_list(at)
    try glob_listed(at, entries, names, i, suffix, mut out)
}

// The same for a name `i` that's `**` or has a wildcard, with `entries` the listing of `at`, which
// what follows a `**` is matched in too, so each directory is listed once, and what each entry
// is comes with it: only a link is looked at, where `*` follows it.
fn glob_listed(at: String, entries: List<(String, Kind)>, names: List<String>, i: usize, suffix: String, out: mut List<String>) ! FsError {
    let name = names[i].copy()
    let last = i + 1 == names.len()
    if name == "**" {
        if not last {
            let next = names[i + 1].copy()
            if next == "**" or has_wildcard(next) {
                try glob_listed(at, entries, names, i + 1, suffix, mut out)
            } else {
                try glob_in(at, names, i + 1, suffix, mut out)
            }
        }
        for e in entries {
            if e.0.starts_with(".") {
                continue
            }
            let inner = join(at, e.0)
            let dir = e.1 == Kind.Dir
            if last {
                if suffix.is_empty() {
                    out.push(inner.copy())
                } else if dir {
                    out.push("{inner}{suffix}")
                }
            }
            if dir {
                try glob_in(inner, names, i, suffix, mut out)
            }
        }
        return
    }
    for e in entries {
        if glob_matches_name(e.0, name) {
            let inner = join(at, e.0)
            let deeper = last or match e.1 {
                Kind.Dir => true,
                Kind.Link => is_dir(inner),
                _ => false,
            }
            if deeper {
                try glob_in(inner, names, i + 1, suffix, mut out)
            }
        }
    }
}

/// The folder the program runs in, as the system gives it, such as `/home/me/project` or
/// `C:\Users\me\project`. Relative paths are on it.
pub fn current_dir() -> String ! FsError {
    if unsafe { cx_fs_current_dir() } == 0 {
        fail last_error()
    }
    return result()
}

/// Makes `path` the folder the program runs in, for the whole program: every relative path after
/// is on it, in every thread, and so is each program `std.process` starts without a folder of
/// its own.
pub fn set_current_dir(path: String) ! FsError {
    if unsafe { cx_fs_set_current_dir(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
}

/// `path` made absolute without looking at what's there, as Python's `os.path.abspath` makes it:
/// on the current folder if it's relative, and then with its `.` names and each `..` after a name
/// taken out, as `std.path.normalize` takes them out of the text. `real_path` follows links instead,
/// and needs the path to be there. An empty path is the current folder. On Windows it's what the
/// system makes of the path, with `\` between the names, and `C:x` is on drive C's current
/// folder.
pub fn absolute(path: String) -> String ! FsError {
    if unsafe { cx_fs_absolute(path.as_ptr(), path.len()) } == 0 {
        fail last_error()
    }
    return normalize(result())
}
