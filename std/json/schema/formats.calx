/// The checks of jsonschema 4.26's `FormatChecker()`: whether a string is an `email`, an `ipv4`
/// or `ipv6` address, a `date`, a `time` or a `uuid` as Python's `ipaddress`, `datetime` and
/// `uuid` read one, which jsonschema checks on its own, and the formats it checks with the
/// libraries of `pip install "jsonschema[format-nongpl]"`. std.json.schema's `with_formats()` and
/// `with_all_formats()` use them, and they're here for code that checks one string.
module std.json.schema.formats

import std.regex.{Regex}
import std.text.python.{is_space, repr_str}
import std.text.ucd.{DIGIT, DIGIT_LEN}

/// What Python raises from a check that doesn't only say yes or no, which leaves jsonschema too:
/// `ValueError` from `relative-json-pointer`, whose leading number is read with `int`, and
/// `Overflow` from `duration`, whose numbers are `Decimal`s.
pub struct FormatFault {
    /// The exception's class: `ValueError` or `Overflow`.
    pub kind: String
    /// What Python's `str` of it gives: `invalid literal for int() with base 10: '²'`.
    pub message: String
}

/// `{fault}` is its message.
impl Display for FormatFault {
    fn show(self) {
        print(self.message)
    }
}

/// jsonschema's `FormatChecker()`: `new()` checks what it checks with jsonschema installed alone,
/// and `with_libraries()` what it checks with `jsonschema[format-nongpl]`, all but `idn-hostname`
/// so far. It keeps the patterns it compiles.
pub struct FormatChecker {
    libraries: bool
    // `uri`, `uri-reference`, `iri` and `iri-reference`'s patterns, with the libraries.
    rx: List<Regex>
}

impl FormatChecker {
    /// `FormatChecker()` with jsonschema installed alone: `date`, `email`, `idn-email`, `ipv4`,
    /// `ipv6`, `regex`, `time` and `uuid`.
    pub fn new() -> FormatChecker {
        return FormatChecker { libraries: false, rx: List<Regex>() }
    }

    /// `FormatChecker()` with the libraries of `jsonschema[format-nongpl]` too: `color`,
    /// `date-time`, `duration`, `hostname`, `iri`, `iri-reference`, `json-pointer`,
    /// `relative-json-pointer`, `uri`, `uri-reference` and `uri-template`.
    pub fn with_libraries() -> FormatChecker {
        var rx = List<Regex>()
        rx.push(Regex.python(URI)!)
        rx.push(Regex.python(URI_REFERENCE)!)
        rx.push(Regex.python(iri_pattern(false))!)
        rx.push(Regex.python(iri_pattern(true))!)
        return FormatChecker { libraries: true, rx: rx }
    }

    /// Whether `s` is of the format `format`, as `checker.conforms(s, format)` says. A format the
    /// checker doesn't know always conforms; `regex` is compiled with `Regex.python`.
    pub fn conforms(mut self, s: String, format: String) -> bool ! FormatFault {
        if format == "regex" {
            return match Regex.python(s) {
                ok(_) => true,
                err(_) => false,
            }
        }
        if format == "email" or format == "idn-email" {
            return is_email(s)
        }
        if format == "ipv4" {
            return is_ipv4(s)
        }
        if format == "ipv6" {
            return is_ipv6(s)
        }
        if format == "date" {
            return is_date(s)
        }
        if format == "time" {
            return is_time(s)
        }
        if format == "uuid" {
            return is_uuid(s)
        }
        if not self.libraries {
            return true
        }
        if format == "date-time" {
            return is_date_time(s)
        }
        if format == "hostname" {
            return is_hostname(s)
        }
        if format == "color" {
            return is_color(s)
        }
        if format == "json-pointer" {
            return is_json_pointer(s)
        }
        if format == "relative-json-pointer" {
            return try is_relative_json_pointer(s)
        }
        if format == "duration" {
            return try is_duration(s)
        }
        if format == "uri-template" {
            return is_uri_template(s)
        }
        // rfc3986-validator's `re.match`, whose `$` also matches before a newline at the end, and
        // rfc3987-syntax's parse of the whole string.
        if format == "uri" {
            return self.rx[0].match_start(s) != none
        }
        if format == "uri-reference" {
            return self.rx[1].match_start(s) != none
        }
        if format == "iri" {
            return self.rx[2].full_match(s) != none
        }
        if format == "iri-reference" {
            return self.rx[3].full_match(s) != none
        }
        return true
    }
}

/// `email` and `idn-email`: whether `s` has an `@`, all jsonschema asks.
pub fn is_email(s: String) -> bool {
    return s.contains("@")
}

/// `ipv4`: whether `ipaddress.IPv4Address(s)` reads `s`: four decimal octets of ASCII digits, each
/// up to 255 and with no leading zero.
pub fn is_ipv4(s: String) -> bool {
    var octets: usize = 0
    var start: usize = 0
    var i: usize = 0
    while i <= s.len() {
        if i == s.len() or s.byte_at(i) == b'.' {
            if not octet(s, start, i) {
                return false
            }
            octets += 1
            start = i + 1
        }
        i += 1
    }
    return octets == 4
}

// Python's `_parse_octet` of the bytes from `a` up to `b`.
fn octet(s: String, a: usize, b: usize) -> bool {
    if a == b or b - a > 3 {
        return false
    }
    var v: u32 = 0
    for i in a..b {
        let c = s.byte_at(i)
        if c < b'0' or c > b'9' {
            return false
        }
        v = v * 10 + u32(c - b'0')
    }
    return v <= 255 and not (b - a > 1 and s.byte_at(a) == b'0')
}

/// `ipv6`: whether `ipaddress.IPv6Address(s)` reads `s` with no scope after a `%`: up to eight
/// groups of up to four hex digits, one `::` standing for groups of zeros, and an IPv4 address
/// allowed as the last 32 bits.
pub fn is_ipv6(s: String) -> bool {
    // A scope is an error or, after a good address, makes jsonschema say no; so does a `/`.
    if s.is_empty() or s.contains("%") or s.contains("/") {
        return false
    }
    var parts = s.split(":")
    // `split(':', maxsplit=9)` leaves the rest in a tenth part, which is never an address.
    if parts.len() < 3 or parts.len() > 10 {
        return false
    }
    if parts[parts.len() - 1].contains(".") {
        let last = parts.pop() ?? String()
        if not is_ipv4(last) {
            return false
        }
        parts.push(String("0"))
        parts.push(String("0"))
    }
    if parts.len() > 9 {
        return false
    }
    let n = parts.len()
    var skip: usize = 0
    var skips = false
    for i in 1..n - 1 {
        if parts[i].is_empty() {
            if skips {
                return false
            }
            skip = i
            skips = true
        }
    }
    var hi = n
    var lo: usize = 0
    if skips {
        hi = skip
        lo = n - skip - 1
        if parts[0].is_empty() {
            hi -= 1
            if hi != 0 {
                return false
            }
        }
        if parts[n - 1].is_empty() {
            lo -= 1
            if lo != 0 {
                return false
            }
        }
        if hi + lo >= 8 {
            return false
        }
    } else if n != 8 or parts[0].is_empty() or parts[n - 1].is_empty() {
        return false
    }
    for i in 0..hi {
        if not hextet(parts[i]) {
            return false
        }
    }
    for i in n - lo..n {
        if not hextet(parts[i]) {
            return false
        }
    }
    return true
}

// Python's `_parse_hextet`: one to four ASCII hex digits.
fn hextet(h: String) -> bool {
    if h.is_empty() or h.len() > 4 {
        return false
    }
    for i in 0..h.len() {
        if hex_digit(h.byte_at(i)) < 0 {
            return false
        }
    }
    return true
}

fn hex_digit(c: u8) -> i32 {
    if c >= b'0' and c <= b'9' {
        return i32(c - b'0')
    }
    if c >= b'a' and c <= b'f' {
        return i32(c - b'a') + 10
    }
    if c >= b'A' and c <= b'F' {
        return i32(c - b'A') + 10
    }
    return -1
}

/// `date`: whether `s` is `YYYY-MM-DD` in ASCII digits, a day `datetime.date` has, from year 1.
pub fn is_date(s: String) -> bool {
    if s.len() != 10 or s.byte_at(4) != b'-' or s.byte_at(7) != b'-' {
        return false
    }
    for i in [0usize, 1, 2, 3, 5, 6, 8, 9] {
        let c = s.byte_at(i)
        if c < b'0' or c > b'9' {
            return false
        }
    }
    let year = number(s, 0, 4)
    let month = number(s, 5, 7)
    let day = number(s, 8, 10)
    return year >= 1 and month >= 1 and month <= 12 and day >= 1 and day <= days_in(year, month)
}

fn number(s: String, a: usize, b: usize) -> u32 {
    var v: u32 = 0
    for i in a..b {
        v = v * 10 + u32(s.byte_at(i) - b'0')
    }
    return v
}

fn days_in(year: u32, month: u32) -> u32 {
    if month == 2 {
        return if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) { 29 } else { 28 }
    }
    return if month == 4 or month == 6 or month == 9 or month == 11 { 30 } else { 31 }
}

/// `time`: whether `datetime.strptime(s, "%H:%M:%S")` reads `s`, the check `FormatChecker()`
/// has for `time`. An hour, a minute and a second of one or two digits, which can be any
/// Unicode decimal digits, as Python's `\d` matches them, and a one-digit hour can have a space
/// before it. A second of 60 or 61 matches, then isn't one `datetime` has.
pub fn is_time(s: String) -> bool {
    var rs = List<u32>()
    for r in s.runes() {
        rs.push(u32(r))
    }
    // Python's regex tries each choice for the hour, the minute and the second in its order, and
    // takes the first that matches from the start; what's left after it is an error.
    for h in 0..4 {
        let m0 = hour(rs, h)
        if m0 < 0 or usize.wrap(m0) >= rs.len() or rs[usize.wrap(m0)] != 0x3A {
            continue
        }
        for m in 0..2 {
            let s0 = minute(rs, usize.wrap(m0) + 1, m)
            if s0 < 0 or usize.wrap(s0) >= rs.len() or rs[usize.wrap(s0)] != 0x3A {
                continue
            }
            let a = usize.wrap(s0) + 1
            for k in 0..3 {
                let end = second(rs, a, k)
                if end < 0 {
                    continue
                }
                // `6[0-1]` is a second `datetime` doesn't have.
                return usize.wrap(end) == rs.len() and k != 0
            }
        }
    }
    return false
}

// Where `%H`'s choice `k` ends, matched from the start, or -1:
// `2[0-3]`, `[0-1]\d`, `\d` and ` \d`.
fn hour(rs: List<u32>, k: i32) -> i64 {
    let n = rs.len()
    if k == 0 {
        return if n >= 2 and rs[0] == 0x32 and rs[1] >= 0x30 and rs[1] <= 0x33 { 2 } else { -1 }
    }
    if k == 1 {
        return if n >= 2 and (rs[0] == 0x30 or rs[0] == 0x31) and decimal(rs[1]) >= 0 { 2 } else { -1 }
    }
    if k == 2 {
        return if n >= 1 and decimal(rs[0]) >= 0 { 1 } else { -1 }
    }
    return if n >= 2 and rs[0] == 0x20 and decimal(rs[1]) >= 0 { 2 } else { -1 }
}

// Where `%M`'s choice `k` ends, from `a`, or -1: `[0-5]\d` and `\d`.
fn minute(rs: List<u32>, a: usize, k: i32) -> i64 {
    let n = rs.len()
    if k == 0 {
        return if a + 1 < n and rs[a] >= 0x30 and rs[a] <= 0x35 and decimal(rs[a + 1]) >= 0 { i64.wrap(a + 2) } else { -1 }
    }
    return if a < n and decimal(rs[a]) >= 0 { i64.wrap(a + 1) } else { -1 }
}

// Where `%S`'s choice `k` ends, from `a`, or -1: `6[0-1]`, `[0-5]\d` and `\d`.
fn second(rs: List<u32>, a: usize, k: i32) -> i64 {
    let n = rs.len()
    if k == 0 {
        return if a + 1 < n and rs[a] == 0x36 and (rs[a + 1] == 0x30 or rs[a + 1] == 0x31) { i64.wrap(a + 2) } else { -1 }
    }
    return minute(rs, a, k - 1)
}

// The value of a Unicode decimal digit, what Python's `\d` and `int` take, or -1. Each run of
// them starts at a 0 and holds whole runs of ten.
fn decimal(r: u32) -> i32 {
    if r < 0x80 {
        return if r >= 0x30 and r <= 0x39 { i32.wrap(r - 0x30) } else { -1 }
    }
    var lo: usize = 0
    var hi = DIGIT_LEN / 2
    while lo < hi {
        let mid = (lo + hi) / 2
        if r > DIGIT[2 * mid + 1] {
            lo = mid + 1
        } else if r < DIGIT[2 * mid] {
            hi = mid
        } else {
            return i32.wrap((r - DIGIT[2 * mid]) % 10)
        }
    }
    return -1
}

/// `uuid`: whether `uuid.UUID(s)` reads `s` and it has `-` at runes 8, 13, 18 and 23, as
/// jsonschema asks. `UUID` takes out `urn:`, `uuid:`, the `{` and `}` at the ends and every `-`,
/// then reads the 32 runes left with Python's `int(h, 16)`, which takes a sign, a `0x`,
/// underscores between digits, white space at the ends and any Unicode decimal digits.
pub fn is_uuid(s: String) -> bool {
    let h = strip_braces(s.replace("urn:", "").replace("uuid:", "")).replace("-", "")
    var rs = List<u32>()
    for r in h.runes() {
        rs.push(u32(r))
    }
    if rs.len() != 32 or not py_hex_int(rs) {
        return false
    }
    var at: usize = 0
    for r in s.runes() {
        if (at == 8 or at == 13 or at == 18 or at == 23) and u32(r) != 0x2D {
            return false
        }
        at += 1
        if at > 23 {
            break
        }
    }
    return true
}

// `s.strip('{}')`.
fn strip_braces(s: String) -> String {
    var a: usize = 0
    var b = s.len()
    while a < b and (s.byte_at(a) == b'{' or s.byte_at(a) == b'}') {
        a += 1
    }
    while b > a and (s.byte_at(b - 1) == b'{' or s.byte_at(b - 1) == b'}') {
        b -= 1
    }
    return s[a..b]
}

// Whether Python's `int(text, 16)` reads the runes `rs`. It first makes them ASCII: a rune below
// 127 stays, other white space becomes a space and another decimal digit its digit; anything else
// is an error. Then come white space, a sign, a `0x` and one `_` after it, hex digits with single
// `_`s between them, and white space, as CPython's `PyLong_FromString` reads them.
fn py_hex_int(rs: List<u32>) -> bool {
    var a = List<u8>()
    for r in rs {
        if r < 127 {
            a.push(u8.wrap(r))
        } else if is_space(r) {
            a.push(b' ')
        } else {
            let d = decimal(r)
            if d < 0 {
                return false
            }
            a.push(b'0' + u8.wrap(d))
        }
    }
    let n = a.len()
    var i: usize = 0
    while i < n and c_space(a[i]) {
        i += 1
    }
    if i < n and (a[i] == b'+' or a[i] == b'-') {
        i += 1
    }
    if i + 1 < n and a[i] == b'0' and (a[i + 1] == b'x' or a[i + 1] == b'X') {
        i += 2
        if i < n and a[i] == b'_' {
            i += 1
        }
    }
    if i < n and a[i] == b'_' {
        return false
    }
    var digits: usize = 0
    var prev: u8 = 0
    while i < n and (hex_digit(a[i]) >= 0 or a[i] == b'_') {
        if a[i] == b'_' {
            if prev == b'_' {
                return false
            }
        } else {
            digits += 1
        }
        prev = a[i]
        i += 1
    }
    if prev == b'_' or digits == 0 {
        return false
    }
    while i < n and c_space(a[i]) {
        i += 1
    }
    return i == n
}

// C's `isspace` in the C locale, CPython's `Py_ISSPACE`.
fn c_space(c: u8) -> bool {
    return c == b' ' or (c >= 9 and c <= 13)
}

// --- with the libraries --------------------------------------------------------------------------

/// `date-time`: whether rfc3339-validator's `validate_rfc3339(s.upper())` is true:
/// `YYYY-MM-DDTHH:MM:SS`, a fraction, and `Z` or an offset from UTC, in ASCII digits, with a day
/// the month has, from year 1. `t` and `z` count, and a newline can end it, which the pattern's
/// `$` lets through.
pub fn is_date_time(s: String) -> bool {
    var n = s.len()
    if n > 0 and s.byte_at(n - 1) == b'\n' {
        n -= 1
    }
    // No rune but an ASCII one uppers to what the pattern takes.
    if n < 20 or not all_digits(s, 0, 4) or s.byte_at(4) != b'-' or not all_digits(s, 5, 7) or s.byte_at(7) != b'-' or
       not all_digits(s, 8, 10) or (s.byte_at(10) != b'T' and s.byte_at(10) != b't') or not hour_at(s, 11) or
       s.byte_at(13) != b':' or not sixty(s, 14) or s.byte_at(16) != b':' or not sixty(s, 17) {
        return false
    }
    var i: usize = 19
    if s.byte_at(i) == b'.' {
        i += 1
        let start = i
        while i < n and s.byte_at(i) >= b'0' and s.byte_at(i) <= b'9' {
            i += 1
        }
        if i == start {
            return false
        }
    }
    if i >= n {
        return false
    }
    let z = s.byte_at(i)
    if z == b'Z' or z == b'z' {
        i += 1
    } else if z == b'+' or z == b'-' {
        if i + 6 > n or not hour_at(s, i + 1) or s.byte_at(i + 3) != b':' or not sixty(s, i + 4) {
            return false
        }
        i += 6
    } else {
        return false
    }
    let year = number(s, 0, 4)
    let month = number(s, 5, 7)
    let day = number(s, 8, 10)
    return i == n and year >= 1 and month >= 1 and month <= 12 and day >= 1 and day <= days_in(year, month)
}

fn all_digits(s: String, a: usize, b: usize) -> bool {
    for i in a..b {
        if s.byte_at(i) < b'0' or s.byte_at(i) > b'9' {
            return false
        }
    }
    return true
}

// `[01]\d|2[0123]` at byte `i`.
fn hour_at(s: String, i: usize) -> bool {
    return all_digits(s, i, i + 2) and number(s, i, i + 2) <= 23
}

// `[0-5]\d` at byte `i`.
fn sixty(s: String, i: usize) -> bool {
    return all_digits(s, i, i + 2) and s.byte_at(i) <= b'5'
}

/// `hostname`: whether fqdn's `FQDN(s, min_labels=1).is_valid` is true. `s.lower()` is labels of
/// 1 to 63 runes, each a letter, a Unicode decimal digit or a `-` that neither starts nor ends it,
/// joined by dots, with a dot allowed at the end, 253 runes at most without it. The pattern is
/// matched ignoring case, so `ı` and `ſ` count as letters, and its `$` lets a newline end it.
pub fn is_hostname(s: String) -> bool {
    if s.is_empty() {
        return false
    }
    var rs = List<u32>()
    for r in s.runes() {
        var c = u32(r)
        // `İ` lowers to `i` and a combining dot, which no label takes.
        if c == 0x130 {
            return false
        }
        if c >= 0x41 and c <= 0x5A {
            c += 32
        } else if c == 0x212A {
            c = 0x6B
        }
        rs.push(c)
    }
    var n = rs.len()
    if (if rs[n - 1] == 0x2E { n - 1 } else { n }) > 253 {
        return false
    }
    if rs[n - 1] == 0x0A {
        n -= 1
    }
    if n > 0 and rs[n - 1] == 0x2E {
        n -= 1
    }
    if n == 0 {
        return false
    }
    var a: usize = 0
    loop {
        var b = a
        while b < n and rs[b] != 0x2E {
            b += 1
        }
        if b == a or b - a > 63 or rs[a] == 0x2D or rs[b - 1] == 0x2D {
            return false
        }
        for k in a..b {
            let c = rs[k]
            if not (c == 0x2D or (c >= 0x61 and c <= 0x7A) or c == 0x131 or c == 0x17F or decimal(c) >= 0) {
                return false
            }
        }
        if b == n {
            return true
        }
        a = b + 1
    }
}

/// `color`, draft 3's: whether webcolors' `name_to_hex(s)` finds `s.lower()` among CSS3's 147
/// names, or `normalize_hex(s.lower())` reads it: `#` and 3 or 6 hex digits, which a newline can
/// end.
pub fn is_color(s: String) -> bool {
    var low = List<u8>()
    for r in s.runes() {
        let c = u32(r)
        // No other rune lowers to ASCII, which every name and hex value is.
        if c == 0x212A {
            low.push(b'k')
        } else if c >= 0x80 {
            return false
        } else if c >= 0x41 and c <= 0x5A {
            low.push(u8.wrap(c + 32))
        } else {
            low.push(u8.wrap(c))
        }
    }
    var n = low.len()
    if n > 0 and low[0] == b'#' {
        if low[n - 1] == b'\n' {
            n -= 1
        }
        if n != 4 and n != 7 {
            return false
        }
        for i in 1..n {
            if hex_digit(low[i]) < 0 {
                return false
            }
        }
        return true
    }
    // Every name is lowercase ASCII letters, so one is found between commas in `CSS3_NAMES`.
    for c in low {
        if c < b'a' or c > b'z' {
            return false
        }
    }
    let name = String.from_utf8(low) ?? String()
    return CSS3_NAMES.contains(",{name},")
}

// CSS3's color names, which webcolors 25.10 has.
const CSS3_NAMES: str = ",aliceblue,antiquewhite,aqua,aquamarine,azure,beige,bisque,black,blanchedalmond,blue,blueviolet,brown,burlywood,cadetblue,chartreuse,chocolate,coral,cornflowerblue,cornsilk,crimson,cyan,darkblue,darkcyan,darkgoldenrod,darkgray,darkgreen,darkgrey,darkkhaki,darkmagenta,darkolivegreen,darkorange,darkorchid,darkred,darksalmon,darkseagreen,darkslateblue,darkslategray,darkslategrey,darkturquoise,darkviolet,deeppink,deepskyblue,dimgray,dimgrey,dodgerblue,firebrick,floralwhite,forestgreen,fuchsia,gainsboro,ghostwhite,gold,goldenrod,gray,green,greenyellow,grey,honeydew,hotpink,indianred,indigo,ivory,khaki,lavender,lavenderblush,lawngreen,lemonchiffon,lightblue,lightcoral,lightcyan,lightgoldenrodyellow,lightgray,lightgreen,lightgrey,lightpink,lightsalmon,lightseagreen,lightskyblue,lightslategray,lightslategrey,lightsteelblue,lightyellow,lime,limegreen,linen,magenta,maroon,mediumaquamarine,mediumblue,mediumorchid,mediumpurple,mediumseagreen,mediumslateblue,mediumspringgreen,mediumturquoise,mediumvioletred,midnightblue,mintcream,mistyrose,moccasin,navajowhite,navy,oldlace,olive,olivedrab,orange,orangered,orchid,palegoldenrod,palegreen,paleturquoise,palevioletred,papayawhip,peachpuff,peru,pink,plum,powderblue,purple,red,rosybrown,royalblue,saddlebrown,salmon,sandybrown,seagreen,seashell,sienna,silver,skyblue,slateblue,slategray,slategrey,snow,springgreen,steelblue,tan,teal,thistle,tomato,turquoise,violet,wheat,white,whitesmoke,yellow,yellowgreen,"

/// `json-pointer`: whether jsonpointer's `JsonPointer(s)` reads `s`: empty or starting with `/`,
/// and every `~` followed by `0` or `1`.
pub fn is_json_pointer(s: String) -> bool {
    for i in 0..s.len() {
        if s.byte_at(i) == b'~' and (i + 1 == s.len() or (s.byte_at(i + 1) != b'0' and s.byte_at(i + 1) != b'1')) {
            return false
        }
    }
    return s.is_empty() or s.byte_at(0) == b'/'
}

/// `relative-json-pointer`, as jsonschema checks it: a number with no leading zero, then `#` or
/// a JSON pointer. The number is the runes `str.isdigit` takes, which `²` and `①` are too, and
/// jsonschema reads a digit with `int` when another follows it, so `²1` raises `ValueError`.
pub fn is_relative_json_pointer(s: String) -> bool ! FormatFault {
    if s.is_empty() {
        return false
    }
    var count: usize = 0
    var at: usize = 0
    var prev = 'a'
    var rest: i64 = -1
    for r in s.runes() {
        let c = u32(r)
        if decimal(c) >= 0 or other_digit(c) {
            if count > 0 {
                let d = decimal(u32(prev))
                if d < 0 {
                    var one = String()
                    one.push(prev)
                    fail FormatFault { kind: String("ValueError"), message: "invalid literal for int() with base 10: {repr_str(one)}" }
                }
                if d == 0 {
                    return false
                }
            }
            count += 1
            prev = r
            at += utf8_len(c)
            continue
        }
        if count == 0 {
            return false
        }
        rest = i64.wrap(at)
        break
    }
    if rest < 0 {
        return true
    }
    let tail = s[usize.wrap(rest)..]
    return tail == "#" or is_json_pointer(tail)
}

fn utf8_len(c: u32) -> usize {
    return if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 }
}

// The runes Python's `str.isdigit` takes that aren't decimal digits, such as `²` and `①`, as ranges.
const OTHER_DIGIT: [u32; 40] = [
    0xB2, 0xB3, 0xB9, 0xB9, 0x1369, 0x1371, 0x19DA, 0x19DA, 0x2070, 0x2070, 0x2074, 0x2079, 0x2080, 0x2089,
    0x2460, 0x2468, 0x2474, 0x247C, 0x2488, 0x2490, 0x24EA, 0x24EA, 0x24F5, 0x24FD, 0x24FF, 0x24FF,
    0x2776, 0x277E, 0x2780, 0x2788, 0x278A, 0x2792, 0x10A40, 0x10A43, 0x10E60, 0x10E68, 0x11052, 0x1105A,
    0x1F100, 0x1F10A,
]

fn other_digit(c: u32) -> bool {
    var i: usize = 0
    while i < 40 {
        if c >= OTHER_DIGIT[i] and c <= OTHER_DIGIT[i + 1] {
            return true
        }
        i += 2
    }
    return false
}

/// `duration`: whether isoduration's `parse_duration(s)` reads `s` and it ends in one of
/// `DMYWHMS`, as jsonschema asks. A sign, `P`, numbers each followed by a designator, in the order
/// `Y`, `M`, `D` and `W`, then after `T`, `H`, `M` and `S`; `W` only with no other date
/// designator but zeros. A number is a `Decimal`, with a `,` read as `.`, and one too large for
/// Python's default context raises `Overflow`.
pub fn is_duration(s: String) -> bool ! FormatFault {
    var rs = List<u32>()
    for r in s.runes() {
        rs.push(u32(r))
    }
    let n = rs.len()
    if n < 2 {
        return false
    }
    let from: usize = if rs[0] == 0x2B or rs[0] == 0x2D { 2 } else { 1 }
    if rs[from - 1] != 0x50 {
        return false
    }
    var next: usize = 0
    var tmp = List<u8>()
    var plain = true
    var other = false
    for idx in from..n {
        let ch = rs[idx]
        if ch == 0x54 {
            // A number then `T` with nothing else before is read by arrow as a date and time, which
            // never ends in a designator.
            if not tmp.is_empty() and plain {
                return false
            }
            if idx + 1 == n or not try time_part(rs, idx + 1) {
                return false
            }
            return duration_end(rs[n - 1])
        }
        if is_alpha(ch) {
            var k = next
            while k < 4 and ch != DATE_DESIGNATORS[k] {
                k += 1
            }
            if k == 4 {
                return false
            }
            next = k + 1
            let v = try decimal_value(tmp)
            if v < 0 {
                return false
            }
            if ch == 0x57 and other {
                return false
            }
            other = other or v == 1
            tmp.clear()
            plain = false
            continue
        }
        if not number_char(ch) {
            return false
        }
        if ch == 0x2C {
            tmp.push(b'.')
            plain = false
        } else {
            tmp.push(u8.wrap(ch))
        }
    }
    return duration_end(rs[n - 1])
}

const DATE_DESIGNATORS: [u32; 4] = [0x59, 0x4D, 0x44, 0x57]
const TIME_DESIGNATORS: [u32; 3] = [0x48, 0x4D, 0x53]

fn time_part(rs: List<u32>, from: usize) -> bool ! FormatFault {
    var next: usize = 0
    var tmp = List<u8>()
    for idx in from..rs.len() {
        let ch = rs[idx]
        if is_alpha(ch) {
            var k = next
            while k < 3 and ch != TIME_DESIGNATORS[k] {
                k += 1
            }
            if k == 3 {
                return false
            }
            next = k + 1
            if try decimal_value(tmp) < 0 {
                return false
            }
            tmp.clear()
            continue
        }
        if not number_char(ch) {
            return false
        }
        tmp.push(if ch == 0x2C { b'.' } else { u8.wrap(ch) })
    }
    return true
}

// isoduration's `is_letter`, for ASCII: a letter but `e`. Any other rune isn't a designator or a
// number, so it ends the parse either way.
fn is_alpha(c: u32) -> bool {
    return ((c >= 0x41 and c <= 0x5A) or (c >= 0x61 and c <= 0x7A)) and c != 0x45 and c != 0x65
}

// `[+\-0-9.,eE]`.
fn number_char(c: u32) -> bool {
    return (c >= 0x30 and c <= 0x39) or c == 0x2B or c == 0x2D or c == 0x2E or c == 0x2C or c == 0x45 or c == 0x65
}

fn duration_end(c: u32) -> bool {
    return c == 0x44 or c == 0x4D or c == 0x59 or c == 0x57 or c == 0x48 or c == 0x53
}

// `sign * Decimal(t)`: -1 when `Decimal` can't read `t`, 0 for a zero, 1 for another number, and
// `Overflow` when the product is past the default context's largest exponent, 999999, after
// rounding to 28 digits. `Decimal` reads exponents as libmpdec's widest context takes them: a
// number's adjusted exponent up to 999999999999999999, and its exponent down to
// -1999999999999999997.
fn decimal_value(t: List<u8>) -> i32 ! FormatFault {
    let n = t.len()
    var i: usize = 0
    if i < n and (t[i] == b'+' or t[i] == b'-') {
        i += 1
    }
    var coeff = List<u8>()
    var whole: usize = 0
    while i < n and t[i] >= b'0' and t[i] <= b'9' {
        coeff.push(t[i])
        whole += 1
        i += 1
    }
    var frac: usize = 0
    if i < n and t[i] == b'.' {
        i += 1
        while i < n and t[i] >= b'0' and t[i] <= b'9' {
            coeff.push(t[i])
            frac += 1
            i += 1
        }
    }
    if whole + frac == 0 {
        return -1
    }
    var e: i64 = 0
    var wide = false
    if i < n and (t[i] == b'e' or t[i] == b'E') {
        i += 1
        var neg = false
        if i < n and (t[i] == b'+' or t[i] == b'-') {
            neg = t[i] == b'-'
            i += 1
        }
        let start = i
        while i < n and t[i] >= b'0' and t[i] <= b'9' {
            let d = i64(t[i] - b'0')
            if e > (9223372036854775807 - d) / 10 {
                wide = true
            } else {
                e = e * 10 + d
            }
            i += 1
        }
        if i == start {
            return -1
        }
        if neg {
            e = -e
        }
    }
    // Past these, the exponent is out of range whatever the digits, and the sums below can't overflow.
    if i != n or wide or e > 4000000000000000000 or e < -4000000000000000000 {
        return -1
    }
    var z: usize = 0
    while z < coeff.len() and coeff[z] == b'0' {
        z += 1
    }
    let count = coeff.len() - z
    let exp = e - i64.wrap(frac)
    if count == 0 {
        return if exp >= -1999999999999999997 and exp <= 999999999999999999 { 0 } else { -1 }
    }
    var adjusted = exp + i64.wrap(count) - 1
    if adjusted > 999999999999999999 or exp < -1999999999999999997 {
        return -1
    }
    // Rounding to 28 digits carries into a 29th when the first 28 are nines and the rest is at
    // least half: an exact half rounds to even, away from the odd 9.
    if count > 28 {
        var nines = true
        for k in z..z + 28 {
            if coeff[k] != b'9' {
                nines = false
            }
        }
        if nines and coeff[z + 28] >= b'5' {
            adjusted += 1
        }
    }
    if adjusted > 999999 {
        fail FormatFault { kind: String("Overflow"), message: String("[<class 'decimal.Overflow'>]") }
    }
    return 1
}

/// `uri-template`: whether uri_template's `URITemplate(s)` reads `s`: literal text with no `{` or
/// `}`, and expressions in braces, each an operator and variables, as RFC 6570 has them, with
/// the library's own rules: a default after `=`, a prefix length of 1 to 999 after `:`, `*` and
/// `[]` for explode, and `/` in a name.
pub fn is_uri_template(s: String) -> bool {
    // `re.split(r'(\{[^\}]*\})', s)`: an expression runs from a `{` to the next `}`.
    var i: usize = 0
    let n = s.len()
    while i < n {
        let rest = s[i..]
        let open = rest.find("\{")
        let close = if let o = open { rest[o..].find("\}") } else { none }
        if close == none {
            return not rest.contains("\{") and not rest.contains("\}")
        }
        let o = i + (open ?? 0)
        let c = o + (close ?? 0)
        if s[i..o].contains("\}") or not expression(s[o + 1..c]) {
            return false
        }
        i = c + 1
    }
    return true
}

// What's between the braces: a simple expansion when it starts with a name's character or a
// `%XX` and has no newline but one at its end, which `re.match('^(...).*$')` asks; otherwise an
// operator, then the variables.
fn expression(e: String) -> bool {
    let n = e.len()
    let first = if n == 0 { b'\}' } else { e.byte_at(0) }
    let named = (first >= b'a' and first <= b'z') or (first >= b'A' and first <= b'Z') or (first >= b'0' and first <= b'9') or
                first == b'_' or (first == b'%' and n >= 3 and hex_digit(e.byte_at(1)) >= 0 and hex_digit(e.byte_at(2)) >= 0)
    if named {
        let skip: usize = if first == b'%' { 3 } else { 1 }
        let newline = e[skip..].find("\n")
        if newline == none or (newline ?? 0) + skip == n - 1 {
            return variables(e)
        }
    }
    if first == b'+' or first == b'#' or first == b'.' or first == b'/' or first == b';' or first == b'?' or first == b'&' {
        return variables(e[1..])
    }
    if first == b',' {
        return if n >= 2 and e.byte_at(1) == b'+' { variables(e[2..]) } else { variables(e[1..]) }
    }
    return false
}

fn variables(v: String) -> bool {
    var list = v.copy()
    if not v.is_empty() {
        let last = v.byte_at(v.len() - 1)
        if last == b',' or last == b'.' or last == b'/' or last == b';' or last == b'&' {
            list = v[..v.len() - 1]
        }
    }
    for spec in list.split(",") {
        if not variable(spec) {
            return false
        }
    }
    return true
}

// uri_template's `Variable(spec)`. An empty one gets past the check of its first character, then
// raises `IndexError`.
fn variable(spec: String) -> bool {
    if not spec.is_empty() and not var_start(spec.byte_at(0)) {
        return false
    }
    var name = spec.copy()
    if let (before, _) = spec.split_once("=") {
        name = before.copy()
    }
    if let (before, length) = name.split_once(":") {
        if length.is_empty() or length.len() > 3 or not all_digits(length, 0, length.len()) or number(length, 0, length.len()) == 0 {
            return false
        }
        name = before.copy()
    } else if name.is_empty() {
        return false
    } else if name.byte_at(name.len() - 1) == b'*' {
        name = name[..name.len() - 1]
    } else if name.ends_with("[]") {
        name = name[..name.len() - 2]
    }
    var k: usize = 0
    while k < name.len() {
        let c = name.byte_at(k)
        if c == b'%' and k + 2 < name.len() and hex_digit(name.byte_at(k + 1)) >= 0 and hex_digit(name.byte_at(k + 2)) >= 0 {
            k += 2
        } else if not var_start(c) and c != b'.' and c != b'/' {
            return false
        }
        k += 1
    }
    return true
}

fn var_start(c: u8) -> bool {
    return (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'_'
}

// rfc3987-syntax's `iri` and `iri_reference` grammar as a pattern, matched against the whole
// string as its parser reads it. Its IPv6 addresses have exactly the groups each form names, so
// `::1` isn't one, and only the Basic Multilingual Plane's runes are `ucschar`s.
fn iri_pattern(reference: bool) -> String {
    var p = String(#"(?:SCHEME:IHIER(?:\?IQUERY)?(?:\#IFRAG)?REL)"#)
    p = p.replace("REL", if reference { #"|(?:IRELPART(?:\?IQUERY)?(?:\#IFRAG)?)"# } else { "" })
    p = p.replace("IHIER", #"(?://IAUTH(?:/ISEG)*|/(?:ISEGNZ(?:/ISEG)*)?|ISEGNZ(?:/ISEG)*|)"#)
    p = p.replace("IRELPART", #"(?://IAUTH(?:/ISEG)*|/(?:ISEGNZ(?:/ISEG)*)?|ISEGNC(?:/ISEG)*|)"#)
    p = p.replace("IAUTH", #"(?:IUSER@)?IHOST(?::[0-9]*)?"#)
    p = p.replace("IUSER", #"(?:[IUNRESSUB:]|PCT)*"#)
    p = p.replace("IHOST", #"(?:\[(?:IPV6|v[0-9A-Fa-f]+\.[A-Za-z0-9\-._~SUB:]+)\]|IPV4|(?:[IUNRESSUB]|PCT)*)"#)
    p = p.replace("ISEGNZ", #"IPCHAR+"#)
    p = p.replace("ISEGNC", #"(?:[IUNRESSUB@]|PCT)+"#)
    p = p.replace("ISEG", #"IPCHAR*"#)
    p = p.replace("IQUERY", #"(?:IPCHAR|[-/?])*"#)
    p = p.replace("IFRAG", #"(?:IPCHAR|[/?])*"#)
    p = p.replace("IPCHAR", #"(?:[IUNRESSUB:@]|PCT)"#)
    p = p.replace("SCHEME", #"[A-Za-z][A-Za-z0-9+\-.]*"#)
    p = p.replace("IPV6", #"(?:H:H:H:H:H:H:LS32|::H:H:H:H:H:LS32|H::H:H:H:H:LS32|H:H::H:H:H:LS32|H:H:H::H:H:LS32|H:H:H:H::H:LS32|H:H:H:H:H::LS32|H:H:H:H:H:H::H|H:H:H:H:H:H:H::)"#)
    p = p.replace("LS32", #"(?:H:H|IPV4)"#)
    p = p.replace("IPV4", #"OCT\.OCT\.OCT\.OCT"#)
    p = p.replace("OCT", #"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])"#)
    p = p.replace("H", #"[0-9A-Fa-f]{1,4}"#)
    p = p.replace("PCT", #"%[0-9A-Fa-f]{2}"#)
    p = p.replace("IUNRES", #"A-Za-z0-9\-._~ -퟿豈-﷏ﷰ-￯"#)
    p = p.replace("SUB", #"!$&'()*+,;="#)
    return p
}

