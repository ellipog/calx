/// Python's `re`, as CPython 3.14 reads and matches it, for std.regex's `Regex.python`. A pattern is
/// parsed as re/_parser.py parses it, with its errors, compiled to sre's opcodes as
/// re/_compiler.py compiles it, and matched by a backtracking machine that takes the steps
/// Modules/_sre/sre_lib.h takes, so the match found and what each group holds are Python's.
module std.regex.sre

import std.text.python.{repr_str}
import std.unicode.names.{lookup_rune}
import std.text.ucd.{ALNUM, ALNUM_LEN, DIGIT, DIGIT_LEN, PY_LOWER_FROM, PY_LOWER_FROM_LEN, PY_LOWER_TO, PY_SPACE, PY_SPACE_LEN, PY_UPPER_FROM, PY_UPPER_FROM_LEN, PY_UPPER_TO}

// This follows CPython's re: Lib/re/_parser.py, Lib/re/_compiler.py and Lib/re/_casefix.py, and
// Modules/_sre/sre_lib.h, under this notice:
