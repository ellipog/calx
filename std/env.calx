/// The program's command line and its environment.
module std.env

extern "C" {
    fn cx_arg_count() -> usize
    fn cx_arg(i: usize) -> *const u8
    fn cx_arg_len(i: usize) -> usize
    fn cx_env_get(name: *const u8, n: usize, out: *u8, cap: usize) -> i64
    fn cx_env_os() -> u32
    fn cx_env_arch() -> u32
    fn cx_env_native_arch() -> u32
    fn cx_env_elevated() -> u32
    fn cx_env_user_id() -> i64
    fn cx_env_user_name(out: *u8, cap: usize) -> i64
    fn cx_script() -> *const u8
    fn cx_script_len() -> usize
    fn memcpy(to: *u8, from: *const u8, n: usize) -> *u8
}

/// The system the program runs on, `"windows"`, `"linux"` or `"macos"`, as Rust's
/// `std::env::consts::OS` names them: for the few things a script does differently on each, such
/// as which program to start. A program is built for one system, so it's the same on every call.
pub fn os() -> String {
    let code = unsafe { cx_env_os() }
    return if code == 1 { "windows" } else if code == 3 { "macos" } else { "linux" }
}

/// The processor the program was built for, `"x86_64"` or `"aarch64"`, as Rust's
/// `std::env::consts::ARCH` names them. An x64 program that Windows or macOS runs on an Arm
/// processor, translating it as it goes, says `"x86_64"`.
pub fn arch() -> String {
    return if unsafe { cx_env_arch() } == 2 { "aarch64" } else { "x86_64" }
}

/// The processor the system has, `"x86_64"` or `"aarch64"`: `arch()`, but for an x64 program
/// that Windows or macOS translates on an Arm processor, which gets `"aarch64"`. For choosing
/// which build of a program to download, as `calx update` does.
pub fn native_arch() -> String {
    return if unsafe { cx_env_native_arch() } == 2 { "aarch64" } else { "x86_64" }
}

/// The arguments the program was started with, after its own name, in order.
///
/// Each is valid UTF-8. Windows passes the command line as UTF-16, which converts exactly, apart
/// from an unpaired surrogate, which becomes U+FFFD. Linux passes bytes, and each one that doesn't
/// start a valid UTF-8 sequence becomes U+FFFD.
pub fn args() -> List<String> {
    var out = List<String>()
    let n = unsafe { cx_arg_count() }
    for i in 1..n {
        out.push(arg(i))
    }
    return out
}

/// The program's name, for its help and its messages: the last part of the path it was started
/// as, without `.exe` or `.calx`. `calx run tools/count.calx` starts it as `tools/count.calx`,
/// the file it was built from, as Python starts a script, so it's `count`, and so is a program
/// built as `count.exe` or started by a `#!` line as `./count`.
pub fn program() -> String {
    if unsafe { cx_arg_count() } == 0 {
        return String()
    }
    let path = arg(0)
    var start: usize = 0
    for i in 0usize..path.len() {
        let b = path.byte_at(i)
        if b == b'/' or b == b'\\' {
            start = i + 1
        }
    }
    let name: String = path[start..]
    for ext in [".exe", ".calx"] {
        if name.ends_with(ext) and name.len() > ext.len() {
            return name[..name.len() - ext.len()]
        }
    }
    return name
}

/// The `.calx` file `calx run` built this program from, as a full path, as Python's `__file__` is
/// for the script it runs: for finding what goes with a script, beside it, from wherever it's run.
/// `none` for a program started another way, such as one `calx build` made, whose own path is
/// `std.process.current_exe()`.
pub fn script() -> String? {
    let n = unsafe { cx_script_len() }
    if n == 0 {
        return none
    }
    var bytes = List<u8>()
    unsafe {
        bytes.reserve(n)
        _ = memcpy(bytes.as_mut_ptr(), cx_script(), n)
        bytes.set_len(n)
    }
    return some(String.from_utf8(bytes)!)
}

// Argument `i`, the program's name at 0, as valid UTF-8.
fn arg(i: usize) -> String {
    var bytes = List<u8>()
    unsafe {
        let len = cx_arg_len(i)
        if len > 0 {
            bytes.reserve(len)
            _ = memcpy(bytes.as_mut_ptr(), cx_arg(i), len)
            bytes.set_len(len)
        }
    }
    return String.from_utf8(bytes)!
}

/// The value of the environment variable `name`, or `none` if it isn't set, or `name` can't be
/// one: empty, or with `=` or a zero byte in it. On Windows the name is matched without regard to
/// case, as Windows matches it.
///
/// The value is valid UTF-8, converted as `args` converts the arguments: on Windows from UTF-16,
/// an unpaired surrogate becoming U+FFFD, and on Linux each byte that doesn't start a valid
/// sequence becoming U+FFFD. Each call reads the environment as it is then.
pub fn variable(name: String) -> String? {
    var cap: usize = 256
    loop {
        var out = List<u8>()
        out.reserve(cap)
        let n = unsafe { cx_env_get(name.as_ptr(), name.len(), out.as_mut_ptr(), cap) }
        if n < 0 {
            return none
        }
        let len = usize.wrap(n)
        if len <= cap {
            unsafe {
                out.set_len(len)
            }
            return String.from_utf8(out)
        }
        cap = len
    }
}

/// Whether the program runs with the system's full rights, which every program it starts gets
/// too: as root, an effective user id of 0, on Linux and macOS, as Python's `os.geteuid() == 0`
/// says; on Windows with an elevated token, as an Administrator's is once UAC has asked, or always
/// where UAC is off, and as SYSTEM's is, which is what Python's
/// `ctypes.windll.shell32.IsUserAnAdmin()` says. For a server that refuses to run that way unless
/// it's told to.
pub fn is_elevated() -> bool {
    return unsafe { cx_env_elevated() } != 0
}

/// The name of the user the program runs as, as Python's `getpass.getuser()` gives it where no
/// environment variable says otherwise: on Windows the account's name, without its domain, and on
/// Linux and macOS the effective user id's name in the user database, `root` under `sudo`. `none`
/// for a user id the database has no entry for, as a container can be started with.
pub fn user_name() -> String? {
    var cap: usize = 64
    loop {
        var out = List<u8>()
        out.reserve(cap)
        let n = unsafe { cx_env_user_name(out.as_mut_ptr(), cap) }
        if n < 0 {
            return none
        }
        let len = usize.wrap(n)
        if len <= cap {
            unsafe {
                out.set_len(len)
            }
            return String.from_utf8(out)
        }
        cap = len
    }
}

/// The effective user id the program runs as on Linux and macOS, as Python's `os.geteuid()`
/// gives it, 0 for root. `none` on Windows, which names users by SID instead.
pub fn user_id() -> u32? {
    let id = unsafe { cx_env_user_id() }
    if id < 0 {
        return none
    }
    return some(u32.wrap(id))
}
