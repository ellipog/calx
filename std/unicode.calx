/// Unicode text normalized, as Python's `unicodedata.normalize` and `unicodedata.is_normalized`
/// do it, with Unicode 16's tables, which are Python 3.14's: NFC and NFD, which keep what text
/// means and only change how it's written, and NFKC and NFKD, which also write compatibility
/// characters, such as `ﬁ` and `²`, as their plain forms.
module std.unicode

import std.text.normal.{BLOCK, CANON_AT, CANON_LEN, CCC, COMPAT_AT, COMPAT_LEN, EASY, PAIR_FIRST, PAIR_RESULT, PAIR_SECOND, POOL, QC, STAGE1, STAGE2}

extern "C" {
    fn cx_bytes_below(p: *const u8, n: usize, limit: u8) -> usize
    fn cx_bytes_skip_starters(hay: *const u8, len: usize, from: usize, low: u8, kinds: u8) -> usize
}

/// A normalization form, as UAX #15 defines it.
pub enum Form {
    /// Canonical decomposition, then canonical composition: `é` as one rune, U+00E9. What most
    /// text is in, and what to compare and store text in.
    NFC,
    /// Canonical decomposition: `é` as `e` and U+0301, the combining acute accent.
    NFD,
    /// Compatibility decomposition, then canonical composition: also `ﬁ` as `fi` and `²` as `2`.
    /// For matching text as people read it, such as names and identifiers.
    NFKC,
    /// Compatibility decomposition.
    NFKD,
}

// Hangul syllables, as the Unicode Standard's section 3.12 makes them from jamo.
const S_BASE: u32 = 0xAC00
const L_BASE: u32 = 0x1100
const V_BASE: u32 = 0x1161
const T_BASE: u32 = 0x11A7
const L_COUNT: u32 = 19
const V_COUNT: u32 = 21
const T_COUNT: u32 = 28
const N_COUNT: u32 = 588
const S_COUNT: u32 = 11172

/// `text` in `form`, as Python's `unicodedata.normalize` gives it. Text that's already in it comes
/// back as it is, which the quick checks of UAX #15 tell for most of it without normalizing.
pub fn normalize(text: String, form: Form) -> String {
    let checked = quick(text, form, false)
    if checked.0 == Check.Yes {
        return text.copy()
    }
    var out = String()
    out.reserve(text.len() + text.len() / 8 + 8)
    out.push_str(text[..checked.1])
    normalize_from(text, checked.1, form, mut out)
    return out
}

/// Whether `text` is in `form`, as Python's `unicodedata.is_normalized` says: by the quick checks
/// where they can tell, and otherwise by normalizing it.
pub fn is_normalized(text: String, form: Form) -> bool {
    return match quick(text, form, true).0 {
        Check.Yes => true,
        Check.No => false,
        Check.Maybe => normalize(text, form) == text,
    }
}

/// The canonical combining class of `r`, as Python's `unicodedata.combining` gives it: 0 for a
/// starter, such as a letter, and otherwise the class that orders combining marks, such as 230
/// for the accents above a letter and 220 for those below.
pub fn combining(r: rune) -> u8 {
    return CCC[record(u32(r))]
}

// --- the tables --------------------------------------------------------------------------------

// The record of rune `c` in std.text.normal's tables.
fn record(c: u32) -> usize {
    let at = usize(c)
    let block = usize(STAGE1[at / BLOCK])
    return usize(STAGE2[block * BLOCK + at % BLOCK])
}

// The quick-check bit that says a rune can't be in `form`.
fn no_bit(form: Form) -> u8 {
    return match form {
        Form.NFD => 1,
        Form.NFKD => 2,
        Form.NFC => 4,
        Form.NFKC => 16,
    }
}

// The bit EASY sets for a block in which every rune is a starter certainly in `form`.
fn easy_bit(form: Form) -> u8 {
    return match form {
        Form.NFD => 1,
        Form.NFKD => 2,
        Form.NFC => 4,
        Form.NFKC => 8,
    }
}

// The bytes from `i` on that are below `limit`, counted 16 at a time.
fn below(text: String, i: usize, limit: u8) -> usize {
    return unsafe { cx_bytes_below(text.as_ptr().add(i), text.len() - i, limit) }
}

// Whether byte `b` can start a run cx_bytes_skip_starters skips: one below `low`, or the lead of a
// three-byte rune from U+1000 to U+DFFF, among which are the blocks it knows.
fn run_start(b: u8, low: u8) -> bool {
    return b < low or (b >= 0xE1 and b <= 0xED)
}

// The bit that says it might not be, in a composing form.
fn maybe_bit(form: Form) -> u8 {
    return match form {
        Form.NFC => 8,
        Form.NFKC => 32,
        _ => 0,
    }
}

// The rune at byte `i` of `t`, and its length. A `String` is always UTF-8, so the bytes a lead
// byte says follow are there, and are read without checking.
fn decode(t: String, i: usize) -> (u32, usize) {
    unsafe {
        let p = t.as_ptr().add(i)
        let b0 = u32(p.read())
        if b0 < 0x80 {
            return (b0, 1)
        }
        let b1 = u32(p.add(1).read()) & 0x3F
        if b0 < 0xE0 {
            return (((b0 & 0x1F) << 6) | b1, 2)
        }
        let b2 = u32(p.add(2).read()) & 0x3F
        if b0 < 0xF0 {
            return (((b0 & 0x0F) << 12) | (b1 << 6) | b2, 3)
        }
        let b3 = u32(p.add(3).read()) & 0x3F
        return (((b0 & 0x07) << 18) | (b1 << 12) | (b2 << 6) | b3, 4)
    }
}

// The rune two runes compose to, if they do.
fn composite(a: u32, b: u32) -> u32? {
    if a >= L_BASE and a < L_BASE + L_COUNT and b >= V_BASE and b < V_BASE + V_COUNT {
        return some(S_BASE + ((a - L_BASE) * V_COUNT + (b - V_BASE)) * T_COUNT)
    }
    if a >= S_BASE and a < S_BASE + S_COUNT and (a - S_BASE) % T_COUNT == 0 and b > T_BASE and b < T_BASE + T_COUNT {
        return some(a + (b - T_BASE))
    }
    var s = pair_slot(a, b)
    loop {
        let first = PAIR_FIRST[s]
        if first == 0 {
            return none
        }
        if first == a and PAIR_SECOND[s] == b {
            return some(PAIR_RESULT[s])
        }
        s = (s + 1) % PAIR_FIRST.len()
    }
}

// The pair's slot in the composition table, as tools/unicode/gen_normal.calx puts it there.
fn pair_slot(a: u32, b: u32) -> usize {
    let h = (a * 0x9E3779B1) ^ (b * 0x85EBCA77)
    return usize(h >> 21)
}

// --- the quick check -----------------------------------------------------------------------------

enum Check {
    Yes,
    Maybe,
    No,
}

// UAX #15's quick check of `text` for `form`: Yes if it's in it, No if it isn't, and Maybe if only
// normalizing can tell. With it, the offset from which normalizing must start: the last starter
// before the first rune that isn't certainly in the form. Nothing before a starter can compose
// with what's after it, so what's before it is in the form as it is. Normalizing starts there for
// Maybe as for No, so `normalize` stops at the first doubt, `past_maybe` false: text in NFD, whose
// every mark is a Maybe in NFC, isn't read twice. `is_normalized` looks on for a No, which saves
// it normalizing.
fn quick(text: String, form: Form, past_maybe: bool) -> (Check, usize) {
    let no = no_bit(form)
    let maybe = maybe_bit(form)
    let easy = easy_bit(form)
    // ASCII is in every form, and nothing below U+0300 changes in NFC, which in UTF-8 is every
    // byte below 0xCC. CJK's ideographs are starters in every form, Hangul's syllables in the
    // composing ones, and Latin Extended Additional in NFC, as tests/std/unicode_skip.calx checks
    // in the tables. Runs of them are skipped 16 or 32 bytes at a time.
    let low: u8 = if form == Form.NFC { 0xCC } else { 0x80 }
    let kinds: u8 = match form {
        Form.NFC => 7,
        Form.NFKC => 3,
        _ => 1,
    }
    let n = text.len()
    var result = Check.Yes
    var doubt = n
    var last_class: u8 = 0
    var starter: usize = 0
    var i: usize = 0
    while i < n {
        let b = text.byte_at(i)
        if run_start(b, low) {
            // A run. The last rune in it starts at its last byte that isn't a continuation byte.
            let to = unsafe { cx_bytes_skip_starters(text.as_ptr(), n, i, low, kinds) }
            if to > i {
                i = to
                var s = i - 1
                while (text.byte_at(s) & 0xC0) == 0x80 {
                    s -= 1
                }
                starter = s
                last_class = 0
                continue
            }
        }
        let d = decode(text, i)
        if (EASY[usize(d.0) / BLOCK] & easy) != 0 {
            last_class = 0
            starter = i
            i += d.1
            if d.1 == 3 {
                // Then the three-byte runes after it in such blocks, as Hangul and CJK text is.
                unsafe {
                    let p = text.as_ptr()
                    while i + 2 < n {
                        let b0 = u32(p.add(i).read())
                        if (b0 & 0xF0) != 0xE0 {
                            break
                        }
                        let c = ((b0 & 0x0F) << 12) | ((u32(p.add(i + 1).read()) & 0x3F) << 6) | (u32(p.add(i + 2).read()) & 0x3F)
                        if (EASY[usize(c) / BLOCK] & easy) == 0 {
                            break
                        }
                        starter = i
                        i += 3
                    }
                }
            }
            continue
        }
        let r = record(d.0)
        let class = CCC[r]
        let q = QC[r]
        if (class != 0 and last_class > class) or q & no != 0 {
            return (Check.No, if result == Check.Maybe { doubt } else { starter })
        }
        if q & maybe != 0 and result == Check.Yes {
            if not past_maybe {
                return (Check.Maybe, starter)
            }
            result = Check.Maybe
            doubt = starter
        }
        if class == 0 {
            starter = i
        }
        last_class = class
        i += d.1
    }
    return (result, doubt)
}

// --- normalizing ---------------------------------------------------------------------------------

// The runes decomposed since the last starter that nothing composes into, in canonical order,
// with their classes. In a decomposing form a starter goes straight out, since marks are only
// ever ordered among themselves, after it, so only marks wait here.
struct Pending {
    runes: List<u32>
    classes: List<u8>
}

// Normalizes `text` from byte `from` onto `out`.
fn normalize_from(text: String, from: usize, form: Form, out: mut String) {
    let compat = form == Form.NFKC or form == Form.NFKD
    let compose = form == Form.NFC or form == Form.NFKC
    let maybe = maybe_bit(form)
    var p = Pending { runes: [], classes: [] }
    let n = text.len()
    var i = from
    while i < n {
        if text.byte_at(i) < 0x80 {
            // A run of ASCII: starters that compose with nothing before them, so what's pending is
            // written out, then the run but its last letter, which a mark after it might compose with.
            let run = below(text, i, 0x80)
            flush(mut p, compose, mut out)
            if compose {
                out.push_str(text[i..i + run - 1])
                p.runes.push(u32(text.byte_at(i + run - 1)))
                p.classes.push(0)
            } else {
                out.push_str(text[i..i + run])
            }
            i += run
            continue
        }
        let d = decode(text, i)
        i += d.1
        let c = d.0
        if c >= S_BASE and c < S_BASE + S_COUNT {
            let s = c - S_BASE
            if not compose {
                // Jamo, starters all, go straight out.
                if not p.runes.is_empty() {
                    flush(mut p, false, mut out)
                }
                out.push(rune.try_from(L_BASE + s / N_COUNT) ?? '\u{FFFD}')
                out.push(rune.try_from(V_BASE + (s % N_COUNT) / T_COUNT) ?? '\u{FFFD}')
                if s % T_COUNT != 0 {
                    out.push(rune.try_from(T_BASE + s % T_COUNT) ?? '\u{FFFD}')
                }
                continue
            }
            add(mut p, L_BASE + s / N_COUNT, 0, compose, false, mut out)
            add(mut p, V_BASE + (s % N_COUNT) / T_COUNT, 0, compose, true, mut out)
            if s % T_COUNT != 0 {
                add(mut p, T_BASE + s % T_COUNT, 0, compose, true, mut out)
            }
            continue
        }
        let r = record(c)
        let at = usize(if compat { COMPAT_AT[r] } else { CANON_AT[r] })
        let len = usize(if compat { COMPAT_LEN[r] } else { CANON_LEN[r] })
        if len == 0 {
            let class = CCC[r]
            if class == 0 and not compose {
                if not p.runes.is_empty() {
                    flush(mut p, false, mut out)
                }
                out.push(rune.try_from(c) ?? '\u{FFFD}')
                continue
            }
            add(mut p, c, class, compose, QC[r] & maybe != 0, mut out)
            continue
        }
        for k in at..at + len {
            let part = POOL[k]
            let pr = record(part)
            add(mut p, part, CCC[pr], compose, QC[pr] & maybe != 0, mut out)
        }
    }
    flush(mut p, compose, mut out)
}

// Adds the decomposed rune `c` of class `class`. A starter that can't compose with what's before
// it, `back` false, first writes out what's pending: by itself if that's one starter, which is
// most of the time. A combining mark goes after the last pending rune whose class isn't greater,
// which is canonical ordering. This has no loop, so its views aren't copied in and out each call.
fn add(p: mut Pending, c: u32, class: u8, compose: bool, back: bool, out: mut String) {
    let m = p.runes.len()
    if class == 0 {
        if not compose {
            if m > 0 {
                flush(mut p, false, mut out)
            }
            out.push(rune.try_from(c) ?? '\u{FFFD}')
            return
        }
        if not back {
            if m == 1 {
                out.push(rune.try_from(p.runes[0]) ?? '\u{FFFD}')
                p.runes.clear()
                p.classes.clear()
            } else if m > 1 {
                flush(mut p, true, mut out)
            }
        }
        p.runes.push(c)
        p.classes.push(0)
        return
    }
    if m == 0 or p.classes[m - 1] <= class {
        p.runes.push(c)
        p.classes.push(class)
    } else {
        insert(mut p, c, class)
    }
}

// Puts the mark `c` before the pending marks of greater classes.
fn insert(p: mut Pending, c: u32, class: u8) {
    var j = p.runes.len()
    while j > 0 and p.classes[j - 1] > class {
        j -= 1
    }
    p.runes.insert(j, c)
    p.classes.insert(j, class)
}

// Writes out what's pending, composed first in a composing form, as UAX #15 composes: each rune
// composes with the last starter if nothing between them has a class as great or is a starter.
fn flush(p: mut Pending, compose: bool, out: mut String) {
    let n = p.runes.len()
    if n == 0 {
        return
    }
    var kept = n
    if compose and n > 1 {
        var starter: usize? = if p.classes[0] == 0 { some(0) } else { none }
        var last_class: u32 = if p.classes[0] == 0 { 0 } else { 256 }
        var w: usize = 1
        for r in 1..n {
            let c = p.runes[r]
            let class = u32(p.classes[r])
            if let s = starter {
                if last_class < class or last_class == 0 {
                    if let made = composite(p.runes[s], c) {
                        p.runes[s] = made
                        continue
                    }
                }
            }
            if class == 0 {
                starter = some(w)
            }
            last_class = class
            p.runes[w] = c
            w += 1
        }
        kept = w
    }
    for k in 0..kept {
        out.push(rune.try_from(p.runes[k]) ?? '\u{FFFD}')
    }
    p.runes.clear()
    p.classes.clear()
}
