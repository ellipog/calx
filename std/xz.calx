/// .xz and .lzma files, decompressed as Python's `lzma.decompress` reads them (CLX-173), and
/// compressed as `xz` and `lzma.compress` write them (CLX-176): release archives such as
/// `.tar.xz`, and whatever `xz` or Python's `lzma` wrote. Whole, or a piece at a time, as
/// `LZMADecompressor` and `LZMACompressor` take them (CLX-179).
module std.xz

import std.bytes.{put_u32_le, put_u64_le, set_u32_le, u32_le, u64_le}

extern "C" {
    fn cx_xz_lzma2_size(input: *const u8, n: usize, info: *u64) -> i32
    fn cx_xz_lzma2_start(ctx: *u8, dict: u64, start: usize)
    fn cx_xz_lzma2(ctx: *u8, input: *const u8, n: usize, out: *u8, cap: usize) -> i32
    fn cx_xz_lzma1_start(ctx: *u8, props: u32, dict: u64, size: u64, start: usize) -> i32
    fn cx_xz_lzma1(ctx: *u8, input: *const u8, n: usize, out: *u8, cap: usize) -> i32
    fn cx_xz_len(ctx: *const u8) -> usize
    fn cx_xz_used(ctx: *const u8) -> usize
    fn cx_xz_delta(buf: *u8, n: usize, dist: u32)
    fn cx_xz_bcj(id: u32, buf: *u8, n: usize, start: u32) -> i32
    fn cx_xz_crc64(crc: u64, p: *const u8, n: usize) -> u64
    fn cx_xz_blocks(input: *const u8, desc: *const u64, n: usize, out: *u8, ok: *u8)
    fn cx_zlib_crc32(crc: u32, p: *const u8, n: usize) -> u32
    fn cx_digest_start(ctx: *u8, kind: u32)
    fn cx_digest_add(ctx: *u8, p: *const u8, n: usize)
    fn cx_digest_finish(ctx: *u8, out: *u8) -> usize
    fn cx_xze_start(input: *const u8, n: u64, opt: *const u64, sizes: *u64) -> u64
    fn cx_xze_blocks(n: u64, block: u64) -> u64
    fn cx_xze_take(h: u64, b: u64, dst: *u8)
    fn cx_xze_end(h: u64)
    fn cx_xz_resume(ctx: *u8, partial: i32)
    fn cx_xz_slide(ctx: *u8, buf: *u8, keep: usize) -> usize
    fn cx_xz_chain_start(ctx: *u8, filters: *const u64, count: u32)
    fn cx_xz_chain(ctx: *u8, buf: *u8, n: usize, at: u64, last: i32) -> usize
    fn cx_workers() -> usize
    fn memcpy(to: *u8, from: *const u8, n: usize) -> *u8
    fn memmove(to: *u8, from: *const u8, n: usize) -> *u8
}

/// Which files `decompress` takes, and which `compress` writes.
pub enum Format {
    /// Any, by the first byte, as Python's `FORMAT_AUTO`: .xz, .lzma, or lzip's .lz, which
    /// liblzma reads since xz 5.4.
    Auto
    /// `.xz` only, as `FORMAT_XZ`.
    Xz
    /// `.lzma` only, as `FORMAT_ALONE`, which takes headers `Auto` doesn't.
    Alone
}

/// Why bytes didn't decompress. Python's `lzma.decompress` raises an `LZMAError` for each, and a
/// file from `lzma.open` an `EOFError` for `Truncated`.
pub enum Error {
    /// They're neither .xz nor .lzma. Python says "Input format not supported by decoder".
    Format
    /// They ask for a filter or a setting there's no decoder for. Python says "Invalid or
    /// unsupported options".
    Options
    /// They're broken. Python says "Corrupt input data".
    Corrupt
    /// A block's check doesn't match what it decompresses to. Python says "Corrupt input data".
    Checksum
    /// They end before the stream does. Python says "Compressed data ended before the
    /// end-of-stream marker was reached".
    Truncated
    /// They decompress to more than the limit.
    TooLong
}

/// What went wrong, in words: `corrupt data`, `the data ends early`.
impl Display for Error {
    fn show(self) {
        match self {
            Format => print("not an .xz or .lzma file"),
            Options => print("a filter or setting that isn't supported"),
            Corrupt => print("corrupt data"),
            Checksum => print("checksum mismatch"),
            Truncated => print("the data ends early"),
            TooLong => print("longer than the limit when decompressed"),
        }
    }
}

// The decoder's context, CX_XZ_CTX in the runtime.
const CTX: usize = 28672
// A size the header doesn't give.
const UNKNOWN: u64 = 18446744073709551615
// The largest a block may be, without its padding, and the first filter ID that's reserved.
const UNPADDED_MAX: u64 = 9223372036854775804
const RESERVED_ID: u64 = 4611686018427387904
const LZMA2: u64 = 0x21
const DELTA: u64 = 0x03

/// What the bytes decompress to: an .xz or .lzma file, or several one after another, as
/// `lzma.decompress(bytes)` gives it. As Python does, it stops quietly at whatever after the first
/// stream isn't another, but fails if that's the start of one that's cut short. Fails with
/// `TooLong` if it's more than `limit` bytes, which is no limit at all unless it's given.
pub fn decompress(bytes: List<u8>, format: Format = Format.Auto, limit: u64 = u64.MAX) -> List<u8> ! Error {
    var out: List<u8> = []
    try decompress_into(bytes, 0, bytes.len(), format, limit, mut out)
    return out
}

/// Decompresses the bytes from `from` up to `to` onto the end of `out`, as `decompress` does,
/// adding at most `limit` bytes. On an error, `out` is as it was. Panics unless the range is in
/// `bytes`.
@track_caller
pub fn decompress_into(bytes: List<u8>, from: usize, to: usize, format: Format, limit: u64, out: mut List<u8>) ! Error {
    if from > to or to > bytes.len() {
        panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
    }
    let begin = out.len()
    // How long the output may get.
    let cap = if limit > u64.MAX - u64(begin) { u64.MAX } else { u64(begin) + limit }
    // The context is written by the runtime before it's read, so it isn't cleared first.
    var ctx = List<u8>()
    ctx.reserve(CTX)
    unsafe {
        ctx.set_len(CTX)
    }
    var at = from
    loop {
        let mark = out.len()
        match stream(bytes, at, to, format, cap, mut ctx, mut out) {
            ok(next) => at = next,
            err(e) => {
                out.truncate(mark)
                // Python's lzma.decompress raises for the first stream, and for a later one cut
                // short, and stops quietly at anything else after the first.
                if at == from or e == Error.Truncated or e == Error.TooLong {
                    out.truncate(begin)
                    fail e
                }
                return
            }
        }
        if at == to {
            return
        }
    }
}

/// Whether the bytes start as an .xz file does.
pub fn is_xz(bytes: List<u8>) -> bool {
    return bytes.len() >= 6 and bytes[0] == 0xFD and bytes[1] == 0x37 and bytes[2] == 0x7A and bytes[3] == 0x58 and bytes[4] == 0x5A and bytes[5] == 0
}

/// The CRC-64 of the bytes, as .xz files check their blocks with it: ECMA-182's, reflected, as
/// `xz` and liblzma's `lzma_crc64` give it.
pub fn crc64(bytes: List<u8>) -> u64 {
    return unsafe { cx_xz_crc64(0, bytes.as_ptr(), bytes.len()) }
}

/// Which check `compress` puts after each block of an .xz file, as `xz --check` and Python's
/// `check=` choose it.
pub enum Check {
    /// None, as `CHECK_NONE`.
    None
    /// CRC-32, as `CHECK_CRC32`.
    Crc32
    /// CRC-64, as `CHECK_CRC64`, which `xz` and Python write unless told otherwise.
    Crc64
    /// SHA-256, as `CHECK_SHA256`.
    Sha256
}

/// The bytes compressed: an .xz file, as `lzma.compress(bytes)` and `xz` write one, or with
/// `Format.Alone` a .lzma file, which has no check. `preset` is 0, fastest, to 9, smallest, as
/// `xz -0` to `xz -9`, and `extreme` is `xz -e`, a little smaller for a lot more time. The text is
/// cut into blocks of `block_size` bytes, or of three times the preset's dictionary, as `xz -T0`
/// cuts it, which compress at once on all the processors and decompress at once too. A block
/// that's alone on a processor is cut into slices that compress at once as well. Panics for a
/// preset past 9 or for `Format.Auto`.
@track_caller
pub fn compress(bytes: List<u8>, preset: u32 = 6, check: Check = Check.Crc64, format: Format = Format.Xz, extreme: bool = false, block_size: u64 = 0) -> List<u8> {
    if preset > 9 {
        panic("the preset is 0 to 9, not {preset}")
    }
    if format == Format.Auto {
        panic("`compress` writes `Format.Xz` or `Format.Alone`, not `Format.Auto`")
    }
    let s = preset_settings(preset, extreme)
    let n = u64(bytes.len())
    let lzma = format == Format.Alone
    var each = block_size
    if each == 0 {
        each = if 3 * s.dict > 1048576 { 3 * s.dict } else { 1048576 }
    }
    let blocks = if lzma { 1u64 } else { unsafe { cx_xze_blocks(n, each) } }
    let opt: List<u64> = [s.dict, 3, 0, 2, if s.fast { 1 } else { 0 }, s.nice, if s.bt { 1 } else { 0 }, s.depth, each, 0, 0, if lzma { 1 } else { 0 }]
    var sizes: List<u64> = [0; usize.wrap(blocks)]
    let h = unsafe { cx_xze_start(bytes.as_ptr(), n, opt.as_ptr(), sizes.as_mut_ptr()) }
    var out = List<u8>()
    if lzma {
        // lc 3, lp 0, pb 2, the dictionary, and the size, which the data then stops at.
        out.push(93)
        put_u32_le(mut out, u32.wrap(dict_size(dict_code(if n < s.dict { n } else { s.dict }))))
        put_u64_le(mut out, n)
        take(h, 0, sizes[0], mut out)
    } else {
        write_xz(bytes, s.dict, each, check, h, sizes, mut out)
    }
    unsafe {
        cx_xze_end(h)
    }
    return out
}

// A preset's dictionary size, whether its parser is the fast one, how long a match is long enough
// to take without looking further, whether its match finder is a binary tree, and how deep that
// looks, 0 for its own depth: as `xz`'s manual lists them.
struct Settings {
    dict: u64
    fast: bool
    nice: u64
    bt: bool
    depth: u64
}

fn preset_settings(preset: u32, extreme: bool) -> Settings {
    let dicts: List<u64> = [18, 20, 21, 22, 22, 23, 23, 24, 25, 26]
    let dict = 1u64 << dicts[usize(preset)]
    if extreme {
        if preset == 3 or preset == 5 {
            return Settings { dict: dict, fast: false, nice: 192, bt: true, depth: 0 }
        }
        return Settings { dict: dict, fast: false, nice: 273, bt: true, depth: 512 }
    }
    if preset <= 3 {
        let nices: List<u64> = [128, 128, 273, 273]
        let depths: List<u64> = [4, 8, 24, 48]
        return Settings { dict: dict, fast: true, nice: nices[usize(preset)], bt: false, depth: depths[usize(preset)] }
    }
    let nice: u64 = if preset == 4 { 16 } else if preset == 5 { 32 } else { 64 }
    return Settings { dict: dict, fast: false, nice: nice, bt: true, depth: 0 }
}

// The code for the smallest dictionary LZMA2's properties can give that holds `want` bytes, at
// least 4 KiB: 2^n or 2^n + 2^(n-1).
fn dict_code(want: u64) -> u8 {
    for b in 0u8..40 {
        if dict_size(b) >= want {
            return b
        }
    }
    return 40
}

fn dict_size(code: u8) -> u64 {
    if code >= 40 {
        return 4294967295
    }
    return (2u64 | u64(code & 1)) << (u64(code / 2) + 11)
}

// Copies block b's data from the compressor onto the end of `out`.
fn take(h: u64, b: u64, size: u64, out: mut List<u8>) {
    let at = out.len()
    out.reserve(usize.wrap(size))
    unsafe {
        cx_xze_take(h, b, out.as_mut_ptr().add(at))
        out.set_len(at + usize.wrap(size))
    }
}

// The .xz stream around the blocks: the header, each block with its header, padding and check,
// the index, and the footer.
fn write_xz(bytes: List<u8>, dict: u64, each: u64, check: Check, h: u64, sizes: List<u64>, out: mut List<u8>) {
    let id = check_id(check)
    put_stream_header(id, mut out)
    let n = u64(bytes.len())
    var records = List<u8>()
    for b in 0u64..u64(sizes.len()) {
        let from = b * each
        let len = if n - from < each { n - from } else { each }
        put_block(h, b, sizes[usize.wrap(b)], bytes, usize.wrap(from), len, dict, id, mut out, mut records)
    }
    put_index(records, u64(sizes.len()), id, mut out)
}

fn check_id(check: Check) -> u8 {
    return match check {
        None => 0,
        Crc32 => 1,
        Crc64 => 4,
        Sha256 => 10,
    }
}

fn put_stream_header(id: u8, out: mut List<u8>) {
    let magic: List<u8> = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0]
    let at = out.len()
    out.extend(magic)
    out.push(0)
    out.push(id)
    let flags = crc32(out, at + 6, at + 8)
    put_u32_le(mut out, flags)
}

// Block b of the compressor's, which holds `len` bytes of text from bytes[from], onto `out`: its
// header, which gives both sizes, so the blocks can be decompressed at once, then LZMA2's filter
// flags; its LZMA2, which is `packed` bytes; its padding, and its check. Its record for the index
// goes onto `records`.
fn put_block(h: u64, b: u64, packed: u64, bytes: List<u8>, from: usize, len: u64, dict: u64, id: u8, out: mut List<u8>, records: mut List<u8>) {
    let head = out.len()
    out.push(0)
    out.push(0xC0)
    put_vli(mut out, packed)
    put_vli(mut out, len)
    out.push(0x21)
    out.push(1)
    out.push(dict_code(if len < dict { len } else { dict }))
    while (out.len() - head) % 4 != 0 {
        out.push(0)
    }
    out[head] = u8.wrap((out.len() - head) / 4)
    let head_crc = crc32(out, head, out.len())
    put_u32_le(mut out, head_crc)
    let head_size = out.len() - head
    take(h, b, packed, mut out)
    while (out.len() - head) % 4 != 0 {
        out.push(0)
    }
    put_check(id, bytes, from, from + usize.wrap(len), mut out)
    put_vli(mut records, u64(head_size) + packed + u64(check_size(id)))
    put_vli(mut records, len)
}

// The index of `count` blocks, whose records are `records`, and the stream footer.
fn put_index(records: List<u8>, count: u64, id: u8, out: mut List<u8>) {
    let listed = out.len()
    out.push(0)
    put_vli(mut out, count)
    out.extend(records)
    while (out.len() - listed) % 4 != 0 {
        out.push(0)
    }
    let index_crc = crc32(out, listed, out.len())
    put_u32_le(mut out, index_crc)
    let backward = u32.wrap((out.len() - listed) / 4 - 1)
    let foot = out.len()
    put_u32_le(mut out, 0)
    put_u32_le(mut out, backward)
    out.push(0)
    out.push(id)
    let foot_crc = crc32(out, foot + 4, foot + 10)
    set_u32_le(mut out, foot, foot_crc)
    out.push(0x59)
    out.push(0x5A)
}

// The check of bytes[from..to) whose ID is `id`, onto the end of `out`.
fn put_check(id: u8, bytes: List<u8>, from: usize, to: usize, out: mut List<u8>) {
    if id == 1 {
        put_u32_le(mut out, crc32(bytes, from, to))
    } else if id == 4 {
        put_u64_le(mut out, unsafe { cx_xz_crc64(0, bytes.as_ptr().add(from), to - from) })
    } else if id == 10 {
        var ctx: List<u8> = [0; 224]
        var digest: List<u8> = [0; 64]
        unsafe {
            cx_digest_start(ctx.as_mut_ptr(), 2)
            cx_digest_add(ctx.as_mut_ptr(), bytes.as_ptr().add(from), to - from)
            _ = cx_digest_finish(ctx.as_mut_ptr(), digest.as_mut_ptr())
        }
        out.extend(digest[0..32])
    }
}

fn put_vli(out: mut List<u8>, v: u64) {
    var x = v
    while x >= 0x80 {
        out.push(u8.wrap(x) | 0x80)
        x >>= 7
    }
    out.push(u8.wrap(x))
}

// Decodes the one stream at bytes[at..to) onto `out`, and gives where it ends.
fn stream(bytes: List<u8>, at: usize, to: usize, format: Format, cap: u64, ctx: mut List<u8>, out: mut List<u8>) -> usize ! Error {
    if format == Format.Xz {
        return try xz(bytes, at, to, cap, mut ctx, mut out)
    }
    if format == Format.Alone {
        return try alone(bytes, at, to, false, cap, mut ctx, mut out)
    }
    // liblzma's auto decoder: .xz starts with 0xFD, and .lz with an L, and anything else may be
    // .lzma, whose header it checks more closely.
    if at >= to {
        fail Error.Truncated
    }
    if bytes[at] == 0xFD {
        return try xz(bytes, at, to, cap, mut ctx, mut out)
    }
    if bytes[at] == 0x4C {
        return try lzip(bytes, at, to, cap, mut ctx, mut out)
    }
    return try alone(bytes, at, to, true, cap, mut ctx, mut out)
}

// --- .xz --------------------------------------------------------------------------------------

// The stream header, its blocks, the index and the footer, checked as liblzma checks them and in
// its order, so the same bytes fail the same way.
fn xz(bytes: List<u8>, at: usize, to: usize, cap: u64, ctx: mut List<u8>, out: mut List<u8>) -> usize ! Error {
    let check = try stream_header(bytes, at, to)
    // Each block's size without its padding, and what it decompresses to.
    var sizes = List<u64>()
    var p = at + 12
    loop {
        if p >= to {
            fail Error.Truncated
        }
        if bytes[p] == 0 {
            break
        }
        let next = blocks_at_once(bytes, p, to, check, cap, mut out, mut sizes)
        if next != p {
            p = next
            continue
        }
        p = try block(bytes, p, to, check, cap, mut ctx, mut out, mut sizes)
    }
    let index_at = p
    p = try index(bytes, p, to, sizes)
    try footer(bytes, p, to, index_at, check)
    return p + 12
}

// The stream header at bytes[at..to): the magic bytes, the flags and their CRC-32. Gives the ID of
// the check the blocks have.
fn stream_header(bytes: List<u8>, at: usize, to: usize) -> u8 ! Error {
    if to - at < 12 {
        fail Error.Truncated
    }
    if not (bytes[at] == 0xFD and bytes[at + 1] == 0x37 and bytes[at + 2] == 0x7A and bytes[at + 3] == 0x58 and bytes[at + 4] == 0x5A and bytes[at + 5] == 0) {
        fail Error.Format
    }
    if crc32(bytes, at + 6, at + 8) != u32_le(bytes, at + 8) {
        fail Error.Corrupt
    }
    if bytes[at + 6] != 0 or bytes[at + 7] & 0xF0 != 0 {
        fail Error.Options
    }
    return bytes[at + 7]
}

// The stream footer at bytes[p..to), after the index at `index_at`: its CRC-32, the index's size,
// and the flags, which must be the header's.
fn footer(bytes: List<u8>, p: usize, to: usize, index_at: usize, check: u8) ! Error {
    if to - p < 12 {
        fail Error.Truncated
    }
    if bytes[p + 10] != 0x59 or bytes[p + 11] != 0x5A {
        fail Error.Corrupt
    }
    if crc32(bytes, p + 4, p + 10) != u32_le(bytes, p) {
        fail Error.Corrupt
    }
    if bytes[p + 8] != 0 or bytes[p + 9] & 0xF0 != 0 {
        fail Error.Options
    }
    if (u64(u32_le(bytes, p + 4)) + 1) * 4 != u64(p - index_at) or bytes[p + 9] != check {
        fail Error.Corrupt
    }
}

// How many bytes a block's check takes, by its ID.
fn check_size(check: u8) -> usize {
    if check == 0 {
        return 0
    }
    return usize.wrap(4u64 << u64((check - 1) / 3))
}

// The units a BCJ filter works on, which its start offset must be a multiple of.
fn bcj_alignment(id: u64) -> u32 {
    return match id {
        5 => 4,
        6 => 16,
        7 => 4,
        8 => 2,
        9 => 4,
        10 => 4,
        11 => 2,
        _ => 1,
    }
}

// A block's filter: its ID, and the BCJ filters' start offset or the delta filter's distance.
struct Filter {
    id: u64
    arg: u32
}

// A block's header, read and checked.
struct Header {
    // The header's own size, and where the data starts.
    size: usize
    data: usize
    // What the data's size and what it decompresses to are, if the header says.
    packed: u64
    unpacked: u64
    // LZMA2's dictionary size, and the filters, LZMA2 last.
    dict: u64
    filters: List<Filter>
}

// Reads the header of the block at `p`, checking it as liblzma does, in its order.
fn header(bytes: List<u8>, p: usize, to: usize, check: u8) -> Header ! Error {
    let size = (usize(bytes[p]) + 1) * 4
    if to - p < size {
        fail Error.Truncated
    }
    let end = p + size - 4
    if crc32(bytes, p, end) != u32_le(bytes, end) {
        fail Error.Corrupt
    }
    let flags = bytes[p + 1]
    if flags & 0x3C != 0 {
        fail Error.Options
    }
    var q = p + 2
    var packed = UNKNOWN
    if flags & 0x40 != 0 {
        let v = try vli_in(bytes, q, end)
        packed = v.value
        q = v.next
        if packed == 0 or packed > UNPADDED_MAX - u64(size + check_size(check)) {
            fail Error.Corrupt
        }
    }
    var unpacked = UNKNOWN
    if flags & 0x80 != 0 {
        let v = try vli_in(bytes, q, end)
        unpacked = v.value
        q = v.next
    }
    let count = usize(flags & 3) + 1
    var filters = List<Filter>()
    var dict: u64 = 0
    for _ in 0..count {
        let id = try vli_in(bytes, q, end)
        if id.value >= RESERVED_ID {
            fail Error.Corrupt
        }
        let len = try vli_in(bytes, id.next, end)
        if u64(end - len.next) < len.value {
            fail Error.Corrupt
        }
        let props = len.next
        let n = usize.wrap(len.value)
        q = props + n
        var arg: u32 = 0
        if id.value == LZMA2 {
            if n != 1 or bytes[props] & 0xC0 != 0 or bytes[props] > 40 {
                fail Error.Options
            }
            let b = u64(bytes[props])
            dict = if b == 40 { 4294967295 } else { (2 | (b & 1)) << (b / 2 + 11) }
        } else if id.value >= 4 and id.value <= 11 {
            if n == 4 {
                arg = u32_le(bytes, props)
            } else if n != 0 {
                fail Error.Options
            }
        } else if id.value == DELTA {
            if n != 1 {
                fail Error.Options
            }
            arg = u32(bytes[props]) + 1
        } else {
            fail Error.Options
        }
        filters.push(Filter { id: id.value, arg: arg })
    }
    while q < end {
        if bytes[q] != 0 {
            fail Error.Options
        }
        q += 1
    }
    // The chain is BCJ and delta filters, then LZMA2.
    for k in 0..count {
        if (filters[k].id == LZMA2) != (k == count - 1) {
            fail Error.Options
        }
        if filters[k].id != LZMA2 and filters[k].id != DELTA and filters[k].arg % bcj_alignment(filters[k].id) != 0 {
            fail Error.Options
        }
    }
    return Header { size: size, data: end + 4, packed: packed, unpacked: unpacked, dict: dict, filters: filters }
}

// Decodes the block at `p` onto `out`, adds its sizes, and gives where it ends.
fn block(bytes: List<u8>, p: usize, to: usize, check: u8, cap: u64, ctx: mut List<u8>, out: mut List<u8>, sizes: mut List<u64>) -> usize ! Error {
    let h = try header(bytes, p, to, check)
    // The data, which is as long as the header says, if it says.
    var stop = to
    var bounded = false
    if h.packed != UNKNOWN and h.packed <= u64(to - h.data) {
        stop = h.data + usize.wrap(h.packed)
        bounded = true
    }
    let start = out.len()
    try lzma2(bytes, h.data, stop, bounded, h.dict, cap, mut ctx, mut out)
    let used = unsafe { cx_xz_used(ctx.as_ptr()) }
    let made = out.len() - start
    if (h.packed != UNKNOWN and u64(used) != h.packed) or (h.unpacked != UNKNOWN and u64(made) != h.unpacked) {
        fail Error.Corrupt
    }
    // The filters before LZMA2, undone last first.
    var k = h.filters.len() - 1
    while k > 0 {
        k -= 1
        unsafe {
            if h.filters[k].id == DELTA {
                cx_xz_delta(out.as_mut_ptr().add(start), made, h.filters[k].arg)
            } else {
                _ = cx_xz_bcj(u32.wrap(h.filters[k].id), out.as_mut_ptr().add(start), made, h.filters[k].arg)
            }
        }
    }
    // Padding to 4 bytes, then the check.
    var r = h.data + used
    while (r - p) % 4 != 0 {
        if r >= to {
            fail Error.Truncated
        }
        if bytes[r] != 0 {
            fail Error.Corrupt
        }
        r += 1
    }
    let check_len = check_size(check)
    if to - r < check_len {
        fail Error.Truncated
    }
    if not check_matches(check, out, start, bytes, r) {
        fail Error.Checksum
    }
    sizes.push(u64(h.size + used + check_len))
    sizes.push(u64(made))
    return r + check_len
}

// Decodes the blocks from `p` on whose headers give both sizes, as `xz -T` writes them, at once,
// each into its own part of `out` on a thread of its own, as many as there are in a row, and adds
// their sizes. Gives where the first block it didn't do starts: `p` itself, for fewer than two. A
// block that goes wrong is left for `block`, which finds the same error the same way.
fn blocks_at_once(bytes: List<u8>, p: usize, to: usize, check: u8, cap: u64, out: mut List<u8>, sizes: mut List<u64>) -> usize {
    let check_len = check_size(check)
    let left = cap - u64(out.len())
    var heads = List<Header>()
    var starts = List<usize>()
    var total: u64 = 0
    var q = p
    loop {
        if q >= to or bytes[q] == 0 {
            break
        }
        let h = match header(bytes, q, to, check) {
            ok(h) => h,
            err(_) => break,
        }
        if h.packed == UNKNOWN or h.unpacked == UNKNOWN or h.packed > u64(to - h.data) or h.unpacked > left - total {
            break
        }
        // Padding to 4 bytes from the block's start, then the check.
        let data_end = h.data + usize.wrap(h.packed)
        let next = data_end + (4 - (data_end - q) % 4) % 4 + check_len
        if next > to {
            break
        }
        starts.push(q)
        total += h.unpacked
        heads.push(h)
        q = next
    }
    let n = heads.len()
    if n < 2 {
        return p
    }
    // What each block is, for the runtime, which decodes them on `parallel for`'s threads.
    let base = out.len()
    var desc = List<u64>()
    var at = u64(base)
    for k in 0..n {
        let data_end = heads[k].data + usize.wrap(heads[k].packed)
        let check_at = data_end + (4 - (data_end - starts[k]) % 4) % 4
        desc.push(u64(heads[k].data))
        desc.push(heads[k].packed)
        desc.push(heads[k].unpacked)
        desc.push(at)
        desc.push(heads[k].dict)
        desc.push(u64(check))
        desc.push(u64(check_at))
        let before = heads[k].filters.len() - 1
        desc.push(u64(before))
        for f in 0usize..3 {
            if f < before {
                desc.push(heads[k].filters[f].id)
                desc.push(u64(heads[k].filters[f].arg))
            } else {
                desc.push(0)
                desc.push(0)
            }
        }
        at += heads[k].unpacked
    }
    out.reserve(usize.wrap(total))
    var good: List<u8> = []
    for _ in 0..n {
        good.push(0)
    }
    unsafe {
        cx_xz_blocks(bytes.as_ptr(), desc.as_ptr(), n, out.as_mut_ptr(), good.as_mut_ptr())
    }
    var done = base
    for k in 0..n {
        if good[k] == 0 {
            unsafe {
                out.set_len(done)
            }
            return starts[k]
        }
        done += usize.wrap(heads[k].unpacked)
        unsafe {
            out.set_len(done)
        }
        sizes.push(u64(heads[k].size) + heads[k].packed + u64(check_len))
        sizes.push(heads[k].unpacked)
    }
    return q
}

// Decodes the LZMA2 data at bytes[from..to) onto `out`. `bounded` says the block's header gave
// where it ends, so data that runs out there is corrupt, not cut short.
fn lzma2(bytes: List<u8>, from: usize, to: usize, bounded: bool, dict: u64, cap: u64, ctx: mut List<u8>, out: mut List<u8>) ! Error {
    let n = to - from
    // The chunks' headers say what it decompresses to: room for that in one go, unless it's more
    // than data like this makes, which a broken header might claim, and then room as it's needed.
    var info: List<u64> = [0, 0]
    unsafe {
        _ = cx_xz_lzma2_size(bytes.as_ptr().add(from), n, info.as_mut_ptr())
        cx_xz_lzma2_start(ctx.as_mut_ptr(), dict, out.len())
    }
    let total = info[0]
    let guess = u64(n) * 64 + 1048576
    var room: u64 = if total < guess { total } else { guess }
    loop {
        let left = cap - u64(out.len())
        if room > left {
            room = left
        }
        out.reserve(usize.wrap(room))
        let status = unsafe { cx_xz_lzma2(ctx.as_mut_ptr(), bytes.as_ptr().add(from), n, out.as_mut_ptr(), out.len() + usize.wrap(room)) }
        unsafe {
            out.set_len(cx_xz_len(ctx.as_ptr()))
        }
        if status == 0 {
            return
        }
        if status == 1 {
            if room == left {
                fail Error.TooLong
            }
            if room >= total {
                // The chunks are no bigger than their headers say, so this can't happen.
                fail Error.Corrupt
            }
            room = if room * 2 < total { room * 2 } else { total }
            continue
        }
        if status == -2 and not bounded {
            fail Error.Truncated
        }
        fail Error.Corrupt
    }
}

// Whether the check at bytes[at..] matches out[start..]: CRC-32, CRC-64 or SHA-256. A check of
// another kind isn't checked, as liblzma doesn't.
fn check_matches(check: u8, out: List<u8>, start: usize, bytes: List<u8>, at: usize) -> bool {
    let n = out.len() - start
    if check == 1 {
        return unsafe { cx_zlib_crc32(0, out.as_ptr().add(start), n) } == u32_le(bytes, at)
    }
    if check == 4 {
        return unsafe { cx_xz_crc64(0, out.as_ptr().add(start), n) } == u64_le(bytes, at)
    }
    if check == 10 {
        var ctx: List<u8> = [0; 224]
        var digest: List<u8> = [0; 64]
        unsafe {
            cx_digest_start(ctx.as_mut_ptr(), 2)
            cx_digest_add(ctx.as_mut_ptr(), out.as_ptr().add(start), n)
            _ = cx_digest_finish(ctx.as_mut_ptr(), digest.as_mut_ptr())
        }
        for i in 0usize..32 {
            if digest[i] != bytes[at + i] {
                return false
            }
        }
    }
    return true
}

// Reads the index at `p` and checks it lists the blocks as they were, and gives where it ends.
fn index(bytes: List<u8>, p: usize, to: usize, sizes: List<u64>) -> usize ! Error {
    let blocks = sizes.len() / 2
    // What the blocks add up to, as the index's records must.
    var want_size: u64 = 0
    var want_made: u64 = 0
    var want_list: u64 = 0
    for i in 0..blocks {
        want_size += (sizes[2 * i] + 3) & ~3u64
        want_made += sizes[2 * i + 1]
        want_list += vli_size(sizes[2 * i]) + vli_size(sizes[2 * i + 1])
    }
    let count = try vli_at(bytes, p + 1, to)
    if count.value != u64(blocks) {
        fail Error.Corrupt
    }
    var q = count.next
    var got_size: u64 = 0
    var got_made: u64 = 0
    var got_list: u64 = 0
    var same = true
    for i in 0..blocks {
        let a = try vli_at(bytes, q, to)
        if a.value < 5 or a.value > UNPADDED_MAX {
            fail Error.Corrupt
        }
        let b = try vli_at(bytes, a.next, to)
        q = b.next
        got_size += (a.value + 3) & ~3u64
        got_made += b.value
        got_list += vli_size(a.value) + vli_size(b.value)
        if got_size > want_size or got_made > want_made or got_list > want_list {
            fail Error.Corrupt
        }
        if a.value != sizes[2 * i] or b.value != sizes[2 * i + 1] {
            same = false
        }
    }
    while (q - p) % 4 != 0 {
        if q >= to {
            fail Error.Truncated
        }
        if bytes[q] != 0 {
            fail Error.Corrupt
        }
        q += 1
    }
    if not same or got_size != want_size or got_made != want_made or got_list != want_list {
        fail Error.Corrupt
    }
    // The CRC-32, a byte at a time, as liblzma reads it.
    let crc = crc32(bytes, p, q)
    for k in 0usize..4 {
        if q + k >= to {
            fail Error.Truncated
        }
        if u32(bytes[q + k]) != (crc >> (8 * k)) & 0xFF {
            fail Error.Corrupt
        }
    }
    return q + 4
}

// A variable-length integer: seven bits a byte, least significant first, with the top bit set on
// all but the last.
struct Vli {
    value: u64
    next: usize
    // 0, 1 for one that's malformed, or 2 for one that runs past the end.
    status: u8
}

fn vli(bytes: List<u8>, at: usize, end: usize) -> Vli {
    var value: u64 = 0
    var i = at
    var k: u64 = 0
    loop {
        if i >= end {
            return Vli { value: value, next: i, status: 2 }
        }
        let b = bytes[i]
        i += 1
        value |= u64(b & 0x7F) << (7 * k)
        k += 1
        if b & 0x80 == 0 {
            // The shortest form only.
            if b == 0 and k > 1 {
                return Vli { value: value, next: i, status: 1 }
            }
            return Vli { value: value, next: i, status: 0 }
        }
        if k == 9 {
            return Vli { value: value, next: i, status: 1 }
        }
    }
}

// One in a block header, which ends at `end`: anything wrong with it is corrupt.
fn vli_in(bytes: List<u8>, at: usize, end: usize) -> Vli ! Error {
    let v = vli(bytes, at, end)
    if v.status != 0 {
        fail Error.Corrupt
    }
    return v
}

// One in the index, which may run past the end of the data, and then it's cut short.
fn vli_at(bytes: List<u8>, at: usize, to: usize) -> Vli ! Error {
    let v = vli(bytes, at, to)
    if v.status == 1 {
        fail Error.Corrupt
    }
    if v.status == 2 {
        fail Error.Truncated
    }
    return v
}

fn vli_size(v: u64) -> u64 {
    var n: u64 = 1
    var x = v >> 7
    while x != 0 {
        n += 1
        x >>= 7
    }
    return n
}

// --- .lzma -------------------------------------------------------------------------------------

// A .lzma file: a properties byte, the dictionary size and the size, then LZMA data. `picky` is
// liblzma's auto decoder, which takes only the dictionary sizes LZMA's tools write, and sizes
// under 256 GiB, as so much else could pass for a header.
fn alone(bytes: List<u8>, at: usize, to: usize, picky: bool, cap: u64, ctx: mut List<u8>, out: mut List<u8>) -> usize ! Error {
    let h = try alone_header(bytes, at, to, picky)
    return try lzma1(bytes, at + 13, to, h.props, h.dict, h.size, cap, mut ctx, mut out)
}

// What a .lzma file's header says: the properties byte, the dictionary size, and the size, or
// UNKNOWN.
struct Alone {
    props: u32
    dict: u32
    size: u64
}

fn alone_header(bytes: List<u8>, at: usize, to: usize, picky: bool) -> Alone ! Error {
    let n = to - at
    if n < 1 {
        fail Error.Truncated
    }
    let props = u32(bytes[at])
    if props > 224 or props % 9 + props / 9 % 5 > 4 {
        fail Error.Format
    }
    if n < 5 {
        fail Error.Truncated
    }
    let dict = u32_le(bytes, at + 1)
    if picky and dict != 4294967295 {
        // 2^n or 2^n + 2^(n-1), as liblzma tells them.
        var d = dict.wrapping_sub(1)
        d |= d >> 2
        d |= d >> 3
        d |= d >> 4
        d |= d >> 8
        d |= d >> 16
        if d.wrapping_add(1) != dict {
            fail Error.Format
        }
    }
    if n < 13 {
        fail Error.Truncated
    }
    let size = u64_le(bytes, at + 5)
    if picky and size != UNKNOWN and size >= 274877906944 {
        fail Error.Format
    }
    return Alone { props: props, dict: dict, size: size }
}

// A .lz file's member, as liblzma reads one since xz 5.4: `LZIP`, a version, the dictionary size,
// LZMA data with an end marker, then the CRC-32 and size of what it holds, and for version 1 the
// member's own size.
fn lzip(bytes: List<u8>, at: usize, to: usize, cap: u64, ctx: mut List<u8>, out: mut List<u8>) -> usize ! Error {
    let h = try lzip_header(bytes, at, to)
    let start = out.len()
    // lc 3, lp 0, pb 2.
    let end = try lzma1(bytes, at + 6, to, 93, h.dict, UNKNOWN, cap, mut ctx, mut out)
    let made = out.len() - start
    let crc = unsafe { cx_zlib_crc32(0, out.as_ptr().add(start), made) }
    return try lzip_trailer(bytes, end, to, h.version, crc, u64(made), u64(end - at))
}

// What an .lz member's header says: its version, and the dictionary size.
struct Lzip {
    version: u8
    dict: u32
}

fn lzip_header(bytes: List<u8>, at: usize, to: usize) -> Lzip ! Error {
    let magic: List<u8> = [0x4C, 0x5A, 0x49, 0x50]
    for k in 0usize..4 {
        if at + k >= to {
            fail Error.Truncated
        }
        if bytes[at + k] != magic[k] {
            fail Error.Format
        }
    }
    if to - at < 5 {
        fail Error.Truncated
    }
    let version = bytes[at + 4]
    if version > 1 {
        fail Error.Options
    }
    if to - at < 6 {
        fail Error.Truncated
    }
    // A power of two from 4 KiB to 512 MiB, less up to seven sixteenths of it.
    let ds = u32(bytes[at + 5])
    let log = ds & 0x1F
    let frac = ds >> 5
    if log < 12 or log > 29 or (log == 12 and frac > 0) {
        fail Error.Corrupt
    }
    return Lzip { version: version, dict: (1u32 << log) - (frac << (log - 4)) }
}

// The trailer of an .lz member at bytes[end..to), after its LZMA data: the CRC-32 and the size of
// what it decompressed to, `crc` and `made`, and for version 1 the member's own size, which is
// `before` bytes up to the trailer, and the trailer. Gives where the member ends.
fn lzip_trailer(bytes: List<u8>, end: usize, to: usize, version: u8, crc: u32, made: u64, before: u64) -> usize ! Error {
    let size: usize = if version == 0 { 12 } else { 20 }
    if to - end < size {
        fail Error.Truncated
    }
    if crc != u32_le(bytes, end) {
        fail Error.Checksum
    }
    if u64_le(bytes, end + 4) != made or (version == 1 and u64_le(bytes, end + 12) != before + 20) {
        fail Error.Corrupt
    }
    return end + size
}

// Decodes the LZMA data at bytes[data..to) onto `out`, with the properties byte, the dictionary
// size, and the size the header gave, if it did, and gives where the data ends.
fn lzma1(bytes: List<u8>, data: usize, to: usize, props: u32, dict: u32, size: u64, cap: u64, ctx: mut List<u8>, out: mut List<u8>) -> usize ! Error {
    let len = to - data
    unsafe {
        _ = cx_xz_lzma1_start(ctx.as_mut_ptr(), props, u64(dict), size, out.len())
    }
    // Room for what the header says, unless it's more than data like this makes, or for a guess.
    let guess = u64(len) * 8 + 65536
    var room: u64 = if size < guess { size } else { guess }
    loop {
        let left = cap - u64(out.len())
        if room > left {
            room = left
        }
        out.reserve(usize.wrap(room))
        let status = unsafe { cx_xz_lzma1(ctx.as_mut_ptr(), bytes.as_ptr().add(data), len, out.as_mut_ptr(), out.len() + usize.wrap(room)) }
        unsafe {
            out.set_len(cx_xz_len(ctx.as_ptr()))
        }
        if status == 0 {
            return data + unsafe { cx_xz_used(ctx.as_ptr()) }
        }
        if status == 1 {
            if room == left {
                fail Error.TooLong
            }
            room = room * 2 + 4096
            continue
        }
        if status == -2 {
            fail Error.Truncated
        }
        fail Error.Corrupt
    }
}

// --- a piece at a time ---------------------------------------------------------------------------

// Where a Decompressor is in the data: at a stream's start; at an .xz block's header or the index;
// in a block's data; at its padding and check; at the index and the footer; in .lzma or .lz data;
// at an .lz member's trailer; or past the end, where the rest is unused.
const AT_STREAM: u8 = 0
const AT_BLOCK: u8 = 1
const IN_BLOCK: u8 = 2
const AT_CHECK: u8 = 3
const AT_INDEX: u8 = 4
const IN_LZMA: u8 = 5
const AT_TRAILER: u8 = 6
const ENDED: u8 = 7
// The room a decoder has in its window before each call: an LZMA2 chunk's most text, and more.
const ROOM: usize = 2101248
// The runtime's filter chain, CX_XZ_CHAIN, and SHA-256's context, CX_DIGEST_CTX.
const CHAIN: usize = 1024
const DIGEST: usize = 224
// The version a Decompressor gives .lzma, which isn't an .lz member.
const NOT_LZIP: u8 = 255
// The most a Decompressor waits to decompress at once: what blocks decompress to, and the input
// they take.
const AT_ONCE: u64 = 268435456

/// .xz, .lzma and .lz data decompressed as it comes, a piece at a time, as `decompress` does with
/// all of it at once: a file bigger than memory read a part at a time, or bytes from a pipe or a
/// socket, as Python's `LZMADecompressor` and `lzma.open` take them. It holds the dictionary, the
/// input it hasn't used, and what it hasn't given out yet. Blocks whose headers give both their
/// sizes, as `xz -T` writes them, wait until several are here, and decompress at once.
pub struct Decompressor {
    format: Format
    limit: u64
    // What it has decompressed, and whether a stream has ended, so another may start. Where the
    // stream it's in started in the input, and what had been decompressed then: a stream after the
    // first that fails before it makes anything is where the data ends, as in `decompress`.
    made: u64 = 0
    later: bool = false
    stream_at: usize = 0
    stream_from: u64 = 0
    // The input, which it has used up to `skip`, and where it is in the data.
    input: List<u8>
    skip: usize = 0
    part: u8 = 0
    // Whether the last call stopped for want of input, and the error it failed with. How many
    // threads `parallel for` has, and the `most` of the call it's in.
    hungry: bool = true
    failed: Error? = none
    workers: u64 = 1
    most: u64 = 0
    // An .xz stream's check and its blocks' sizes so far; the block's header's sizes, and how much
    // of its data it has used, and what that made.
    check: u8 = 0
    sizes: List<u64>
    packed: u64 = 0
    unpacked: u64 = 0
    head_size: u64 = 0
    used: u64 = 0
    block_made: u64 = 0
    // An .lz member's version, or NOT_LZIP, and how much of the member it has used.
    version: u8 = 0
    member: u64 = 0
    // The decoder, a copy to go back to, and its window: the dictionary, and from `given` on what
    // hasn't gone out.
    ctx: List<u8>
    spare: List<u8>
    window: List<u8>
    given: usize = 0
    // A block's filters before LZMA2, and what's come out of LZMA2 but isn't through them all and
    // out: tail[tail_from..], which is `tail_at` into the block, with `ready` bytes through.
    filtered: bool = false
    chain: List<u8>
    tail: List<u8>
    tail_from: usize = 0
    tail_at: u64 = 0
    ready: usize = 0
    // The check of what has gone out of the block or member, by the .xz check's ID: 0 for none, 1
    // for CRC-32, 4 for CRC-64 and 10 for SHA-256.
    sum: u8 = 0
    crc32: u32 = 0
    crc64: u64 = 0
    sha: List<u8>
}

impl Decompressor {
    /// A decompressor for `format`, which fails with `TooLong` once more than `limit` bytes have
    /// come out, as `decompress` does.
    pub fn new(format: Format = Format.Auto, limit: u64 = u64.MAX) -> Decompressor {
        // How many threads there are changes when the output comes, not what it is.
        let workers = u64(unsafe { cx_workers() })
        return Decompressor { format: format, limit: limit, workers: workers, input: [], sizes: [], ctx: [0; CTX], spare: [], window: [], chain: [], tail: [], sha: [] }
    }

    /// Takes the next piece, and gives what it and the pieces before decompress to that hasn't
    /// been given yet, at most `most` bytes. A piece can be any size, even empty. Fails as
    /// `decompress` fails, but for `Truncated`, which only `finish` can tell, and fails the same
    /// way again after that.
    pub fn add(mut self, bytes: List<u8>, most: u64 = u64.MAX) -> List<u8> ! Error {
        var out = List<u8>()
        try self.add_into(bytes, 0, bytes.len(), most, mut out)
        return out
    }

    /// Takes bytes[from..to] as the next piece, as `add` does, and puts what it gives onto the end
    /// of `out`, which can be kept from one call to the next. On an error, `out` is as it was.
    /// Panics unless the range is in `bytes`.
    @track_caller
    pub fn add_into(mut self, bytes: List<u8>, from: usize, to: usize, most: u64, out: mut List<u8>) ! Error {
        if from > to or to > bytes.len() {
            panic("the range {from}..{to} is out of bounds for {bytes.len()} bytes")
        }
        if let e = self.failed {
            fail e
        }
        self.take(bytes, from, to)
        if self.part == ENDED {
            return
        }
        let mark = out.len()
        match self.run(mut out, most, false) {
            ok => return,
            err(e) => {
                out.truncate(mark)
                self.failed = some(e)
                fail e
            }
        }
    }

    /// Whether the last `add` gave all it could from what it has, so it wants the next piece.
    /// It's false when `add` stopped at `most` bytes: then `add` with no bytes gives more.
    pub fn needs_input(self) -> bool {
        return self.hungry
    }

    /// What it was given after the end of the data: after a stream, bytes that aren't another,
    /// which fail before they decompress to anything, as `decompress` stops quietly at them. Empty
    /// until `add` comes to them.
    pub fn unused(self) -> List<u8> {
        if self.part != ENDED {
            return []
        }
        return self.input[self.skip..]
    }

    /// Ends the data: gives all the rest of what it decompresses to, and fails with `Truncated` if
    /// the data ended early, as `decompress` would.
    pub fn finish(own self) -> List<u8> ! Error {
        var out = List<u8>()
        try self.finish_into(mut out)
        return out
    }

    /// Ends the data as `finish` does, putting the rest onto the end of `out`. On an error, `out`
    /// is as it was.
    pub fn finish_into(own self, out: mut List<u8>) ! Error {
        var d = self
        if let e = d.failed {
            fail e
        }
        if d.part != ENDED {
            let mark = out.len()
            match d.run(mut out, u64.MAX, true) {
                ok => {},
                err(e) => {
                    out.truncate(mark)
                    fail e
                },
            }
        }
    }

    // Adds bytes[from..to] to the input, first dropping what's used when that's at least half of it,
    // but for a stream after the first that hasn't made anything yet, which may turn out unused.
    fn take(mut self, bytes: List<u8>, from: usize, to: usize) {
        let drop = if self.later and self.made == self.stream_from and self.stream_at < self.skip { self.stream_at } else { self.skip }
        if drop > 0 and drop >= self.input.len() / 2 {
            let left = self.input.len() - drop
            unsafe {
                _ = memmove(self.input.as_mut_ptr(), self.input.as_ptr().add(drop), left)
                self.input.set_len(left)
            }
            self.skip -= drop
            self.stream_at = if self.stream_at > drop { self.stream_at - drop } else { 0 }
        }
        let at = self.input.len()
        self.input.reserve(to - from)
        unsafe {
            _ = memcpy(self.input.as_mut_ptr().add(at), bytes.as_ptr().add(from), to - from)
            self.input.set_len(at + to - from)
        }
    }

    // Decompresses what it can onto `out`, at most `most` bytes, stopping when it wants more input.
    // With `ending`, the input it has is all there is.
    fn run(mut self, out: mut List<u8>, most: u64, ending: bool) ! Error {
        let start = out.len()
        self.most = most
        loop {
            let room = room_left(most, out.len() - start)
            self.give(mut out, room)
            let after = room_left(most, out.len() - start)
            if after == 0 {
                self.hungry = false
                return
            }
            var moved = false
            match self.step(mut out, after, ending) {
                ok(m) => moved = m,
                err(e) => {
                    // After a stream, bytes that fail before they make anything aren't another,
                    // and `decompress` stops quietly at them, unless they're one cut short.
                    if not self.later or self.made != self.stream_from or e == Error.Truncated or e == Error.TooLong {
                        fail e
                    }
                    self.part = ENDED
                    self.skip = self.stream_at
                }
            }
            if not moved {
                self.hungry = true
                return
            }
        }
    }

    // Takes a step through the data: gives whether it took one, or false when it wants more input.
    fn step(mut self, out: mut List<u8>, room: usize, ending: bool) -> bool ! Error {
        let part = self.part
        if part == AT_STREAM {
            return try self.at_stream(ending)
        }
        if part == AT_BLOCK {
            return try self.at_block(mut out, room, ending)
        }
        if part == IN_BLOCK {
            return try self.in_block(ending)
        }
        if part == AT_CHECK {
            return try self.at_check(ending)
        }
        if part == AT_INDEX {
            return try self.at_index(ending)
        }
        if part == IN_LZMA {
            return try self.in_lzma(ending)
        }
        if part == AT_TRAILER {
            return try self.at_trailer(ending)
        }
        return false
    }

    fn at_stream(mut self, ending: bool) -> bool ! Error {
        if self.skip == self.input.len() {
            if ending and not self.later {
                fail Error.Truncated
            }
            return false
        }
        self.stream_at = self.skip
        self.stream_from = self.made
        match self.start_stream() {
            ok => return true,
            err(e) => {
                if e == Error.Truncated {
                    return try more(ending)
                }
                fail e
            }
        }
    }

    // Reads the header of the stream at `skip`, told apart as `stream` tells them, and sets out to
    // decode it.
    fn start_stream(mut self) ! Error {
        let p = self.skip
        let to = self.input.len()
        var xz_file = self.format == Format.Xz
        var lz = false
        if self.format == Format.Auto {
            xz_file = self.input[p] == 0xFD
            lz = self.input[p] == 0x4C
        }
        if xz_file {
            self.check = try stream_header(self.input, p, to)
            self.sizes.clear()
            self.skip = p + 12
            self.part = AT_BLOCK
            return
        }
        unsafe {
            self.window.set_len(0)
        }
        self.given = 0
        self.filtered = false
        self.block_made = 0
        if lz {
            let h = try lzip_header(self.input, p, to)
            unsafe {
                // lc 3, lp 0, pb 2.
                _ = cx_xz_lzma1_start(self.ctx.as_mut_ptr(), 93, u64(h.dict), UNKNOWN, 0)
            }
            self.size_window(u64(h.dict), UNKNOWN)
            self.version = h.version
            self.member = 6
            self.start_sum(1)
            self.skip = p + 6
            self.part = IN_LZMA
            return
        }
        let h = try alone_header(self.input, p, to, self.format == Format.Auto)
        unsafe {
            _ = cx_xz_lzma1_start(self.ctx.as_mut_ptr(), h.props, u64(h.dict), h.size, 0)
        }
        self.size_window(u64(h.dict), h.size)
        self.version = NOT_LZIP
        self.start_sum(0)
        self.skip = p + 13
        self.part = IN_LZMA
    }

    fn at_block(mut self, out: mut List<u8>, room: usize, ending: bool) -> bool ! Error {
        let p = self.skip
        let to = self.input.len()
        if p >= to {
            return try more(ending)
        }
        if self.input[p] == 0 {
            self.part = AT_INDEX
            return true
        }
        // Blocks with both their sizes in their headers, as `xz -T` writes them, decode at once, so
        // it waits for several. Then those that are here decode straight onto `out`.
        let most = if self.most < AT_ONCE { self.most } else { AT_ONCE }
        if not ending and self.workers > 1 and worth_waiting(self.input, p, to, self.check, self.workers, most) {
            return false
        }
        let mark = out.len()
        let left = self.limit - self.made
        let fits = if u64(room) < left { u64(room) } else { left }
        let cap = if fits > u64.MAX - u64(mark) { u64.MAX } else { u64(mark) + fits }
        let next = blocks_at_once(self.input, p, to, self.check, cap, mut out, mut self.sizes)
        if next != p {
            self.made += u64(out.len() - mark)
            self.skip = next
            return true
        }
        let h = match header(self.input, p, to, self.check) {
            ok(h) => h,
            err(e) => {
                if e == Error.Truncated {
                    return try more(ending)
                }
                fail e
            }
        }
        self.packed = h.packed
        self.unpacked = h.unpacked
        self.head_size = u64(h.size)
        self.used = 0
        self.block_made = 0
        self.skip = h.data
        unsafe {
            self.window.set_len(0)
            cx_xz_lzma2_start(self.ctx.as_mut_ptr(), h.dict, 0)
        }
        self.given = 0
        self.size_window(h.dict, h.unpacked)
        let before = h.filters.len() - 1
        self.filtered = before > 0
        if self.filtered {
            var list = List<u64>()
            for k in 0..before {
                list.push(h.filters[k].id)
                list.push(u64(h.filters[k].arg))
            }
            if self.chain.len() < CHAIN {
                self.chain = [0; CHAIN]
            }
            unsafe {
                cx_xz_chain_start(self.chain.as_mut_ptr(), list.as_ptr(), u32.wrap(before))
                self.tail.set_len(0)
            }
            self.tail_from = 0
            self.tail_at = 0
            self.ready = 0
        }
        let id = self.check
        self.start_sum(id)
        self.part = IN_BLOCK
        return true
    }

    // Decodes the block's LZMA2 chunks that are here. When the header gave the data's size and all
    // the rest of it is here, or there's no more to come, it's `decompress`'s call on the same bytes.
    fn in_block(mut self, ending: bool) -> bool ! Error {
        let avail = self.input.len() - self.skip
        var n = avail
        var partial = not ending
        var bounded = false
        if self.packed != UNKNOWN and self.packed - self.used <= u64(avail) {
            n = usize.wrap(self.packed - self.used)
            partial = false
            bounded = true
        }
        self.make_room()
        let len = self.window.len()
        let free = u64(self.window.capacity() - len)
        let left = self.limit - self.made
        let cap = len + usize.wrap(if left < free { left } else { free })
        var status: i32 = 0
        unsafe {
            cx_xz_resume(self.ctx.as_mut_ptr(), if partial { 1 } else { 0 })
            status = cx_xz_lzma2(self.ctx.as_mut_ptr(), self.input.as_ptr().add(self.skip), n, self.window.as_mut_ptr(), cap)
        }
        self.took(len)
        if status == 0 {
            if (self.packed != UNKNOWN and self.used != self.packed) or (self.unpacked != UNKNOWN and self.block_made != self.unpacked) {
                fail Error.Corrupt
            }
            self.part = AT_CHECK
            return true
        }
        if status == 1 {
            // There's always room for a chunk, so it's the limit.
            if left <= free {
                fail Error.TooLong
            }
            return true
        }
        if status == -3 or (status == -2 and partial) {
            return self.window.len() > len
        }
        if status == -2 and not bounded {
            fail Error.Truncated
        }
        fail Error.Corrupt
    }

    // The block's padding and check, once all it made has gone out.
    fn at_check(mut self, ending: bool) -> bool ! Error {
        let to = self.input.len()
        var r = self.skip
        var at = self.head_size + self.used
        while at % 4 != 0 {
            if r >= to {
                return try more(ending)
            }
            if self.input[r] != 0 {
                fail Error.Corrupt
            }
            r += 1
            at += 1
        }
        let check_len = check_size(self.check)
        if to - r < check_len {
            return try more(ending)
        }
        if not self.check_ok(r) {
            fail Error.Checksum
        }
        self.sizes.push(self.head_size + self.used + u64(check_len))
        self.sizes.push(self.block_made)
        self.skip = r + check_len
        self.part = AT_BLOCK
        return true
    }

    // Whether the check at input[r..] matches what went out of the block.
    fn check_ok(mut self, r: usize) -> bool {
        let id = self.check
        if id == 1 {
            return self.crc32 == u32_le(self.input, r)
        }
        if id == 4 {
            return self.crc64 == u64_le(self.input, r)
        }
        if id == 10 {
            var digest: List<u8> = [0; 64]
            unsafe {
                _ = cx_digest_finish(self.sha.as_mut_ptr(), digest.as_mut_ptr())
            }
            for i in 0usize..32 {
                if digest[i] != self.input[r + i] {
                    return false
                }
            }
        }
        return true
    }

    fn at_index(mut self, ending: bool) -> bool ! Error {
        let p = self.skip
        let to = self.input.len()
        let q = match index(self.input, p, to, self.sizes) {
            ok(q) => q,
            err(e) => {
                if e == Error.Truncated {
                    return try more(ending)
                }
                fail e
            }
        }
        match footer(self.input, q, to, p, self.check) {
            ok => {},
            err(e) => {
                if e == Error.Truncated {
                    return try more(ending)
                }
                fail e
            }
        }
        self.skip = q + 12
        self.part = AT_STREAM
        self.later = true
        return true
    }

    // Decodes .lzma or .lz data. While more may come, the decoder stops short of the input's end,
    // where the next symbol might not all be here yet; then it tries to finish from what's here,
    // going back if that needs more.
    fn in_lzma(mut self, ending: bool) -> bool ! Error {
        self.make_room()
        let len = self.window.len()
        let free = u64(self.window.capacity() - len)
        let left = self.limit - self.made
        let cap = len + usize.wrap(if left < free { left } else { free })
        let made = self.made
        let skip = self.skip
        var status = self.lzma_call(cap, not ending)
        if status == 2 or (status == -2 and not ending) {
            if self.made != made or self.skip != skip {
                return true
            }
            if self.spare.len() < CTX {
                self.spare = [0; CTX]
            }
            unsafe {
                _ = memcpy(self.spare.as_mut_ptr(), self.ctx.as_ptr(), CTX)
            }
            let member = self.member
            let block_made = self.block_made
            status = self.lzma_call(cap, false)
            if status == -2 {
                unsafe {
                    _ = memcpy(self.ctx.as_mut_ptr(), self.spare.as_ptr(), CTX)
                    self.window.set_len(len)
                }
                self.made = made
                self.skip = skip
                self.member = member
                self.block_made = block_made
                return false
            }
        }
        if status == 0 {
            if self.version == NOT_LZIP {
                self.part = AT_STREAM
                self.later = true
            } else {
                self.part = AT_TRAILER
            }
            return true
        }
        if status == 1 {
            if left <= free {
                fail Error.TooLong
            }
            return true
        }
        if status == -2 {
            fail Error.Truncated
        }
        fail Error.Corrupt
    }

    // Runs the LZMA decoder on the input from `skip` into the window, as far as `cap`, and takes in
    // what it used and made. `partial` says more input may come.
    fn lzma_call(mut self, cap: usize, partial: bool) -> i32 {
        let len = self.window.len()
        var status: i32 = 0
        unsafe {
            cx_xz_resume(self.ctx.as_mut_ptr(), if partial { 1 } else { 0 })
            status = cx_xz_lzma1(self.ctx.as_mut_ptr(), self.input.as_ptr().add(self.skip), self.input.len() - self.skip, self.window.as_mut_ptr(), cap)
        }
        self.took(len)
        return status
    }

    fn at_trailer(mut self, ending: bool) -> bool ! Error {
        match lzip_trailer(self.input, self.skip, self.input.len(), self.version, self.crc32, self.block_made, self.member) {
            ok(next) => {
                self.skip = next
                self.part = AT_STREAM
                self.later = true
                return true
            },
            err(e) => {
                if e == Error.Truncated {
                    return try more(ending)
                }
                fail e
            }
        }
    }

    // Takes in what the decoder made since the window was `len` long, and the input it used.
    fn took(mut self, len: usize) {
        let now = unsafe { cx_xz_len(self.ctx.as_ptr()) }
        let used = unsafe { cx_xz_used(self.ctx.as_ptr()) }
        unsafe {
            self.window.set_len(now)
        }
        self.made += u64(now - len)
        self.block_made += u64(now - len)
        self.skip += used
        self.used += u64(used)
        self.member += u64(used)
    }

    // Gives the empty window room for three dictionaries and a chunk, or for all the text if that's
    // less, so that it seldom slides and moves little when it does: up to 64 MiB to start with,
    // and more as it's needed.
    fn size_window(mut self, dict: u64, text: u64) {
        var want = 3 * dict
        if text < want {
            want = text
        }
        if want > 67108864 {
            want = 67108864
        }
        let need = usize.wrap(want) + ROOM
        if self.window.capacity() < need {
            self.window.reserve(need)
        }
    }

    // Makes ROOM free at the end of the window, by sliding what's still needed to the front, and
    // growing it to twice that, so a slide moves no more than comes out between slides.
    fn make_room(mut self) {
        let len = self.window.len()
        if self.window.capacity() - len >= ROOM {
            return
        }
        let shift = unsafe { cx_xz_slide(self.ctx.as_mut_ptr(), self.window.as_mut_ptr(), self.given) }
        self.given -= shift
        let kept = len - shift
        unsafe {
            self.window.set_len(kept)
        }
        if self.window.capacity() < 2 * kept + ROOM {
            self.window.reserve(kept + ROOM)
        }
    }

    // Gives out what's decoded and through the filters, at most `room` bytes.
    fn give(mut self, out: mut List<u8>, room: usize) {
        if not self.filtered {
            let n = if self.window.len() - self.given < room { self.window.len() - self.given } else { room }
            if n > 0 {
                let at = self.given
                self.emit(false, at, n, mut out)
                self.given += n
            }
            return
        }
        let fresh = self.window.len() - self.given
        let last = self.part == AT_CHECK
        if fresh > 0 or (last and self.ready < self.tail.len() - self.tail_from) {
            // What's left of the tail to the front, then what LZMA2 made onto it.
            let keep = self.tail.len() - self.tail_from
            unsafe {
                _ = memmove(self.tail.as_mut_ptr(), self.tail.as_ptr().add(self.tail_from), keep)
                self.tail.set_len(keep)
            }
            self.tail_at += u64(self.tail_from)
            self.tail_from = 0
            self.tail.reserve(fresh)
            unsafe {
                _ = memcpy(self.tail.as_mut_ptr().add(keep), self.window.as_ptr().add(self.given), fresh)
                self.tail.set_len(keep + fresh)
            }
            self.given += fresh
            self.ready = unsafe { cx_xz_chain(self.chain.as_mut_ptr(), self.tail.as_mut_ptr(), self.tail.len(), self.tail_at, if last { 1 } else { 0 }) }
        }
        let n = if self.ready < room { self.ready } else { room }
        if n > 0 {
            let at = self.tail_from
            self.emit(true, at, n, mut out)
            self.tail_from += n
            self.ready -= n
        }
    }

    // Puts n bytes from the window or the tail, from `from`, onto `out`, and into the check.
    fn emit(mut self, from_tail: bool, from: usize, n: usize, out: mut List<u8>) {
        let at = out.len()
        out.reserve(n)
        unsafe {
            let p = if from_tail { self.tail.as_ptr().add(from) } else { self.window.as_ptr().add(from) }
            _ = memcpy(out.as_mut_ptr().add(at), p, n)
            out.set_len(at + n)
            let q = out.as_ptr().add(at)
            if self.sum == 1 {
                self.crc32 = cx_zlib_crc32(self.crc32, q, n)
            } else if self.sum == 4 {
                self.crc64 = cx_xz_crc64(self.crc64, q, n)
            } else if self.sum == 10 {
                cx_digest_add(self.sha.as_mut_ptr(), q, n)
            }
        }
    }

    // Starts the check of what goes out of a block or member.
    fn start_sum(mut self, id: u8) {
        self.sum = id
        self.crc32 = 0
        self.crc64 = 0
        if id == 10 {
            if self.sha.len() < DIGEST {
                self.sha = [0; DIGEST]
            }
            unsafe {
                cx_digest_start(self.sha.as_mut_ptr(), 2)
            }
        }
    }
}

// What's left of `most` once `given` bytes have gone out, as a length.
fn room_left(most: u64, given: usize) -> usize {
    return usize.wrap(most - u64(given))
}

// Whether a Decompressor at the block at `p` should wait for more input before it decodes: while
// the blocks from there on have both their sizes, and fewer than `workers` of them are here, which
// decompress to no more than `most` and take no more than that of input, with the next to come.
fn worth_waiting(bytes: List<u8>, p: usize, to: usize, check: u8, workers: u64, most: u64) -> bool {
    let check_len = u64(check_size(check))
    var q = p
    var k: u64 = 0
    var total: u64 = 0
    loop {
        if k >= workers {
            return false
        }
        if q >= to {
            return true
        }
        if bytes[q] == 0 {
            return false
        }
        if to - q < (usize(bytes[q]) + 1) * 4 {
            return true
        }
        let h = match header(bytes, q, to, check) {
            ok(h) => h,
            err(_) => return false,
        }
        let before = u64(h.data - p)
        if h.packed == UNKNOWN or h.unpacked == UNKNOWN or h.unpacked > most - total or before > most or h.packed > most - before {
            return false
        }
        // The data, its padding to 4 bytes from the block's start, and the check.
        let data_end = u64(h.data) + h.packed
        let next = data_end + (4 - (data_end - u64(q)) % 4) % 4 + check_len
        if next > u64(to) {
            return true
        }
        k += 1
        total += h.unpacked
        q = usize.wrap(next)
    }
}

// Where a Decompressor wants more input: none comes once it's ending, so the data ended early.
fn more(ending: bool) -> bool ! Error {
    if ending {
        fail Error.Truncated
    }
    return false
}

/// Text compressed as it comes, a piece at a time, into the same .xz file `compress` writes for all
/// of it at once, as Python's `LZMACompressor` takes it. It holds the text until a few blocks of it
/// are in, as many as there are processors, up to 64 MiB, then compresses them at once and gives
/// them out. A .lzma file has no blocks, so for `Format.Alone` it holds all the text until `finish`.
pub struct Compressor {
    s: Settings
    id: u8
    each: u64
    lzma: bool
    preset: u32
    check: Check
    extreme: bool
    block_size: u64
    // How many blocks it compresses at once.
    batch: u64
    // The text it hasn't compressed yet, and the index's records so far.
    text: List<u8>
    records: List<u8>
    blocks: u64 = 0
    started: bool = false
}

impl Compressor {
    /// A compressor with `compress`'s settings. Panics as `compress` does, for a preset past 9 or
    /// for `Format.Auto`.
    @track_caller
    pub fn new(preset: u32 = 6, check: Check = Check.Crc64, format: Format = Format.Xz, extreme: bool = false, block_size: u64 = 0) -> Compressor {
        if preset > 9 {
            panic("the preset is 0 to 9, not {preset}")
        }
        if format == Format.Auto {
            panic("`Compressor` writes `Format.Xz` or `Format.Alone`, not `Format.Auto`")
        }
        let s = preset_settings(preset, extreme)
        var each = block_size
        if each == 0 {
            each = if 3 * s.dict > 1048576 { 3 * s.dict } else { 1048576 }
        }
        // The blocks are cut by size, so how many go at once changes when they come out, not what.
        let workers = u64(unsafe { cx_workers() })
        var batch = 67108864 / each
        if batch > workers {
            batch = workers
        }
        if batch == 0 {
            batch = 1
        }
        return Compressor { s: s, id: check_id(check), each: each, lzma: format == Format.Alone, preset: preset, check: check, extreme: extreme, block_size: block_size, batch: batch, text: [], records: [] }
    }

    /// Takes the next piece of text, and gives what's compressed so far that it hasn't given: the
    /// stream's header the first time, then blocks as they fill.
    pub fn add(mut self, bytes: List<u8>) -> List<u8> {
        var out = List<u8>()
        if not self.lzma and not self.started {
            put_stream_header(self.id, mut out)
            self.started = true
        }
        self.text.extend(bytes)
        if not self.lzma and u64(self.text.len()) >= self.batch * self.each {
            let full = u64(self.text.len()) / self.each
            self.put_blocks(full, mut out)
        }
        return out
    }

    /// Compresses the rest of the text, and gives it with the end of the file.
    pub fn finish(own self) -> List<u8> {
        var c = self
        if c.lzma {
            return compress(c.text, c.preset, c.check, Format.Alone, c.extreme, c.block_size)
        }
        var out = List<u8>()
        if not c.started {
            put_stream_header(c.id, mut out)
        }
        let n = u64(c.text.len())
        if n > 0 {
            let count = unsafe { cx_xze_blocks(n, c.each) }
            c.put_blocks(count, mut out)
        }
        put_index(c.records, c.blocks, c.id, mut out)
        return out
    }

    // Compresses the text's first `count` blocks, every one whole but the last, onto `out`, and
    // drops them from the text.
    fn put_blocks(mut self, count: u64, out: mut List<u8>) {
        let all = u64(self.text.len())
        let n = if count * self.each < all { count * self.each } else { all }
        let s = self.s
        let opt: List<u64> = [s.dict, 3, 0, 2, if s.fast { 1 } else { 0 }, s.nice, if s.bt { 1 } else { 0 }, s.depth, self.each, 0, 0, 0]
        var sizes: List<u64> = [0; usize.wrap(count)]
        let h = unsafe { cx_xze_start(self.text.as_ptr(), n, opt.as_ptr(), sizes.as_mut_ptr()) }
        for b in 0u64..count {
            let from = b * self.each
            let len = if n - from < self.each { n - from } else { self.each }
            put_block(h, b, sizes[usize.wrap(b)], self.text, usize.wrap(from), len, s.dict, self.id, mut out, mut self.records)
        }
        unsafe {
            cx_xze_end(h)
        }
        self.blocks += count
        let left = self.text.len() - usize.wrap(n)
        unsafe {
            _ = memmove(self.text.as_mut_ptr(), self.text.as_ptr().add(usize.wrap(n)), left)
            self.text.set_len(left)
        }
    }
}

// --- bytes -------------------------------------------------------------------------------------

fn crc32(bytes: List<u8>, from: usize, to: usize) -> u32 {
    return unsafe { cx_zlib_crc32(0, bytes.as_ptr().add(from), to - from) }
}
