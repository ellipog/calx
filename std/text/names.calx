// The tables are in DATA, the bytes of names.bin, and numbers in them are written in base
// 256, a byte to a digit.
/// What an entry is: a rune's name, an alias, or a name Java gives a control character.
pub const NAME: u32 = 1
pub const ALIAS: u32 = 2
pub const JAVA: u32 = 4
/// How many entries and words there are, how many entries go between two written whole, how many
/// places between two in PLACES_AT, and how many words between two in WORD_AT.
pub const ENTRIES: usize = 33550
pub const WORDS: usize = 11805
pub const CHECK: usize = 8
pub const PLACE_CHECK: usize = 16
pub const WORD_STEP: usize = 4
pub const KEY: usize = 16
/// How many runs of named runes there are in RUNS, and named sequences in SEQ_TEXT.
pub const RUN_COUNT: usize = 716
pub const SEQUENCES: usize = 461
/// The digits a number takes: 1 below A, 2 below A + B * 256, 3 below that and C * 256^2, and 4 past it.
pub const WORD_A: u32 = 209
pub const WORD_B: u32 = 45
pub const WORD_C: u32 = 1

pub const CODE_A: u32 = 178
pub const CODE_B: u32 = 45
pub const CODE_C: u32 = 32

pub const PLACE_A: u32 = 129
pub const PLACE_B: u32 = 125
pub const PLACE_C: u32 = 1

/// The tables below, a byte to a digit.
pub const DATA: [u8; 420932] = embed("names.bin")

/// The words names are made of, most used first, one after the other, `_` for a space. It starts here in DATA.
pub const WORD_TEXT: usize = 0

/// Each word's length, in one digit. It starts here in DATA.
pub const WORD_LEN: usize = 59813

/// Where each WORD_STEPth word starts in WORD_TEXT, in three digits. It starts here in DATA.
pub const WORD_AT: usize = 71618

/// The entries, in order of their names: the words shared with the one before and the new ones, in one digit, or a 90 and one digit each, the new words' numbers, then the rune, as its difference from the one before's, zigzagged, times 8, with what the entry is. Every CHECKth is whole. It starts here in DATA.
pub const STREAM: usize = 80474

/// Where each CHECKth entry starts in STREAM, in three digits. It starts here in DATA.
pub const STREAM_AT: usize = 267876

/// The first KEY bytes of each CHECKth entry's name, `~` past its end. It starts here in DATA.
pub const KEYS: usize = 280458

/// For each rune with a name or a Java name, in order, its entry, as its difference from the one before's, zigzagged. Every PLACE_CHECKth is whole. It starts here in DATA.
pub const PLACES: usize = 347562

/// Where each PLACE_CHECKth number starts in PLACES, in three digits. It starts here in DATA.
pub const PLACES_AT: usize = 391251

/// The runs of runes with a name or a Java name, RUN_COUNT of them, nine digits each: the first rune, how many runes the run has, and the first rune's number in PLACES, in three digits each. It starts here in DATA.
pub const RUNS: usize = 397464

/// The named sequences' names, in order, one after the other. It starts here in DATA.
pub const SEQ_TEXT: usize = 403908

/// Where each named sequence's name starts in SEQ_TEXT, and after the last, where they end, in three digits. It starts here in DATA.
pub const SEQ_AT: usize = 415244

/// Each named sequence's runes, in three digits each. It starts here in DATA.
pub const SEQ_RUNES: usize = 416630

/// Where each named sequence's runes start in SEQ_RUNES, and after the last, where they end, in three digits. It starts here in DATA.
pub const SEQ_RUNES_AT: usize = 419546

/// The first rune of each family of names made from a rune's number, such as `CJK COMPATIBILITY IDEOGRAPH-F900`.
pub const FAMILY_LO: [u32; 11] = [
    0xF900, 0xFA70, 0xFE00, 0x13460, 0x18800, 0x18B00, 0x1B170, 0x1D200,
    0x1F0E1, 0x2F800, 0xE0100,
]

/// The last rune of each family.
pub const FAMILY_HI: [u32; 11] = [
    0xFA6D, 0xFAD9, 0xFE0F, 0x143FA, 0x18AFF, 0x18CD5, 0x1B2FB, 0x1D217,
    0x1F0F5, 0x2FA1D, 0xE01EF,
]

/// 0 for a family named by the rune's number in hex, or else how many digits its decimal count has at least.
pub const FAMILY_DIGITS: [u32; 11] = [
    0x0, 0x0, 0x1, 0x0, 0x3, 0x0, 0x0, 0x1,
    0x1, 0x0, 0x1,
]

/// The count at the family's first rune.
pub const FAMILY_BASE: [u32; 11] = [
    0x0, 0x0, 0x1, 0x0, 0x1, 0x0, 0x0, 0x1,
    0x1, 0x0, 0x11,
]

