/// The runes in a block of the two stages.
pub const BLOCK: usize = 128

/// For each block of runes, where its records' numbers start in STAGE2, in blocks.
pub const STAGE1: [u16; 8704] = embed("normal/stage1.bin")

/// Each rune's record, by blocks.
pub const STAGE2: [u16; 22272] = embed("normal/stage2.bin")

/// For each block, the forms in which every rune of it has class 0 and passes the quick check: 1 NFD, 2 NFKD, 4 NFC, 8 NFKC.
pub const EASY: [u8; 8704] = embed("normal/easy.bin")

/// Each record's canonical combining class.
pub const CCC: [u8; 3887] = embed("normal/ccc.bin")

/// Each record's quick checks: 1 not in NFD, 2 not in NFKD, 4 not in NFC, 8 maybe in NFC, 16 not in NFKC, 32 maybe in NFKC.
pub const QC: [u8; 3887] = embed("normal/qc.bin")

/// Where each record's full canonical decomposition is in POOL.
pub const CANON_AT: [u16; 3887] = embed("normal/canon_at.bin")

/// Its length, 0 if the rune has none.
pub const CANON_LEN: [u8; 3887] = embed("normal/canon_len.bin")

/// Where each record's full compatibility decomposition is in POOL.
pub const COMPAT_AT: [u16; 3887] = embed("normal/compat_at.bin")

/// Its length, 0 if the rune has none.
pub const COMPAT_LEN: [u8; 3887] = embed("normal/compat_len.bin")

/// The decompositions' runes.
pub const POOL: [u32; 6764] = embed("normal/pool.bin")

/// The pairs that compose, by `pair_slot` in std/unicode.calx, each in its slot or the next free
/// one after it: the first rune, 0 for a free slot, the second, and what they compose to. Every
/// pair is found within 10 tries.
/// The first runes.
pub const PAIR_FIRST: [u32; 2048] = embed("normal/pair_first.bin")

/// The second runes.
pub const PAIR_SECOND: [u32; 2048] = embed("normal/pair_second.bin")

/// What they compose to.
pub const PAIR_RESULT: [u32; 2048] = embed("normal/pair_result.bin")
