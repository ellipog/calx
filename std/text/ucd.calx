/// `\s`'s runes, White_Space, as ranges.
pub const SPACE: [u32; 20] = [
    0x9, 0xD, 0x20, 0x20, 0x85, 0x85, 0xA0, 0xA0,
    0x1680, 0x1680, 0x2000, 0x200A, 0x2028, 0x2029, 0x202F, 0x202F,
    0x205F, 0x205F, 0x3000, 0x3000,
]
/// How many numbers `SPACE` holds.
pub const SPACE_LEN: usize = 20

/// The runes Python's `str.isalnum` is true for, the letters and those with a numeric value, as ranges.
pub const ALNUM: [u32; 1540] = embed("ucd/alnum.bin")
/// How many numbers `ALNUM` holds.
pub const ALNUM_LEN: usize = 1540

/// Each rune that case folding puts with others, in order.
pub const FOLD_FROM: [u32; 2932] = embed("ucd/fold_from.bin")
/// How many numbers `FOLD_FROM` holds.
pub const FOLD_FROM_LEN: usize = 2932

/// The next rune in `FOLD_FROM[i]`'s orbit: the smallest past it, or else the smallest.
pub const FOLD_NEXT: [u32; 2932] = embed("ucd/fold_next.bin")
/// How many numbers `FOLD_NEXT` holds.
pub const FOLD_NEXT_LEN: usize = 2932

/// Each rune Python's `re` lowers to another, in order.
pub const PY_LOWER_FROM: [u32; 1460] = embed("ucd/py_lower_from.bin")
/// How many numbers `PY_LOWER_FROM` holds.
pub const PY_LOWER_FROM_LEN: usize = 1460

/// The rune `PY_LOWER_FROM[i]` lowers to.
pub const PY_LOWER_TO: [u32; 1460] = embed("ucd/py_lower_to.bin")
/// How many numbers `PY_LOWER_TO` holds.
pub const PY_LOWER_TO_LEN: usize = 1460

/// Each rune Python's `re` uppers to another, in order.
pub const PY_UPPER_FROM: [u32; 1552] = embed("ucd/py_upper_from.bin")
/// How many numbers `PY_UPPER_FROM` holds.
pub const PY_UPPER_FROM_LEN: usize = 1552

/// The rune `PY_UPPER_FROM[i]` uppers to.
pub const PY_UPPER_TO: [u32; 1552] = embed("ucd/py_upper_to.bin")
/// How many numbers `PY_UPPER_TO` holds.
pub const PY_UPPER_TO_LEN: usize = 1552

/// The runes Python's `str.isspace` is true for, as ranges.
pub const PY_SPACE: [u32; 20] = [
    0x9, 0xD, 0x1C, 0x20, 0x85, 0x85, 0xA0, 0xA0,
    0x1680, 0x1680, 0x2000, 0x200A, 0x2028, 0x2029, 0x202F, 0x202F,
    0x205F, 0x205F, 0x3000, 0x3000,
]
/// How many numbers `PY_SPACE` holds.
pub const PY_SPACE_LEN: usize = 20

/// The runes Python's `str.isprintable` is true for, as ranges.
pub const PY_PRINT: [u32; 1472] = embed("ucd/py_print.bin")
/// How many numbers `PY_PRINT` holds.
pub const PY_PRINT_LEN: usize = 1472

/// The runes that are Cased, as ranges.
pub const PY_CASED: [u32; 318] = embed("ucd/py_cased.bin")
/// How many numbers `PY_CASED` holds.
pub const PY_CASED_LEN: usize = 318

/// The runes that are Case_Ignorable, as ranges.
pub const PY_CASE_IGNORABLE: [u32; 904] = embed("ucd/py_case_ignorable.bin")
/// How many numbers `PY_CASE_IGNORABLE` holds.
pub const PY_CASE_IGNORABLE_LEN: usize = 904

/// The runes up to U+FFFF Java's `Character.isAlphabetic` or `isDigit` is true for, as ranges.
pub const JAVA_ALNUM: [u32; 872] = embed("ucd/java_alnum.bin")
/// How many numbers `JAVA_ALNUM` holds.
pub const JAVA_ALNUM_LEN: usize = 872
