/// Python's `repr` of strings and floats, written as CPython 3.14 writes them, for messages that
/// quote values as Python would: `Regex.python`'s errors and std.json.schema's.
module std.text.python

import std.text.ucd.{PY_PRINT, PY_PRINT_LEN, PY_SPACE, PY_SPACE_LEN}

/// Whether Python's `str.isspace` is true for `r`: what `strip`, `split()` and `re`'s `\s` take
/// as white space.
pub fn is_space(r: u32) -> bool {
    if r < 0x80 {
        return r == 32 or (r >= 9 and r <= 13) or (r >= 0x1C and r <= 0x1F)
    }
    var lo: usize = 0
    var hi = PY_SPACE_LEN / 2
    while lo < hi {
        let mid = (lo + hi) / 2
        if r > PY_SPACE[2 * mid + 1] {
            lo = mid + 1
        } else if r < PY_SPACE[2 * mid] {
            hi = mid
        } else {
            return true
        }
    }
    return false
}

/// Whether Python's `str.isprintable` is true for `r`, so that `repr` keeps it as it is.
pub fn is_printable(r: u32) -> bool {
    if r < 0x7F {
        return r >= 0x20
    }
    var lo: usize = 0
    var hi = PY_PRINT_LEN / 2
    while lo < hi {
        let mid = (lo + hi) / 2
        if r > PY_PRINT[2 * mid + 1] {
            lo = mid + 1
        } else if r < PY_PRINT[2 * mid] {
            hi = mid
        } else {
            return true
        }
    }
    return false
}

const HEX: str = "0123456789abcdef"

fn push_hex(out: mut String, v: u32, digits: u32) {
    var shift = digits * 4
    while shift > 0 {
        shift -= 4
        out.push(rune(HEX.byte_at(usize((v >> shift) & 15))))
    }
}

/// `s` as Python's `repr` writes a string: in single quotes, or double ones when it has a `'`
/// and no `"`; with `\\`, `\n`, `\r`, `\t` and the quote escaped; and each rune Python doesn't
/// print as `\xhh`, `\uhhhh` or `\Uhhhhhhhh`.
pub fn repr_str(s: String) -> String {
    var out = String()
    repr_str_into(mut out, s)
    return out
}

/// Adds `repr_str(s)` to `out`.
pub fn repr_str_into(out: mut String, s: String) {
    let double = s.contains("'") and not s.contains("\"")
    let quote: u32 = if double { 34 } else { 39 }
    out.push(if double { '"' } else { '\'' })
    for r in s.runes() {
        let c = u32(r)
        if c == quote or c == 92 {
            out.push('\\')
            out.push(r)
        } else if c == 9 {
            out.push_str("\\t")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c == 13 {
            out.push_str("\\r")
        } else if c < 0x20 or c == 0x7F {
            out.push_str("\\x")
            push_hex(mut out, c, 2)
        } else if c < 0x7F or is_printable(c) {
            out.push(r)
        } else if c <= 0xFF {
            out.push_str("\\x")
            push_hex(mut out, c, 2)
        } else if c <= 0xFFFF {
            out.push_str("\\u")
            push_hex(mut out, c, 4)
        } else {
            out.push_str("\\U")
            push_hex(mut out, c, 8)
        }
    }
    out.push(if double { '"' } else { '\'' })
}

/// `f` as Python's `repr` writes a float: the shortest digits that read back, with `.0` on a
/// whole number, and an exponent from 1e16 up and below 1e-4: `1e+16`, `1.5e-05`; `inf`, `-inf`
/// and `nan`.
pub fn repr_float(f: f64) -> String {
    var out = String()
    repr_float_into(mut out, f)
    return out
}

/// Adds `repr_float(f)` to `out`.
pub fn repr_float_into(out: mut String, f: f64) {
    if f.is_nan() {
        out.push_str("nan")
        return
    }
    if f == f64.INFINITY {
        out.push_str("inf")
        return
    }
    if f == -f64.INFINITY {
        out.push_str("-inf")
        return
    }
    // `{f:e}` writes the shortest digits that read back, as Python's `repr` picks them: `1.5e3`.
    let sci = "{f:e}"
    var i: usize = 0
    if sci.byte_at(0) == b'-' {
        out.push('-')
        i = 1
    }
    var digits = String()
    while i < sci.len() and sci.byte_at(i) != b'e' {
        if sci.byte_at(i) != b'.' {
            digits.push(rune(sci.byte_at(i)))
        }
        i += 1
    }
    i += 1
    var exp: i32 = 0
    var negative = false
    if i < sci.len() and sci.byte_at(i) == b'-' {
        negative = true
        i += 1
    }
    while i < sci.len() {
        exp = exp * 10 + i32(sci.byte_at(i) - b'0')
        i += 1
    }
    if negative {
        exp = -exp
    }
    if digits == "0" {
        out.push_str("0.0")
        return
    }
    if exp >= -4 and exp < 16 {
        if exp < 0 {
            out.push_str("0.")
            for _ in 0..usize.wrap(-exp - 1) {
                out.push('0')
            }
            out.push_str(digits)
            return
        }
        let whole = usize.wrap(exp + 1)
        if digits.len() <= whole {
            out.push_str(digits)
            for _ in digits.len()..whole {
                out.push('0')
            }
            out.push_str(".0")
            return
        }
        out.push_str(digits[..whole])
        out.push('.')
        out.push_str(digits[whole..])
        return
    }
    out.push(rune(digits.byte_at(0)))
    if digits.len() > 1 {
        out.push('.')
        out.push_str(digits[1..])
    }
    out.push_str(if exp < 0 { "e-" } else { "e+" })
    let a = if exp < 0 { -exp } else { exp }
    if a < 10 {
        out.push('0')
    }
    out.push_str("{a}")
}
