/// HTTP and HTTPS requests, on the system's own client, so certificates are checked as the system
/// checks them: WinHTTP on Windows, and libcurl on Linux (D118).
///
/// A request runs on a thread of its own, and `done` says when it has finished, so a server's loop
/// goes on while it waits, as vanilla's login waits for Mojang's session server on a thread of its
/// own.
module std.http

extern "C" {
    fn cx_http_start(post: bool, url: *const u8, url_len: usize, head: *const u8, head_len: usize, body: *const u8, body_len: usize, timeout_ms: u32, limit: usize) -> u64
    fn cx_http_done(h: u64) -> i32
    fn cx_http_wait(h: u64) -> i32
    fn cx_http_code(h: u64) -> i32
    fn cx_http_status(h: u64) -> u32
    fn cx_http_head_len(h: u64) -> usize
    fn cx_http_head(h: u64, out: *u8)
    fn cx_http_body_len(h: u64) -> usize
    fn cx_http_body(h: u64, out: *u8)
    fn cx_http_free(h: u64)
    fn cx_http_received(h: u64) -> u64
    fn cx_http_expected(h: u64) -> u64
    fn cx_crypto_random(p: *u8, n: usize)
}

/// A header line of a request or a response.
pub struct Header {
    pub name: String,
    pub value: String,
}

/// Why a request got no response.
pub enum Error {
    /// The URL isn't `http://` or `https://`, a host, and an optional port and path, in printable
    /// ASCII.
    BadUrl
    /// No name server knows the host.
    Resolve
    /// Nothing answered at the host and port.
    Connect
    /// The TLS handshake failed, or the system doesn't trust the server's certificate.
    Tls
    /// The response didn't come within the time.
    Timeout
    /// The server closed the connection early, or what it sent isn't HTTP.
    Protocol
    /// The body is longer than the limit.
    TooLong
    /// There's no HTTP client on the system: on Linux, libcurl isn't installed.
    Unavailable
    /// Something else, with the system's error code: libcurl's on Linux.
    Os(i32)
}

/// What went wrong, in words: `timed out`, `can't find the host`, or `system error 7` with
/// the system's code.
impl Display for Error {
    fn show(self) {
        match self {
            BadUrl => print("not a valid URL"),
            Resolve => print("can't find the host"),
            Connect => print("can't connect: nothing answered at the host and port"),
            Tls => print("the TLS handshake failed"),
            Timeout => print("timed out"),
            Protocol => print("the response ended early, or isn't HTTP"),
            TooLong => print("the body is longer than the limit"),
            Unavailable => print("there's no HTTP client on this system; on Linux, install libcurl"),
            Os(code) => print("system error {code}"),
        }
    }
}

/// What the server answered.
pub struct Response {
    /// The status code, such as 200, or 204 when Mojang's session server says a player hasn't
    /// joined.
    pub status: u32,
    /// The header lines, in the order they came, their values trimmed.
    pub headers: List<Header>,
    pub body: List<u8>,
}

impl Response {
    /// The value of the first header named `name`, compared without regard to case, as HTTP
    /// compares header names.
    pub fn header(self, name: String) -> String? {
        let want = name.to_lower_root()
        for h in self.headers {
            if h.name.to_lower_root() == want {
                return some(h.value.copy())
            }
        }
        return none
    }
}

/// How far a request's response has come: what a download's progress bar shows.
pub struct Progress {
    /// The bytes of the body that have come so far.
    pub received: u64,
    /// The body's length in all, if the server said, in its Content-Length header.
    pub total: u64?,
}

/// A request that's running, or finished and waiting to be taken.
pub struct Request {
    handle: u64,
}

impl Request {
    /// Whether it has finished, so that `wait` won't wait.
    pub fn done(self) -> bool {
        return self.handle == 0 or unsafe { cx_http_done(self.handle) } != 0
    }

    /// How much of the body has come so far, and how long it is in all if the server said, which
    /// a program draws as a progress bar while it waits:
    ///
    /// ```
    /// var r = get(url, [], 600000, 1 << 30)
    /// while not r.done() {
    ///     let p = r.progress()
    ///     ...
    /// }
    /// ```
    ///
    /// Nothing has come until the response's headers have. Once the response is taken, by `wait`,
    /// it's 0 of an unknown length.
    pub fn progress(self) -> Progress {
        if self.handle == 0 {
            return Progress { received: 0, total: none }
        }
        let expected = unsafe { cx_http_expected(self.handle) }
        let total: u64? = if expected == 0 { none } else { some(expected - 1) }
        return Progress { received: unsafe { cx_http_received(self.handle) }, total: total }
    }

    /// Waits for it to finish, and gives the response. Panics if the response was taken already,
    /// by this request or a copy of it.
    @track_caller
    pub fn wait(mut self) -> Response ! Error {
        let h = self.handle
        let kind = if h == 0 { -1 } else { unsafe { cx_http_wait(h) } }
        if kind < 0 {
            panic("the request's response was taken already")
        }
        self.handle = 0
        if kind != 0 {
            let code = unsafe { cx_http_code(h) }
            unsafe { cx_http_free(h) }
            fail match kind {
                1 => Error.BadUrl,
                2 => Error.Resolve,
                3 => Error.Connect,
                4 => Error.Tls,
                5 => Error.Timeout,
                6 => Error.Protocol,
                7 => Error.TooLong,
                8 => Error.Unavailable,
                _ => Error.Os(code),
            }
        }
        var head = List<u8>()
        var body = List<u8>()
        var status: u32 = 0
        unsafe {
            let hn = cx_http_head_len(h)
            head.reserve(hn)
            cx_http_head(h, head.as_mut_ptr())
            head.set_len(hn)
            let bn = cx_http_body_len(h)
            body.reserve(bn)
            cx_http_body(h, body.as_mut_ptr())
            body.set_len(bn)
            status = cx_http_status(h)
            cx_http_free(h)
        }
        return Response { status: status, headers: header_list(String.from_utf8(head) ?? String()), body: body }
    }
}

// The runtime's header lines, each "name:value\r\n".
fn header_list(text: String) -> List<Header> {
    var out = List<Header>()
    var at: usize = 0
    while at < text.len() {
        let rest = text[at..]
        let end = rest.find("\r\n") ?? rest.len()
        let line = rest[..end]
        let colon = line.find(":") ?? 0
        out.push(Header { name: line[..colon], value: line[colon + 1..] })
        at += end + 2
    }
    return out
}

// Whether the byte can be in a header's name: RFC 9110's token.
fn token_byte(b: u8) -> bool {
    if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) {
        return true
    }
    let marks = "!#$%&'*+-.^_`|~"
    for i in 0..marks.len() {
        if marks.byte_at(i) == b {
            return true
        }
    }
    return false
}

@track_caller
fn header_lines(headers: List<Header>) -> String {
    var s = String()
    for h in headers {
        if h.name.is_empty() {
            panic("a header's name is empty")
        }
        for i in 0..h.name.len() {
            if not token_byte(h.name.byte_at(i)) {
                panic("the header name {h.name} has a byte HTTP doesn't allow in names")
            }
        }
        let lower = h.name.to_lower_root()
        if lower == "host" or lower == "content-length" or lower == "transfer-encoding" or lower == "connection" {
            panic("std.http sets the {h.name} header itself")
        }
        for i in 0..h.value.len() {
            let b = h.value.byte_at(i)
            if b == 13 or b == 10 or b == 0 {
                panic("the value of the header {h.name} has a line break or a zero byte")
            }
        }
        s.push_str(h.name)
        s.push_str(": ")
        s.push_str(h.value)
        s.push_str("\r\n")
    }
    return s
}

@track_caller
fn start(is_post: bool, url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32, limit: usize) -> Request {
    if timeout_ms == 0 {
        panic("a request's timeout is at least 1 ms")
    }
    let head = header_lines(headers)
    let h = unsafe { cx_http_start(is_post, url.as_ptr(), url.len(), head.as_ptr(), head.len(), body.as_ptr(), body.len(), timeout_ms, limit) }
    return Request { handle: h }
}

/// Starts a GET of `url` with the header lines, which may take `timeout_ms` milliseconds in all
/// and give a body of at most `limit` bytes. Panics if the timeout is 0, or a header's name isn't
/// a token, its value has a line break, or it's one std.http sets itself: Host, Content-Length,
/// Transfer-Encoding or Connection.
@track_caller
pub fn get(url: String, headers: List<Header>, timeout_ms: u32, limit: usize) -> Request {
    return start(false, url, headers, List<u8>(), timeout_ms, limit)
}

/// Starts a POST of `body` to `url`, as `get` does. Give a Content-Type header for the body.
@track_caller
pub fn post(url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32, limit: usize) -> Request {
    return start(true, url, headers, body, timeout_ms, limit)
}

/// A `multipart/form-data` body (RFC 7578): text fields and files, as an HTML form with a file
/// input sends them, and as Python's requests sends `data=` with `files=` (CLX-303). Each part is
/// written as it's added, so a file's bytes are copied once:
///
/// ```
/// let form = Form.new().field("metadata", meta).file("file", "mod.jar", jar)
/// var r = post_form(url, [Header { name: "X-Api-Token", value: token }], form, 60000, 1 << 20)
/// ```
pub struct Form {
    mark: String,
    parts: List<u8>,
}

// A field's or a file's name in a Content-Disposition line, quoted, with `"`, CR and LF written
// %22, %0D and %0A, as browsers write them (the HTML standard's multipart encoding) and as urllib3
// does. Other bytes, UTF-8 too, go as they are.
fn quoted(name: String) -> String {
    return "\"{name.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")}\""
}

impl Form {
    /// An empty form whose boundary is 32 hex digits from the system's random generator, as urllib3
    /// makes it, so it's as good as certain not to be in anything the form holds.
    pub fn new() -> Form {
        var raw: List<u8> = [0; 16]
        unsafe {
            cx_crypto_random(raw.as_mut_ptr(), 16)
        }
        let digits = "0123456789abcdef"
        var b = String()
        for x in raw {
            let hi = usize(u32(x) >> 4)
            let lo = usize(u32(x) & 15)
            b.push_str(digits[hi..hi + 1])
            b.push_str(digits[lo..lo + 1])
        }
        return Form { mark: b, parts: List<u8>() }
    }

    /// An empty form with this boundary, for a body that must come out the same each time, as in a
    /// test. Panics unless it's 1 to 70 of the characters RFC 2046 allows in one, letters, digits
    /// and `'()+_,-./:=?` and spaces, not ending in a space.
    @track_caller
    pub fn with_boundary(boundary: String) -> Form {
        let marks = "'()+_,-./:=? "
        var good = boundary.len() >= 1 and boundary.len() <= 70 and not boundary.ends_with(" ")
        for i in 0..boundary.len() {
            let b = boundary.byte_at(i)
            let alnum = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
            if not alnum and (b >= 128 or not marks.contains(boundary[i..i + 1])) {
                good = false
            }
        }
        if not good {
            panic("a multipart boundary is 1 to 70 letters, digits and '()+_,-./:=? or spaces, not ending in a space, not {boundary}")
        }
        return Form { mark: boundary.copy(), parts: List<u8>() }
    }

    // A part's opening: the boundary line, its headers and the blank line after them.
    fn open(mut self, disposition: String, content_type: String) {
        let head = if content_type.is_empty() {
            "--{self.mark}\r\nContent-Disposition: form-data; {disposition}\r\n\r\n"
        } else {
            "--{self.mark}\r\nContent-Disposition: form-data; {disposition}\r\nContent-Type: {content_type}\r\n\r\n"
        }
        self.parts.extend(head.to_bytes())
    }

    /// Adds a text field, as an HTML form's `<input name=...>` sends it: no Content-Type of its
    /// own, so the server reads it as text.
    pub fn field(own self, name: String, value: String) -> Form {
        var f = self
        f.open("name={quoted(name)}", String())
        f.parts.extend(value.to_bytes())
        f.parts.extend("\r\n".to_bytes())
        return f
    }

    /// Adds a file, its bytes as they are, under `filename`, with `content_type`, which is
    /// `application/octet-stream`, any bytes, unless it's given. Panics if the content type has a
    /// line break.
    @track_caller
    pub fn file(own self, name: String, filename: String, bytes: List<u8>, content_type: String = "application/octet-stream") -> Form {
        if content_type.contains("\r") or content_type.contains("\n") {
            panic("a file's content type has a line break: {content_type}")
        }
        var f = self
        f.open("name={quoted(name)}; filename={quoted(filename)}", content_type)
        f.parts.extend(bytes)
        f.parts.extend("\r\n".to_bytes())
        return f
    }

    /// The boundary between its parts.
    pub fn boundary(self) -> String {
        return self.mark.copy()
    }

    /// The Content-Type header's value for the body: `multipart/form-data; boundary=` and the
    /// boundary.
    pub fn content_type(self) -> String {
        return "multipart/form-data; boundary={self.mark}"
    }

    /// The whole body: every part, then the closing boundary.
    pub fn body(self) -> List<u8> {
        var out = self.parts.copy()
        out.extend("--{self.mark}--\r\n".to_bytes())
        return out
    }
}

/// Starts a POST of the form to `url`, with its Content-Type, as `post` does. Panics if the
/// header lines have a Content-Type of their own, or as `get` does.
@track_caller
pub fn post_form(url: String, headers: List<Header>, form: Form, timeout_ms: u32, limit: usize) -> Request {
    var all = List<Header>()
    for h in headers {
        if h.name.to_lower_root() == "content-type" {
            panic("post_form sets the Content-Type header itself, to the form's")
        }
        all.push(Header { name: h.name.copy(), value: h.value.copy() })
    }
    all.push(Header { name: "Content-Type", value: form.content_type() })
    return start(true, url, all, form.body(), timeout_ms, limit)
}

/// GETs `url` and waits for what the server answers, as a script wants it, as Python's
/// `requests.get(url)` does: no headers of its own, 60 seconds in all, and a body of up to 1 GiB.
/// Any status is an answer, so a 404 comes back as a `Response` with that status; only no answer
/// is an error.
pub fn fetch(url: String, timeout_ms: u32 = 60000) -> Response ! Error {
    var r = start(false, url, List<Header>(), List<u8>(), timeout_ms, 1 << 30)
    return try r.wait()
}
