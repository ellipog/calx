/// HTTP and HTTPS requests, on the system's own client, so certificates are checked as the system
/// checks them: WinHTTP on Windows, URLSession on iOS, and libcurl on Linux and macOS (D118).
///
/// A request runs off the program's thread, and `done` says when it has finished, so a server's
/// loop goes on while it waits, as vanilla's login waits for Mojang's session server on a thread of
/// its own. A connection is kept for the requests after it to the same host, and HTTP/2 ones,
/// which `Version.Http2` asks for, go over one connection at once (CLX-383). A `Stream`, from
/// `stream_get` or `stream_post`, gives its body as it comes, for a response that may never end,
/// as an event stream's doesn't (CLX-459). A `local://NAME/path` URL goes over the local socket
/// `NAME` of std.net, to a server on the same machine, which is how a confined program reaches its
/// parent (CLX-480).
module std.http

import std.net.waker.{Waker}
import std.text.utf8.{decode_lossy_unicode}

extern "C" {
    fn cx_http_start(post: bool, url: *const u8, url_len: usize, head: *const u8, head_len: usize, body: *const u8, body_len: usize, timeout_ms: u32, limit: usize, version: u32) -> u64
    fn cx_http_done(h: u64) -> i32
    fn cx_http_wait(h: u64) -> i32
    fn cx_http_code(h: u64) -> i32
    fn cx_http_status(h: u64) -> u32
    fn cx_http_head_len(h: u64) -> usize
    fn cx_http_head(h: u64, out: *u8)
    fn cx_http_body_len(h: u64) -> usize
    fn cx_http_body(h: u64, out: *u8)
    fn cx_http_free(h: u64)
    fn cx_http_received(h: u64) -> u64
    fn cx_http_expected(h: u64) -> u64
    fn cx_http_version(h: u64) -> u32
    fn cx_http_times(h: u64, out: *u64)
    fn cx_http_wake_on(h: u64, hooks: usize, net: u64)
    fn cx_http_open(post: bool, url: *const u8, url_len: usize, head: *const u8, head_len: usize, body: *const u8, body_len: usize, timeout_ms: u32, version: u32) -> u64
    fn cx_http_stream_head(h: u64) -> i32
    fn cx_http_stream_read(h: u64, timeout_ms: i64) -> i32
    fn cx_http_stream_ready(h: u64) -> bool
    fn cx_http_taken_len(h: u64) -> usize
    fn cx_http_taken(h: u64, out: *u8)
    fn cx_http_stream_close(h: u64)
    fn cx_crypto_random(p: *u8, n: usize)
}

/// A header line of a request or a response.
pub struct Header {
    pub name: String,
    pub value: String,
}

/// Why a request got no response.
pub enum Error {
    /// The URL isn't `http://` or `https://`, a host, and an optional port and path, in printable
    /// ASCII.
    BadUrl
    /// No name server knows the host.
    Resolve
    /// Nothing answered at the host and port.
    Connect
    /// The TLS handshake failed, or the system doesn't trust the server's certificate.
    Tls
    /// The response didn't come within the time.
    Timeout
    /// The server closed the connection early, or what it sent isn't HTTP/1.1 or HTTP/2: an
    /// HTTP/2-only server's answer to HTTP/1.1, or something that isn't HTTP at all. With
    /// `Version.Http2Only`, a server that doesn't speak HTTP/2.
    Protocol
    /// The body is longer than the limit.
    TooLong
    /// There's no HTTP client on the system that can make the request: on Linux, libcurl isn't
    /// installed, or for `Version.Http2Only`, the system's client has no HTTP/2 (a libcurl built
    /// without nghttp2), or no HTTP/2 without TLS (WinHTTP and URLSession).
    Unavailable
    /// Something else, with the system's error code: libcurl's on Linux, `NSURLError`'s on iOS.
    Os(i32)
}

/// What went wrong, in words: `timed out`, `can't find the host`, or `system error 7` with
/// the system's code.
impl Display for Error {
    fn show(self) {
        match self {
            BadUrl => print("not a valid URL"),
            Resolve => print("can't find the host"),
            Connect => print("can't connect: nothing answered at the host and port"),
            Tls => print("the TLS handshake failed"),
            Timeout => print("timed out"),
            Protocol => print("the response ended early, or the server didn't answer in HTTP/1.1 or HTTP/2"),
            TooLong => print("the body is longer than the limit"),
            Unavailable => print("there's no HTTP client on this system for the request; on Linux, install libcurl"),
            Os(code) => print("system error {code}"),
        }
    }
}

/// The HTTP a request asks for (CLX-383).
pub enum Version {
    /// HTTP/1.1, as every request was before HTTP/2 came to std.http.
    Http1
    /// HTTP/2 if the server takes it in the TLS handshake (ALPN), and HTTP/1.1 if it doesn't, or
    /// the URL is `http://`, or the system's client has no HTTP/2: as Python's
    /// `httpx.Client(http2=True)`.
    Http2
    /// HTTP/2 and nothing else: over `http://`, h2c, with no Upgrade first, and over `https://`,
    /// a server that doesn't take HTTP/2 is a `Protocol` error. As httpx's `http1=False,
    /// http2=True`. `Unavailable` where the system's client can't: WinHTTP has no h2c.
    Http2Only
}

/// How long a request's steps took, each in nanoseconds from its start to the step's end, as
/// curl's `-w '%{time_connect}'` gives them. A step the request didn't take is 0: resolving,
/// connecting and TLS on a connection that was open already, TLS on `http://`.
pub struct Timings {
    /// Until the host's address was known. 0 too when the system had it already (on Windows).
    pub resolve_ns: u64,
    /// Until the TCP connection was made.
    pub connect_ns: u64,
    /// Until the TLS handshake was done.
    pub tls_ns: u64,
    /// Until the response's first byte came (on Windows, its headers).
    pub first_byte_ns: u64,
    /// Until the whole body had come.
    pub total_ns: u64,
}

/// What the server answered.
pub struct Response {
    /// The status code, such as 200, or 204 when Mojang's session server says a player hasn't
    /// joined.
    pub status: u32,
    /// The header lines, in the order they came, their values trimmed. Over HTTP/2 their names
    /// are in lower case, as HTTP/2 sends them.
    pub headers: List<Header>,
    pub body: List<u8>,
    /// The HTTP it came in: `HTTP/1.1`, `HTTP/2` or `HTTP/1.0`, as httpx's `r.http_version`.
    pub version: String,
    /// Whether it came over a connection that was open already, kept from a request before it or
    /// shared with one running beside it.
    pub reused: bool,
    /// How long its steps took. Only the total, on a Windows whose WinHTTP doesn't give the rest.
    pub timings: Timings,
}

// The value of the first of the headers named `name`, compared without regard to case.
fn first_header(headers: List<Header>, name: String) -> String? {
    let want = name.to_lower_root()
    for h in headers {
        if h.name.to_lower_root() == want {
            return some(h.value.copy())
        }
    }
    return none
}

impl Response {
    /// The value of the first header named `name`, compared without regard to case, as HTTP
    /// compares header names.
    pub fn header(self, name: String) -> String? {
        return first_header(self.headers, name)
    }
}

/// How far a request's response has come: what a download's progress bar shows.
pub struct Progress {
    /// The bytes of the body that have come so far.
    pub received: u64,
    /// The body's length in all, if the server said, in its Content-Length header.
    pub total: u64?,
}

/// A request that's running, or finished and waiting to be taken.
pub struct Request {
    handle: u64,
}

impl Request {
    /// Whether it has finished, so that `wait` won't wait.
    pub fn done(self) -> bool {
        return self.handle == 0 or unsafe { cx_http_done(self.handle) } != 0
    }

    /// Wakes `waker`'s `Net` as it finishes, so a loop waiting on a server's `next_event`, or a
    /// `Net`'s `poll`, hears of it then and takes the response with `wait`, rather than looking
    /// at `done` at each timeout, as asyncio's `wait` returns once a request finishes. It wakes it
    /// at once if it has finished already, and a later call wakes the `Net` it's given instead.
    pub fn wake_on(self, waker: Waker) {
        if self.handle == 0 {
            return
        }
        let (net, hooks) = unsafe { waker.parts() }
        unsafe {
            cx_http_wake_on(self.handle, hooks, net)
        }
    }

    /// How much of the body has come so far, and how long it is in all if the server said, which
    /// a program draws as a progress bar while it waits:
    ///
    /// ```
    /// var r = get(url, [], 600000, 1 << 30)
    /// while not r.done() {
    ///     let p = r.progress()
    ///     ...
    /// }
    /// ```
    ///
    /// Nothing has come until the response's headers have. Once the response is taken, by `wait`,
    /// it's 0 of an unknown length.
    pub fn progress(self) -> Progress {
        if self.handle == 0 {
            return Progress { received: 0, total: none }
        }
        let expected = unsafe { cx_http_expected(self.handle) }
        let total: u64? = if expected == 0 { none } else { some(expected - 1) }
        return Progress { received: unsafe { cx_http_received(self.handle) }, total: total }
    }

    /// Waits for it to finish, and gives the response. Panics if the response was taken already,
    /// by this request or a copy of it.
    @track_caller
    pub fn wait(mut self) -> Response ! Error {
        let h = self.handle
        let kind = if h == 0 { -1 } else { unsafe { cx_http_wait(h) } }
        if kind < 0 {
            panic("the request's response was taken already")
        }
        self.handle = 0
        if kind != 0 {
            let e = error_of(h, kind)
            unsafe { cx_http_free(h) }
            fail e
        }
        let head = head_of(h)
        var body = List<u8>()
        var t: List<u64> = [0; 6]
        unsafe {
            let bn = cx_http_body_len(h)
            body.reserve(bn)
            cx_http_body(h, body.as_mut_ptr())
            body.set_len(bn)
            cx_http_times(h, t.as_mut_ptr())
            cx_http_free(h)
        }
        return Response {
            status: head.status,
            headers: head.headers,
            body: body,
            version: head.version,
            reused: t[5] != 0,
            timings: Timings { resolve_ns: t[0], connect_ns: t[1], tls_ns: t[2], first_byte_ns: t[3], total_ns: t[4] },
        }
    }
}

// The runtime's error number `kind` as an Error.
fn error_of(h: u64, kind: i32) -> Error {
    return match kind {
        1 => Error.BadUrl,
        2 => Error.Resolve,
        3 => Error.Connect,
        4 => Error.Tls,
        5 => Error.Timeout,
        6 => Error.Protocol,
        7 => Error.TooLong,
        8 => Error.Unavailable,
        _ => Error.Os(unsafe { cx_http_code(h) }),
    }
}

// The status, header lines and version of a request whose response has come, or a stream's whose
// headers have.
fn head_of(h: u64) -> Head {
    var head = List<u8>()
    var status: u32 = 0
    var used: u32 = 0
    unsafe {
        let hn = cx_http_head_len(h)
        head.reserve(hn)
        cx_http_head(h, head.as_mut_ptr())
        head.set_len(hn)
        status = cx_http_status(h)
        used = cx_http_version(h)
    }
    let version = match used {
        10 => "HTTP/1.0",
        20 => "HTTP/2",
        30 => "HTTP/3",
        _ => "HTTP/1.1",
    }
    return Head { status: status, headers: header_list(String.from_utf8(head) ?? String()), version: String(version) }
}

/// The status and header lines of a stream's response, which come before its body.
pub struct Head {
    /// The status code, such as 200.
    pub status: u32,
    /// The header lines, as `Response.headers` has them.
    pub headers: List<Header>,
    /// The HTTP it came in, as `Response.version` says. On iOS, `HTTP/1.1` whichever it was, as
    /// URLSession says only once the body has ended.
    pub version: String,
}

impl Head {
    /// The value of the first header named `name`, compared without regard to case.
    pub fn header(self, name: String) -> String? {
        return first_header(self.headers, name)
    }
}

/// A request whose body is read as it comes, as httpx's `stream` reads one: an event stream that
/// stays open until one side closes it, or a download too big to hold. It runs on a thread of its
/// own, as a `Request` does, which keeps up to 1 MiB of the body that the program hasn't read and
/// then stops reading until it has, so the server waits. Closing it, or dropping it, closes the
/// connection, so the server hears the program has stopped.
@handle
pub struct Stream {
    handle: u64,
    // How long `read`, `read_line` and `line_ready`'s reads wait for bytes, -1 for no limit.
    wait_ms: i64,
    // What has come and isn't given yet, from `at`.
    buf: List<u8>,
    at: usize,
    // How far from `at` has no line end, so `read_line` doesn't look there again.
    scanned: usize,
    // The last line ended with CR, so a LF first in what comes next ends it too.
    skip_lf: bool,
    // The body has ended, and `buf` holds the last of it.
    ended: bool,
    // What it ended with, 0 for nothing.
    fault: i32,
}

impl Stream {
    /// Waits for the response's status and header lines, and gives them, or fails with why no
    /// response came. A stream whose headers didn't come within its `timeout_ms` fails with
    /// `Timeout`. It can be asked again, and gives them again.
    pub fn head(self) -> Head ! Error {
        let kind = unsafe { cx_http_stream_head(self.handle) }
        if kind != 0 {
            fail error_of(self.handle, kind)
        }
        return head_of(self.handle)
    }

    // Takes what has come into `buf`, waiting up to `timeout_ms` for something, -1 for no limit:
    // true if anything came or the body ended, false if nothing came in the time.
    fn take(mut self, timeout_ms: i64) -> bool ! Error {
        if self.ended {
            if self.fault != 0 {
                fail error_of(self.handle, self.fault)
            }
            return true
        }
        let kind = unsafe { cx_http_stream_read(self.handle, timeout_ms) }
        if kind == 0 {
            return false
        }
        if kind == 1 {
            if self.at > 0 and self.at == self.buf.len() {
                self.buf.clear()
                self.at = 0
            } else if self.at > 65536 and self.at * 2 > self.buf.len() {
                self.buf = self.buf[self.at..]
                self.at = 0
            }
            unsafe {
                let n = cx_http_taken_len(self.handle)
                let len = self.buf.len()
                self.buf.reserve(n)
                cx_http_taken(self.handle, self.buf.as_mut_ptr().add(len))
                self.buf.set_len(len + n)
            }
            return true
        }
        self.ended = true
        if kind < 0 {
            self.fault = -kind
            fail error_of(self.handle, self.fault)
        }
        return true
    }

    // Drops the LF that ends a line whose CR ended it already, once what comes next is here.
    fn after_cr(mut self) {
        if self.skip_lf and self.at < self.buf.len() {
            if self.buf[self.at] == 10 {
                self.at += 1
            }
            self.skip_lf = false
        }
    }

    /// The next bytes of the body, all that have come that weren't given yet, waiting for some,
    /// or `none` once the body has ended. Fails if the connection ended with an error, as when the
    /// server went away mid-body (`Protocol`), or if nothing came for `read_timeout_ms`
    /// (`Timeout`), after which it can be read again.
    pub fn read(mut self) -> List<u8>? ! Error {
        self.after_cr()
        while self.at == self.buf.len() {
            if self.ended and self.fault == 0 {
                return none
            }
            let wait = self.wait_ms
            if not try self.take(wait) {
                fail Error.Timeout
            }
            self.after_cr()
        }
        let out = if self.at == 0 { self.buf.copy() } else { self.buf[self.at..] }
        self.buf.clear()
        self.at = 0
        self.scanned = 0
        return some(out)
    }

    // The offset in `buf` of the next CR or LF from `at`, if one has come.
    fn line_end(mut self) -> usize? {
        var i = self.at + self.scanned
        while i < self.buf.len() {
            let b = self.buf[i]
            if b == 10 or b == 13 {
                return some(i)
            }
            i += 1
        }
        self.scanned = self.buf.len() - self.at
        return none
    }

    /// The next line of the body, without the LF, CRLF or CR that ends it, as Python's
    /// `iter_lines` gives them, waiting until it has all come, or `none` once the body has ended.
    /// A last line with no end is given as it is. The bytes are read as UTF-8, with U+FFFD for
    /// any that aren't. Fails as `read` does.
    pub fn read_line(mut self) -> String? ! Error {
        loop {
            self.after_cr()
            match self.line_end() {
                some(end) => {
                    let line = decode_lossy_unicode(self.buf, self.at, end)
                    self.at = end + 1
                    self.scanned = 0
                    if self.buf[end] == 13 {
                        self.skip_lf = true
                        self.after_cr()
                    }
                    return some(line)
                }
                none => {
                    if self.ended and self.fault == 0 {
                        if self.at == self.buf.len() {
                            return none
                        }
                        let last = decode_lossy_unicode(self.buf, self.at, self.buf.len())
                        self.at = self.buf.len()
                        self.scanned = 0
                        return some(last)
                    }
                    let wait = self.wait_ms
                    if not try self.take(wait) {
                        fail Error.Timeout
                    }
                }
            }
        }
    }

    /// Whether `read` would give something, or say the body has ended, without waiting: for a
    /// loop that does other work, with `wake_on`.
    pub fn ready(self) -> bool {
        return self.at < self.buf.len() or self.ended or unsafe { cx_http_stream_ready(self.handle) }
    }

    /// Whether `read_line` would give a line, or say the body has ended, without waiting. It takes
    /// what has come, so it can fail as `read` does.
    pub fn line_ready(mut self) -> bool ! Error {
        loop {
            self.after_cr()
            if self.ended or self.line_end() != none {
                return true
            }
            if not try self.take(0) {
                return false
            }
        }
    }

    /// Wakes `waker`'s `Net` as the headers come, each time some of the body does, and as it ends,
    /// so a loop waiting on a server's `next_event`, or a `Net`'s `poll`, hears of it then and
    /// reads what's `ready`. Wakes that come before a poll are one. A later call wakes the `Net`
    /// it's given instead.
    pub fn wake_on(self, waker: Waker) {
        let (net, hooks) = unsafe { waker.parts() }
        unsafe {
            cx_http_wake_on(self.handle, hooks, net)
        }
    }

    /// Closes it, whether or not its body has ended, as leaving httpx's `with stream(...)` does:
    /// the connection is closed, so the server hears the program has stopped reading. Dropping it
    /// does the same.
    pub fn close(own self) {
        var s = self
        s.end()
    }

    fn end(mut self) {
        if self.handle != 0 {
            unsafe {
                cx_http_stream_close(self.handle)
            }
            self.handle = 0
        }
    }

    fn drop(mut self) {
        self.end()
    }
}

@track_caller
fn open(is_post: bool, url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32, read_timeout_ms: u32, version: Version) -> Stream {
    if timeout_ms == 0 {
        panic("a stream's timeout is at least 1 ms")
    }
    let head = header_lines(headers)
    let v: u32 = match version {
        Http1 => 0,
        Http2 => 1,
        Http2Only => 2,
    }
    let h = unsafe { cx_http_open(is_post, url.as_ptr(), url.len(), head.as_ptr(), head.len(), body.as_ptr(), body.len(), timeout_ms, v) }
    let wait: i64 = if read_timeout_ms == 0 { -1 } else { i64(read_timeout_ms) }
    return Stream { handle: h, wait_ms: wait, buf: List<u8>(), at: 0, scanned: 0, skip_lf: false, ended: false, fault: 0 }
}

/// Starts a GET of `url` whose body is read as it comes, and gives it at once, while it connects
/// on its own thread, as httpx's `stream("GET", url)`. Its status and headers may take
/// `timeout_ms` milliseconds to come, and after them there's no limit on how long the body takes
/// or how long it is. With `read_timeout_ms`, a read that waits that long with nothing coming
/// fails with `Timeout`, as httpx's read timeout does; with 0 it waits as long as it takes. Panics
/// as `get` does.
@track_caller
pub fn stream_get(url: String, headers: List<Header> = [], timeout_ms: u32 = 30000, read_timeout_ms: u32 = 0, version: Version = Version.Http1) -> Stream {
    return open(false, url, headers, List<u8>(), timeout_ms, read_timeout_ms, version)
}

/// Starts a POST of `body` to `url` whose answer is read as it comes, as `stream_get` does, as
/// MCP's `subscriptions/listen` is answered with an event stream. Give a Content-Type header for
/// the body.
@track_caller
pub fn stream_post(url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32 = 30000, read_timeout_ms: u32 = 0, version: Version = Version.Http1) -> Stream {
    return open(true, url, headers, body, timeout_ms, read_timeout_ms, version)
}

// The runtime's header lines, each "name:value\r\n".
fn header_list(text: String) -> List<Header> {
    var out = List<Header>()
    var at: usize = 0
    while at < text.len() {
        let rest = text[at..]
        let end = rest.find("\r\n") ?? rest.len()
        let line = rest[..end]
        let colon = line.find(":") ?? 0
        out.push(Header { name: line[..colon], value: line[colon + 1..] })
        at += end + 2
    }
    return out
}

// Whether the byte can be in a header's name: RFC 9110's token.
fn token_byte(b: u8) -> bool {
    if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) {
        return true
    }
    let marks = "!#$%&'*+-.^_`|~"
    for i in 0..marks.len() {
        if marks.byte_at(i) == b {
            return true
        }
    }
    return false
}

@track_caller
fn header_lines(headers: List<Header>) -> String {
    var s = String()
    for h in headers {
        if h.name.is_empty() {
            panic("a header's name is empty")
        }
        for i in 0..h.name.len() {
            if not token_byte(h.name.byte_at(i)) {
                panic("the header name {h.name} has a byte HTTP doesn't allow in names")
            }
        }
        let lower = h.name.to_lower_root()
        if lower == "host" or lower == "content-length" or lower == "transfer-encoding" or lower == "connection" {
            panic("std.http sets the {h.name} header itself")
        }
        for i in 0..h.value.len() {
            let b = h.value.byte_at(i)
            if b == 13 or b == 10 or b == 0 {
                panic("the value of the header {h.name} has a line break or a zero byte")
            }
        }
        s.push_str(h.name)
        s.push_str(": ")
        s.push_str(h.value)
        s.push_str("\r\n")
    }
    return s
}

@track_caller
fn start(is_post: bool, url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32, limit: usize, version: Version) -> Request {
    if timeout_ms == 0 {
        panic("a request's timeout is at least 1 ms")
    }
    let head = header_lines(headers)
    let v: u32 = match version {
        Http1 => 0,
        Http2 => 1,
        Http2Only => 2,
    }
    let h = unsafe { cx_http_start(is_post, url.as_ptr(), url.len(), head.as_ptr(), head.len(), body.as_ptr(), body.len(), timeout_ms, limit, v) }
    return Request { handle: h }
}

/// Starts a GET of `url` with the header lines, which may take `timeout_ms` milliseconds in all
/// and give a body of at most `limit` bytes, in the HTTP `version` asks for. Panics if the timeout
/// is 0, or a header's name isn't a token, its value has a line break, or it's one std.http sets
/// itself: Host, Content-Length, Transfer-Encoding or Connection.
@track_caller
pub fn get(url: String, headers: List<Header>, timeout_ms: u32, limit: usize, version: Version = Version.Http1) -> Request {
    return start(false, url, headers, List<u8>(), timeout_ms, limit, version)
}

/// Starts a POST of `body` to `url`, as `get` does. Give a Content-Type header for the body.
@track_caller
pub fn post(url: String, headers: List<Header>, body: List<u8>, timeout_ms: u32, limit: usize, version: Version = Version.Http1) -> Request {
    return start(true, url, headers, body, timeout_ms, limit, version)
}

/// A `multipart/form-data` body (RFC 7578): text fields and files, as an HTML form with a file
/// input sends them, and as Python's requests sends `data=` with `files=` (CLX-303). Each part is
/// written as it's added, so a file's bytes are copied once:
///
/// ```
/// let form = Form.new().field("metadata", meta).file("file", "mod.jar", jar)
/// var r = post_form(url, [Header { name: "X-Api-Token", value: token }], form, 60000, 1 << 20)
/// ```
pub struct Form {
    mark: String,
    parts: List<u8>,
}

// A field's or a file's name in a Content-Disposition line, quoted, with `"`, CR and LF written
// %22, %0D and %0A, as browsers write them (the HTML standard's multipart encoding) and as urllib3
// does. Other bytes, UTF-8 too, go as they are.
fn quoted(name: String) -> String {
    return "\"{name.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")}\""
}

impl Form {
    /// An empty form whose boundary is 32 hex digits from the system's random generator, as urllib3
    /// makes it, so it's as good as certain not to be in anything the form holds.
    pub fn new() -> Form {
        var raw: List<u8> = [0; 16]
        unsafe {
            cx_crypto_random(raw.as_mut_ptr(), 16)
        }
        let digits = "0123456789abcdef"
        var b = String()
        for x in raw {
            let hi = usize(u32(x) >> 4)
            let lo = usize(u32(x) & 15)
            b.push_str(digits[hi..hi + 1])
            b.push_str(digits[lo..lo + 1])
        }
        return Form { mark: b, parts: List<u8>() }
    }

    /// An empty form with this boundary, for a body that must come out the same each time, as in a
    /// test. Panics unless it's 1 to 70 of the characters RFC 2046 allows in one, letters, digits
    /// and `'()+_,-./:=?` and spaces, not ending in a space.
    @track_caller
    pub fn with_boundary(boundary: String) -> Form {
        let marks = "'()+_,-./:=? "
        var good = boundary.len() >= 1 and boundary.len() <= 70 and not boundary.ends_with(" ")
        for i in 0..boundary.len() {
            let b = boundary.byte_at(i)
            let alnum = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
            if not alnum and (b >= 128 or not marks.contains(boundary[i..i + 1])) {
                good = false
            }
        }
        if not good {
            panic("a multipart boundary is 1 to 70 letters, digits and '()+_,-./:=? or spaces, not ending in a space, not {boundary}")
        }
        return Form { mark: boundary.copy(), parts: List<u8>() }
    }

    // A part's opening: the boundary line, its headers and the blank line after them.
    fn open(mut self, disposition: String, content_type: String) {
        let head = if content_type.is_empty() {
            "--{self.mark}\r\nContent-Disposition: form-data; {disposition}\r\n\r\n"
        } else {
            "--{self.mark}\r\nContent-Disposition: form-data; {disposition}\r\nContent-Type: {content_type}\r\n\r\n"
        }
        self.parts.extend(head.to_bytes())
    }

    /// Adds a text field, as an HTML form's `<input name=...>` sends it: no Content-Type of its
    /// own, so the server reads it as text.
    pub fn field(own self, name: String, value: String) -> Form {
        var f = self
        f.open("name={quoted(name)}", String())
        f.parts.extend(value.to_bytes())
        f.parts.extend("\r\n".to_bytes())
        return f
    }

    /// Adds a file, its bytes as they are, under `filename`, with `content_type`, which is
    /// `application/octet-stream`, any bytes, unless it's given. Panics if the content type has a
    /// line break.
    @track_caller
    pub fn file(own self, name: String, filename: String, bytes: List<u8>, content_type: String = "application/octet-stream") -> Form {
        if content_type.contains("\r") or content_type.contains("\n") {
            panic("a file's content type has a line break: {content_type}")
        }
        var f = self
        f.open("name={quoted(name)}; filename={quoted(filename)}", content_type)
        f.parts.extend(bytes)
        f.parts.extend("\r\n".to_bytes())
        return f
    }

    /// The boundary between its parts.
    pub fn boundary(self) -> String {
        return self.mark.copy()
    }

    /// The Content-Type header's value for the body: `multipart/form-data; boundary=` and the
    /// boundary.
    pub fn content_type(self) -> String {
        return "multipart/form-data; boundary={self.mark}"
    }

    /// The whole body: every part, then the closing boundary.
    pub fn body(self) -> List<u8> {
        var out = self.parts.copy()
        out.extend("--{self.mark}--\r\n".to_bytes())
        return out
    }
}

/// Starts a POST of the form to `url`, with its Content-Type, as `post` does. Panics if the
/// header lines have a Content-Type of their own, or as `get` does.
@track_caller
pub fn post_form(url: String, headers: List<Header>, form: Form, timeout_ms: u32, limit: usize, version: Version = Version.Http1) -> Request {
    var all = List<Header>()
    for h in headers {
        if h.name.to_lower_root() == "content-type" {
            panic("post_form sets the Content-Type header itself, to the form's")
        }
        all.push(Header { name: h.name.copy(), value: h.value.copy() })
    }
    all.push(Header { name: "Content-Type", value: form.content_type() })
    return start(true, url, all, form.body(), timeout_ms, limit, version)
}

/// GETs `url` and waits for what the server answers, as a script wants it, as Python's
/// `requests.get(url)` does: no headers of its own, 60 seconds in all, and a body of up to 1 GiB.
/// Any status is an answer, so a 404 comes back as a `Response` with that status; only no answer
/// is an error.
pub fn fetch(url: String, timeout_ms: u32 = 60000, version: Version = Version.Http1) -> Response ! Error {
    var r = start(false, url, List<Header>(), List<u8>(), timeout_ms, 1 << 30, version)
    return try r.wait()
}
