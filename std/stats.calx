/// Statistics of lists of numbers, as Python's `statistics` module gives them (CLX-103).
///
/// Each function gives what Python 3.14's does, to the last bit: `mean`, the variances and the
/// standard deviations are worked out exactly and rounded once, as Python does with fractions,
/// and the rest take the same steps Python takes. Each that needs values gives `none` without
/// enough of them, where Python raises `StatisticsError`: one for a mean or a median, two for a
/// sample's variance.
module std.stats

import std.bigint.{BigInt}
import std.math.{exp, log}

/// The sum, correctly rounded: the `f64` nearest the exact sum of the values, as Python's
/// `math.fsum`, however many there are and in whatever order. An infinity or a NaN among them
/// makes the sum what adding them in turn makes it.
pub fn fsum(xs: List<f64>) -> f64 {
    var partials: List<f64> = []
    var special = 0.0
    var any_special = false
    for x in xs {
        if x - x != 0.0 {
            special += x  // an infinity or a NaN
            any_special = true
        } else {
            add_exact(mut partials, x)
        }
    }
    if any_special {
        return special
    }
    return rounded(partials)
}

/// The arithmetic mean, the exact sum over the count, rounded once, as Python's `mean`. `none`
/// for no values.
pub fn mean(xs: List<f64>) -> f64? {
    if xs.len() == 0 {
        return none
    }
    var partials: List<f64> = []
    for x in xs {
        if x - x != 0.0 {
            return some(fsum(xs) / f64.nearest(u64(xs.len())))
        }
        add_exact(mut partials, x)
    }
    let (n, e) = exact(partials)
    return some(ratio(n, e, count_of(xs)))
}

/// The geometric mean, the nth root of the product, from logarithms as Python's
/// `geometric_mean` works it out: 0 when a value is 0. `none` for no values or a negative one.
pub fn geometric_mean(xs: List<f64>) -> f64? {
    var logs: List<f64> = []
    var zero = false
    for x in xs {
        if x > 0.0 or x.is_nan() {
            logs.push(log(x))
        } else if x == 0.0 {
            zero = true
        } else {
            return none
        }
    }
    if xs.len() == 0 {
        return none
    }
    let total = fsum(logs)
    if total.is_nan() {
        return some(f64.NAN)
    }
    if zero {
        return some(if total == f64.INFINITY { f64.NAN } else { 0.0 })
    }
    return some(exp(total / f64.nearest(u64(xs.len()))))
}

/// The harmonic mean, the count over the sum of reciprocals, as Python's `harmonic_mean`: 0 when
/// a value is 0. `none` for no values or a negative one.
pub fn harmonic_mean(xs: List<f64>) -> f64? {
    if xs.len() == 0 {
        return none
    }
    if xs.len() == 1 {
        return if xs[0] < 0.0 { none } else { some(xs[0]) }
    }
    var partials: List<f64> = []
    var plain = false
    var inverses: List<f64> = []
    for x in xs {
        if x < 0.0 {
            return none
        }
        if x == 0.0 {
            return some(0.0)
        }
        let r = 1.0 / x
        inverses.push(r)
        if r - r != 0.0 {
            plain = true
        } else {
            add_exact(mut partials, r)
        }
    }
    if plain {
        return some(f64.nearest(u64(xs.len())) / fsum(inverses))
    }
    // The count over the exact sum, n / (m 2^e), rounded once.
    let (m, e) = exact(partials)
    let c = count_of(xs)
    if e <= 0 {
        return some(c.shl(u64.wrap(0 - e)).div_f64(m))
    }
    return some(c.div_f64(m.shl(u64.wrap(e))))
}

/// The middle value once they're sorted, or the mean of the two in the middle, or `none` for no
/// values. NaNs sort after everything, as `total_cmp` puts them.
pub fn median(xs: List<f64>) -> f64? {
    let n = xs.len()
    if n == 0 {
        return none
    }
    let s = sorted(xs)
    if n % 2 == 1 {
        return some(s[n / 2])
    }
    return some((s[n / 2 - 1] + s[n / 2]) / 2.0)
}

/// The `n - 1` cut points that divide the sorted values into `n` groups of equal probability,
/// as Python's `quantiles(xs, n=n)`: `quantiles(xs, 4)` gives the quartiles, and
/// `quantiles(xs, 100)` the percentiles. By default the values are taken as a sample of a larger
/// population, Python's `exclusive` method; `inclusive: true` takes them as the whole population,
/// with the least and greatest as the 0th and 100th percentiles. One value is every cut point;
/// no values give `none`. It panics when `n` is 0.
@track_caller
pub fn quantiles(xs: List<f64>, n: usize = 4, inclusive: bool = false) -> List<f64>? {
    if n == 0 {
        panic("quantiles need at least one group")
    }
    let count = xs.len()
    if count == 0 {
        return none
    }
    var out: List<f64> = []
    out.reserve(n - 1)
    if count == 1 {
        for _ in 1..n {
            out.push(xs[0])
        }
        return some(out)
    }
    let s = sorted(xs)
    let nf = f64.nearest(u64(n))
    // Python's arithmetic step for step, so the cut points are the same to the last bit.
    if inclusive {
        let m = count - 1
        for i in 1..n {
            let j = i * m / n
            let delta = i * m % n
            out.push((s[j] * f64.nearest(u64(n - delta)) + s[j + 1] * f64.nearest(u64(delta))) / nf)
        }
    } else {
        let m = count + 1
        for i in 1..n {
            let j = (i * m / n).max(1).min(count - 1)
            let delta = i64.wrap(i * m) - i64.wrap(j * n)
            out.push((s[j - 1] * f64.nearest(i64.wrap(n) - delta) + s[j] * f64.nearest(delta)) / nf)
        }
    }
    return some(out)
}

/// The most common value, the first of them to appear when several are as common, as Python's
/// `mode` gives it, or `none` for no values. It works on anything that can be a map's key, such
/// as integers and text.
pub fn mode<T: Equal + Hash + Copy>(xs: List<T>) -> T? {
    var counts: Map<T, usize> = Map()
    var most: usize = 0
    for x in xs {
        let c = (counts.get(x) ?? 0) + 1
        counts.insert(x, c)
        most = most.max(c)
    }
    for x in xs {
        if counts.get(x) == some(most) {
            return some(x)
        }
    }
    return none
}

/// The variance of a sample: the sum of squared differences from the mean over one less than the
/// count, exactly, rounded once, as Python's `variance`. `none` for fewer than two values, and NaN
/// with an infinity or a NaN among them.
pub fn variance(xs: List<f64>) -> f64? {
    if xs.len() < 2 {
        return none
    }
    let c = count_of(xs)
    if let (ss, e) = scaled_squares(xs) {
        return some(ratio(ss, e, c * (c - 1)))
    }
    return some(f64.NAN)
}

/// The variance of a whole population: the mean squared difference from the mean, exactly,
/// rounded once, as Python's `pvariance`. `none` for no values, and NaN with an infinity or a NaN
/// among them.
pub fn pvariance(xs: List<f64>) -> f64? {
    if xs.len() == 0 {
        return none
    }
    let c = count_of(xs)
    if let (ss, e) = scaled_squares(xs) {
        return some(ratio(ss, e, c * c))
    }
    return some(f64.NAN)
}

/// The standard deviation of a sample, the square root of the exact `variance`, correctly
/// rounded, as Python's `stdev`. `none` for fewer than two values.
pub fn stdev(xs: List<f64>) -> f64? {
    if xs.len() < 2 {
        return none
    }
    let c = count_of(xs)
    if let (ss, e) = scaled_squares(xs) {
        return some(sqrt_ratio(ss, e, c * (c - 1)))
    }
    return some(f64.NAN)
}

/// The standard deviation of a whole population, the square root of the exact `pvariance`,
/// correctly rounded, as Python's `pstdev`. `none` for no values.
pub fn pstdev(xs: List<f64>) -> f64? {
    if xs.len() == 0 {
        return none
    }
    let c = count_of(xs)
    if let (ss, e) = scaled_squares(xs) {
        return some(sqrt_ratio(ss, e, c * c))
    }
    return some(f64.NAN)
}

/// The covariance of two samples of the same length, as Python's `covariance`. `none` for fewer
/// than two pairs. It panics when the lengths differ.
@track_caller
pub fn covariance(xs: List<f64>, ys: List<f64>) -> f64? {
    same_length(xs, ys)
    if xs.len() < 2 {
        return none
    }
    let n = f64.nearest(u64(xs.len()))
    let dx = deviations(xs, fsum(xs) / n)
    let dy = deviations(ys, fsum(ys) / n)
    return some(sumprod(dx, dy) / f64.nearest(u64(xs.len() - 1)))
}

/// Pearson's correlation coefficient, from -1 to 1, as Python's `correlation`. `none` for fewer
/// than two pairs, or when either list has every value the same. It panics when the lengths
/// differ.
@track_caller
pub fn correlation(xs: List<f64>, ys: List<f64>) -> f64? {
    same_length(xs, ys)
    if xs.len() < 2 {
        return none
    }
    let n = f64.nearest(u64(xs.len()))
    let dx = deviations(xs, fsum(xs) / n)
    let dy = deviations(ys, fsum(ys) / n)
    let sxy = sumprod(dx, dy)
    let root = sqrt_product(sumprod(dx, dx), sumprod(dy, dy))
    if root == 0.0 {
        return none
    }
    return some(sxy / root)
}

/// The slope and the intercept of the straight line that fits the pairs best by least squares,
/// as Python's `linear_regression`: `y` is about `slope * x + intercept`. `none` for fewer than
/// two pairs, or when every `x` is the same. It panics when the lengths differ.
@track_caller
pub fn linear_regression(xs: List<f64>, ys: List<f64>) -> (f64, f64)? {
    same_length(xs, ys)
    if xs.len() < 2 {
        return none
    }
    let n = f64.nearest(u64(xs.len()))
    let xbar = fsum(xs) / n
    let ybar = fsum(ys) / n
    let dx = deviations(xs, xbar)
    let sxx = sumprod(dx, dx)
    if sxx == 0.0 {
        return none
    }
    let slope = (sumprod(dx, deviations(ys, ybar)) + 0.0) / sxx
    return some((slope, ybar - slope * xbar))
}

// --- exact sums ---------------------------------------------------------------------------------

/// Adds `v`, which is finite, to an exact sum kept as partial sums that don't overlap, smallest
/// first: Shewchuk's algorithm, as Python's `math.fsum` keeps them.
fn add_exact(partials: mut List<f64>, v: f64) {
    var x = v
    var kept: usize = 0
    for i in 0..partials.len() {
        var y = partials[i]
        if x.abs() < y.abs() {
            let t = x
            x = y
            y = t
        }
        let hi = x + y
        let lo = y - (hi - x)
        if lo != 0.0 {
            partials[kept] = lo
            kept += 1
        }
        x = hi
    }
    partials.truncate(kept)
    partials.push(x)
}

/// The `f64` nearest an exact sum's partials, with half-way cases rounded as the whole sum
/// would be, as `math.fsum` rounds them.
fn rounded(partials: List<f64>) -> f64 {
    var n = partials.len()
    if n == 0 {
        return 0.0
    }
    n -= 1
    var hi = partials[n]
    var lo = 0.0
    while n > 0 {
        n -= 1
        let x = hi
        let y = partials[n]
        hi = x + y
        lo = y - (hi - x)
        if lo != 0.0 {
            break
        }
    }
    if n > 0 and ((lo < 0.0 and partials[n - 1] < 0.0) or (lo > 0.0 and partials[n - 1] > 0.0)) {
        let y = lo * 2.0
        let x = hi + y
        if y == x - hi {
            hi = x
        }
    }
    return hi
}

/// An exact sum's partials as one integer times 2^e.
fn exact(partials: List<f64>) -> (BigInt, i64) {
    var low = i64.MAX
    for p in partials {
        if p != 0.0 {
            low = low.min(exponent_of(p))
        }
    }
    var total = BigInt.zero()
    for p in partials {
        if p != 0.0 {
            let m = BigInt.from(mantissa_of(p)).shl(u64.wrap(exponent_of(p) - low))
            if p < 0.0 {
                total -= m
            } else {
                total += m
            }
        }
    }
    return (total, if low == i64.MAX { 0 } else { low })
}

/// A finite nonzero `f64`'s magnitude is its mantissa times 2 to its exponent.
fn mantissa_of(x: f64) -> u64 {
    let bits = x.to_bits()
    let frac = bits & 0xFFFFFFFFFFFFF
    return if (bits >> 52) & 0x7FF == 0 { frac } else { frac | (1u64 << 52) }
}

fn exponent_of(x: f64) -> i64 {
    let e = i64.wrap((x.to_bits() >> 52) & 0x7FF)
    return if e == 0 { -1074 } else { e - 1075 }
}

/// `n 2^e / d`, rounded once.
fn ratio(n: BigInt, e: i64, d: BigInt) -> f64 {
    if e >= 0 {
        return n.shl(u64.wrap(e)).div_f64(d)
    }
    return n.div_f64(d.shl(u64.wrap(0 - e)))
}

/// The square root of `n 2^e / d`, correctly rounded, as Python's `_float_sqrt_of_frac` works it
/// out: a root of 55 bits or more, rounded to odd, so rounding it to 53 bits rounds the exact root.
fn sqrt_ratio(n0: BigInt, e: i64, d0: BigInt) -> f64 {
    let n = if e >= 0 { n0.shl(u64.wrap(e)) } else { n0.copy() }
    let d = if e < 0 { d0.shl(u64.wrap(0 - e)) } else { d0.copy() }
    if n.is_zero() {
        return 0.0
    }
    let q = (i64.wrap(n.bit_len()) - i64.wrap(d.bit_len()) - 109).floor_div(2)
    if q >= 0 {
        return root_to_odd(n, d.shl(u64.wrap(2 * q))).shl(u64.wrap(q)).div_f64(BigInt.from(1))
    }
    return root_to_odd(n.shl(u64.wrap(-2 * q)), d).div_f64(BigInt.from(1).shl(u64.wrap(0 - q)))
}

/// The integer square root of `n / d`, with its lowest bit set when it isn't exact.
fn root_to_odd(n: BigInt, d: BigInt) -> BigInt {
    let a = (n / d).isqrt()
    if a.is_even() and a * a * d != n {
        return a + 1
    }
    return a
}

/// The count times the sum of squared differences from the mean, exactly, as one integer times
/// 2^e: the count times the sum of squares less the square of the sum. `none` with an infinity or
/// a NaN among the values, or a square too big for an `f64`.
fn scaled_squares(xs: List<f64>) -> (BigInt, i64)? {
    var s1: List<f64> = []
    var s2: List<f64> = []
    for x in xs {
        let hi = x * x
        if hi - hi != 0.0 {
            return none
        }
        add_exact(mut s1, x)
        // x² is exactly hi + lo, the rounded square and what rounding left out.
        add_exact(mut s2, hi)
        add_exact(mut s2, x.mul_add(x, -hi))
    }
    let (a, ea) = exact(s1)
    let (b, eb) = exact(s2)
    let left = count_of(xs) * b
    let right = a * a
    let low = eb.min(2 * ea)
    return some((left.shl(u64.wrap(eb - low)) - right.shl(u64.wrap(2 * ea - low)), low))
}

/// The sum of products, correctly rounded, as Python's `math.sumprod` gives it.
fn sumprod(xs: List<f64>, ys: List<f64>) -> f64 {
    var partials: List<f64> = []
    var plain = 0.0
    var any_plain = false
    for i in 0..xs.len() {
        let hi = xs[i] * ys[i]
        if hi - hi != 0.0 {
            plain += hi
            any_plain = true
        } else {
            add_exact(mut partials, hi)
            add_exact(mut partials, xs[i].mul_add(ys[i], -hi))
        }
    }
    if any_plain {
        return plain + rounded(partials)
    }
    return rounded(partials)
}

/// The square root of `x * y`, without overflowing or underflowing on the way, and corrected once
/// for rounding, as Python's `_sqrtprod`.
fn sqrt_product(x: f64, y: f64) -> f64 {
    let h = (x * y).sqrt()
    if h - h != 0.0 {
        if h == f64.INFINITY and x - x == 0.0 and y - y == 0.0 {
            let scale = f64.from_bits(0x1FF0000000000000)  // 2^-512
            return sqrt_product(scale * x, scale * y) / scale
        }
        return h
    }
    if h == 0.0 {
        if x != 0.0 and y != 0.0 {
            let scale = f64.from_bits(0x6180000000000000)  // 2^537
            return sqrt_product(scale * x, scale * y) / scale
        }
        return h
    }
    let hs: List<f64> = [x, h]
    let ks: List<f64> = [y, -h]
    let d = sumprod(hs, ks)
    return h + d / (2.0 * h)
}

// --- helpers -----------------------------------------------------------------------------------

fn count_of(xs: List<f64>) -> BigInt {
    return BigInt.from(u64(xs.len()))
}

fn sorted(xs: List<f64>) -> List<f64> {
    var s = xs.copy()
    s.sort_by(|a, b| a.total_cmp(b))
    return s
}

fn deviations(xs: List<f64>, m: f64) -> List<f64> {
    return xs.map(|x| x - m)
}

@track_caller
fn same_length(xs: List<f64>, ys: List<f64>) {
    if xs.len() != ys.len() {
        panic("the lists have {xs.len()} and {ys.len()} values, and must have the same number")
    }
}
