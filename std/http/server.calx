/// A small HTTP/1.1 server for scripts, as Python's `http.server` is: requests from as many
/// connections as come, handed to the program one at a time by `next`, on std.net's event loop,
/// and `serve_dir`, which serves a folder's files as `python -m http.server` does. It pushes to
/// a browser too, over a WebSocket, as Python's `websockets.serve` does, or as a stream of
/// events, `text/event-stream`, which a browser's `EventSource` reads.
///
/// It listens on loopback, `127.0.0.1`, unless it's given another address, so only programs on
/// the same machine reach it, and Windows' firewall never asks about it.
module std.http.server

import std.bytes.{base64, from_base64}
import std.env.{os}
import std.fs.{File, Kind, Metadata, is_dir, kind, list, open_read}
import std.hash.{sha1}
import std.html.{escape}
import std.io.{flush}
import std.http.{Header}
import std.http.websocket.{Message}
import std.net.{Conn, Event, Net, NetError, Waker}
import std.process.{processors}
import std.thread.{Task}
import std.time.{DateTime, Instant, Timestamp}
import std.url.{decode, encode}

/// A request, as `next` gives it.
pub struct Request {
    /// `GET`, `POST` or another method, as it was sent.
    pub method: String
    /// The path and query as they were sent, still percent-encoded: `/find?q=a%20b`.
    pub target: String
    /// The path, percent-decoded, without the query: `/find`.
    pub path: String
    /// What's after the `?`, as it was sent, or `""`.
    pub query: String
    /// `HTTP/1.1` or `HTTP/1.0`.
    pub version: String
    /// The headers, in the order they came.
    pub headers: List<Header>
    /// The body, as `Content-Length` or chunks gave it, or empty.
    pub body: List<u8>
    /// The client's address: `127.0.0.1`.
    pub client: String
    conn: Conn
    keep: bool
    line: String
}

impl Request {
    /// The value of the first header named `name`, in any case, or `none`.
    pub fn header(self, name: String) -> String? {
        for h in self.headers {
            if same_name(h.name, name) {
                return some(h.value.copy())
            }
        }
        return none
    }

    /// The body as text, or `none` if it isn't UTF-8.
    pub fn text(self) -> String? {
        return String.from_utf8(self.body.copy())
    }
}

/// A response to a request: its status, headers and body. `respond` adds `Content-Length`,
/// `Date` and `Server` headers.
pub struct Response {
    pub status: u16
    pub headers: List<Header>
    pub body: List<u8>
}

impl Response {
    /// A response with `body`, whose `Content-Type` is `type_name`.
    pub fn new(status: u16, type_name: String, body: own List<u8>) -> Response {
        var headers = List<Header>()
        headers.push(Header { name: "Content-Type", value: type_name.copy() })
        return Response { status: status, headers: headers, body: body }
    }

    /// Plain text, as `text/plain; charset=utf-8`.
    pub fn text(body: String, status: u16 = 200) -> Response {
        return Response.new(status, "text/plain; charset=utf-8", body.to_bytes())
    }

    /// A page, as `text/html; charset=utf-8`.
    pub fn html(body: String, status: u16 = 200) -> Response {
        return Response.new(status, "text/html; charset=utf-8", body.to_bytes())
    }

    /// JSON, as `application/json`.
    pub fn json(body: String, status: u16 = 200) -> Response {
        return Response.new(status, "application/json", body.to_bytes())
    }

    /// A short page that says what went wrong: `404 Not Found`, and `message` if there is one.
    pub fn error(status: u16, message: String = "") -> Response {
        let what = "{status} {reason(status)}"
        var page = String("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>")
        page.push_str(what)
        page.push_str("</title>\n</head>\n<body>\n<h1>")
        page.push_str(what)
        page.push_str("</h1>\n")
        if not message.is_empty() {
            page.push_str("<p>")
            page.push_str(escape(message, false))
            page.push_str("</p>\n")
        }
        page.push_str("</body>\n</html>\n")
        return Response.html(page, status)
    }

    /// A redirect to `location`, `302 Found` unless another status is given.
    pub fn redirect(location: String, status: u16 = 302) -> Response {
        var headers = List<Header>()
        headers.push(Header { name: "Location", value: location.copy() })
        return Response { status: status, headers: headers, body: List<u8>() }
    }

    /// The response with one more header.
    pub fn with_header(own self, name: String, value: String) -> Response {
        var r = self
        r.headers.push(Header { name: name.copy(), value: value.copy() })
        return r
    }
}

/// A WebSocket connection that `upgrade` gave, which `send_text`, `send_binary` and
/// `close_socket` take and `next_event` names. It stands for the connection the server keeps, so
/// it can be copied, compared, and kept in a list or a map. Once the connection has closed, what's
/// sent to it is dropped.
pub struct ServerSocket {
    conn: Conn
}

impl ServerSocket {
    /// A number for the connection, which no other connection open at the same time has, for a
    /// map's key.
    pub fn id(self) -> u32 {
        return self.conn.id()
    }
}

/// A stream of events, `text/event-stream`, that `stream` started, which `send_event` writes to
/// and a browser's `EventSource` reads. It can be copied and compared, as a `ServerSocket` can.
pub struct EventStream {
    conn: Conn
}

impl EventStream {
    /// A number for the connection, which no other connection open at the same time has.
    pub fn id(self) -> u32 {
        return self.conn.id()
    }
}

/// What `next_event` gives: a request, or what happened on a WebSocket or an event stream.
pub enum ServerEvent {
    /// A request, as `next` gives it.
    Request(Request)
    /// A whole message from a WebSocket, its frames joined: text, which the server has checked
    /// is UTF-8, or bytes.
    Message(ServerSocket, Message)
    /// A WebSocket that closed, with the code and reason it ended with: the client's close, the
    /// server's own when the client broke the protocol (1002), sent text that isn't UTF-8 (1007)
    /// or a message longer than `max_message` (1009), or 1006 and `""` when the connection ended
    /// without a close. It's the last event for the socket.
    Closed(ServerSocket, u16, String)
    /// An event stream whose browser went away, or that `end_stream` ended. It's the last event
    /// for the stream.
    Ended(EventStream)
}

/// Why `upgrade` didn't make a request a WebSocket. It answered the request with the status that
/// says so, except for `Gone`.
pub enum UpgradeError {
    /// The request isn't a WebSocket handshake: a `GET` by HTTP/1.1 with `Upgrade: websocket`,
    /// `Connection: Upgrade`, and a `Sec-WebSocket-Key` of 16 bytes in base64. It got
    /// `400 Bad Request`.
    NotWebSocket
    /// It asked for a version of the protocol other than 13, RFC 6455's. It got
    /// `426 Upgrade Required`, with `Sec-WebSocket-Version: 13`.
    Version
    /// It came from a page of another site, whose `Origin` this is, and that isn't one of the
    /// origins `upgrade` was given. It got `403 Forbidden`.
    Origin(String)
    /// The request was answered already, or its connection closed.
    Gone
}

/// What went wrong, in words.
impl Display for UpgradeError {
    fn show(self) {
        match self {
            NotWebSocket => print("not a WebSocket handshake"),
            Version => print("not version 13 of the WebSocket protocol"),
            Origin(o) => print("a page from {o}, which isn't allowed"),
            Gone => print("the request was answered already, or its connection closed"),
        }
    }
}

// What a connection is: one for HTTP requests, a WebSocket, or an event stream.
const KIND_HTTP: u8 = 0
const KIND_SOCKET: u8 = 1
const KIND_STREAM: u8 = 2
/// How long `close_socket` waits for the client's close before it closes the connection, 5 s.
const CLOSE_WAIT_MS: u64 = 5000
/// What RFC 6455 adds to a handshake's key before it's hashed for the answer.
const WS_GUID: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

// A connection and what's come on it that isn't a request yet, or a WebSocket's frames.
struct Client {
    conn: Conn
    buf: List<u8>
    // A request was handed out and has no response yet, or the connection is closing, or it's
    // a WebSocket or an event stream now.
    busy: bool
    // `100 Continue` went out for the request coming in.
    continued: bool
    kind: u8
    // A WebSocket's message coming in frames: its opcode, or 0 when none is, and its bytes.
    op: u8
    message: List<u8>
    // The subprotocol `upgrade` chose, or `""`.
    protocol: String
    // The server sent its close, at `closed_at`, and waits for the client's.
    closing: bool
    closed_at: Instant
}

// A frame from a client, as `frame_at` read it: whether it ends its message, its opcode, where
// its payload starts and how long it is, and its mask.
struct Frame {
    fin: bool
    op: u8
    start: usize
    len: usize
    mask: [u8; 4]
}

/// A file of this size or more, 64 KiB, `serve` doesn't read: it leaves the system to send it
/// from the file, with `Net.send_file`, or sends it in parts if the system can't open it again.
const SEND_FROM: u64 = 65536
/// A part of a file `serve` sends, 1 MiB, and how much it keeps queued on a connection, 4 MiB.
const STREAM_PART: u64 = 1048576
const STREAM_QUEUED: usize = 4194304

/// A server listening on a port, whose `next` gives the requests that come to it.
pub struct Server {
    /// The port it listens on, which the system picked if `listen` was given 0.
    pub port: u16
    /// The address it listens on.
    pub host: String
    /// The longest body it takes, in bytes. A longer one gets `413 Content Too Large`. 64 MB to
    /// start with.
    pub max_body: usize
    /// Whether `serve` says where it's serving and logs each request to standard error, as
    /// Python does. It does to start with.
    pub log: bool
    /// The longest message it takes from a WebSocket, in bytes. A longer one closes the socket
    /// with 1009. 64 MB to start with.
    pub max_message: usize
    net: Net
    clients: Map<u32, Client>
    ready: Deque<u32>
    events: List<Event>
    date: String
    date_second: i64
    streams: List<Stream>
    // What happened on WebSockets and event streams, for `next_event`, and how many sockets
    // wait for the client's close.
    happened: Deque<ServerEvent>
    closing: usize
}

// A file `serve` is sending in parts after its response's head: where the next part starts, how
// much is left, and whether the connection stays open after it.
struct Stream {
    conn: Conn
    file: File
    at: u64
    left: u64
    keep: bool
}

// The answer to a request from a folder: the whole response, or its head and an open file whose
// bytes, as many as the `u64`, go after it.
enum Answer {
    Whole(Response)
    Head(Response, File, u64)
}

// A worker's answer, with the request it answers.
enum Served {
    Whole(Request, Response)
    Head(Request, Response, File, u64)
}

// A thread that answers requests from the folder `dir`, as `from_dir` does but for big files,
// which it opens and leaves to be sent from the file, and hands each answer back, waking the poll.
struct FileWorker {
    jobs: Receiver<Request>
    out: Sender<Served>
    waker: Waker
    dir: String
}

impl Task for FileWorker {
    fn run(own self) {
        while let req = self.jobs.wait() {
            match answer_dir(self.dir, req, SEND_FROM - 1) {
                Whole(res) => self.out.send(Served.Whole(req, res)),
                Head(res, f, size) => self.out.send(Served.Head(req, res, f, size)),
            }
            self.waker.wake()
        }
    }
}

impl Server {
    /// A server listening on `port` of `host`: loopback unless another address is given, and a
    /// port the system picks for 0. `""` listens on every address, IPv4 and IPv6, as
    /// `python -m http.server` does.
    pub fn listen(port: u16, host: String = "127.0.0.1") -> Server ! NetError {
        let net = try Net.new()
        let p = try net.listen(host, port)
        return Server { port: p, host: host.copy(), max_body: 67108864, log: true, max_message: 67108864, net: net, clients: Map<u32, Client>(), ready: Deque<u32>(), events: List<Event>(), date: String(), date_second: -1, streams: List<Stream>(), happened: Deque<ServerEvent>(), closing: 0 }
    }

    /// The address to open in a browser: `http://127.0.0.1:8000/`.
    pub fn url(self) -> String {
        var h = if self.host.is_empty() { String("localhost") } else { self.host.copy() }
        if h.contains(":") {
            h = "[{h}]"
        }
        return "http://{h}:{self.port}/"
    }

    /// The next request, from whichever connection has one, waiting for it up to `timeout_ms`
    /// milliseconds, or forever if it's negative, and `none` if none came in that time. Each
    /// request gets one `respond`; until it does, the next request on the same connection waits,
    /// while other connections' come.
    pub fn next(mut self, timeout_ms: i64 = -1) -> Request? {
        let start = unsafe { Instant.now() }
        loop {
            if let r = self.take_ready() {
                return some(r)
            }
            let wait = self.wait_left(start, timeout_ms)
            if wait == none {
                return none
            }
            self.poll_events(wait ?? 0)
        }
    }

    /// The next thing that happens, as `next` gives requests: a request, a WebSocket's message
    /// or close, or an event stream's end, waiting up to `timeout_ms` milliseconds for it, or
    /// forever if it's negative. `none` if nothing happened in that time. What happens on
    /// sockets and streams waits for it in order, while `next` gives only the requests.
    pub fn next_event(mut self, timeout_ms: i64 = -1) -> ServerEvent? {
        let start = unsafe { Instant.now() }
        loop {
            if let h = self.happened.pop_first() {
                return some(h)
            }
            if let r = self.take_ready() {
                return some(ServerEvent.Request(r))
            }
            let wait = self.wait_left(start, timeout_ms)
            if wait == none {
                return none
            }
            self.poll_events(wait ?? 0)
        }
    }

    // How long a poll may wait, from `start` and a timeout that's negative for forever, or
    // `none` once the time is up. A socket waiting for the client's close is let go at its time,
    // so a poll waits no more than 100 ms while one does.
    fn wait_left(mut self, start: Instant, timeout_ms: i64) -> i64? {
        self.expire_closes()
        var wait = timeout_ms
        if timeout_ms >= 0 {
            let spent = i64.wrap(unsafe { Instant.now() }.nanos_since(start) / 1000000)
            if spent >= timeout_ms {
                return none
            }
            wait = timeout_ms - spent
        }
        if self.closing > 0 and (wait < 0 or wait > 100) {
            wait = 100
        }
        return some(wait)
    }

    // The next request a connection has ready, if one has.
    fn take_ready(mut self) -> Request? {
        while let id = self.ready.pop_first() {
            if let r = self.take(id) {
                return some(r)
            }
        }
        return none
    }

    // Waits up to `wait` milliseconds for the network, or forever if it's negative, and takes in
    // what came: new connections, bytes, and connections that closed.
    fn poll_events(mut self, wait: i64) {
        self.net.poll(wait, mut self.events)
        // WebSockets with bytes to read as frames, and sockets and streams that ended, which are
        // seen to after the events, since their frames come before their end.
        var sockets = List<u32>()
        var ended = List<u32>()
        for e in self.events {
            match e {
                Accepted(c) => {
                    self.clients.insert(c.id(), Client { conn: c, buf: List<u8>(), busy: false, continued: false, kind: KIND_HTTP, op: 0, message: List<u8>(), protocol: String(), closing: false, closed_at: unsafe { Instant.now() } })
                }
                Received(c) => {
                    let id = c.id()
                    if let client = mut self.clients.find(id) {
                        _ = self.net.read(c, mut client.buf)
                        if client.kind == KIND_HTTP {
                            self.ready.push_last(id)
                        } else if client.kind == KIND_SOCKET {
                            sockets.push(id)
                        } else {
                            // A browser sends nothing on an event stream.
                            client.buf.clear()
                        }
                    } else {
                        var junk = List<u8>()
                        _ = self.net.read(c, mut junk)
                    }
                }
                Closed(c) => {
                    let id = c.id()
                    if self.clients.contains(id) and self.clients[id].kind != KIND_HTTP {
                        ended.push(id)
                    } else {
                        _ = self.clients.remove(id)
                    }
                }
                Connected(_) => {}
                Woken => {}
            }
        }
        for id in sockets {
            self.read_frames(id)
        }
        for id in ended {
            self.end_client(id, 1006, String())
        }
    }

    // The client `id` let go, if it's still here, and its end told to `next_event`: a socket's
    // close with `code` and `reason`, or a stream's end.
    fn end_client(mut self, id: u32, code: u16, why: String) {
        if let client = self.clients.remove(id) {
            if client.kind == KIND_SOCKET {
                if client.closing {
                    self.closing -= 1
                }
                self.happened.push_last(ServerEvent.Closed(ServerSocket { conn: client.conn }, code, why.copy()))
            } else if client.kind == KIND_STREAM {
                self.happened.push_last(ServerEvent.Ended(EventStream { conn: client.conn }))
            }
        }
    }

    // Each socket whose close has waited `CLOSE_WAIT_MS` for the client's closed, as one that
    // ended without a close.
    fn expire_closes(mut self) {
        if self.closing == 0 {
            return
        }
        let now = unsafe { Instant.now() }
        var late = List<u32>()
        for (id, client) in self.clients {
            if client.closing and now.nanos_since(client.closed_at) / 1000000 >= CLOSE_WAIT_MS {
                late.push(id)
            }
        }
        for id in late {
            self.net.close(self.clients[id].conn)
            self.end_client(id, 1006, String())
        }
    }

    // The request in a connection's bytes, if they hold one yet. A request that's wrong gets its
    // error, and the connection is closed.
    fn take(mut self, id: u32) -> Request? {
        if not self.clients.contains(id) or self.clients[id].busy {
            return none
        }
        let c = self.clients[id].conn
        var req = Request { method: String(), target: String(), path: String(), query: String(), version: String(), headers: List<Header>(), body: List<u8>(), client: String(), conn: c, keep: false, line: String() }
        var p = Parse { status: 0, message: String(), used: 0, expect: false }
        let state = parse_request(self.clients[id].buf, self.max_body, mut req, mut p)
        if state == 0 {
            if p.expect and not self.clients[id].continued {
                let cont = "HTTP/1.1 100 Continue\r\n\r\n"
                self.net.write(c, cont.to_bytes())
                self.clients[id].continued = true
            }
            return none
        }
        if state == 2 {
            self.clients[id].busy = true
            let res = Response.error(p.status, p.message)
            self.send(c, String("GET"), false, res)
            return none
        }
        let rest = self.clients[id].buf[p.used..]
        self.clients[id].buf = rest
        self.clients[id].busy = true
        self.clients[id].continued = false
        if let a = self.net.peer(c) {
            req.client = a.ip.to_string()
        }
        return some(req)
    }

    /// `res` sent as the response to `req`, with `Content-Length`, `Date` and `Server` headers
    /// added, and no body for a `HEAD` request. The connection is closed after it if the request
    /// asked for that, came by HTTP/1.0 without `keep-alive`, or `res` has `Connection: close`.
    pub fn respond(mut self, req: Request, res: Response) {
        let id = req.conn.id()
        if not self.answerable(id) {
            return
        }
        let keep = keeps_open(req, res)
        self.send(req.conn, req.method, keep, res)
        if keep {
            self.clients[id].busy = false
            self.ready.push_last(id)
        }
    }

    // Whether the request on the connection `id` waits for its answer: the connection is open,
    // has handed out a request, and is still HTTP's.
    fn answerable(self, id: u32) -> bool {
        return self.clients.contains(id) and self.clients[id].busy and self.clients[id].kind == KIND_HTTP
    }

    /// `req` answered by making its connection a WebSocket (RFC 6455), as Python's
    /// `websockets.serve` does for each connection that asks. The socket's messages, and its
    /// close, come from `next_event`, and the server answers its pings itself.
    ///
    /// The subprotocol is the first of `protocols` that the request's `Sec-WebSocket-Protocol`
    /// offers, or none. A request from a page, which has an `Origin`, is turned away unless the
    /// page is the server's own, at the address the request was sent to, or its origin is one of
    /// `origins`, such as `"https://example.com"`; `"*"` lets every page in. It fails if the
    /// request isn't a WebSocket handshake, and answers it with the status that says why.
    pub fn upgrade(mut self, req: Request, protocols: List<String> = [], origins: List<String> = []) -> ServerSocket ! UpgradeError {
        let id = req.conn.id()
        if not self.answerable(id) {
            fail UpgradeError.Gone
        }
        let key = (req.header("Sec-WebSocket-Key") ?? String()).trim().copy()
        let key_bytes = from_base64(key.copy()) ?? List<u8>()
        let upgrade = req.header("Upgrade") ?? String()
        let connection = req.header("Connection") ?? String()
        if req.method != "GET" or req.version != "HTTP/1.1" or not has_token(upgrade, "websocket") or
            not has_token(connection, "upgrade") or key_bytes.len() != 16 {
            self.respond(req, Response.error(400, "This address is a WebSocket, which takes a WebSocket handshake."))
            fail UpgradeError.NotWebSocket
        }
        if (req.header("Sec-WebSocket-Version") ?? String()).trim() != "13" {
            self.respond(req, Response.error(426, "This WebSocket speaks version 13.").with_header("Sec-WebSocket-Version", "13"))
            fail UpgradeError.Version
        }
        if let origin = req.header("Origin") {
            if not origin_allowed(origin, req.header("Host") ?? String(), origins) {
                self.respond(req, Response.error(403, "A page from {origin} can't open this WebSocket."))
                fail UpgradeError.Origin(origin)
            }
        }
        // Each header that offers subprotocols, and each one it offers.
        var offered = List<String>()
        for h in req.headers {
            if same_name(h.name, "sec-websocket-protocol") {
                for p in h.value.split(",") {
                    offered.push(p.trim().copy())
                }
            }
        }
        var chosen = String()
        for p in protocols {
            if chosen.is_empty() and offered.contains(p) {
                chosen = p.copy()
            }
        }
        var res = Response { status: 101, headers: List<Header>(), body: List<u8>() }
        res.headers.push(Header { name: "Upgrade", value: "websocket" })
        res.headers.push(Header { name: "Connection", value: "Upgrade" })
        res.headers.push(Header { name: "Sec-WebSocket-Accept", value: base64(sha1("{key}{WS_GUID}".to_bytes())) })
        if not chosen.is_empty() {
            res.headers.push(Header { name: "Sec-WebSocket-Protocol", value: chosen.copy() })
        }
        let head = self.head_of(res, true, false)
        self.net.write(req.conn, head.to_bytes())
        self.net.flush()
        self.clients[id].kind = KIND_SOCKET
        self.clients[id].protocol = chosen
        // Frames the client sent right behind its handshake.
        if not self.clients[id].buf.is_empty() {
            self.read_frames(id)
        }
        return ServerSocket { conn: req.conn }
    }

    /// The subprotocol `upgrade` chose for the socket, or `none` if it chose none or the socket
    /// has closed.
    pub fn protocol(self, s: ServerSocket) -> String? {
        let id = s.id()
        if not self.clients.contains(id) or self.clients[id].kind != KIND_SOCKET or self.clients[id].protocol.is_empty() {
            return none
        }
        return some(self.clients[id].protocol.copy())
    }

    /// Whether the socket is open: neither the client nor `close_socket` has closed it.
    pub fn is_open(self, s: ServerSocket) -> bool {
        let id = s.id()
        return self.clients.contains(id) and self.clients[id].kind == KIND_SOCKET and not self.clients[id].closing
    }

    /// Sends a text message on the socket. `false` if it has closed or is closing, so nothing
    /// was sent.
    pub fn send_text(self, s: ServerSocket, text: String) -> bool {
        return self.send_frame(s, 1, text.to_bytes())
    }

    /// Sends a binary message on the socket. `false` if it has closed or is closing.
    pub fn send_binary(self, s: ServerSocket, bytes: List<u8>) -> bool {
        return self.send_frame(s, 2, bytes)
    }

    fn send_frame(self, s: ServerSocket, op: u8, payload: List<u8>) -> bool {
        if not self.is_open(s) {
            return false
        }
        self.net.write(s.conn, frame_head(op, payload.len()))
        if not payload.is_empty() {
            self.net.write(s.conn, payload)
        }
        self.net.flush()
        return true
    }

    /// Closes the socket with `code` and the reason `why`: the client is told, and the connection
    /// closes once it answers, or after 5 seconds, when `next_event` gives the socket's `Closed`.
    /// A reason has room for 123 bytes, and a longer one is cut at the last whole rune that fits.
    /// It panics for a code a close can't carry: one under 1000, 1004 to 1006, 1015 to 2999, or
    /// over 4999.
    @track_caller
    pub fn close_socket(mut self, s: ServerSocket, code: u16 = 1000, why: String = "") {
        if not close_code_ok(code) {
            panic("a WebSocket's close can't carry the code {code}; 1000 is a normal close, 1001 a server going away, and 4000 to 4999 are the program's own")
        }
        if not self.is_open(s) {
            return
        }
        var n = why.len().min(123)
        while n > 0 and n < why.len() and (why.byte_at(n) & 0xC0) == 0x80 {
            n -= 1
        }
        var body = List<u8>()
        body.push(u8.wrap(u32(code) >> 8))
        body.push(u8.wrap(code))
        body.extend(why.to_bytes()[0..n])
        self.net.write(s.conn, frame_head(8, body.len()))
        self.net.write(s.conn, body)
        self.net.flush()
        let id = s.id()
        self.clients[id].closing = true
        self.clients[id].closed_at = unsafe { Instant.now() }
        self.closing += 1
    }

    // The whole frames a WebSocket's client has sent, taken in turn: its messages and its close
    // for `next_event`, and its pings answered. A frame that breaks the protocol closes the
    // socket.
    fn read_frames(mut self, id: u32) {
        var at: usize = 0
        var f = Frame { fin: false, op: 0, start: 0, len: 0, mask: [0u8; 4] }
        while self.clients.contains(id) {
            let got = frame_at(self.clients[id].buf, at, self.max_message, mut f)
            if got == 0 {
                break
            }
            if got > 1 {
                self.fail_socket(id, got)
                return
            }
            at = f.start + f.len
            let payload = unmasked(self.clients[id].buf, f)
            if f.op == 9 {
                // A ping, answered with its bytes.
                if not self.clients[id].closing {
                    self.net.write(self.clients[id].conn, frame_head(10, payload.len()))
                    self.net.write(self.clients[id].conn, payload)
                    self.net.flush()
                }
                continue
            }
            if f.op == 10 {
                continue
            }
            if f.op == 8 {
                self.client_closed(id, payload)
                return
            }
            // A message's first frame, or one that goes on with it.
            if (f.op == 0) != (self.clients[id].op != 0) {
                self.fail_socket(id, 1002)
                return
            }
            if f.fin and f.op != 0 {
                // A message in one frame, as most are.
                if not self.deliver(id, f.op, payload) {
                    return
                }
                continue
            }
            if f.op != 0 {
                self.clients[id].op = f.op
            }
            if self.clients[id].message.len() + payload.len() > self.max_message {
                self.fail_socket(id, 1009)
                return
            }
            self.clients[id].message.extend(payload)
            if f.fin {
                let op = self.clients[id].op
                self.clients[id].op = 0
                let bytes = self.clients[id].message.copy()
                self.clients[id].message.clear()
                if not self.deliver(id, op, bytes) {
                    return
                }
            }
        }
        if self.clients.contains(id) and at > 0 {
            let rest = self.clients[id].buf[at..]
            self.clients[id].buf = rest
        }
    }

    // A whole message from the socket `id` given to `next_event`, or `false` if it's text that
    // isn't UTF-8, which closes the socket.
    fn deliver(mut self, id: u32, op: u8, bytes: own List<u8>) -> bool {
        let s = ServerSocket { conn: self.clients[id].conn }
        if op == 2 {
            self.happened.push_last(ServerEvent.Message(s, Message.Binary(bytes)))
            return true
        }
        if let text = String.from_utf8(bytes) {
            self.happened.push_last(ServerEvent.Message(s, Message.Text(text)))
            return true
        }
        self.fail_socket(id, 1007)
        return false
    }

    // The client's close: answered with its code, unless the server's own close went first,
    // and the connection closed. A close that isn't one RFC 6455 allows breaks the protocol.
    fn client_closed(mut self, id: u32, payload: List<u8>) {
        var code: u16 = 1005
        var why = String()
        if payload.len() == 1 {
            self.fail_socket(id, 1002)
            return
        }
        if payload.len() >= 2 {
            code = u16.wrap((u32(payload[0]) << 8) | u32(payload[1]))
            if not close_code_ok(code) {
                self.fail_socket(id, 1002)
                return
            }
            if let r = String.from_utf8(payload[2..]) {
                why = r
            } else {
                self.fail_socket(id, 1007)
                return
            }
        }
        let c = self.clients[id].conn
        if not self.clients[id].closing {
            let echo = if payload.len() >= 2 { payload[0..2] } else { List<u8>() }
            self.net.write(c, frame_head(8, echo.len()))
            self.net.write(c, echo)
        }
        self.net.close(c)
        self.end_client(id, code, why)
    }

    // The socket closed with `code`, telling the client so unless the server's close went
    // already, after a frame that broke the protocol (1002), text that isn't UTF-8 (1007) or a
    // message that's too long (1009).
    fn fail_socket(mut self, id: u32, code: u16) {
        let c = self.clients[id].conn
        if not self.clients[id].closing {
            var body = List<u8>()
            body.push(u8.wrap(u32(code) >> 8))
            body.push(u8.wrap(code))
            self.net.write(c, frame_head(8, 2))
            self.net.write(c, body)
        }
        self.net.close(c)
        self.end_client(id, code, String())
    }

    /// `req` answered with a stream of events, `text/event-stream`, which a browser's
    /// `EventSource` reads. It stays open for `send_event` until `end_stream`, or until the
    /// browser goes, when `next_event` gives its `Ended`. `headers` go with the answer, after
    /// `Content-Type: text/event-stream` and `Cache-Control: no-cache`. A browser that connects
    /// again sends `Last-Event-ID`, the `id` of the last event it had.
    pub fn stream(mut self, req: Request, headers: List<Header> = []) -> EventStream {
        let s = EventStream { conn: req.conn }
        let id = req.conn.id()
        if not self.answerable(id) {
            self.happened.push_last(ServerEvent.Ended(s))
            return s
        }
        var res = Response { status: 200, headers: List<Header>(), body: List<u8>() }
        res.headers.push(Header { name: "Content-Type", value: "text/event-stream" })
        res.headers.push(Header { name: "Cache-Control", value: "no-cache" })
        for h in headers {
            res.headers.push(h.copy())
        }
        let head = self.head_of(res, false, false)
        self.net.write(req.conn, head.to_bytes())
        self.clients[id].kind = KIND_STREAM
        self.clients[id].buf.clear()
        if req.method == "HEAD" {
            self.end_stream(s)
        } else {
            self.net.flush()
        }
        return s
    }

    /// An event sent on the stream: `data`, each of its lines a `data:` line, which the
    /// browser's `EventSource` joins with `\n`, with the `event:` name, the type its listeners
    /// listen for, and the `id:`, unless they're empty. `false` if the stream has ended, so
    /// nothing was sent. It panics if `event` or `id` has a line break.
    @track_caller
    pub fn send_event(self, s: EventStream, data: String, event: String = "", id: String = "") -> bool {
        if event.contains("\n") or event.contains("\r") or id.contains("\n") or id.contains("\r") {
            panic("an event's name and id are one line each, and this has a line break")
        }
        let k = s.id()
        if not self.clients.contains(k) or self.clients[k].kind != KIND_STREAM {
            return false
        }
        var out = String()
        out.reserve(data.len() + event.len() + id.len() + 24)
        if not event.is_empty() {
            out.push_str("event: ")
            out.push_str(event)
            out.push('\n')
        }
        if not id.is_empty() {
            out.push_str("id: ")
            out.push_str(id)
            out.push('\n')
        }
        // A line ends at `\r\n`, `\r` or `\n`, as EventSource reads them.
        var from: usize = 0
        var i: usize = 0
        while i <= data.len() {
            let b = if i < data.len() { data.byte_at(i) } else { 10u8 }
            if b == 10 or b == 13 {
                out.push_str("data: ")
                out.push_str(data[from..i])
                out.push('\n')
                if b == 13 and i + 1 < data.len() and data.byte_at(i + 1) == 10 {
                    i += 1
                }
                from = i + 1
            }
            i += 1
        }
        out.push('\n')
        self.net.write(s.conn, out.to_bytes())
        self.net.flush()
        return true
    }

    /// Ends the stream: its connection closes once what was sent has gone, and `next_event`
    /// gives its `Ended`.
    pub fn end_stream(mut self, s: EventStream) {
        let id = s.id()
        if self.clients.contains(id) and self.clients[id].kind == KIND_STREAM {
            self.net.close(s.conn)
            self.end_client(id, 1006, String())
        }
    }

    /// The folder `dir` served until the program is stopped, as `serve_dir` serves it, after a
    /// line saying where to find it, for a server that's already listening. Files are opened and
    /// read on worker threads, one for each processor up to 8, so many are served at once, and a
    /// file of 64 KiB or more isn't read: the system sends it from the file, with
    /// `Net.send_file`, so the memory it takes doesn't grow with the file. Each request is logged
    /// to standard error, unless `log` is false, which leaves out the line too.
    pub fn serve(mut self, dir: String) {
        if self.log {
            let shown = if self.host.is_empty() { String("every address") } else { self.host.copy() }
            println("Serving HTTP on {shown} port {self.port} ({self.url()}) ...")
            flush()
        }
        let waker = match self.net.waker() {
            ok(w) => w,
            err(_) => {
                // Without a waker, nothing can hand answers back, so they're made here.
                loop {
                    if let req = self.next() {
                        let res = from_dir(dir, req)
                        if self.log {
                            log_request(req, res.status)
                        }
                        self.respond(req, res)
                    }
                }
            },
        }
        let jobs = Receiver<Request>()
        var done = Receiver<Served>()
        var to_workers = jobs.sender()
        let count = usize(unsafe { processors() }).min(8).max(2)
        for _ in 0..count {
            // Each runs as long as the program does.
            _ = unsafe { Thread.spawn(FileWorker { jobs: jobs.share(), out: done.sender(), waker: waker, dir: dir.copy() }) }
        }
        loop {
            while let req = self.take_ready() {
                to_workers.send(req)
            }
            while let d = done.next() {
                self.finish(d)
            }
            self.pump()
            // An answer just sent may have let a request that came behind it through.
            if self.ready.is_empty() {
                // Files being sent are topped up as their connections take them.
                let wait: i64 = if self.streams.is_empty() { -1 } else { 1 }
                self.poll_events(wait)
            }
        }
    }

    // A worker's answer sent, and logged.
    fn finish(mut self, d: own Served) {
        match d {
            Whole(req, res) => {
                if self.log {
                    log_request(req, res.status)
                }
                self.respond(req, res)
            },
            Head(req, res, f, size) => {
                if self.log {
                    log_request(req, res.status)
                }
                self.start_stream(req, res, f, size)
            },
        }
    }

    // The head of `res`, the response to `req`, sent, then the file `f`'s `size` bytes: by the
    // system from the file, or in parts if it can't open the file again. The system's way, the
    // runtime queues the file, and what's written after it, behind what the connection is sending
    // already, so the connection's next request can be answered at once.
    fn start_stream(mut self, req: Request, res: Response, f: own File, size: u64) {
        let id = req.conn.id()
        if not self.answerable(id) {
            close_quietly(f)
            return
        }
        let keep = keeps_open(req, res)
        let head = self.head_of(res, keep)
        self.net.write(req.conn, head.to_bytes())
        if self.net.send_file(req.conn, f, 0, size) {
            close_quietly(f)
            if not keep {
                self.net.close(req.conn)
            } else {
                self.clients[id].busy = false
                self.ready.push_last(id)
            }
            return
        }
        self.streams.push(Stream { conn: req.conn, file: f, at: 0, left: size, keep: keep })
    }

    // The next parts of each file being sent, for each connection that has taken most of what was
    // queued on it. A file that's done, or can't be read, or whose connection closed, is closed.
    fn pump(mut self) {
        var i: usize = 0
        while i < self.streams.len() {
            let c = self.streams[i].conn
            var failed = not self.clients.contains(c.id())
            while not failed and self.streams[i].left > 0 and self.net.queued(c) < STREAM_QUEUED {
                let want = usize.wrap(self.streams[i].left.min(STREAM_PART))
                match self.streams[i].file.read_part(self.streams[i].at, want) {
                    ok(bytes) => {
                        let got = bytes.len()
                        self.net.write(c, bytes)
                        self.streams[i].at += u64(got)
                        self.streams[i].left -= u64(got)
                        // The file got shorter than the length its head said.
                        failed = got < want
                    },
                    err(_) => failed = true,
                }
            }
            if failed or self.streams[i].left == 0 {
                let done = self.streams.swap_remove(i)
                let keep = done.keep and not failed
                close_quietly(done.file)
                if not keep {
                    self.net.close(c)
                } else if self.clients.contains(c.id()) {
                    self.clients[c.id()].busy = false
                    self.ready.push_last(c.id())
                }
            } else {
                i += 1
            }
        }
    }

    fn send(mut self, c: Conn, method: String, keep: bool, res: Response) {
        let head = self.head_of(res, keep)
        self.net.write(c, head.to_bytes())
        let no_body = res.status < 200 or res.status == 204 or res.status == 304
        if method != "HEAD" and not no_body and not res.body.is_empty() {
            self.net.write(c, res.body)
        }
        if not keep {
            self.net.close(c)
        } else {
            // Sent now, not at the next poll, which a program might not come back to soon.
            self.net.flush()
        }
    }

    // The status line and headers of `res`, with `Server`, `Date`, `Content-Length` where it has
    // none unless `length` is false, as for a stream whose end is the connection's, and
    // `Connection: close` unless the connection stays open.
    fn head_of(mut self, res: Response, keep: bool, length: bool = true) -> String {
        let now = unsafe { Timestamp.now() }.unix_ms
        let second = now / 1000
        if second != self.date_second {
            self.date = http_date(second * 1000)
            self.date_second = second
        }
        var head = String()
        head.reserve(160 + 40 * res.headers.len())
        head.push_str("HTTP/1.1 {res.status} {reason(res.status)}\r\nServer: Calx\r\nDate: ")
        head.push_str(self.date)
        head.push_str("\r\n")
        var has_length = false
        for h in res.headers {
            if same_name(h.name, "content-length") {
                has_length = true
            }
            head.push_str(clean(h.name))
            head.push_str(": ")
            head.push_str(clean(h.value))
            head.push_str("\r\n")
        }
        let no_body = res.status < 200 or res.status == 204 or res.status == 304
        if length and not has_length and not no_body {
            head.push_str("Content-Length: {res.body.len()}\r\n")
        }
        if not keep {
            head.push_str("Connection: close\r\n")
        }
        head.push_str("\r\n")
        return head
    }
}

// The head of a frame the server sends: whole, unmasked, with `op` and a payload of `n` bytes.
fn frame_head(op: u8, n: usize) -> List<u8> {
    var out = List<u8>()
    out.push(0x80 | op)
    if n < 126 {
        out.push(u8.wrap(n))
    } else if n < 65536 {
        out.push(126)
        out.push(u8.wrap(n >> 8))
        out.push(u8.wrap(n))
    } else {
        out.push(127)
        let big = u64(n)
        for k in 0u64..8 {
            out.push(u8.wrap(big >> (56 - 8 * k)))
        }
    }
    return out
}

// The frame at `at` in a WebSocket client's bytes, into `f`: 0 if it isn't all there yet, 1 if
// it is, or the code to close the socket with: 1002 for a frame RFC 6455 doesn't allow from a
// client, and 1009 for one longer than `max`.
fn frame_at(buf: List<u8>, at: usize, max: usize, f: mut Frame) -> u16 {
    let n = buf.len() - at
    if n < 2 {
        return 0
    }
    let b0 = buf[at]
    let b1 = buf[at + 1]
    f.fin = (b0 & 0x80) != 0
    f.op = b0 & 0x0F
    var head: usize = 2
    var len = u64(b1 & 0x7F)
    if len == 126 {
        if n < 4 {
            return 0
        }
        len = (u64(buf[at + 2]) << 8) | u64(buf[at + 3])
        head = 4
    } else if len == 127 {
        if n < 10 {
            return 0
        }
        len = 0
        for k in 2usize..10 {
            len = (len << 8) | u64(buf[at + k])
        }
        head = 10
    }
    // No extension was agreed, so the reserved bits are 0. A client masks every frame. A control
    // frame comes whole, with up to 125 bytes.
    let control = f.op >= 8
    if (b0 & 0x70) != 0 or (b1 & 0x80) == 0 or (f.op > 2 and f.op < 8) or f.op > 10 or (control and (not f.fin or len > 125)) {
        return 1002
    }
    if len > u64(max) {
        return 1009
    }
    if u64(n) < u64(head + 4) + len {
        return 0
    }
    for k in 0usize..4 {
        f.mask[k] = buf[at + head + k]
    }
    f.start = at + head + 4
    f.len = usize.wrap(len)
    return 1
}

// The payload of the frame `f` in `buf`, unmasked.
fn unmasked(buf: List<u8>, f: Frame) -> List<u8> {
    var out = buf[f.start..f.start + f.len]
    for i in 0..out.len() {
        out[i] = out[i] ^ f.mask[i & 3]
    }
    return out
}

// Whether a close may carry `code`: RFC 6455 section 7.4's, with 1012 to 1014, which IANA has
// registered since, and the codes for libraries and programs, 3000 to 4999.
fn close_code_ok(code: u16) -> bool {
    if code >= 3000 and code <= 4999 {
        return true
    }
    return code >= 1000 and code <= 1014 and code != 1004 and code != 1005 and code != 1006
}

// Whether a page from `origin` may open a WebSocket: it's one of `origins`, `"*"` is, or it's the
// server's own, `http://` or `https://` and the `Host` the request was sent to.
fn origin_allowed(origin: String, host: String, origins: List<String>) -> bool {
    for o in origins {
        if o == "*" or same_name(o, origin) {
            return true
        }
    }
    let o = origin.trim()
    let h = host.trim()
    if h.is_empty() {
        return false
    }
    for scheme in ["http://", "https://"] {
        if o.len() == scheme.len() + h.len() and same_name(o[0..scheme.len()], scheme) and same_name(o[scheme.len()..], h) {
            return true
        }
    }
    return false
}

// Whether the connection stays open after `res`: the request asked for that, and `res` has no
// `Connection: close`.
fn keeps_open(req: Request, res: Response) -> bool {
    var keep = req.keep
    for h in res.headers {
        if same_name(h.name, "connection") and has_token(h.value, "close") {
            keep = false
        }
    }
    return keep
}

// What reading a request found wrong, and how far it got.
struct Parse {
    status: u16
    message: String
    used: usize
    expect: bool
}

// The request at the start of `buf`, into `req`: 0 if it isn't all there yet, 1 if it is, and 2
// if it's wrong, with the status to answer in `p`.
fn parse_request(buf: List<u8>, max_body: usize, req: mut Request, p: mut Parse) -> u8 {
    let n = buf.len()
    var at: usize = 0
    // Blank lines before a request are left out, as RFC 9112 says a server should.
    while at < n and (buf[at] == 13 or buf[at] == 10) {
        at += 1
    }
    let e = line_end(buf, at)
    if e == n {
        if n - at > 65536 {
            return refuse(mut p, 414, String())
        }
        return 0
    }
    if e - at > 65536 {
        return refuse(mut p, 414, String())
    }
    let first = text_of(buf, at, trim_cr(buf, at, e))
    if first == none {
        return refuse(mut p, 400, String("The request line isn't UTF-8."))
    }
    let line = first ?? String()
    let words = line.split_whitespace()
    var keep = false
    if words.len() >= 3 {
        let v = words[words.len() - 1].copy()
        let numbers = version_of(v)
        if numbers == none {
            return refuse(mut p, 400, "Bad request version ({v})")
        }
        let (major, minor) = numbers ?? (0u64, 0u64)
        if major >= 2 {
            return refuse(mut p, 505, "Invalid HTTP version ({v})")
        }
        keep = major == 1 and minor >= 1
        req.version = v
    }
    if words.len() == 2 {
        return refuse(mut p, 400, String("HTTP/0.9 requests aren't served."))
    }
    if words.len() != 3 {
        return refuse(mut p, 400, "Bad request syntax ({line})")
    }
    req.method = words[0].copy()
    var target = words[1].copy()
    // `//` at the start would read as a host, as in `//evil.example/`, so it's one `/`.
    if target.starts_with("//") {
        var k: usize = 0
        while k < target.len() and target.byte_at(k) == 47 {
            k += 1
        }
        let fixed = "/{target[k..]}"
        target = fixed
    }
    req.line = line.copy()
    // The headers, to a blank line.
    var pos = e + 1
    var count = 0
    loop {
        let le = line_end(buf, pos)
        if le == n {
            if n - pos > 65536 or n - at > 100 * 65536 {
                return refuse(mut p, 431, String("Line too long"))
            }
            return 0
        }
        if le - pos > 65536 {
            return refuse(mut p, 431, String("Line too long"))
        }
        let end = trim_cr(buf, pos, le)
        if end == pos {
            pos = le + 1
            break
        }
        if (buf[pos] == 32 or buf[pos] == 9) and not req.headers.is_empty() {
            // A line that goes on from the one before.
            let more = text_of(buf, pos, end) ?? String()
            let last = req.headers.len() - 1
            req.headers[last].value.push(' ')
            req.headers[last].value.push_str(more.trim())
            pos = le + 1
            continue
        }
        count += 1
        if count > 100 {
            return refuse(mut p, 431, String("Too many headers"))
        }
        var colon = pos
        while colon < end and buf[colon] != 58 {
            colon += 1
        }
        if colon == end or colon == pos {
            let what = text_of(buf, pos, end) ?? String("?")
            return refuse(mut p, 400, "Bad header line ({what})")
        }
        let name = text_of(buf, pos, colon) ?? String()
        let value = text_of(buf, colon + 1, end) ?? String()
        req.headers.push(Header { name: name.trim().copy(), value: value.trim().copy() })
        pos = le + 1
    }
    var chunked = false
    var length: usize? = none
    var expect = false
    for h in req.headers {
        if same_name(h.name, "connection") {
            if has_token(h.value, "close") {
                keep = false
            } else if has_token(h.value, "keep-alive") {
                keep = true
            }
        } else if same_name(h.name, "transfer-encoding") {
            if has_token(h.value, "chunked") {
                chunked = true
            }
        } else if same_name(h.name, "content-length") {
            let digits = h.value.trim().copy()
            if digits.is_empty() {
                return refuse(mut p, 400, String("Bad Content-Length"))
            }
            var x: u64 = 0
            for i in 0..digits.len() {
                let b = digits.byte_at(i)
                if b < 48 or b > 57 {
                    return refuse(mut p, 400, String("Bad Content-Length"))
                }
                // Past the most a body can be, the rest of the digits don't matter.
                if x <= u64(max_body) {
                    x = x * 10 + u64(b - 48)
                }
            }
            if x > u64(max_body) {
                return refuse(mut p, 413, String())
            }
            length = some(usize.wrap(x))
        } else if same_name(h.name, "expect") and h.value.trim().to_lower_root() == "100-continue" {
            expect = req.version != "HTTP/1.0"
        }
    }
    req.keep = keep
    if chunked {
        var body = List<u8>()
        var q = pos
        loop {
            let le = line_end(buf, q)
            if le == n {
                p.expect = expect
                return 0
            }
            var size: usize = 0
            var digits = 0
            var k = q
            let stop = trim_cr(buf, q, le)
            while k < stop and buf[k] != 59 {
                let b = buf[k]
                var dv: usize = 99
                if b >= 48 and b <= 57 {
                    dv = usize(b - 48)
                } else if b >= 97 and b <= 102 {
                    dv = usize(b - 87)
                } else if b >= 65 and b <= 70 {
                    dv = usize(b - 55)
                } else if b == 32 or b == 9 {
                    k += 1
                    continue
                }
                if dv == 99 or digits >= 15 {
                    return refuse(mut p, 400, String("Bad chunk size"))
                }
                size = size * 16 + dv
                digits += 1
                k += 1
            }
            if digits == 0 {
                return refuse(mut p, 400, String("Bad chunk size"))
            }
            q = le + 1
            if size == 0 {
                // The trailers, to a blank line.
                loop {
                    let te = line_end(buf, q)
                    if te == n {
                        return 0
                    }
                    let blank = trim_cr(buf, q, te) == q
                    q = te + 1
                    if blank {
                        break
                    }
                }
                break
            }
            if body.len() + size > max_body {
                return refuse(mut p, 413, String())
            }
            if n < q + size + 1 {
                p.expect = expect
                return 0
            }
            body.extend(buf[q..q + size])
            q += size
            if buf[q] == 13 {
                if q + 1 >= n {
                    return 0
                }
                q += 1
            }
            if buf[q] != 10 {
                return refuse(mut p, 400, String("Bad chunk end"))
            }
            q += 1
        }
        req.body = body
        pos = q
    } else if let len = length {
        if len > max_body {
            return refuse(mut p, 413, String())
        }
        if n < pos + len {
            p.expect = expect
            return 0
        }
        req.body = buf[pos..pos + len]
        pos += len
    }
    // The target's parts: the path, decoded, and the query.
    var path_end = target.len()
    var query = String()
    if let qm = target.find("?") {
        path_end = qm
        var qe = target.len()
        if let h = target.find("#") {
            if h > qm {
                qe = h
            }
        }
        query = target[qm + 1..qe].copy()
    }
    if let h = target.find("#") {
        if h < path_end {
            path_end = h
        }
    }
    req.path = decode(target[0..path_end].copy())
    req.query = query
    req.target = target
    p.used = pos
    return 1
}

fn refuse(p: mut Parse, status: u16, message: String) -> u8 {
    p.status = status
    p.message = message.copy()
    return 2
}

// The index of the `\n` that ends the line from `from`, or the end of `buf`.
fn line_end(buf: List<u8>, from: usize) -> usize {
    var i = from
    let n = buf.len()
    while i < n and buf[i] != 10 {
        i += 1
    }
    return i
}

// The end of the line before its `\r`, if it has one.
fn trim_cr(buf: List<u8>, from: usize, to: usize) -> usize {
    if to > from and buf[to - 1] == 13 {
        return to - 1
    }
    return to
}

fn text_of(buf: List<u8>, from: usize, to: usize) -> String? {
    return String.from_utf8(buf[from..to])
}

// `HTTP/1.1` as (1, 1), or `none` if it isn't `HTTP/` and two numbers, as Python reads it.
fn version_of(v: String) -> (u64, u64)? {
    if not v.starts_with("HTTP/") {
        return none
    }
    let rest = v[5..].copy()
    let parts = rest.split(".")
    if parts.len() != 2 {
        return none
    }
    var nums = List<u64>()
    for part in parts {
        if part.is_empty() or part.len() > 10 {
            return none
        }
        var x: u64 = 0
        for i in 0..part.len() {
            let b = part.byte_at(i)
            if b < 48 or b > 57 {
                return none
            }
            x = x * 10 + u64(b - 48)
        }
        nums.push(x)
    }
    return some((nums[0], nums[1]))
}

// Whether two header names are the same, in any case.
fn same_name(a: String, b: String) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        var x = a.byte_at(i)
        var y = b.byte_at(i)
        if x >= 65 and x <= 90 {
            x += 32
        }
        if y >= 65 and y <= 90 {
            y += 32
        }
        if x != y {
            return false
        }
    }
    return true
}

// Whether a list of tokens, such as `keep-alive, Upgrade`, has `token`, in any case.
fn has_token(value: String, token: String) -> bool {
    for part in value.split(",") {
        if same_name(part.trim().copy(), token) {
            return true
        }
    }
    return false
}

// A header's name or value without the line breaks that would end it early.
fn clean(s: String) -> String {
    if not s.contains("\r") and not s.contains("\n") {
        return s.copy()
    }
    return s.replace("\r", " ").replace("\n", " ")
}

const WEEKDAYS: [str; 7] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
const MONTHS: [str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

// A time as HTTP's headers write it: `Sun, 08 Nov 2026 11:30:00 GMT`.
fn http_date(ms: i64) -> String {
    let d = Timestamp { unix_ms: ms }.date_time(0)
    let wd = WEEKDAYS[usize.wrap(d.weekday())]
    let mon = MONTHS[usize.wrap(d.month - 1)]
    return "{wd}, {d.day:02} {mon} {d.year} {d.hour:02}:{d.minute:02}:{d.second:02} GMT"
}

// A date as `If-Modified-Since` gives it, `Sun, 08 Nov 2026 11:30:00 GMT`, in milliseconds, or
// `none` if it isn't one.
fn parse_http_date(s: String) -> i64? {
    let words = s.trim().copy().split_whitespace()
    if words.len() != 6 or words[5] != "GMT" {
        return none
    }
    let day = small_number(words[1]) ?? 0
    var month = 0
    for i in 0usize..12 {
        if words[2] == MONTHS[i] {
            month = i32.wrap(i) + 1
        }
    }
    let year = small_number(words[3]) ?? 0
    let clock = words[4].split(":")
    if day == 0 or month == 0 or year == 0 or clock.len() != 3 {
        return none
    }
    let hour = small_number(clock[0]) ?? 99
    let minute = small_number(clock[1]) ?? 99
    let second = small_number(clock[2]) ?? 99
    if let d = DateTime.new(year, month, day, hour, minute, second) {
        return some(d.timestamp(0).unix_ms)
    }
    return none
}

fn small_number(s: String) -> i32? {
    if s.is_empty() or s.len() > 4 {
        return none
    }
    var x: i32 = 0
    for i in 0..s.len() {
        let b = s.byte_at(i)
        if b < 48 or b > 57 {
            return none
        }
        x = x * 10 + i32(b - 48)
    }
    return some(x)
}

/// The reason phrase that goes with a status: `Not Found` for 404, as RFC 9110 names it, or
/// `""` for one it doesn't name.
pub fn reason(status: u16) -> str {
    return match status {
        100 => "Continue",
        101 => "Switching Protocols",
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        203 => "Non-Authoritative Information",
        204 => "No Content",
        205 => "Reset Content",
        206 => "Partial Content",
        300 => "Multiple Choices",
        301 => "Moved Permanently",
        302 => "Found",
        303 => "See Other",
        304 => "Not Modified",
        307 => "Temporary Redirect",
        308 => "Permanent Redirect",
        400 => "Bad Request",
        401 => "Unauthorized",
        402 => "Payment Required",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        406 => "Not Acceptable",
        407 => "Proxy Authentication Required",
        408 => "Request Timeout",
        409 => "Conflict",
        410 => "Gone",
        411 => "Length Required",
        412 => "Precondition Failed",
        413 => "Content Too Large",
        414 => "URI Too Long",
        415 => "Unsupported Media Type",
        416 => "Range Not Satisfiable",
        417 => "Expectation Failed",
        421 => "Misdirected Request",
        422 => "Unprocessable Content",
        425 => "Too Early",
        426 => "Upgrade Required",
        428 => "Precondition Required",
        429 => "Too Many Requests",
        431 => "Request Header Fields Too Large",
        451 => "Unavailable For Legal Reasons",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        504 => "Gateway Timeout",
        505 => "HTTP Version Not Supported",
        _ => "",
    }
}

/// The response Python's `SimpleHTTPRequestHandler` gives for `req` from the folder `dir`:
///
/// - The file at the request's path under `dir`, decoded, with `.` and `..` resolved and any
///   part that isn't a plain name left out, so nothing outside `dir` is served.
/// - For a folder, a redirect to the path with a `/` at its end if it hasn't one, then its
///   `index.html` or `index.htm` if it has one, and otherwise a page listing what's in it.
/// - `304 Not Modified` for an `If-Modified-Since` the file hasn't changed since, `404` for a
///   file that isn't there, and `501` for a method other than `GET` and `HEAD`.
pub fn from_dir(dir: String, req: Request) -> Response {
    return match answer_dir(dir, req, u64.MAX) {
        Whole(res) => res,
        Head(res, f, _) => {
            close_quietly(f)
            res
        },
    }
}

// `from_dir`'s answer, with a file bigger than `stream_from` bytes left open to be sent after the
// head.
fn answer_dir(dir: String, req: Request, stream_from: u64) -> Answer {
    if req.method != "GET" and req.method != "HEAD" {
        return Answer.Whole(Response.error(501, "Unsupported method ({req.method})"))
    }
    let trailing = req.path.ends_with("/")
    let windows = os() == "windows"
    var path = dir.copy()
    var parts = List<String>()
    for w in req.path.split("/") {
        if w.is_empty() or w == "." {
            continue
        }
        if w == ".." {
            _ = parts.pop()
            continue
        }
        parts.push(w.copy())
    }
    for w in parts {
        // No file has a NUL in its name.
        if w.contains("\u{0}") {
            return Answer.Whole(Response.error(404, "File not found"))
        }
        // A part with a drive or a `\` would name another place on Windows.
        if windows and (w.contains("\\") or w.contains(":")) {
            continue
        }
        if not path.ends_with("/") and not path.ends_with("\\") {
            path.push('/')
        }
        path.push_str(w)
    }
    // A file is opened once, and asked what it is, how long and when it changed, since each call
    // costs, and on Windows opening a file just after it was closed waits for the antivirus.
    match open_read(path) {
        ok(f) => {
            if trailing {
                close_quietly(f)
                return Answer.Whole(Response.error(404, "File not found"))
            }
            return serve_file(f, path, req, stream_from)
        }
        err(e) => {
            match e {
                IsDirectory => {}
                _ => return Answer.Whole(Response.error(404, "File not found")),
            }
        }
    }
    var raw = req.target.copy()
    var tail = String()
    if let q = raw.find("?") {
        tail = raw[q..].copy()
        raw = raw[0..q].copy()
    } else if let h = raw.find("#") {
        tail = raw[h..].copy()
        raw = raw[0..h].copy()
    }
    if not raw.ends_with("/") and not raw.ends_with("%2f") and not raw.ends_with("%2F") {
        return Answer.Whole(Response.redirect("{raw}/{tail}", 301))
    }
    for index in ["index.html", "index.htm"] {
        let candidate = join_path(path, index)
        match open_read(candidate) {
            ok(f) => return serve_file(f, candidate, req, stream_from),
            err(_) => {}
        }
    }
    return Answer.Whole(listing(path, req))
}

// The file `f`, open at `path`, as the answer to `req`, closed after it's read. A `HEAD` request
// gets its length without its bytes being read, and one bigger than `stream_from` bytes is left
// open to be sent after the head.
fn serve_file(f: own File, path: String, req: Request, stream_from: u64) -> Answer {
    var meta = Metadata { size: 0, modified: Timestamp { unix_ms: 0 }, mode: 0, kind: Kind.Other }
    match f.metadata() {
        ok(m) => meta = m,
        err(_) => {}
    }
    if not is_plain_file(meta.kind) {
        close_quietly(f)
        return Answer.Whole(Response.error(404, "File not found"))
    }
    let modified = meta.modified.unix_ms
    let seconds = if modified >= 0 { modified / 1000 } else { -((-modified + 999) / 1000) }
    if req.header("if-none-match") == none {
        if let since = req.header("if-modified-since") {
            if let ims = parse_http_date(since) {
                if seconds * 1000 <= ims {
                    close_quietly(f)
                    return Answer.Whole(Response { status: 304, headers: List<Header>(), body: List<u8>() })
                }
            }
        }
    }
    if req.method == "HEAD" or meta.size > stream_from {
        var res = Response.new(200, content_type(path), List<u8>())
        res.headers.push(Header { name: "Content-Length", value: "{meta.size}" })
        res.headers.push(Header { name: "Last-Modified", value: http_date(seconds * 1000) })
        if req.method == "HEAD" {
            close_quietly(f)
            return Answer.Whole(res)
        }
        return Answer.Head(res, f, meta.size)
    }
    match f.read_part(0, usize.wrap(meta.size)) {
        ok(bytes) => {
            close_quietly(f)
            var res = Response.new(200, content_type(path), bytes)
            res.headers.push(Header { name: "Last-Modified", value: http_date(seconds * 1000) })
            return Answer.Whole(res)
        }
        err(_) => {
            close_quietly(f)
            return Answer.Whole(Response.error(404, "File not found"))
        }
    }
}

// Closes a file only read from, where closing can't lose anything.
fn close_quietly(f: own File) {
    match f.close() {
        ok => {},
        err(_) => {},
    }
}

fn is_plain_file(k: Kind) -> bool {
    return match k {
        File => true,
        _ => false,
    }
}

fn join_path(dir: String, name: str) -> String {
    if dir.ends_with("/") or dir.ends_with("\\") {
        return "{dir}{name}"
    }
    return "{dir}/{name}"
}

// A page listing a folder, for a request whose path is the folder's.
fn listing(path: String, req: Request) -> Response {
    var names = List<String>()
    match list(path) {
        ok(ns) => names = ns,
        err(_) => return Response.error(404, "No permission to list directory"),
    }
    // In the order Python's `sort(key=str.lower)` gives.
    names.sort_by(|a, b| a.to_lower_root().cmp(b.to_lower_root()))
    let shown = escape(req.path, false)
    var page = String("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Directory listing for ")
    page.push_str(shown)
    page.push_str("</title>\n</head>\n<body>\n<h1>Directory listing for ")
    page.push_str(shown)
    page.push_str("</h1>\n<hr>\n<ul>\n")
    for name in names {
        let full = join_path(path, "")
        let entry = "{full}{name}"
        var link = name.copy()
        var label = name.copy()
        if is_dir(entry) {
            link.push('/')
            label.push('/')
        }
        match kind(entry) {
            ok(k) => {
                if let what = k {
                    match what {
                        Link => label = "{name}@",
                        _ => {}
                    }
                }
            }
            err(_) => {}
        }
        page.push_str("<li><a href=\"")
        page.push_str(encode(link))
        page.push_str("\">")
        page.push_str(escape(label, false))
        page.push_str("</a></li>\n")
    }
    page.push_str("</ul>\n<hr>\n</body>\n</html>\n")
    return Response.html(page)
}

/// The type of a file from its name's extension, as a `Content-Type` header gives it:
/// `text/html; charset=utf-8` for `.html`, `image/png` for `.png`, and
/// `application/octet-stream` for one it doesn't know.
pub fn content_type(name: String) -> String {
    var dot = name.len()
    var i = name.len()
    while i > 0 {
        i -= 1
        let b = name.byte_at(i)
        if b == 46 {
            dot = i
            break
        }
        if b == 47 or b == 92 {
            break
        }
    }
    if dot == name.len() or dot == 0 {
        return String("application/octet-stream")
    }
    let ext = name[dot + 1..].to_lower_root()
    for j in 0..TYPES.len() / 2 {
        if ext == TYPES[2 * j] {
            let t = TYPES[2 * j + 1]
            if t.starts_with("text/") {
                return "{t}; charset=utf-8"
            }
            return String(t)
        }
    }
    return String("application/octet-stream")
}

const TYPES: [str; 104] = [
    "html", "text/html", "htm", "text/html", "css", "text/css", "js", "text/javascript",
    "mjs", "text/javascript", "json", "application/json", "txt", "text/plain", "text", "text/plain",
    "log", "text/plain", "md", "text/markdown", "csv", "text/csv", "tsv", "text/tab-separated-values",
    "xml", "text/xml", "svg", "image/svg+xml", "png", "image/png", "jpg", "image/jpeg",
    "jpeg", "image/jpeg", "gif", "image/gif", "webp", "image/webp", "avif", "image/avif",
    "ico", "image/vnd.microsoft.icon", "bmp", "image/bmp", "tif", "image/tiff", "tiff", "image/tiff",
    "pdf", "application/pdf", "zip", "application/zip", "gz", "application/gzip", "tar", "application/x-tar",
    "bz2", "application/x-bzip2", "xz", "application/x-xz", "wasm", "application/wasm", "woff", "font/woff",
    "woff2", "font/woff2", "ttf", "font/ttf", "otf", "font/otf", "mp3", "audio/mpeg",
    "wav", "audio/wav", "ogg", "audio/ogg", "flac", "audio/flac", "mp4", "video/mp4",
    "webm", "video/webm", "mov", "video/quicktime", "py", "text/x-python", "c", "text/plain",
    "h", "text/plain", "sh", "application/x-sh", "toml", "application/toml", "yaml", "application/yaml",
    "yml", "application/yaml", "calx", "text/plain", "ini", "text/plain", "rss", "application/rss+xml",
]

/// The folder `dir` served on `port` of `host` until the program is stopped, as
/// `python -m http.server` serves the folder it's started in: each request answered as `from_dir`
/// answers it, and logged to standard error as Python logs it, after a line saying where to find
/// it. Loopback unless another address is given.
pub fn serve_dir(dir: String, port: u16 = 8000, host: String = "127.0.0.1") ! NetError {
    var server = try Server.listen(port, host)
    server.serve(dir)
}

// A line about a request, as Python's `log_message` writes it to standard error:
// `127.0.0.1 - - [08/Nov/2026 11:30:00] "GET / HTTP/1.1" 200 -`.
fn log_request(req: Request, status: u16) {
    let now = unsafe { Timestamp.now() }
    let d = now.date_time(unsafe { now.local_offset() })
    let mon = MONTHS[usize.wrap(d.month - 1)]
    var line = String()
    for r in req.line.runes() {
        let c = u32(r)
        if c < 0x20 or (c >= 0x7F and c < 0xA0) {
            line.push_str("\\x{c:02x}")
        } else if c == 92 {
            line.push_str("\\\\")
        } else {
            line.push(r)
        }
    }
    eprintln("{req.client} - - [{d.day:02}/{mon}/{d.year:04} {d.hour:02}:{d.minute:02}:{d.second:02}] \"{line}\" {status} -")
}
