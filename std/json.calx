/// JSON: text parsed into a tree of values, with the line and column of what's wrong when it isn't
/// JSON, values written back as compact or indented text, and `@json`, which writes a struct's
/// `to_json` and its `FromJson`, to read it from a tree or straight from text.
module std.json

import std.meta.{EnumDecl, Field, Generated, StructDecl, TypeKind, TypeRef}

/// A JSON value.
pub enum Json {
    Null
    Bool(bool)
    /// A number written without a fraction or an exponent, that fits an `i64`.
    Int(i64)
    /// One written the same way that's too big for an `i64` but fits a `u64`: from 2^63 to
    /// 2^64 - 1. With it, every `u64` comes through exactly.
    UInt(u64)
    /// One written the same way that's past both, kept exactly, as Python's `json` keeps an `int`
    /// of any size: its digits, with a `-` first if it's below zero, as the text has them. They're
    /// what `BigInt.parse` reads, and each number has one form, so `==` compares the numbers.
    Big(String)
    /// Any other number.
    Float(f64)
    Str(String)
    Array(List<Json>)
    /// An object's members, in the order the text had them. A key given twice keeps its first
    /// place and its last value, as in Python and JavaScript.
    Object(LinkedMap<String, Json>)
}

/// Why text isn't JSON, or a value isn't what `from_json` wants.
pub struct JsonError {
    pub message: String
    /// Where in the text, from 1, or 0 for an error in a value rather than in text.
    pub line: usize
    /// The rune on the line, from 1.
    pub column: usize
}

impl Display for JsonError {
    fn show(self) {
        if self.line > 0 {
            print("line {self.line}, column {self.column}: ")
        }
        print(self.message)
    }
}

/// How deep arrays and objects may nest, so that hostile text can't run the stack out.
const MAX_DEPTH: usize = 512

// --- parsing -------------------------------------------------------------------------------------

/// The JSON value in `text`, with nothing but white space around it, as RFC 8259 defines it: no
/// comments, no trailing commas, no single quotes, and no `NaN`.
pub fn parse(text: String) -> Json ! JsonError {
    var at: usize = 0
    skip_space(text, mut at)
    let v = try parse_value(text, mut at, 0)
    skip_space(text, mut at)
    if at < text.len() {
        fail error_at(text, at, "{found(text, at)} after the value, where the text should end")
    }
    return v
}

// The error at byte `at` of `text`, with its line and column.
fn error_at(text: String, at: usize, message: own String) -> JsonError {
    var line: usize = 1
    var start: usize = 0
    for i in 0..at {
        if text.byte_at(i) == 10 {
            line += 1
            start = i + 1
        }
    }
    var column: usize = 1
    for i in start..at {
        if (text.byte_at(i) & 0xC0) != 0x80 {
            column += 1
        }
    }
    return JsonError { message: message, line: line, column: column }
}

// What's at byte `at`, for an error: the rune in backquotes, or the end.
fn found(text: String, at: usize) -> String {
    if at >= text.len() {
        return "the end"
    }
    let b = text.byte_at(at)
    let n: usize = if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
    return "`{text[at..at + n]}`"
}

fn skip_space(text: String, at: mut usize) {
    while at < text.len() {
        let b = text.byte_at(at)
        if b != 32 and b != 10 and b != 13 and b != 9 {
            return
        }
        at += 1
    }
}

fn parse_value(text: String, at: mut usize, depth: usize) -> Json ! JsonError {
    if at >= text.len() {
        fail error_at(text, at, "the end, where a value should be")
    }
    let b = text.byte_at(at)
    if b == 34 {
        return Json.Str(try parse_string(text, mut at))
    }
    if b == 123 or b == 91 {
        if depth >= MAX_DEPTH {
            fail error_at(text, at, "arrays and objects nested more than {MAX_DEPTH} deep")
        }
        if b == 123 {
            return Json.Object(try parse_object(text, mut at, depth + 1))
        }
        return Json.Array(try parse_array(text, mut at, depth + 1))
    }
    if b == 45 or (b >= 48 and b <= 57) {
        return try parse_number(text, mut at)
    }
    if word(text, at, "true") {
        at += 4
        return Json.Bool(true)
    }
    if word(text, at, "false") {
        at += 5
        return Json.Bool(false)
    }
    if word(text, at, "null") {
        at += 4
        return Json.Null
    }
    fail error_at(text, at, "{found(text, at)} where a value should be")
}

// Whether `w` is at byte `at`.
fn word(text: String, at: usize, w: String) -> bool {
    if at + w.len() > text.len() {
        return false
    }
    for i in 0..w.len() {
        if text.byte_at(at + i) != w.byte_at(i) {
            return false
        }
    }
    return true
}

fn parse_array(text: String, at: mut usize, depth: usize) -> List<Json> ! JsonError {
    at += 1
    var items = List<Json>()
    skip_space(text, mut at)
    if at < text.len() and text.byte_at(at) == 93 {
        at += 1
        return items
    }
    loop {
        items.push(try parse_value(text, mut at, depth))
        skip_space(text, mut at)
        if at < text.len() {
            let b = text.byte_at(at)
            if b == 44 {
                at += 1
                skip_space(text, mut at)
                continue
            }
            if b == 93 {
                at += 1
                return items
            }
        }
        fail error_at(text, at, "{found(text, at)} in an array, where `,` or `]` should be")
    }
}

fn parse_object(text: String, at: mut usize, depth: usize) -> LinkedMap<String, Json> ! JsonError {
    at += 1
    var members = LinkedMap<String, Json>()
    skip_space(text, mut at)
    if at < text.len() and text.byte_at(at) == 125 {
        at += 1
        return members
    }
    loop {
        if at >= text.len() or text.byte_at(at) != 34 {
            fail error_at(text, at, "{found(text, at)} in an object, where a key in double quotes should be")
        }
        let key = try parse_key(text, mut at)
        skip_space(text, mut at)
        if at >= text.len() or text.byte_at(at) != 58 {
            fail error_at(text, at, "{found(text, at)} after a key, where `:` should be")
        }
        at += 1
        skip_space(text, mut at)
        let v = try parse_value(text, mut at, depth)
        members.insert(key, v)
        skip_space(text, mut at)
        if at < text.len() {
            let b = text.byte_at(at)
            if b == 44 {
                at += 1
                skip_space(text, mut at)
                continue
            }
            if b == 125 {
                at += 1
                return members
            }
        }
        fail error_at(text, at, "{found(text, at)} in an object, where `,` or `\}` should be")
    }
}

// A key, from its opening quote at `at`, interned: an array of objects repeats the same keys,
// which then share one copy, as Python's parser shares them (CLX-202). A key without escapes is
// interned straight from the text.
fn parse_key(text: String, at: mut usize) -> String ! JsonError {
    var end = at + 1
    while end < text.len() {
        let b = text.byte_at(end)
        if b == 34 {
            let key = text[at + 1..end].interned()
            at = end + 1
            return key
        }
        if b == 92 or b < 0x20 {
            break
        }
        end += 1
    }
    let key = try parse_string(text, mut at)
    return key.interned()
}

// A string, from its opening quote at `at`, with its escapes decoded. The text is UTF-8 already,
// so the runs between escapes are copied whole.
fn parse_string(text: String, at: mut usize) -> String ! JsonError {
    let open = at
    at += 1
    var start = at
    var out = String()
    loop {
        if at >= text.len() {
            fail error_at(text, open, "a string that doesn't end")
        }
        let b = text.byte_at(at)
        if b == 34 {
            out.push_str(text[start..at])
            at += 1
            return out
        }
        if b == 92 {
            out.push_str(text[start..at])
            try parse_escape(text, mut at, mut out)
            start = at
            continue
        }
        if b < 0x20 {
            fail error_at(text, at, "a control character in a string, which JSON writes as an escape, such as `\\n`")
        }
        at += 1
    }
}

// The escape at `at`, its `\` first, added to `out`.
fn parse_escape(text: String, at: mut usize, out: mut String) ! JsonError {
    let slash = at
    at += 1
    if at >= text.len() {
        fail error_at(text, slash, "a string that doesn't end")
    }
    let e = text.byte_at(at)
    at += 1
    if e == 34 or e == 92 or e == 47 {
        out.push(rune(e))
    } else if e == 110 {
        out.push('\n')
    } else if e == 116 {
        out.push('\t')
    } else if e == 114 {
        out.push('\r')
    } else if e == 98 {
        out.push('\u{8}')
    } else if e == 102 {
        out.push('\u{c}')
    } else if e == 117 {
        var cp = try hex4(text, mut at, slash)
        if cp >= 0xD800 and cp < 0xDC00 {
            // A high surrogate, which an escaped low one must follow.
            if not word(text, at, "\\u") {
                fail error_at(text, slash, "half a surrogate pair, `\\u{text[slash + 2..slash + 6]}`, without its other half")
            }
            at += 2
            let low = try hex4(text, mut at, slash)
            if low < 0xDC00 or low >= 0xE000 {
                fail error_at(text, slash, "half a surrogate pair, `\\u{text[slash + 2..slash + 6]}`, without its other half")
            }
            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)
        } else if cp >= 0xDC00 and cp < 0xE000 {
            fail error_at(text, slash, "half a surrogate pair, `\\u{text[slash + 2..slash + 6]}`, without its other half")
        }
        out.push(rune.try_from(cp) ?? '\u{FFFD}')
    } else {
        fail error_at(text, slash, "{found(text, slash + 1)} after `\\` in a string, which isn't an escape")
    }
}

fn hex4(text: String, at: mut usize, slash: usize) -> u32 ! JsonError {
    if at + 4 > text.len() {
        fail error_at(text, slash, "`\\u` without four hex digits after it")
    }
    var v: u32 = 0
    for i in 0..4usize {
        let b = u32(text.byte_at(at + i))
        let d = if b >= 48 and b <= 57 {
            b - 48
        } else if b >= 97 and b <= 102 {
            b - 87
        } else if b >= 65 and b <= 70 {
            b - 55
        } else {
            fail error_at(text, slash, "`\\u` without four hex digits after it")
        }
        v = v * 16 + d
    }
    at += 4
    return v
}

// A number, checked against JSON's grammar: `-`, digits without a leading zero, then a fraction
// and an exponent if there are. One with neither that fits an `i64` is an `Int`, one past that
// that fits a `u64` a `UInt`, and any other a `Big`.
fn parse_number(text: String, at: mut usize) -> Json ! JsonError {
    let start = at
    let negative = text.byte_at(at) == 45
    if negative {
        at += 1
    }
    let digits = at
    // The magnitude, in a u64 until it can't hold it.
    var mag: u64 = 0
    var fits = true
    while at < text.len() {
        let b = text.byte_at(at)
        if b < 48 or b > 57 {
            break
        }
        let d = u64(b - 48)
        if mag > 1844674407370955161 or (mag == 1844674407370955161 and d > 5) {
            fits = false
        } else {
            mag = mag * 10 + d
        }
        at += 1
    }
    if at == digits {
        fail error_at(text, start, "a number with no digits after its `-`")
    }
    if at - digits > 1 and text.byte_at(digits) == 48 {
        fail error_at(text, digits, "a number that starts with `0` and goes on, which JSON doesn't allow")
    }
    var whole = true
    if at < text.len() and text.byte_at(at) == 46 {
        whole = false
        at += 1
        let frac = at
        skip_digits(text, mut at)
        if at == frac {
            fail error_at(text, start, "a number with no digits after its `.`")
        }
    }
    if at < text.len() and (text.byte_at(at) == 101 or text.byte_at(at) == 69) {
        whole = false
        at += 1
        if at < text.len() and (text.byte_at(at) == 43 or text.byte_at(at) == 45) {
            at += 1
        }
        let exp = at
        skip_digits(text, mut at)
        if at == exp {
            fail error_at(text, start, "a number with no digits in its exponent")
        }
    }
    if whole and fits {
        if not negative {
            if mag <= 9223372036854775807 {
                return Json.Int(i64.wrap(mag))
            }
            return Json.UInt(mag)
        }
        if mag <= 9223372036854775808 {
            return Json.Int(i64.wrap(0 - mag))
        }
    }
    if whole {
        return Json.Big(text[start..at].copy())
    }
    return Json.Float(f64.parse(text[start..at]) ?? 0.0)
}

fn skip_digits(text: String, at: mut usize) {
    while at < text.len() and text.byte_at(at) >= 48 and text.byte_at(at) <= 57 {
        at += 1
    }
}

// --- writing -------------------------------------------------------------------------------------

/// `{v}` is the value as compact JSON, with no white space: what `JSON.stringify` writes.
impl Display for Json {
    fn show(self) {
        var out = String()
        write_json(mut out, self, false, 0, 0)
        print(out)
    }
}

/// `value` as JSON indented by `indent` spaces a level, as Python's `json.dumps(v, indent=2)`
/// writes it, with a key's value after `: ` and each array's element and object's member on a
/// line of its own. An empty array or object is `[]` or `\{\}`. An `indent` of 0 puts them on lines
/// of their own all the same, without indenting them, as Python's `indent=0` does.
pub fn pretty(value: Json, indent: usize) -> String {
    var out = String()
    write_json(mut out, value, true, indent, 0)
    return out
}

/// `value` with each object's members in the order of their keys, all the way down, as Python's
/// `json.dumps(v, sort_keys=True)` writes them: `pretty(sort_keys(v), 2)`. Keys are ordered by
/// their UTF-8 bytes, which is the order of their code points, as Python orders them.
pub fn sort_keys(value: Json) -> Json {
    return match value {
        Json.Array(items) => {
            var out = List<Json>()
            out.reserve(items.len())
            for item in items {
                out.push(sort_keys(item))
            }
            Json.Array(out)
        },
        Json.Object(members) => {
            var keys = List<String>()
            keys.reserve(members.len())
            for (k, _) in members {
                keys.push(k.copy())
            }
            keys.sort()
            var out = LinkedMap<String, Json>()
            out.reserve(keys.len())
            for k in keys {
                let v = sort_keys(members[k])
                out.insert(k.copy(), v)
            }
            Json.Object(out)
        },
        _ => value.copy(),
    }
}

// The value at the rest of a pointer, the part from `at`, which is just after a `/`.
fn find(v: Json, path: String, at: usize) -> Json? {
    var end = at
    while end < path.len() and path.byte_at(end) != b'/' {
        end += 1
    }
    var token = path[at..end]
    if token.contains("~") {
        token = token.replace("~1", "/").replace("~0", "~")
    }
    let last = end == path.len()
    match v {
        Json.Object(members) => {
            if not members.contains(token) {
                return none
            }
            return if last { some(members[token].copy()) } else { find(members[token], path, end + 1) }
        },
        Json.Array(items) => {
            // An index is digits without a leading 0, or `0` itself.
            let n = token.len()
            if n == 0 or n > 19 or (n > 1 and token.byte_at(0) == b'0') {
                return none
            }
            var i: u64 = 0
            for k in 0usize..n {
                let d = token.byte_at(k)
                if d < b'0' or d > b'9' {
                    return none
                }
                i = i * 10 + u64(d - b'0')
            }
            if i >= u64(items.len()) {
                return none
            }
            let j = usize.wrap(i)
            return if last { some(items[j].copy()) } else { find(items[j], path, end + 1) }
        },
        _ => return none,
    }
}

// Adds `v` to `out`: compact, or with each element and member on a line of its own, `indent`
// spaces a level and `level` levels in.
fn write_json(out: mut String, v: Json, indented: bool, indent: usize, level: usize) {
    match v {
        Json.Null => out.push_str("null"),
        Json.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Json.Int(n) => out.push_str("{n}"),
        Json.UInt(n) => out.push_str("{n}"),
        Json.Big(digits) => out.push_str(digits),
        Json.Float(f) => {
            // JSON has no NaN or infinity; JavaScript writes them as null too.
            if f - f == 0.0 {
                out.push_str("{f}")
            } else {
                out.push_str("null")
            }
        },
        Json.Str(s) => write_string(mut out, s),
        Json.Array(items) => {
            if items.is_empty() {
                out.push_str("[]")
                return
            }
            out.push('[')
            var first = true
            for item in items {
                if not first {
                    out.push(',')
                }
                first = false
                new_line(mut out, indented, indent, level + 1)
                write_json(mut out, item, indented, indent, level + 1)
            }
            new_line(mut out, indented, indent, level)
            out.push(']')
        },
        Json.Object(members) => {
            if members.is_empty() {
                out.push_str("\{\}")
                return
            }
            out.push('{')
            var first = true
            for (k, value) in members {
                if not first {
                    out.push(',')
                }
                first = false
                new_line(mut out, indented, indent, level + 1)
                write_string(mut out, k)
                out.push(':')
                if indented {
                    out.push(' ')
                }
                write_json(mut out, value, indented, indent, level + 1)
            }
            new_line(mut out, indented, indent, level)
            out.push('}')
        },
    }
}

fn new_line(out: mut String, indented: bool, indent: usize, level: usize) {
    if not indented {
        return
    }
    out.push('\n')
    for _ in 0..indent * level {
        out.push(' ')
    }
}

// Adds `s` as a JSON string: `"` and `\` escaped, and each control character, as `\n` and the like
// or `\u00XX`. Everything else is written as itself, so text that isn't ASCII stays UTF-8.
fn write_string(out: mut String, s: String) {
    out.reserve(s.len() + 2)
    out.push('"')
    var start: usize = 0
    for i in 0..s.len() {
        let b = s.byte_at(i)
        if b >= 0x20 and b != 34 and b != 92 {
            continue
        }
        out.push_str(s[start..i])
        start = i + 1
        if b == 34 {
            out.push_str("\\\"")
        } else if b == 92 {
            out.push_str("\\\\")
        } else if b == 10 {
            out.push_str("\\n")
        } else if b == 13 {
            out.push_str("\\r")
        } else if b == 9 {
            out.push_str("\\t")
        } else if b == 8 {
            out.push_str("\\b")
        } else if b == 12 {
            out.push_str("\\f")
        } else {
            let hex = "0123456789abcdef"
            out.push_str("\\u00")
            out.push(rune(hex.byte_at(usize(u32(b) >> 4))))
            out.push(rune(hex.byte_at(usize(u32(b) & 15))))
        }
    }
    out.push_str(s[start..])
    out.push('"')
}

// --- reading values ------------------------------------------------------------------------------

impl Json {
    /// A copy of the member `key`'s value, if this is an object that has one. A `match` on the
    /// value reads it in place instead, without the copy.
    pub fn get(self, key: String) -> Json? {
        return match self {
            Json.Object(members) => if let v = members.find(key) { some(v.copy()) } else { none },
            _ => none,
        }
    }

    /// A copy of element `i`, if this is an array that long.
    pub fn at(self, i: usize) -> Json? {
        return match self {
            Json.Array(items) => if i < items.len() { some(items[i].copy()) } else { none },
            _ => none,
        }
    }

    /// A copy of the value a JSON Pointer names, as RFC 6901 reads one and serde_json's `pointer`
    /// does: `/downloads/server/url` is member `url` of member `server` of member `downloads`, and
    /// `/versions/0` is an array's first element. `~1` in a name is `/` and `~0` is `~`. The empty
    /// pointer is the whole value. `none` if something on the way isn't there, or the pointer
    /// doesn't start with `/`. Only what's found is copied.
    pub fn pointer(self, path: String) -> Json? {
        if path.is_empty() {
            return some(self.copy())
        }
        if path.byte_at(0) != b'/' {
            return none
        }
        return find(self, path, 1)
    }

    /// The text, if this is a string.
    pub fn as_str(self) -> String? {
        return match self {
            Json.Str(s) => some(s.copy()),
            _ => none,
        }
    }

    /// The number, if this is one written as an integer that fits an `i64`.
    pub fn as_i64(self) -> i64? {
        return match self {
            Json.Int(n) => some(n),
            _ => none,
        }
    }

    /// The number, if this is one written as an integer from 0 that fits a `u64`.
    pub fn as_u64(self) -> u64? {
        return match self {
            Json.Int(n) => if n >= 0 { some(u64.wrap(n)) } else { none },
            Json.UInt(n) => some(n),
            _ => none,
        }
    }

    /// The number, if this is one, as the nearest `f64`: an infinity for a `Big` past `f64`'s
    /// range, where Python's `float` raises `OverflowError`.
    pub fn as_f64(self) -> f64? {
        return match self {
            Json.Int(n) => some(f64.nearest(n)),
            Json.UInt(n) => some(f64.nearest(n)),
            Json.Big(digits) => f64.parse(digits),
            Json.Float(f) => some(f),
            _ => none,
        }
    }

    /// The value, if this is `true` or `false`.
    pub fn as_bool(self) -> bool? {
        return match self {
            Json.Bool(b) => some(b),
            _ => none,
        }
    }

    /// Whether this is `null`.
    pub fn is_null(self) -> bool {
        return match self {
            Json.Null => true,
            _ => false,
        }
    }

    /// How many elements an array has, or members an object has. Anything else has none.
    pub fn len(self) -> usize {
        return match self {
            Json.Array(items) => items.len(),
            Json.Object(members) => members.len(),
            _ => 0,
        }
    }

    /// An object's keys, in order, or none for anything else.
    pub fn keys(self) -> List<String> {
        var out = List<String>()
        if let Json.Object(members) = self {
            out.reserve(members.len())
            for (k, _) in members {
                out.push(k.copy())
            }
        }
        return out
    }

    /// Calls `f` with each value in this one and its JSON Pointer, as `pointer` reads one: this
    /// value first, with the empty pointer, then each element's or member's, depth first, in
    /// order. The values are given where they are, not copied, and the pointers are one string
    /// that the walk adds to and takes back, so `f` copies one it keeps.
    pub fn walk(self, f: FnMut(String, Json)) {
        var path = String()
        walk_from(self, mut path, f)
    }

    /// What kind of value this is, for messages: `null`, `a bool`, `a number`, `a string`, `an
    /// array` or `an object`.
    pub fn kind(self) -> String {
        return match self {
            Json.Null => "null",
            Json.Bool(_) => "a bool",
            Json.Int(_) => "a number",
            Json.UInt(_) => "a number",
            Json.Big(_) => "a number",
            Json.Float(_) => "a number",
            Json.Str(_) => "a string",
            Json.Array(_) => "an array",
            Json.Object(_) => "an object",
        }
    }
}

// `v.walk(f)`: `v`, at `path`, then what's in it.
fn walk_from<F: FnMut(String, Json)>(v: Json, path: mut String, f: F) {
    f(path, v)
    let at = path.len()
    match v {
        Json.Array(items) => {
            for i in 0..items.len() {
                path.push_str("/{i}")
                walk_from(items[i], mut path, f)
                path.truncate(at)
            }
        },
        Json.Object(members) => {
            for (k, x) in members {
                path.push('/')
                add_token(k, mut path)
                walk_from(x, mut path, f)
                path.truncate(at)
            }
        },
        _ => {},
    }
}

// A member's name in a pointer, with `~` as `~0` and `/` as `~1`.
fn add_token(k: String, path: mut String) {
    if not k.contains("~") and not k.contains("/") {
        path.push_str(k)
        return
    }
    for r in k.runes() {
        if r == '~' {
            path.push_str("~0")
        } else if r == '/' {
            path.push_str("~1")
        } else {
            path.push(r)
        }
    }
}

// --- what @json's code calls ---------------------------------------------------------------------

/// The error for `what`, which should be `wanted` but is `value`. `@json`'s code calls it.
pub fn json_expected(value: Json, wanted: String, what: String) -> JsonError {
    return JsonError { message: "`{what}` should be {wanted}, not {value.kind()}", line: 0, column: 0 }
}

/// The error for a member that isn't there. `@json`'s code calls it.
pub fn json_missing(what: String) -> JsonError {
    return JsonError { message: "`{what}` is missing", line: 0, column: 0 }
}

/// `value` as a `bool`, for `what`. `@json`'s code calls it.
pub fn json_bool(value: Json, what: String) -> bool ! JsonError {
    if let Json.Bool(b) = value {
        return b
    }
    fail json_expected(value, "true or false", what)
}

/// `value` as an integer from `min` to `max`, for `what`. `@json`'s code calls it.
pub fn json_int(value: Json, what: String, min: i64, max: i64) -> i64 ! JsonError {
    match value {
        Json.Int(n) => {
            if n < min or n > max {
                fail JsonError { message: "`{what}` should be from {min} to {max}, not {n}", line: 0, column: 0 }
            }
            return n
        },
        Json.UInt(n) => {
            fail JsonError { message: "`{what}` should be from {min} to {max}, not {n}", line: 0, column: 0 }
        },
        Json.Big(digits) => {
            fail JsonError { message: "`{what}` should be from {min} to {max}, not {digits}", line: 0, column: 0 }
        },
        _ => {},
    }
    fail json_expected(value, "an integer", what)
}

/// `value` as a `u64`, for `what`. `@json`'s code calls it.
pub fn json_u64(value: Json, what: String) -> u64 ! JsonError {
    match value {
        Json.Int(n) => {
            if n < 0 {
                fail JsonError { message: "`{what}` should be 0 or more, not {n}", line: 0, column: 0 }
            }
            return u64.wrap(n)
        },
        Json.UInt(n) => {
            return n
        },
        Json.Big(digits) => {
            let limit = if digits.starts_with("-") { "0 or more" } else { "at most 18446744073709551615" }
            fail JsonError { message: "`{what}` should be {limit}, not {digits}", line: 0, column: 0 }
        },
        _ => {},
    }
    fail json_expected(value, "an integer", what)
}

/// `n` as a JSON number: an `Int` if it fits an `i64`, and a `UInt` if it doesn't. `@json`'s code
/// calls it.
pub fn json_from_u64(n: u64) -> Json {
    if n <= 9223372036854775807 {
        return Json.Int(i64.wrap(n))
    }
    return Json.UInt(n)
}

/// `value` as an `f64`, for `what`. `@json`'s code calls it.
pub fn json_f64(value: Json, what: String) -> f64 ! JsonError {
    return match value {
        Json.Int(n) => f64.nearest(n),
        Json.UInt(n) => f64.nearest(n),
        Json.Big(digits) => f64.parse(digits) ?? 0.0,
        Json.Float(f) => f,
        _ => {
            fail json_expected(value, "a number", what)
        },
    }
}

/// `value` as a `String`, for `what`. `@json`'s code calls it.
pub fn json_string(value: Json, what: String) -> String ! JsonError {
    if let Json.Str(s) = value {
        return s.copy()
    }
    fail json_expected(value, "a string", what)
}

// --- reading straight from text ------------------------------------------------------------------

/// What `@json` and `@json_enum` give a type, and lists of them have: reading it from a `Json`
/// tree, and straight from text, which `from_text` does.
pub interface FromJson {
    /// The value JSON describes, whose errors start with the type's name.
    fn from_json(value: Json) -> Self ! JsonError
    /// The same for a value deep in a document, whose errors start with `path`.
    fn from_json_at(value: Json, path: String) -> Self ! JsonError
    /// The value at byte `at` of `text`, nested `depth` deep, read from the text without a tree,
    /// with `at` moved past it; or `none` where the text isn't plainly one, which the tree then
    /// says why, or reads the long way.
    fn read_json(text: String, at: mut usize, depth: usize) -> Self?
}

/// The `T` JSON text describes, read straight from the text: `from_text<List<Player>>(text)`.
/// Text that isn't plainly a `T`, with escapes in its keys, say, or that isn't one at all, is read
/// into a tree first, so its errors are `parse`'s and `T.from_json`'s.
pub fn from_text<T: FromJson>(text: String) -> T ! JsonError {
    var at: usize = 0
    skip_space(text, mut at)
    if let v = T.read_json(text, mut at, 0) {
        skip_space(text, mut at)
        if at == text.len() {
            return v
        }
    }
    let value = try parse(text)
    return try T.from_json(value)
}

impl<T: FromJson> FromJson for List<T> {
    fn from_json(value: Json) -> List<T> ! JsonError {
        return try list_from_json<T>(value, "")
    }

    fn from_json_at(value: Json, path: String) -> List<T> ! JsonError {
        return try list_from_json<T>(value, path)
    }

    fn read_json(text: String, at: mut usize, depth: usize) -> List<T>? {
        if not json_read_array(text, mut at, depth) {
            return none
        }
        var out = List<T>()
        var more = not json_read_empty(text, mut at, 93)
        while more {
            let v = T.read_json(text, mut at, depth + 1) else return none
            out.push(v)
            let next = json_read_more(text, mut at, 93) else return none
            more = next
        }
        return some(out)
    }
}

// A list read from the tree. At the top, its path is empty, and its items' are `[0]` and on.
fn list_from_json<T: FromJson>(value: Json, path: String) -> List<T> ! JsonError {
    if let Json.Array(items) = value {
        var out = List<T>()
        out.reserve(items.len())
        for (i, x) in items.enumerate() {
            out.push(try T.from_json_at(x, "{path}[{i}]"))
        }
        return out
    }
    if path.is_empty() {
        fail JsonError { message: "the text should be an array, not {value.kind()}", line: 0, column: 0 }
    }
    fail json_expected(value, "an array", path)
}

// What `read_json`'s code calls, which `@json` writes. Each reads at byte `at` of `text`, and
// gives `none` or `false` where the text isn't plainly what it reads, which is then read again
// through the tree, so none of them says why.

/// Whether an object that may nest `depth` deep starts at `at`; if so, moves past its `{` and
/// the white space after it.
pub fn json_read_object(text: String, at: mut usize, depth: usize) -> bool {
    if depth >= MAX_DEPTH or at >= text.len() or text.byte_at(at) != 123 {
        return false
    }
    at += 1
    skip_space(text, mut at)
    return true
}

/// The same for an array and its `[`.
pub fn json_read_array(text: String, at: mut usize, depth: usize) -> bool {
    if depth >= MAX_DEPTH or at >= text.len() or text.byte_at(at) != 91 {
        return false
    }
    at += 1
    skip_space(text, mut at)
    return true
}

/// Whether the byte at `at` is `close`, `}` or `]`, where an object or an array that has just
/// started ends at once; if so, moves past it.
pub fn json_read_empty(text: String, at: mut usize, close: u8) -> bool {
    if at < text.len() and text.byte_at(at) == close {
        at += 1
        return true
    }
    return false
}

/// After a member or an item, past the white space: `some(true)` at a `,`, moving past it and the
/// white space after it, and `some(false)` at `close`, moving past it.
pub fn json_read_more(text: String, at: mut usize, close: u8) -> bool? {
    skip_space(text, mut at)
    if at < text.len() {
        let b = text.byte_at(at)
        if b == 44 {
            at += 1
            skip_space(text, mut at)
            return some(true)
        }
        if b == close {
            at += 1
            return some(false)
        }
    }
    return none
}

/// A string without escapes: where its text starts, with `end` where it ends, and `at` past its
/// closing quote.
pub fn json_read_name(text: String, at: mut usize, end: mut usize) -> usize? {
    if at >= text.len() or text.byte_at(at) != 34 {
        return none
    }
    let start = at + 1
    var i = start
    while i < text.len() {
        let b = text.byte_at(i)
        if b == 34 {
            end = i
            at = i + 1
            return some(start)
        }
        if b == 92 or b < 0x20 {
            return none
        }
        i += 1
    }
    return none
}

/// A member's key, as `json_read_name` reads it, with `at` past the `:` after it and the white
/// space around that.
pub fn json_read_key(text: String, at: mut usize, end: mut usize) -> usize? {
    let start = json_read_name(text, mut at, mut end) else return none
    skip_space(text, mut at)
    if at >= text.len() or text.byte_at(at) != 58 {
        return none
    }
    at += 1
    skip_space(text, mut at)
    return some(start)
}

/// Whether `null` is at `at`; if so, moves past it.
pub fn json_read_null(text: String, at: mut usize) -> bool {
    if word(text, at, "null") {
        at += 4
        return true
    }
    return false
}

/// `true` or `false`.
pub fn json_read_bool(text: String, at: mut usize) -> bool? {
    if word(text, at, "true") {
        at += 4
        return some(true)
    }
    if word(text, at, "false") {
        at += 5
        return some(false)
    }
    return none
}

/// An integer from `min` to `max`.
pub fn json_read_int(text: String, at: mut usize, min: i64, max: i64) -> i64? {
    // Most are a few digits, read here; the rest are read as `parse` reads them.
    var i = at
    let negative = i < text.len() and text.byte_at(i) == 45
    if negative {
        i += 1
    }
    let digits = i
    var mag: i64 = 0
    while i < text.len() and i - digits < 18 {
        let b = text.byte_at(i)
        if b < 48 or b > 57 {
            break
        }
        mag = mag * 10 + i64(b - 48)
        i += 1
    }
    // Digits that don't start with a `0` and go on, with nothing after them that makes the number
    // longer or not whole.
    let some_digits = i > digits and (i - digits == 1 or text.byte_at(digits) != 48)
    if some_digits and (i >= text.len() or not number_goes_on(text.byte_at(i))) {
        let n = if negative { 0 - mag } else { mag }
        if n < min or n > max {
            return none
        }
        at = i
        return some(n)
    }
    let v = read_number(text, mut at) else return none
    if let Json.Int(n) = v {
        if n >= min and n <= max {
            return some(n)
        }
    }
    return none
}

// Whether the byte after a number's digits makes it more: another digit, a `.` or an exponent.
fn number_goes_on(b: u8) -> bool {
    return (b >= 48 and b <= 57) or b == 46 or b == 101 or b == 69
}

// A number, as `parse` reads it.
fn read_number(text: String, at: mut usize) -> Json? {
    if at >= text.len() {
        return none
    }
    let b = text.byte_at(at)
    if b != 45 and (b < 48 or b > 57) {
        return none
    }
    let ok(v) = parse_number(text, mut at) else {
        return none
    }
    return some(v)
}

/// A `u64`.
pub fn json_read_u64(text: String, at: mut usize) -> u64? {
    let v = read_number(text, mut at) else return none
    return match v {
        Json.Int(n) => if n >= 0 { some(u64.wrap(n)) } else { none },
        Json.UInt(n) => some(n),
        _ => none,
    }
}

/// A number, as an `f64`.
pub fn json_read_f64(text: String, at: mut usize) -> f64? {
    let v = read_number(text, mut at) else return none
    return match v {
        Json.Int(n) => some(f64.nearest(n)),
        Json.UInt(n) => some(f64.nearest(n)),
        Json.Big(digits) => some(f64.parse(digits) ?? 0.0),
        Json.Float(f) => some(f),
        _ => none,
    }
}

/// A string, with its escapes decoded.
pub fn json_read_str(text: String, at: mut usize) -> String? {
    if at >= text.len() or text.byte_at(at) != 34 {
        return none
    }
    let ok(s) = parse_string(text, mut at) else {
        return none
    }
    return some(s)
}

/// Any value, nested `depth` deep, as `parse` reads it.
pub fn json_read_value(text: String, at: mut usize, depth: usize) -> Json? {
    let ok(v) = parse_value(text, mut at, depth) else {
        return none
    }
    return some(v)
}

/// Whether a value nested `depth` deep is at `at`, which it moves past: a member no field reads.
pub fn json_read_skip(text: String, at: mut usize, depth: usize) -> bool {
    if let ok(_) = parse_value(text, mut at, depth) {
        return true
    }
    return false
}

// --- @json ---------------------------------------------------------------------------------------

/// The error for a string at `path` that names none of an enum's variants, `names`.
/// `@json_enum`'s code calls it.
pub fn json_not_one_of(value: Json, names: String, path: String) -> JsonError {
    if let Json.Str(s) = value {
        return JsonError { message: "`{path}` should be one of {names}, not `{s}`", line: 0, column: 0 }
    }
    return json_expected(value, "one of {names}", path)
}

/// Writes `to_json(self) -> Json`, `to_json_text` and `from_json_text` for a struct, and its
/// `FromJson`, which reads it from a tree or straight from text, from its fields' types. See
/// docs/std/json.md.
@attribute("json_key")
pub fn json(decl: StructDecl) -> Generated ! String {
    if not decl.generics.is_empty() {
        fail "`@json` can't write a generic struct's JSON yet"
    }
    var w = Writer { owner: decl.name.copy(), helpers: String(), next: 0, uses: List<String>() }
    var to = String()
    var from = String()
    // `read_json`'s parts: a slot for each field, the code that reads each member into its slot,
    // and the struct made from the slots.
    var slots = String()
    var reads = String()
    var takes = String()
    var made = String()
    for f in decl.fields {
        let key = try json_key(f)
        let at = #""{path}.#{key}""#
        let put = try w.to_json(f.ty, "self.{f.name}")
        to.push_str(#"        out.insert("#{key}", #{put})"#)
        to.push('\n')
        let get = try w.from_json(f.ty, #"members["#{key}"]"#, at)
        // A missing member is `none` for an optional, the field's default if it has one, and an
        // error otherwise.
        var missing = String()
        let optional = f.ty.kind == TypeKind.Optional
        if optional {
            missing.push_str("none")
        } else if not f.default.is_empty() {
            missing.push_str(f.default)
        } else {
            w.use_name("json_missing")
            missing.push_str(#"
                    fail json_missing(#{at})
                "#)
        }
        from.push_str(#"            #{f.name}: if members.contains("#{key}") { #{get} } else { #{missing} },"#)
        from.push('\n')
        // An optional field's slot is the field's own type, since `null` and a missing member are
        // both `none`; another's holds the value once its member is read.
        let slot = "json_f_{f.name}"
        let slot_type = if optional { f.ty.text.copy() } else { "{f.ty.text}?" }
        slots.push_str("        var {slot}: {slot_type} = none\n")
        let read = if optional {
            try w.reader(f.ty, "{slot} = ", "", "depth + 1")
        } else {
            try w.reader(f.ty, "{slot} = some(", ")", "depth + 1")
        }
        if not reads.is_empty() {
            reads.push_str(" else ")
        }
        reads.push_str("if text[json_key..json_end] == \"{key}\" \{\n{read}\n            \}")
        if optional {
            made.push_str("            {f.name}: {slot},\n")
        } else if not f.default.is_empty() {
            made.push_str("            {f.name}: {slot} ?? {f.default},\n")
        } else {
            takes.push_str("        let json_r_{f.name} = {slot} else return none\n")
            made.push_str("            {f.name}: json_r_{f.name},\n")
        }
    }
    // A member no field reads is read all the same, so text that isn't JSON is never taken.
    let skip = "if not json_read_skip(text, mut at, depth + 1) \{\n                return none\n            \}"
    let key_name = if reads.is_empty() { "_json_key" } else { "json_key" }
    if reads.is_empty() {
        reads.push_str(skip)
    } else {
        reads.push_str(" else \{\n{skip}\n            \}")
    }
    for name in ["Json", "JsonError", "json_expected", "FromJson", "from_text as json_from_text", "json_read_object",
        "json_read_empty", "json_read_key", "json_read_more", "json_read_skip"] {
        w.use_name(name)
    }
    var g = Generated.new()
    g.add(w.imports())
    g.add(#"
        impl #{decl.name} {
            /// This, as JSON, as `@json` writes it.
            pub fn to_json(self) -> Json {
                var out = LinkedMap<String, Json>()
        #{to}        return Json.Object(out)
            }

            /// This, as compact JSON text.
            pub fn to_json_text(self) -> String {
                return "{self.to_json()}"
            }

            /// The value JSON text describes, read straight from the text, as `from_text` reads
            /// it, with `from_json`'s errors.
            pub fn from_json_text(text: String) -> #{decl.name} ! JsonError {
                return try json_from_text<#{decl.name}>(text)
            }
        }

        impl FromJson for #{decl.name} {
            /// The value JSON describes, as `@json` reads it: an object with a member for each
            /// field, whose others are passed over.
            fn from_json(value: Json) -> #{decl.name} ! JsonError {
                return try #{decl.name}.from_json_at(value, "#{decl.name}")
            }

            /// The same, for the value at `path` in a bigger document, which errors name.
            fn from_json_at(value: Json, path: String) -> #{decl.name} ! JsonError {
                if let Json.Object(members) = value {
                    return #{decl.name} {
        #{from}            }
                }
                fail json_expected(value, "an object", path)
            }

            /// The same, read straight from text, or `none` where it isn't plainly one.
            fn read_json(text: String, at: mut usize, depth: usize) -> #{decl.name}? {
                if not json_read_object(text, mut at, depth) {
                    return none
                }
        #{slots}        var json_end: usize = 0
                var json_more = not json_read_empty(text, mut at, 125)
                while json_more {
                    let #{key_name} = json_read_key(text, mut at, mut json_end) else return none
                    #{reads}
                    let json_next = json_read_more(text, mut at, 125) else return none
                    json_more = json_next
                }
        #{takes}        return some(#{decl.name} {
        #{made}        })
            }
        }
        "#)
    if not w.helpers.is_empty() {
        g.add(w.helpers.copy())
    }
    return g
}

/// Writes `to_json` and `FromJson` for an enum whose variants hold nothing, as their names, so a
/// field of the enum's type can be in a struct with `@json`. See docs/std/json.md.
@attribute
pub fn json_enum(decl: EnumDecl) -> Generated ! String {
    if not decl.generics.is_empty() {
        fail "`@json_enum` can't write a generic enum's JSON"
    }
    if decl.variants.is_empty() {
        fail "`@json_enum` writes an enum as the name of its variant, and `{decl.name}` has none"
    }
    var to = String()
    var from = String()
    var read = String()
    var names = String()
    for v in decl.variants {
        if not v.payload.is_empty() or not v.fields.is_empty() {
            fail "`@json_enum` writes an enum as the name of its variant, so its variants can't hold anything, as `{v.name}` does"
        }
        to.push_str(#"                    #{decl.name}.#{v.name} => "#{v.name}","#)
        to.push('\n')
        from.push_str(#"                    if s == "#{v.name}" { return #{decl.name}.#{v.name} }"#)
        from.push('\n')
        read.push_str(#"                if text[json_start..json_end] == "#{v.name}" { return some(#{decl.name}.#{v.name}) }"#)
        read.push('\n')
        if not names.is_empty() {
            names.push_str(", ")
        }
        names.push_str("`{v.name}`")
    }
    var g = Generated.new()
    g.add("import std.json.\{Json, JsonError, json_not_one_of, FromJson, json_read_name\}")
    g.add(#"
        impl #{decl.name} {
            /// This, as the name of its variant.
            pub fn to_json(self) -> Json {
                return Json.Str(match self {
        #{to}            })
            }
        }

        impl FromJson for #{decl.name} {
            /// The variant a JSON string names.
            fn from_json(value: Json) -> #{decl.name} ! JsonError {
                return try #{decl.name}.from_json_at(value, "#{decl.name}")
            }

            /// The same, for the value at `path` in a bigger document, which errors name.
            fn from_json_at(value: Json, path: String) -> #{decl.name} ! JsonError {
                if let Json.Str(s) = value {
        #{from}        }
                fail json_not_one_of(value, "#{names}", path)
            }

            /// The same, read straight from text, or `none` where it isn't plainly one.
            fn read_json(text: String, at: mut usize, depth: usize) -> #{decl.name}? {
                var json_end: usize = 0
                let json_start = json_read_name(text, mut at, mut json_end) else return none
        #{read}        return none
            }
        }
        "#)
    return g
}

// The key a field is written under: its name, or what `@json_key("...")` says.
fn json_key(f: Field) -> String ! String {
    for a in f.attributes {
        if a.name == "json_key" {
            if a.args.len() != 1 or not a.args[0].starts_with("\"") {
                fail "`@json_key` takes the key, as a string: `@json_key(\"serverPort\")`"
            }
            return a.args[0][1..a.args[0].len() - 1]
        }
    }
    return f.name.copy()
}

// What `@json` has written so far for one declaration: helper functions for lists, maps and
// optionals, and the names it needs from `std.json`.
struct Writer {
    owner: String
    helpers: String
    next: usize
    uses: List<String>
}

impl Writer {
    fn use_name(mut self, name: String) {
        for u in self.uses {
            if u == name {
                return
            }
        }
        self.uses.push(name.copy())
    }

    // Adds a helper function, on lines of its own.
    fn add_helper(mut self, code: own String) {
        self.helpers.push_str(code)
        self.helpers.push('\n')
    }

    fn imports(self) -> String {
        return "import std.json.\{{self.uses.join(", ")}\}"
    }

    fn fresh(mut self) -> String {
        self.next += 1
        return "json_{self.owner.to_lower_root()}_{self.next}"
    }

    // An expression that's `value`, of type `t`, as a `Json`.
    fn to_json(mut self, t: TypeRef, value: String) -> String ! String {
        if t.kind == TypeKind.Optional {
            let inner = try self.to_json(t.args[0], "x")
            let name = self.fresh()
            self.add_helper(#"
                fn #{name}(v: #{t.text}) -> Json {
                    return match v {
                        some(x) => #{inner},
                        none => Json.Null,
                    }
                }
                "#)
            return "{name}({value})"
        }
        if t.kind != TypeKind.Named {
            fail "`@json` can't write a `{t.text}` field yet: it writes numbers, `bool`, `String`, `Json`, lists, maps with `String` keys, optionals, and types with `@json` of their own"
        }
        let n = t.name.copy()
        if n == "bool" {
            return "Json.Bool({value})"
        }
        if n == "i64" {
            return "Json.Int({value})"
        }
        if n == "i8" or n == "i16" or n == "i32" or n == "u8" or n == "u16" or n == "u32" {
            return "Json.Int(i64({value}))"
        }
        if n == "u64" or n == "usize" {
            // Past `i64`'s range it's a number all the same, as near as an `f64` comes.
            self.use_name("json_from_u64")
            return if n == "u64" { "json_from_u64({value})" } else { "json_from_u64(u64({value}))" }
        }
        if n == "f64" {
            return "Json.Float({value})"
        }
        if n == "f32" {
            return "Json.Float(f64({value}))"
        }
        if n == "String" {
            return "Json.Str({value}.copy())"
        }
        if n == "Json" {
            return "{value}.copy()"
        }
        if n == "List" {
            let inner = try self.to_json(t.args[0], "x")
            let name = self.fresh()
            self.add_helper(#"
                fn #{name}(v: #{t.text}) -> Json {
                    var out = List<Json>()
                    out.reserve(v.len())
                    for x in v {
                        out.push(#{inner})
                    }
                    return Json.Array(out)
                }
                "#)
            return "{name}({value})"
        }
        if n == "Map" or n == "LinkedMap" or n == "SortedMap" {
            if t.args[0].text != "String" {
                fail "`@json` writes maps with `String` keys, since JSON's keys are text, not `{t.text}`"
            }
            let inner = try self.to_json(t.args[1], "x")
            let name = self.fresh()
            self.add_helper(#"
                fn #{name}(v: #{t.text}) -> Json {
                    var out = LinkedMap<String, Json>()
                    out.reserve(v.len())
                    for (k, x) in v {
                        out.insert(k.copy(), #{inner})
                    }
                    return Json.Object(out)
                }
                "#)
            return "{name}({value})"
        }
        if not t.args.is_empty() {
            fail "`@json` can't write a `{t.text}` field yet"
        }
        // A type with `@json` of its own.
        return "{value}.to_json()"
    }

    // Statements that read a `t` straight from the text at `at`, nested `depth` deep, where `depth`
    // is an expression, and give it to `put` and `close`, the code before and after the value. They
    // `return none` where the text isn't plainly a `t`.
    fn reader(mut self, t: TypeRef, put: String, close: String, depth: String) -> String ! String {
        if t.kind == TypeKind.Optional {
            self.use_name("json_read_null")
            let inner = try self.reader(t.args[0], "{put}some(", "){close}", depth)
            return "if json_read_null(text, mut at) \{\n{put}none{close}\n\} else \{\n{inner}\n\}"
        }
        if t.kind != TypeKind.Named {
            fail "`@json` can't read a `{t.text}` field yet"
        }
        let n = t.name.copy()
        var get = String()
        var value = String("json_v")
        let range = int_range(n)
        if n == "bool" {
            self.use_name("json_read_bool")
            get.push_str("json_read_bool(text, mut at)")
        } else if let (lo, hi) = range {
            self.use_name("json_read_int")
            get.push_str("json_read_int(text, mut at, {lo}, {hi})")
            if n != "i64" {
                value = "{n}.wrap(json_v)"
            }
        } else if n == "u64" or n == "usize" {
            self.use_name("json_read_u64")
            get.push_str("json_read_u64(text, mut at)")
            if n == "usize" {
                value = "usize.wrap(json_v)"
            }
        } else if n == "f64" or n == "f32" {
            self.use_name("json_read_f64")
            get.push_str("json_read_f64(text, mut at)")
            if n == "f32" {
                value = "f32.nearest(json_v)"
            }
        } else if n == "String" {
            self.use_name("json_read_str")
            get.push_str("json_read_str(text, mut at)")
        } else if n == "Json" {
            self.use_name("json_read_value")
            get.push_str("json_read_value(text, mut at, {depth})")
        } else if n == "List" {
            let inner = try self.reader(t.args[0], "json_out.push(", ")", "depth + 1")
            let name = self.fresh()
            self.use_name("json_read_array")
            self.use_name("json_read_empty")
            self.use_name("json_read_more")
            self.add_helper(#"
                fn #{name}(text: String, at: mut usize, depth: usize) -> #{t.text}? {
                    if not json_read_array(text, mut at, depth) {
                        return none
                    }
                    var json_out = #{t.text}()
                    var json_more = not json_read_empty(text, mut at, 93)
                    while json_more {
                        #{inner}
                        let json_next = json_read_more(text, mut at, 93) else return none
                        json_more = json_next
                    }
                    return some(json_out)
                }
                "#)
            get.push_str("{name}(text, mut at, {depth})")
        } else if n == "Map" or n == "LinkedMap" or n == "SortedMap" {
            let inner = try self.reader(t.args[1], "json_out.insert(text[json_key..json_end].copy(), ", ")", "depth + 1")
            let name = self.fresh()
            self.use_name("json_read_object")
            self.use_name("json_read_empty")
            self.use_name("json_read_key")
            self.use_name("json_read_more")
            self.add_helper(#"
                fn #{name}(text: String, at: mut usize, depth: usize) -> #{t.text}? {
                    if not json_read_object(text, mut at, depth) {
                        return none
                    }
                    var json_out = #{t.text}()
                    var json_end: usize = 0
                    var json_more = not json_read_empty(text, mut at, 125)
                    while json_more {
                        let json_key = json_read_key(text, mut at, mut json_end) else return none
                        #{inner}
                        let json_next = json_read_more(text, mut at, 125) else return none
                        json_more = json_next
                    }
                    return some(json_out)
                }
                "#)
            get.push_str("{name}(text, mut at, {depth})")
        } else if not t.args.is_empty() {
            fail "`@json` can't read a `{t.text}` field yet"
        } else {
            // A type with `@json` or `@json_enum` of its own.
            get.push_str("{n}.read_json(text, mut at, {depth})")
        }
        return "let json_v = {get} else return none\n{put}{value}{close}"
    }

    // An expression that's the `Json` `value` as a `t`, failing with a `JsonError` for the place
    // `what`, an expression that's a `String`.
    fn from_json(mut self, t: TypeRef, value: String, what: String) -> String ! String {
        if t.kind == TypeKind.Optional {
            let inner = try self.from_json(t.args[0], "v", "path")
            let name = self.fresh()
            // A `Json?` reads anything, so it has no place to name.
            let param = if inner.contains("path") { "path" } else { "_path" }
            self.add_helper(#"
                fn #{name}(v: Json, #{param}: String) -> #{t.text} ! JsonError {
                    if let Json.Null = v {
                        return none
                    }
                    return some(#{inner})
                }
                "#)
            return "try {name}({value}, {what})"
        }
        if t.kind != TypeKind.Named {
            fail "`@json` can't read a `{t.text}` field yet: it reads numbers, `bool`, `String`, `Json`, lists, maps with `String` keys, optionals, and types with `@json` of their own"
        }
        let n = t.name.copy()
        if n == "bool" {
            self.use_name("json_bool")
            return "try json_bool({value}, {what})"
        }
        let range = int_range(n)
        if let (lo, hi) = range {
            self.use_name("json_int")
            if n == "i64" {
                return "try json_int({value}, {what}, {lo}, {hi})"
            }
            return "{n}.wrap(try json_int({value}, {what}, {lo}, {hi}))"
        }
        if n == "u64" or n == "usize" {
            self.use_name("json_u64")
            if n == "u64" {
                return "try json_u64({value}, {what})"
            }
            return "usize.wrap(try json_u64({value}, {what}))"
        }
        if n == "f64" {
            self.use_name("json_f64")
            return "try json_f64({value}, {what})"
        }
        if n == "f32" {
            self.use_name("json_f64")
            return "f32.nearest(try json_f64({value}, {what}))"
        }
        if n == "String" {
            self.use_name("json_string")
            return "try json_string({value}, {what})"
        }
        if n == "Json" {
            return "{value}.copy()"
        }
        if n == "List" {
            let inner = try self.from_json(t.args[0], "x", #""{path}[{i}]""#)
            let name = self.fresh()
            self.add_helper(#"
                fn #{name}(v: Json, path: String) -> #{t.text} ! JsonError {
                    if let Json.Array(items) = v {
                        var out = #{t.text}()
                        out.reserve(items.len())
                        for (i, x) in items.enumerate() {
                            out.push(#{inner})
                        }
                        return out
                    }
                    fail json_expected(v, "an array", path)
                }
                "#)
            return "try {name}({value}, {what})"
        }
        if n == "Map" or n == "LinkedMap" or n == "SortedMap" {
            if t.args[0].text != "String" {
                fail "`@json` reads maps with `String` keys, since JSON's keys are text, not `{t.text}`"
            }
            let inner = try self.from_json(t.args[1], "x", #""{path}.{k}""#)
            let name = self.fresh()
            self.add_helper(#"
                fn #{name}(v: Json, path: String) -> #{t.text} ! JsonError {
                    if let Json.Object(members) = v {
                        var out = #{t.text}()
                        for (k, x) in members {
                            out.insert(k.copy(), #{inner})
                        }
                        return out
                    }
                    fail json_expected(v, "an object", path)
                }
                "#)
            return "try {name}({value}, {what})"
        }
        if not t.args.is_empty() {
            fail "`@json` can't read a `{t.text}` field yet"
        }
        return "try {n}.from_json_at({value}, {what})"
    }
}

// The range of an integer type up to `i64`'s, as the literals `@json`'s code checks against.
fn int_range(n: String) -> (String, String)? {
    return match n {
        "i8" => some(("-128", "127")),
        "i16" => some(("-32768", "32767")),
        "i32" => some(("-2147483648", "2147483647")),
        "i64" => some(("-9223372036854775807 - 1", "9223372036854775807")),
        "u8" => some(("0", "255")),
        "u16" => some(("0", "65535")),
        "u32" => some(("0", "4294967295")),
        _ => none,
    }
}
