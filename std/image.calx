/// Images in memory: read from PNG, JPEG and ICO files, changed, and written back, as Pillow
/// does it. Resizing, blurring and drawing shapes give Pillow's pixels, PNG and JPEG are read
/// as libpng and libjpeg-turbo read them, and JPEGs are written byte for byte as Pillow writes
/// them.
///
/// An `Image` holds its pixels 8 bits a channel, row by row from the top, in `pixels`.
module std.image

import std.font.{Font}
import std.fs.{read, write}
import std.image.jpeg
import std.image.jpeg.{Sampling}
import std.image.png
import std.math.{PI, atan2, cos, hypot, sin}

extern "C" {
    fn memcpy(to: *u8, from: *const u8, n: usize) -> *u8
}

/// What each pixel holds.
pub enum Kind {
    /// One byte, its brightness: Pillow's mode `L`.
    Gray
    /// Brightness, then alpha: Pillow's `LA`.
    GrayAlpha
    /// Red, green and blue: Pillow's `RGB`.
    Rgb
    /// Red, green, blue and alpha: Pillow's `RGBA`.
    Rgba
}

impl Kind {
    /// How many bytes a pixel takes: 1 for `Gray`, 2 for `GrayAlpha`, 3 for `Rgb` and 4 for
    /// `Rgba`.
    pub fn channels(self) -> usize {
        return match self {
            Gray => 1,
            GrayAlpha => 2,
            Rgb => 3,
            Rgba => 4,
        }
    }

    /// Whether its pixels have alpha.
    pub fn has_alpha(self) -> bool {
        return match self {
            GrayAlpha | Rgba => true,
            _ => false,
        }
    }
}

fn kind_of(channels: usize) -> Kind {
    return match channels {
        1 => Kind.Gray,
        2 => Kind.GrayAlpha,
        3 => Kind.Rgb,
        _ => Kind.Rgba,
    }
}

/// A color, 8 bits a channel, with its alpha: 255 is opaque and 0 clear.
pub struct Color {
    pub r: u8
    pub g: u8
    pub b: u8
    pub a: u8
}

impl Color {
    /// An opaque color.
    pub fn rgb(r: u8, g: u8, b: u8) -> Color {
        return Color { r, g, b, a: 255 }
    }

    /// A color and its alpha.
    pub fn rgba(r: u8, g: u8, b: u8, a: u8) -> Color {
        return Color { r, g, b, a }
    }

    /// An opaque gray, `v` its brightness.
    pub fn gray(v: u8) -> Color {
        return Color { r: v, g: v, b: v, a: 255 }
    }

    /// The color a CSS hex code names, with or without its `#`: `#1838D0`, `#18d`, or with alpha
    /// last, `#1838D080` and `#18d8`. `none` for anything else.
    pub fn hex(text: String) -> Color? {
        let all = text.to_bytes()
        let skip: usize = if all.len() > 0 and all[0] == 35 { 1 } else { 0 }
        let n = all.len() - skip
        if n != 3 and n != 4 and n != 6 and n != 8 {
            return none
        }
        var digits: List<u8> = []
        for i in skip..all.len() {
            let c = all[i]
            let d = if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else if c >= 65 and c <= 70 { c - 55 } else { 255u8 }
            if d == 255 {
                return none
            }
            digits.push(d)
        }
        if n <= 4 {
            let a = if n == 4 { digits[3] * 17 } else { 255u8 }
            return some(Color { r: digits[0] * 17, g: digits[1] * 17, b: digits[2] * 17, a })
        }
        let a = if n == 8 { digits[6] * 16 + digits[7] } else { 255u8 }
        return some(Color { r: digits[0] * 16 + digits[1], g: digits[2] * 16 + digits[3], b: digits[4] * 16 + digits[5], a })
    }

    /// Its brightness, as Pillow turns RGB into gray: ITU-R 601's weights in 16-bit fixed point.
    pub fn luma(self) -> u8 {
        return luma(self.r, self.g, self.b)
    }
}

fn luma(r: u8, g: u8, b: u8) -> u8 {
    return u8.wrap((u32(r) * 19595 + u32(g) * 38470 + u32(b) * 7471 + 0x8000) >> 16)
}

/// `#1838d0`, as CSS writes it, with the alpha after when it isn't 255: `#1838d080`.
impl Display for Color {
    fn show(self) {
        var s = String("#")
        var parts: List<u8> = [self.r, self.g, self.b]
        if self.a != 255 {
            parts.push(self.a)
        }
        for p in parts {
            s.push(hex_digit(p / 16))
            s.push(hex_digit(p % 16))
        }
        print(s)
    }
}

fn hex_digit(v: u8) -> rune {
    return rune(if v < 10 { v + 48 } else { v + 87 })
}

impl Equal for Color {
    fn eq(self, other: Self) -> bool {
        return self.r == other.r and self.g == other.g and self.b == other.b and self.a == other.a
    }
}

/// How `resize` works out each new pixel from the old ones near it, Pillow's filters.
pub enum Filter {
    /// The one nearest: fast, and blocky.
    Nearest
    /// The average of those it covers: the best for shrinking by a whole factor.
    Box
    /// Triangle weights over 2 pixels across each new one.
    Bilinear
    /// A Hamming-windowed sinc over 2: sharper than bilinear, as fast.
    Hamming
    /// Cubic weights over 4, Pillow's default.
    Bicubic
    /// A Lanczos-windowed sinc over 6: the sharpest.
    Lanczos
}

/// How a shape is drawn: its inside filled, its edge drawn, or both, as Pillow's `fill`,
/// `outline` and `width` give them.
pub struct Paint {
    /// The color inside the shape, or `none` to leave the inside as it is.
    pub fill: Color?
    /// The color of the edge, or `none` for no edge.
    pub outline: Color?
    /// How many pixels wide the edge is, inward from the shape's own edge. 0 draws none.
    pub width: u32
}

impl Paint {
    /// The inside filled with `color`, and no edge.
    pub fn filled(color: Color) -> Paint {
        return Paint { fill: some(color), outline: none, width: 1 }
    }

    /// Only the edge, in `color`, `width` pixels wide.
    pub fn outlined(color: Color, width: u32 = 1) -> Paint {
        return Paint { fill: none, outline: some(color), width }
    }

    /// The inside filled with `inside`, then the edge drawn over it in `edge`, `width` pixels
    /// wide.
    pub fn both(inside: Color, edge: Color, width: u32 = 1) -> Paint {
        return Paint { fill: some(inside), outline: some(edge), width }
    }
}

/// An image: its size, what each pixel holds, and the pixels.
pub struct Image {
    w: usize
    h: usize
    form: Kind
    /// The pixels, row by row from the top, each pixel's channels in turn, so pixel (x, y) starts
    /// at `(y * width + x) * channels`. Its length is `width × height × channels`; the methods
    /// panic if that's changed.
    pub pixels: List<u8>
}

impl Equal for Image {
    fn eq(self, other: Self) -> bool {
        return self.w == other.w and self.h == other.h and self.form == other.form and self.pixels == other.pixels
    }
}

/// `Image(640x480 Rgb)`.
impl Display for Image {
    fn show(self) {
        print("Image({self.w}x{self.h} {self.form})")
    }
}

impl Image {
    /// An image filled with `color`, made gray or dropping alpha as `kind` holds it. Panics for
    /// a width or height of 0.
    @track_caller
    pub fn new(width: usize, height: usize, kind: Kind, color: Color) -> Image {
        if width == 0 or height == 0 {
            panic("an image can't be {width} by {height}")
        }
        let ch = kind.channels()
        let px = pixel_bytes(kind, color)
        var pixels: List<u8> = []
        pixels.reserve(width * height * ch)
        for _ in 0usize..width * height {
            for c in 0usize..ch {
                pixels.push(px[c])
            }
        }
        return Image { w: width, h: height, form: kind, pixels }
    }

    /// An image of these pixels, as `pixels` lays them out. Panics unless there are
    /// `width × height × channels` of them, or for a width or height of 0.
    @track_caller
    pub fn from_pixels(width: usize, height: usize, kind: Kind, pixels: own List<u8>) -> Image {
        if width == 0 or height == 0 {
            panic("an image can't be {width} by {height}")
        }
        let want = width * height * kind.channels()
        if pixels.len() != want {
            panic("a {width} by {height} {kind} image is {want} bytes, not {pixels.len()}")
        }
        return Image { w: width, h: height, form: kind, pixels }
    }

    /// The image in a PNG, JPEG or ICO file, as `decode` reads it.
    pub fn open(path: String) -> Image ! Error {
        let bytes = try read(path.copy()).context("reading {path}")
        return try Image.decode(bytes).context("reading {path}")
    }

    /// The image in a PNG, JPEG or ICO file's bytes, told apart by how they start, or why it
    /// can't be read. A palette PNG comes out RGB, or RGBA if it has transparency, and a CMYK
    /// JPEG RGB, so every image is one of the four kinds. An ICO gives its largest image.
    pub fn decode(bytes: List<u8>) -> Image ! String {
        if bytes.len() >= 8 and bytes[0] == 137 and bytes[1] == 80 and bytes[2] == 78 and bytes[3] == 71 {
            let d = try png.decode(bytes)
            return Image { w: d.width, h: d.height, form: kind_of(d.channels), pixels: d.pixels }
        }
        if bytes.len() >= 3 and bytes[0] == 0xFF and bytes[1] == 0xD8 and bytes[2] == 0xFF {
            let d = try jpeg.decode(bytes)
            return Image { w: d.width, h: d.height, form: kind_of(d.channels), pixels: d.pixels }
        }
        if bytes.len() >= 6 and bytes[0] == 0 and bytes[1] == 0 and bytes[2] == 1 and bytes[3] == 0 {
            var images = try decode_ico(bytes)
            var best: usize = 0
            for i in 0usize..images.len() {
                if images[i].w * images[i].h > images[best].w * images[best].h {
                    best = i
                }
            }
            return images.swap_remove(best)
        }
        fail String("not a PNG, JPEG or ICO file")
    }

    /// Writes the image to a file in the format its name ends with: `.png`, `.jpg` or `.jpeg` at
    /// quality 75, or `.ico` with the sizes Pillow writes, 16 to 256 pixels, as many as fit in
    /// the image. A JPEG holds no alpha, so an image with alpha can't be one; drop it first
    /// with `to(Kind.Rgb)`.
    pub fn save(self, path: String) ! Error {
        let lower = path.to_lower_root()
        var bytes: List<u8> = []
        if lower.ends_with(".png") {
            bytes = self.encode_png()
        } else if lower.ends_with(".jpg") or lower.ends_with(".jpeg") {
            if self.form.has_alpha() {
                fail "can't write {path}: a JPEG holds no alpha, and the image is {self.form}"
            }
            bytes = self.encode_jpeg()
        } else if lower.ends_with(".ico") {
            var icons: List<Image> = []
            for size in [16usize, 24, 32, 48, 64, 128, 256] {
                if size <= self.w and size <= self.h {
                    icons.push(self.thumbnail(size, size, Filter.Lanczos))
                }
            }
            if icons.is_empty() {
                fail "can't write {path}: an icon is at least 16 pixels a side"
            }
            bytes = encode_ico(icons)
        } else {
            fail "can't tell what format to write {path} in; end it with .png, .jpg or .ico"
        }
        try write(path.copy(), bytes).context("writing {path}")
    }

    /// The image as a PNG file, compressed at `level`, 0 to 9, as `std.image.png.encode` writes
    /// it: 6, the default, is libpng's and Pillow's.
    pub fn encode_png(self, level: u32 = 6) -> List<u8> {
        return png.encode(self.w, self.h, self.form.channels(), self.pixels, level)
    }

    /// The image as a JPEG file, byte for byte as Pillow writes it with the same settings:
    /// `quality` from 1 to 100, `sampling` how much color to keep, `optimize` for Huffman tables
    /// made for the image, and `progressive` for a file that shows a rough picture early and
    /// sharpens as the rest comes. Panics if the image has alpha, which a JPEG can't hold.
    @track_caller
    pub fn encode_jpeg(self, quality: u32 = 75, sampling: Sampling = Sampling.S420, optimize: bool = false, progressive: bool = false) -> List<u8> {
        if self.form.has_alpha() {
            panic("a JPEG holds no alpha, and the image is {self.form}; drop it first with to(Kind.Rgb)")
        }
        return jpeg.encode(self.w, self.h, self.form.channels(), self.pixels, quality, sampling, optimize, progressive)
    }

    /// How many pixels across.
    pub fn width(self) -> usize {
        return self.w
    }

    /// How many pixels down.
    pub fn height(self) -> usize {
        return self.h
    }

    /// What each pixel holds.
    pub fn kind(self) -> Kind {
        return self.form
    }

    /// How many bytes each pixel takes.
    pub fn channels(self) -> usize {
        return self.form.channels()
    }

    @track_caller
    fn check(self) {
        if self.pixels.len() != self.w * self.h * self.form.channels() {
            panic("the image's pixels are {self.pixels.len()} bytes, not the {self.w * self.h * self.form.channels()} a {self.w} by {self.h} {self.form} image is")
        }
    }

    /// The color of pixel (x, y), from the top left: gray as R, G and B alike, and alpha 255
    /// without alpha. Panics if it's outside the image.
    @track_caller
    pub fn get(self, x: usize, y: usize) -> Color {
        if x >= self.w or y >= self.h {
            panic("pixel ({x}, {y}) is outside a {self.w} by {self.h} image")
        }
        let ch = self.form.channels()
        let at = (y * self.w + x) * ch
        let p = self.pixels[at..at + ch]
        return match self.form {
            Gray => Color.gray(p[0]),
            GrayAlpha => Color { r: p[0], g: p[0], b: p[0], a: p[1] },
            Rgb => Color.rgb(p[0], p[1], p[2]),
            Rgba => Color { r: p[0], g: p[1], b: p[2], a: p[3] },
        }
    }

    /// Sets pixel (x, y) to `color`: its brightness in a gray image, and without its alpha in
    /// one without. Panics if it's outside the image.
    @track_caller
    pub fn set(mut self, x: usize, y: usize, color: Color) {
        if x >= self.w or y >= self.h {
            panic("pixel ({x}, {y}) is outside a {self.w} by {self.h} image")
        }
        let ch = self.form.channels()
        let at = (y * self.w + x) * ch
        let px = pixel_bytes(self.form, color)
        for c in 0usize..ch {
            self.pixels[at + c] = px[c]
        }
    }

    /// The image with its pixels holding `kind`, as Pillow's `convert` makes them: gray from RGB
    /// by ITU-R 601's weights, RGB from gray by repeating it, alpha dropped, or 255 where there
    /// was none.
    @track_caller
    pub fn to(self, kind: Kind) -> Image {
        self.check()
        if kind == self.form {
            return Image { w: self.w, h: self.h, form: kind, pixels: self.pixels.copy() }
        }
        let n = self.w * self.h
        let from = self.form.channels()
        let to = kind.channels()
        var out: List<u8> = []
        out.reserve(n * to)
        unsafe {
            out.set_len(n * to)
            let s = self.pixels.as_ptr()
            let d = out.as_mut_ptr()
            if to == 1 and from >= 3 {
                // Gray from color, the commonest: a loop with nothing else in it.
                for i in 0usize..n {
                    let p = s.add(i * from)
                    let v = (u32(p.read()) * 19595 + u32(p.add(1).read()) * 38470 + u32(p.add(2).read()) * 7471 + 0x8000) >> 16
                    d.add(i).write(u8.wrap(v))
                }
                return Image { w: self.w, h: self.h, form: kind, pixels: out }
            }
            for i in 0usize..n {
                let p = s.add(i * from)
                let (r, g, b) = if from >= 3 { (p.read(), p.add(1).read(), p.add(2).read()) } else { (p.read(), p.read(), p.read()) }
                let a = if from == 2 { p.add(1).read() } else if from == 4 { p.add(3).read() } else { 255u8 }
                let q = d.add(i * to)
                if to <= 2 {
                    q.write(if from >= 3 { luma(r, g, b) } else { r })
                    if to == 2 {
                        q.add(1).write(a)
                    }
                } else {
                    q.write(r)
                    q.add(1).write(g)
                    q.add(2).write(b)
                    if to == 4 {
                        q.add(3).write(a)
                    }
                }
            }
        }
        return Image { w: self.w, h: self.h, form: kind, pixels: out }
    }

    /// The rectangle `width` by `height` whose top left is (x, y). Panics unless it's inside the
    /// image and not empty; `expand` adds a border instead.
    @track_caller
    pub fn crop(self, x: usize, y: usize, width: usize, height: usize) -> Image {
        self.check()
        if width == 0 or height == 0 or x + width > self.w or y + height > self.h {
            panic("a {width} by {height} crop at ({x}, {y}) isn't inside a {self.w} by {self.h} image")
        }
        let ch = self.form.channels()
        var out: List<u8> = []
        out.reserve(width * height * ch)
        for r in y..y + height {
            let at = (r * self.w + x) * ch
            out.extend(self.pixels[at..at + width * ch])
        }
        return Image { w: width, h: height, form: self.form, pixels: out }
    }

    /// The image with a border of `color` around it, as many pixels on each side as given.
    @track_caller
    pub fn expand(self, left: usize, top: usize, right: usize, bottom: usize, color: Color) -> Image {
        self.check()
        var out = Image.new(self.w + left + right, self.h + top + bottom, self.form, color)
        out.paste(self, i64.wrap(left), i64.wrap(top))
        return out
    }

    /// The image resized to `width` by `height` with `filter`, Pillow's `resize` to the pixel:
    /// a pass across and a pass down, with weights in 22-bit fixed point. An image with alpha
    /// is resized with each color weighted by its alpha, as Pillow does it, so clear pixels
    /// don't bleed their color. Panics for a width or height of 0.
    @track_caller
    pub fn resize(self, width: usize, height: usize, filter: Filter = Filter.Bicubic) -> Image {
        self.check()
        if width == 0 or height == 0 {
            panic("an image can't be resized to {width} by {height}")
        }
        if width == self.w and height == self.h {
            return Image { w: width, h: height, form: self.form, pixels: self.pixels.copy() }
        }
        let ch = self.form.channels()
        if filter == Filter.Nearest {
            return Image { w: width, h: height, form: self.form, pixels: nearest(self.pixels, self.w, self.h, ch, width, height) }
        }
        let alpha = self.form.has_alpha()
        var src: List<u8> = if alpha { premultiply(self.pixels, ch) } else { self.pixels.copy() }
        let (support, kind) = filter_info(filter)
        let (vb, vk, vsize) = coefficients(self.h, height, support, kind)
        // Only the rows the vertical pass reads are resized across.
        let first = vb[0]
        let last = vb[(height - 1) * 2] + vb[(height - 1) * 2 + 1]
        if width != self.w {
            let (hb, hk, hsize) = coefficients(self.w, width, support, kind)
            src = convolve_rows(src, self.w, ch, first, last, width, hb, hk, hsize)
        }
        var out = src
        if height != self.h {
            let start = if width != self.w { first } else { 0usize }
            out = convolve_cols(out, width, ch, height, vb, vk, vsize, start)
        }
        if alpha {
            out = unpremultiply(out, ch)
        }
        return Image { w: width, h: height, form: self.form, pixels: out }
    }

    /// The image made as big as fits in `width` by `height`, its proportions kept, as Pillow's
    /// `thumbnail` works out the size, and no bigger than it was. Pillow first shrinks by a whole
    /// factor before filtering; this filters in one step, which is a little sharper.
    @track_caller
    pub fn thumbnail(self, width: usize, height: usize, filter: Filter = Filter.Bicubic) -> Image {
        if width >= self.w and height >= self.h {
            return self.copy()
        }
        let aspect = f64.nearest(self.w) / f64.nearest(self.h)
        var x = width
        var y = height
        let fx = f64.nearest(x)
        let fy = f64.nearest(y)
        if fx / fy >= aspect {
            // The nearer of the whole numbers around y × aspect, by how close its proportions are.
            let v = fy * aspect
            let lo = v.floor()
            let hi = v.ceil()
            let pick = if (aspect - hi / fy).abs() < (aspect - lo / fy).abs() { hi } else { lo }
            x = usize.wrap(i64.saturate(pick).max(1))
        } else {
            let v = fx / aspect
            let lo = v.floor()
            let hi = v.ceil()
            let dl = if lo == 0.0 { 0.0 } else { (aspect - fx / lo).abs() }
            let dh = if hi == 0.0 { 0.0 } else { (aspect - fx / hi).abs() }
            let pick = if dh < dl { hi } else { lo }
            y = usize.wrap(i64.saturate(pick).max(1))
        }
        return self.resize(x, y, filter)
    }

    /// A copy of the image.
    pub fn copy(self) -> Image {
        return Image { w: self.w, h: self.h, form: self.form, pixels: self.pixels.copy() }
    }

    /// The image blurred by a Gaussian of `radius` pixels, Pillow's `GaussianBlur(radius)` to the
    /// pixel: three box blurs whose sizes make a Gaussian of that spread, across and down.
    @track_caller
    pub fn blur(self, radius: f64) -> Image {
        self.check()
        if radius < 0.0 {
            panic("a blur's radius can't be negative, not {radius}")
        }
        let r = gaussian_box(f32.nearest(radius), 3)
        return Image { w: self.w, h: self.h, form: self.form, pixels: box_blur(self.pixels, self.w, self.h, self.form.channels(), r, 3) }
    }

    /// The image blurred by averaging each pixel with those up to `radius` away, Pillow's
    /// `BoxBlur(radius)`; a radius that isn't whole weights the farthest pixels by its fraction.
    @track_caller
    pub fn box_blur(self, radius: f64) -> Image {
        self.check()
        if radius < 0.0 {
            panic("a blur's radius can't be negative, not {radius}")
        }
        return Image { w: self.w, h: self.h, form: self.form, pixels: box_blur(self.pixels, self.w, self.h, self.form.channels(), f32.nearest(radius), 1) }
    }

    /// The image mirrored left to right.
    @track_caller
    pub fn flip_horizontal(self) -> Image {
        self.check()
        let ch = self.form.channels()
        var out: List<u8> = []
        out.reserve(self.pixels.len())
        for y in 0usize..self.h {
            for x in 0usize..self.w {
                let at = (y * self.w + self.w - 1 - x) * ch
                for c in 0usize..ch {
                    out.push(self.pixels[at + c])
                }
            }
        }
        return Image { w: self.w, h: self.h, form: self.form, pixels: out }
    }

    /// The image upside down.
    @track_caller
    pub fn flip_vertical(self) -> Image {
        self.check()
        let row = self.w * self.form.channels()
        var out: List<u8> = []
        out.reserve(self.pixels.len())
        for y in 0usize..self.h {
            let at = (self.h - 1 - y) * row
            out.extend(self.pixels[at..at + row])
        }
        return Image { w: self.w, h: self.h, form: self.form, pixels: out }
    }

    /// The image turned a quarter turn to the left, counterclockwise, as Pillow's `ROTATE_90`.
    @track_caller
    pub fn rotate_left(self) -> Image {
        return self.turn(true)
    }

    /// The image turned a quarter turn to the right, clockwise, as Pillow's `ROTATE_270`.
    @track_caller
    pub fn rotate_right(self) -> Image {
        return self.turn(false)
    }

    /// The image turned half a turn, as Pillow's `ROTATE_180`.
    @track_caller
    pub fn rotate_180(self) -> Image {
        return self.flip_horizontal().flip_vertical()
    }

    @track_caller
    fn turn(self, left: bool) -> Image {
        self.check()
        let ch = self.form.channels()
        var out: List<u8> = []
        out.reserve(self.pixels.len())
        // The new image is h wide and w high.
        for ny in 0usize..self.w {
            for nx in 0usize..self.h {
                let (x, y) = if left { (self.w - 1 - ny, nx) } else { (ny, self.h - 1 - nx) }
                let at = (y * self.w + x) * ch
                for c in 0usize..ch {
                    out.push(self.pixels[at + c])
                }
            }
        }
        return Image { w: self.h, h: self.w, form: self.form, pixels: out }
    }

    /// Copies `other` onto the image with its top left at (x, y), replacing what's there, alpha
    /// too, as Pillow's `paste` without a mask: converted to this image's kind, and cut off at
    /// the edges. (x, y) can be outside the image.
    @track_caller
    pub fn paste(mut self, other: Image, x: i64, y: i64) {
        self.check()
        let src = if other.form == self.form { other.copy() } else { other.to(self.form) }
        let ch = self.form.channels()
        let x0 = x.max(0)
        let y0 = y.max(0)
        let x1 = (x + i64.wrap(src.w)).min(i64.wrap(self.w))
        let y1 = (y + i64.wrap(src.h)).min(i64.wrap(self.h))
        if x0 >= x1 or y0 >= y1 {
            return
        }
        let n = usize.wrap(x1 - x0) * ch
        for row in y0..y1 {
            let s = (usize.wrap(row - y) * src.w + usize.wrap(x0 - x)) * ch
            let d = (usize.wrap(row) * self.w + usize.wrap(x0)) * ch
            for i in 0usize..n {
                self.pixels[d + i] = src.pixels[s + i]
            }
        }
    }

    /// Draws `other` over the image with its top left at (x, y), blended by its alpha as
    /// Pillow's `alpha_composite` blends it, and cut off at the edges. The image gets alpha if
    /// it had none.
    @track_caller
    pub fn overlay(mut self, other: Image, x: i64, y: i64) {
        self.check()
        if not self.form.has_alpha() {
            let kind = if self.form == Kind.Gray { Kind.GrayAlpha } else { Kind.Rgba }
            let changed = self.to(kind)
            self.form = kind
            self.pixels = changed.pixels
        }
        let src = other.to(Kind.Rgba)
        let x0 = x.max(0)
        let y0 = y.max(0)
        let x1 = (x + i64.wrap(src.w)).min(i64.wrap(self.w))
        let y1 = (y + i64.wrap(src.h)).min(i64.wrap(self.h))
        let gray = self.form == Kind.GrayAlpha
        let ch = self.form.channels()
        for row in y0..y1 {
            for col in x0..x1 {
                let s = (usize.wrap(row - y) * src.w + usize.wrap(col - x)) * 4
                let d = (usize.wrap(row) * self.w + usize.wrap(col)) * ch
                let sa = u32(src.pixels[s + 3])
                if sa == 0 {
                    continue
                }
                let (dr, dg, db, da) = if gray { (u32(self.pixels[d]), u32(self.pixels[d]), u32(self.pixels[d]), u32(self.pixels[d + 1])) } else { (u32(self.pixels[d]), u32(self.pixels[d + 1]), u32(self.pixels[d + 2]), u32(self.pixels[d + 3])) }
                // Pillow's integer blend, with 7 more bits.
                let blend = da * (255 - sa)
                let outa255 = sa * 255 + blend
                let coef1 = sa * 255 * 255 * 128 / outa255
                let coef2 = 255u32 * 128 - coef1
                let r = div255(u32(src.pixels[s]) * coef1 + dr * coef2 + (0x80 << 7)) >> 7
                let g = div255(u32(src.pixels[s + 1]) * coef1 + dg * coef2 + (0x80 << 7)) >> 7
                let b = div255(u32(src.pixels[s + 2]) * coef1 + db * coef2 + (0x80 << 7)) >> 7
                let a = div255(outa255 + 0x80)
                if gray {
                    self.pixels[d] = luma(u8.wrap(r), u8.wrap(g), u8.wrap(b))
                    self.pixels[d + 1] = u8.wrap(a)
                } else {
                    self.pixels[d] = u8.wrap(r)
                    self.pixels[d + 1] = u8.wrap(g)
                    self.pixels[d + 2] = u8.wrap(b)
                    self.pixels[d + 3] = u8.wrap(a)
                }
            }
        }
    }

    /// The image with its alpha taken from `mask`, a gray image the same size, as Pillow's
    /// `putalpha`: a gray image becomes gray and alpha, and RGB becomes RGBA. Panics if `mask`
    /// isn't gray or isn't the same size.
    @track_caller
    pub fn with_alpha(self, mask: Image) -> Image {
        self.check()
        if mask.form != Kind.Gray or mask.w != self.w or mask.h != self.h {
            panic("an alpha mask is a gray image the same size, {self.w} by {self.h}, not {mask}")
        }
        let kind = if self.form == Kind.Gray or self.form == Kind.GrayAlpha { Kind.GrayAlpha } else { Kind.Rgba }
        var out = self.to(kind)
        let ch = kind.channels()
        for i in 0usize..self.w * self.h {
            out.pixels[i * ch + ch - 1] = mask.pixels[i]
        }
        return out
    }

    /// One channel as a gray image: 0 is the first, red or the brightness, and the last is the
    /// alpha. Panics for a channel the image doesn't have.
    @track_caller
    pub fn channel(self, index: usize) -> Image {
        self.check()
        let ch = self.form.channels()
        if index >= ch {
            panic("a {self.form} image has channels 0 to {ch - 1}, not {index}")
        }
        var out: List<u8> = []
        out.reserve(self.w * self.h)
        for i in 0usize..self.w * self.h {
            out.push(self.pixels[i * ch + index])
        }
        return Image { w: self.w, h: self.h, form: Kind.Gray, pixels: out }
    }

    /// Fills the rectangle `width` by `height` whose top left is (x, y) with `color`, as the
    /// image holds it, cut off at the edges.
    @track_caller
    pub fn fill_rect(mut self, x: i64, y: i64, width: usize, height: usize, color: Color) {
        self.check()
        let ch = self.form.channels()
        let px = pixel_bytes(self.form, color)
        let x0 = usize.wrap(x.max(0))
        let y0 = usize.wrap(y.max(0))
        let x1 = usize.wrap((x + i64.wrap(width)).min(i64.wrap(self.w)).max(0))
        let y1 = usize.wrap((y + i64.wrap(height)).min(i64.wrap(self.h)).max(0))
        for row in y0..y1 {
            for col in x0..x1 {
                let at = (row * self.w + col) * ch
                for c in 0usize..ch {
                    self.pixels[at + c] = px[c]
                }
            }
        }
    }

    /// Draws `text` in `font` at `size` pixels per em, in `color`, as Pillow's `ImageDraw.text`
    /// places it: (x, y) is the left of the first line at its ascender, rounded up to a whole
    /// pixel. Lines split at `\n`, the font's line height apart. The glyphs are antialiased, at
    /// their pens' fractions of a pixel, and blended over the image by their coverage and the
    /// color's alpha; an image with alpha gets more where the text covers it. Text past the edges
    /// is cut off.
    @track_caller
    pub fn draw_text(mut self, x: i64, y: i64, text: String, font: Font, size: f64, color: Color) {
        self.check()
        let m = font.mask(text, size)
        let ch = self.form.channels()
        let alpha = self.form.has_alpha()
        let ink = pixel_bytes(self.form, color)
        let left = x + m.x
        let top = y + m.y
        let x0 = left.max(0)
        let y0 = top.max(0)
        let x1 = (left + i64.wrap(m.width)).min(i64.wrap(self.w))
        let y1 = (top + i64.wrap(m.height)).min(i64.wrap(self.h))
        let colors = if alpha { ch - 1 } else { ch }
        for row in y0..y1 {
            for col in x0..x1 {
                let c = u32(m.coverage[usize.wrap(row - top) * m.width + usize.wrap(col - left)])
                if c == 0 {
                    continue
                }
                // How much of the ink this pixel gets, 0 to 255.
                let a = div255(c * u32(color.a) + 128)
                if a == 0 {
                    continue
                }
                let at = (usize.wrap(row) * self.w + usize.wrap(col)) * ch
                if not alpha {
                    for k in 0..colors {
                        let v = u32(self.pixels[at + k])
                        self.pixels[at + k] = u8.wrap(div255(v * (255 - a) + u32(ink[k]) * a + 128))
                    }
                    continue
                }
                // Over what's there: the ink's share, then the rest of what was there.
                let da = u32(self.pixels[at + colors])
                let keep = div255(da * (255 - a) + 128)
                let out_a = a + keep
                for k in 0..colors {
                    let v = u32(self.pixels[at + k])
                    self.pixels[at + k] = u8.wrap((u32(ink[k]) * a + v * keep + out_a / 2) / out_a)
                }
                self.pixels[at + colors] = u8.wrap(out_a)
            }
        }
    }

    // The ink for `color` on this image: blended by its alpha when it isn't opaque and the
    // image has none, as Pillow blends RGBA drawn on RGB, and set as it is otherwise.
    fn ink(self, color: Color) -> Ink {
        return Ink { w: i32.wrap(self.w), h: i32.wrap(self.h), ch: self.form.channels(), px: pixel_bytes(self.form, color), alpha: u32(color.a), blend: not self.form.has_alpha() and color.a < 255 }
    }

    /// Sets pixel (x, y) to `color`, as Pillow's `ImageDraw.point`: a color that isn't opaque
    /// is blended on an image without alpha. Nothing happens outside the image.
    @track_caller
    pub fn point(mut self, x: i64, y: i64, color: Color) {
        self.check()
        let k = self.ink(color)
        ink_point(mut self.pixels, k, c32(x), c32(y))
    }

    /// Draws lines from each point to the next, `width` pixels wide, as Pillow's
    /// `ImageDraw.line`. `round_joints` rounds the corners where wide lines meet, as Pillow's
    /// `joint="curve"` does for lines wider than 4.
    @track_caller
    pub fn line(mut self, points: List<(i64, i64)>, color: Color, width: u32 = 1, round_joints: bool = false) {
        self.check()
        if width == 0 {
            return
        }
        let k = self.ink(color)
        let w = w32(width)
        let xy = coords(points)
        draw_lines(mut self.pixels, k, xy, w)
        if not round_joints or w <= 4 or points.len() < 3 {
            return
        }
        // Pillow's joints: a pie slice the line's width across at each corner, turning from one
        // line's direction to the next, and past 8 pixels a short line over the gap between.
        for i in 1usize..points.len() - 1 {
            let (ax, ay) = points[i - 1]
            let (cx, cy) = points[i]
            let (bx, by) = points[i + 1]
            let a0 = py_mod360(atan2(f64.nearest(cx - ax), f64.nearest(ay - cy)) * RAD_TO_DEG)
            let a1 = py_mod360(atan2(f64.nearest(bx - cx), f64.nearest(cy - by)) * RAD_TO_DEG)
            if a0 == a1 {
                continue
            }
            let flipped = (a1 > a0 and a1 - 180.0 > a0) or (a1 < a0 and a1 + 180.0 > a0)
            let half = f64(w) / 2.0
            let px0 = i32.saturate(f64.nearest(cx) - half + 1.0)
            let py0 = i32.saturate(f64.nearest(cy) - half + 1.0)
            let px1 = i32.saturate(f64.nearest(cx) + half - 1.0)
            let py1 = i32.saturate(f64.nearest(cy) + half - 1.0)
            let (s, e) = if flipped { (a1 + 90.0, a0 + 90.0) } else { (a0 - 90.0, a1 - 90.0) }
            draw_pieslice(mut self.pixels, k, px0, py0, px1, py1, f32.nearest(s - 90.0), f32.nearest(e - 90.0), true, 0)
            if w > 8 {
                let turn = if flipped { 90.0 } else { -90.0 }
                let (gx0, gy0) = at_angle(cx, cy, a0 + turn, w)
                let (gx1, gy1) = at_angle(cx, cy, a1 + turn, w)
                draw_lines(mut self.pixels, k, [c32(gx0), c32(gy0), c32(cx), c32(cy), c32(gx1), c32(gy1)], 3)
            }
        }
    }

    /// Draws the rectangle from (x0, y0) to (x1, y1), both corners' pixels included, as
    /// Pillow's `ImageDraw.rectangle`: filled, outlined `paint.width` pixels inward, or both.
    /// Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn rectangle(mut self, x0: i64, y0: i64, x1: i64, y1: i64, paint: Paint) {
        self.check()
        check_box(x0, y0, x1, y1)
        if let f = paint.fill {
            let k = self.ink(f)
            draw_rect(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), true, 0)
        }
        if let o = edge_of(self.form, paint) {
            let k = self.ink(o)
            draw_rect(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), false, w32(paint.width))
        }
    }

    /// Draws the rectangle from (x0, y0) to (x1, y1) with its corners rounded `radius` pixels,
    /// as Pillow's `ImageDraw.rounded_rectangle`. `corners` says which are rounded: top left,
    /// top right, bottom right and bottom left. Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn rounded_rectangle(mut self, x0: i64, y0: i64, x1: i64, y1: i64, radius: u32, paint: Paint, corners: [bool; 4] = [true, true, true, true]) {
        self.check()
        check_box(x0, y0, x1, y1)
        var d = (x1 - x0).min(y1 - y0).min(i64(radius) * 2)
        var full_x = false
        var full_y = false
        if corners[0] and corners[1] and corners[2] and corners[3] {
            // Corners that meet are drawn as halves of one ellipse, or as a whole one.
            full_x = d >= x1 - x0 - 1
            if full_x {
                d = x1 - x0
            }
            full_y = d >= y1 - y0 - 1
            if full_y {
                d = y1 - y0
            }
            if full_x and full_y {
                self.ellipse(x0, y0, x1, y1, paint)
                return
            }
        }
        if d == 0 or not (corners[0] or corners[1] or corners[2] or corners[3]) {
            self.rectangle(x0, y0, x1, y1, paint)
            return
        }
        let r = d / 2
        // Each corner's box and the angles it turns through.
        var parts: List<(i64, i64, i64, i64, f32, f32)> = []
        if full_x {
            parts.push((x0, y0, x0 + d, y0 + d, 180.0f32, 360.0f32))
            parts.push((x0, y1 - d, x0 + d, y1, 0.0f32, 180.0f32))
        } else if full_y {
            parts.push((x0, y0, x0 + d, y0 + d, 90.0f32, 270.0f32))
            parts.push((x1 - d, y0, x1, y0 + d, 270.0f32, 90.0f32))
        } else {
            if corners[0] {
                parts.push((x0, y0, x0 + d, y0 + d, 180.0f32, 270.0f32))
            }
            if corners[1] {
                parts.push((x1 - d, y0, x1, y0 + d, 270.0f32, 360.0f32))
            }
            if corners[2] {
                parts.push((x1 - d, y1 - d, x1, y1, 0.0f32, 90.0f32))
            }
            if corners[3] {
                parts.push((x0, y1 - d, x0 + d, y1, 90.0f32, 180.0f32))
            }
        }
        // How far down the left and right sides start and end, past the corners rounded.
        let lt = if corners[0] { y0 + r + 1 } else { y0 }
        let lb = if corners[3] { y1 - r - 1 } else { y1 }
        let rt = if corners[1] { y0 + r + 1 } else { y0 }
        let rb = if corners[2] { y1 - r - 1 } else { y1 }
        if let f = paint.fill {
            let k = self.ink(f)
            for p in parts {
                draw_pieslice(mut self.pixels, k, c32(p.0), c32(p.1), c32(p.2), c32(p.3), p.4, p.5, true, 0)
            }
            if full_x {
                fill_box(mut self.pixels, k, x0, y0 + r + 1, x1, y1 - r - 1)
            } else if x1 - r - 1 >= x0 + r + 1 {
                fill_box(mut self.pixels, k, x0 + r + 1, y0, x1 - r - 1, y1)
            }
            if not full_x and not full_y {
                fill_box(mut self.pixels, k, x0, lt, x0 + r, lb)
                fill_box(mut self.pixels, k, x1 - r, rt, x1, rb)
            }
        }
        if let o = edge_of(self.form, paint) {
            let k = self.ink(o)
            let w = i64(paint.width)
            for p in parts {
                draw_arc(mut self.pixels, k, c32(p.0), c32(p.1), c32(p.2), c32(p.3), p.4, p.5, w32(paint.width))
            }
            if not full_x {
                let tl = if corners[0] { x0 + r + 1 } else { x0 }
                let tr = if corners[1] { x1 - r - 1 } else { x1 }
                fill_box(mut self.pixels, k, tl, y0, tr, y0 + w - 1)
                let bl = if corners[3] { x0 + r + 1 } else { x0 }
                let br = if corners[2] { x1 - r - 1 } else { x1 }
                fill_box(mut self.pixels, k, bl, y1 - w + 1, br, y1)
            }
            if not full_y {
                fill_box(mut self.pixels, k, x0, lt, x0 + w - 1, lb)
                fill_box(mut self.pixels, k, x1 - w + 1, rt, x1, rb)
            }
        }
    }

    /// Draws the ellipse that fits the box from (x0, y0) to (x1, y1), both corners' pixels
    /// included, as Pillow's `ImageDraw.ellipse`. Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn ellipse(mut self, x0: i64, y0: i64, x1: i64, y1: i64, paint: Paint) {
        self.check()
        check_box(x0, y0, x1, y1)
        if let f = paint.fill {
            let k = self.ink(f)
            draw_ellipse(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), true, 0)
        }
        if let o = edge_of(self.form, paint) {
            let k = self.ink(o)
            draw_ellipse(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), false, w32(paint.width))
        }
    }

    /// Draws the circle around (x, y) `radius` pixels out, as Pillow's `ImageDraw.circle`: the
    /// ellipse from (x - radius, y - radius) to (x + radius, y + radius).
    @track_caller
    pub fn circle(mut self, x: i64, y: i64, radius: u32, paint: Paint) {
        let r = i64(radius)
        self.ellipse(x - r, y - r, x + r, y + r, paint)
    }

    /// Draws the polygon through `points`, closed back to the first, as Pillow's
    /// `ImageDraw.polygon`. Its edge is drawn inside the shape, so a wide one doesn't make it
    /// bigger. Panics for fewer than 2 points.
    @track_caller
    pub fn polygon(mut self, points: List<(i64, i64)>, paint: Paint) {
        self.check()
        if points.len() < 2 {
            panic("a polygon needs at least 2 points, not {points.len()}")
        }
        let xy = coords(points)
        if let f = paint.fill {
            let k = self.ink(f)
            ink_polygon(mut self.pixels, k, xy, true, 0, [])
        }
        let o = edge_of(self.form, paint) else return
        let k = self.ink(o)
        if paint.width == 1 {
            ink_polygon(mut self.pixels, k, xy, false, 1, [])
            return
        }
        // A line twice as wide, drawn only where the polygon's inside is.
        var inside: List<u8> = [0u8; self.w * self.h]
        let mark = Ink { w: k.w, h: k.h, ch: 1, px: [1, 0, 0, 0], alpha: 255, blend: false }
        ink_polygon(mut inside, mark, xy, true, 0, [])
        ink_polygon(mut self.pixels, k, xy, false, w32(paint.width) * 2 - 1, inside)
    }

    /// Draws the part of the ellipse in the box from (x0, y0) to (x1, y1) from `start` to
    /// `end` degrees, clockwise from 3 o'clock, `width` pixels wide, as Pillow's
    /// `ImageDraw.arc`. Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn arc(mut self, x0: i64, y0: i64, x1: i64, y1: i64, start: f64, end: f64, color: Color, width: u32 = 1) {
        self.check()
        check_box(x0, y0, x1, y1)
        if width == 0 {
            return
        }
        let k = self.ink(color)
        draw_arc(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), f32.nearest(start), f32.nearest(end), w32(width))
    }

    /// Draws the part of the ellipse in the box from (x0, y0) to (x1, y1) cut off by the line
    /// from `start` to `end` degrees, clockwise from 3 o'clock, as Pillow's `ImageDraw.chord`.
    /// Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn chord(mut self, x0: i64, y0: i64, x1: i64, y1: i64, start: f64, end: f64, paint: Paint) {
        self.check()
        check_box(x0, y0, x1, y1)
        let (s, e) = (f32.nearest(start), f32.nearest(end))
        if let f = paint.fill {
            let k = self.ink(f)
            draw_chord(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), s, e, true, 0)
        }
        if let o = edge_of(self.form, paint) {
            let k = self.ink(o)
            draw_chord(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), s, e, false, w32(paint.width))
        }
    }

    /// Draws the slice of the ellipse in the box from (x0, y0) to (x1, y1) from `start` to
    /// `end` degrees, clockwise from 3 o'clock, with its sides to the center, as Pillow's
    /// `ImageDraw.pieslice`. Panics if x1 is less than x0 or y1 than y0.
    @track_caller
    pub fn pieslice(mut self, x0: i64, y0: i64, x1: i64, y1: i64, start: f64, end: f64, paint: Paint) {
        self.check()
        check_box(x0, y0, x1, y1)
        let (s, e) = (f32.nearest(start), f32.nearest(end))
        if let f = paint.fill {
            let k = self.ink(f)
            draw_pieslice(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), s, e, true, 0)
        }
        if let o = edge_of(self.form, paint) {
            let k = self.ink(o)
            draw_pieslice(mut self.pixels, k, c32(x0), c32(y0), c32(x1), c32(y1), s, e, false, w32(paint.width))
        }
    }

    /// Fills the image with `color`.
    @track_caller
    pub fn fill(mut self, color: Color) {
        let (w, h) = (self.w, self.h)
        self.fill_rect(0, 0, w, h, color)
    }

    /// Fills the area around (x, y) that's the color it is there with `color`, as Pillow's
    /// `ImageDraw.floodfill` does: pixels joined to it up, down, left or right, and no more
    /// than `threshold` from its color in any channel. Does nothing if (x, y) is outside the
    /// image, or already `color`.
    @track_caller
    pub fn flood_fill(mut self, x: usize, y: usize, color: Color, threshold: u8 = 0) {
        self.check()
        if x >= self.w or y >= self.h {
            return
        }
        let ch = self.form.channels()
        let fill = pixel_bytes(self.form, color)
        let start = (y * self.w + x) * ch
        let background = self.pixels[start..start + ch]
        if close(fill.to_list()[..ch], background, threshold) {
            return
        }
        // Each pixel is filled when it's reached, and its neighbors looked at once.
        var seen: List<bool> = [false; self.w * self.h]
        var todo: List<usize> = [y * self.w + x]
        seen[y * self.w + x] = true
        while todo.len() > 0 {
            let i = todo.pop() ?? 0
            for c in 0usize..ch {
                self.pixels[i * ch + c] = fill[c]
            }
            let px = i % self.w
            let py = i / self.w
            // Neighbors past an edge are marked with the pixel itself, which is already seen.
            let next: [usize; 4] = [
                if px + 1 < self.w { i + 1 } else { i },
                if px > 0 { i - 1 } else { i },
                if py + 1 < self.h { i + self.w } else { i },
                if py > 0 { i - self.w } else { i },
            ]
            for j in next {
                if seen[j] {
                    continue
                }
                seen[j] = true
                if close(self.pixels[j * ch..j * ch + ch], background, threshold) {
                    todo.push(j)
                }
            }
        }
    }

    /// The image with each color channel turned to 255 minus itself, alpha kept, as Pillow's
    /// `ImageOps.invert`.
    @track_caller
    pub fn invert(self) -> Image {
        self.check()
        var out = self.copy()
        let ch = self.form.channels()
        let colors = if self.form.has_alpha() { ch - 1 } else { ch }
        for i in 0usize..self.w * self.h {
            for c in 0usize..colors {
                out.pixels[i * ch + c] = 255 - out.pixels[i * ch + c]
            }
        }
        return out
    }

    /// The image in at most `colors` colors, 1 to 256, each pixel an index into a palette, for a
    /// small PNG. An image with that few colors keeps them exactly; otherwise they're chosen by
    /// median cut, refined by a few rounds of k-means, and each pixel takes the nearest. Alpha is
    /// a channel like the others. Panics for 0 colors or more than 256.
    @track_caller
    pub fn quantize(self, colors: usize = 256) -> Paletted {
        self.check()
        if colors == 0 or colors > 256 {
            panic("a palette holds 1 to 256 colors, not {colors}")
        }
        let rgba = self.to(Kind.Rgba)
        return quantize_rgba(rgba.pixels, self.w, self.h, colors)
    }
}

/// An image whose pixels are indexes into a palette of up to 256 colors, as `quantize` makes it,
/// for a small PNG.
pub struct Paletted {
    w: usize
    h: usize
    /// Each pixel's index into `palette`, row by row from the top.
    pub indexes: List<u8>
    /// The colors.
    pub palette: List<Color>
}

impl Paletted {
    /// How many pixels across.
    pub fn width(self) -> usize {
        return self.w
    }

    /// How many pixels down.
    pub fn height(self) -> usize {
        return self.h
    }

    /// The image with each pixel its palette color: RGBA if any color isn't opaque, and RGB
    /// otherwise.
    @track_caller
    pub fn to_image(self) -> Image {
        let alpha = self.palette.any(|c| c.a != 255)
        let kind = if alpha { Kind.Rgba } else { Kind.Rgb }
        let ch = kind.channels()
        var out: List<u8> = []
        out.reserve(self.w * self.h * ch)
        for i in self.indexes {
            let c = self.palette[usize(i)]
            out.push(c.r)
            out.push(c.g)
            out.push(c.b)
            if alpha {
                out.push(c.a)
            }
        }
        return Image.from_pixels(self.w, self.h, kind, out)
    }

    /// The image as a palette PNG, its indexes in as few bits as the palette needs, as Pillow
    /// writes one, at zlib `level`.
    @track_caller
    pub fn encode_png(self, level: u32 = 6) -> List<u8> {
        var palette: List<u8> = []
        for c in self.palette {
            palette.push(c.r)
            palette.push(c.g)
            palette.push(c.b)
            palette.push(c.a)
        }
        return png.encode_indexed(self.w, self.h, self.indexes, palette, level)
    }

    /// Writes the image to a PNG file.
    pub fn save(self, path: String) ! Error {
        if not path.to_lower_root().ends_with(".png") {
            fail "can't write {path}: a palette image is written as a PNG"
        }
        try write(path.copy(), self.encode_png()).context("writing {path}")
    }
}

// ---- Shapes, drawn as Pillow's ImageDraw draws them ----
//
// What follows takes the steps of Pillow 12.3's src/libImaging/Draw.c and ImageDraw.py, written
// again in Calx so that each shape covers the same pixels: Bresenham's lines, the scan-line
// polygon filler with its rules for corners, the ellipse traced on a grid of doubled
// coordinates, and the trees of half-planes that cut arcs, chords and pie slices from it.
// Pillow's notice:
//
// The Python Imaging Library (PIL) is
//
//     Copyright © 1997-2011 by Secret Labs AB
//     Copyright © 1995-2011 by Fredrik Lundh and contributors
//
// Pillow is the friendly PIL fork. It is
//
//     Copyright © 2010 by Jeffrey 'Alex' Clark and contributors
//
// Like PIL, Pillow is licensed under the open source MIT-CMU License:
//
// By obtaining, using, and/or copying this software and/or its associated documentation, you
// agree that you have read, understood, and will comply with the following terms and
// conditions:
//
// Permission to use, copy, modify and distribute this software and its documentation for any
// purpose and without fee is hereby granted, provided that the above copyright notice appears in
// all copies, and that both that copyright notice and this permission notice appear in
// supporting documentation, and that the name of Secret Labs AB or the author not be used in
// advertising or publicity pertaining to distribution of the software without specific, written
// prior permission.
//
// SECRET LABS AB AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE, INCLUDING
// ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL SECRET LABS AB OR THE
// AUTHOR BE LIABLE FOR ANY SPECIAL, INDIRECT OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER
// RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR
// OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS
// SOFTWARE.

const RAD_TO_DEG: f64 = 180.0 / PI
const DEG_TO_RAD: f64 = PI / 180.0
// Widths past this are cut to it, so the arithmetic on them can't overflow.
const MOST_WIDTH: u32 = 1 << 24
const CLIP_AND: u8 = 0
const CLIP_OR: u8 = 1
const CLIP_PLANE: u8 = 2

// Where a shape's pixels go and what they get: the image's size and channels, the color's bytes
// as the image holds them, and whether they're blended by its alpha.
struct Ink {
    w: i32
    h: i32
    ch: usize
    px: [u8; 4]
    alpha: u32
    blend: bool
}

// A coordinate as Pillow's C takes it, an int.
fn c32(v: i64) -> i32 {
    return i32.wrap(v.max(i64(i32.MIN)).min(i64(i32.MAX)))
}

fn w32(width: u32) -> i32 {
    return i32.wrap(width.min(MOST_WIDTH))
}

fn coords(points: List<(i64, i64)>) -> List<i32> {
    var xy: List<i32> = []
    xy.reserve(points.len() * 2)
    for (x, y) in points {
        xy.push(c32(x))
        xy.push(c32(y))
    }
    return xy
}

@track_caller
fn check_box(x0: i64, y0: i64, x1: i64, y1: i64) {
    if x1 < x0 {
        panic("a box's x1, {x1}, is less than its x0, {x0}")
    }
    if y1 < y0 {
        panic("a box's y1, {y1}, is less than its y0, {y0}")
    }
}

// Whether two colors are the same ink on this kind of image, as Pillow compares them to leave
// out an edge the fill's color.
fn same_ink(kind: Kind, a: Color, b: Color) -> bool {
    return match kind {
        Gray => a.luma() == b.luma(),
        GrayAlpha => a.luma() == b.luma() and a.a == b.a,
        _ => a == b,
    }
}

// The edge's color, unless there's no edge or it's the fill's ink.
fn edge_of(kind: Kind, p: Paint) -> Color? {
    let o = p.outline else return none
    if p.width == 0 {
        return none
    }
    if let f = p.fill {
        if same_ink(kind, f, o) {
            return none
        }
    }
    return some(o)
}

// Python's `%` by 360 on a float: the result has the divisor's sign.
fn py_mod360(x: f64) -> f64 {
    let m = x % 360.0
    if m == 0.0 {
        return 0.0
    }
    return if m < 0.0 { m + 360.0 } else { m }
}

// A point `width / 2 - 1` from (x, y) at `angle` - 90 degrees, its offsets rounded toward 0,
// as Pillow's coord_at_angle.
fn at_angle(x: i64, y: i64, angle: f64, width: i32) -> (i64, i64) {
    let a = (angle - 90.0) * DEG_TO_RAD
    let distance = f64(width) / 2.0 - 1.0
    let dx = distance * cos(a)
    let dy = distance * sin(a)
    let ox = i64.saturate(if dx > 0.0 { dx.floor() } else { dx.ceil() })
    let oy = i64.saturate(if dy > 0.0 { dy.floor() } else { dy.ceil() })
    return (x + ox, y + oy)
}

// C's roundf and lround: the nearest integer, halves away from 0.
fn roundf(v: f32) -> f32 {
    let t = if v < 0.0f32 { v.ceil() } else { v.floor() }
    let f = v - t
    if f >= 0.5f32 {
        return t + 1.0f32
    }
    if f <= -0.5f32 {
        return t - 1.0f32
    }
    return t
}

fn lround(v: f64) -> i32 {
    let t = if v < 0.0 { v.ceil() } else { v.floor() }
    let f = v - t
    let r = if f >= 0.5 { t + 1.0 } else if f <= -0.5 { t - 1.0 } else { t }
    return i32.saturate(r)
}

// Pillow's ROUND_UP and ROUND_DOWN: halves away from 0, and toward it, in the float's own type.
fn round_up32(f: f32) -> i32 {
    if f >= 0.0f32 {
        return i32.saturate(f64((f + 0.5f32).floor()))
    }
    return -i32.saturate(f64((f.abs() + 0.5f32).floor()))
}

fn round_down32(f: f32) -> i32 {
    if f >= 0.0f32 {
        return i32.saturate(f64((f - 0.5f32).ceil()))
    }
    return -i32.saturate(f64((f.abs() - 0.5f32).ceil()))
}

fn round_up64(f: f64) -> i32 {
    if f >= 0.0 {
        return i32.saturate((f + 0.5).floor())
    }
    return -i32.saturate((f.abs() + 0.5).floor())
}

fn round_down64(f: f64) -> i32 {
    if f >= 0.0 {
        return i32.saturate((f - 0.5).ceil())
    }
    return -i32.saturate((f.abs() - 0.5).ceil())
}

fn ink_put(px: mut List<u8>, k: Ink, at: usize) {
    if k.blend {
        for c in 0usize..k.ch {
            px[at + c] = u8.wrap(div255(u32(px[at + c]) * (255 - k.alpha) + u32(k.px[c]) * k.alpha + 128))
        }
        return
    }
    for c in 0usize..k.ch {
        px[at + c] = k.px[c]
    }
}

fn ink_point(px: mut List<u8>, k: Ink, x: i32, y: i32) {
    if x >= 0 and x < k.w and y >= 0 and y < k.h {
        ink_put(mut px, k, (usize.wrap(y) * usize.wrap(k.w) + usize.wrap(x)) * k.ch)
    }
}

// The pixels from x0 to x1 on row y, both included, cut off at the edges; where `mask` isn't
// empty, only those it marks.
fn ink_hline(px: mut List<u8>, k: Ink, x0: i32, y: i32, x1: i32, mask: List<u8>) {
    if y < 0 or y >= k.h {
        return
    }
    if x0 >= k.w or x1 < 0 {
        return
    }
    let a = x0.max(0)
    let b = x1.min(k.w - 1)
    if a > b {
        return
    }
    let row = usize.wrap(y) * usize.wrap(k.w)
    if mask.len() == 0 {
        // The row is inside the image, checked above, so it's written through a pointer.
        let n = usize.wrap(b - a + 1)
        let total = n * k.ch
        unsafe {
            let start = (row + usize.wrap(a)) * k.ch
            let p = px.as_mut_ptr().add(start)
            if not k.blend {
                // The first pixel, then copies of the part done, twice as long each time.
                for c in 0usize..k.ch {
                    p.add(c).write(k.px[c])
                }
                let from = px.as_ptr().add(start)
                var done = k.ch
                while done < total {
                    let more = done.min(total - done)
                    _ = memcpy(p.add(done), from, more)
                    done += more
                }
                return
            }
            // Only images without alpha blend: gray, or red, green and blue.
            let keep = 255 - k.alpha
            let t0 = u32(k.px[0]) * k.alpha + 128
            if k.ch == 1 {
                for i in 0usize..n {
                    p.add(i).write(u8.wrap(div255(u32(p.add(i).read()) * keep + t0)))
                }
                return
            }
            let t1 = u32(k.px[1]) * k.alpha + 128
            let t2 = u32(k.px[2]) * k.alpha + 128
            for i in 0usize..n {
                let q = p.add(i * 3)
                q.write(u8.wrap(div255(u32(q.read()) * keep + t0)))
                q.add(1).write(u8.wrap(div255(u32(q.add(1).read()) * keep + t1)))
                q.add(2).write(u8.wrap(div255(u32(q.add(2).read()) * keep + t2)))
            }
        }
        return
    }
    for x in a..b + 1 {
        let i = row + usize.wrap(x)
        if mask.len() > 0 and mask[i] == 0 {
            continue
        }
        ink_put(mut px, k, i * k.ch)
    }
}

// The points of a column from y0 up to but not including y1, either way, cut off at the edges:
// Pillow's line where it's vertical.
fn ink_vline(px: mut List<u8>, k: Ink, x: i32, y0: i32, y1: i32) {
    if x < 0 or x >= k.w or y0 == y1 {
        return
    }
    // The rows drawn, lowest first.
    let (lo, hi) = if y1 > y0 { (i64(y0), i64(y1) - 1) } else { (i64(y1) + 1, i64(y0)) }
    let a = lo.max(0)
    let b = hi.min(i64(k.h) - 1)
    var y = a
    while y <= b {
        ink_put(mut px, k, (usize.wrap(y) * usize.wrap(k.w) + usize.wrap(x)) * k.ch)
        y += 1
    }
}

// Pillow's line: Bresenham's, from (x0, y0) up to but not including (x1, y1).
fn ink_line(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32) {
    var dx = x1 - x0
    var xs: i32 = 1
    if dx < 0 {
        dx = -dx
        xs = -1
    }
    var dy = y1 - y0
    var ys: i32 = 1
    if dy < 0 {
        dy = -dy
        ys = -1
    }
    if dx == 0 {
        ink_vline(mut px, k, x0, y0, y1)
        return
    }
    var x = x0
    var y = y0
    if dy == 0 {
        // Pillow's horizontal line stops short of x1; a row cut off at the edges.
        if xs > 0 {
            ink_hline(mut px, k, x0, y0, x1 - 1, [])
        } else {
            ink_hline(mut px, k, x1 + 1, y0, x0, [])
        }
        return
    }
    if dx > dy {
        let ddy = dy + dy
        var e = ddy - dx
        let ddx = dx + dx
        for _ in 0..dx {
            ink_point(mut px, k, x, y)
            if e >= 0 {
                y += ys
                e -= ddx
            }
            e += ddy
            x += xs
        }
        return
    }
    let ddx = dx + dx
    var e = ddx - dy
    let ddy = dy + dy
    for _ in 0..dy {
        ink_point(mut px, k, x, y)
        if e >= 0 {
            x += xs
            e -= ddy
        }
        e += ddx
        y += ys
    }
}

// A polygon's side, for filling it a row at a time: Pillow's Edge.
struct Edge {
    x0: i32
    y0: i32
    xmin: i32
    ymin: i32
    xmax: i32
    ymax: i32
    dx: f32
}

fn new_edge(x0: i32, y0: i32, x1: i32, y1: i32) -> Edge {
    let dx = if y0 == y1 { 0.0f32 } else { f32.nearest(x1 - x0) / f32.nearest(y1 - y0) }
    return Edge { x0, y0, xmin: x0.min(x1), ymin: y0.min(y1), xmax: x0.max(x1), ymax: y0.max(y1), dx }
}

// Where a side crosses row y, worked out in f32 as Pillow does.
fn edge_x(e: Edge, y: i32) -> f32 {
    return f32.nearest(y - e.y0) * e.dx + f32.nearest(e.x0)
}

fn sort_f32(xs: mut List<f32>) {
    if xs.len() > 24 {
        xs.sort_by(|a, b| a.total_cmp(b))
        return
    }
    for i in 1usize..xs.len() {
        let v = xs[i]
        var j = i
        while j > 0 and xs[j - 1] > v {
            xs[j] = xs[j - 1]
            j -= 1
        }
        xs[j] = v
    }
}

// Pillow's draw_horizontal_lines, when blending: the flat sides on row y from `pos` on, so no
// pixel is drawn twice. Gives where the row has been drawn to.
fn flat_sides(px: mut List<u8>, k: Ink, es: List<Edge>, pos: i32, y: i32, mask: List<u8>) -> i32 {
    var at = pos
    for e in es {
        if e.ymin != y or e.ymin != e.ymax {
            continue
        }
        var xmin = e.xmin
        if at != -1 and at < xmin {
            continue
        }
        if at > xmin {
            xmin = at
            if e.xmax < xmin {
                continue
            }
        }
        ink_hline(mut px, k, xmin, y, e.xmax, mask)
        at = e.xmax + 1
    }
    return at
}

// Pillow's polygon_generic: each row crosses the sides at points worked out in f32, which are
// sorted and filled between in pairs, with Pillow's rules for where sides meet.
fn scan_fill(px: mut List<u8>, k: Ink, es: List<Edge>, mask: List<u8>) {
    if es.len() == 0 {
        return
    }
    var sides: List<usize> = []
    var ymin = k.h - 1
    var ymax: i32 = 0
    for i in 0usize..es.len() {
        let e = es[i]
        ymin = ymin.min(e.ymin)
        ymax = ymax.max(e.ymax)
        if e.ymin == e.ymax {
            if not k.blend {
                ink_hline(mut px, k, e.xmin, e.ymin, e.xmax, mask)
            }
            continue
        }
        sides.push(i)
    }
    ymin = ymin.max(0)
    ymax = ymax.min(k.h)
    var xx: List<f32> = []
    var y = ymin
    while y <= ymax {
        xx.clear()
        for si in 0usize..sides.len() {
            let e = es[sides[si]]
            if y < e.ymin or y > e.ymax {
                continue
            }
            let x = edge_x(e, y)
            xx.push(x)
            if y == e.ymax and y < ymax {
                xx.push(x)
                continue
            }
            if (y != e.ymin and y != e.ymax) or e.dx == 0.0f32 {
                continue
            }
            // A corner of two sides that would leave a gap moves out to meet the next row.
            for sk in 0usize..si {
                let o = es[sides[sk]]
                if (y != o.ymin and y != o.ymax) or o.dx == 0.0f32 {
                    continue
                }
                let last = xx.len() - 1
                if roundf(xx[last]) != roundf(edge_x(o, y)) {
                    continue
                }
                let step: i32 = if y == e.ymax { -1 } else { 1 }
                let near = y + step
                if near < o.ymin or near > o.ymax {
                    continue
                }
                let mine = edge_x(e, near)
                let theirs = edge_x(o, near)
                if xx[last] > mine + 1.0f32 and xx[last] > theirs + 1.0f32 {
                    xx[last] = roundf(mine.max(theirs)) + 1.0f32
                } else if xx[last] < mine - 1.0f32 and xx[last] < theirs - 1.0f32 {
                    xx[last] = roundf(mine.min(theirs)) - 1.0f32
                }
                break
            }
        }
        sort_f32(mut xx)
        if not k.blend {
            var i: usize = 1
            while i < xx.len() {
                ink_hline(mut px, k, round_up32(xx[i - 1]), y, round_down32(xx[i]), mask)
                i += 2
            }
        } else {
            var pos: i32 = if xx.len() == 0 { -1 } else { 0 }
            var i: usize = 1
            while i < xx.len() {
                let x_end = round_down32(xx[i])
                if x_end >= pos {
                    pos = flat_sides(mut px, k, es, pos, y, mask)
                    if x_end >= pos {
                        var x_start = round_up32(xx[i - 1])
                        var go = true
                        if pos > x_start {
                            x_start = pos
                            go = x_end >= x_start
                        }
                        if go {
                            ink_hline(mut px, k, x_start, y, x_end, mask)
                            pos = x_end + 1
                        }
                    }
                }
                i += 2
            }
            _ = flat_sides(mut px, k, es, pos, y, mask)
        }
        y += 1
    }
}

// Pillow's ImagingDrawWideLine: a line `width` across as a polygon of four corners, its ends cut
// square.
fn ink_wide_line(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, width: i32, mask: List<u8>) {
    let dx = x1 - x0
    let dy = y1 - y0
    if dx == 0 and dy == 0 {
        ink_point(mut px, k, x0, y0)
        return
    }
    let big = hypot(f64(dx), f64(dy))
    let small = f64(width - 1) / 2.0
    let ratio_max = f64(round_up64(small)) / big
    let ratio_min = f64(round_down64(small)) / big
    let dxmin = round_down64(ratio_min * f64(dy))
    let dxmax = round_down64(ratio_max * f64(dy))
    let dymin = round_down64(ratio_min * f64(dx))
    let dymax = round_down64(ratio_max * f64(dx))
    let (ax, ay) = (x0 - dxmin, y0 + dymax)
    let (bx, by) = (x1 - dxmin, y1 + dymax)
    let (cx, cy) = (x1 + dxmax, y1 - dymin)
    let (ex, ey) = (x0 + dxmax, y0 - dymin)
    let es: List<Edge> = [new_edge(ax, ay, bx, by), new_edge(bx, by, cx, cy), new_edge(cx, cy, ex, ey), new_edge(ex, ey, ax, ay)]
    scan_fill(mut px, k, es, mask)
}

// Pillow's _draw_lines: width 1 as Bresenham's lines, each without its last point, then the
// last point; wider as a polygon for each line.
fn draw_lines(px: mut List<u8>, k: Ink, xy: List<i32>, width: i32) {
    let n = xy.len() / 2
    if n < 2 {
        return
    }
    for i in 0usize..n - 1 {
        if width == 1 {
            ink_line(mut px, k, xy[2 * i], xy[2 * i + 1], xy[2 * i + 2], xy[2 * i + 3])
        } else {
            ink_wide_line(mut px, k, xy[2 * i], xy[2 * i + 1], xy[2 * i + 2], xy[2 * i + 3], width, [])
        }
    }
    if width == 1 {
        ink_point(mut px, k, xy[2 * n - 2], xy[2 * n - 1])
    }
}

// Pillow's ImagingDrawPolygon: filled, with a run of flat sides going the same way as one; or
// its sides as lines, `width` wide.
fn ink_polygon(px: mut List<u8>, k: Ink, xy: List<i32>, fill: bool, width: i32, mask: List<u8>) {
    let count = xy.len() / 2
    if count == 0 {
        return
    }
    if fill {
        var es: List<Edge> = []
        var i: usize = 0
        while i + 1 < count {
            let (x0, y0, x1, y1) = (xy[i * 2], xy[i * 2 + 1], xy[i * 2 + 2], xy[i * 2 + 3])
            if y0 == y1 and i != 0 and y0 == xy[i * 2 - 1] {
                let last = es.len() - 1
                if x1 > x0 and x0 > xy[i * 2 - 2] {
                    es[last].xmax = x1
                    i += 1
                    continue
                }
                if x1 < x0 and x0 < xy[i * 2 - 2] {
                    es[last].xmin = x1
                    i += 1
                    continue
                }
            }
            es.push(new_edge(x0, y0, x1, y1))
            i += 1
        }
        if xy[i * 2] != xy[0] or xy[i * 2 + 1] != xy[1] {
            es.push(new_edge(xy[i * 2], xy[i * 2 + 1], xy[0], xy[1]))
        }
        scan_fill(mut px, k, es, mask)
        return
    }
    for i in 0usize..count {
        let j = if i + 1 < count { i + 1 } else { 0 }
        if width == 1 {
            ink_line(mut px, k, xy[i * 2], xy[i * 2 + 1], xy[j * 2], xy[j * 2 + 1])
        } else {
            ink_wide_line(mut px, k, xy[i * 2], xy[i * 2 + 1], xy[j * 2], xy[j * 2 + 1], width, mask)
        }
    }
}

// Pillow's ImagingDrawRectangle: filled from row y0 to y1, or `width` rings inward.
fn draw_rect(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, fill: bool, width: i32) {
    let top = y0.min(y1)
    let bottom = y0.max(y1)
    if fill {
        if top >= k.h or bottom < 0 {
            return
        }
        for y in top.max(0)..bottom.min(k.h) + 1 {
            ink_hline(mut px, k, x0, y, x1, [])
        }
        return
    }
    let w = if width == 0 { 1 } else { width }
    // Ring i draws rows top + i and bottom - i, and columns x1 - i and x0 + i between; only the
    // rings that reach the image are drawn. Each pixel gets the same ink as many times as in
    // Pillow, and the same ink blended twice is the same whichever comes first.
    let (t, b, l, r, ww, hh) = (i64(top), i64(bottom), i64(x0), i64(x1), i64(k.w), i64(k.h))
    var spans: List<(i64, i64)> = [(-t, hh - 1 - t), (b - hh + 1, b), (r - ww + 1, r), (-l, ww - 1 - l)]
    spans.sort()
    var next: i64 = 0
    for (s, e) in spans {
        var i = s.max(next)
        let stop = e.min(i64(w) - 1)
        while i <= stop {
            let n = i32.wrap(i)
            ink_hline(mut px, k, x0, top + n, x1, [])
            ink_hline(mut px, k, x0, bottom - n, x1, [])
            ink_vline(mut px, k, x1 - n, top + w, bottom - w + 1)
            ink_vline(mut px, k, x0 + n, top + w, bottom - w + 1)
            i += 1
        }
        next = next.max(stop + 1)
    }
}

// A filled box that's skipped where its corners are the wrong way round: Pillow refuses those.
fn fill_box(px: mut List<u8>, k: Ink, x0: i64, y0: i64, x1: i64, y1: i64) {
    if x1 >= x0 and y1 >= y0 {
        draw_rect(mut px, k, c32(x0), c32(y0), c32(x1), c32(y1), true, 0)
    }
}

// Pillow's quarter_state: a quarter of an ellipse traced on the grid of doubled coordinates,
// from its right end up, the point nearest the curve each step.
struct Quarter {
    a2: i64
    b2: i64
    a2b2: i64
    cx: i32
    cy: i32
    ex: i32
    ey: i32
    done: bool
}

impl Quarter {
    fn new(a: i32, b: i32) -> Quarter {
        if a < 0 or b < 0 {
            return Quarter { a2: 0, b2: 0, a2b2: 0, cx: 0, cy: 0, ex: 0, ey: 0, done: true }
        }
        let a2 = i64(a) * i64(a)
        let b2 = i64(b) * i64(b)
        return Quarter { a2, b2, a2b2: a2 * b2, cx: a, cy: b % 2, ex: a % 2, ey: b, done: false }
    }

    // How far the point is from the curve: the ellipse's equation with it put in.
    fn off(self, x: i32, y: i32) -> i64 {
        let (fx, fy) = (i64(x), i64(y))
        return (self.a2 * fy * fy + self.b2 * fx * fx - self.a2b2).abs()
    }

    fn next(mut self) -> (i32, i32)? {
        if self.done {
            return none
        }
        let at = (self.cx, self.cy)
        if self.cx == self.ex and self.cy == self.ey {
            self.done = true
            return some(at)
        }
        var nx = self.cx
        var ny = self.cy + 2
        let up = self.off(nx, ny)
        if nx > 1 {
            let diagonal = self.off(self.cx - 2, self.cy + 2)
            let best = up.min(diagonal)
            if up > diagonal {
                nx = self.cx - 2
            }
            if best > self.off(self.cx - 2, self.cy) {
                nx = self.cx - 2
                ny = self.cy
            }
        }
        self.cx = nx
        self.cy = ny
        return some(at)
    }
}

// Pillow's ellipse_state: an ellipse's rows on the doubled grid, `width` thick, from an outer
// quarter and an inner one, each row given out for all four quarters.
struct EllipseRows {
    outer: Quarter
    inner: Quarter
    py: i32
    pl: i32
    pr: i32
    ys: [i32; 4]
    ls: [i32; 4]
    rs: [i32; 4]
    count: usize
    done: bool
    leftmost: i32
}

impl EllipseRows {
    fn new(a: i32, b: i32, width: i32) -> EllipseRows {
        var s = EllipseRows { outer: Quarter.new(a, b), inner: Quarter.new(-1, -1), py: 0, pl: 0, pr: 0, ys: [0, 0, 0, 0], ls: [0, 0, 0, 0], rs: [0, 0, 0, 0], count: 0, done: true, leftmost: a % 2 }
        if width < 1 {
            return s
        }
        let first = s.outer.next() else return s
        s.pr = first.0
        s.py = first.1
        s.done = false
        s.inner = Quarter.new(a - 2 * (width - 1), b - 2 * (width - 1))
        s.pl = s.leftmost
        return s
    }

    fn keep(mut self, l: i32, y: i32, r: i32) {
        self.ls[self.count] = l
        self.ys[self.count] = y
        self.rs[self.count] = r
        self.count += 1
    }

    // The next row: from x0 to x1 on row y, doubled.
    fn next(mut self) -> (i32, i32, i32)? {
        if self.count == 0 {
            if self.done {
                return none
            }
            let y = self.py
            var l = self.pl
            let r = self.pr
            loop {
                match self.outer.next() {
                    none => {
                        self.done = true
                        break
                    }
                    some(p) => {
                        if p.1 > y {
                            self.pr = p.0
                            self.py = p.1
                            break
                        }
                    }
                }
            }
            loop {
                match self.inner.next() {
                    none => {
                        self.pl = self.leftmost
                        break
                    }
                    some(p) => {
                        if p.1 > y {
                            self.pl = p.0
                            break
                        }
                        l = p.0
                    }
                }
            }
            let left = if l == 0 { 2 } else { l }
            if (l > 0 or l < r) and y > 0 {
                self.keep(left, y, r)
            }
            if y > 0 {
                self.keep(-r, y, -l)
            }
            if l > 0 or l < r {
                self.keep(left, -y, r)
            }
            self.keep(-r, -y, -l)
        }
        self.count -= 1
        let i = self.count
        return some((self.ls[i], self.ys[i], self.rs[i]))
    }
}

// Pillow's ellipseNew: the ellipse in the box, filled or `width` thick.
fn draw_ellipse(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, fill: bool, width: i32) {
    let a = x1 - x0
    let b = y1 - y0
    if a < 0 or b < 0 {
        return
    }
    var rows = EllipseRows.new(a, b, if fill { a + b } else { width })
    loop {
        let s = rows.next() else break
        ink_hline(mut px, k, x0 + (s.0 + a) / 2, y0 + (s.1 + b) / 2, x0 + (s.2 + a) / 2, [])
    }
}

// A node of Pillow's clipping tree: where both or either of two subtrees keep, or the
// half-plane where a x + b y + c isn't below 0.
struct ClipNode {
    op: u8
    a: f64
    b: f64
    c: f64
    l: usize
    r: usize
}

// An ellipse's rows and the tree that cuts them: Pillow's clip_ellipse_state.
struct Clipped {
    rows: EllipseRows
    nodes: List<ClipNode>
    root: usize?
}

impl Clipped {
    fn new(a: i32, b: i32, width: i32) -> Clipped {
        return Clipped { rows: EllipseRows.new(a, b, width), nodes: [], root: none }
    }

    fn plane(mut self, a: f64, b: f64, c: f64) -> usize {
        self.nodes.push(ClipNode { op: CLIP_PLANE, a, b, c, l: 0, r: 0 })
        return self.nodes.len() - 1
    }

    fn join(mut self, op: u8, l: usize, r: usize) -> usize {
        self.nodes.push(ClipNode { op, a: 0.0, b: 0.0, c: 0.0, l, r })
        return self.nodes.len() - 1
    }
}

// Pillow's clip_tree_do_clip: the row from x0 to x1 cut by the tree, as the ends of the pieces
// kept, each an x and 1 for a start or -1 for an end, in order.
fn clip_ends(nodes: List<ClipNode>, at: usize?, x0: i32, y: i32, x1: i32) -> List<(i32, i32)> {
    let i = at else return [(x0, 1), (x1, -1)]
    let n = nodes[i]
    if n.op == CLIP_PLANE {
        let eps = 1e-9
        var lo = x0
        var hi = x1
        let fy = f64(y)
        if n.a.abs() < eps {
            if n.b * fy + n.c < -eps {
                lo = 1
                hi = 0
            }
        } else {
            let ix = -(n.b * fy + n.c) / n.a
            if n.a * f64(x0) + n.b * fy + n.c < eps {
                lo = lround(f64(x0).max(ix))
            }
            if n.a * f64(x1) + n.b * fy + n.c < eps {
                hi = lround(f64(x1).min(ix))
            }
        }
        if lo <= hi {
            return [(lo, 1), (hi, -1)]
        }
        return []
    }
    let l1 = clip_ends(nodes, some(n.l), x0, y, x1)
    let l2 = clip_ends(nodes, some(n.r), x0, y, x1)
    var out: List<(i32, i32)> = []
    var i1: usize = 0
    var i2: usize = 0
    var k1: i32 = 0
    var k2: i32 = 0
    while i1 < l1.len() or i2 < l2.len() {
        let first = i2 >= l2.len() or (i1 < l1.len() and (l1[i1].0 < l2[i2].0 or (l1[i1].0 == l2[i2].0 and l1[i1].1 > l2[i2].1)))
        var t: (i32, i32) = (0, 0)
        if first {
            t = l1[i1]
            k1 += t.1
            i1 += 1
        } else {
            t = l2[i2]
            k2 += t.1
            i2 += 1
        }
        let open = out.len() > 0 and out[out.len() - 1].1 == 1
        let keep = if n.op == CLIP_OR {
            (t.1 == 1 and not open) or (t.1 == -1 and k1 == 0 and k2 == 0)
        } else {
            (t.1 == 1 and not open and k1 > 0 and k2 > 0) or (t.1 == -1 and open and (k1 == 0 or k2 == 0))
        }
        if keep {
            out.push(t)
        }
    }
    return out
}

// Pillow's clipEllipseNew: the rows of the ellipse in the box at (x0, y0), `a` and `b` across
// and down, cut by the tree.
fn draw_clipped(px: mut List<u8>, k: Ink, x0: i32, y0: i32, a: i32, b: i32, c: mut Clipped) {
    loop {
        let s = c.rows.next() else break
        let ends = clip_ends(c.nodes, c.root, s.0, s.1, s.2)
        var i: usize = 0
        while i + 1 < ends.len() {
            ink_hline(mut px, k, x0 + (ends[i].0 + a) / 2, y0 + (s.1 + b) / 2, x0 + (ends[i + 1].0 + a) / 2, [])
            i += 2
        }
    }
}

// Pillow's normalize_angles: 0 <= start < 360 and start <= end <= start + 360, in f32 as Pillow
// keeps them, worked out with C's fmod.
fn normalize_angles(al: f32, ar: f32) -> (f32, f32) {
    if ar - al >= 360.0f32 {
        return (0.0f32, 360.0f32)
    }
    let from = if al < 0.0f32 { 360.0 - (f64(-al) % 360.0) } else { f64(al) }
    let l = f32.nearest(from % 360.0)
    let span = if ar < l { 360.0 - (f64(l - ar) % 360.0) } else { f64(ar - l) }
    return (l, f32.nearest(f64(l) + (span % 360.0)))
}

// Pillow's arc_init: an arc from `al` to `ar` degrees, its ends cut square to the curve, worked
// out on an ellipse wider than it's tall and turned for one that isn't.
fn arc_clip(a: i32, b: i32, width: i32, al0: f32, ar0: f32) -> Clipped {
    if a < b {
        var c = arc_clip(b, a, width, 90.0f32 - ar0, 90.0f32 - al0)
        c.rows = EllipseRows.new(a, b, width)
        for i in 0usize..c.nodes.len() {
            if c.nodes[i].op == CLIP_PLANE {
                let t = c.nodes[i].a
                c.nodes[i].a = c.nodes[i].b
                c.nodes[i].b = t
            }
        }
        return c
    }
    var c = Clipped.new(a, b, width)
    let (al, ar) = normalize_angles(al0, ar0)
    if ar == al + 360.0f32 {
        return c
    }
    let (l, r) = (f64(al), f64(ar))
    let lc = c.plane(f64(-a) * sin(l * PI / 180.0), f64(b) * cos(l * PI / 180.0), f64(a * a - b * b) * sin(l * PI / 90.0) / 2.0)
    let rc = c.plane(f64(a) * sin(r * PI / 180.0), f64(-b) * cos(r * PI / 180.0), f64(b * b - a * a) * sin(r * PI / 90.0) / 2.0)
    let narrow = if ar - al < 180.0f32 { CLIP_AND } else { CLIP_OR }
    let half_l = i32.saturate(f64(al / 180.0f32))
    let half_r = i32.saturate(f64(ar / 180.0f32))
    if l % 180.0 == 0.0 or r % 180.0 == 0.0 {
        c.root = some(c.join(narrow, lc, rc))
    } else if (half_l + half_r) % 2 == 1 {
        let pl = c.plane(0.0, if half_l % 2 == 0 { 1.0 } else { -1.0 }, 0.0)
        let pr = c.plane(0.0, if half_r % 2 == 0 { 1.0 } else { -1.0 }, 0.0)
        let left = c.join(CLIP_AND, pl, lc)
        let right = c.join(CLIP_AND, pr, rc)
        c.root = some(c.join(CLIP_OR, left, right))
    } else {
        let both = c.join(narrow, lc, rc)
        let side = c.plane(0.0, if ar < 180.0f32 or ar > 540.0f32 { 1.0 } else { -1.0 }, 0.0)
        c.root = some(c.join(narrow, both, side))
    }
    return c
}

// The ends of the arc from `al` to `ar` on the ellipse a by b: x at al, x at ar, y at al, y at ar.
fn arc_ends(a: i32, b: i32, al: f32, ar: f32) -> (f64, f64, f64, f64) {
    let (l, r) = (f64(al) * PI / 180.0, f64(ar) * PI / 180.0)
    return (f64(a) * cos(l), f64(a) * cos(r), f64(b) * sin(l), f64(b) * sin(r))
}

// Pillow's chord_line_init: the band `width` thick inside the chord's line.
fn chord_line_clip(a: i32, b: i32, width: i32, al: f32, ar: f32) -> Clipped {
    var c = Clipped.new(a, b, a + b + 1)
    let (xl, xr, yl, yr) = arc_ends(a, b, al, ar)
    let la = yr - yl
    let lb = xl - xr
    let lc = -(la * xl + lb * yl)
    let near = c.plane(la, lb, lc)
    let far = c.plane(-la, -lb, f64(2 * width) * (la * la + lb * lb).sqrt() - lc)
    c.root = some(c.join(CLIP_AND, near, far))
    return c
}

// Pillow's pie_side_init: the side of a pie slice at `al` degrees, `width` thick.
fn pie_side_clip(a: i32, b: i32, width: i32, al: f32) -> Clipped {
    var c = Clipped.new(a, b, a + b + 1)
    let (xl, _, yl, _) = arc_ends(a, b, al, al)
    let a1 = -yl
    let b1 = xl
    let c1 = f64(width) * (a1 * a1 + b1 * b1).sqrt()
    let p1 = c.plane(a1, b1, c1)
    let p2 = c.plane(-a1, -b1, c1)
    let band = c.join(CLIP_AND, p1, p2)
    let ahead = c.plane(b1, -a1, 0.0)
    c.root = some(c.join(CLIP_AND, band, ahead))
    return c
}

// Pillow's chord_init: the ellipse on one side of the chord's line.
fn chord_clip(a: i32, b: i32, width: i32, al: f32, ar: f32) -> Clipped {
    var c = Clipped.new(a, b, width)
    let (xl, xr, yl, yr) = arc_ends(a, b, al, ar)
    let ca = yr - yl
    let cb = xl - xr
    c.root = some(c.plane(ca, cb, -(ca * xl + cb * yl)))
    return c
}

// Pillow's pie_init: the ellipse between the two sides of a pie slice, and in front of the
// center for a slice narrower than 90 degrees, so it has no spike behind.
fn pie_clip(a: i32, b: i32, width: i32, al: f32, ar: f32) -> Clipped {
    var c = Clipped.new(a, b, width)
    let (xl, xr, yl, yr) = arc_ends(a, b, al, ar)
    let lc = c.plane(-yl, xl, 0.0)
    let rc = c.plane(yr, -xr, 0.0)
    var root = c.join(if ar - al < 180.0f32 { CLIP_AND } else { CLIP_OR }, lc, rc)
    if ar - al < 90.0f32 {
        let spike = c.plane((xl + xr) / 2.0, (yl + yr) / 2.0, 0.0)
        root = c.join(CLIP_AND, root, spike)
    }
    c.root = some(root)
    return c
}

// Pillow's ImagingDrawArc.
fn draw_arc(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, start: f32, end: f32, width: i32) {
    let (s, e) = normalize_angles(start, end)
    if s + 360.0f32 == e {
        draw_ellipse(mut px, k, x0, y0, x1, y1, false, width)
        return
    }
    let (a, b) = (x1 - x0, y1 - y0)
    if s == e or a < 0 or b < 0 {
        return
    }
    var c = arc_clip(a, b, width, s, e)
    draw_clipped(mut px, k, x0, y0, a, b, mut c)
}

// Pillow's ImagingDrawChord.
fn draw_chord(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, start: f32, end: f32, fill: bool, width: i32) {
    let (s, e) = normalize_angles(start, end)
    if s + 360.0f32 == e {
        draw_ellipse(mut px, k, x0, y0, x1, y1, fill, width)
        return
    }
    let (a, b) = (x1 - x0, y1 - y0)
    if s == e or a < 0 or b < 0 {
        return
    }
    if fill {
        var c = chord_clip(a, b, a + b + 1, s, e)
        draw_clipped(mut px, k, x0, y0, a, b, mut c)
        return
    }
    var band = chord_line_clip(a, b, width, s, e)
    draw_clipped(mut px, k, x0, y0, a, b, mut band)
    var c = chord_clip(a, b, width, s, e)
    draw_clipped(mut px, k, x0, y0, a, b, mut c)
}

// Pillow's ImagingDrawPieslice: filled, or its two sides, a dot at the center the edge's width
// across, and its curved edge.
fn draw_pieslice(px: mut List<u8>, k: Ink, x0: i32, y0: i32, x1: i32, y1: i32, start: f32, end: f32, fill: bool, width: i32) {
    let (s, e) = normalize_angles(start, end)
    if s + 360.0f32 == e {
        draw_ellipse(mut px, k, x0, y0, x1, y1, fill, width)
        return
    }
    if s == e {
        return
    }
    let (a, b) = (x1 - x0, y1 - y0)
    let shaped = a >= 0 and b >= 0
    if fill {
        if shaped {
            var c = pie_clip(a, b, a + b, s, e)
            draw_clipped(mut px, k, x0, y0, a, b, mut c)
        }
        return
    }
    if shaped {
        var side = pie_side_clip(a, b, width, s)
        draw_clipped(mut px, k, x0, y0, a, b, mut side)
        var other = pie_side_clip(a, b, width, e)
        draw_clipped(mut px, k, x0, y0, a, b, mut other)
    }
    let xc = lround(f64(x0 + x1 - width) / 2.0)
    let yc = lround(f64(y0 + y1 - width) / 2.0)
    draw_ellipse(mut px, k, xc, yc, xc + width - 1, yc + width - 1, true, 0)
    if shaped {
        var c = pie_clip(a, b, width, s, e)
        draw_clipped(mut px, k, x0, y0, a, b, mut c)
    }
}

// The bytes a pixel of `kind` holds for `color`.
fn pixel_bytes(kind: Kind, c: Color) -> [u8; 4] {
    return match kind {
        Gray => [c.luma(), 0, 0, 0],
        GrayAlpha => [c.luma(), c.a, 0, 0],
        Rgb => [c.r, c.g, c.b, 0],
        Rgba => [c.r, c.g, c.b, c.a],
    }
}

fn close(a: List<u8>, b: List<u8>, threshold: u8) -> bool {
    for i in 0usize..a.len() {
        let d = if a[i] > b[i] { a[i] - b[i] } else { b[i] - a[i] }
        if d > threshold {
            return false
        }
    }
    return true
}

fn div255(v: u32) -> u32 {
    return ((v >> 8) + v) >> 8
}

// Colors weighted by alpha, as Pillow's RGBa, with its rounding.
fn premultiply(pixels: List<u8>, ch: usize) -> List<u8> {
    var out = pixels.copy()
    let n = pixels.len() / ch
    for i in 0usize..n {
        let a = u32(pixels[i * ch + ch - 1])
        for c in 0usize..ch - 1 {
            let t = u32(pixels[i * ch + c]) * a + 128
            out[i * ch + c] = u8.wrap(((t >> 8) + t) >> 8)
        }
    }
    return out
}

fn unpremultiply(pixels: List<u8>, ch: usize) -> List<u8> {
    var out = pixels.copy()
    let n = pixels.len() / ch
    for i in 0usize..n {
        let a = u32(pixels[i * ch + ch - 1])
        if a == 0 or a == 255 {
            continue
        }
        for c in 0usize..ch - 1 {
            out[i * ch + c] = u8.wrap((255 * u32(pixels[i * ch + c]) / a).min(255))
        }
    }
    return out
}

// Pillow's nearest-neighbor resize: each new pixel's center mapped back, the position stepped
// along by adding the scale, as Pillow steps it.
fn nearest(pixels: List<u8>, w: usize, h: usize, ch: usize, nw: usize, nh: usize) -> List<u8> {
    let sx = f64.nearest(w) / f64.nearest(nw)
    let sy = f64.nearest(h) / f64.nearest(nh)
    var xs: List<usize> = []
    var xo = sx * 0.5
    for _ in 0usize..nw {
        xs.push(usize.wrap(i64.saturate(xo).min(i64.wrap(w) - 1)))
        xo += sx
    }
    var out: List<u8> = []
    out.reserve(nw * nh * ch)
    var yo = sy * 0.5
    for _ in 0usize..nh {
        let y = usize.wrap(i64.saturate(yo).min(i64.wrap(h) - 1))
        for x in xs {
            let at = (y * w + x) * ch
            for c in 0usize..ch {
                out.push(pixels[at + c])
            }
        }
        yo += sy
    }
    return out
}

// A filter's reach, in source pixels at full size, and which it is.
fn filter_info(f: Filter) -> (f64, i32) {
    return match f {
        Box => (0.5, 0),
        Bilinear => (1.0, 1),
        Hamming => (1.0, 2),
        Bicubic => (2.0, 3),
        Lanczos => (3.0, 4),
        Nearest => (0.5, 0),
    }
}

fn sinc(x: f64) -> f64 {
    if x == 0.0 {
        return 1.0
    }
    let y = x * PI
    return sin(y) / y
}

fn weight(kind: i32, x0: f64) -> f64 {
    var x = x0
    if kind == 0 {
        return if x > -0.5 and x <= 0.5 { 1.0 } else { 0.0 }
    }
    if kind == 4 {
        return if x >= -3.0 and x < 3.0 { sinc(x) * sinc(x / 3.0) } else { 0.0 }
    }
    if x < 0.0 {
        x = -x
    }
    if kind == 1 {
        return if x < 1.0 { 1.0 - x } else { 0.0 }
    }
    if kind == 2 {
        if x == 0.0 {
            return 1.0
        }
        if x >= 1.0 {
            return 0.0
        }
        let y = x * PI
        return sin(y) / y * (0.54 + 0.46 * cos(y))
    }
    // Bicubic, a = -0.5.
    if x < 1.0 {
        return ((-0.5 + 2.0) * x - (-0.5 + 3.0)) * x * x + 1.0
    }
    if x < 2.0 {
        return (((x - 5.0) * x + 8.0) * x - 4.0) * -0.5
    }
    return 0.0
}

// Pillow's precompute_coeffs and normalize_coeffs_8bpc: for each new pixel, the first source
// pixel and how many it takes, and their weights in 22-bit fixed point, `size` to a pixel.
fn coefficients(in_size: usize, out_size: usize, support0: f64, kind: i32) -> (List<usize>, List<i32>, usize) {
    let scale = f64.nearest(in_size) / f64.nearest(out_size)
    let filterscale = if scale < 1.0 { 1.0 } else { scale }
    let support = support0 * filterscale
    let size = usize.wrap(i64.saturate(support.ceil())) * 2 + 1
    var bounds: List<usize> = []
    var kk: List<i32> = [0; out_size * size]
    var w: List<f64> = [0.0; size]
    for xx in 0usize..out_size {
        let center = (f64.nearest(xx) + 0.5) * scale
        let ss = 1.0 / filterscale
        let xmin = i64.saturate(center - support + 0.5).max(0)
        let xmax = i64.saturate(center + support + 0.5).min(i64.wrap(in_size))
        let count = usize.wrap((xmax - xmin).max(0))
        var ww = 0.0
        for x in 0usize..count {
            let v = weight(kind, (f64.nearest(x) + f64.nearest(xmin) - center + 0.5) * ss)
            w[x] = v
            ww += v
        }
        for x in 0usize..count {
            let v = if ww != 0.0 { w[x] / ww } else { w[x] }
            let scaled = v * 4194304.0
            kk[xx * size + x] = i32.saturate(if v < 0.0 { scaled - 0.5 } else { scaled + 0.5 })
        }
        bounds.push(usize.wrap(xmin))
        bounds.push(count)
    }
    return (bounds, kk, size)
}

fn clip8(v: i32) -> u8 {
    return u8.wrap((v >> 22).max(0).min(255))
}

// Rows `first` to `last` resized across.
fn convolve_rows(src: List<u8>, w: usize, ch: usize, first: usize, last: usize, nw: usize, bounds: List<usize>, kk: List<i32>, size: usize) -> List<u8> {
    let rows = last - first
    var out: List<u8> = []
    out.reserve(rows * nw * ch)
    unsafe {
        out.set_len(rows * nw * ch)
        let s = src.as_ptr()
        let d = out.as_mut_ptr()
        let k = kk.as_ptr()
        for y in 0usize..rows {
            let row = s.add((first + y) * w * ch)
            for xx in 0usize..nw {
                let xmin = bounds[xx * 2]
                let count = bounds[xx * 2 + 1]
                let kw = k.add(xx * size)
                for c in 0usize..ch {
                    var ss: i32 = 1 << 21
                    for x in 0usize..count {
                        ss += i32(row.add((xmin + x) * ch + c).read()) * kw.add(x).read()
                    }
                    d.add((y * nw + xx) * ch + c).write(clip8(ss))
                }
            }
        }
    }
    return out
}

// Resized down: `bounds` count from row `start` of the original, which is row 0 of `src`.
fn convolve_cols(src: List<u8>, w: usize, ch: usize, nh: usize, bounds: List<usize>, kk: List<i32>, size: usize, start: usize) -> List<u8> {
    let row = w * ch
    var out: List<u8> = []
    out.reserve(nh * row)
    var acc: List<i32> = [0; row]
    unsafe {
        out.set_len(nh * row)
        let s = src.as_ptr()
        let d = out.as_mut_ptr()
        let a = acc.as_mut_ptr()
        for yy in 0usize..nh {
            let ymin = bounds[yy * 2] - start
            let count = bounds[yy * 2 + 1]
            for i in 0usize..row {
                a.add(i).write(1 << 21)
            }
            for y in 0usize..count {
                let kv = kk[yy * size + y]
                let r = s.add((ymin + y) * row)
                for i in 0usize..row {
                    a.add(i).write(a.add(i).read() + i32(r.add(i).read()) * kv)
                }
            }
            let o = d.add(yy * row)
            for i in 0usize..row {
                o.add(i).write(clip8(a.add(i).read()))
            }
        }
    }
    return out
}

// Pillow's _gaussian_blur_radius: the box radius whose `passes` box blurs spread as a Gaussian
// of this radius does, in single precision as Pillow works it out.
fn gaussian_box(radius: f32, passes: i32) -> f32 {
    let sigma2 = radius * radius / f32.nearest(passes)
    let big_l = f32.nearest((f64(sigma2 * 12.0f32 + 1.0f32)).sqrt())
    let l = ((big_l - 1.0f32) / 2.0f32).floor()
    var a = (2.0f32 * l + 1.0f32) * (l * (l + 1.0f32) - 3.0f32 * sigma2)
    a /= 6.0f32 * (sigma2 - (l + 1.0f32) * (l + 1.0f32))
    return l + a
}

// Pillow's ImagingBoxBlur: `passes` box blurs across, then the same down.
fn box_blur(pixels: List<u8>, w: usize, h: usize, ch: usize, radius: f32, passes: i32) -> List<u8> {
    var cur = pixels.copy()
    if radius == 0.0f32 {
        return cur
    }
    for _ in 0i32..passes {
        cur = blur_rows(cur, w, h, ch, radius)
    }
    for _ in 0i32..passes {
        cur = blur_cols(cur, w, h, ch, radius)
    }
    return cur
}

// A box blur's weights in 24-bit fixed point: each whole pixel's, and the two farthest's, the
// radius's fraction of one, as Pillow's ImagingHorizontalBoxBlur works them out.
fn box_weights(float_radius: f32) -> (usize, u32, u32) {
    let radius = usize.wrap(i32.saturate(float_radius))
    let ww = u32.wrap(i64.saturate(f64(16777216.0f32 / (float_radius * 2.0f32 + 1.0f32))))
    let fw = (16777216 - u32.wrap(radius * 2 + 1) * ww) / 2
    return (radius, ww, fw)
}

// One box blur of each row, the edges repeated, as Pillow's: a running sum, all channels of a
// pixel at once. Past the first and last radius + 1 pixels, nothing is clamped.
fn blur_rows(pixels: List<u8>, w: usize, h: usize, ch: usize, float_radius: f32) -> List<u8> {
    let (radius, ww, fw) = box_weights(float_radius)
    let last = w - 1
    let edge_a = (radius + 1).min(w)
    // The middle, from a to b: every position the sum reaches is inside the row.
    let a = edge_a
    let b = if w > radius + 1 { (w - radius - 1).max(a) } else { a }
    var out: List<u8> = []
    out.reserve(pixels.len())
    unsafe {
        out.set_len(pixels.len())
        let s = pixels.as_ptr()
        let d = out.as_mut_ptr()
        for y in 0usize..h {
            let line = s.add(y * w * ch)
            let o = d.add(y * w * ch)
            var acc: [u32; 4] = [0; 4]
            for c in 0usize..ch {
                var v = u32(line.add(c).read()) * u32.wrap(radius + 1)
                for x in 0usize..edge_a - 1 {
                    v += u32(line.add(x * ch + c).read())
                }
                v += u32(line.add(last * ch + c).read()) * u32.wrap(radius + 1 - edge_a)
                acc[c] = v
            }
            for x in 0usize..w {
                if x == a and b > a {
                    // The middle.
                    for m in a..b {
                        let sub = line.add((m - radius - 1) * ch)
                        let add = line.add((m + radius) * ch)
                        let far = line.add((m + radius + 1) * ch)
                        for c in 0usize..ch {
                            let sv = u32(sub.add(c).read())
                            acc[c] = acc[c] + u32(add.add(c).read()) - sv
                            let bulk = acc[c] * ww + (sv + u32(far.add(c).read())) * fw
                            o.add(m * ch + c).write(u8.wrap((bulk + (1u32 << 23)) >> 24))
                        }
                    }
                }
                if x >= a and x < b {
                    continue
                }
                let sub = line.add((if x >= radius + 1 { x - radius - 1 } else { 0usize }) * ch)
                let add = line.add((x + radius).min(last) * ch)
                let far = line.add((x + radius + 1).min(last) * ch)
                for c in 0usize..ch {
                    let sv = u32(sub.add(c).read())
                    acc[c] = acc[c] + u32(add.add(c).read()) - sv
                    let bulk = acc[c] * ww + (sv + u32(far.add(c).read())) * fw
                    o.add(x * ch + c).write(u8.wrap((bulk + (1u32 << 23)) >> 24))
                }
            }
        }
    }
    return out
}

// One box blur of each column, as Pillow's blur of the image turned on its side gives, worked
// out a row at a time, so every column's sum moves at once.
fn blur_cols(pixels: List<u8>, w: usize, h: usize, ch: usize, float_radius: f32) -> List<u8> {
    let (radius, ww, fw) = box_weights(float_radius)
    let n = w * ch
    let last = h - 1
    let edge_a = (radius + 1).min(h)
    var acc: List<u32> = [0; n]
    var out: List<u8> = []
    out.reserve(pixels.len())
    unsafe {
        out.set_len(pixels.len())
        let s = pixels.as_ptr()
        let d = out.as_mut_ptr()
        let ap = acc.as_mut_ptr()
        let first = s
        let end = s.add(last * n)
        for i in 0usize..n {
            ap.add(i).write(u32(first.add(i).read()) * u32.wrap(radius + 1) + u32(end.add(i).read()) * u32.wrap(radius + 1 - edge_a))
        }
        for y in 0usize..edge_a - 1 {
            let r = s.add(y * n)
            for i in 0usize..n {
                ap.add(i).write(ap.add(i).read() + u32(r.add(i).read()))
            }
        }
        for y in 0usize..h {
            let sub = s.add((if y >= radius + 1 { y - radius - 1 } else { 0usize }) * n)
            let add = s.add((y + radius).min(last) * n)
            let far = s.add((y + radius + 1).min(last) * n)
            let o = d.add(y * n)
            for i in 0usize..n {
                let sv = u32(sub.add(i).read())
                let v = ap.add(i).read() + u32(add.add(i).read()) - sv
                ap.add(i).write(v)
                let bulk = v * ww + (sv + u32(far.add(i).read())) * fw
                o.add(i).write(u8.wrap((bulk + (1u32 << 23)) >> 24))
            }
        }
    }
    return out
}

// A color in the palette search: its channels, and how many pixels have it.
struct Bucket {
    from: usize
    to: usize
}

// Median cut over the distinct colors, weighted by how often each comes, then a few rounds of
// k-means; each pixel takes the nearest palette color.
fn quantize_rgba(pixels: List<u8>, w: usize, h: usize, colors: usize) -> Paletted {
    let n = w * h
    // The distinct colors and their counts.
    var counts = Map<u32, u32>()
    for i in 0usize..n {
        let key = u32(pixels[i * 4]) << 24 | u32(pixels[i * 4 + 1]) << 16 | u32(pixels[i * 4 + 2]) << 8 | u32(pixels[i * 4 + 3])
        let c = counts.get(key) ?? 0
        counts.insert(key, c + 1)
    }
    var keys: List<u32> = []
    for (k, _) in counts {
        keys.push(k)
    }
    keys.sort()
    var palette: List<Color> = []
    if keys.len() <= colors {
        // Few enough to keep them all, exactly.
        var index = Map<u32, u8>()
        for i in 0usize..keys.len() {
            index.insert(keys[i], u8.wrap(i))
            palette.push(unpack(keys[i]))
        }
        var indexes: List<u8> = []
        indexes.reserve(n)
        for i in 0usize..n {
            let key = u32(pixels[i * 4]) << 24 | u32(pixels[i * 4 + 1]) << 16 | u32(pixels[i * 4 + 2]) << 8 | u32(pixels[i * 4 + 3])
            indexes.push(index.get(key) ?? 0)
        }
        return Paletted { w, h, indexes, palette }
    }
    var weights: List<u64> = []
    for k in keys {
        weights.push(u64(counts.get(k) ?? 0))
    }
    // Median cut: split the bucket with the widest channel, weighted by its pixels, at the
    // weighted median of that channel.
    var order: List<usize> = []
    for i in 0usize..keys.len() {
        order.push(i)
    }
    var buckets: List<Bucket> = [Bucket { from: 0, to: keys.len() }]
    while buckets.len() < colors {
        var best: usize = 0
        var best_score: u64 = 0
        var best_channel: u32 = 0
        for b in 0usize..buckets.len() {
            let (from, to) = (buckets[b].from, buckets[b].to)
            if to - from < 2 {
                continue
            }
            var total: u64 = 0
            for i in from..to {
                total += weights[order[i]]
            }
            for channel in 0u32..4 {
                var lo: u32 = 255
                var hi: u32 = 0
                for i in from..to {
                    let v = (keys[order[i]] >> (24 - channel * 8)) & 255
                    lo = lo.min(v)
                    hi = hi.max(v)
                }
                let score = u64(hi - lo) * u64(hi - lo) * total
                if score > best_score {
                    best_score = score
                    best = b
                    best_channel = channel
                }
            }
        }
        if best_score == 0 {
            break
        }
        let (from, to) = (buckets[best].from, buckets[best].to)
        let shift = 24 - best_channel * 8
        var part = order[from..to]
        part.sort_by_key(|i| (keys[i] >> shift) & 255)
        var total: u64 = 0
        for i in part {
            total += weights[i]
        }
        var run: u64 = 0
        var cut = from + 1
        for j in 0usize..part.len() - 1 {
            run += weights[part[j]]
            cut = from + j + 1
            if run * 2 >= total {
                break
            }
        }
        for j in 0usize..part.len() {
            order[from + j] = part[j]
        }
        buckets[best] = Bucket { from, to: cut }
        buckets.push(Bucket { from: cut, to })
    }
    // Each bucket's weighted mean, then k-means over the distinct colors.
    var centers: List<[f64; 4]> = []
    for b in buckets {
        var sum: [f64; 4] = [0.0; 4]
        var total = 0.0
        for i in b.from..b.to {
            let k = keys[order[i]]
            let wt = f64.nearest(weights[order[i]])
            for c in 0usize..4 {
                sum[c] += f64((k >> u32.wrap(24 - c * 8)) & 255) * wt
            }
            total += wt
        }
        centers.push(sum.map(|s| s / total))
    }
    var assign: List<usize> = [0; keys.len()]
    for _ in 0usize..4 {
        for i in 0usize..keys.len() {
            assign[i] = nearest_center(centers, keys[i])
        }
        var sums: List<[f64; 4]> = [[0.0; 4]; centers.len()]
        var totals: List<f64> = [0.0; centers.len()]
        for i in 0usize..keys.len() {
            let wt = f64.nearest(weights[i])
            for c in 0usize..4 {
                sums[assign[i]][c] += f64((keys[i] >> u32.wrap(24 - c * 8)) & 255) * wt
            }
            totals[assign[i]] += wt
        }
        for j in 0usize..centers.len() {
            if totals[j] > 0.0 {
                centers[j] = sums[j].map(|s| s / totals[j])
            }
        }
    }
    for c in centers {
        palette.push(Color { r: u8.wrap(i64.round(c[0]).max(0).min(255)), g: u8.wrap(i64.round(c[1]).max(0).min(255)), b: u8.wrap(i64.round(c[2]).max(0).min(255)), a: u8.wrap(i64.round(c[3]).max(0).min(255)) })
    }
    // Each distinct color's nearest palette color, then each pixel's.
    var centers8: List<[f64; 4]> = []
    for c in palette {
        centers8.push([f64(c.r), f64(c.g), f64(c.b), f64(c.a)])
    }
    var index = Map<u32, u8>()
    for k in keys {
        index.insert(k, u8.wrap(nearest_center(centers8, k)))
    }
    var indexes: List<u8> = []
    indexes.reserve(n)
    for i in 0usize..n {
        let key = u32(pixels[i * 4]) << 24 | u32(pixels[i * 4 + 1]) << 16 | u32(pixels[i * 4 + 2]) << 8 | u32(pixels[i * 4 + 3])
        indexes.push(index.get(key) ?? 0)
    }
    return Paletted { w, h, indexes, palette }
}

fn unpack(k: u32) -> Color {
    return Color { r: u8.wrap(k >> 24), g: u8.wrap(k >> 16), b: u8.wrap(k >> 8), a: u8.wrap(k) }
}

fn nearest_center(centers: List<[f64; 4]>, k: u32) -> usize {
    let v: [f64; 4] = [f64((k >> 24) & 255), f64((k >> 16) & 255), f64((k >> 8) & 255), f64(k & 255)]
    var best: usize = 0
    var best_d = 1.0e30
    for j in 0usize..centers.len() {
        var d = 0.0
        for c in 0usize..4 {
            let e = centers[j][c] - v[c]
            d += e * e
        }
        if d < best_d {
            best_d = d
            best = j
        }
    }
    return best
}

/// Images as an ICO file, each stored as a PNG, smallest first, as Pillow writes one: a
/// Windows icon, or a website's favicon.ico. Panics unless there's at least one image, each
/// at most 256 pixels a side.
@track_caller
pub fn encode_ico(images: List<Image>) -> List<u8> {
    if images.is_empty() {
        panic("an icon holds at least one image")
    }
    var order: List<usize> = []
    for i in 0usize..images.len() {
        if images[i].w > 256 or images[i].h > 256 {
            panic("an icon's images are at most 256 pixels a side, not {images[i].w} by {images[i].h}")
        }
        order.push(i)
    }
    order.sort_by_key(|i| images[i].w * images[i].h)
    var out: List<u8> = [0, 0, 1, 0, u8.wrap(images.len() % 256), u8.wrap(images.len() / 256)]
    var datas: List<List<u8>> = []
    for i in order {
        datas.push(images[i].encode_png())
    }
    var offset = 6 + 16 * images.len()
    for j in 0usize..order.len() {
        let (iw, ih) = (images[order[j]].w, images[order[j]].h)
        out.push(if iw < 256 { u8.wrap(iw) } else { 0u8 })
        out.push(if ih < 256 { u8.wrap(ih) } else { 0u8 })
        out.extend([0, 0, 0, 0, 32, 0])
        let len = datas[j].len()
        for v in [len, offset] {
            out.push(u8.wrap(v % 256))
            out.push(u8.wrap(v / 256 % 256))
            out.push(u8.wrap(v / 65536 % 256))
            out.push(u8.wrap(v / 16777216 % 256))
        }
        offset += len
    }
    for d in datas {
        out.extend(d)
    }
    return out
}

fn le16(b: List<u8>, at: usize) -> usize {
    return usize(b[at]) | usize(b[at + 1]) * 256
}

fn le32(b: List<u8>, at: usize) -> usize {
    return le16(b, at) | le16(b, at + 2) * 65536
}

/// The images in an ICO file, or why they can't be read: PNG entries as `Image.decode` reads
/// them, and bitmap ones, of 1, 4, 8, 24 or 32 bits with their transparency mask, as RGBA.
pub fn decode_ico(bytes: List<u8>) -> List<Image> ! String {
    if bytes.len() < 6 or bytes[0] != 0 or bytes[1] != 0 or bytes[2] != 1 or bytes[3] != 0 {
        fail String("not an ICO file")
    }
    let count = le16(bytes, 4)
    if count == 0 or bytes.len() < 6 + 16 * count {
        fail String("the ICO file's directory is cut short")
    }
    var images: List<Image> = []
    for i in 0usize..count {
        let e = 6 + 16 * i
        let size = le32(bytes, e + 8)
        let at = le32(bytes, e + 12)
        if at > bytes.len() or size > bytes.len() - at {
            fail "the ICO file's image {i} runs past its end"
        }
        let data = bytes[at..at + size]
        if data.len() >= 8 and data[0] == 137 and data[1] == 80 {
            images.push(try Image.decode(data))
        } else {
            images.push(try decode_dib(data))
        }
    }
    return images
}

// A bitmap in an icon: its header, then the pixels bottom row first, then a 1-bit mask of the
// clear pixels, twice the height counting both.
fn decode_dib(d: List<u8>) -> Image ! String {
    if d.len() < 40 {
        fail String("the ICO file's bitmap is cut short")
    }
    let header = le32(d, 0)
    let w = le32(d, 4)
    let h2 = le32(d, 8)
    let bits = le16(d, 14)
    let compression = le32(d, 16)
    if header < 40 or w == 0 or w > 256 or h2 < 2 or h2 > 512 or compression != 0 {
        fail String("the ICO file has a bitmap it can't read")
    }
    let h = h2 / 2
    let used = le32(d, 32)
    let palette_size = if bits <= 8 { if used == 0 { usize(1u32 << u32.wrap(bits)) } else { used } } else { 0usize }
    let pal = header
    let start = pal + palette_size * 4
    let stride = (w * bits + 31) / 32 * 4
    let mask_stride = (w + 31) / 32 * 4
    if bits != 1 and bits != 4 and bits != 8 and bits != 24 and bits != 32 {
        fail "the ICO file has a {bits}-bit bitmap, which isn't read"
    }
    if start + stride * h > d.len() {
        fail String("the ICO file's bitmap is cut short")
    }
    let mask_at = start + stride * h
    let has_mask = mask_at + mask_stride * h <= d.len()
    var out: List<u8> = []
    out.reserve(w * h * 4)
    for y in 0usize..h {
        let row = start + (h - 1 - y) * stride
        for x in 0usize..w {
            var px: [u8; 4] = [0, 0, 0, 255]
            if bits == 32 {
                let p = row + x * 4
                px = [d[p + 2], d[p + 1], d[p], d[p + 3]]
            } else if bits == 24 {
                let p = row + x * 3
                px = [d[p + 2], d[p + 1], d[p], 255]
            } else {
                let per = 8 / bits
                let byte = u32(d[row + x / per])
                let shift = u32.wrap(8 - (x % per + 1) * bits)
                let index = usize((byte >> shift) & ((1u32 << u32.wrap(bits)) - 1))
                let p = pal + index * 4
                if p + 3 < start {
                    px = [d[p + 2], d[p + 1], d[p], 255]
                }
            }
            if has_mask and bits != 32 {
                let m = u32(d[mask_at + (h - 1 - y) * mask_stride + x / 8])
                if (m >> u32.wrap(7 - x % 8)) & 1 == 1 {
                    px[3] = 0
                }
            }
            out.push(px[0])
            out.push(px[1])
            out.push(px[2])
            out.push(px[3])
        }
    }
    return Image { w, h, form: Kind.Rgba, pixels: out }
}
