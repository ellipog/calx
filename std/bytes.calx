    }
    unsafe {
        let p = b.as_ptr().add(at)
        return (u32(p.read()) << 24) | (u32(p.add(1).read()) << 16) | (u32(p.add(2).read()) << 8) | u32(p.add(3).read())
    }
}

/// Adds `v`'s 4 bytes at the end of `out`, big-endian.
pub fn put_u32_be(out: mut List<u8>, v: u32) {
