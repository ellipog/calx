        p.add(1).write(u8.wrap(x >> 16))
        p.add(2).write(u8.wrap(x >> 8))
        p.add(3).write(u8.wrap(x))
        out.set_len(start + 4)
    }
}

/// Writes `v`'s 4 bytes over those from index `at`, big-endian. It panics past the end.
@track_caller
