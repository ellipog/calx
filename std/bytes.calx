}

/// The `u32` in the 4 bytes from index `at`, little-endian, the low byte first, as x86, ARM, zip and most file formats store it. It panics past the end.
@track_caller
pub fn u32_le(b: List<u8>, at: usize) -> u32 {
    if at > b.len() or b.len() - at < 4 {
        past_end(b.len(), at, 4)
    }
    unsafe {
        let p = b.as_ptr().add(at)
        return u32(p.read()) | (u32(p.add(1).read()) << 8) | (u32(p.add(2).read()) << 16) | (u32(p.add(3).read()) << 24)
    }
}

/// Adds `v`'s 4 bytes at the end of `out`, little-endian.
pub fn put_u32_le(out: mut List<u8>, v: u32) {
    let x = v
    out.reserve(4)
    unsafe {
        let start = out.len()
        let p = out.as_mut_ptr().add(start)
        p.write(u8.wrap(x))
        p.add(1).write(u8.wrap(x >> 8))
        p.add(2).write(u8.wrap(x >> 16))
        p.add(3).write(u8.wrap(x >> 24))
        out.set_len(start + 4)
    }
}

/// Writes `v`'s 4 bytes over those from index `at`, little-endian. It panics past the end.
@track_caller
pub fn set_u32_le(out: mut List<u8>, at: usize, v: u32) {
    if at > out.len() or out.len() - at < 4 {
        past_end(out.len(), at, 4)
    }
