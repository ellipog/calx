    unsafe {
        let p = out.as_mut_ptr().add(at)
        p.write(u8.wrap(x))
        p.add(1).write(u8.wrap(x >> 8))
        p.add(2).write(u8.wrap(x >> 16))
        p.add(3).write(u8.wrap(x >> 24))
    }
}

