        let p = b.as_ptr().add(at)
        return (u64(p.read()) << 56) | (u64(p.add(1).read()) << 48) | (u64(p.add(2).read()) << 40) | (u64(p.add(3).read()) << 32) | (u64(p.add(4).read()) << 24) | (u64(p.add(5).read()) << 16) | (u64(p.add(6).read()) << 8) | u64(p.add(7).read())
    }
}

/// Adds `v`'s 8 bytes at the end of `out`, big-endian.
pub fn put_u64_be(out: mut List<u8>, v: u64) {
    let x = v
    out.reserve(8)
    unsafe {
        let start = out.len()
        let p = out.as_mut_ptr().add(start)
        p.write(u8.wrap(x >> 56))
        p.add(1).write(u8.wrap(x >> 48))
        p.add(2).write(u8.wrap(x >> 40))
        p.add(3).write(u8.wrap(x >> 32))
        p.add(4).write(u8.wrap(x >> 24))
        p.add(5).write(u8.wrap(x >> 16))
        p.add(6).write(u8.wrap(x >> 8))
        p.add(7).write(u8.wrap(x))
        out.set_len(start + 8)
    }
}

