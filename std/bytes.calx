/// The `u64` in the 8 bytes from index `at`, little-endian, the low byte first, as x86, ARM, zip and most file formats store it. It panics past the end.
@track_caller
pub fn u64_le(b: List<u8>, at: usize) -> u64 {
    if at > b.len() or b.len() - at < 8 {
        past_end(b.len(), at, 8)
    }
    unsafe {
        let p = b.as_ptr().add(at)
        return u64(p.read()) | (u64(p.add(1).read()) << 8) | (u64(p.add(2).read()) << 16) | (u64(p.add(3).read()) << 24) | (u64(p.add(4).read()) << 32) | (u64(p.add(5).read()) << 40) | (u64(p.add(6).read()) << 48) | (u64(p.add(7).read()) << 56)
    }
}

/// Adds `v`'s 8 bytes at the end of `out`, little-endian.
pub fn put_u64_le(out: mut List<u8>, v: u64) {
    let x = v
    out.reserve(8)
    unsafe {
        let start = out.len()
        let p = out.as_mut_ptr().add(start)
        p.write(u8.wrap(x))
        p.add(1).write(u8.wrap(x >> 8))
        p.add(2).write(u8.wrap(x >> 16))
        p.add(3).write(u8.wrap(x >> 24))
        p.add(4).write(u8.wrap(x >> 32))
        p.add(5).write(u8.wrap(x >> 40))
        p.add(6).write(u8.wrap(x >> 48))
        p.add(7).write(u8.wrap(x >> 56))
        out.set_len(start + 8)
    }
}

/// Writes `v`'s 8 bytes over those from index `at`, little-endian. It panics past the end.
@track_caller
pub fn set_u64_le(out: mut List<u8>, at: usize, v: u64) {
    if at > out.len() or out.len() - at < 8 {
        past_end(out.len(), at, 8)
    }
    let x = v
    unsafe {
        let p = out.as_mut_ptr().add(at)
        p.write(u8.wrap(x))
        p.add(1).write(u8.wrap(x >> 8))
        p.add(2).write(u8.wrap(x >> 16))
        p.add(3).write(u8.wrap(x >> 24))
        p.add(4).write(u8.wrap(x >> 32))
        p.add(5).write(u8.wrap(x >> 40))
        p.add(6).write(u8.wrap(x >> 48))
        p.add(7).write(u8.wrap(x >> 56))
    }
}

