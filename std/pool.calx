/// The pool of threads `parallel for` runs on, and pools of a program's own.
///
/// A `parallel for` gives the same result with one thread and with many (D21), so the number
/// of threads changes only how fast a program runs. By default it's the number of logical
/// processors the program may run on.
module std.pool

extern "C" fn cx_set_workers(n: usize)
extern "C" fn cx_workers() -> usize
extern "C" fn cx_pool_new(threads: usize) -> u64
extern "C" fn cx_pool_close(pool: u64)

/// Sets how many threads run each `parallel for`, counting the thread that reaches it. With 1,
/// every `parallel for` runs on that thread alone. Panics if `n` is 0, or if called inside a
/// `parallel for`.
pub fn set_workers(n: usize) {
    if n == 0 {
        panic("a `parallel for` needs at least one thread")
    }
    unsafe { cx_set_workers(n) }
}

/// How many threads each `parallel for` runs on, counting the thread that reaches it: the
/// number of logical processors, unless `set_workers` changed it. It differs from machine to
/// machine, so reading it takes `unsafe`, as reading the clock does: what a program does with it
/// can't be the same everywhere.
pub unsafe fn workers() -> usize {
    return unsafe { cx_workers() }
}

/// A pool of threads of the program's own, which `parallel(pool) for` runs on instead of the
/// main pool (CLX-71): for loops on a thread `Thread.spawn` started, whose loops otherwise run on
/// it alone, or for work that mustn't take the main pool's threads, such as a world generator's
/// beside a server's ticks. It's a handle: there's one set of threads, and one thing to close
/// them. It's `Send`, so it goes to the thread that runs loops on it, and one thread at a time
/// runs a loop on it; another waits.
@handle
pub struct Pool {
    // The runtime's pool, as a number, which the compiler hands to `parallel(pool) for`.
    handle: u64
    count: usize
}

impl Pool {
    /// A pool whose loops run on `threads` threads, counting the thread that runs the loop, so
    /// it starts `threads - 1` of its own, with its first loop. With 1, its loops run on the
    /// thread that runs them alone. Panics if `threads` is 0.
    pub fn new(threads: usize) -> Pool {
        if threads == 0 {
            panic("a pool needs at least one thread")
        }
        return Pool { handle: unsafe { cx_pool_new(threads) }, count: threads }
    }

    /// How many threads its loops run on, counting the thread that runs each one.
    pub fn threads(self) -> usize {
        return self.count
    }

    /// Stops its threads, once no loop runs on it, and frees it. A pool that's never closed
    /// keeps its threads, asleep, until the program ends.
    pub fn close(own self) {
        unsafe { cx_pool_close(self.handle) }
    }
}
