// Times Calx against C, Rust, Go and Python on the same programs: the Benchmarks Game's classic
// compute, programs shaped like real work, parallel loops, and what building and starting cost.
//
//     calx run --release bench/suite.calx -- [--rounds 5] [--only nbody,json] [--groups compute]
//         [--langs calx,c] [--threads 1,4,8,all] [--quick] [--record] [--keep]
//
// Each benchmark is a folder in bench/suite with one program per language, `<name>.calx`, `.c`,
// `.rs`, `.go` and `.py`, which do the same work with the same algorithm. A program prints what its
// work came to, and every language's output must be the same, byte for byte once `\r\n` is read as
// `\n`, or that language's result is dropped and the run says so. bench/README.md lists them.
//
// Each program runs once to warm up and to check its output, then `--rounds` times, the languages
// taking turns, in the other order every other round. A program that took more than 10 s to warm
// up runs 3 rounds. Each run is timed from outside, as a fresh process, as GNU `time` times it: its
// wall time from just before it starts until it exits, the CPU time of all its threads, and the
// most memory it held (peak working set on Windows, peak resident set on Linux), from std.process's
// `Usage`. Each starts `measured`, so on Linux its peak is its own, not at least the runner's
// (CLX-295). The tables give the median wall time and the median peak memory; the record has
// every run.
//
// The machine is shared, so each run also measures how busy the rest of the machine was while it
// ran: the CPU time every other program used, as a share of all the processors. A run where that
// was over 10% is run again, up to twice, and the least disturbed one kept; the record says how
// busy each run's machine was. Under WSL only Linux's own processes can be seen.
//
// The runner pins itself, and so the programs it starts, to the performance cores of a processor
// with two kinds (the i9-13900K's processors 2, 4 to 14, one thread on each of 7 cores), and on
// Windows takes itself out of power throttling, with std.process's `set_affinity` and
// `set_full_speed` (CLX-291). On Linux that pins the thread that starts them, which they take
// with them. Parallel benchmarks run at each of `--threads`, pinned to as many performance cores,
// and at `all` on every processor.
//
// Builds: Calx with `calx build --release`; C with clang at Calx's release flags, `-O3
// -march=x86-64-v3 -ffp-contract=off -fno-math-errno -flto=thin`; Rust with Cargo's release
// profile in bench/suite/rust (opt-level 3, thin LTO, one codegen unit, panic=abort) and
// `-C target-cpu=x86-64-v3`; Go with `go build`, GOAMD64=v3 and cgo off; Python 3 as it is.
//
// What it builds and the inputs it writes go in a folder of its own in the temp folder, removed at
// the end unless --keep. --record writes bench/results/suite-<os>.json with the machine, the
// toolchains and the commit; with --only or --groups, the benchmarks left out keep their results.
import dx.{MODULES, c_flags, edit_big, write_big, write_hello, write_ninja}
import inputs.{make_input}
import machine.{commit, compiler, exe, machine, now_utc, output_of, repo_root, round_to}
import std.bytes
import std.cli.{cli}
import std.env
import std.fs
import std.hash.{sha256}
import std.json.{Json, parse, pretty}
import std.process
import std.process.{Command}
import std.stats
import std.thread
import std.time.{Instant}

/// Times Calx against C, Rust, Go and Python on the same programs.
@cli(name: "bench/suite.calx")
struct Args {
    /// Timed runs of each program, after one to warm up.
    rounds: u32 = 5
    /// The benchmarks, with commas between. All of them if empty.
    only: String = ""
    /// The groups, with commas between: compute, realistic, parallel, dx. All of them if empty.
    groups: String = ""
    /// The languages, with commas between: calx, c, rust, go, python. All of them if empty.
    langs: String = ""
    /// The parallel benchmarks' thread counts, with commas between; `all` is every processor.
    threads: String = "1,4,8,all"
    /// Small inputs and one round, to check that every program builds and agrees, as CI does.
    quick: bool
    /// Write bench/results/suite-<os>.json.
    record: bool
    /// Keep the folder with the builds and inputs, and say where it is.
    keep: bool
    /// Print the tables docs/language-benchmarks.md gives, from bench/results, and run nothing.
    tables: bool
}

const LANGS: [str; 5] = ["calx", "c", "rust", "go", "python"]

// A run whose machine was busier than this, other programs' CPU time over all the processors', is
// run again.
const BUSY: f64 = 0.10

fn lang_name(l: String) -> String {
    return if l == "calx" {
        String("Calx")
    } else if l == "c" {
        String("C")
    } else if l == "rust" {
        String("Rust")
    } else if l == "go" {
        String("Go")
    } else {
        String("Python")
    }
}

fn ext(l: String) -> String {
    return if l == "python" { String("py") } else if l == "rust" { String("rs") } else { l.copy() }
}

fn stop(why: String) -> never {
    eprintln("suite: {why}")
    process.exit(1)
}

// One benchmark: its folder in bench/suite, its group, its title, and its arguments at full size
// and with --quick. An argument `@kind` is the path of a generated input (inputs.calx), and
// `@threads` the thread count of a parallel benchmark.
struct Bench {
    name: String
    group: String
    title: String
    args: List<String>
    quick: List<String>
    // Extra flags for clang, such as -fopenmp.
    cflags: List<String>
}

fn bench(name: str, group: str, title: str, args: own List<String>, quick: own List<String>) -> Bench {
    return Bench { name: String(name), group: String(group), title: String(title), args: args, quick: quick, cflags: [] }
}

fn benches() -> List<Bench> {
    var b: List<Bench> = []
    b.push(bench("nbody", "compute", "n-body, 10 million steps", ["10000000"], ["1000"]))
    b.push(bench("spectralnorm", "compute", "spectral-norm, n = 3,000", ["3000"], ["100"]))
    b.push(bench("fannkuch", "compute", "fannkuch-redux, n = 11", ["11"], ["7"]))
    b.push(bench("binarytrees", "compute", "binary-trees, depth 18", ["18"], ["10"]))
    b.push(bench("mandelbrot", "compute", "mandelbrot, 4,000 by 4,000", ["4000"], ["200"]))
    b.push(bench("fasta", "compute", "fasta, n = 2.5 million", ["2500000"], ["1000"]))
    b.push(bench("knucleotide", "compute", "k-nucleotide, fasta n = 1 million", ["@fasta"], ["@fasta"]))
    b.push(bench("revcomp", "compute", "reverse-complement, fasta n = 1 million", ["@fasta"], ["@fasta"]))
    b.push(bench("regexredux", "compute", "regex-redux, fasta n = 1 million", ["@fasta"], ["@fasta"]))
    b.push(bench("pidigits", "compute", "pidigits, 10,000 digits", ["10000"], ["30"]))
    b.push(bench("json", "realistic", "JSON: 200,000 records parsed, written, read typed", ["@json"], ["@json"]))
    b.push(bench("csv", "realistic", "CSV report: a million rows summed by group", ["@csv"], ["@csv"]))
    b.push(bench("logs", "realistic", "Log analysis: a million access-log lines", ["@log"], ["@log"]))
    b.push(bench("wordcount", "realistic", "Word count: 5 million words", ["@words"], ["@words"]))
    b.push(bench("sort", "realistic", "Sorting: 5M integers, 5M doubles, 1M strings", ["@numbers"], ["@numbers"]))
    b.push(bench("hashmap", "realistic", "Hash maps: 2M integer keys, 500,000 strings", ["@numbers", "2000000"], ["@numbers", "5000"]))
    b.push(bench("objects", "realistic", "Many small objects: 4M records", ["20", "200000"], ["2", "1000"]))
    b.push(bench("text", "realistic", "Building and splitting text: a million lines", ["1000000"], ["1000"]))
    b.push(bench("files", "realistic", "Files: 2,000 written, read and removed", ["@scratch", "2000"], ["@scratch", "50"]))
    b.push(bench("compress", "realistic", "Compression: gzip, zstd and xz round trips", ["@corpus"], ["@corpus"]))
    b.push(bench("hash", "realistic", "Hashing: SHA-256 and CRC-32 of 270 MB", ["@corpus"], ["@corpus"]))
    b.push(bench("png", "realistic", "PNG: a 2,048 by 2,048 image encoded and decoded", ["@rgb", "2048", "2048"], ["@rgb", "256", "256"]))
    // The parallel ones build C with OpenMP.
    var par: List<Bench> = []
    par.push(bench("parmandel", "parallel", "mandelbrot, 6,000 by 6,000", ["6000", "@threads"], ["200", "@threads"]))
    par.push(bench("parspectral", "parallel", "spectral-norm, n = 5,500", ["5500", "@threads"], ["100", "@threads"]))
    par.push(bench("parsum", "parallel", "π as a float sum, 2 billion terms", ["2000000000", "@threads"], ["100000", "@threads"]))
    for p in mut par {
        p.cflags = ["-fopenmp"]
    }
    for p in par {
        b.push(p.copy())
    }
    return b
}

// Where the programs run: the processors they're pinned to.
struct Pin {
    cpus: List<u32>
    threads: u32
}

// The processors a run of `threads` threads gets. A single-threaded program, or a parallel one at
// up to 7 threads, gets the performance cores but the first, one thread on each; 8 threads get all
// 8; more get every processor.
fn pin_for(threads: u32, processors: u32) -> Pin {
    if threads <= 7 {
        return Pin { cpus: [2, 4, 6, 8, 10, 12, 14], threads: threads }
    }
    if threads == 8 {
        return Pin { cpus: [0, 2, 4, 6, 8, 10, 12, 14], threads: threads }
    }
    var all: List<u32> = []
    for k in 0u32..processors {
        all.push(k)
    }
    return Pin { cpus: all, threads: threads }
}

// Pins this program, and so what it starts, out of power throttling on Windows.
fn apply_pin(p: Pin) {
    match process.set_affinity(p.cpus.copy()) {
        ok => {},
        err(e) => stop("{e}"),
    }
    process.set_full_speed()
}

// The machine's CPU time, busy and in all, in nanoseconds, summed over its processors.
fn cpu_times() -> (u64, u64) {
    let t = unsafe { process.machine_cpu() }
    return (t.busy_ns, t.busy_ns + t.idle_ns)
}

// One run of a program.
struct Run {
    wall: f64
    cpu: f64
    peak: f64
    load: f64
    out: String
}

// Runs a command, stopping on nothing: an error comes back as the text of what went wrong. Each
// program starts `measured`, so on Linux its peak memory is its own rather than at least this
// program's, which holds the inputs and outputs, and its wall time, CPU time and peak are what the
// system says of it: from just before it starts until it exits, as GNU `time` gives them.
fn run_once(cmd: List<String>, dir: String, envs: List<(String, String)>) -> Run ! String {
    var rest: List<String> = []
    for k in 1usize..cmd.len() {
        rest.push(cmd[k].copy())
    }
    var c = Command.new(cmd[0].copy()).args(rest).dir(dir).timeout(1800000).measured()
    for (k, v) in envs {
        c = c.env(k.copy(), v.copy())
    }
    let before = cpu_times()
    let out = match c.output() {
        ok(o) => o,
        err(e) => fail "can't run {cmd[0]}: {e}",
    }
    let after = cpu_times()
    if not out.status.success() {
        let why = out.error_text().trim()
        fail "{cmd.join(" ")} {out.status}: {why[..why.len().min(2000usize)]}"
    }
    let u = unsafe { out.status.usage() }
    let busy = f64.nearest(after.0 - before.0) - f64.nearest(u.cpu_ns)
    let total = f64.nearest(after.1 - before.1)
    let load = if total > 0.0 { (busy / total).max(0.0) } else { 0.0 }
    return Run { wall: f64.nearest(u.wall_ns) / 1e6, cpu: f64.nearest(u.cpu_ns) / 1e6, peak: f64.nearest(u.peak_memory) / 1048576.0, load: load, out: out.text().replace("\r\n", "\n") }
}

// Runs it until the machine was quiet enough, at most three times, and keeps the quietest run.
fn run_quiet(cmd: List<String>, dir: String, envs: List<(String, String)>) -> (Run, u32) ! String {
    var best = try run_once(cmd.copy(), dir.copy(), envs.copy())
    var again: u32 = 0
    while best.load > BUSY and again < 2 {
        again += 1
        let r = try run_once(cmd.copy(), dir.copy(), envs.copy())
        if r.load < best.load {
            best = r
        }
    }
    return (best, again)
}

// A language's program for one benchmark: how to run it, and what its runs gave.
struct Prog {
    lang: String
    cmd: List<String>
    envs: List<(String, String)>
    // "ok", or why it has no results: "no program", "didn't build", "failed", "output differs".
    status: String
    why: String
    out: String
    runs: List<Run>
    again: u32
    rounds: u32
    // Whether its `info` lines changed from one run to the next, as a parallel float sum's can.
    varied: bool
}

fn median(v: List<f64>) -> f64 {
    return stats.median(v) ?? 0.0
}

fn best_of(v: List<f64>) -> f64 {
    return v.min() ?? 0.0
}

fn walls(p: Prog) -> List<f64> {
    return p.runs.map(|r| r.wall)
}

fn peaks(p: Prog) -> List<f64> {
    return p.runs.map(|r| r.peak)
}

fn cpus(p: Prog) -> List<f64> {
    return p.runs.map(|r| r.cpu)
}

fn digest(text: String) -> String {
    return bytes.hex(sha256(text.to_bytes()))
}

// The output most of the programs gave, which the others must match; ties go to the language
// first in LANGS. Lines that start with `info ` are left out: what may rightly differ between
// languages, such as a compressor's output size or a parallel sum's exact bits. The record keeps
// them, and says when a program's changed from one run to the next, as a parallel sum's can.
fn checked_part(out: String) -> String {
    var s = String()
    for line in out.lines() {
        if not line.starts_with("info ") {
            s.push_str(line)
            s.push('\n')
        }
    }
    return s
}

fn agree(progs: mut List<Prog>, title: String) {
    var counts = LinkedMap<String, u32>()
    for p in progs {
        if p.status == "ok" {
            let k = checked_part(p.out.copy())
            counts.insert(k.copy(), (counts.get(k) ?? 0) + 1)
        }
    }
    var want = String()
    var most: u32 = 0
    for (k, n) in counts {
        if n > most {
            most = n
            want = k.copy()
        }
    }
    for p in mut progs {
        if p.status == "ok" and checked_part(p.out.copy()) != want {
            p.status = String("output differs")
            let got = p.out.trim()
            p.why = "printed {got[..got.len().min(300usize)]}"
            eprintln("suite: {title}: {lang_name(p.lang.copy())}'s output differs from the others', so it's left out")
            eprintln("  it printed: {got[..got.len().min(300usize)]}")
            let w = want.trim()
            eprintln("  the others: {w[..w.len().min(300usize)]}")
        }
    }
}

// Warms each program up and checks it, then times them in turns.
fn measure(progs: mut List<Prog>, dir: String, rounds: u32, title: String) {
    for p in mut progs {
        if p.status != "ok" {
            continue
        }
        match run_once(p.cmd.copy(), dir.copy(), p.envs.copy()) {
            ok(r) => {
                p.out = r.out.copy()
                p.rounds = if r.wall > 10000.0 { rounds.min(3) } else { rounds }
            }
            err(e) => {
                p.status = String("failed")
                p.why = e.copy()
                eprintln("suite: {title}: {lang_name(p.lang.copy())} failed: {e}")
            }
        }
    }
    agree(mut progs, title.copy())
    for r in 0u32..rounds {
        var order: List<usize> = []
        for k in 0usize..progs.len() {
            order.push(if r % 2 == 0 { k } else { progs.len() - 1 - k })
        }
        for k in order {
            if progs[k].status != "ok" or r >= progs[k].rounds {
                continue
            }
            match run_quiet(progs[k].cmd.copy(), dir.copy(), progs[k].envs.copy()) {
                ok(got) => {
                    if checked_part(got.0.out.copy()) != checked_part(progs[k].out.copy()) {
                        progs[k].status = String("output differs")
                        progs[k].why = String("its output changed from one run to the next")
                        eprintln("suite: {title}: {lang_name(progs[k].lang.copy())}'s output changed between runs, so it's left out")
                    } else {
                        if got.0.out != progs[k].out and not progs[k].varied {
                            progs[k].varied = true
                            eprintln("suite: {title}: {lang_name(progs[k].lang.copy())}'s info lines changed between runs, as the record says")
                        }
                        progs[k].runs.push(got.0)
                        progs[k].again += got.1
                    }
                }
                err(e) => {
                    progs[k].status = String("failed")
                    progs[k].why = e.copy()
                    eprintln("suite: {title}: {lang_name(progs[k].lang.copy())} failed: {e}")
                }
            }
        }
    }
}

// Milliseconds, with fewer decimals the bigger they are.
fn ms(v: f64) -> String {
    if v < 10.0 {
        return "{v:.2} ms"
    }
    if v < 100.0 {
        return "{v:.1} ms"
    }
    return "{v:,.0} ms"
}

fn mb(v: f64) -> String {
    return if v < 10.0 { "{v:.1} MB" } else { "{v:,.0} MB" }
}

// A program's record: its status, every run, and the medians.
fn prog_json(p: Prog) -> Json {
    var m = LinkedMap<String, Json>()
    m.insert("status", Json.Str(p.status.copy()))
    if p.status != "ok" {
        if not p.why.is_empty() {
            m.insert("why", Json.Str(p.why.copy()))
        }
        return Json.Object(m)
    }
    m.insert("median_ms", Json.Float(round_to(median(walls(p)), 3)))
    m.insert("best_ms", Json.Float(round_to(best_of(walls(p)), 3)))
    m.insert("cpu_ms", Json.Float(round_to(median(cpus(p)), 1)))
    m.insert("peak_mb", Json.Float(round_to(median(peaks(p)), 2)))
    m.insert("wall_ms", Json.Array(p.runs.map(|r| Json.Float(round_to(r.wall, 3)))))
    m.insert("cpu_ms_runs", Json.Array(p.runs.map(|r| Json.Float(round_to(r.cpu, 1)))))
    m.insert("peak_mb_runs", Json.Array(p.runs.map(|r| Json.Float(round_to(r.peak, 2)))))
    m.insert("machine_busy", Json.Array(p.runs.map(|r| Json.Float(round_to(r.load, 3)))))
    m.insert("runs_repeated", Json.Int(i64(p.again)))
    if p.varied {
        m.insert("info_changed_between_runs", Json.Bool(true))
    }
    m.insert("output_sha256", Json.Str(digest(p.out.copy())))
    var info: List<Json> = []
    for line in p.out.lines() {
        if line.starts_with("info ") {
            info.push(Json.Str(line["info ".len()..]))
        }
    }
    if not info.is_empty() {
        m.insert("info", Json.Array(info))
    }
    return Json.Object(m)
}

// What a build left: the programs that built, by language, and why the others didn't.
struct Built {
    paths: LinkedMap<String, String>
    failed: LinkedMap<String, String>
}

fn exists_source(root: String, b: Bench, lang: String) -> bool {
    return fs.is_file("{root}/bench/suite/{b.name}/{b.name}.{ext(lang)}")
}

fn build_all(root: String, work: String, calx: String, list: List<Bench>, langs: List<String>) -> Built {
    var built = Built { paths: LinkedMap<String, String>(), failed: LinkedMap<String, String>() }
    let bin = "{work}/bin"
    fs.make_dir_all(bin.copy())!
    let suite = "{root}/bench/suite"
    var any_rust = false
    for b in list {
        for l in langs {
            if not exists_source(root.copy(), b.copy(), l.copy()) {
                continue
            }
            let key = "{b.name}/{l}"
            let src = "{suite}/{b.name}/{b.name}.{ext(l.copy())}"
            let out = "{bin}/{b.name}-{l}{exe()}"
            var cmd: List<String> = []
            var envs: List<(String, String)> = []
            var dir = root.copy()
            if l == "calx" {
                cmd = [calx.copy(), "build", "--release", src.copy(), "-o", out.copy()]
            } else if l == "c" {
                cmd = ["clang", "-O3", "-march=x86-64-v3", "-ffp-contract=off", "-fno-math-errno", "-flto=thin", "-fuse-ld=lld"]
                for f in b.cflags {
                    cmd.push(f.copy())
                }
                cmd.push("-o")
                cmd.push(out.copy())
                cmd.push(src.copy())
                if env.os() != "windows" {
                    cmd.push("-lm")
                }
            } else if l == "go" {
                cmd = ["go", "build", "-o", out.copy(), "./{b.name}/{b.name}.go"]
                dir = suite.copy()
                envs = [(String("GOAMD64"), String("v3")), (String("CGO_ENABLED"), String("0"))]
            } else if l == "rust" {
                any_rust = true
                continue
            } else {
                built.paths.insert(key.copy(), src.copy())
                continue
            }
            println("  building {b.name} in {lang_name(l.copy())}")
            var rest: List<String> = []
            for k in 1usize..cmd.len() {
                rest.push(cmd[k].copy())
            }
            var c = Command.new(cmd[0].copy()).args(rest).dir(dir)
            for (k, v) in envs {
                c = c.env(k.copy(), v.copy())
            }
            match c.output() {
                ok(o) => {
                    if o.status.success() {
                        built.paths.insert(key.copy(), out.copy())
                    } else {
                        let why = "{o.text()}{o.error_text()}".trim()
                        built.failed.insert(key.copy(), why[..why.len().min(2000usize)])
                        eprintln("suite: {b.name} didn't build in {lang_name(l.copy())}:\n{why}")
                    }
                }
                err(e) => {
                    built.failed.insert(key.copy(), "{e}")
                    eprintln("suite: can't build {b.name} in {lang_name(l.copy())}: {e}")
                }
            }
        }
    }
    if any_rust {
        println("  building the Rust programs")
        let target = "{work}/cargo"
        var why = String()
        match Command.new("cargo").args(["build", "--release", "--quiet", "--manifest-path", "{suite}/rust/Cargo.toml"]).env("CARGO_TARGET_DIR", target.copy()).env("RUSTFLAGS", "-C target-cpu=x86-64-v3").output() {
            ok(out) => {
                if not out.status.success() {
                    why = "{out.error_text()}".trim()
                }
            }
            err(e) => {
                why = "{e}"
            }
        }
        if not why.is_empty() {
            eprintln("suite: the Rust programs didn't build:\n{why}")
        }
        for b in list {
            if not exists_source(root.copy(), b.copy(), String("rust")) {
                continue
            }
            let path = "{target}/release/{b.name}{exe()}"
            if fs.is_file(path.copy()) and why.is_empty() {
                built.paths.insert("{b.name}/rust", path)
            } else {
                built.failed.insert("{b.name}/rust", if why.is_empty() { String("no binary; is it a [[bin]] in bench/suite/rust/Cargo.toml?") } else { why[..why.len().min(2000usize)] })
            }
        }
    }
    return built
}

// The command that runs a language's program with these arguments.
fn command(lang: String, path: String, python: String, args: List<String>) -> List<String> {
    var cmd: List<String> = []
    if lang == "python" {
        cmd = [python.copy(), "-I", path.copy()]
    } else {
        cmd = [path.copy()]
    }
    for a in args {
        cmd.push(a.copy())
    }
    return cmd
}

// The benchmark's arguments, with each `@kind` the path of its input and `@threads` the count.
fn resolve(args: List<String>, inputs: mut LinkedMap<String, String>, work: String, quick: bool, threads: String) -> List<String> {
    var out: List<String> = []
    for a in args {
        if a == "@threads" {
            out.push(threads.copy())
        } else if a.starts_with("@") {
            let kind = a[1..]
            if not inputs.contains(kind.copy()) {
                println("  making the input {kind}")
                let p = make_input(kind.copy(), "{work}/inputs", quick)
                inputs.insert(kind.copy(), p)
            }
            out.push(inputs[kind].copy())
        } else {
            out.push(a.copy())
        }
    }
    return out
}

fn new_prog(lang: own String, cmd: own List<String>, envs: own List<(String, String)>) -> Prog {
    return Prog { lang: lang, cmd: cmd, envs: envs, status: String("ok"), why: String(), out: String(), runs: [], again: 0, rounds: 0, varied: false }
}

// The programs for one benchmark, at one thread count for a parallel one.
fn progs_for(b: Bench, langs: List<String>, built: Built, python: String, args: List<String>, threads: u32) -> List<Prog> {
    var progs: List<Prog> = []
    for l in langs {
        let key = "{b.name}/{l}"
        var envs: List<(String, String)> = []
        if b.group == "parallel" and l == "c" {
            envs.push((String("OMP_NUM_THREADS"), "{threads}"))
        }
        if let path = built.paths.find(key.copy()) {
            progs.push(new_prog(l.copy(), command(l.copy(), path.copy(), python.copy(), args.copy()), envs))
        } else if let why = built.failed.find(key.copy()) {
            var p = new_prog(l.copy(), [], [])
            p.status = String("didn't build")
            p.why = why.copy()
            progs.push(p)
        } else {
            var p = new_prog(l.copy(), [], [])
            p.status = String("no program")
            p.why = why_none(b.name.copy(), l.copy())
            progs.push(p)
        }
    }
    return progs
}

// Why a language has no program for a benchmark, for the record.
fn why_none(name: String, lang: String) -> String {
    if lang == "c" {
        if name == "regexredux" {
            return String("C's standard library has no regular expressions, and Windows has no POSIX regex.h")
        }
        if name == "pidigits" {
            return String("C's standard library has no big integers")
        }
        if name == "json" {
            return String("C's standard library has no JSON")
        }
        if name == "compress" or name == "hash" {
            return String("C's standard library has no compression or hashes")
        }
        if name == "png" {
            return String("C's standard library has no image formats")
        }
    }
    if lang == "python" and name == "png" {
        return String("Python's standard library has no image formats; Pillow, the usual choice, isn't part of Python")
    }
    if lang == "python" and name.starts_with("par") {
        return String("CPython's threads take turns under its lock (the GIL), so a parallel loop runs on one core")
    }
    return String("no program in this language")
}

// The table of one group, its median wall times and peak memory, the fastest in bold.
fn table(title: String, rows: List<(String, List<Prog>)>, langs: List<String>) {
    println("")
    println("{title}, the median wall time and the most memory held")
    println("")
    var head = String("| Benchmark |")
    var line = String("| --- |")
    for l in langs {
        head.push_str(" {lang_name(l.copy())} |")
        line.push_str(" --- |")
    }
    println(head)
    println(line)
    for (name, progs) in rows {
        var fastest = 1e300
        for p in progs {
            if p.status == "ok" and not p.runs.is_empty() {
                fastest = fastest.min(median(walls(p)))
            }
        }
        var row = "| {name} |"
        for l in langs {
            var cell = String(" — |")
            for p in progs {
                if p.lang == l {
                    if p.status == "ok" and not p.runs.is_empty() {
                        let t = median(walls(p))
                        let tm = ms(t)
                        let shown = if t == fastest { "**{tm}**" } else { tm }
                        cell = " {shown}, {mb(median(peaks(p)))} |"
                    } else {
                        cell = " {p.status} |"
                    }
                }
            }
            row.push_str(cell)
        }
        println(row)
    }
}

// Python's own program, not the `py` launcher, which would be what's measured on Windows.
fn find_python() -> String {
    if env.os() == "windows" {
        if let p = output_of(Command.new("py").args(["-c", "import sys; print(sys.executable)"])) {
            return p.replace("\\", "/")
        }
        return String("python")
    }
    return String("python3")
}

fn first_line(text: String?) -> Json {
    return match text {
        some(t) => Json.Str((t.split_once("\n") ?? (t.copy(), String())).0.trim()),
        none => Json.Null,
    }
}

fn toolchains(calx: String, python: String) -> Json {
    var tc = LinkedMap<String, Json>()
    tc.insert("calx", Json.Str(output_of(Command.new(calx.copy()).arg("version")) ?? String()))
    tc.insert("clang", first_line(output_of(Command.new("clang").arg("--version"))))
    tc.insert("rustc", Json.Str(output_of(Command.new("rustc").arg("--version")) ?? String()))
    var llvm = String()
    for line in (output_of(Command.new("rustc").arg("-vV")) ?? String()).lines() {
        if line.starts_with("LLVM version: ") {
            llvm = line["LLVM version: ".len()..]
        }
    }
    tc.insert("rustc_llvm", Json.Str(llvm))
    tc.insert("go", Json.Str(output_of(Command.new("go").arg("version")) ?? String()))
    tc.insert("python", Json.Str(output_of(Command.new(python).arg("--version")) ?? String()))
    var flags = LinkedMap<String, Json>()
    flags.insert("calx", Json.Str("calx build --release: clang -O3 -march=x86-64-v3 -ffp-contract=off, ThinLTO"))
    flags.insert("c", Json.Str("clang -O3 -march=x86-64-v3 -ffp-contract=off -fno-math-errno -flto=thin -fuse-ld=lld"))
    flags.insert("rust", Json.Str("cargo build --release: opt-level 3, lto thin, codegen-units 1, panic abort; RUSTFLAGS=-C target-cpu=x86-64-v3"))
    flags.insert("go", Json.Str("go build, GOAMD64=v3, CGO_ENABLED=0"))
    flags.insert("python", Json.Str("python -I"))
    tc.insert("flags", Json.Object(flags))
    return Json.Object(tc)
}

// The list a comma-separated option names, or `all` when it's empty, each checked against `all`.
fn chosen(option: String, all: List<String>, what: String) -> List<String> {
    var want: List<String> = []
    for w in option.split(",") {
        let t = w.trim()
        if not t.is_empty() {
            if not all.contains(t.copy()) {
                stop("there's no {what} `{t}`: it's one of {all.join(", ")}")
            }
            want.push(t)
        }
    }
    return if want.is_empty() { all.copy() } else { want }
}

// Removes a folder this run made under `work`, and nothing else.
fn remove_mine(path: String, work: String) {
    if work.len() < 8 or not path.starts_with("{work}/") {
        stop("won't remove {path}: it isn't in {work}")
    }
    if fs.is_dir(path.copy()) {
        fs.remove_dir_all(path)!
    }
}

// Waits, up to 5 s, for a quarter of a second when the rest of the machine used at most BUSY of
// it, and gives how busy the last quarter was. A build starts programs of its own, whose CPU time
// can't be told from other programs' while it runs, so builds look before they start instead.
fn settle() -> f64 {
    var load = 1.0
    for _ in 0..20 {
        let before = cpu_times()
        unsafe { thread.sleep(250000000) }
        let after = cpu_times()
        load = if after.1 > before.1 { f64.nearest(after.0 - before.0) / f64.nearest(after.1 - before.1) } else { 0.0 }
        if load <= BUSY {
            return load
        }
    }
    return load
}

// One timed build: its wall time in ms and how busy the machine was just before, or what went
// wrong.
fn build_once(cmd: List<String>, dir: String, envs: List<(String, String)>) -> (f64, f64) ! String {
    var rest: List<String> = []
    for k in 1usize..cmd.len() {
        rest.push(cmd[k].copy())
    }
    var c = Command.new(cmd[0].copy()).args(rest).dir(dir).timeout(1800000)
    for (k, v) in envs {
        c = c.env(k.copy(), v.copy())
    }
    let load = settle()
    let t0 = unsafe { Instant.now() }
    let out = match c.output() {
        ok(o) => o,
        err(e) => fail "can't run {cmd[0]}: {e}",
    }
    let wall = f64.nearest(unsafe { Instant.now() }.nanos_since(t0)) / 1e6
    if not out.status.success() {
        let why = "{out.text()}{out.error_text()}".trim()
        fail "{cmd.join(" ")} {out.status}: {why[..why.len().min(2000usize)]}"
    }
    return (wall, load)
}

// What one build of the dx group needs: the command, where it runs, its environment, and where
// the program it makes ends up.
struct BuildCmd {
    cmd: List<String>
    dir: String
    envs: List<(String, String)>
    made: String
}

// The build of `lang`'s hello or large program, in debug or release mode, with its caches and
// objects in `cache`, to `out`.
fn build_cmd(lang: String, size: String, mode: String, dir: String, cache: String, out: String, calx: String) -> BuildCmd {
    let release = mode == "release"
    if lang == "calx" {
        var cmd: List<String> = [calx.copy(), "build"]
        if release {
            cmd.push("--release")
        }
        cmd.push(if size == "hello" { "{dir}/hello.calx" } else { "{dir}/main.calx" })
        cmd.push("-o")
        cmd.push(out.copy())
        return BuildCmd { cmd: cmd, dir: dir.copy(), envs: [(String("CALX_CACHE"), cache.copy())], made: out.copy() }
    }
    if lang == "c" {
        if size == "big" {
            let ninja = write_ninja(dir.copy(), cache.copy(), mode.copy(), out.copy())
            return BuildCmd { cmd: ["ninja", "--quiet", "-f", ninja], dir: dir.copy(), envs: [], made: out.copy() }
        }
        var cmd: List<String> = ["clang"]
        for f in c_flags(mode.copy()).split(" ") {
            cmd.push(f.copy())
        }
        cmd.push("-fuse-ld=lld")
        cmd.push("-o")
        cmd.push(out.copy())
        cmd.push("{dir}/hello.c")
        return BuildCmd { cmd: cmd, dir: dir.copy(), envs: [], made: out.copy() }
    }
    if lang == "rust" {
        var cmd: List<String> = ["cargo", "build", "--quiet"]
        if release {
            cmd.push("--release")
        }
        cmd.push("--manifest-path")
        cmd.push("{dir}/Cargo.toml")
        let made = "{cache}/{if release { "release" } else { "debug" }}/{size}{exe()}"
        return BuildCmd { cmd: cmd, dir: dir.copy(), envs: [(String("CARGO_TARGET_DIR"), cache.copy()), (String("RUSTFLAGS"), String("-C target-cpu=x86-64-v3"))], made: made }
    }
    var cmd: List<String> = ["go", "build"]
    if not release {
        cmd.push("-gcflags=all=-N -l")
    }
    cmd.push("-o")
    cmd.push(out.copy())
    cmd.push(".")
    let envs: List<(String, String)> = [(String("GOCACHE"), cache.copy()), (String("GOAMD64"), String("v3")), (String("CGO_ENABLED"), String("0")), (String("GOTOOLCHAIN"), String("local"))]
    return BuildCmd { cmd: cmd, dir: dir.copy(), envs: envs, made: out.copy() }
}

// The dx group's builds: (key, title, size, mode, kind), where kind is how the build starts:
// "scratch" with every cache empty, "edit" after module 0 changed, "unchanged" with nothing
// changed.
fn dx_rows() -> List<(String, String, String, String, String)> {
    var rows: List<(String, String, String, String, String)> = []
    for mode in ["debug", "release"] {
        rows.push(("hello_scratch_{mode}", "hello, from scratch, {mode}", String("hello"), String(mode), String("scratch")))
    }
    for kind in ["scratch", "edit", "unchanged"] {
        for mode in ["debug", "release"] {
            let how = if kind == "scratch" { String("from scratch") } else if kind == "edit" { String("one module edited") } else { String("nothing changed") }
            rows.push(("big_{kind}_{mode}", "{MODULES} modules, {how}, {mode}", String("big"), String(mode), String(kind)))
        }
    }
    return rows
}

// Times building, and starting, small and large programs: the dx group. Gives its record.
fn dx_group(work: String, langs: List<String>, calx: String, python: String, rounds: u32, processors: u32, single: Pin) -> Json {
    let base = "{work}/dx"
    var build_langs: List<String> = []
    for l in langs {
        if l != "python" {
            build_langs.push(l.copy())
        }
    }
    var lines = LinkedMap<String, Json>()
    for l in build_langs {
        _ = write_hello(l.copy(), "{base}/{l}/hello")
        lines.insert(l.copy(), Json.Int(i64.wrap(write_big(l.copy(), "{base}/{l}/big"))))
    }
    let py_hello = write_hello(String("python"), "{base}/python/hello")

    // Builds use every processor, as they would on a developer's machine.
    apply_pin(pin_for(processors, processors))
    var builds = LinkedMap<String, Json>()
    var table_rows: List<(String, LinkedMap<String, List<f64>>)> = []
    var sizes = LinkedMap<String, Json>()
    var made = LinkedMap<String, String>()
    var failed = LinkedMap<String, String>()
    var fresh: u32 = 0
    var tweak: u32 = 0
    for (key, title, size, mode, kind) in dx_rows() {
        println("{title}")
        if kind == "unchanged" {
            // calx records the files a build read only once they're 2 s old, in case one was
            // still being written, so a build right after an edit can't skip yet.
            unsafe { thread.sleep(3000000000) }
        }
        var times = LinkedMap<String, List<f64>>()
        var loads = LinkedMap<String, List<f64>>()
        if kind != "scratch" {
            for l in build_langs {
                let dir = "{base}/{l}/{size}"
                let b = build_cmd(l.copy(), size.copy(), mode.copy(), dir, "{base}/{l}/cache-{mode}", "{base}/{l}/warm-{mode}{exe()}", calx.copy())
                match build_once(b.cmd.copy(), b.dir.copy(), b.envs.copy()) {
                    ok(_) => {}
                    err(e) => {
                        failed.insert("{key}/{l}", e.copy())
                        eprintln("suite: {title}: {lang_name(l.copy())} didn't build: {e}")
                    }
                }
            }
        }
        for r in 0u32..rounds {
            var order: List<String> = []
            for k in 0usize..build_langs.len() {
                order.push(build_langs[if r % 2 == 0 { k } else { build_langs.len() - 1 - k }].copy())
            }
            if kind == "edit" {
                tweak += 1
            }
            for l in order {
                if failed.contains("{key}/{l}") {
                    continue
                }
                let dir = "{base}/{l}/{size}"
                // The cache and the program apart, as without `.exe` they'd have the same name.
                var cache = "{base}/{l}/cache-{mode}"
                var out = "{base}/{l}/warm-{mode}{exe()}"
                if kind == "scratch" {
                    fresh += 1
                    cache = "{base}/{l}/scratch-{fresh}"
                    out = "{base}/{l}/{size}-{mode}{exe()}"
                }
                if kind == "edit" {
                    edit_big(l.copy(), dir.copy(), tweak)
                }
                let b = build_cmd(l.copy(), size.copy(), mode.copy(), dir, cache.copy(), out.copy(), calx.copy())
                match build_once(b.cmd.copy(), b.dir.copy(), b.envs.copy()) {
                    ok(got) => {
                        var t: List<f64> = times.remove(l.copy()) ?? []
                        t.push(got.0)
                        times.insert(l.copy(), t)
                        var ld: List<f64> = loads.remove(l.copy()) ?? []
                        ld.push(got.1)
                        loads.insert(l.copy(), ld)
                        if kind == "scratch" {
                            if b.made != out {
                                fs.copy(b.made.copy(), out.copy())!
                            }
                            made.insert("{size}-{mode}/{l}", out.copy())
                        }
                    }
                    err(e) => {
                        failed.insert("{key}/{l}", e.copy())
                        eprintln("suite: {title}: {lang_name(l.copy())} didn't build: {e}")
                    }
                }
                if kind == "scratch" {
                    remove_mine(cache, work.copy())
                }
            }
        }
        var row = LinkedMap<String, Json>()
        row.insert("title", Json.Str(title.copy()))
        for l in build_langs {
            var m = LinkedMap<String, Json>()
            if let e = failed.find("{key}/{l}") {
                m.insert("status", Json.Str("failed"))
                m.insert("why", Json.Str(e.copy()))
            } else {
                let t: List<f64> = if let v = times.find(l.copy()) { v.copy() } else { [] }
                m.insert("status", Json.Str("ok"))
                m.insert("median_ms", Json.Float(round_to(median(t.copy()), 1)))
                m.insert("best_ms", Json.Float(round_to(best_of(t.copy()), 1)))
                m.insert("wall_ms", Json.Array(t.map(|v| Json.Float(round_to(v, 1)))))
                let ld: List<f64> = if let v = loads.find(l.copy()) { v.copy() } else { [] }
                m.insert("machine_busy", Json.Array(ld.map(|v| Json.Float(round_to(v, 3)))))
                println("  {lang_name(l.copy())}: {ms(median(t.copy()))} median, {ms(best_of(t.copy()))} best")
            }
            row.insert(l.copy(), Json.Object(m))
        }
        builds.insert(key.copy(), Json.Object(row))
        table_rows.push((title.copy(), times))
    }

    // What the release builds made: their sizes, and that the large program prints the same in
    // every language.
    var outputs = LinkedMap<String, String>()
    var size_of = LinkedMap<String, u64>()
    for size in ["hello", "big"] {
        var s = LinkedMap<String, Json>()
        for l in build_langs {
            if let p = made.find("{size}-release/{l}") {
                let size_bytes = fs.metadata(p.copy())!.size
                size_of.insert("{size}/{l}", size_bytes)
                s.insert(l.copy(), Json.Int(i64.wrap(size_bytes)))
                if size == "big" {
                    if let text = output_of(Command.new(p.copy())) {
                        outputs.insert(l.copy(), text.trim())
                    }
                }
            }
        }
        sizes.insert(String(size), Json.Object(s))
    }
    var counts = LinkedMap<String, u32>()
    for (_, o) in outputs {
        counts.insert(o.copy(), (counts.get(o.copy()) ?? 0) + 1)
    }
    var want = String()
    var most: u32 = 0
    for (o, n) in counts {
        if n > most {
            most = n
            want = o.copy()
        }
    }
    var agrees = LinkedMap<String, Json>()
    for (l, o) in outputs {
        agrees.insert(l.copy(), Json.Bool(o == want))
        if o != want {
            eprintln("suite: the {MODULES}-module program printed {o} in {lang_name(l.copy())}, and {want} in the others")
        }
    }

    // Starting: the release hello programs, and Python's, pinned as the single-threaded
    // benchmarks are.
    apply_pin(single.copy())
    var progs: List<Prog> = []
    for l in langs {
        if l == "python" {
            progs.push(new_prog(l.copy(), [python.copy(), "-I", py_hello.copy()], []))
        } else if let p = made.find("hello-release/{l}") {
            progs.push(new_prog(l.copy(), [p.copy()], []))
        }
    }
    println("hello, started and run to the end")
    measure(mut progs, work.copy(), rounds.max(20), String("hello"))
    var startup = LinkedMap<String, Json>()
    for p in progs {
        startup.insert(p.lang.copy(), prog_json(p.copy()))
        if p.status == "ok" and not p.runs.is_empty() {
            println("  {lang_name(p.lang.copy())}: {ms(median(walls(p)))} median, {ms(best_of(walls(p)))} best, {mb(median(peaks(p)))}")
        }
    }

    println("")
    println("Builds, the median wall time")
    println("")
    var head = String("| Build |")
    var line = String("| --- |")
    for l in build_langs {
        head.push_str(" {lang_name(l.copy())} |")
        line.push_str(" --- |")
    }
    println(head)
    println(line)
    for (title, times) in table_rows {
        var row = "| {title} |"
        for l in build_langs {
            if let t = times.find(l.copy()) {
                row.push_str(" {ms(median(t.copy()))} |")
            } else {
                row.push_str(" failed |")
            }
        }
        println(row)
    }
    println("")
    println("Release programs' sizes")
    println("")
    println(head.replace("Build", "Program"))
    println(line)
    for size in ["hello", "big"] {
        var row = "| {if size == "hello" { String("hello") } else { "{MODULES} modules" }} |"
        for l in build_langs {
            if let n = size_of.get("{size}/{l}") {
                row.push_str(" {f64.nearest(n) / 1024.0:,.0} KB |")
            } else {
                row.push_str(" — |")
            }
        }
        println(row)
    }

    var r = LinkedMap<String, Json>()
    r.insert("title", Json.Str("Building and starting programs"))
    r.insert("group", Json.Str("dx"))
    r.insert("modules", Json.Int(i64(MODULES)))
    r.insert("lines", Json.Object(lines))
    r.insert("builds", Json.Object(builds))
    r.insert("sizes_bytes", Json.Object(sizes))
    r.insert("big_output", Json.Str(want))
    r.insert("big_output_agrees", Json.Object(agrees))
    r.insert("startup", Json.Object(startup))
    return Json.Object(r)
}

// The suite's files that differ from the commit checked out, so a record says when what it
// measured isn't exactly that commit's.
fn uncommitted(root: String) -> List<String> {
    let text = output_of(Command.new("git").args(["status", "--porcelain", "--", "bench/suite", "bench/suite.calx", "bench/inputs.calx", "bench/dx.calx", "bench/machine.calx"]).dir(root)) ?? String()
    var files: List<String> = []
    // Each line is a status, then the path; output_of trimmed the first line's leading space.
    for line in text.lines() {
        if let parts = line.trim().split_once(" ") {
            files.push(parts.1.trim())
        }
    }
    return files
}

// --tables: the tables docs/language-benchmarks.md gives, from the records, so the page is written
// from what was measured.

// A language's median wall time and peak memory in a record, if it has them.
fn timing(p: Json?) -> (f64, f64)? {
    if let j = p {
        if (j.get("status") ?? Json.Null) == Json.Str("ok") {
            if let t = (j.get("median_ms") ?? Json.Null).as_f64() {
                return some((t, (j.get("peak_mb") ?? Json.Null).as_f64() ?? 0.0))
            }
        }
    }
    return none
}

// A table row: each cell's time and memory, or a dash, the fastest in bold. Without `memory`,
// only the times.
fn md_row(label: String, cells: List<(f64, f64)?>, memory: bool) -> String {
    var fastest = 1e300
    for c in cells {
        if let v = c {
            fastest = fastest.min(v.0)
        }
    }
    var row = "| {label} |"
    for c in cells {
        if let v = c {
            let t = if v.0 == fastest { "**{ms(v.0)}**" } else { ms(v.0) }
            row.push_str(if memory { " {t}, {mb(v.1)} |" } else { " {t} |" })
        } else {
            row.push_str(" — |")
        }
    }
    return row
}

// Times within this factor of each other are even, as on the site's chart.
const EVEN: f64 = 1.05

// Where a benchmark's times are in its record: its own, or a parallel loop's at the most threads.
fn widest(r: own Json) -> Json {
    let counts = r.get("threads") ?? Json.Null
    var last = Json.Null
    for t in counts.keys() {
        last = counts.get(t.copy()) ?? Json.Null
    }
    return if last.is_null() { r } else { last }
}

fn md_head(first: str, langs: List<String>) {
    var head = "| {first} |"
    var line = String("| --- |")
    for l in langs {
        head.push_str(" {lang_name(l.copy())} |")
        line.push_str(" --- |")
    }
    println(head)
    println(line)
}

fn print_tables(root: String) {
    var all: List<String> = []
    var built: List<String> = []
    for l in LANGS {
        all.push(String(l))
        if l != "python" {
            built.push(String(l))
        }
    }
    for os in ["windows", "linux"] {
        let ok(read) = fs.read_text("{root}/bench/results/suite-{os}.json") else {
            continue
        }
        let text = read else {
            continue
        }
        let ok(doc) = parse(text) else {
            continue
        }
        let results = doc.get("results") ?? Json.Null
        println("<!-- {os}, recorded at {(doc.get("commit") ?? Json.Null).as_str() ?? String()} -->")
        println("")
        for group in ["compute", "realistic"] {
            println("{os}, {group}:")
            println("")
            md_head("Benchmark", all.copy())
            for name in results.keys() {
                let r = results.get(name.copy()) ?? Json.Null
                if (r.get("group") ?? Json.Null) != Json.Str(String(group)) {
                    continue
                }
                let cells = all.map(|l| timing(r.get(l.copy())))
                println(md_row((r.get("title") ?? Json.Null).as_str() ?? name.copy(), cells, true))
            }
            println("")
        }
        for name in results.keys() {
            let r = results.get(name.copy()) ?? Json.Null
            if (r.get("group") ?? Json.Null) != Json.Str("parallel") {
                continue
            }
            println("{os}, {(r.get("title") ?? Json.Null).as_str() ?? name.copy()}:")
            println("")
            md_head("Threads", built.copy())
            let counts = r.get("threads") ?? Json.Null
            for t in counts.keys() {
                let at = counts.get(t.copy()) ?? Json.Null
                println(md_row(t.copy(), built.map(|l| timing(at.get(l.copy()))), false))
            }
            let same = r.get("same_output_at_every_count") ?? Json.Null
            var row = String("| Same output at every count |")
            for l in built {
                let s = (same.get(l.copy()) ?? Json.Null).as_bool()
                row.push_str(if s == some(true) { " yes |" } else if s == some(false) { " no |" } else { " — |" })
            }
            println(row)
            println("")
        }
        // Calx against each language as the site's chart counts it: within 5% either way is even,
        // and a parallel loop counts at the most threads.
        var faster = [0u32; 4]
        var even = [0u32; 4]
        var slower = [0u32; 4]
        for name in results.keys() {
            let at = widest(results.get(name.copy()) ?? Json.Null)
            let calx = timing(at.get("calx")) else {
                continue
            }
            for i in 0usize..4 {
                let other = timing(at.get(all[i + 1].copy())) else {
                    continue
                }
                let r = calx.0 / other.0
                if r <= 1.0 / EVEN {
                    faster[i] += 1
                } else if r >= EVEN {
                    slower[i] += 1
                } else {
                    even[i] += 1
                }
            }
        }
        println("{os}, Calx against each language:")
        println("")
        println("| Against | Calx faster | Even | Calx slower |")
        println("| --- | --- | --- | --- |")
        for i in 0usize..4 {
            println("| {lang_name(all[i + 1].copy())}, on {faster[i] + even[i] + slower[i]} | {faster[i]} | {even[i]} | {slower[i]} |")
        }
        println("")
        let dx = results.get("dx") ?? Json.Null
        if dx.is_null() {
            continue
        }
        println("{os}, builds:")
        println("")
        md_head("Build", built.copy())
        let builds = dx.get("builds") ?? Json.Null
        for key in builds.keys() {
            let b = builds.get(key.copy()) ?? Json.Null
            println(md_row((b.get("title") ?? Json.Null).as_str() ?? key.copy(), built.map(|l| timing(b.get(l.copy()))), false))
        }
        println("")
        println("{os}, release programs' sizes:")
        println("")
        md_head("Program", built.copy())
        let sizes = dx.get("sizes_bytes") ?? Json.Null
        for size in sizes.keys() {
            let s = sizes.get(size.copy()) ?? Json.Null
            var row = "| {if size == "hello" { String("hello") } else { "{dx.get("modules") ?? Json.Null} modules" }} |"
            for l in built {
                if let n = (s.get(l.copy()) ?? Json.Null).as_f64() {
                    row.push_str(" {n / 1024.0:,.0} KB |")
                } else {
                    row.push_str(" — |")
                }
            }
            println(row)
        }
        println("")
        println("{os}, starting hello:")
        println("")
        md_head("Program", all.copy())
        let startup = dx.get("startup") ?? Json.Null
        println(md_row(String("hello"), all.map(|l| timing(startup.get(l.copy()))), true))
        println("")
    }
}

// The results `path` holds, if it's there and reads as a record.
fn kept(path: String) -> Json {
    let ok(read) = fs.read_text(path) else {
        return Json.Null
    }
    let text = read else {
        return Json.Null
    }
    let ok(doc) = parse(text) else {
        return Json.Null
    }
    return doc.get("results") ?? Json.Null
}

fn main() {
    let a = Args.parse()
    let root = repo_root()
    if a.tables {
        print_tables(root)
        return
    }
    let calx = compiler(root.copy())
    let python = find_python()
    var all_langs: List<String> = []
    for l in LANGS {
        all_langs.push(String(l))
    }
    let langs = chosen(a.langs.copy(), all_langs, String("language"))
    let groups = chosen(a.groups.copy(), ["compute", "realistic", "parallel", "dx"], String("group"))
    var names: List<String> = []
    for b in benches() {
        names.push(b.name.copy())
    }
    let only = chosen(a.only.copy(), names, String("benchmark"))
    var list: List<Bench> = []
    for b in benches() {
        if only.contains(b.name.copy()) and groups.contains(b.group.copy()) {
            list.push(b.copy())
        }
    }
    let rounds = if a.quick { 1u32 } else { a.rounds }
    let processors = unsafe { process.processors() }
    var thread_counts: List<u32> = []
    for t in a.threads.split(",") {
        let w = t.trim()
        if w == "all" {
            thread_counts.push(processors)
        } else if let n = u32.parse(w.copy()) {
            if n > 0 {
                thread_counts.push(n.min(processors))
            }
        } else {
            stop("--threads takes numbers and `all`, with commas between")
        }
    }

    // A record names the commit it measured, so it should be measuring exactly that commit.
    let changed = uncommitted(root.copy())
    if a.record and not changed.is_empty() {
        eprintln("suite: recording with uncommitted changes to {changed.join(", ")}; the record lists them")
    }

    let work = fs.temp_dir()!.replace("\\", "/")
    let single = pin_for(1, processors)
    apply_pin(single.copy())
    let quiet = cpu_times()
    println("suite: building in {work}")
    let built = build_all(root.copy(), work.copy(), calx.copy(), list.copy(), langs.copy())
    let after = cpu_times()
    if after.1 > quiet.1 {
        println("suite: the machine was {f64.nearest(after.0 - quiet.0) / f64.nearest(after.1 - quiet.1) * 100.0:.0}% busy while it built")
    }
    // On Linux every program starts `measured`, from a helper, so its peak memory is its own and
    // not this one's. What a program that does nothing gets is the floor.
    var floor = Json.Null
    if env.os() == "linux" {
        let ok(r) = run_once(["true"], work.copy(), []) else {
            stop("can't run `true`")
        }
        floor = Json.Float(round_to(r.peak, 2))
        println("suite: a program that does nothing peaks at {mb(r.peak)}")
    }

    var inputs = LinkedMap<String, String>()
    var results = LinkedMap<String, Json>()
    var rows = LinkedMap<String, List<(String, List<Prog>)>>()
    for b in list {
        if b.group == "parallel" {
            continue
        }
        let args = resolve(if a.quick { b.quick.copy() } else { b.args.copy() }, mut inputs, work.copy(), a.quick, String("1"))
        var progs = progs_for(b.copy(), langs.copy(), built.copy(), python.copy(), args, 1)
        println("{b.title}")
        measure(mut progs, work.copy(), rounds, b.title.copy())
        for p in progs {
            if p.status == "ok" and not p.runs.is_empty() {
                println("  {lang_name(p.lang.copy())}: {ms(median(walls(p)))} median, {ms(best_of(walls(p)))} best, {mb(median(peaks(p)))}, {p.runs.len()} runs, {p.again} repeated")
            }
        }
        var r = LinkedMap<String, Json>()
        r.insert("title", Json.Str(b.title.copy()))
        r.insert("group", Json.Str(b.group.copy()))
        r.insert("args", Json.Array((if a.quick { b.quick.copy() } else { b.args.copy() }).map(|s| Json.Str(s.copy()))))
        r.insert("recorded", Json.Str(now_utc()))
        r.insert("commit", commit(root.copy()))
        for p in progs {
            r.insert(p.lang.copy(), prog_json(p.copy()))
        }
        results.insert(b.name.copy(), Json.Object(r))
        var g: List<(String, List<Prog>)> = rows.remove(b.group.copy()) ?? []
        g.push((b.title.copy(), progs))
        rows.insert(b.group.copy(), g)
    }

    // The parallel benchmarks, at each thread count, pinned to as many processors, and whether
    // each language printed the same at every count, its `info` lines too.
    var par_rows: List<(String, List<Prog>)> = []
    for b in list {
        if b.group != "parallel" {
            continue
        }
        var r = LinkedMap<String, Json>()
        r.insert("title", Json.Str(b.title.copy()))
        r.insert("group", Json.Str(b.group.copy()))
        r.insert("args", Json.Array((if a.quick { b.quick.copy() } else { b.args.copy() }).map(|s| Json.Str(s.copy()))))
        r.insert("recorded", Json.Str(now_utc()))
        r.insert("commit", commit(root.copy()))
        var by_count = LinkedMap<String, Json>()
        var outs = LinkedMap<String, List<String>>()
        // Languages whose output changed between runs at some count, so isn't the same at every
        // count either.
        var varied = Set<String>()
        for t in thread_counts {
            let pin = pin_for(t, processors)
            apply_pin(pin.copy())
            let args = resolve(if a.quick { b.quick.copy() } else { b.args.copy() }, mut inputs, work.copy(), a.quick, "{t}")
            var progs = progs_for(b.copy(), langs.copy(), built.copy(), python.copy(), args, t)
            let title = if t == 1 { "{b.title}, 1 thread" } else { "{b.title}, {t} threads" }
            println(title)
            measure(mut progs, work.copy(), rounds, title.copy())
            var per = LinkedMap<String, Json>()
            for p in progs {
                if p.status == "ok" and not p.runs.is_empty() {
                    println("  {lang_name(p.lang.copy())}: {ms(median(walls(p)))} median, {ms(best_of(walls(p)))} best, {mb(median(peaks(p)))}, {p.runs.len()} runs, {p.again} repeated")
                    var seen: List<String> = outs.remove(p.lang.copy()) ?? []
                    seen.push(p.out.copy())
                    outs.insert(p.lang.copy(), seen)
                    if p.varied {
                        varied.insert(p.lang.copy())
                    }
                }
                per.insert(p.lang.copy(), prog_json(p.copy()))
            }
            by_count.insert("{t}", Json.Object(per))
            par_rows.push((title, progs))
        }
        var same = LinkedMap<String, Json>()
        for (l, seen) in outs {
            if seen.len() == thread_counts.len() {
                var all_same = not varied.contains(l.copy())
                for o in seen {
                    if o != seen[0] {
                        all_same = false
                    }
                }
                same.insert(l.copy(), Json.Bool(all_same))
                println("  {lang_name(l.copy())}: {if all_same { "the same output at every thread count" } else { "output that changes with the thread count" }}")
            }
        }
        r.insert("threads", Json.Object(by_count))
        r.insert("same_output_at_every_count", Json.Object(same))
        results.insert(b.name.copy(), Json.Object(r))
    }
    apply_pin(single.copy())

    var dx_record = Json.Null
    if groups.contains("dx") and a.only.is_empty() {
        dx_record = dx_group(work.copy(), langs.copy(), calx.copy(), python.copy(), rounds, processors, single.copy())
    }

    for (group, g) in rows {
        table(if group == "compute" { String("Classic compute") } else { String("Realistic programs") }, g.copy(), langs.copy())
    }
    if not par_rows.is_empty() {
        var par_langs: List<String> = []
        for l in langs {
            if l != "python" {
                par_langs.push(l.copy())
            }
        }
        table(String("Parallel loops"), par_rows, par_langs)
    }

    if a.record and not a.quick {
        let out = "{root}/bench/results/suite-{env.os()}.json"
        var merged = LinkedMap<String, Json>()
        let old = kept(out.copy())
        for b in benches() {
            match results.remove(b.name.copy()) {
                some(j) => {
                    merged.insert(b.name.copy(), j)
                }
                none => {
                    if let j = old.get(b.name.copy()) {
                        merged.insert(b.name.copy(), j)
                    }
                }
            }
        }
        if dx_record != Json.Null {
            merged.insert("dx", dx_record)
        } else if let j = old.get("dx") {
            merged.insert("dx", j)
        }
        var r = LinkedMap<String, Json>()
        r.insert("recorded", Json.Str(now_utc()))
        r.insert("commit", commit(root.copy()))
        if not changed.is_empty() {
            r.insert("uncommitted", Json.Array(changed.map(|f| Json.Str(f.copy()))))
        }
        r.insert("machine", machine())
        r.insert("toolchain", toolchains(calx.copy(), python.copy()))
        r.insert("rounds", Json.Int(i64(a.rounds)))
        if floor != Json.Null {
            r.insert("peak_mb_of_a_program_that_does_nothing", floor)
        }
        r.insert("results", Json.Object(merged))
        fs.make_dir_all("{root}/bench/results")!
        fs.write_text(out.copy(), "{pretty(Json.Object(r), 2)}\n")!
        println("")
        println("suite: wrote {out}")
    }
    if a.keep {
        println("suite: kept {work}")
    } else {
        fs.remove_dir_all(work)!
    }
}
