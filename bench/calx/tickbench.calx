// The Calx version of the tick-loop benchmark (docs/benchmarks.md, P3.3).
//
// It implements exactly the algorithms in docs/benchmarks.md, as the Rust reference does, and
// must print the checksum in bench/expected.json.
//
//     tickbench [--threads N] [--warmup 200] [--ticks 1000] [--stats]

import std.env.{args}
import std.time.{Instant}

const SEED: i64 = 20261027
const STATES: i32 = 30000
const STATE_COUNT: u32 = 30000
const WORLD_CHUNKS: i32 = 16
const SECTIONS: usize = 24
const MIN_Y: i32 = -64
const MAX_Y: i32 = 320
const REGION_CHUNKS: i32 = 4
const REGIONS: usize = 16
const ENTITIES: usize = 4096
const MESSAGES: usize = 64
const RANDOM_TICKS: usize = 3
const SECTION_SIZE: usize = 4096
const EPS: f64 = 1.0e-7

// ---------------------------------------------------------------------------------------------
// java.util.Random, as its Javadoc specifies it.

const MULTIPLIER: i64 = 0x5DEECE66D
const ADDEND: i64 = 0xB
const MASK: i64 = (1i64 << 48) - 1

struct JavaRandom {
    seed: i64,
}

impl JavaRandom {
    fn new(seed: i64) -> JavaRandom {
        return JavaRandom { seed: (seed ^ MULTIPLIER) & MASK }
    }

    fn next(mut self, bits: i32) -> i32 {
        self.seed = (self.seed * MULTIPLIER + ADDEND) & MASK
        return i32.wrap(self.seed >> (48 - bits))
    }

    fn next_int(mut self, bound: i32) -> i32 {
        if (bound & -bound) == bound {
            return i32.wrap((i64(bound) * i64(self.next(31))) >> 31)
        }
        loop {
            let bits = self.next(31)
            let val = bits % bound
            if bits - val + (bound - 1) >= 0 {
                return val
            }
        }
    }

    fn next_long(mut self) -> i64 {
        let high = i64(self.next(32)) << 32
        return high + i64(self.next(32))
    }

    fn next_double(mut self) -> f64 {
        let high = i64(self.next(26)) << 27
        return f64.nearest(high + i64(self.next(27))) * (1.0 / 9007199254740992.0)
    }
}

// ---------------------------------------------------------------------------------------------
// The checksum: 64-bit FNV-1a over u64 values, each fed as 8 little-endian bytes.

struct Fnv {
    h: u64 = 0xcbf29ce484222325,
}

impl Fnv {
    fn feed(mut self, v: u64) {
        var h = self.h
        for k in 0..8 {
            h = (h ^ ((v >> (k * 8)) & 0xFF)) * 0x100000001b3
        }
        self.h = h
    }
}

// ---------------------------------------------------------------------------------------------
// The fast native map, from i64 keys: open addressing with linear probing, and one multiply to
// hash, as rustc's FxHasher does. The home slot takes the product's top bits.

const FX: u64 = 0x517cc1b727220a95

struct Entry<V> {
    key: i64,
    value: V,
}

struct I64Map<V> {
    slots: List<Entry<V>?>,
    len: usize,
    shift: i32,
}

impl<V: Copy> I64Map<V> {
    fn new() -> I64Map<V> {
        return I64Map<V> { slots: [none; 16], len: 0, shift: 60 }
    }

    fn home(self, key: i64) -> usize {
        return usize.wrap((u64.wrap(key) * FX) >> self.shift)
    }

    fn get(self, key: i64) -> V? {
        let mask = self.slots.len() - 1
        var h = self.home(key)
        loop {
            let e = self.slots[h] else return none
            if e.key == key {
                return some(e.value)
            }
            h = (h + 1) & mask
        }
    }

    fn put(mut self, key: i64, value: V) {
        if (self.len + 1) * 2 > self.slots.len() {
            self.grow()
        }
        let mask = self.slots.len() - 1
        var h = self.home(key)
        loop {
            let e = self.slots[h] else {
                self.slots[h] = some(Entry<V> { key: key, value: value })
                self.len += 1
                return
            }
            if e.key == key {
                self.slots[h] = some(Entry<V> { key: key, value: value })
                return
            }
            h = (h + 1) & mask
        }
    }

    fn grow(mut self) {
        let old = self.slots.len()
        var slots: List<Entry<V>?> = [none; old * 2]
        self.shift -= 1
        let mask = slots.len() - 1
        for i in 0usize..old {
            let e = self.slots[i] else continue
            var h = self.home(e.key)
            loop {
                match slots[h] {
                    none => break,
                    some(_) => h = (h + 1) & mask,
                }
            }
            slots[h] = some(e)
        }
        self.slots = slots
    }

    fn clear(mut self) {
        for i in 0usize..self.slots.len() {
            self.slots[i] = none
        }
        self.len = 0
    }

    /// The number of slots, for going over the entries with `at`.
    fn slot_count(self) -> usize {
        return self.slots.len()
    }

    fn at(self, i: usize) -> Entry<V>? {
        return self.slots[i]
    }
}

// ---------------------------------------------------------------------------------------------
// Positions, packed as vanilla packs them.

fn block_key(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 0x3FFFFFF) << 38) | ((i64(z) & 0x3FFFFFF) << 12) | (i64(y) & 0xFFF)
}

fn block_x(key: i64) -> i32 {
    return i32.wrap(key >> 38)
}

fn block_y(key: i64) -> i32 {
    return i32.wrap((key << 52) >> 52)
}

fn block_z(key: i64) -> i32 {
    return i32.wrap((key << 26) >> 38)
}

fn chunk_key(cx: i32, cz: i32) -> i64 {
    return (i64(cx) & 0xFFFFFFFF) | (i64(cz) << 32)
}

fn region_of(cx: i32, cz: i32) -> usize {
    return usize.wrap((cz / REGION_CHUNKS) * (WORLD_CHUNKS / REGION_CHUNKS) + cx / REGION_CHUNKS)
}

// ---------------------------------------------------------------------------------------------
// Bit storage: values packed into u64 words, never spanning two.

struct BitStorage {
    bits: i32,
    per_word: usize,
    divide_mul: u64,
    mask: u64,
    data: List<u64>,
}

impl BitStorage {
    fn new(bits: i32) -> BitStorage {
        if bits == 0 {
            return BitStorage { bits: 0, per_word: 0, divide_mul: 0, mask: 0, data: List() }
        }
        let per_word = usize.wrap(64 / bits)
        return BitStorage {
            bits: bits,
            per_word: per_word,
            // floor(2^32 / per_word) + 1, so (i * divide_mul) >> 32 == i / per_word for i < 4096.
            divide_mul: (1u64 << 32) / u64(per_word) + 1,
            mask: (1u64 << bits) - 1,
            data: [0u64; (SECTION_SIZE + per_word - 1) / per_word],
        }
    }

    fn get(self, i: usize) -> u32 {
        let word = usize.wrap((u64(i) * self.divide_mul) >> 32)
        let shift = i32.wrap(i - word * self.per_word) * self.bits
        return u32.wrap((self.data[word] >> shift) & self.mask)
    }

    fn set(mut self, i: usize, v: u32) {
        let word = usize.wrap((u64(i) * self.divide_mul) >> 32)
        let shift = i32.wrap(i - word * self.per_word) * self.bits
        let w = self.data[word]
        self.data[word] = (w & ~(self.mask << shift)) | (u64(v) << shift)
    }
}

// ---------------------------------------------------------------------------------------------
// The hash palette's ID-to-index map: open addressing with linear probing.

struct IdIndex {
    slots: List<u16>,    // palette index + 1, or 0 for empty
    shift: i32,
}

impl IdIndex {
    fn empty() -> IdIndex {
        return IdIndex { slots: List(), shift: 0 }
    }

    fn new(bits: i32, states: List<u32>) -> IdIndex {
        let capacity_log = bits + 1    // twice the palette's capacity
        var index = IdIndex { slots: [0u16; usize.wrap(1 << capacity_log)], shift: 32 - capacity_log }
        for i in 0usize..states.len() {
            index.insert(states[i], i)
        }
        return index
    }

    fn home(self, id: u32) -> usize {
        return usize((id * 0x9E3779B9) >> self.shift)
    }

    fn find(self, id: u32, states: List<u32>) -> u32? {
        let mask = self.slots.len() - 1
        var h = self.home(id)
        loop {
            let e = self.slots[h]
            if e == 0 {
                return none
            }
            if states[usize(e) - 1] == id {
                return some(u32(e) - 1)
            }
            h = (h + 1) & mask
        }
    }

    fn insert(mut self, id: u32, index: usize) {
        let mask = self.slots.len() - 1
        var h = self.home(id)
        while self.slots[h] != 0 {
            h = (h + 1) & mask
        }
        self.slots[h] = u16.wrap(index) + 1
    }
}

// ---------------------------------------------------------------------------------------------
// A section: 4,096 block states in one of vanilla's four layouts.

const SINGLE: i32 = 0
const LINEAR: i32 = 1
const HASH: i32 = 2
const GLOBAL: i32 = 3

const LINEAR_BITS: i32 = 4
const HASH_MIN_BITS: i32 = 5
const HASH_MAX_BITS: i32 = 8
const GLOBAL_BITS: i32 = 15

struct Section {
    kind: i32,
    single: u32,           // SINGLE: the one state
    states: List<u32>,     // LINEAR and HASH: palette index to state
    index: IdIndex,        // HASH: state to palette index
    storage: BitStorage,
}

fn ceil_log2(n: usize) -> i32 {
    var bits = 0
    while (1u64 << bits) < u64(n) {
        bits += 1
    }
    return bits
}

fn position(states: List<u32>, id: u32) -> usize? {
    for j in 0usize..states.len() {
        if states[j] == id {
            return some(j)
        }
    }
    return none
}

impl Section {
    /// A section whose palette is `states`, in that order, with every index 0.
    fn with_states(states: own List<u32>) -> Section {
        let n = states.len()
        if n == 1 {
            return Section { kind: SINGLE, single: states[0], states: List(), index: IdIndex.empty(), storage: BitStorage.new(0) }
        }
        if n <= 16 {
            return Section { kind: LINEAR, single: 0, states: states, index: IdIndex.empty(), storage: BitStorage.new(LINEAR_BITS) }
        }
        if n <= 256 {
            let bits = ceil_log2(n).max(HASH_MIN_BITS)
            let index = IdIndex.new(bits, states)
            return Section { kind: HASH, single: 0, states: states, index: index, storage: BitStorage.new(bits) }
        }
        return Section { kind: GLOBAL, single: 0, states: List(), index: IdIndex.empty(), storage: BitStorage.new(GLOBAL_BITS) }
    }

    fn get(self, i: usize) -> u32 {
        if self.kind == SINGLE {
            return self.single
        }
        let v = self.storage.get(i)
        if self.kind == GLOBAL {
            return v
        }
        return self.states[usize(v)]
    }

    fn set(mut self, i: usize, id: u32) {
        var index: u32 = id
        if self.kind == SINGLE {
            if self.single == id {
                return
            }
            let states: List<u32> = [self.single, id]
            self.resize(LINEAR, states, IdIndex.empty(), LINEAR_BITS)
            index = 1
        } else if self.kind == LINEAR {
            if let j = position(self.states, id) {
                index = u32.wrap(j)
            } else if self.states.len() < 16 {
                self.states.push(id)
                index = u32.wrap(self.states.len() - 1)
            } else {
                var grown = self.states.copy()
                grown.push(id)
                let ids = IdIndex.new(HASH_MIN_BITS, grown)
                self.resize(HASH, grown, ids, HASH_MIN_BITS)
                index = 16
            }
        } else if self.kind == HASH {
            if let j = self.index.find(id, self.states) {
                index = j
            } else if self.states.len() < usize.wrap(1 << self.storage.bits) {
                self.states.push(id)
                self.index.insert(id, self.states.len() - 1)
                index = u32.wrap(self.states.len() - 1)
            } else if self.storage.bits < HASH_MAX_BITS {
                let bits = self.storage.bits + 1
                var grown = self.states.copy()
                grown.push(id)
                let ids = IdIndex.new(bits, grown)
                index = u32.wrap(grown.len() - 1)
                self.resize(HASH, grown, ids, bits)
            } else {
                self.resize(GLOBAL, List(), IdIndex.empty(), GLOBAL_BITS)
            }
        }
        self.storage.set(i, index)
    }

    /// Re-encodes all 4,096 values into a larger layout. The new palette keeps the old one's
    /// entries at the same indices, so a palette index carries over; the global layout stores IDs.
    fn resize(mut self, kind: i32, states: own List<u32>, index: own IdIndex, bits: i32) {
        var storage = BitStorage.new(bits)
        if self.kind != SINGLE {
            for i in 0usize..SECTION_SIZE {
                let j = self.storage.get(i)
                storage.set(i, if kind == GLOBAL { self.states[usize(j)] } else { j })
            }
        }
        self.kind = kind
        self.states = states
        self.index = index
        self.storage = storage
    }

    fn sum(self) -> u64 {
        var total: u64 = 0
        for i in 0usize..SECTION_SIZE {
            total += u64(self.get(i))
        }
        return total
    }
}

fn section_index(lx: i32, ly: i32, lz: i32) -> usize {
    return usize.wrap((ly << 8) | (lz << 4) | lx)
}

// ---------------------------------------------------------------------------------------------
// A Java-compatible HashMap<Long, Integer>: Java's hash spreading, power-of-two table, tail
// insertion, load factor 0.75 and the order-preserving resize split. A bin that would reach
// Java's treeify threshold on a table of 64 or more stops the run: the benchmark's workload never
// makes one.

const NIL: u32 = 0xFFFFFFFF

struct Node {
    hash: i32,
    key: i64,
    value: i32,
    next: u32,
}

struct JavaHashMap {
    table: List<u32>,
    nodes: List<Node>,
    free: List<u32>,
    size: usize,
    threshold: usize,
}

fn java_hash(key: i64) -> i32 {
    let h = i32.wrap(key ^ (key >>> 32))
    return h ^ (h >>> 16)
}

fn bucket_of(hash: i32, len: usize) -> usize {
    return usize(u32.wrap(hash)) & (len - 1)
}

impl JavaHashMap {
    fn new() -> JavaHashMap {
        return JavaHashMap { table: List(), nodes: List(), free: List(), size: 0, threshold: 0 }
    }

    fn alloc(mut self, node: Node) -> u32 {
        let i = self.free.pop() else {
            self.nodes.push(node)
            return u32.wrap(self.nodes.len() - 1)
        }
        self.nodes[usize(i)] = node
        return i
    }

    fn put(mut self, key: i64, value: i32) {
        if self.table.is_empty() {
            self.resize()
        }
        let hash = java_hash(key)
        let bucket = bucket_of(hash, self.table.len())
        var p = self.table[bucket]
        if p == NIL {
            let n = self.alloc(Node { hash: hash, key: key, value: value, next: NIL })
            self.table[bucket] = n
        } else {
            var bin_count = 0
            loop {
                let node = self.nodes[usize(p)]
                if node.hash == hash and node.key == key {
                    self.nodes[usize(p)].value = value
                    return
                }
                if node.next == NIL {
                    let n = self.alloc(Node { hash: hash, key: key, value: value, next: NIL })
                    self.nodes[usize(p)].next = n
                    if bin_count >= 7 {
                        // Java's treeifyBin: on a table under 64 it resizes instead.
                        if self.table.len() >= 64 {
                            panic("tickbench: a scheduled-tick bin reached Java's treeify threshold")
                        }
                        self.resize()
                    }
                    break
                }
                p = node.next
                bin_count += 1
            }
        }
        self.size += 1
        if self.size > self.threshold {
            self.resize()
        }
    }

    fn remove(mut self, key: i64) {
        let hash = java_hash(key)
        let bucket = bucket_of(hash, self.table.len())
        var prev = NIL
        var p = self.table[bucket]
        while p != NIL {
            let node = self.nodes[usize(p)]
            if node.hash == hash and node.key == key {
                if prev == NIL {
                    self.table[bucket] = node.next
                } else {
                    self.nodes[usize(prev)].next = node.next
                }
                self.free.push(p)
                self.size -= 1
                return
            }
            prev = p
            p = node.next
        }
    }

    fn resize(mut self) {
        let old = self.table.len()
        let grown = if old == 0 { 16usize } else { old * 2 }
        self.threshold = grown * 3 / 4
        var table: List<u32> = [NIL; grown]
        for j in 0usize..old {
            var lo_head = NIL
            var lo_tail = NIL
            var hi_head = NIL
            var hi_tail = NIL
            var p = self.table[j]
            while p != NIL {
                let next = self.nodes[usize(p)].next
                self.nodes[usize(p)].next = NIL
                if (usize(u32.wrap(self.nodes[usize(p)].hash)) & old) == 0 {
                    if lo_tail == NIL {
                        lo_head = p
                    } else {
                        self.nodes[usize(lo_tail)].next = p
                    }
                    lo_tail = p
                } else {
                    if hi_tail == NIL {
                        hi_head = p
                    } else {
                        self.nodes[usize(hi_tail)].next = p
                    }
                    hi_tail = p
                }
                p = next
            }
            table[j] = lo_head
            table[j + old] = hi_head
        }
        self.table = table
    }

    /// The keys whose value is at most `tick`, in Java's iteration order.
    fn due(self, tick: i32, out: mut List<i64>) {
        for head in self.table {
            var p = head
            while p != NIL {
                let node = self.nodes[usize(p)]
                if node.value <= tick {
                    out.push(node.key)
                }
                p = node.next
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// The world: regions own their chunks, scheduled ticks, entities and random streams.

struct Chunk {
    cx: i32,
    cz: i32,
    sections: List<Section>,
}

struct Entity {
    id: u32,
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
}

struct Message {
    pos: i64,
    value: i64,
}

struct Outgoing {
    dest: usize,
    m: Message,
}

struct Handoff {
    dest: usize,
    e: Entity,
}

struct Blocks {
    chunks: List<Chunk>,
}

/// Where a chunk is: its region, and its index in that region's list.
struct ChunkRef {
    r: usize,
    c: usize,
}

struct State {
    rng: JavaRandom,
    scheduled: JavaHashMap,
    tick_hash: Fnv,
    message_hash: Fnv,
    inbox: List<Message>,
    outbox: List<Outgoing>,
    entities: List<Entity>,
    handoffs: List<Handoff>,
    per_chunk: I64Map<u32>,
    due: List<i64>,
}

struct World {
    blocks: List<Blocks>,
    states: List<State>,
    /// Chunk position to where the chunk is: the fast native map.
    chunk_map: I64Map<ChunkRef>,
}

fn floor_i32(x: f64) -> i32 {
    return i32.saturate(x.floor())
}

fn generate() -> World {
    var rng = JavaRandom.new(SEED)
    var blocks = List<Blocks>()
    for _ in 0usize..REGIONS {
        blocks.push(Blocks { chunks: List() })
    }
    var chunk_map: I64Map<ChunkRef> = I64Map.new()
    // Each region lists its chunks in x, then z order, the same as generation.
    for cx in 0..WORLD_CHUNKS {
        for cz in 0..WORLD_CHUNKS {
            let r = region_of(cx, cz)
            chunk_map.put(chunk_key(cx, cz), ChunkRef { r: r, c: blocks[r].chunks.len() })
            blocks[r].chunks.push(Chunk { cx: cx, cz: cz, sections: List() })
        }
    }
    for cx in 0..WORLD_CHUNKS {
        for cz in 0..WORLD_CHUNKS {
            let at = chunk_map.get(chunk_key(cx, cz))!
            for _ in 0usize..SECTIONS {
                let roll = rng.next_int(100)
                let n = if roll < 40 {
                    1
                } else if roll < 80 {
                    2 + rng.next_int(15)
                } else if roll < 95 {
                    17 + rng.next_int(240)
                } else {
                    257 + rng.next_int(768)
                }
                var states = List<u32>()
                while states.len() < usize.wrap(n) {
                    let s = u32.wrap(rng.next_int(STATES))
                    if not states.contains(s) {
                        states.push(s)
                    }
                }
                var section = Section.with_states(states.copy())
                for i in 0usize..SECTION_SIZE {
                    let j = usize.wrap(rng.next_int(n))
                    if section.kind == GLOBAL {
                        section.storage.set(i, states[j])
                    } else if section.kind != SINGLE {
                        section.storage.set(i, u32.wrap(j))
                    }
                }
                blocks[at.r].chunks[at.c].sections.push(section)
            }
        }
    }
    var states = List<State>()
    for k in 0usize..REGIONS {
        states.push(State {
            rng: JavaRandom.new(SEED + i64.wrap(k)),
            scheduled: JavaHashMap.new(),
            tick_hash: Fnv {},
            message_hash: Fnv {},
            inbox: List(),
            outbox: List(),
            entities: List(),
            handoffs: List(),
            per_chunk: I64Map.new(),
            due: List(),
        })
    }
    for k in 0usize..ENTITIES {
        let x = 0.3 + rng.next_double() * 255.4
        let y = f64(MAX_Y) + rng.next_double() * 64.0
        let z = 0.3 + rng.next_double() * 255.4
        let vx = rng.next_double() - 0.5
        let vy = rng.next_double() - 0.5
        let vz = rng.next_double() - 0.5
        let r = region_of(floor_i32(x) >> 4, floor_i32(z) >> 4)
        states[r].entities.push(Entity { id: u32.wrap(k), x: x, y: y, z: z, vx: vx, vy: vy, vz: vz })
    }
    return World { blocks: blocks, states: states, chunk_map: chunk_map }
}

// ---------------------------------------------------------------------------------------------
// Pass 1: each region's block work.

fn bump(section: mut Section, i: usize) {
    let id = section.get(i)
    section.set(i, (id + 1) % STATE_COUNT)
}

/// The section's random ticks, then its full read.
fn random_ticks(section: mut Section, st: mut State, cx: i32, cz: i32, sy: i32, tick: i32) {
    for _ in 0usize..RANDOM_TICKS {
        let i = st.rng.next_int(4096)
        let lx = i & 15
        let lz = (i >> 4) & 15
        let ly = i >> 8
        let id = section.get(usize.wrap(i))
        let sum = id +
            section.get(section_index((lx - 1).max(0), ly, lz)) +
            section.get(section_index((lx + 1).min(15), ly, lz)) +
            section.get(section_index(lx, (ly - 1).max(0), lz)) +
            section.get(section_index(lx, (ly + 1).min(15), lz)) +
            section.get(section_index(lx, ly, (lz - 1).max(0))) +
            section.get(section_index(lx, ly, (lz + 1).min(15)))
        if sum % 7 == 0 {
            section.set(usize.wrap(i), (id * 31 + 7) % STATE_COUNT)
            let key = block_key(cx * 16 + lx, MIN_Y + sy * 16 + ly, cz * 16 + lz)
            st.scheduled.put(key, tick + 2)
        }
    }
    st.tick_hash.feed(section.sum())
}

fn block_pass(blocks: mut Blocks, st: mut State, tick: i32) {
    // Messages delivered at the last barrier, in delivery order.
    for j in 0usize..st.inbox.len() {
        let m = st.inbox[j]
        st.message_hash.feed(u64.wrap(m.pos))
        st.message_hash.feed(u64.wrap(m.value))
    }
    st.inbox.clear()

    // Scheduled ticks that are due, in the map's iteration order.
    st.due.clear()
    st.scheduled.due(tick, mut st.due)
    for j in 0usize..st.due.len() {
        let key = st.due[j]
        st.scheduled.remove(key)
        let x = block_x(key)
        let y = block_y(key)
        let z = block_z(key)
        let local = usize.wrap(((x >> 4) % REGION_CHUNKS) * REGION_CHUNKS + (z >> 4) % REGION_CHUNKS)
        bump(mut blocks.chunks[local].sections[usize.wrap((y - MIN_Y) >> 4)], section_index(x & 15, y & 15, z & 15))
        st.tick_hash.feed(u64.wrap(key))
    }

    // Random ticks, then one full read, for every section.
    for c in 0usize..blocks.chunks.len() {
        let cx = blocks.chunks[c].cx
        let cz = blocks.chunks[c].cz
        for sy in 0usize..SECTIONS {
            random_ticks(mut blocks.chunks[c].sections[sy], mut st, cx, cz, i32.wrap(sy), tick)
        }
    }

    // Messages to random regions.
    for _ in 0usize..MESSAGES {
        let dest = usize.wrap(st.rng.next_int(16))
        let pos = st.rng.next_long()
        let value = st.rng.next_long()
        st.outbox.push(Outgoing { dest: dest, m: Message { pos: pos, value: value } })
    }
}

// ---------------------------------------------------------------------------------------------
// Pass 2: each region's entity physics, reading blocks anywhere in the world.

/// The chunk an entity started the tick in, looked up once.
struct Home {
    cx: i32,
    cz: i32,
    at: ChunkRef,
}

fn solid(blocks: List<Blocks>, chunk_map: I64Map<ChunkRef>, home: Home, bx: i32, by: i32, bz: i32) -> bool {
    // The world border is a wall at every height, so nothing leaves the world.
    let edge = WORLD_CHUNKS * 16
    if bx < 0 or bz < 0 or bx >= edge or bz >= edge or by < MIN_Y {
        return true
    }
    if by >= MAX_Y {
        return false
    }
    let cx = bx >> 4
    let cz = bz >> 4
    let at = if cx == home.cx and cz == home.cz { home.at } else { chunk_map.get(chunk_key(cx, cz))! }
    let section = usize.wrap((by - MIN_Y) >> 4)
    return blocks[at.r].chunks[at.c].sections[section].get(section_index(bx & 15, by & 15, bz & 15)) != 0
}

struct Aabb {
    min: [f64; 3],
    max: [f64; 3],
}

fn aabb_of(e: Entity) -> Aabb {
    return Aabb { min: [e.x - 0.3, e.y, e.z - 0.3], max: [e.x + 0.3, e.y + 1.8, e.z + 0.3] }
}

/// Whether any block in the layer at `layer` along axis `a`, across the box's extent in `u` and
/// `v`, is solid.
fn hit(blocks: List<Blocks>, chunk_map: I64Map<ChunkRef>, home: Home, a: usize, u: usize, v: usize, layer: i32,
       u0: i32, u1: i32, v0: i32, v1: i32) -> bool {
    for p in u0..=u1 {
        for q in v0..=v1 {
            var c = [0, 0, 0]
            c[a] = layer
            c[u] = p
            c[v] = q
            if solid(blocks, chunk_map, home, c[0], c[1], c[2]) {
                return true
            }
        }
    }
    return false
}

/// How far the box can move by `d` along axis `a` before it meets a solid block. Blocks it
/// already overlaps by more than EPS are ignored, as in vanilla.
fn clip(blocks: List<Blocks>, chunk_map: I64Map<ChunkRef>, home: Home, b: Aabb, a: usize, d: f64) -> f64 {
    let u: usize = if a == 0 { 1 } else { 0 }
    let v: usize = if a == 2 { 1 } else { 2 }
    let u0 = floor_i32(b.min[u] + EPS)
    let u1 = floor_i32(b.max[u] - EPS)
    let v0 = floor_i32(b.min[v] + EPS)
    let v1 = floor_i32(b.max[v] - EPS)
    if d < 0.0 {
        let first = floor_i32(b.min[a] + EPS) - 1
        let last = floor_i32(b.min[a] + d + EPS)
        var down = first
        while down >= last {
            if hit(blocks, chunk_map, home, a, u, v, down, u0, u1, v0, v1) {
                return d.max(f64(down + 1) - b.min[a])
            }
            down -= 1
        }
    } else if d > 0.0 {
        let first = floor_i32(b.max[a] - EPS) + 1
        let last = floor_i32(b.max[a] + d - EPS)
        for up in first..=last {
            if hit(blocks, chunk_map, home, a, u, v, up, u0, u1, v0, v1) {
                return d.min(f64(up) - b.max[a])
            }
        }
    }
    return d
}

const AXIS_X: usize = 0
const AXIS_Y: usize = 1
const AXIS_Z: usize = 2

fn step(blocks: List<Blocks>, chunk_map: I64Map<ChunkRef>, home: Home, e: mut Entity, axis: usize) {
    let d = if axis == AXIS_X { e.vx } else if axis == AXIS_Y { e.vy } else { e.vz }
    let moved = clip(blocks, chunk_map, home, aabb_of(e), axis, d)
    if axis == AXIS_X {
        e.x += moved
        if moved != d {
            e.vx = 0.0
        }
    } else if axis == AXIS_Y {
        e.y += moved
        if moved != d {
            e.vy = 0.0
        }
    } else {
        e.z += moved
        if moved != d {
            e.vz = 0.0
        }
    }
}

fn entity_pass(blocks: List<Blocks>, chunk_map: I64Map<ChunkRef>, k: usize, st: mut State) {
    var kept = List<Entity>()
    kept.reserve(st.entities.len())
    for j in 0usize..st.entities.len() {
        var e = st.entities[j]
        let cx = floor_i32(e.x) >> 4
        let cz = floor_i32(e.z) >> 4
        let home = Home { cx: cx, cz: cz, at: chunk_map.get(chunk_key(cx, cz))! }
        step(blocks, chunk_map, home, mut e, AXIS_Y)
        if e.vx.abs() < e.vz.abs() {
            step(blocks, chunk_map, home, mut e, AXIS_Z)
            step(blocks, chunk_map, home, mut e, AXIS_X)
        } else {
            step(blocks, chunk_map, home, mut e, AXIS_X)
            step(blocks, chunk_map, home, mut e, AXIS_Z)
        }
        e.vy = (e.vy - 0.08) * 0.98
        e.vx *= 0.91
        e.vz *= 0.91
        let dest = region_of(floor_i32(e.x) >> 4, floor_i32(e.z) >> 4)
        if dest == k {
            kept.push(e)
        } else {
            st.handoffs.push(Handoff { dest: dest, e: e })
        }
    }
    st.entities = kept

    st.per_chunk.clear()
    for j in 0usize..st.entities.len() {
        let key = chunk_key(floor_i32(st.entities[j].x) >> 4, floor_i32(st.entities[j].z) >> 4)
        let n = st.per_chunk.get(key) ?? 0
        st.per_chunk.put(key, n + 1)
    }
    var crowding: u64 = 0
    for i in 0usize..st.per_chunk.slot_count() {
        let entry = st.per_chunk.at(i) else continue
        crowding += u64(entry.value) * u64(entry.value)
    }
    st.tick_hash.feed(crowding)
}

// ---------------------------------------------------------------------------------------------
// The barrier: deliver in sender order, apply handoffs, absorb each region's hashes.

fn barrier(world: mut World, checksum: mut Fnv) {
    for s in 0usize..REGIONS {
        for j in 0usize..world.states[s].outbox.len() {
            let o = world.states[s].outbox[j]
            world.states[o.dest].inbox.push(o.m)
        }
        world.states[s].outbox.clear()
        for j in 0usize..world.states[s].handoffs.len() {
            let h = world.states[s].handoffs[j]
            world.states[h.dest].entities.push(h.e)
        }
        world.states[s].handoffs.clear()
    }
    for s in 0usize..REGIONS {
        checksum.feed(world.states[s].tick_hash.h)
        checksum.feed(world.states[s].message_hash.h)
        world.states[s].tick_hash = Fnv {}
    }
}

// ---------------------------------------------------------------------------------------------

struct Options {
    threads: usize,
    warmup: usize,
    ticks: usize,
    stats: bool,
}

fn parse_args() -> Options {
    var o = Options { threads: 1, warmup: 200, ticks: 1000, stats: false }
    let a = args()
    var i: usize = 0
    while i < a.len() {
        if a[i] == "--stats" {
            o.stats = true
            i += 1
            continue
        }
        if i + 1 >= a.len() {
            panic("tickbench: {a[i]} needs a number")
        }
        let value = usize.parse(a[i + 1]) else panic("tickbench: {a[i]} needs a number")
        match a[i] {
            "--threads" => o.threads = value.max(1),
            "--warmup" => o.warmup = value,
            "--ticks" => o.ticks = value,
            _ => panic("tickbench: unknown option {a[i]}"),
        }
        i += 2
    }
    return o
}

fn print_stats(world: World, when: String) {
    var kinds: [usize; 4] = [0, 0, 0, 0]
    for b in world.blocks {
        for c in b.chunks {
            for s in c.sections {
                kinds[usize.wrap(s.kind)] += 1
            }
        }
    }
    var scheduled: usize = 0
    for st in world.states {
        scheduled += st.scheduled.size
    }
    eprintln("{when}: sections single {kinds[0]} linear {kinds[1]} hash {kinds[2]} global {kinds[3]}; scheduled ticks {scheduled}")
}

fn final_checksum(world: World, checksum: mut Fnv) {
    for cx in 0..WORLD_CHUNKS {
        for cz in 0..WORLD_CHUNKS {
            let at = world.chunk_map.get(chunk_key(cx, cz))!
            for section in world.blocks[at.r].chunks[at.c].sections {
                for i in 0usize..SECTION_SIZE {
                    checksum.feed(u64(section.get(i)))
                }
            }
        }
    }
    // Each entity in id order, which is where it goes in this list.
    let missing = Entity { id: 0xFFFFFFFF, x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 }
    var by_id: List<Entity> = [missing; ENTITIES]
    var count: usize = 0
    for st in world.states {
        for e in st.entities {
            by_id[usize(e.id)] = e
            count += 1
        }
    }
    if count != ENTITIES {
        panic("tickbench: an entity was lost or duplicated")
    }
    for e in by_id {
        if e.id == 0xFFFFFFFF {
            panic("tickbench: an entity was lost or duplicated")
        }
        checksum.feed(e.x.to_bits())
        checksum.feed(e.y.to_bits())
        checksum.feed(e.z.to_bits())
    }
}

fn sort(xs: mut List<u64>) {
    for i in 1usize..xs.len() {
        let x = xs[i]
        var j = i
        while j > 0 and xs[j - 1] > x {
            xs[j] = xs[j - 1]
            j -= 1
        }
        xs[j] = x
    }
}

fn hex16(v: u64) -> String {
    let digits = "0123456789abcdef"
    var bytes = List<u8>()
    for k in 0..16 {
        bytes.push(digits.byte_at(usize.wrap((v >> ((15 - k) * 4)) & 15)))
    }
    return String.from_utf8(bytes)!
}

/// `x`, which isn't negative, with 3 decimals.
fn fixed3(x: f64) -> String {
    let n = i64.saturate((x * 1000.0 + 0.5).floor())
    let frac = n % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    return "{n / 1000}.{pad}{frac}"
}

fn main() {
    let o = parse_args()
    if o.threads > 1 {
        panic("tickbench: more than one worker isn't built yet")
    }
    let started = unsafe { Instant.now() }
    var world = generate()
    let generated = unsafe { Instant.now() }.secs_since(started)
    if o.stats {
        print_stats(world, "generated")
    }

    let total = o.warmup + o.ticks
    var times = List<u64>()
    times.reserve(o.ticks)
    var checksum = Fnv {}
    for tick in 0usize..total {
        if o.stats and tick == o.warmup {
            print_stats(world, "after warmup")
        }
        let t0 = unsafe { Instant.now() }
        let t = i32.wrap(tick)
        for k in 0usize..REGIONS {
            block_pass(mut world.blocks[k], mut world.states[k], t)
        }
        for k in 0usize..REGIONS {
            entity_pass(world.blocks, world.chunk_map, k, mut world.states[k])
        }
        barrier(mut world, mut checksum)
        if tick >= o.warmup {
            times.push(unsafe { Instant.now() }.nanos_since(t0))
        }
    }
    if o.stats {
        print_stats(world, "end")
    }
    final_checksum(world, mut checksum)

    var sum: u64 = 0
    for t in times {
        sum += t
    }
    let mean = f64.nearest(sum) / f64.nearest(times.len().max(1))
    sort(mut times)
    let rank = (times.len() * 99 + 99) / 100
    let p99 = if rank == 0 { 0u64 } else { times[rank - 1] }
    let total_s = unsafe { Instant.now() }.secs_since(started)
    println("\{\"impl\": \"calx\", \"threads\": {o.threads}, \"warmup\": {o.warmup}, \"ticks\": {o.ticks}, \"checksum\": \"{hex16(checksum.h)}\", \"mean_tick_us\": {fixed3(mean / 1000.0)}, \"p99_tick_us\": {fixed3(f64.nearest(p99) / 1000.0)}, \"generate_s\": {fixed3(generated)}, \"total_s\": {fixed3(total_s)}\}")
}
