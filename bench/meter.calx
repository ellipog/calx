// Runs a program and writes down what it used, for bench/suite.calx on Linux.
//
//     meter <report> <program> <args>...
//
// On Linux a child's peak resident set, wait4's `ru_maxrss`, starts at the peak of the process
// that started it: posix_spawn's child runs in its parent's memory until it execs, and the kernel
// keeps that memory's peak as the child's. The suite holds inputs and outputs of many megabytes,
// so every program would have its peak at least. It starts each through this small program
// instead, whose own peak is a megabyte or two.
//
// The program reads and writes this one's input and output. The report is one line: its wall
// time and CPU time in nanoseconds and its peak memory in bytes. If the program fails, this exits
// with status 1.
import std.env.{args}
import std.fs
import std.process
import std.process.{Command}
import std.time.{Instant}

fn main() {
    let given = args()
    if given.len() < 2 {
        eprintln("usage: meter <report> <program> <args>...")
        process.exit(2)
    }
    var rest: List<String> = []
    for k in 2usize..given.len() {
        rest.push(given[k].copy())
    }
    let t0 = unsafe { Instant.now() }
    let status = Command.new(given[1].copy()).args(rest).status()!
    let wall = unsafe { Instant.now() }.nanos_since(t0)
    let used = unsafe { status.usage() }
    fs.write_text(given[0].copy(), "{wall} {used.cpu_ns} {used.peak_memory}\n")!
    if not status.success() {
        process.exit(1)
    }
}
