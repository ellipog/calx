// regex-redux: the Benchmarks Game's regular-expression test. fasta's output has its headers and
// line breaks taken out by one pattern, nine variants of a motif counted, and five patterns
// replaced in turn, with the lengths printed. Each language uses its standard regex library, or
// Rust's regex crate; C has none.
import std.env.{args}
import std.fs
import std.regex.{Regex}

const VARIANTS: [str; 9] = ["agggtaaa|tttaccct", "[cgt]gggtaaa|tttaccc[acg]", "a[act]ggtaaa|tttacc[agt]t", "ag[act]gtaaa|tttac[agt]ct", "agg[act]taaa|ttta[agt]cct", "aggg[acg]aaa|ttt[cgt]ccct", "agggt[cgt]aa|tt[acg]accct", "agggta[cgt]a|t[acg]taccct", "agggtaa[cgt]|[acg]ttaccct"]

fn main() {
    let input = fs.read_text(args()[0].copy())! ?? String()
    var headers = Regex.new(">.*\n|\n")!
    let seq = headers.replace_all(input, "")
    for v in VARIANTS {
        var re = Regex.new(v)!
        println("{v} {re.count(seq)}")
    }
    var text = seq.copy()
    for (pattern, with) in [("tHa[Nt]", "<4>"), ("aND|caN|Ha[DS]|WaS", "<3>"), ("a[NSt]|BY", "<2>"), ("<[^>]*>", "|"), (#"\|[^|][^|]*\|"#, "-")] {
        var re = Regex.new(pattern)!
        text = re.replace_all(text, with)
    }
    println("\n{input.len()}\n{seq.len()}\n{text.len()}")
}
