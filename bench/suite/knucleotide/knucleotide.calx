// k-nucleotide: the Benchmarks Game's hash-table test. The third sequence of fasta's output is read,
// every k-mer of it counted for each k, and the 1- and 2-mers' frequencies and five longer k-mers'
// counts printed. Each k-mer is the key, two bits a base in a 64-bit integer, of the language's
// own hash map.
import std.env.{args}
import std.fs

fn code(b: u8) -> u64 {
    return if b == b'A' { 0 } else if b == b'C' { 1 } else if b == b'G' { 2 } else { 3 }
}

fn count(seq: List<u8>, k: usize) -> Map<u64, i32> {
    var counts = Map<u64, i32>()
    let mask = (1u64 << u64(2 * k)) - 1
    var key: u64 = 0
    for i in 0usize..k - 1 {
        key = (key << 2) | code(seq[i])
    }
    for i in k - 1..seq.len() {
        key = ((key << 2) | code(seq[i])) & mask
        if let c = mut counts.find(key) {
            c += 1
        } else {
            counts.insert(key, 1)
        }
    }
    return counts
}

fn decode(key: u64, k: usize) -> String {
    var s = String()
    for i in 0usize..k {
        let c = (key >> u64(2 * (k - 1 - i))) & 3
        s.push(if c == 0 { 'A' } else if c == 1 { 'C' } else if c == 2 { 'G' } else { 'T' })
    }
    return s
}

fn frequencies(seq: List<u8>, k: usize) {
    let counts = count(seq, k)
    var entries: List<(u64, i32)> = []
    for (key, n) in counts {
        entries.push((key, n))
    }
    entries.sort_by(|a, b| if a.1 != b.1 { b.1.cmp(a.1) } else { a.0.cmp(b.0) })
    let total = f64.nearest(seq.len() - k + 1)
    for (key, n) in entries {
        println("{decode(key, k)} {100.0 * f64(n) / total:.3}")
    }
    println("")
}

fn occurrences(seq: List<u8>, kmer: str) {
    let k = kmer.len()
    let counts = count(seq, k)
    var key: u64 = 0
    for b in kmer.to_bytes() {
        key = (key << 2) | code(b)
    }
    println("{counts.get(key) ?? 0}\t{kmer}")
}

fn main() {
    let text = fs.read_text(args()[0].copy())! ?? String()
    var seq: List<u8> = []
    var inside = false
    for line in text.lines() {
        if line.starts_with(">") {
            if inside {
                break
            }
            inside = line.starts_with(">THREE")
        } else if inside {
            for b in line.to_upper_root().to_bytes() {
                seq.push(b)
            }
        }
    }
    frequencies(seq, 1)
    frequencies(seq, 2)
    for kmer in ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"] {
        occurrences(seq, kmer)
    }
}
