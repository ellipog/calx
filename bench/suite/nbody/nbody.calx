// n-body: the Benchmarks Game's model of the Jovian planets, advanced n steps of 0.01 with plain
// doubles, printing the system's energy before and after. Every version in this folder does the
// same arithmetic in the same order.
import std.env.{args}

const PI: f64 = 3.141592653589793
const SOLAR_MASS: f64 = 4.0 * PI * PI
const DAYS_PER_YEAR: f64 = 365.24

struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
}

fn planet(x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, mass: f64) -> Body {
    return Body { x: x, y: y, z: z, vx: vx * DAYS_PER_YEAR, vy: vy * DAYS_PER_YEAR, vz: vz * DAYS_PER_YEAR, mass: mass * SOLAR_MASS }
}

fn advance(bodies: mut List<Body>, dt: f64) {
    let n = bodies.len()
    for i in 0usize..n {
        for j in i + 1..n {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            let mi = bodies[i].mass * mag
            let mj = bodies[j].mass * mag
            bodies[i].vx -= dx * mj
            bodies[i].vy -= dy * mj
            bodies[i].vz -= dz * mj
            bodies[j].vx += dx * mi
            bodies[j].vy += dy * mi
            bodies[j].vz += dz * mi
        }
    }
    for b in mut bodies {
        b.x += dt * b.vx
        b.y += dt * b.vy
        b.z += dt * b.vz
    }
}

fn energy(bodies: List<Body>) -> f64 {
    var e = 0.0
    let n = bodies.len()
    for i in 0usize..n {
        let b = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..n {
            let dx = b.x - bodies[j].x
            let dy = b.y - bodies[j].y
            let dz = b.z - bodies[j].z
            e -= b.mass * bodies[j].mass / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    return e
}

fn offset_momentum(bodies: mut List<Body>) {
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for b in bodies {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    bodies[0].vx = -px / SOLAR_MASS
    bodies[0].vy = -py / SOLAR_MASS
    bodies[0].vz = -pz / SOLAR_MASS
}

fn main() {
    let a = args()
    let n = if a.len() > 0 { i32.parse(a[0].copy()) ?? 1000 } else { 1000 }
    var bodies: List<Body> = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS },
        planet(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04),
        planet(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04),
        planet(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05),
        planet(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05),
    ]
    offset_momentum(mut bodies)
    println("{energy(bodies):.9}")
    for _ in 0..n {
        advance(mut bodies, 0.01)
    }
    println("{energy(bodies):.9}")
}
