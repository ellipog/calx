// Building and taking apart text: a million CSV-like lines built onto one string with formatting,
// then each line split at its commas, a field uppercased and three joined with " | " onto a second
// string, the lines that name one user counted, and a word replaced through the whole result.
import std.env.{args}

fn main() {
    let n = i64.parse(args()[0].copy()) ?? 1000000
    let words = ["alpha", "beta", "gamma", "delta", "epsilon"]
    var built = String()
    for i in 0i64..n {
        built.push_str("{i},user{i % 1000},{i * 7 % 10007}.{i % 100:02},{words[usize.wrap(i % 5)]}\n")
    }
    var out = String()
    var matches = 0
    for line in built.lines() {
        let fields = line.split(",")
        out.push_str(fields[3].to_upper_root())
        out.push_str(" | ")
        out.push_str(fields[1])
        out.push_str(" | ")
        out.push_str(fields[2])
        out.push('\n')
        if fields[1] == "user42" {
            matches += 1
        }
    }
    let replaced = out.replace("user", "u")
    println("built {built.len()}\nout {out.len()}\nmatches {matches}\nreplaced {replaced.len()}")
}
