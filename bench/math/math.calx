fn time_acos(xs: List<f64>) {
    var best = 1.0e30
    var sum = 0.0
    for _ in 0..7 {
        let t0 = unsafe { Instant.now() }
        var acc = 0.0
        for x in xs {
            acc += acos(x)
        }
        acc = black_box(acc)
        let t = unsafe { Instant.now() }.secs_since(t0)
        best = best.min(t)
        sum = acc
    }
    report("acos", best, xs.len(), sum)
}

fn main() {
    let n = 2000000usize
    time_exp(inputs(2, n, -20.0, 20.0))
    time_log(inputs(3, n, 0.0, 1000.0))
    time_pow(inputs(4, n, 0.0, 10.0), inputs(5, n, -5.0, 5.0))
    let trig = inputs(1, n, -10.0, 10.0)
    time_sin(trig.copy())
    time_cos(trig.copy())
    time_tan(trig)
    time_atan2(inputs(6, n, -1.0, 1.0), inputs(7, n, -1.0, 1.0))
    time_acos(inputs(6, n, -1.0, 1.0))
}
