// std.math against the C library on the same inputs: bench/math/libm.c is the same loops in C.
// The Windows CRT and glibc are what Rust's f64 methods call.
// Release builds inline std.math into each loop (D99), so clang could move a loop with no side
// effects past the second reading of the clock; `black_box` makes it finish before that.
import std.math.{acos, atan2, cos, exp, log, pow, sin, tan}
import std.hint.{black_box}
import std.time.{Instant}

fn inputs(seed: u64, n: usize, lo: f64, hi: f64) -> List<f64> {
    var s = seed
    var xs = List<f64>()
    for _ in 0usize..n {
        s = s * 6364136223846793005 + 1442695040888963407
        xs.push(lo + (hi - lo) * (f64.nearest(s >> 11) * 1.1102230246251565e-16))
    }
    return xs
}

fn report(name: str, best: f64, n: usize, sum: f64) {
    println("{name}: {best * 1.0e9 / f64.nearest(n)} ns/call (sum {sum})")
}

fn time_exp(xs: List<f64>) {
    var best = 1.0e30
    var sum = 0.0
    for _ in 0..7 {
        let t0 = unsafe { Instant.now() }
        var acc = 0.0
        for x in xs {
            acc += exp(x)
        }
        acc = black_box(acc)
        let t = unsafe { Instant.now() }.secs_since(t0)
        best = best.min(t)
        sum = acc
    }
    report("exp", best, xs.len(), sum)
}

fn time_log(xs: List<f64>) {
    var best = 1.0e30
    var sum = 0.0
    for _ in 0..7 {
        let t0 = unsafe { Instant.now() }
        var acc = 0.0
        for x in xs {
            acc += log(x)
        }
        acc = black_box(acc)
        let t = unsafe { Instant.now() }.secs_since(t0)
        best = best.min(t)
        sum = acc
    }
    report("log", best, xs.len(), sum)
}

fn time_pow(xs: List<f64>, ys: List<f64>) {
    var best = 1.0e30
    var sum = 0.0
    for _ in 0..7 {
        let t0 = unsafe { Instant.now() }
        var acc = 0.0
        for i in 0usize..xs.len() {
            acc += pow(xs[i], ys[i])
        }
        acc = black_box(acc)
        let t = unsafe { Instant.now() }.secs_since(t0)
        best = best.min(t)
        sum = acc
    }
    report("pow", best, xs.len(), sum)
}

