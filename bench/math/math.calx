fn time_atan2(xs: List<f64>, ys: List<f64>) {
    var best = 1.0e30
    var sum = 0.0
    for _ in 0..7 {
        let t0 = unsafe { Instant.now() }
        var acc = 0.0
        for i in 0usize..xs.len() {
            acc += atan2(xs[i], ys[i])
        }
        acc = black_box(acc)
        let t = unsafe { Instant.now() }.secs_since(t0)
        best = best.min(t)
        sum = acc
