{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Calx",
  "scopeName": "source.calx",
  "fileTypes": ["calx"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#attributes" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#calls" },
        { "include": "#names" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "comment": "Three slashes make a doc comment; four or more make an ordinary one.",
          "name": "comment.line.documentation.calx",
          "begin": "///(?!/)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.calx" } },
          "end": "$",
          "patterns": [{ "name": "markup.inline.raw.calx", "match": "`[^`]*`" }]
        },
        {
          "name": "comment.line.double-slash.calx",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.calx" } },
          "end": "$"
        }
      ]
    },
    "attributes": {
      "comment": "`@packet`, `@command(...)`, `@std.inline`",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.calx" },
        "2": { "name": "entity.name.function.decorator.calx" }
      }
    },
    "strings": {
      "comment": "A string ends at its line's end, as in the lexer. `t\"...\"` has a prefix.",
      "name": "string.quoted.double.calx",
      "begin": "(?:\\b([A-Za-z_][A-Za-z0-9_]*))?(\")",
      "beginCaptures": {
        "1": { "name": "storage.type.string.calx" },
        "2": { "name": "punctuation.definition.string.begin.calx" }
      },
      "end": "(\")|$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.calx" } },
      "patterns": [
        { "include": "#escapes" },
        {
          "name": "meta.interpolation.calx",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.calx" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.calx" } },
          "contentName": "source.calx",
          "patterns": [{ "include": "#interpolation" }]
        },
        { "name": "invalid.illegal.brace.calx", "match": "\\}" }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "comment": "Braces nested in an interpolated expression.",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.calx" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.braces.end.calx" } },
          "patterns": [{ "include": "#interpolation" }]
        },
        { "include": "#code" }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.calx", "match": "\\\\(?:[ntr0\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,6}\\})" },
        { "name": "invalid.illegal.escape.calx", "match": "\\\\." }
      ]
    },
    "chars": {
      "name": "string.quoted.single.calx",
      "match": "(')(?:[^'\\\\\\n]|(\\\\(?:[ntr0\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,6}\\})))(')",
      "captures": {
        "1": { "name": "punctuation.definition.char.begin.calx" },
        "2": { "name": "constant.character.escape.calx" },
        "3": { "name": "punctuation.definition.char.end.calx" }
      }
    },
    "numbers": {
      "comment": "A suffix such as `u8` or `f32` gives the literal its type. A fraction needs a digit after the dot, so `0..3` is a range.",
      "match": "\\b(0[xX][0-9A-Fa-f_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?)([A-Za-z_][A-Za-z0-9_]*)?",
      "captures": {
        "1": { "name": "constant.numeric.calx" },
        "2": { "name": "storage.type.numeric.calx" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.calx" },
            "2": { "name": "entity.name.function.calx" }
          }
        },
        {
          "match": "\\b(struct|enum|interface|actor|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.calx" },
            "2": { "name": "entity.name.type.calx" }
          }
        },
        {
          "match": "\\b(module|import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.other.$1.calx" },
            "2": { "name": "entity.name.namespace.calx" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.calx",
          "match": "\\b(?:if|else|match|while|for|in|loop|break|continue|return|try|fail|send|checkout|parallel)\\b"
        },
        { "name": "storage.type.calx", "match": "\\b(?:fn|struct|enum|interface|actor|type|impl|let|var|const)\\b" },
        { "name": "keyword.other.calx", "match": "\\b(?:module|import)\\b" },
        { "name": "storage.modifier.calx", "match": "\\b(?:pub|mut|own|dyn|unsafe|extern)\\b" },
        { "name": "keyword.operator.wordlike.calx", "match": "\\b(?:and|or|not)\\b" },
        { "name": "constant.language.boolean.calx", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.none.calx", "match": "\\bnone\\b" },
        { "name": "variable.language.self.calx", "match": "\\b(?:self|Self)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.calx",
          "match": "\\b(?:print|println|panic|assert|some|ok|err)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.calx",
          "match": "\\b(?:bool|i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|char|rune|str)\\b"
        },
        {
          "comment": "Names in capitals and digits are constants, such as `MAX` and `CHUNK_SIZE`.",
          "name": "variable.other.constant.calx",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b|\\b[A-Z][A-Z0-9]*_[A-Z0-9_]*\\b"
        },
        {
          "comment": "Other capitalized names are types and enum variants.",
          "name": "entity.name.type.calx",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.calx" } }
    },
    "names": {
      "name": "variable.other.calx",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.calx", "match": "->|=>" },
        { "name": "keyword.operator.range.calx", "match": "\\.\\.=?" },
        { "name": "keyword.operator.optional.calx", "match": "\\?\\?|\\?\\." },
        { "name": "keyword.operator.assignment.compound.calx", "match": ">>>=|<<=|>>=|[-+*/%&|^]=" },
        { "name": "keyword.operator.comparison.calx", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.bitwise.shift.calx", "match": ">>>|<<|>>" },
        { "name": "keyword.operator.comparison.calx", "match": "[<>]" },
        { "name": "keyword.operator.assignment.calx", "match": "=" },
        { "name": "keyword.operator.arithmetic.calx", "match": "[-+*/%]" },
        { "name": "keyword.operator.bitwise.calx", "match": "[&|^~]" },
        { "name": "keyword.operator.unwrap.calx", "match": "!" },
        { "name": "keyword.operator.optional.calx", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.calx", "match": "," },
        { "name": "punctuation.terminator.statement.calx", "match": ";" },
        { "name": "punctuation.separator.colon.calx", "match": ":" },
        { "name": "punctuation.accessor.dot.calx", "match": "\\." }
      ]
    }
  }
}
