// Packages the VS Code extension as a .vsix, without needing vsce or npm.
//
//     calx run tools/vscode/package.calx                 # writes build/vscode/calx-<version>.vsix
//     calx run tools/vscode/package.calx -- --install    # and installs it with `code --install-extension`
//
// A .vsix is a zip holding the extension under `extension/`, a manifest, and a content-types file.
// The icons come from assets/logo, so they aren't copied into this folder.
import std.cli.{cli}
import std.env
import std.fs
import std.json
import std.json.{Json}
import std.path
import std.process
import std.process.{Command, which}
import std.zip.{Writer}

/// Packages the VS Code extension as a .vsix, without needing vsce or npm.
@cli(name: "tools/vscode/package.calx")
struct Args {
    /// Install it into VS Code afterwards.
    install: bool
    /// Where to write the .vsix; build/vscode/<name>-<version>.vsix if not given.
    @short("o")
    output: String?
}

const CONTENT_TYPES: str = #"
    <?xml version="1.0" encoding="utf-8"?>
    <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
    <Default Extension=".json" ContentType="application/json"/>
    <Default Extension=".js" ContentType="application/javascript"/>
    <Default Extension=".md" ContentType="text/markdown"/>
    <Default Extension=".txt" ContentType="text/plain"/>
    <Default Extension=".png" ContentType="image/png"/>
    <Default Extension=".svg" ContentType="image/svg+xml"/>
    <Default Extension=".vsixmanifest" ContentType="text/xml"/>
    </Types>
    "#

fn stop(why: String) {
    eprintln("package: {why}")
    process.exit(1)
}

// Text with XML's `&`, `<` and `>` escaped, for an element or an attribute in double quotes.
fn escape(s: String) -> String {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// A field of package.json as escaped text, which must be there.
fn field(pkg: Json, name: String) -> String {
    match pkg.get(name.copy()) {
        some(v) => {
            if let s = v.as_str() {
                return escape(s)
            }
        },
        none => {},
    }
    stop("package.json has no `{name}`")
    return String()
}

fn manifest(pkg: Json) -> String {
    var categories: List<String> = []
    if let Json.Array(cs) = pkg.get("categories") ?? Json.Null {
        for c in cs {
            categories.push(c.as_str() ?? String())
        }
    }
    let engine = field(pkg.get("engines") ?? Json.Null, "vscode")
    let source = field(pkg.get("repository") ?? Json.Null, "url")
    return #"
        <?xml version="1.0" encoding="utf-8"?>
        <PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
          <Metadata>
            <Identity Language="en-US" Id="#{field(pkg, "name")}" Version="#{field(pkg, "version")}" Publisher="#{field(pkg, "publisher")}"/>
            <DisplayName>#{field(pkg, "displayName")}</DisplayName>
            <Description xml:space="preserve">#{field(pkg, "description")}</Description>
            <Tags>calx</Tags>
            <Categories>#{escape(categories.join(","))}</Categories>
            <GalleryFlags>Public</GalleryFlags>
            <Properties>
              <Property Id="Microsoft.VisualStudio.Code.Engine" Value="#{engine}"/>
              <Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value=""/>
              <Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value=""/>
              <Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace"/>
              <Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value=""/>
              <Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="#{source}"/>
            </Properties>
            <License>extension/LICENSE.txt</License>
            <Icon>extension/images/icon.png</Icon>
          </Metadata>
          <Installation>
            <InstallationTarget Id="Microsoft.VisualStudio.Code"/>
          </Installation>
          <Dependencies/>
          <Assets>
            <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/>
            <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true"/>
            <Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="extension/LICENSE.txt" Addressable="true"/>
            <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/images/icon.png" Addressable="true"/>
          </Assets>
        </PackageManifest>
        "#
}

fn main() {
    let a = Args.parse()
    let script = env.script() ?? String()
    let here = (path.parent_dir(script) ?? String(".")).replace("\\", "/")
    let root = path.parent_dir(path.parent_dir(here.copy()) ?? String()) ?? String(".")
    let logo = "{root}/assets/logo"
    // What goes in the package, as (path in the package, file on disk).
    let files: List<(String, String)> = [
        ("package.json", "{here}/package.json"),
        ("extension.js", "{here}/extension.js"),
        ("compiler.js", "{here}/compiler.js"),
        ("language-configuration.json", "{here}/language-configuration.json"),
        ("syntaxes/calx.tmLanguage.json", "{here}/syntaxes/calx.tmLanguage.json"),
        ("syntaxes/calx.markdown.tmLanguage.json", "{here}/syntaxes/calx.markdown.tmLanguage.json"),
        ("README.md", "{here}/README.md"),
        ("LICENSE.txt", "{root}/LICENSE"),
        ("images/icon.png", "{logo}/calx-avatar-512.png"),
        ("images/calx-mark.svg", "{logo}/calx-mark.svg"),
        ("images/calx-mark-white.svg", "{logo}/calx-mark-white.svg"),
    ]

    let pkg = match json.parse(fs.read_text("{here}/package.json")! ?? String()) {
        ok(v) => v,
        err(e) => {
            stop("package.json isn't JSON: {e}")
            Json.Null
        },
    }
    let out = a.output ?? "{root}/build/vscode/{field(pkg, "name")}-{field(pkg, "version")}.vsix"
    if let dir = path.parent_dir(out.copy()) {
        fs.make_dir_all(dir)!
    }
    var z = Writer.new()
    z.add("[Content_Types].xml", "{CONTENT_TYPES}\n".to_bytes())
    z.add("extension.vsixmanifest", "{manifest(pkg)}\n".to_bytes())
    for f in files {
        match fs.read(f.1.copy()) {
            ok(bytes) => z.add("extension/{f.0}", bytes),
            err(e) => stop("can't read {f.1}: {e}"),
        }
    }
    fs.write(out.copy(), z.finish())!
    println(out)

    if a.install {
        let code = which("code") ?? which("code.cmd") ?? String()
        if code.is_empty() {
            stop("can't find VS Code's `code` command on PATH; install the .vsix from the Extensions view instead")
        }
        match Command.new(code).args(["--install-extension", out, "--force"]).status() {
            ok(s) => {
                if not s.success() {
                    stop("code --install-extension failed: {s}")
                }
            },
            err(e) => stop("can't run code: {e}"),
        }
    }
}
