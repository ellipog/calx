// Writes the tables in runtime/calx_case.c from what Java does to each code point.
//
// Usage, from anywhere, with Java 25:
//
//     java tools/unicode/CaseDump.java build/cases.txt
//     calx run tools/unicode/gen_case.calx -- build/cases.txt
//
// CaseDump.java writes, for each code point, what String.toLowerCase and toUpperCase give with
// Locale.ROOT, how Java's word BreakIterator treats it, and whether it's cased, which is what Java
// decides a capital sigma's lowercase by. This packs that into a two-stage table: the code
// point's block, then its kind, which holds the two case deltas, the word class and flags. The
// mapping is the Unicode Character Database's, as Java 25 has it (Unicode 16).
import std.env
import std.fs
import std.path
import std.process

const CASED: u32 = 1
const UP_MANY: u32 = 2
const LOW_MANY: u32 = 4
const SIGMA: u32 = 8
// Past this, only plane 14 has anything, which `kind_of` tests by range.
const DENSE: u32 = 0x40000
const BEGIN: str = "/* --- generated by tools/unicode/gen_case.calx; don't edit by hand --- */\n"
const END: str = "/* --- end of the generated tables --- */\n"

fn classes() -> List<String> {
    return ["O", "L", "D", "MW", "MWN", "MN", "POST", "WS", "CR", "LS", "X", "XF", "K", "H", "KA", "DANDA"]
}

// The tables are the Unicode Character Database's case mappings and word classes, as Java has them.
fn notice() -> String {
    let text = #"
    /* The case mappings and the classes below are from the Unicode Character Database, under this notice:
     *
     * UNICODE LICENSE V3
     *
     * COPYRIGHT AND PERMISSION NOTICE
     *
     * Copyright (c) 1991-2024 Unicode, Inc.
     *
     * NOTICE TO USER: Carefully read the following legal agreement. BY DOWNLOADING, INSTALLING,
     * COPYING OR OTHERWISE USING DATA FILES, AND/OR SOFTWARE, YOU UNEQUIVOCALLY ACCEPT, AND AGREE TO BE
     * BOUND BY, ALL OF THE TERMS AND CONDITIONS OF THIS AGREEMENT. IF YOU DO NOT AGREE, DO NOT
     * DOWNLOAD, INSTALL, COPY, DISTRIBUTE OR USE THE DATA FILES OR SOFTWARE.
     *
     * Permission is hereby granted, free of charge, to any person obtaining a copy of data files and
     * any associated documentation (the "Data Files") or software and any associated documentation
     * (the "Software") to deal in the Data Files or Software without restriction, including without
     * limitation the rights to use, copy, modify, merge, publish, distribute, and/or sell copies of
     * the Data Files or Software, and to permit persons to whom the Data Files or Software are
     * furnished to do so, provided that either (a) this copyright and permission notice appear with
     * all copies of the Data Files or Software, or (b) this copyright and permission notice appear in
     * associated Documentation.
     *
     * THE DATA FILES AND SOFTWARE ARE PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
     * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A
     * PARTICULAR PURPOSE AND NONINFRINGEMENT OF THIRD PARTY RIGHTS. IN NO EVENT SHALL THE COPYRIGHT
     * HOLDER OR HOLDERS INCLUDED IN THIS NOTICE BE LIABLE FOR ANY CLAIM, OR ANY SPECIAL INDIRECT OR
     * CONSEQUENTIAL DAMAGES, OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
     * WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
     * CONNECTION WITH THE USE OR PERFORMANCE OF THE DATA FILES OR SOFTWARE.
     *
     * Except as contained in this notice, the name of a copyright holder shall not be used in
     * advertising or otherwise to promote the sale, use or other dealings in these Data Files or
     * Software without prior written authorization of the copyright holder. */
    "#
    return "{text}\n"
}

struct Row {
    cp: u32
    lower: List<u32>
    upper: List<u32>
    class: usize
    cased: bool
}

fn hex_list(s: String, cp: u32) -> List<u32> {
    if s == "same" {
        return [cp]
    }
    var out: List<u32> = []
    for x in s.split(",") {
        out.push(u32.parse_radix(x, 16) ?? panic("{x} isn't hex"))
    }
    return out
}

// What a code point's kind is: its case deltas, its word class and its flags.
fn kind_of(r: Row) -> (i64, i64, usize, u32) {
    var flags = if r.cased { CASED } else { 0 }
    var lower: i64 = 0
    var upper: i64 = 0
    if r.lower.len() == 1 {
        lower = i64(r.lower[0]) - i64(r.cp)
    } else {
        flags |= LOW_MANY
    }
    if r.upper.len() == 1 {
        upper = i64(r.upper[0]) - i64(r.cp)
    } else {
        flags |= UP_MANY
    }
    if r.cp == 0x3A3 {
        flags |= SIGMA
    }
    return (lower, upper, r.class, flags)
}

fn hex(n: u32) -> String {
    let digits = "0123456789ABCDEF"
    if n == 0 {
        return String("0")
    }
    var out = List<u8>()
    var v = n
    while v > 0 {
        out.push(digits.byte_at(usize(v % 16)))
        v /= 16
    }
    out.reverse()
    return String.from_utf8(out) ?? String()
}

fn array(ctype: str, name: str, values: List<usize>, per_line: usize) -> String {
    var s = "static const {ctype} {name}[{values.len()}] = \{\n"
    var i: usize = 0
    while i < values.len() {
        let end = (i + per_line).min(values.len())
        var parts: List<String> = []
        for k in i..end {
            parts.push("{values[k]}")
        }
        s.push_str("    {parts.join(", ")},\n")
        i = end
    }
    s.push_str("\};\n")
    return s
}

fn main() {
    let args = env.args()
    if args.len() != 1 {
        eprintln("usage: calx run tools/unicode/gen_case.calx -- CASES.txt, which tools/unicode/CaseDump.java writes")
        process.exit(2)
    }
    let names = classes()
    var java = String()
    var rows: List<Row> = []
    for line in (fs.read_text(args[0].copy())! ?? String()).lines() {
        if line.starts_with("#") {
            java = line[1..].trim()
            continue
        }
        let f = line.split_whitespace()
        let cp = u32.parse_radix(f[0].copy(), 16) ?? panic("{f[0]} isn't hex")
        let class = names.position(|c| c == f[3]) ?? panic("no class {f[3]}")
        rows.push(Row { cp: cp, lower: hex_list(f[1].copy(), cp), upper: hex_list(f[2].copy(), cp), class: class, cased: f[4] == "1" })
    }

    // Lowercase of more than one code point is İ's alone, which the C handles by itself.
    for r in rows {
        if r.lower.len() != 1 and not (r.cp == 0x130 and r.lower == [0x69, 0x307]) {
            panic("{hex(r.cp)} lowercases to {r.lower.len()} code points")
        }
    }
    var up_many: List<(u32, List<u32>)> = []
    for r in rows {
        if r.upper.len() != 1 {
            if r.upper.len() > 3 {
                panic("{hex(r.cp)} uppercases to more than 3")
            }
            up_many.push((r.cp, r.upper.copy()))
        }
    }
    up_many.sort()
    // Past DENSE, only marks and format characters, with no case: tested by range in C.
    var far: List<(u32, usize)> = []
    for r in rows {
        if r.cp >= DENSE {
            let n = names[r.class].copy()
            if r.lower != [r.cp] or r.upper != [r.cp] or r.cased or (n != "X" and n != "XF") {
                panic("{hex(r.cp)} is past the dense part with a case or a class")
            }
            far.push((r.cp, r.class))
        }
    }
    far.sort()
    var far_ranges: List<(u32, u32, usize)> = []
    for f in far {
        let n = far_ranges.len()
        if n > 0 and far_ranges[n - 1].1 == f.0 - 1 and far_ranges[n - 1].2 == f.1 {
            far_ranges[n - 1].1 = f.0
        } else {
            far_ranges.push((f.0, f.0, f.1))
        }
    }

    var kinds: List<(i64, i64, usize, u32)> = [(0, 0, 0, 0)]
    var index = Map<(i64, i64, usize, u32), usize>()
    index.insert((0, 0, 0, 0), 0)
    var per_cp: List<usize> = [0; usize(DENSE)]
    for r in rows {
        if r.cp >= DENSE {
            continue
        }
        let k = kind_of(r)
        if not index.contains(k) {
            index.insert(k, kinds.len())
            kinds.push(k)
        }
        per_cp[usize(r.cp)] = index.get(k) ?? 0
    }
    if kinds.len() > 256 {
        panic("{kinds.len()} kinds don't fit a byte")
    }

    // The block size that makes the two stages smallest.
    var best_total: usize = 0
    var shift: u32 = 0
    var stage1: List<usize> = []
    var blocks: List<List<usize>> = []
    var s1_bytes: usize = 1
    for sh in 4u32..9 {
        let size = usize(1u32 << sh)
        var bl: List<List<usize>> = []
        var bindex = Map<List<usize>, usize>()
        var s1: List<usize> = []
        for b in 0usize..usize(DENSE >> sh) {
            let block: List<usize> = per_cp[b * size..(b + 1) * size]
            if let at = bindex.get(block) {
                s1.push(at)
            } else {
                bindex.insert(block.copy(), bl.len())
                s1.push(bl.len())
                bl.push(block)
            }
        }
        let bytes: usize = if bl.len() <= 256 { 1 } else { 2 }
        let total = s1.len() * bytes + bl.len() * size
        if shift == 0 or total < best_total {
            best_total = total
            shift = sh
            stage1 = s1
            blocks = bl
            s1_bytes = bytes
        }
    }

    var out = String(BEGIN)
    out.push_str(notice())
    out.push_str("/* From {java}: {rows.len()} code points, {kinds.len()} kinds, blocks of {1u32 << shift}, {best_total + kinds.len() * 12 + up_many.len() * 16} bytes. */\n")
    out.push_str("enum \{ {names.map(|c| "W_{c}").join(", ")} \};\n")
    out.push_str("enum \{ CASED = {CASED}, UP_MANY = {UP_MANY}, LOW_MANY = {LOW_MANY}, SIGMA = {SIGMA} \};\n")
    out.push_str("typedef struct \{ cx_i32 lower, upper; cx_u8 word, flags; \} case_kind;\n")
    out.push_str("static const case_kind kinds[{kinds.len()}] = \{\n")
    var i: usize = 0
    while i < kinds.len() {
        let end = (i + 4).min(kinds.len())
        var parts: List<String> = []
        for k in i..end {
            parts.push("\{{kinds[k].0}, {kinds[k].1}, {kinds[k].2}, {kinds[k].3}\},")
        }
        out.push_str("    {parts.join(" ")}\n")
        i = end
    }
    out.push_str("\};\n")
    out.push_str(array(if s1_bytes == 1 { "cx_u8" } else { "cx_u16" }, "stage1", stage1, 24))
    var flat: List<usize> = []
    for b in blocks {
        flat.extend(b)
    }
    out.push_str(array("cx_u8", "stage2", flat, 32))
    out.push_str("/* Uppercase that's more than one code point, as ß is SS, by code point. */\n")
    out.push_str("static const struct \{ cx_u32 cp, to[3]; \} up_many[{up_many.len()}] = \{\n")
    i = 0
    while i < up_many.len() {
        let end = (i + 3).min(up_many.len())
        var parts: List<String> = []
        for k in i..end {
            var to: List<String> = []
            for j in 0usize..3 {
                to.push("0x{hex(if j < up_many[k].1.len() { up_many[k].1[j] } else { 0 })}")
            }
            parts.push("\{0x{hex(up_many[k].0)}, \{{to.join(", ")}\}\},")
        }
        out.push_str("    {parts.join(" ")}\n")
        i = end
    }
    out.push_str("\};\n")
    out.push_str("static inline const case_kind* kind_of(cx_u32 cp) \{\n")
    out.push_str("    if (__builtin_expect(cp < 0x{hex(DENSE)}, 1)) return &kinds[stage2[(cx_u32)stage1[cp >> {shift}] << {shift} | (cp & {(1u32 << shift) - 1})]];\n")
    for r in far_ranges {
        let k = (0i64, 0i64, r.2, 0u32)
        let at = index.get(k) ?? panic("no kind for class {names[r.2]} far out")
        let cond = if r.0 == r.1 { "cp == 0x{hex(r.0)}" } else { "cp >= 0x{hex(r.0)} && cp <= 0x{hex(r.1)}" }
        out.push_str("    if ({cond}) return &kinds[{at}];\n")
    }
    out.push_str("    return &kinds[0];\n\}\n")
    out.push_str(END)

    let here = path.parent_dir(env.script() ?? panic("run this with `calx run`")) ?? String()
    let root = path.parent_dir(path.parent_dir(here) ?? String()) ?? String()
    let file = "{root}/runtime/calx_case.c"
    let text = fs.read_text(file.copy())! ?? String()
    let a = text.find(BEGIN) ?? panic("{file} has no generated tables")
    let b = (text.find(END) ?? panic("{file} has no end to its tables")) + END.len()
    fs.write_text(file, "{text[..a]}{out}{text[b..]}")!
    println("{kinds.len()} kinds, blocks of {1u32 << shift}, {blocks.len()} blocks, {best_total} bytes of stages")
}
