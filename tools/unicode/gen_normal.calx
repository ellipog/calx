// Writes std/text/normal.calx, the tables std.unicode normalizes text with, from the Unicode
// Character Database's own files, which it downloads from unicode.org into build/ucd/<version> the
// first time, and reads from there after.
//
//     calx run tools/unicode/gen_normal.calx
//
// The tables are Unicode 16's, as Python 3.14's unicodedata has it. For each rune: its canonical
// combining class; its full canonical and compatibility decompositions, each applied again to what
// it gives until nothing decomposes further; and its quick checks, whether it can be in text in
// each form, from DerivedNormalizationProps.txt. For each block of runes, the forms in which every
// rune of it passes the quick check, so text in them is passed over a block lookup at a time. Then
// the pairs that compose: each canonical decomposition of two runes whose rune isn't a
// Full_Composition_Exclusion. Hangul syllables decompose and compose by arithmetic, so the pairs
// leave them out.
import std.env
import std.fs
import std.http
import std.path
import std.process

const VERSION: str = "16.0.0"
const MAX: u32 = 0x10FFFF
// The composition table's size, a power of two about twice the number of pairs.
const PAIR_SLOTS: usize = 2048

// Hangul syllables, as the Unicode Standard's section 3.12 makes them from jamo.
const S_BASE: u32 = 0xAC00
const L_BASE: u32 = 0x1100
const V_BASE: u32 = 0x1161
const T_BASE: u32 = 0x11A7
const T_COUNT: u32 = 28
const N_COUNT: u32 = 588
const S_COUNT: u32 = 11172

fn notice() -> String {
