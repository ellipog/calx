// Writes the tables of powers the float code reads: powers of five in runtime/calx_fparse.c, for
// parsing, and powers of ten in runtime/calx_float.c, for printing.
//
//     calx run tools/float/tables.calx
//
// Entry i of each is the significand of its power in 128 bits, rounded down: the integer in
// [2^127, 2^128) that is the power times a power of two, less what's past its last bit. A BigInt
// is exact, so each entry is too.
//
// - Powers of five, 5^-342 to 5^308. The entries for q from 0 to 55 are exact, since 5^55 fits in
//   128 bits; the rest are less than the true value by less than one in their last bit, which is
//   what the parser's error bound assumes. It checks, too, that the binary exponent the parser
//   works out with a multiply and a shift, floor(log2(5^q)) = (q * 152170) >> 16, holds for every
//   q in the table.
// - Powers of ten, 10^-293 to 10^324. Żmij's printing reads the entry for 10^(-k - 1), for every k
//   a double or a float can scale by.
import std.bigint.{BigInt}
import std.env
import std.fs
import std.path

const BEGIN: str = "/* --- generated by tools/float/tables.calx; don't edit by hand --- */\n"
const END: str = "/* --- end of the generated table --- */\n"

// The significand of base^e in 128 bits, rounded down, whether it's exact, and floor(log2) of the
// power, which for a negative e holds only where the power isn't a power of two, as no power of
// five is.
fn significand(base: i64, e: i64) -> (BigInt, bool, i64) {
    if e >= 0 {
        let v = BigInt.from(base).pow(u32.wrap(e))
        let n = v.bit_len()
        let sig = if n <= 128 { v.shl(128 - n) } else { v.shr(n - 128) }
        return (sig, n <= 128, i64.wrap(n) - 1)
    }
    let d = BigInt.from(base).pow(u32.wrap(-e))
    let n = d.bit_len()
    return (BigInt.from(1).shl(n + 127) / d, false, -i64.wrap(n))
}

// One entry: the significand's high and low 64 bits, and what it's the power of.
fn row(sig: BigInt, label: String) -> String {
    let low = BigInt.from(1).shl(127)
    if sig < low or sig >= low.shl(1) {
        panic("the significand of {label} isn't 128 bits")
    }
    let hi = sig.shr(64)
    let lo = sig - hi.shl(64)
    return "    \{0x{hex(hi)}, 0x{hex(lo)}\},  /* {label} */\n"
}

fn hex(n: BigInt) -> String {
    return n.to_radix(16).pad_start(16, '0')
}

// Puts `table` in the file at `file`, in place of what's between the markers, with them.
fn replace_table(file: String, table: String) {
    let text = fs.read_text(file.copy())! ?? String()
    let start = text.find(BEGIN) ?? panic("{file} has no generated table")
    let end = (text.find(END) ?? panic("{file} has no end to its table")) + END.len()
    fs.write_text(file, "{text[..start]}{table}{text[end..]}")!
}

fn main() {
    let tools = path.parent_dir(env.script() ?? panic("run this with `calx run`")) ?? String()
    let root = path.parent_dir(path.parent_dir(tools) ?? String()) ?? String()

    var five = String(BEGIN)
    five.push_str("#define POW5_FIRST (-342)\n#define POW5_LAST 308\nstatic const cx_u64 pow5[][2] = \{\n")
    for q in -342i64..309 {
        let s = significand(5, q)
        if (q * 152170) >> 16 != s.2 {
            panic("floor(log2(5^{q})) isn't (q * 152170) >> 16")
        }
        if s.1 != (q >= 0 and q <= 55) {
            panic("5^{q} is exact where it shouldn't be, or not where it should")
        }
        five.push_str(row(s.0, "5^{q}"))
    }
    five.push_str("\};\n")
    five.push_str(END)
    replace_table("{root}/runtime/calx_fparse.c", five)

    var ten = String(BEGIN)
    ten.push_str("static const pow10_sig POW10[618] = \{\n")
    for e in -293i64..325 {
        ten.push_str(row(significand(10, e).0, "10^{e}"))
    }
    ten.push_str("\};\n")
    ten.push_str(END)
    replace_table("{root}/runtime/calx_float.c", ten)
    println("651 powers of five, 5^-342 to 5^308, and 618 powers of ten, 10^-293 to 10^324")
}
