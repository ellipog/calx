// calx-update: what `calx update` runs. Ships in every release's bin/, beside calx.
//
// It downloads a release from github.com/ellipog/calx, checks it against the SHA-256 published
// beside it, and swaps it into the installation, keeping what it replaced in .update/old so
// `calx update --rollback` can put it back. The swap renames rather than copies, so it's quick,
// and on Windows it renames the running calx.exe out of the way, which Windows allows where it
// wouldn't allow overwriting it.
//
//     calx-update --home DIR --current VERSION [--check] [--nightly | --stable] [--to VERSION]
//                 [--force] [--rollback] [--toolchain] [--background CACHE_FILE]
//
// A release is `version.txt`, holding its version, and for each platform
// `calx-VERSION-OS-x64.zip` or `.tar.gz` with a `.sha256` beside it. Stable releases are tagged
// `vVERSION` and are what `releases/latest` points to; nightlies replace the `nightly` release
// on every push to main that passes CI, and upload version.txt last, so the archive it names is
// already there.
//
// A release's archive can name, in toolchain.txt, the toolchain it builds programs with: an
// archive of its own in the release, `calx-toolchain-NAME-OS-x64.tar.xz`, its SHA-256, and its
// VERSION (CLX-110, CLX-251). An update downloads it only when toolchain/VERSION isn't that
// VERSION, which is when LLVM changes, and keeps the one it replaces for `--rollback`.
// `--toolchain` installs the one the installed release names, if it isn't there: the install
// scripts run that, and it mends an installation whose toolchain went missing.

import std.env.{args, variable}
import std.fs.{FsError, is_dir, is_file, list, make_dir_all, read, remove_dir_all, rename, separator, write}
import std.hash.{sha256}
import std.http.{Header, get}
import std.io.{flush, is_terminal}
import std.math.{sin}
import std.process.{exit}
import std.tar.{Tar}
import std.term.{size as term_size}
import std.thread.{Task, sleep}
import std.time.{Instant, Timestamp}
import std.zip.{Zip}

struct Options {
    home: String
    current: String
    check: bool
    nightly: bool
    stable: bool
    to: String
    force: bool
    rollback: bool
    toolchain: bool
    background: String
}

fn main() {
    let o = options()
    let l = look()
    if let err(message) = run(o, l) {
        if l.color {
            eprintln("{paint(l, "31", "✗")} calx update: {commands(l, message)}")
        } else {
            eprintln("calx update: {message}")
        }
        exit(1)
    }
}

fn run(o: Options, l: Look) ! String {
    if o.rollback {
        try rollback(o.home, l)
        return
    }
    if not o.background.is_empty() {
        background(o)
        return
    }
    if o.toolchain {
        try install_toolchain(o, l)
        return
    }
    let windows = separator() == "\\"
    let nightly = channel_is_nightly(o)
    var target = o.to.copy()
    if target.is_empty() {
        let looking = "Looking for the newest {if nightly { "nightly" } else { "stable" }} release of Calx"
        if l.color {
            let p = pulse(l, looking)
            target = match newest(nightly, false, l) {
                ok(v) => v,
                err(e) => {
                    stop_pulse(p)
                    fail e
                },
            }
            stop_pulse(p)
            if not nightly and target.contains("-nightly.") {
                println("{dim(l, "·")} {dim(l, "There's no stable release yet, so this follows the nightly releases.")}")
            }
        } else {
            println("{looking}...")
            target = try newest(nightly, false, l)
        }
    }
    let newer = compare(target, o.current) > 0
    if o.check {
        if l.color {
            if target == o.current {
                done(l, "calx `{o.current}` is the newest")
            } else if newer {
                println("{band(l, "↑ calx {target} is out")}  {dim(l, "you have {o.current};")} {commands(l, "`calx update` installs it")}")
            } else {
                done(l, "calx `{o.current}` is newer than the newest release, {target}")
            }
        } else if target == o.current {
            println("calx {o.current} is the newest.")
        } else if newer {
            println("calx {target} is out; you have {o.current}. `calx update` installs it.")
        } else {
            println("calx {o.current} is newer than the newest release, {target}.")
        }
        return
    }
    if target == o.current and not o.force {
        if l.color {
            done(l, "calx `{o.current}` is the newest; there's nothing to update")
        } else {
            println("calx {o.current} is the newest; there's nothing to update.")
        }
        return
    }
    if not newer and o.to.is_empty() and not o.force {
        if l.color {
            done(l, "calx `{o.current}` is newer than the newest release, {target}; `calx update --to {target}` goes back to it")
        } else {
            println("calx {o.current} is newer than the newest release, {target}; `calx update --to {target}` goes back to it.")
        }
        return
    }
    let tag = tag_of(target)
    let file = "calx-{target}-{if windows { "windows-x64.zip" } else { "linux-x64.tar.gz" }}"
    let url = "{releases()}/download/{tag}/{file}"
    if not l.color {
        println("Downloading {file}...")
    }
    let archive = try fetch_shown(l, file, url, 300000, 1073741824)    // 1 GiB
    let sums = try fetch("{url}.sha256", 30000, 4096)
    let want = first_word(String.from_utf8(sums) ?? String())
    let got = hex(sha256(archive))
    if want != got {
        fail "the download's SHA-256 is {got}, but the release says {want}; nothing was changed. Try again in a minute, in case the release was being replaced."
    }
    if l.color {
        done(l, "Downloaded {file} {dim(l, "{megabytes(archive.len())} MB, SHA-256 checked")}")
    } else {
        println("Checked its SHA-256 ({megabytes(archive.len())} MB).")
    }

    let work = "{o.home}/.update"
    let fresh = "{work}/new"
    try clear(fresh)
    if let err(e) = make_dir_all(fresh) {
        fail "can't make {fresh}: {why(e)}"
    }
    if windows {
        let z = match Zip.open(archive) {
            ok(z) => z,
            err(e) => fail "the download isn't a zip archive Calx can read: {e}",
        }
        try z.extract(fresh)
    } else {
        let t = match Tar.open(archive) {
            ok(t) => t,
            err(e) => fail "the download isn't a tar archive Calx can read: {e}",
        }
        try t.extract(fresh)
    }
    let root = "{fresh}/calx"
    let exe = if windows { "calx.exe" } else { "calx" }
    if not is_file("{root}/bin/{exe}") or not is_file("{root}/runtime/calx_rt.h") {
        fail "the download has no bin/{exe} or runtime/; nothing was changed"
    }
    // The toolchain it builds with, if that's another, before anything moves.
    let tools = try fetch_toolchain(o.home, root, tag, work, l)
    try swap(o.home, root, "{work}/old")
    if not tools.is_empty() {
        try place_toolchain(o.home, tools, "{work}/old")
        try clear("{work}/toolchain")
    }
    try clear(fresh)
    if let err(_) = write("{work}/previous", "{o.current}\n".to_bytes()) {
    }
    if l.color {
        println("")
        println("{band(l, "✓ Installed calx {target}")}")
        println("{dim(l, commands(l, "in place of {o.current}; `calx update --rollback` puts it back"))}")
    } else {
        println("Installed calx {target}, in place of {o.current}. `calx update --rollback` puts {o.current} back.")
    }
}

// The release a version is in: `nightly` for a nightly, `vVERSION` for the others.
fn tag_of(version: String) -> String {
    return if version.contains("-nightly.") { String("nightly") } else { "v{version}" }
}

// What a release's toolchain.txt says: the toolchain's archive, its SHA-256 and its VERSION.
struct ToolchainNote {
    file: String
    sha256: String
    name: String
}

// The toolchain the release in `root` names, or none if it names none.
fn toolchain_note(root: String) -> ToolchainNote? ! String {
    let bytes = match read("{root}/toolchain.txt") {
        ok(b) => b,
        err(_) => return none,
    }
    let lines = (String.from_utf8(bytes) ?? String()).lines()
    if lines.len() < 3 or lines[0].trim().is_empty() or lines[1].trim().len() != 64 {
        fail "{root}/toolchain.txt doesn't name a toolchain"
    }
    return some(ToolchainNote { file: lines[0].trim(), sha256: lines[1].trim(), name: lines[2].trim() })
}

// The VERSION of the toolchain installed in `home`, or "" if there's none.
fn installed_toolchain(home: String) -> String {
    return match read("{home}/toolchain/VERSION") {
        ok(b) => (String.from_utf8(b) ?? String()).trim(),
        err(_) => String(),
    }
}

// Downloads and checks the toolchain the release in `root` names, from the release `tag`, and
// unpacks it under `work`, if `home` hasn't that one already. Gives where it unpacked it, or ""
// if there's nothing to do. Nothing in `home` changes.
fn fetch_toolchain(home: String, root: String, tag: String, work: String, l: Look) -> String ! String {
    let note = (try toolchain_note(root)) else return String()
    if installed_toolchain(home) == note.name {
        return String()
    }
    let url = "{releases()}/download/{tag}/{note.file}"
    if not l.color {
        println("Downloading the toolchain programs are built with, {note.name}...")
    }
    let archive = try fetch_shown(l, "toolchain", url, 900000, 2147483648)    // 2 GiB
    let got = hex(sha256(archive))
    if got != note.sha256 {
        fail "the toolchain's SHA-256 is {got}, but the release says {note.sha256}; nothing was changed. Try again in a minute, in case the release was being replaced."
    }
    if l.color {
        done(l, "Downloaded the toolchain, {note.name} {dim(l, "{megabytes(archive.len())} MB, SHA-256 checked")}")
    } else {
        println("Checked its SHA-256 ({megabytes(archive.len())} MB). Unpacking it...")
    }
    let fresh = "{work}/toolchain"
    try clear(fresh)
    if let err(e) = make_dir_all(fresh) {
        fail "can't make {fresh}: {why(e)}"
    }
    // Opening it decompresses it, which takes seconds too, so the pulse starts first.
    let unpacking = pulse(l, "Unpacking the toolchain")
    let t = match Tar.open(archive) {
        ok(t) => t,
        err(e) => {
            stop_pulse(unpacking)
            fail "the toolchain isn't a tar archive Calx can read: {e}"
        },
    }
    if let err(e) = t.extract(fresh) {
        stop_pulse(unpacking)
        fail e
    }
    stop_pulse(unpacking)
    if l.color {
        done(l, "Unpacked the toolchain")
    }
    let exe = if separator() == "\\" { ".exe" } else { "" }
    let dir = "{fresh}/toolchain"
    if not is_file("{dir}/bin/clang{exe}") {
        fail "the toolchain has no bin/clang{exe}; nothing was changed"
    }
    return dir
}

// Moves the toolchain at `from` into `home`, and the one it replaces, if any, into `old`.
fn place_toolchain(home: String, from: String, old: String) ! String {
    let current = "{home}/toolchain"
    if is_dir(current) {
        if let err(_) = make_dir_all(old) {
        }
        if let err(e) = rename(current, "{old}/toolchain") {
            fail "can't move {current} aside: {why(e)}; is a build running? `calx update --toolchain` tries again"
        }
    }
    if let err(e) = rename(from, current) {
        fail "can't move the toolchain into {current}: {why(e)}; `calx update --toolchain` tries again"
    }
}

// Installs the toolchain the installed release names, if it isn't there.
fn install_toolchain(o: Options, l: Look) ! String {
    let note = (try toolchain_note(o.home)) else {
        println("This release of Calx builds programs with the clang it finds; it names no toolchain to install.")
        return
    }
    let work = "{o.home}/.update"
    let dir = try fetch_toolchain(o.home, o.home, tag_of(o.current), work, l)
    if dir.is_empty() {
        if l.color {
            done(l, "The toolchain, {note.name}, is installed")
        } else {
            println("The toolchain, {note.name}, is installed.")
        }
        return
    }
    // The one it replaces isn't kept: it's not what this release builds with.
    let aside = "{work}/toolchain-replaced"
    try clear(aside)
    try place_toolchain(o.home, dir, aside)
    try clear(aside)
    try clear("{work}/toolchain")
    if l.color {
        done(l, bold(l, "Installed the toolchain, {note.name}"))
    } else {
        println("Installed the toolchain, {note.name}.")
    }
}

// The releases page of Calx's repository, or CALX_RELEASES, for a mirror or a test.
fn releases() -> String {
    return variable("CALX_RELEASES") ?? String("https://github.com/ellipog/calx/releases")
}

fn options() -> Options {
    let a = args()
    var o = Options {
        home: String(), current: String(), check: false, nightly: false, stable: false, to: String(), force: false, rollback: false,
        toolchain: false, background: String(),
    }
    var i: usize = 0
    while i < a.len() {
        let x = a[i].copy()
        if x == "--home" and i + 1 < a.len() {
            o.home = a[i + 1].copy()
            i += 1
        } else if x == "--current" and i + 1 < a.len() {
            o.current = a[i + 1].copy()
            i += 1
        } else if x == "--to" and i + 1 < a.len() {
            o.to = trim_v(a[i + 1])
            i += 1
        } else if x == "--background" and i + 1 < a.len() {
            o.background = a[i + 1].copy()
            i += 1
        } else if x == "--check" {
            o.check = true
        } else if x == "--nightly" {
            o.nightly = true
        } else if x == "--stable" {
            o.stable = true
        } else if x == "--force" {
            o.force = true
        } else if x == "--rollback" {
            o.rollback = true
        } else if x == "--toolchain" {
            o.toolchain = true
        } else {
            eprintln("calx update: unknown option {x}")
            eprintln("usage: calx update [--check] [--nightly | --stable] [--to VERSION] [--force] [--rollback] [--toolchain]")
            exit(2)
        }
        i += 1
    }
    if o.home.is_empty() or o.current.is_empty() {
        eprintln("calx-update is run by `calx update`, which says where Calx is installed")
        exit(2)
    }
    if o.nightly and o.stable {
        eprintln("calx update: --nightly and --stable each pick a channel; give one")
        exit(2)
    }
    return o
}

// Whether to follow nightlies: as asked, or as the installed version does.
fn channel_is_nightly(o: Options) -> bool {
    if o.nightly {
        return true
    }
    if o.stable {
        return false
    }
    return o.current.contains("-nightly.")
}

// The newest release's version on a channel. Until there's a stable release, the stable
// channel follows nightlies.
fn newest(nightly: bool, quiet: bool, l: Look) -> String ! String {
    if not nightly {
        match fetch("{releases()}/latest/download/version.txt", 15000, 65536) {
            ok(b) => return try parse_version(b),
            err(e) => {
                if not e.contains("404") {
                    fail e
                }
                // In a terminal, the pulse that's drawing says it once it's done, as a note.
                if not quiet and not l.color {
                    println("There's no stable release yet, so this follows the nightly releases.")
                }
            },
        }
    }
    let b = try fetch("{releases()}/download/nightly/version.txt", 15000, 65536)
    return try parse_version(b)
}

fn parse_version(b: own List<u8>) -> String ! String {
    let v = first_word(String.from_utf8(b) ?? String())
    if v.is_empty() or not (v.byte_at(0) >= 48 and v.byte_at(0) <= 57) {
        fail String("the release's version.txt doesn't hold a version")
    }
    return v
}

// The body of a GET, or why there's none, with a status other than 200 as an error.
fn fetch(url: String, timeout_ms: u32, limit: usize) -> List<u8> ! String {
    let agent = Header { name: "User-Agent", value: "calx-update" }
    var r = get(url.copy(), [agent], timeout_ms, limit)
    let resp = match r.wait() {
        ok(resp) => resp,
        err(e) => fail "can't reach {url}: {e}",
    }
    if resp.status != 200 {
        fail "{url} answered {resp.status}"
    }
    return resp.body
}

// The daily check `calx` starts in the background. It writes to `file` three lines: the version
// it checked for, the newer one or nothing, and when it checked, in seconds since 1970, which
// `calx` reads so that one read of the file tells it everything. When it can't reach GitHub,
// it keeps what the file said and moves the time on, so the next check is a day away too.
fn background(o: Options) {
    let file = o.background.copy()
    let now = unsafe { Timestamp.now() }.unix_ms / 1000
    let newer = match newest(channel_is_nightly(o), true, look()) {
        ok(v) => if compare(v, o.current) > 0 { v } else { String() },
        err(_) => {
            let before = match read(file) {
                ok(b) => String.from_utf8(b) ?? String(),
                err(_) => String(),
            }
            second_line(before, o.current)
        },
    }
    if let err(_) = write(file, "{o.current}\n{newer}\n{now}\n".to_bytes()) {
    }
}

// The second line of what an earlier check wrote, if it was about `current`, or nothing.
fn second_line(text: String, current: String) -> String {
    let a = text.find("\n") ?? text.len()
    if text[..a] != current or a == text.len() {
        return String()
    }
    let rest = text[a + 1..]
    let b = rest.find("\n") ?? rest.len()
    return rest[..b]
}

// Moves each part of the release at `root` into `home`, and what it replaces into `old`. bin's
// files move one by one, since the running calx.exe can be renamed but not its folder.
fn swap(home: String, root: String, old: String) ! String {
    try clear(old)
    if let err(e) = make_dir_all("{old}/bin") {
        fail "can't make {old}: {why(e)}"
    }
    let parts = match list(root) {
        ok(p) => p,
        err(e) => fail "can't list {root}: {why(e)}",
    }
    // What has moved so far, as (from, to), to undo if a later move fails.
    var moved = List<(String, String)>()
    for part in parts {
        if part == "bin" {
            let files = match list("{root}/bin") {
                ok(f) => f,
                err(e) => fail undo(moved, "can't list {root}/bin: {why(e)}"),
            }
            if let err(e) = make_dir_all("{home}/bin") {
                fail undo(moved, "can't make {home}/bin: {why(e)}")
            }
            for f in files {
                try step(mut moved, "{home}/bin/{f}", "{old}/bin/{f}", "{root}/bin/{f}")
            }
        } else {
            try step(mut moved, "{home}/{part}", "{old}/{part}", "{root}/{part}")
        }
    }
}

// Moves `current`, if it's there, to `backup`, then `incoming` to where `current` was.
fn step(moved: mut List<(String, String)>, current: String, backup: String, incoming: String) ! String {
    if is_file(current) or is_dir(current) {
        if let err(e) = rename(current, backup) {
            fail undo(moved, "can't move {current} aside: {why(e)}")
        }
        moved.push((current.copy(), backup.copy()))
    }
    if let err(e) = rename(incoming, current) {
        fail undo(moved, "can't move {incoming} into place: {why(e)}")
    }
    moved.push((incoming.copy(), current.copy()))
}

// Puts back everything `swap` moved, newest first, and gives the message to fail with.
fn undo(moved: List<(String, String)>, message: String) -> String {
    var i = moved.len()
    while i > 0 {
        i -= 1
        let (from, to) = moved[i].copy()
        if let err(_) = rename(to, from) {
        }
    }
    return "{message}. Nothing was changed."
}

// Swaps the installation with what the last update replaced, so running it twice goes back to
// where it started.
fn rollback(home: String, l: Look) ! String {
    let work = "{home}/.update"
    let old = "{work}/old"
    if not is_dir(old) {
        fail String("there's no earlier version to go back to: no update has replaced one yet")
    }
    let previous = match read("{work}/previous") {
        ok(b) => first_word(String.from_utf8(b) ?? String()),
        err(_) => String("the earlier version"),
    }
    let current = match read("{home}/VERSION") {
        ok(b) => first_word(String.from_utf8(b) ?? String()),
        err(_) => String("this version"),
    }
    let back = "{work}/back"
    try clear(back)
    if let err(e) = rename(old, back) {
        fail "can't move {old}: {why(e)}"
    }
    try swap(home, back, old)
    try clear(back)
    if let err(_) = write("{work}/previous", "{current}\n".to_bytes()) {
    }
    if l.color {
        println("{band(l, "✓ Went back to calx {previous}")}")
        println("{dim(l, commands(l, "from {current}; `calx update --rollback` again returns to it"))}")
    } else {
        println("Went back to calx {previous}, from {current}. `calx update --rollback` again returns to {current}.")
    }
}

// Removes a folder if it's there. On Windows a calx.exe that's still running can't be removed,
// so a folder that won't go is renamed out of the way, to be removed by a later update.
fn clear(dir: String) ! String {
    if not is_dir(dir) {
        return
    }
    if let err(_) = remove_dir_all(dir) {
        let now = unsafe { Timestamp.now() }
        if let err(e) = rename(dir, "{dir}-{now.unix_ms}.trash") {
            fail "can't clear {dir}: {why(e)}"
        }
    }
    // Earlier folders that wouldn't go may go now.
    let parent = dir[..dir.find_last("/") ?? 0]
    if let ok(names) = list(parent) {
        for n in names {
            if n.ends_with(".trash") {
                if let err(_) = remove_dir_all("{parent}/{n}") {
                }
            }
        }
    }
}

fn why(e: FsError) -> String {
    return match e {
        NotFound => String("it isn't there"),
        Denied => String("access is denied; is another calx running from this installation?"),
        Exists => String("something is in the way"),
        BadPath => String("the path is bad"),
        IsDirectory => String("it's a directory"),
        NotEmpty => String("the directory isn't empty"),
        Os(code) => "system error {code}",
    }
}

// -1, 0 or 1 as `a` is older than, the same as, or newer than `b`, by semantic versioning:
// numbers first, then a version without a prerelease part after one with it, then the
// prerelease parts, numbers by value and words by their bytes. Build metadata, after `+`,
// doesn't count.
fn compare(a: String, b: String) -> i32 {
    let ap = a[..a.find("+") ?? a.len()]
    let bp = b[..b.find("+") ?? b.len()]
    let a_dash = ap.find("-") ?? ap.len()
    let b_dash = bp.find("-") ?? bp.len()
    let c = compare_parts(ap[..a_dash], bp[..b_dash])
    if c != 0 {
        return c
    }
    let a_pre = a_dash < ap.len()
    let b_pre = b_dash < bp.len()
    if not a_pre and not b_pre {
        return 0
    }
    if not a_pre {
        return 1
    }
    if not b_pre {
        return -1
    }
    return compare_parts(ap[a_dash + 1..], bp[b_dash + 1..])
}

// Compares dot-separated parts, numbers as numbers and words as bytes; a number comes before a
// word, and fewer parts before more.
fn compare_parts(a: String, b: String) -> i32 {
    let xs = split_dots(a)
    let ys = split_dots(b)
    var i: usize = 0
    while i < xs.len() and i < ys.len() {
        let xn = u64.parse(xs[i])
        let yn = u64.parse(ys[i])
        let c = match (xn, yn) {
            (some(x), some(y)) => if x < y { -1 } else if x > y { 1 } else { 0 },
            (some(_), none) => -1,
            (none, some(_)) => 1,
            (none, none) => if xs[i] < ys[i] { -1 } else if xs[i] > ys[i] { 1 } else { 0 },
        }
        if c != 0 {
            return c
        }
        i += 1
    }
    return if xs.len() < ys.len() { -1 } else if xs.len() > ys.len() { 1 } else { 0 }
}

fn split_dots(s: String) -> List<String> {
    var out = List<String>()
    var start: usize = 0
    for i in 0..s.len() {
        if s.byte_at(i) == 46 {
            out.push(s[start..i])
            start = i + 1
        }
    }
    out.push(s[start..])
    return out
}

// The text up to the first space or line break.
fn first_word(s: String) -> String {
    var start: usize = 0
    while start < s.len() and is_space(s.byte_at(start)) {
        start += 1
    }
    var end = start
    while end < s.len() and not is_space(s.byte_at(end)) {
        end += 1
    }
    return s[start..end]
}

fn is_space(b: u8) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

fn trim_v(s: String) -> String {
    let w = first_word(s)
    return if w.starts_with("v") { w[1..] } else { w }
}

fn hex(bytes: List<u8>) -> String {
    var out = String()
    out.reserve(bytes.len() * 2)
    for b in bytes {
        out.push(hex_digit(u32(b) >> 4))
        out.push(hex_digit(u32(b) & 15))
    }
    return out
}

fn hex_digit(v: u32) -> rune {
    return rune(u8.wrap(if v < 10 { 48 + v } else { 87 + v }))
}

fn megabytes(n: usize) -> String {
    let tenths = (n * 10 + 524288) / 1048576
    return "{tenths / 10}.{tenths % 10}"
}

// How calx-update looks (CLX-250), as calx does. In a terminal someone's watching it shows colour,
// a ✓ before what's done, a progress bar for each download, and a pulse while the toolchain
// unpacks. Anywhere else, such as a pipe, CI or with NO_COLOR set, it prints the plain lines it
// always printed. CLICOLOR_FORCE=1 or FORCE_COLOR turns the terminal's look on anyway, for a
// recording.
struct Look {
    color: bool
    live: bool
    truecolor: bool
}

fn env(name: String) -> String {
    return variable(name) ?? String()
}

fn look() -> Look {
    let force_color = env("FORCE_COLOR")
    let force = env("CLICOLOR_FORCE") == "1" or (not force_color.is_empty() and force_color != "0")
    let off = not env("NO_COLOR").is_empty() or env("TERM") == "dumb"
    let color = force or (is_terminal() and not off)
    let colorterm = env("COLORTERM")
    // Every Windows console that takes ANSI codes takes 24-bit colour.
    let truecolor = separator() == "\\" or colorterm == "truecolor" or colorterm == "24bit" or not env("WT_SESSION").is_empty() or force
    return Look { color: color, live: color and (force or env("CI").is_empty()), truecolor: truecolor }
}

// `s` in the style `sgr`, which comes back after each style inside it ends, so a dim line with a
// command in the accent is dim on both sides of it.
fn paint(l: Look, sgr: String, s: String) -> String {
    if not l.color {
        return s.copy()
    }
    let inner = s.replace("\u{1b}[0m", "\u{1b}[0m\u{1b}[{sgr}m")
    return "\u{1b}[{sgr}m{inner}\u{1b}[0m"
}

// Calx's amber, as calx's: the brand's (`--calx` on calxlang.com), or the nearest the terminal's
// palette has. `ground` is the same colour behind text, for a chip.
fn amber(l: Look) -> String {
    if l.truecolor {
        return String("38;2;188;133;54")
    }
    return if env("TERM").contains("256") { String("38;5;136") } else { String("33") }
}

fn ground(l: Look) -> String {
    if l.truecolor {
        return String("48;2;188;133;54")
    }
    return if env("TERM").contains("256") { String("48;5;136") } else { String("43") }
}

fn accent(l: Look, s: String) -> String {
    return paint(l, amber(l), s)
}

// A result: `text` on a chip of amber that dithers in and out, `░▒▓ text ▓▒░`, as calx's.
fn band(l: Look, text: String) -> String {
    if not l.color {
        return text.copy()
    }
    let ink = if l.truecolor { String("38;2;24;24;27;1") } else { String("30") }
    let fg = amber(l)
    return "\u{1b}[{fg}m░▒▓\u{1b}[0m\u{1b}[{ground(l)};{ink}m {text} \u{1b}[0m\u{1b}[{fg}m▓▒░\u{1b}[0m"
}

fn dim(l: Look, s: String) -> String {
    return paint(l, "90", s)
}

fn bold(l: Look, s: String) -> String {
    return paint(l, "1", s)
}

// `✓ text`, with each `...` in `text` in the accent, without its backticks.
fn done(l: Look, text: String) {
    println("{paint(l, "32", "✓")} {commands(l, text)}")
    flush()
}

// `text` with each `...` in it in the accent, without the backticks.
fn commands(l: Look, text: String) -> String {
    var out = String()
    var rest = text.copy()
    loop {
        let open = rest.find("`") ?? rest.len()
        if open == rest.len() {
            break
        }
        let after = rest[open + 1..]
        let close = after.find("`") ?? after.len()
        if close == after.len() {
            break
        }
        out.push_str(rest[..open])
        out.push_str(accent(l, after[..close]))
        rest = after[close + 1..]
    }
    out.push_str(rest)
    return out
}

// Cells of shade, each amber or the grey of a track, with one escape code for each run of either.
struct Cells {
    out: String
    lit: i32    // 0 before the first cell, 1 for the track's grey, 2 for amber
    amber: String
}

impl Cells {
    fn add(mut self, lit: bool, cell: String) {
        let want: i32 = if lit { 2 } else { 1 }
        if want != self.lit {
            if self.lit != 0 {
                self.out.push_str("\u{1b}[0m")
            }
            if lit {
                let code = "\u{1b}[{self.amber}m"
                self.out.push_str(code)
            } else {
                self.out.push_str("\u{1b}[90m")
            }
            self.lit = want
        }
        self.out.push_str(cell)
    }

    fn done(own self) -> String {
        var out = self.out
        out.push_str("\u{1b}[0m")
        return out
    }
}

// The shades by how much of a cell they ink, in quarters: ░, ▒, ▓, █.
fn shade(quarters: i64) -> String {
    return if quarters <= 1 { String("░") } else if quarters == 2 { String("▒") } else if quarters == 3 { String("▓") } else { String("█") }
}

// A bar `width` cells wide, `part` of `whole` filled, as calx's: full cells, then an edge that
// fades through ▓ ▒ ░ over four cells, on a grey ░ track. The edge breathes from frame to frame.
fn bar(l: Look, part: u64, whole: u64, width: u64, frame: u64) -> String {
    var fraction = 0.0
    if whole > 0 {
        fraction = f64.nearest(if part > whole { whole } else { part }) / f64.nearest(whole)
    }
    let edge = 4.0
    var head = (0.5 - edge / 2.0) + fraction * (f64.nearest(width) + edge - 1.0)
    if fraction > 0.0 and fraction < 1.0 {
        head += 0.6 * sin(f64.nearest(frame % 1000) * 0.7)
    }
    var cells = Cells { out: String(), lit: 0, amber: amber(l) }
    for i in 0..width {
        let v = ((head - (f64.nearest(i) + 0.5)) / edge + 0.5).max(0.0).min(1.0)
        let q = i64.saturate((v * 4.0 + 0.5).floor())
        cells.add(q > 0, shade(if q > 0 { q } else { 1 }))
    }
    return cells.done()
}

// A comet of dither that sweeps to and fro across a grey ░ track `width` cells wide, as calx's.
fn scanner(l: Look, frame: u64, width: u64) -> String {
    let span = width - 1
    let at = frame % (2 * span)
    let rightward = at < span
    let head = if rightward { at } else { 2 * span - at }
    var cells = Cells { out: String(), lit: 0, amber: amber(l) }
    for i in 0..width {
        // How far behind the head this cell is, going the way it's going.
        var behind: i64 = -1
        if rightward and i <= head {
            behind = i64.wrap(head - i)
        } else if not rightward and i >= head {
            behind = i64.wrap(i - head)
        }
        let lit = behind >= 0 and behind < 4
        cells.add(lit, shade(if lit { 4 - behind } else { 1 }))
    }
    return cells.done()
}

// `ns` so far, for a status line: `0.4 s`, `12.3 s`, `2 min 5 s`.
fn elapsed(ns: u64) -> String {
    let tenths = ns / 100000000
    if tenths < 600 {
        return "{tenths / 10}.{tenths % 10} s"
    }
    let s = tenths / 10
    return "{s / 60} min {s % 60} s"
}

// The columns of the terminal, or 80.
fn columns() -> u64 {
    return match unsafe { term_size() } {
        some(s) => if s.columns >= 40 { u64(s.columns) } else { 80 },
        none => 80,
    }
}

// The body of a GET, as `fetch`, with what's happening drawn on the line while it comes, if `l`
// is live: `label`, a progress bar and the speed for a download that says how long it is, or a
// pulse after a quarter of a second for one that doesn't, so a quick request draws nothing.
fn fetch_shown(l: Look, label: String, url: String, timeout_ms: u32, limit: usize) -> List<u8> ! String {
    if not l.live {
        return try fetch(url, timeout_ms, limit)
    }
    let agent = Header { name: "User-Agent", value: "calx-update" }
    var r = get(url.copy(), [agent], timeout_ms, limit)
    let start = unsafe { Instant.now() }
    var frame: u64 = 0
    var drawn = false
    while not r.done() {
        let ns = unsafe { Instant.now() }.nanos_since(start)
        let p = r.progress()
        if ns >= 250000000 {
            // Tenths of a MB, and of a MB a second.
            let got = p.received * 10 / 1048576
            let speed = if ns > 0 { got * 1000000000 / ns } else { 0 }
            let rate = dim(l, "{speed / 10}.{speed % 10} MB/s")
            let line = match p.total {
                some(total) => {
                    let all = total * 10 / 1048576
                    let numbers = "{got / 10}.{got % 10} of {all / 10}.{all % 10} MB"
                    let used = 2 + u64(label.len()) + 2 + u64(numbers.len()) + 2 + 10
                    let width = if columns() > used + 10 { (columns() - used).min(30) } else { 10 }
                    "  {label}  {bar(l, p.received, total, width, frame)}  {numbers}  {rate}"
                },
                none => "  {label}  {scanner(l, frame, 8)}  {got / 10}.{got % 10} MB  {rate}",
            }
            print("\r\u{1b}[2K{line}")
            flush()
            drawn = true
            frame += 1
        }
        unsafe { sleep(50000000) }
    }
    if drawn {
        print("\r\u{1b}[2K")
        flush()
    }
    let resp = match r.wait() {
        ok(resp) => resp,
        err(e) => fail "can't reach {url}: {e}",
    }
    if resp.status != 200 {
        fail "{url} answered {resp.status}"
    }
    return resp.body
}

// A thread that draws `text` with a scanner before it and the time so far after it, once a
// quarter of a second has passed, until `stop` gets a message, then takes the line off the screen.
struct Pulse {
    text: String
    stop: Receiver<bool>
    look: Look
}

impl Task for Pulse {
    fn run(own self) {
        let start = unsafe { Instant.now() }
        var frame: u64 = 0
        var drawn = false
        loop {
            if let _ = self.stop.next() {
                break
            }
            let ns = unsafe { Instant.now() }.nanos_since(start)
            if ns >= 250000000 {
                let time = if ns >= 1000000000 { "  {dim(self.look, elapsed(ns))}" } else { String() }
                print("\r\u{1b}[2K{scanner(self.look, frame, 8)}  {self.text}{time}")
                flush()
                drawn = true
                frame += 1
            }
            unsafe { sleep(80000000) }
        }
        if drawn {
            print("\r\u{1b}[2K")
            flush()
        }
    }
}

// A pulse that runs while the main thread works, if `l` is live, which `stop_pulse` stops.
struct Pulsing {
    thread: Thread?
    stop: Sender<bool>
}

fn pulse(l: Look, text: String) -> Pulsing {
    let stop = Receiver<bool>()
    let to_stop = stop.sender()
    if not l.live {
        return Pulsing { thread: none, stop: to_stop }
    }
    let t = unsafe { Thread.spawn(Pulse { text: text.copy(), stop: stop, look: l }) }
    return Pulsing { thread: some(t), stop: to_stop }
}

fn stop_pulse(p: own Pulsing) {
    let Pulsing { thread: thread, stop: stop } = p
    var to_stop = stop
    to_stop.send(true)
    if let t = thread {
        t.join()
    }
}
