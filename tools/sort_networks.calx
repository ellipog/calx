// Generates the sorting networks of calx_sort.h, for integers' short runs (D157).
//
//     calx run tools/sort_networks.calx > networks.h
//
// Each is Batcher's odd-even merge sort for 4, 8, 16 or 32 elements: 5, 19, 63 and 191 comparators,
// 3, 6, 10 and 15 deep. A comparator puts the lesser of two elements first. They're printed a layer
// to a line, where no comparator waits on another, so the compiler can run a layer at once, with
// `cmov`s or, for x86-64-v3, vector compares.
//
// It checks each network by the 0-1 principle: a network that sorts every list of zeros and ones
// sorts every list. That's every such list up to 16 elements, and 200,000 random ones of 32.
import std.random.{Random}

// Merges the sorted halves of lo..lo+n, comparing elements r apart.
fn merge(lo: usize, n: usize, r: usize, net: mut List<(usize, usize)>) {
    let step = r * 2
    if step < n {
        merge(lo, n, step, mut net)
        merge(lo + r, n, step, mut net)
        var i = lo + r
        while i < lo + n - r {
            net.push((i, i + r))
            i += step
        }
    } else {
        net.push((lo, lo + r))
    }
}

fn batcher(lo: usize, n: usize, net: mut List<(usize, usize)>) {
    if n > 1 {
        let half = n / 2
        batcher(lo, half, mut net)
        batcher(lo + half, half, mut net)
        merge(lo, n, 1, mut net)
    }
}

// The comparators in layers, each after every comparator it depends on.
fn layers(net: List<(usize, usize)>, n: usize) -> List<List<(usize, usize)>> {
    var depth: List<usize> = []
    for _ in 0..n {
        depth.push(0)
    }
    var out: List<List<(usize, usize)>> = []
    for c in net {
        let d = depth[c.0].max(depth[c.1])
        while out.len() <= d {
            out.push([])
        }
        out[d].push(c)
        depth[c.0] = d + 1
        depth[c.1] = d + 1
    }
    return out
}

// Whether the network sorts the zeros and ones of `bits`.
fn sorts(net: List<(usize, usize)>, n: usize, bits: u64) -> bool {
    var x = bits
    for c in net {
        let a = (x >> c.0) & 1
        let b = (x >> c.1) & 1
        if a > b {
            x ^= (1u64 << c.0) | (1u64 << c.1)
        }
    }
    // Sorted is every zero before every one: a run of ones at the top.
    let ones = u32.wrap(x.count_ones())
    let want = if ones == 0 { 0u64 } else { ((1u64 << ones) - 1) << (u32.wrap(n) - ones) }
    return x == want
}

fn check(net: List<(usize, usize)>, n: usize) {
    if n <= 16 {
        for bits in 0u64..(1u64 << n) {
            if not sorts(net, n, bits) {
                panic("the network for {n} doesn't sort {bits}")
            }
        }
        return
    }
    var r = Random.new(1)
    for _ in 0..200000 {
        let bits = r.next_u64() & ((1u64 << n) - 1)
        if not sorts(net, n, bits) {
            panic("the network for {n} doesn't sort {bits}")
        }
    }
}

// `items` joined by spaces, in lines of at most `width`, the first after `first` and the rest
// after as many spaces.
fn wrap(items: List<String>, first: String, out: mut List<String>) {
    let width: usize = 110
    let rest = " ".repeat(first.len())
    var line = first.copy()
    var start = first.copy()
    for item in items {
        if line.len() + item.len() + 1 > width and line.len() > start.len() {
            out.push(line.trim_end())
            line = rest.copy()
            start = rest.copy()
        }
        line.push_str(item)
        line.push(' ')
    }
    out.push(line.trim_end())
}

fn main() {
    let sizes: List<(usize, usize, usize)> = [(4, 5, 3), (8, 19, 6), (16, 63, 10), (32, 191, 15)]
    var out: List<String> = ["/* Generated by tools/sort_networks.calx. */"]
    for s in sizes {
        let n = s.0
        var net: List<(usize, usize)> = []
        batcher(0, n, mut net)
        check(net, n)
        let ls = layers(net, n)
        if net.len() != s.1 or ls.len() != s.2 {
            panic("the network for {n} has {net.len()} comparators {ls.len()} deep")
        }
        out.push("static inline void CX_SORT_F(_net{n})(CX_SORT_T* v CX_SORT_P) \{")
        var loads: List<String> = []
        for k in 0..n {
            loads.push(if k + 1 < n { "x{k} = v[{k}]," } else { "x{k} = v[{k}];" })
        }
        wrap(loads, String("    CX_SORT_T "), mut out)
        for layer in ls {
            wrap(layer.map(|c| "CX_SORT_CAS(x{c.0}, x{c.1});"), String("    "), mut out)
        }
        var stores: List<String> = []
        for k in 0..n {
            stores.push("v[{k}] = x{k};")
        }
        wrap(stores, String("    "), mut out)
        out.push("\}")
        out.push("")
    }
    print(out.join("\n"))
}
